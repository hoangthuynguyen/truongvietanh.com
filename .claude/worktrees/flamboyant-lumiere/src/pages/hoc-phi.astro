---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import { getPillarPage } from '../lib/directus';

const cmsPage = await getPillarPage('hoc-phi');
const cmsFaqs = cmsPage?.faq_items || null;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Trường Liên Cấp Việt Anh",
    "alternateName": "Trường Song Ngữ Việt Anh",
    "url": "https://truongvietanh.com/hoc-phi",
    "logo": "https://truongvietanh.com/logo-crest-80.webp",
    "foundingDate": "2011",
    "description": "Học phí Trường Việt Anh 2026: Bảng phí chi tiết từ Mầm non đến THPT. Minh bạch, không phí ẩn, chất lượng quốc tế với mức học phí phù hợp cho gia đình Việt Nam.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Hồ Chí Minh",
      "addressCountry": "VN"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "bestRating": "5",
      "ratingCount": "300"
    },
    "numberOfEmployees": { "@type": "QuantitativeValue", "value": 500 },
    "areaServed": ["TP. Hồ Chí Minh", "Long An", "Kiên Giang"],
    "educationalLevel": ["Preschool", "Primary", "Secondary", "High School"]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Học phí Trường Việt Anh có tăng hàng năm không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Học phí có thể được điều chỉnh hàng năm theo chi phí vận hành và nâng cấp chương trình. Mức tăng thường từ 5-8% mỗi năm. Phụ huynh được thông báo trước ít nhất 3 tháng trước kỳ điều chỉnh." }
      },
      {
        "@type": "Question",
        "name": "Có thể trả học phí theo kỳ không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Có. Phụ huynh có thể đóng theo tháng, theo quý (giảm 2%), theo học kỳ (giảm 3%) hoặc theo năm (giảm 5%). Trường hỗ trợ nhiều hình thức thanh toán: chuyển khoản, tiền mặt, thẻ tín dụng." }
      },
      {
        "@type": "Question",
        "name": "Có phí đồng phục không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Có. Phí đồng phục được tính riêng, khoảng 1-2 triệu cho bộ đồng phục đầy đủ (áo, quần, giày thể thao). Đồng phục chỉ mua 1 lần và có thể mua thêm nếu cần." }
      },
      {
        "@type": "Question",
        "name": "Có hoàn phí nếu con nghỉ học không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Có chính sách hoàn phí theo quy định. Nếu nghỉ trước khi bắt đầu học: hoàn 90% phí nhập học. Nghỉ trong tháng đầu: hoàn 70% học phí còn lại. Sau tháng đầu: hoàn phí theo số tháng chưa học." }
      },
      {
        "@type": "Question",
        "name": "Có chiết khấu khi đóng học phí cả năm không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Có. Đóng theo năm giảm 5% tổng học phí. Đóng theo học kỳ giảm 3%. Đóng theo quý giảm 2%. Phụ huynh có thể chọn phương thức phù hợp nhất với tài chính gia đình." }
      },
      {
        "@type": "Question",
        "name": "Phí xe đưa rước bao nhiêu?",
        "acceptedAnswer": { "@type": "Answer", "text": "Phí xe đưa rước tuỳ theo khoảng cách, dao động từ 800.000 đến 1.500.000 đồng/tháng. Xe trang bị camera, GPS và phụ xe chuyên trách. Phụ huynh nhận thông báo tự động khi con lên/xuống xe." }
      },
      {
        "@type": "Question",
        "name": "Phí ngoại khoá có tính riêng không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Ngoại khoá cơ bản (thể thao, nghệ thuật, CLB) đã bao gồm trong học phí. Các chương trình nâng cao (piano, guitar, bóng đá chuyên nghiệp, robotics nâng cao) có phí bổ sung từ 500.000 - 1.500.000 đồng/tháng." }
      },
      { "@type": "Question", "name": "So với trường quốc tế, học phí Trường Việt Anh thế nào?", "acceptedAnswer": { "@type": "Answer", "text": "Học phí chỉ bằng 1/3 đến 1/5 trường quốc tế nhưng chất lượng tương đương: giáo viên bản ngữ, chương trình UK, IELTS đầu ra 6.0-8.0, Leader in Me bản quyền Franklin Covey." } },
      { "@type": "Question", "name": "Có phải đóng thêm phí khi thi IELTS tại trường không?", "acceptedAnswer": { "@type": "Answer", "text": "Chi phí luyện IELTS chuyên sâu lớp 10-12 đã tích hợp trong học phí. Lệ phí thi IELTS theo quy định IDP/British Council, học sinh trường được hỗ trợ ưu đãi." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://truongvietanh.com" },
      { "@type": "ListItem", "position": 2, "name": "Học phí", "item": "https://truongvietanh.com/hoc-phi" }
    ]
  }
];
---

<BaseLayout
  title={cmsPage?.title || "Học Phí Trường Việt Anh 2026 – Mầm Non Đến THPT"}
  description={cmsPage?.description || "Học phí Trường Việt Anh 2026: bảng phí chi tiết Mầm non đến THPT. Minh bạch, không phí ẩn. Học bổng lên đến 50%. Đăng ký tư vấn miễn phí."}
  canonical="https://truongvietanh.com/hoc-phi"
  ogImage="https://media.truongvietanh.com/images/extra-giao-vien-va-hoc-sinh-2.webp"
  structuredData={structuredData}
>
  <div class="gi-page">
    <HeaderBase />

    <!-- ====== HERO WITH FORM ====== -->
    <section class="gi-hero">
      <div class="gi-container gi-hero-inner">
        <div class="gi-hero-left">
          <nav class="gi-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Trang chủ</a>
            <span aria-hidden="true">/</span>
            <span>Học phí</span>
          </nav>

          <h1 class="gi-h1">Học Phí Trường Việt Anh: Chất Lượng Quốc Tế, Học Phí Phù Hợp</h1>
          <p class="gi-subtitle">Minh bạch — Không phí ẩn — Đầu tư xứng đáng cho tương lai con</p>
          <p class="gi-last-updated">Cập nhật lần cuối: Tháng 4, 2026</p>

          <div class="gi-hero-rating">
            <span class="gi-stars" aria-label="4.9 trên 5 sao">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            <span class="gi-rating-text">4.9/5 (300+ đánh giá)</span>
          </div>

          <div class="gi-trust-badges">
            <div class="gi-badge"><strong>5-12tr</strong> /tháng</div>
            <div class="gi-badge"><strong>100%</strong> Tiếng Anh</div>
            <div class="gi-badge"><strong>Không</strong> phí ẩn</div>
            <div class="gi-badge"><strong>Học bổng</strong> lên đến 50%</div>
          </div>
        </div>

        <div class="gi-hero-right">
          <div class="gi-form-card">
            <p class="gi-form-heading">Nhận bảng học phí chi tiết & tư vấn miễn phí</p>
            <LeadFormTwoStepEmailFirst
              formId="hoc-phi-form"
              funnelCode="hoc-phi-pillar"
              schoolLevel="tieu-hoc"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ====== TOC SIDEBAR + CONTENT ====== -->
    <div class="gi-container gi-body">
      <p class="gi-last-updated">Cập nhật lần cuối: Tháng 4/2026</p>
      <!-- Sticky TOC sidebar -->
      <nav class="gi-toc" aria-label="Mục lục">
        <p class="gi-toc-title">Mục lục</p>
        <ol class="gi-toc-list">
          <li><a href="#tinh-hoc-phi">Tính học phí ước lượng</a></li>
          <li><a href="#bang-phi">Bảng học phí theo cấp</a></li>
          <li><a href="#bao-gom">Học phí bao gồm gì</a></li>
          <li><a href="#so-sanh">So sánh với trường khác</a></li>
          <li><a href="#hoc-bong">Học bổng & ưu đãi</a></li>
          <li><a href="#roi">Đầu tư có xứng đáng</a></li>
          <li><a href="#danh-gia">Phụ huynh nói gì</a></li>
          <li><a href="#faq">Câu hỏi thường gặp</a></li>
        </ol>
        <a href="#hoc-phi-form-hoc-phi-pillar" class="gi-toc-cta">Nhận bảng phí chi tiết</a>
      </nav>

      <!-- Main content -->
      <article class="gi-main">

        <!-- Tuition Calculator -->
        <section id="tinh-hoc-phi" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="10" x2="10" y2="10"/><line x1="12" y1="10" x2="14" y2="10"/><line x1="8" y1="14" x2="10" y2="14"/><line x1="12" y1="14" x2="16" y2="14"/><line x1="8" y1="18" x2="16" y2="18"/></svg></span>Tính Học Phí Ước Lượng</h2>
          <p>Chọn cấp học và ưu đãi để xem mức học phí ước tính hàng tháng. Đây là mức tham khảo — liên hệ tư vấn để nhận bảng phí chi tiết theo cơ sở.</p>

          <div class="calc-box" id="calcBox">
            <div class="calc-row">
              <label class="calc-label">Cấp học</label>
              <select id="calcLevel" class="calc-select">
                <option value="0">— Chọn cấp học —</option>
                <option value="5000000">Mầm Non (18 tháng – 3 tuổi)</option>
                <option value="6000000">Mầm Non (3 – 6 tuổi)</option>
                <option value="7000000">Tiểu Học (Lớp 1-5)</option>
                <option value="9000000">THCS (Lớp 6-9)</option>
                <option value="11000000">THPT (Lớp 10-12)</option>
              </select>
            </div>
            <div class="calc-row">
              <label class="calc-label">Ưu đãi</label>
              <div class="calc-checks">
                <label class="calc-check"><input type="checkbox" id="calcEarly" /> Early Bird (giảm 15%)</label>
                <label class="calc-check"><input type="checkbox" id="calcSibling" /> Anh/chị em (giảm 10%)</label>
              </div>
            </div>
            <div class="calc-result" id="calcResult">
              <span class="calc-result__label">Học phí ước tính/tháng:</span>
              <span class="calc-result__value" id="calcValue">—</span>
              <span class="calc-result__note" id="calcNote"></span>
            </div>
          </div>
          <p style="font-size:0.85rem;color:#94a3b8;margin-top:0.75rem;">* Mức phí ước lượng. Liên hệ <a href="tel:0916961409" style="color:#D4A843">0916 961 409</a> để nhận bảng phí chính xác theo cơ sở.</p>
        </section>

        <script is:inline>
        (function(){
          var level=document.getElementById('calcLevel');
          var early=document.getElementById('calcEarly');
          var sibling=document.getElementById('calcSibling');
          var val=document.getElementById('calcValue');
          var note=document.getElementById('calcNote');
          function calc(){
            var base=parseInt(level.value);
            if(!base){val.textContent='—';note.textContent='';return;}
            var disc=0;var labels=[];
            if(early.checked){disc+=0.15;labels.push('Early Bird -15%');}
            if(sibling.checked){disc+=0.10;labels.push('Anh/chị em -10%');}
            var final=Math.round(base*(1-disc));
            val.textContent=final.toLocaleString('vi-VN')+'đ';
            if(disc>0){
              var saved=base-final;
              note.textContent='Tiết kiệm '+saved.toLocaleString('vi-VN')+'đ/tháng ('+labels.join(' + ')+')';
            } else {note.textContent='';}
          }
          level.addEventListener('change',calc);
          early.addEventListener('change',calc);
          sibling.addEventListener('change',calc);
        })();
        </script>

        <!-- Section 1: Bảng học phí -->
        <section id="bang-phi" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg></span>Học phí Trường Việt Anh bao nhiêu 1 tháng?</h2>
          <p>Học phí Trường Việt Anh dao động từ <strong>5 đến 12 triệu đồng mỗi tháng</strong> tuỳ theo cấp học và cơ sở. Đây là mức học phí phù hợp cho gia đình Việt Nam — chỉ bằng 1/3 so với trường quốc tế — nhưng chất lượng giáo dục tương đương: giáo viên bản ngữ, 100% tiếng Anh, chương trình chuẩn UK Curriculum. Tìm hiểu thêm về <a href="/gioi-thieu">triết lý giáo dục</a> và <a href="/cap-hoc">chương trình các cấp học</a> tại Trường Việt Anh.</p>
          <p>Trường Việt Anh cam kết <strong>minh bạch tuyệt đối</strong> về học phí. Tất cả khoản phí được công bố rõ ràng ngay từ đầu — phụ huynh không bao giờ bị bất ngờ bởi phí phát sinh. Mức học phí dưới đây đã bao gồm phần lớn chi phí: học chính khoá, ăn bán trú, ngoại khoá cơ bản và bảo hiểm.</p>

          <img src="https://media.truongvietanh.com/images/giao-vien-20.webp" alt="Cơ sở vật chất hiện đại Trường Việt Anh" loading="lazy" width="1200" height="auto" class="section-img" />

          <div class="gi-comparison-box">
            <h3>Bảng học phí theo cấp học — Năm học 2026-2027</h3>
            <div class="gi-table-responsive">
              <table class="gi-table">
                <thead>
                  <tr>
                    <th>Cấp học</th>
                    <th>Độ tuổi</th>
                    <th>Học phí/tháng</th>
                    <th>Đặc điểm chương trình</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Mầm non</td>
                    <td>2-6 tuổi</td>
                    <td><strong>5 - 8 triệu</strong></td>
                    <td>100% tiếng Anh immersion, giáo viên bản ngữ, PDR, SAM Math</td>
                  </tr>
                  <tr>
                    <td>Tiểu học</td>
                    <td>6-11 tuổi</td>
                    <td><strong>6 - 9 triệu</strong></td>
                    <td>UK Curriculum, IELTS foundation, STEAM, Coding từ lớp 3</td>
                  </tr>
                  <tr>
                    <td>THCS</td>
                    <td>11-15 tuổi</td>
                    <td><strong>7 - 10 triệu</strong></td>
                    <td>IELTS chuyên sâu, định hướng nghề nghiệp, CLB ngoại khoá</td>
                  </tr>
                  <tr>
                    <td>THPT</td>
                    <td>15-18 tuổi</td>
                    <td><strong>8 - 12 triệu</strong></td>
                    <td>IELTS 6.5-8.0, SAT/ACT, tư vấn du học, A-Level</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div class="gi-evidence-bar">
            <div class="gi-evidence-item">
              <strong>5-12tr</strong>
              <span>Học phí/tháng tất cả cấp</span>
            </div>
            <div class="gi-evidence-item">
              <strong>1/3</strong>
              <span>So với trường quốc tế</span>
            </div>
            <div class="gi-evidence-item">
              <strong>0</strong>
              <span>Phí ẩn phát sinh</span>
            </div>
            <div class="gi-evidence-item">
              <strong>Lên đến 50%</strong>
              <span>Học bổng xuất sắc</span>
            </div>
          </div>

          <p>Mức học phí cụ thể có thể khác nhau giữa các cơ sở do điều kiện cơ sở vật chất và vị trí địa lý khác nhau. Phụ huynh vui lòng liên hệ phòng tuyển sinh hoặc điền form để nhận bảng học phí chi tiết theo cơ sở mà gia đình quan tâm. Đội ngũ tư vấn sẽ gửi thông tin trong vòng 24 giờ.</p>
        </section>

        <!-- Section 2: Học phí bao gồm gì -->
        <section id="bao-gom" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></span>Học phí bao gồm những gì?</h2>
          <p>Một trong những điểm khác biệt lớn nhất của Trường Việt Anh so với nhiều trường tư thục khác là <strong>học phí đã bao gồm phần lớn chi phí</strong>. Phụ huynh không cần đóng thêm hàng loạt phí phát sinh như: phí ngoại ngữ, phí ngoại khoá cơ bản, phí ăn trưa, hay phí tài liệu học tập. Tất cả đã nằm trong một mức học phí duy nhất.</p>

          <div class="gi-leader-grid">
            <div class="gi-leader-card">
              <h4>Bao gồm trong học phí</h4>
              <ul>
                <li><strong>Chương trình chính khoá:</strong> Toàn bộ môn học theo Bộ GD&ĐT kết hợp UK Curriculum — Toán, Khoa học, Xã hội, Thể dục, Âm nhạc, Mỹ thuật</li>
                <li><strong>Tiếng Anh với giáo viên bản ngữ:</strong> 100% thời gian trong lớp, không tính phí riêng cho chương trình tiếng Anh chuyên sâu</li>
                <li><strong>Ăn bán trú dinh dưỡng:</strong> Ăn trưa + 2 bữa phụ (snack sáng và chiều). Thực đơn do chuyên gia dinh dưỡng thiết kế, thay đổi hàng ngày</li>
                <li><strong>Hoạt động ngoại khoá cơ bản:</strong> Bơi lội, thể thao, nghệ thuật, CLB sách, dự án nhóm, trải nghiệm thực tế</li>
                <li><strong>Tài liệu học tập:</strong> Sách giáo khoa, vở bài tập, đồ dùng học tập trong lớp</li>
                <li><strong>Bảo hiểm:</strong> Bảo hiểm tai nạn và y tế cơ bản trong thời gian tại trường</li>
                <li><strong>Hệ thống PDR:</strong> Báo cáo phát triển cá nhân hàng tháng, không phí riêng</li>
              </ul>
            </div>
            <div class="gi-leader-card">
              <h4>Phí bổ sung (tuỳ chọn)</h4>
              <ul>
                <li><strong>Xe đưa rước:</strong> 800.000 - 1.500.000 đồng/tháng (tuỳ khoảng cách). Xe có camera, GPS, phụ xe chuyên trách</li>
                <li><strong>Đồng phục:</strong> 1 - 2 triệu đồng (mua 1 lần đầu năm). Bao gồm áo, quần, giày thể thao</li>
                <li><strong>CLB nâng cao:</strong> 500.000 - 1.500.000 đồng/tháng. Piano, guitar, bóng đá chuyên nghiệp, robotics nâng cao, dance</li>
                <li><strong>Afterschool:</strong> Phí bổ sung hợp lý cho giờ trông trẻ kéo dài đến 17:30</li>
                <li><strong>Chuyến trải nghiệm:</strong> Phí theo từng chuyến (dã ngoại, tham quan doanh nghiệp, trại hè)</li>
              </ul>
            </div>
          </div>

          <p>Điểm quan trọng: <strong>KHÔNG có phí ẩn</strong>. Phụ huynh sẽ nhận bảng phí chi tiết ngay từ đầu với tất cả khoản phí bắt buộc và tuỳ chọn được liệt kê rõ ràng. Không có tình trạng "đóng phí rồi mới biết còn phải đóng thêm" như một số trường khác. Đây là cam kết minh bạch tài chính mà Trường Việt Anh luôn tuân thủ từ ngày thành lập.</p>
          <p>So sánh nhanh: Tại nhiều trường tư thục, học phí công bố là 3-5 triệu/tháng nhưng phụ huynh phải đóng thêm: phí tiếng Anh riêng (1-2 triệu), phí ngoại khoá (500.000-1 triệu), phí ăn trưa riêng, phí tài liệu... Tổng thực tế lên đến 7-9 triệu. Tại Việt Anh, mức 5-12 triệu đã là <strong>tổng tất cả</strong> — phụ huynh biết chính xác số tiền cần đóng mỗi tháng.</p>
        </section>

        <!-- Section 3: So sánh với trường khác -->
        <section id="so-sanh" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg></span>So sánh học phí Việt Anh với các trường khác tại TP.HCM</h2>
          <p>Phụ huynh thường so sánh Trường Việt Anh với 3 loại hình trường khác: công lập, tư thục thông thường và quốc tế. Theo quy định của <a href="https://moet.gov.vn" target="_blank" rel="noopener">Bộ Giáo dục và Đào tạo</a>, chương trình giáo dục phổ thông phải đảm bảo chuẩn đầu ra quốc gia — Trường Việt Anh đáp ứng 100% yêu cầu này, đồng thời tích hợp chương trình <a href="https://www.cambridgeinternational.org" target="_blank" rel="noopener">Cambridge International</a>. Bảng so sánh dưới đây giúp phụ huynh có cái nhìn tổng quan về giá trị thực sự mà mỗi mức học phí mang lại — không chỉ về số tiền mà còn về chất lượng giáo dục con nhận được.</p>

          <div class="gi-comparison-box">
            <h3>So sánh toàn diện: Việt Anh vs Công lập vs Tư thục khác vs Quốc tế</h3>
            <div class="gi-table-responsive">
              <table class="gi-table">
                <thead>
                  <tr>
                    <th>Tiêu chí</th>
