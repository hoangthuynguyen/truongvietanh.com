                    <th>Quốc tế</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Học phí/tháng</td>
                    <td>1-2 triệu</td>
                    <td>3-7 triệu</td>
                    <td><strong>5-12 triệu</strong></td>
                    <td>15-40 triệu</td>
                  </tr>
                  <tr>
                    <td>Tiếng Anh trong lớp</td>
                    <td>2-4 giờ/tuần</td>
                    <td>4-8 giờ/tuần</td>
