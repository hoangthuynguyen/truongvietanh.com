                  </tr>
                  <tr>
                    <td>Chương trình quốc tế</td>
                    <td>Không</td>
                    <td>Một phần</td>
                    <td><strong>UK Curriculum</strong></td>
                    <td>IB / Cambridge</td>
                  </tr>
                  <tr>
                    <td>IELTS khi tốt nghiệp</td>
                    <td>Không</td>
                    <td>4.0-5.0</td>
                    <td><strong>6.5-8.0</strong></td>
                    <td>6.5-8.0</td>
                  </tr>
                  <tr>
                    <td>Phí ngoại khoá</td>
                    <td>Riêng</td>
                    <td>Riêng</td>
                    <td><strong>Bao gồm (cơ bản)</strong></td>
                    <td>Riêng</td>
                  </tr>
                  <tr>
                    <td>Sĩ số lớp</td>
                    <td>40-50</td>
                    <td>30-40</td>
