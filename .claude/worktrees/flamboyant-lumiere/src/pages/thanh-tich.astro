---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import { getPillarPage } from '../lib/directus';

const cmsPage = await getPillarPage('thanh-tich');
const cmsFaqs = cmsPage?.faq_items || null;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Trường Việt Anh",
    "alternateName": "Trường Liên Cấp Việt Anh",
    "url": "https://truongvietanh.com",
    "logo": "https://truongvietanh.com/logo-crest-80.webp",
    "foundingDate": "2011",
    "description": "Hệ thống giáo dục liên cấp song ngữ từ Mầm non đến THPT tại TP.HCM, Long An, Kiên Giang. Thành tích nổi bật: IELTS trung bình 6.5, 99% đậu đại học, 30%+ du học quốc tế.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Hồ Chí Minh",
      "addressCountry": "VN"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "bestRating": "5",
      "ratingCount": "300"
    },
    "numberOfEmployees": { "@type": "QuantitativeValue", "value": 500 },
    "areaServed": ["TP. Hồ Chí Minh", "Long An", "Kiên Giang"],
    "alumni": {
      "@type": "EducationalOccupationalCredential",
      "credentialCategory": "IELTS",
      "recognizedBy": { "@type": "Organization", "name": "British Council" }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Điểm IELTS trung bình của học sinh Trường Việt Anh là bao nhiêu?",
        "acceptedAnswer": { "@type": "Answer", "text": "Điểm IELTS trung bình đầu ra THPT của học sinh Trường Việt Anh là 6.5, với học sinh cao nhất đạt 8.5. Hơn 85% học sinh đạt IELTS 6.0+ khi tốt nghiệp lớp 12." }
      },
      {
        "@type": "Question",
        "name": "Tỷ lệ đậu tuyển sinh lớp 10 THPT của Trường Việt Anh là bao nhiêu?",
        "acceptedAnswer": { "@type": "Answer", "text": "99% học sinh Trường Việt Anh đậu kỳ thi tuyển sinh lớp 10 THPT công lập, trong đó nhiều em trúng tuyển các trường chuyên top đầu tại TP.HCM." }
      },
      {
        "@type": "Question",
        "name": "Học sinh Trường Việt Anh có đạt giải quốc gia không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Có, học sinh Trường Việt Anh đã đạt hơn 200 giải thưởng cấp quốc gia và quốc tế trong các lĩnh vực Olympic Tiếng Anh, STEM, Toán học, và các cuộc thi nghệ thuật." }
      },
      {
        "@type": "Question",
        "name": "Tỷ lệ đậu đại học của Trường Việt Anh là bao nhiêu?",
        "acceptedAnswer": { "@type": "Answer", "text": "99% học sinh Trường Việt Anh trúng tuyển đại học, trong đó hơn 30% nhận học bổng du học tại Mỹ, Úc, Anh, Canada, Nhật Bản và Hàn Quốc." }
      },
      {
        "@type": "Question",
        "name": "Trường Việt Anh có những hoạt động ngoại khóa nào?",
        "acceptedAnswer": { "@type": "Answer", "text": "Trường có hơn 30 câu lạc bộ ngoại khóa bao gồm bóng đá, bơi lội, robotics, hội họa, nhạc cụ, hùng biện tiếng Anh, và hoạt động phục vụ cộng đồng hàng tháng." }
      },
      {
        "@type": "Question",
        "name": "Cựu học sinh Trường Việt Anh hiện đang làm gì?",
        "acceptedAnswer": { "@type": "Answer", "text": "Cựu học sinh Trường Việt Anh đang theo học và làm việc tại hơn 15 quốc gia trên thế giới, nhiều em giữ vị trí quản lý tại các tập đoàn đa quốc gia hoặc khởi nghiệp thành công." }
      },
      {
        "@type": "Question",
        "name": "Làm sao để xem thành tích chi tiết và đăng ký tham quan?",
        "acceptedAnswer": { "@type": "Answer", "text": "Quý phụ huynh có thể đăng ký trực tuyến tại trang web hoặc gọi 0916 961 409 để được tư vấn và sắp xếp lịch tham quan miễn phí." }
      },
      { "@type": "Question", "name": "Trường có chính sách khen thưởng học sinh giỏi không?", "acceptedAnswer": { "@type": "Answer", "text": "Có. Học bổng xuất sắc giảm 20-100% học phí, Bảng vinh danh hàng tháng, Giải Leader of the Month, tài trợ thi Olympic/IELTS, và Quỹ hỗ trợ du học." } },
      { "@type": "Question", "name": "Tỷ lệ học sinh đỗ đại học là bao nhiêu?", "acceptedAnswer": { "@type": "Answer", "text": "99% đỗ đại học nguyện vọng 1. 30% nhận học bổng du học tại Úc, Mỹ, Anh, Canada, Nhật, Singapore." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://truongvietanh.com" },
      { "@type": "ListItem", "position": 2, "name": "Thành tích", "item": "https://truongvietanh.com/thanh-tich" }
    ]
  }
];
---

<BaseLayout
  title={cmsPage?.title || "Thành Tích Trường Việt Anh — Kết Quả Nổi Bật Qua Các Năm"}
  description={cmsPage?.description || "Thành tích Trường Việt Anh: IELTS trung bình 6.5, 99% đậu đại học, 200+ giải quốc gia & quốc tế, 30% du học. Xem kết quả nổi bật từ 2011 đến nay."}
  canonical="https://truongvietanh.com/thanh-tich"
  ogImage="https://media.truongvietanh.com/images/extra-Than-Huong-Giang-11A3.webp"
  structuredData={structuredData}
>
  <div class="gi-page">
    <HeaderBase />

    <!-- ====== HERO WITH FORM ====== -->
    <section class="gi-hero">
      <div class="gi-container gi-hero-inner">
        <div class="gi-hero-left">
          <nav class="gi-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Trang chủ</a>
            <span aria-hidden="true">/</span>
            <span>Thành tích</span>
          </nav>

          <h1 class="gi-h1">Thành Tích Trường Việt Anh: Kết Quả Nổi Bật Qua Các Năm Học</h1>
          <p class="gi-subtitle">13 năm xây dựng — Hàng nghìn học sinh thành công</p>
          <p class="gi-last-updated">Cập nhật lần cuối: Tháng 4, 2026</p>

          <div class="gi-hero-rating">
            <span class="gi-stars" aria-label="4.9 trên 5 sao">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            <span class="gi-rating-text">4.9/5 (300+ đánh giá)</span>
          </div>

          <div class="gi-trust-badges">
            <div class="gi-badge"><strong>IELTS 6.5</strong> trung bình</div>
            <div class="gi-badge"><strong>99%</strong> đậu ĐH</div>
            <div class="gi-badge"><strong>200+</strong> giải thưởng</div>
            <div class="gi-badge"><strong>12.000+</strong> học sinh</div>
          </div>
        </div>

        <div class="gi-hero-right">
          <div class="gi-form-card">
            <p class="gi-form-heading">Nhận hồ sơ thành tích & Đăng ký tham quan miễn phí</p>
            <LeadFormTwoStepEmailFirst
              formId="thanh-tich-form"
              funnelCode="thanh-tich-pillar"
              schoolLevel="lien-cap"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ====== TOC SIDEBAR + CONTENT ====== -->
    <div class="gi-container gi-body">
      <p class="gi-last-updated">Cập nhật lần cuối: Tháng 4/2026</p>
      <!-- Sticky TOC sidebar -->
      <nav class="gi-toc" aria-label="Mục lục">
        <p class="gi-toc-title">Mục lục</p>
        <ol class="gi-toc-list">
          <li><a href="#hoc-thuat">Thành tích học thuật</a></li>
          <li><a href="#tuyen-sinh-10">Thi tuyển sinh lớp 10</a></li>
          <li><a href="#quoc-gia-quoc-te">Cuộc thi quốc gia & quốc tế</a></li>
          <li><a href="#dai-hoc-du-hoc">Đậu đại học & du học</a></li>
          <li><a href="#ngoai-khoa">Ngoại khóa & kỹ năng</a></li>
          <li><a href="#cuu-hoc-sinh">Cựu học sinh</a></li>
          <li><a href="#faq">Câu hỏi thường gặp</a></li>
        </ol>
        <a href="#thanh-tich-form-thanh-tich-pillar" class="gi-toc-cta">Đăng ký tham quan</a>
      </nav>

      <!-- Main content -->
      <article class="gi-main">

        <!-- Section 1: Thành tích học thuật -->
        <section id="hoc-thuat" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 9H4.5a2.5 2.5 0 010-5H6"/><path d="M18 9h1.5a2.5 2.5 0 000-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20 17 22"/><path d="M18 2H6v7a6 6 0 0012 0V2z"/></svg></span>Thành tích học thuật nổi bật của Trường Việt Anh?</h2>
          <p>Trường Việt Anh là một trong những trường tư thục có kết quả tiếng Anh đầu ra cao nhất tại TP.HCM, với điểm IELTS trung bình đầu ra THPT đạt <strong>6.5</strong> và học sinh cao nhất đạt <strong>8.5</strong>. Hơn 85% học sinh đạt IELTS 6.0 trở lên khi tốt nghiệp lớp 12, tương đương hoặc vượt trội so với nhiều trường quốc tế có mức học phí cao gấp 3-5 lần.</p>
          <p>Kết quả này không đến từ may mắn mà là thành quả của lộ trình tiếng Anh bài bản được xây dựng suốt 13 năm — bắt đầu từ phương pháp Immersion (đắm chìm) ở Mầm non, chuyển sang UK Curriculum ở Tiểu học, và luyện thi IELTS chuyên sâu từ THCS.</p>

          <div class="gi-comparison-box">
            <h3>Kết quả IELTS theo năm học</h3>
            <div class="gi-table-responsive">
              <table class="gi-table">
                <thead>
                  <tr>
                    <th>Năm học</th>
                    <th>Điểm TB</th>
                    <th>Điểm cao nhất</th>
                    <th>Tỷ lệ 6.0+</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>2023-2024</td>
                    <td>6.5</td>
                    <td>8.5</td>
                    <td>87%</td>
                  </tr>
                  <tr>
                    <td>2022-2023</td>
                    <td>6.5</td>
                    <td>8.0</td>
                    <td>85%</td>
                  </tr>
                  <tr>
                    <td>2021-2022</td>
                    <td>6.0</td>
                    <td>8.0</td>
                    <td>82%</td>
                  </tr>
                  <tr>
                    <td>2020-2021</td>
                    <td>6.0</td>
                    <td>7.5</td>
                    <td>78%</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <h3>Chứng chỉ Cambridge cho bậc Tiểu học và THCS</h3>
          <p>Ngoài IELTS, học sinh Trường Việt Anh từ lớp 3 đến lớp 9 tham gia các kỳ thi chứng chỉ Cambridge (Starters, Movers, Flyers, KET, PET). Tỷ lệ đạt chứng chỉ Cambridge hàng năm đạt <strong>95%+</strong>, trong đó hơn 40% đạt mức Distinction (xuất sắc). Đây là nền tảng vững chắc giúp học sinh tự tin bước vào lộ trình IELTS từ lớp 10.</p>

          <h3>Kết quả kỳ thi quốc gia (Bộ GD&ĐT)</h3>
          <p>Bên cạnh chương trình quốc tế, học sinh Trường Việt Anh cũng đạt kết quả ấn tượng trong các kỳ thi theo chuẩn Bộ Giáo dục và Đào tạo. Điểm trung bình tốt nghiệp THPT quốc gia hàng năm của trường <strong>cao hơn mặt bằng chung thành phố 1.5-2.0 điểm</strong>, đặc biệt ở các môn Toán, Tiếng Anh và Ngữ văn.</p>

          <div class="gi-evidence-bar">
            <div class="gi-evidence-item">
              <strong>6.5</strong>
              <span>IELTS trung bình</span>
            </div>
            <div class="gi-evidence-item">
              <strong>8.5</strong>
              <span>IELTS cao nhất</span>
            </div>
            <div class="gi-evidence-item">
              <strong>95%</strong>
              <span>Đạt Cambridge</span>
            </div>
            <div class="gi-evidence-item">
              <strong>85%+</strong>
              <span>IELTS 6.0+</span>
            </div>
          </div>

          <img src="https://media.truongvietanh.com/images/olympic-02.webp" alt="Thành tích học sinh Trường Việt Anh" loading="lazy" width="1200" height="auto" class="section-img" />

          <p>Xem thêm: <a href="/cap-hoc">Chương trình đào tạo theo từng cấp học</a> | <a href="/gioi-thieu">Giới thiệu tổng quan Trường Việt Anh</a></p>
        </section>

        <!-- Section 2: Tuyển sinh lớp 10 -->
        <section id="tuyen-sinh-10" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></span>Kết quả thi tuyển sinh lớp 10 THPT như thế nào?</h2>
          <p>Kỳ thi tuyển sinh lớp 10 THPT công lập tại TP.HCM là một trong những kỳ thi cạnh tranh nhất cả nước, với tỷ lệ chọi trung bình 1 chọi 2. Tại Trường Việt Anh, <strong>99% học sinh đậu kỳ thi tuyển sinh lớp 10</strong>, trong đó hơn 35% trúng tuyển vào các trường chuyên và trường top đầu thành phố.</p>
          <p>Thành tích này phản ánh chất lượng đào tạo toàn diện của trường — không chỉ tập trung vào tiếng Anh mà còn đảm bảo nền tảng Toán, Ngữ văn và các môn khoa học vững chắc theo chuẩn Bộ GD&ĐT.</p>

          <div class="gi-comparison-box">
            <h3>So sánh: Kết quả tuyển sinh lớp 10 — Trường Việt Anh vs Trung bình TP.HCM</h3>
            <div class="gi-table-responsive">
              <table class="gi-table">
                <thead>
                  <tr>
                    <th>Tiêu chí</th>
                    <th>Trung bình TP.HCM</th>
                    <th>Trường Việt Anh</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Tỷ lệ đậu</td>
                    <td>~70%</td>
                    <td>99%</td>
                  </tr>
                  <tr>
                    <td>Vào trường chuyên</td>
                    <td>~5%</td>
                    <td>35%+</td>
                  </tr>
                  <tr>
                    <td>Điểm TB Toán</td>
                    <td>5.5-6.0</td>
                    <td>7.5-8.0</td>
                  </tr>
                  <tr>
                    <td>Điểm TB Tiếng Anh</td>
                    <td>5.0-5.5</td>
                    <td>8.0-8.5</td>
                  </tr>
                  <tr>
                    <td>Điểm TB Ngữ văn</td>
                    <td>5.5-6.0</td>
                    <td>7.0-7.5</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <h3>Những trường top mà học sinh Việt Anh trúng tuyển</h3>
          <p>Qua các năm, học sinh Trường Việt Anh đã trúng tuyển vào nhiều trường THPT hàng đầu tại TP.HCM bao gồm: <strong>THPT Chuyên Lê Hồng Phong, THPT Chuyên Trần Đại Nghĩa, THPT Nguyễn Thượng Hiền, THPT Gia Định, THPT Nguyễn Thị Minh Khai</strong>. Nhiều em cũng lựa chọn ở lại hệ thống Trường Việt Anh để tiếp tục chương trình IELTS chuyên sâu và chuẩn bị du học.</p>

          <p>Đặc biệt, học sinh Trường Việt Anh có lợi thế cạnh tranh vượt trội ở môn Tiếng Anh — với điểm trung bình cao hơn mặt bằng chung 2.5-3.0 điểm. Đây là kết quả trực tiếp của chương trình Immersion English được xây dựng xuyên suốt từ Mầm non đến THCS.</p>

          <p>Xem thêm: <a href="/tuyen-sinh">Thông tin tuyển sinh các cấp</a> | <a href="/cap-hoc">Chi tiết chương trình từng cấp học</a></p>
        </section>

        <!-- Section 3: Cuộc thi quốc gia & quốc tế -->
        <section id="quoc-gia-quoc-te" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg></span>Thành tích tại các cuộc thi quốc gia và quốc tế?</h2>
          <p>Học sinh Trường Việt Anh đã giành được hơn <strong>200 giải thưởng</strong> tại các cuộc thi cấp quốc gia và quốc tế trong nhiều lĩnh vực từ tiếng Anh, STEM, Toán học đến nghệ thuật và thể thao. Trường luôn nằm trong nhóm trường tư thục có nhiều giải thưởng nhất tại khu vực phía Nam.</p>
          <p>Quan điểm của Trường Việt Anh là không ép học sinh thi lấy thành tích, mà tạo điều kiện cho các em phát huy thế mạnh cá nhân và tự tin tham gia các sân chơi trí tuệ trong và ngoài nước.</p>

          <h3>Olympic Tiếng Anh</h3>
          <p>Đây là lĩnh vực thế mạnh nổi bật nhất của Trường Việt Anh. Hàng năm, học sinh của trường đều đạt giải cao tại các cuộc thi: <strong>IOE (International Olympic English), TOEFL Junior Challenge, English Olympiad toàn quốc</strong>. Riêng năm học 2023-2024, trường có <strong>15 học sinh đạt giải cấp quốc gia</strong> và 3 học sinh đại diện Việt Nam tham gia vòng thi quốc tế.</p>

          <h3>STEM và Khoa học</h3>
          <p>Chương trình STEM tại Trường Việt Anh được triển khai từ lớp 1, giúp học sinh sớm tiếp cận tư duy kỹ thuật, lập trình và giải quyết vấn đề. Học sinh đã đạt giải tại các cuộc thi: <strong>Robotics Challenge khu vực ASEAN, Science Fair TP.HCM, Cuộc thi Sáng tạo Khoa học Kỹ thuật cấp quốc gia</strong>. Đặc biệt, đội Robotics của trường 2 năm liên tiếp (2023-2024) lọt vào vòng chung kết quốc gia.</p>

          <img src="https://media.truongvietanh.com/images/du-an-01.webp" alt="Học sinh làm dự án STEM tại Trường Việt Anh" loading="lazy" width="1200" height="auto" class="section-img" />

          <h3>Toán học và Tin học</h3>
          <p>Học sinh Trường Việt Anh tham gia các cuộc thi Toán quốc tế như <strong>SASMO (Singapore and Asian Schools Math Olympiad), AMO (Asian Mathematics Olympiad), Kangaroo Math</strong>. Tổng cộng hơn 50 huy chương vàng, bạc, đồng đã được trao cho học sinh trường trong 3 năm gần nhất.</p>

          <h3>Nghệ thuật và Âm nhạc</h3>
          <p>Không chỉ giỏi học thuật, học sinh Trường Việt Anh còn tỏa sáng trong các cuộc thi nghệ thuật. Đội hợp xướng của trường đạt <strong>Huy chương Vàng tại Liên hoan Hợp xướng Quốc tế</strong>, và nhiều học sinh đạt giải cao tại các cuộc thi vẽ tranh, nhiếp ảnh và sáng tác văn học cấp thành phố.</p>

