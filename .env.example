# ============================================================
# .env.example — copy to .env and fill in
# ============================================================
# Variables consumed by Astro build + local dev.
# Production secrets are stored in Cloudflare Worker env via
#   `wrangler secret put ...` (see docs/cloudflare-setup.md)

# ------------------------------------------------------------
# Public (exposed to browser)
# ------------------------------------------------------------
PUBLIC_SITE_URL=https://truongvietanh.com
PUBLIC_DIRECTUS_URL=http://127.0.0.1:8055
PUBLIC_TURNSTILE_SITEKEY=

# ------------------------------------------------------------
# Build-time (Astro SSG fetches CMS data during build)
# ------------------------------------------------------------
# v1 (legacy directus.ts lib)
DIRECTUS_TOKEN=

# v2 (cms.ts lib + ab-testing.ts)
DIRECTUS_URL=https://cms.truongvietanh.com
DIRECTUS_READ_TOKEN=

# For scripts/seed-directus.ts — admin token with write access
DIRECTUS_ADMIN_TOKEN=

# ------------------------------------------------------------
# Deploy (optional — CI passes these as GitHub secrets)
# ------------------------------------------------------------
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# ------------------------------------------------------------
# Worker secrets — DO NOT commit these. Set via:
#   npx wrangler secret put <NAME> -c wrangler.staging.jsonc
# ------------------------------------------------------------
# GHL_API_KEY=
# PANCAKE_API_KEY=
# PANCAKE_WORKSPACE_ID=
# ZALO_OA_TOKEN=
# ZALO_SALES_USER_ID=
# SALES_EMAIL=
# CC_EMAIL=
# SLACK_HOT_LEAD_WEBHOOK=
# TURNSTILE_SECRET=
