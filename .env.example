# Copy to .env (which is gitignored) and fill in real values.
#
# Cloudflare API token for `wrangler deploy`.
# Permissions required:
#   - Workers Scripts: Edit
#   - Workers R2 Storage: Edit
#   - Zone (truongvietanh.com): Read
#   - Workers Routes: Edit
# Create at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=cfat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Directus CMS URL (public, dùng cho cả asset URLs) + static token (server-only).
# LƯU Ý: token cũ tva_0b80... đã từng bị hard-code trong source (git history) —
# phải thu hồi trong Directus admin và cấp token mới.
PUBLIC_DIRECTUS_URL=http://your-directus-host:8055
DIRECTUS_TOKEN=your_directus_static_token
