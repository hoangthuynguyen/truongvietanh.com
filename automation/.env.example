# ─────────────────────────────────────────────
# VA Content Automation — n8n environment vars
# ─────────────────────────────────────────────
# Copy → `.env`, điền giá trị thật.
# n8n self-host: pass file qua --env-file khi docker run

# ── Anthropic (Claude — ideate + score) ──
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxx

# ── Airtable (DB) ──
AIRTABLE_API_KEY=patxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AIRTABLE_BASE_ID=appxxxxxxxxxxxxxx

# ── Telegram (approval bot) ──
TELEGRAM_BOT_TOKEN=xxxxxxxxx:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_FALLBACK_CHAT_ID=-1001234567890

# ── Publisher (Publer — đề xuất thay Buffer) ──
# Publer API: https://publer.io/api
PUBLER_API_TOKEN=publer_xxxxxxxxxxxxxxxxxxxxxxxx
PUBLER_WORKSPACE_ID=xxxxxxxxxxxxxxxxxx

# ── Facebook Graph (insight + tracker) ──
FB_PAGE_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxx
FB_PAGE_ID=123456789012345

# ── GoHighLevel (CRM attribution) ──
GHL_API_TOKEN=eyJhbGciOiJIUzI1NiJ9.xxxxx
GHL_LOCATION_ID=xxxxxxxxxxxxxxxxxx

# ── Lark (task ekip cho Tier 3) ──
LARK_TENANT_ACCESS_TOKEN=t-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Cloud (Veo 3 via Vertex AI) ──
# gcloud auth print-access-token (refresh mỗi 1h — recommend service account + n8n credential)
GCP_PROJECT_ID=va-content-automation
GCP_ACCESS_TOKEN=ya29.xxxxxxxxxxxxxxxxxxxx

# ── Gemini (nano-banana image generation) ──
# https://ai.google.dev → API Key
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── fal.ai (Kling 2.1 video) ──
# https://fal.ai → Keys
FAL_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:xxxxxxxxxxxxxxxx

# ── HeyGen (avatar Anh Dương — chỉ 1 avatar, không lạm dụng) ──
# https://app.heygen.com/settings/api
HEYGEN_API_KEY=YjxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxXX
HEYGEN_ANH_DUONG_AVATAR_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
HEYGEN_ANH_DUONG_VOICE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── MiniMax (voice clone TTS Vietnamese) ──
# https://www.minimax.io/platform/document
MINIMAX_API_KEY=eyJhbGciOiJSUzI1NiIxxx
MINIMAX_VOICE_ID=anh_duong_clone_v1

# ── Cloudflare R2 (asset storage) ──
# Anh đã có sẵn — xem r2-files-table.csv
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxx
R2_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET=va-content-assets
R2_PUBLIC_DOMAIN=assets.truongvietanh.com
