        <mxCell id="p2-pick" value="🎯 Pick Best + Route&#10;━━━━━━━━━━━&#10;Sort by score_total DESC&#10;Generate utm_content (callback key)&#10;Determine status by tier + format:&#10;• carousel/blog → needs_image&#10;• reel → needs_video&#10;• text → needs_text_only&#10;• Tier 3 → needs_shoot + Lark task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
