        <mxCell id="lane-cron" value="⏰ TRIGGERS (n8n cron)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#78350f;" vertex="1" parent="1">
