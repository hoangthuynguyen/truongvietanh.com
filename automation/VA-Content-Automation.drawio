        <mxCell id="tbl-vc" value="🎙️ voice_cards&#10;━━━━━━━━━━&#10;25 records (1/kênh)&#10;• channel_name&#10;• channel_tier (1/2/2.5/3)&#10;• system_prompt&#10;• telegram_chat_id&#10;• video_engine default&#10;• active checkbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ec4899;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
