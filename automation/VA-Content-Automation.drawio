  <diagram name="2. Pipeline Detail Flow" id="page2">
    <mxGraphModel dx="2400" dy="3000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="2400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p2-title" value="VA Content Automation — Pipeline Detail Flow (00:00 → 07:00+)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;fontColor=#1e3a8a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1320" height="50" as="geometry" />
        </mxCell>

        <mxCell id="p2-cron" value="🕛 Cron 00:00 Daily&#10;0 0 * * *" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="100" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="p2-ks" value="Check Kill Switch&#10;Airtable: system_flags" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="200" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="p2-ksoff" value="off → continue" style="text;html=1;fontSize=10;fontColor=#16a34a;" vertex="1" parent="1">
          <mxGeometry x="810" y="230" width="100" height="20" as="geometry" />
        </mxCell>

        <mxCell id="p2-kson" value="on → STOP&#10;Telegram alert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="900" y="220" width="140" height="40" as="geometry" />
        </mxCell>

        <mxCell id="p2-fvc" value="📦 Fetch Active Voice Cards&#10;GET /airtable/voice_cards&#10;filter: active=TRUE" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fce7f3;strokeColor=#ec4899;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="320" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="p2-fins" value="📦 Fetch Insights Last 24h&#10;GET /airtable/insights&#10;filter: date &gt; NOW-24h" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fce7f3;strokeColor=#ec4899;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="820" y="320" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="p2-pair" value="🧠 Pair Cards × Insights&#10;n8n Code node&#10;Match audience_tags ↔ audience_segment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="430" width="320" height="60" as="geometry" />
        </mxCell>

        <mxCell id="p2-loop" value="🔁 Loop 3 cards parallel&#10;SplitInBatches" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="530" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="p2-ide" value="🤖 Claude Sonnet 4.6&#10;━━━━━━━━━━━━&#10;POST anthropic.com/v1/messages&#10;system: voice_card.system_prompt&#10;user: insights + format mix + CTA pattern&#10;Output: JSON 3 ideas + visual_brief + slide_briefs + video_engine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="500" y="630" width="440" height="120" as="geometry" />
        </mxCell>

        <mxCell id="p2-hr" value="✅ Hard Rules Check&#10;━━━━━━━━━━━&#10;• forbidden_words&#10;• unverified claim (số 1, %, top)&#10;• length per format&#10;• missing CTA&#10;• child mention → flag consent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="790" width="360" height="120" as="geometry" />
        </mxCell>

        <mxCell id="p2-ifp" value="Pass ≥1 idea?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="950" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="p2-fail" value="No → back to Loop&#10;(retry next card)" style="text;html=1;fontSize=10;fontColor=#dc2626;" vertex="1" parent="1">
          <mxGeometry x="820" y="975" width="160" height="30" as="geometry" />
        </mxCell>

        <mxCell id="p2-score" value="🤖 Claude Haiku 4.5&#10;━━━━━━━━━━━━&#10;Soft score 4 dimensions:&#10;brand_fit / insight_depth / conversion / education&#10;0-5 each → total 0-20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="500" y="1070" width="440" height="100" as="geometry" />
