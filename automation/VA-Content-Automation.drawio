        <mxCell id="wf05-box" value="⚙️ 05 Asset Generator&#10;━━━━━━━━━━━━━━━━━&#10;⏰ */10 min (00:10–06:50)&#10;&#10;• Poll needs_image/video&#10;• Veo 3 / Kling / HeyGen&#10;• nano-banana (image)&#10;• MiniMax (voiceover)&#10;&#10;→ R2 upload + ready_for_review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=3;align=left;verticalAlign=top;fontSize=12;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
