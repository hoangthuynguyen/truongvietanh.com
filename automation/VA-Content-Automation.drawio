        <mxCell id="wf06-box" value="📢 06 Review Dispatcher&#10;━━━━━━━━━━━━━━━━━&#10;⏰ Daily 06:55&#10;&#10;• Fetch ready_for_review&#10;• Morning summary&#10;• Send Telegram + 3 buttons&#10;• Throttle 3s/msg&#10;&#10;→ pending_review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cffafe;strokeColor=#06b6d4;strokeWidth=3;align=left;verticalAlign=top;fontSize=12;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="970" y="150" width="290" height="220" as="geometry" />
        </mxCell>

        <mxCell id="wf02-box" value="☀️ 02 Approval Callback&#10;━━━━━━━━━━━━━━━━━&#10;🔔 Telegram webhook&#10;&#10;• Parse callback data&#10;• ✅ Duyệt → Publer publish&#10;• ✏️ Sửa → status=editing&#10;• ❌ Bỏ → training data&#10;&#10;→ published / editing / rejected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;strokeWidth=3;align=left;verticalAlign=top;fontSize=12;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
