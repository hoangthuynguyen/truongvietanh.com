        <mxCell id="wf03-box" value="📡 03 Insight Harvester&#10;━━━━━━━━━━━━━━━━━&#10;⏰ Every 2 hours&#10;&#10;• Google Trends VN&#10;• GHL form submits&#10;• FB owned comments&#10;&#10;→ insights table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;strokeWidth=2;align=left;verticalAlign=top;fontSize=12;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
