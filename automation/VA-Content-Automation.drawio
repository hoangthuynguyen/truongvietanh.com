        </mxCell>

        <mxCell id="wf01-box" value="🕛 01 Content Master&#10;━━━━━━━━━━━━━━━━━&#10;⏰ Daily 00:00&#10;&#10;• Kill switch check&#10;• Ideate (Claude Sonnet 4.6)&#10;• Hard rules + Soft score&#10;• Route by tier 1/2/2.5/3&#10;&#10;→ content_pipeline (needs_*)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;strokeWidth=3;align=left;verticalAlign=top;fontSize=12;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
