{
  "name": "truongvietanh.com",
  "version": "1.0.0",
  "description": "Astro static frontend for truongvietanh.com connected to a Directus backend and deployable on Cloudflare Workers Static Assets.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "smoke": "BASE_URL=${BASE_URL:-https://truongvietanh.com} node scripts/smoke-test.mjs",
    "legacy:audit": "node scripts/legacy-to-v2.mjs",
    "deploy:v2": "ENV=prod node scripts/deploy-v2.mjs",
    "deploy": "npm run build && npx wrangler deploy -c wrangler.jsonc",
    "deploy:prod": "npm run build && npx wrangler deploy -c wrangler.jsonc",
    "directus:up": "docker compose -f directus/docker-compose.yml up -d",
    "directus:down": "docker compose -f directus/docker-compose.yml down",
    "directus:setup": "node scripts/setup-directus.mjs",
    "directus:setup:blocks": "echo '[DEPRECATED] Use directus:setup:m2a instead' && node scripts/setup-directus-blocks.mjs",
    "directus:setup:m2a": "node scripts/setup-directus-m2a-foundation.mjs",
    "directus:seed:pages:m2a": "node scripts/seed-directus-static-pages-m2a.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoangthuynguyen/truongvietanh.com.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/hoangthuynguyen/truongvietanh.com/issues"
  },
  "homepage": "https://github.com/hoangthuynguyen/truongvietanh.com#readme",
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@directus/sdk": "^21.2.0",
    "astro": "^6.1.5",
    "axios": "^1.13.6",
    "cheerio": "^1.2.0",
    "csv-parser": "^3.2.0",
    "csv-writer": "^1.6.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.76.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@playwright/test": "^1.59.1",
    "@vitest/coverage-v8": "^4.1.4",
    "vitest": "^4.1.4"
  }
}
