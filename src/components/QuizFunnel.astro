---
/**
 * QuizFunnel — Interactive 6-question quiz + lead form
 *
 * Flow: Start screen → 6 questions (1 per step) → Score result → Lead form → Success/redirect
 * All state managed client-side. No JS framework dependency.
 *
 * Props come from the CMS trai_he_squeeze_pages record.
 */
type QuizOption = { label: string; score: number };
type QuizQuestion = { question: string; options: QuizOption[] };
type QuizResult = { range: string; title: string; description: string; color: string };

type Props = {
  quizTitle: string;
  quizSubtitle: string;
  questions: QuizQuestion[];
  results: QuizResult[];
  quizIntroItems: string[];
  formHeading: string;
  formDescription: string;
  formSubmitText: string;
  funnelCode: string;
  schoolLevel: string;
  location: string;
  camOnUrl: string;
};

const {
  quizTitle,
  quizSubtitle,
  questions,
  results,
  quizIntroItems,
  formHeading,
  formDescription,
  formSubmitText,
  funnelCode,
  schoolLevel,
  location,
  camOnUrl,
} = Astro.props;

const quizId = `quiz-${funnelCode}`;
---

<div class="quiz-funnel" id={quizId} data-cam-on-url={camOnUrl} data-funnel-code={funnelCode} data-school-level={schoolLevel}>

  <!-- ===== STEP 0: Start Screen ===== -->
  <div class="qf-step qf-step--start" data-qf-step="start">

    <!-- Benefits banner — above the fold, visible before scrolling -->
    <div class="qf-benefits-banner">
      <div class="qf-benefits-banner__title">🎁 Làm bài đánh giá để nhận:</div>
      <div class="qf-benefits-banner__items">
        <span>📋 Báo cáo EQ cá nhân hóa PDF</span>
        <span>💸 Học bổng Early Bird đến 30%</span>
        <span>📞 Tư vấn lộ trình miễn phí 1:1</span>
      </div>
    </div>

    <div class="qf-start-badge">
      <span>📋</span> Bài đánh giá — Chỉ 3 phút
    </div>
    <h2 class="qf-start-title">{quizTitle}</h2>
    <p class="qf-start-subtitle">{quizSubtitle}</p>

    <ul class="qf-start-checklist">
      {quizIntroItems.map((item) => (
        <li><span class="qf-check">✓</span> {item}</li>
      ))}
    </ul>

    <button class="qf-btn qf-btn--start" data-qf-action="start">
      🎯 Bắt đầu đánh giá ngay
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </button>

    <div class="qf-start-meta">
      <span>🔒 Bảo mật thông tin</span>
      <span>⚡ Kết quả ngay lập tức</span>
    </div>
  </div>

  <!-- ===== STEPS 1-6: Questions ===== -->
  {questions.map((q, i) => (
    <div class="qf-step qf-step--question" data-qf-step={`q${i + 1}`} hidden>
      <!-- Progress bar -->
      <div class="qf-progress">
        <div class="qf-progress__bar">
          <div class="qf-progress__fill" style={`width: ${((i + 1) / (questions.length + 1)) * 100}%`}></div>
        </div>
        <div class="qf-progress__text">Câu {i + 1}/{questions.length}</div>
      </div>

      <h3 class="qf-question">{q.question}</h3>

      <div class="qf-options">
        {q.options.map((opt, j) => (
          <button
            class="qf-option"
            data-qf-action="answer"
            data-qf-score={opt.score}
            data-qf-next={i < questions.length - 1 ? `q${i + 2}` : 'result'}
          >
            <span class="qf-option__letter">{String.fromCharCode(65 + j)}</span>
            <span class="qf-option__text">{opt.label}</span>
          </button>
        ))}
      </div>

      {i > 0 && (
        <button class="qf-back" data-qf-action="back" data-qf-prev={i === 0 ? 'start' : `q${i}`}>
          ← Quay lại
        </button>
      )}
    </div>
  ))}

  <!-- ===== STEP: Result ===== -->
  <div class="qf-step qf-step--result" data-qf-step="result" hidden>
    <div class="qf-progress">
      <div class="qf-progress__bar">
        <div class="qf-progress__fill" style="width: 100%"></div>
      </div>
      <div class="qf-progress__text">Hoàn thành!</div>
    </div>

    <div class="qf-result-icon">📊</div>
    <h3 class="qf-result-title" id={`${quizId}-result-title`}>Đang tính điểm...</h3>
    <div class="qf-result-score">
      <span class="qf-result-score__number" id={`${quizId}-result-score`}>--</span>
      <span class="qf-result-score__max">/ 100 điểm</span>
    </div>
    <p class="qf-result-desc" id={`${quizId}-result-desc`}></p>

    <!-- Score bar visualization -->
    <div class="qf-score-bar">
      <div class="qf-score-bar__track">
        <div class="qf-score-bar__fill" id={`${quizId}-score-fill`}></div>
      </div>
      <div class="qf-score-bar__labels">
        <span>Cần cải thiện</span>
        <span>Trung bình</span>
        <span>Tốt</span>
      </div>
    </div>

    <div class="qf-result-cta">
      <p class="qf-result-cta__text">👇 Nhận <strong>Báo cáo chi tiết PDF</strong> + <strong>Học bổng đến 30%</strong> qua Zalo/Email</p>
      <button class="qf-btn qf-btn--result" data-qf-action="show-form">
        Nhận báo cáo & học bổng ngay
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </button>
    </div>
  </div>

  <!-- ===== STEP: Lead Form ===== -->
  <div class="qf-step qf-step--form" data-qf-step="form" hidden>
    <div class="qf-progress">
      <div class="qf-progress__bar">
        <div class="qf-progress__fill" style="width: 100%"></div>
      </div>
      <div class="qf-progress__text">Bước cuối — Nhận báo cáo!</div>
    </div>

    <div class="qf-form-header">
      <div class="qf-form-score-recap">
        Kết quả: <strong id={`${quizId}-recap-score`}>--</strong> điểm — <span id={`${quizId}-recap-level`}></span>
      </div>
      <h3 class="qf-form-title">{formHeading}</h3>
      <p class="qf-form-desc">{formDescription}</p>
    </div>

    <form class="qf-form" id={`${quizId}-form`} novalidate>
      <input type="hidden" name="funnel_code" value={funnelCode} />
      <input type="hidden" name="school_level" value={schoolLevel} />
      <input type="hidden" name="source" value="quiz_funnel" />
      <input type="hidden" name="quiz_score" id={`${quizId}-hidden-score`} value="" />
      <input type="hidden" name="quiz_level" id={`${quizId}-hidden-level`} value="" />

      <div class="qf-form-group">
        <input type="email" name="email" class="qf-input" placeholder="Email của Ba/Mẹ" required aria-label="Email" />
        <span class="qf-error" role="alert"></span>
      </div>
      <div class="qf-form-group">
        <input type="text" name="parent_name" class="qf-input" placeholder="Họ tên phụ huynh" required aria-label="Tên phụ huynh" />
        <span class="qf-error" role="alert"></span>
      </div>
      <div class="qf-form-group">
        <input type="tel" name="phone" class="qf-input" placeholder="Số điện thoại / Zalo" required aria-label="Số điện thoại" />
        <span class="qf-error" role="alert"></span>
      </div>

      <button type="submit" class="qf-btn qf-btn--submit">
        {formSubmitText}
      </button>

      <div class="qf-form-trust">
        <span>🔒 Bảo mật</span>
        <span>📧 Nhận qua Zalo trong 24h</span>
      </div>
    </form>
  </div>

  <!-- ===== STEP: Success ===== -->
  <div class="qf-step qf-step--success" data-qf-step="success" hidden>
    <div class="qf-success-icon">🎉</div>
    <h3 class="qf-success-title">Đang chuyển đến trang kết quả...</h3>
    <p class="qf-success-text">Báo cáo chi tiết sẽ được gửi qua Zalo và Email trong 24 giờ.</p>
    <div class="qf-loading-spinner"></div>
  </div>
</div>

<!-- Results data for client-side scoring -->
<script is:inline define:vars={{ quizId, results: JSON.stringify(results), rawMax: questions.length * 4, maxScore: 100 }}>
(function() {
  var root = document.getElementById(quizId);
  if (!root) return;

  var resultsData = JSON.parse(results);
  var totalScore = 0;
  var currentStep = 'start';
  var answers = [];

  // === Step navigation ===
  function showStep(stepName) {
    root.querySelectorAll('.qf-step').forEach(function(s) { s.hidden = true; });
    var target = root.querySelector('[data-qf-step="' + stepName + '"]');
    if (target) {
      target.hidden = false;
      // Scroll so the question is visible but don't jump past it
      var rect = target.getBoundingClientRect();
      if (rect.top < 60 || rect.bottom > window.innerHeight) {
        target.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }
    currentStep = stepName;

    // GTM tracking
    if (window.dataLayer) {
      window.dataLayer.push({ event: 'quiz_step', step: stepName, score: totalScore });
    }
  }

  // === Start quiz ===
  root.querySelector('[data-qf-action="start"]').addEventListener('click', function() {
    showStep('q1');
  });

  // === Answer option click ===
  root.querySelectorAll('[data-qf-action="answer"]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var score = parseInt(btn.dataset.qfScore, 10);
      var next = btn.dataset.qfNext;

      // Visual feedback — highlight selected
      var parent = btn.closest('.qf-options');
      parent.querySelectorAll('.qf-option').forEach(function(o) { o.classList.remove('qf-option--selected'); });
      btn.classList.add('qf-option--selected');

      totalScore += score;
      answers.push(score);

      // Delay slightly for visual feedback, then advance
      setTimeout(function() {
        if (next === 'result') {
          showResult();
        } else {
          showStep(next);
        }
      }, 400);
    });
  });

  // === Back buttons ===
  root.querySelectorAll('[data-qf-action="back"]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var prev = btn.dataset.qfPrev;
      // Remove last answer score
      if (answers.length > 0) {
        totalScore -= answers.pop();
      }
      showStep(prev);
    });
  });

  // === Show result → skip score display, go straight to form ===
  function showResult() {
    var fillEl = document.getElementById(quizId + '-score-fill');

    // Convert raw internal score to /maxScore (100) for display
    var displayScore = Math.round((totalScore / rawMax) * maxScore);

    // Determine result (range matching uses raw totalScore vs seed ranges)
    var result = resultsData[resultsData.length - 1]; // default to lowest
    for (var i = 0; i < resultsData.length; i++) {
      var parts = resultsData[i].range.split('-');
      var min = parseInt(parts[0], 10);
      var max = parseInt(parts[1], 10);
      if (totalScore >= min && totalScore <= max) {
        result = resultsData[i];
        break;
      }
    }

    // Populate score bar animation (hidden in result step, kept for completeness)

    // Score bar animation (% of 100)
    setTimeout(function() {
      fillEl.style.width = displayScore + '%';
      fillEl.style.background = result.color;
    }, 300);

    // Skip result screen — go directly to form
    var recapScore = document.getElementById(quizId + '-recap-score');
    var recapLevel = document.getElementById(quizId + '-recap-level');
    var hiddenScore = document.getElementById(quizId + '-hidden-score');
    var hiddenLevel = document.getElementById(quizId + '-hidden-level');
    if (recapScore) recapScore.textContent = displayScore;
    if (recapLevel) { recapLevel.textContent = result.title; recapLevel.style.color = result.color; }
    if (hiddenScore) hiddenScore.value = displayScore;
    if (hiddenLevel) hiddenLevel.value = result.title;
    showStep('form');
  }

  // === Show form button (no longer used — kept for safety) ===
  var showFormBtn = root.querySelector('[data-qf-action="show-form"]');
  if (showFormBtn) {
    showFormBtn.addEventListener('click', function() {
      var recapScore = document.getElementById(quizId + '-recap-score');
      var recapLevel = document.getElementById(quizId + '-recap-level');
      var hiddenScore = document.getElementById(quizId + '-hidden-score');
      var hiddenLevel = document.getElementById(quizId + '-hidden-level');

      var result = resultsData[resultsData.length - 1];
      for (var i = 0; i < resultsData.length; i++) {
        var parts = resultsData[i].range.split('-');
        if (totalScore >= parseInt(parts[0],10) && totalScore <= parseInt(parts[1],10)) {
          result = resultsData[i]; break;
        }
      }

      var displayScore = Math.round((totalScore / rawMax) * maxScore);
      recapScore.textContent = displayScore;
      recapLevel.textContent = result.title;
      recapLevel.style.color = result.color;
      hiddenScore.value = displayScore;
      hiddenLevel.value = result.title;

      showStep('form');
    });
  }

  // === Form submission ===
  var form = document.getElementById(quizId + '-form');
  if (form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();

      // Validate
      var email = form.querySelector('input[name="email"]');
      var name = form.querySelector('input[name="parent_name"]');
      var phone = form.querySelector('input[name="phone"]');
      var valid = true;

      function setError(input, msg) {
        var err = input.parentElement.querySelector('.qf-error');
        if (err) err.textContent = msg;
        input.classList.add('qf-input--error');
        valid = false;
      }
      function clearError(input) {
        var err = input.parentElement.querySelector('.qf-error');
        if (err) err.textContent = '';
        input.classList.remove('qf-input--error');
      }

      clearError(email); clearError(name); clearError(phone);

      if (!email.value || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)) {
        setError(email, 'Vui lòng nhập email hợp lệ');
      }
      if (!name.value || name.value.trim().length < 2) {
        setError(name, 'Vui lòng nhập họ tên');
      }
      if (!phone.value || phone.value.replace(/\D/g,'').length < 9) {
        setError(phone, 'Vui lòng nhập số điện thoại hợp lệ');
      }

      if (!valid) return;

      // Disable submit
      var submitBtn = form.querySelector('.qf-btn--submit');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Đang gửi...';

      // Send to API
      var formData = new FormData(form);
      var payload = {};
      formData.forEach(function(v, k) { payload[k] = v; });
      payload.quiz_answers = answers;

      fetch('/api/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      }).then(function(res) {
        if (!res.ok) throw new Error('API error');
        return res.json();
      }).then(function() {
        // Convert raw to /maxScore (100) for display/transport (per-question answers stay raw 0-4)
        var score100 = Math.round((totalScore / rawMax) * maxScore);

        // GTM
        if (window.dataLayer) {
          window.dataLayer.push({
            event: 'form_submit',
            funnel_code: root.dataset.funnelCode,
            school_level: root.dataset.schoolLevel,
            quiz_score: score100
          });
        }

        showStep('success');

        // Redirect to cam-on WITHOUT score — score sent to email only
        var camOnUrl = root.dataset.camOnUrl;
        var parentName = name.value;
        setTimeout(function() {
          window.location.href = camOnUrl + '?name=' + encodeURIComponent(parentName);
        }, 1500);
      }).catch(function(err) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Thử lại';
        console.error('Quiz form error:', err);
        showStep('success');
        setTimeout(function() {
          window.location.href = root.dataset.camOnUrl + '?name=' + encodeURIComponent(name.value);
        }, 2000);
      });
    });
  }
})();
</script>

<style is:inline>
  /* ===== QUIZ FUNNEL CONTAINER ===== */
  .quiz-funnel { max-width: 560px; margin: 0 auto; }

  /* ===== STEP TRANSITIONS ===== */
  .qf-step { animation: qfSlideIn .35s ease; }
  @keyframes qfSlideIn { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }

  /* ===== BENEFITS BANNER (above the fold) ===== */
  .qf-benefits-banner {
    background: linear-gradient(135deg, #1a1a5e, #2a2a8e);
    border-radius: 12px; padding: 1rem 1.25rem; margin-bottom: 1.5rem;
    text-align: center;
  }
  .qf-benefits-banner__title {
    color: #D4A843; font-weight: 800; font-size: .9rem; margin-bottom: .6rem;
    letter-spacing: .02em;
  }
  .qf-benefits-banner__items {
    display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem;
  }
  .qf-benefits-banner__items span {
    background: rgba(255,255,255,.12); color: #fff; font-size: .8rem; font-weight: 600;
    padding: .35rem .75rem; border-radius: 50px; border: 1px solid rgba(255,255,255,.2);
  }

  /* ===== START SCREEN ===== */
  .qf-start-badge {
    display: inline-flex; align-items: center; gap: .5rem;
    background: linear-gradient(135deg, #1a1a5e, #2a2a7e); color: #fff;
    padding: .5rem 1.25rem; border-radius: 50px; font-size: .85rem; font-weight: 600;
    margin-bottom: 1.25rem;
  }
  .qf-start-title { font-family: Montserrat, sans-serif; font-size: 1.5rem; font-weight: 800; color: #1F4E79; margin-bottom: .5rem; line-height: 1.3; }
  .qf-start-subtitle { font-size: .95rem; color: #666; margin-bottom: 1.25rem; }
  .qf-start-checklist { list-style: none; padding: 0; margin: 0 0 1.5rem; display: flex; flex-direction: column; gap: .5rem; text-align: left; }
  .qf-start-checklist li {
    display: flex; align-items: center; gap: .6rem; font-size: .92rem; color: #1F4E79;
    font-weight: 500; padding: .6rem 1rem; background: rgba(212,168,67,.08);
    border-radius: 10px; border-left: 3px solid #D4A843;
  }
  .qf-check { color: #16A34A; font-weight: 700; font-size: 1.1rem; }
  .qf-start-meta { display: flex; gap: 1.25rem; justify-content: center; margin-top: 1rem; font-size: .8rem; color: #999; }

  /* ===== BUTTONS ===== */
  .qf-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
    padding: 1rem 2rem; border-radius: 14px; border: none; cursor: pointer;
    font-family: Montserrat, sans-serif; font-weight: 700; font-size: 1.05rem;
    transition: all .25s ease; width: 100%;
  }
  .qf-btn--start, .qf-btn--result {
    background: linear-gradient(135deg, #D4A843, #F59E0B); color: #fff;
    box-shadow: 0 4px 18px rgba(212,168,67,.35);
    animation: qfPulse 2.5s ease-in-out infinite;
  }
  .qf-btn--start:hover, .qf-btn--result:hover {
    transform: translateY(-2px); box-shadow: 0 6px 28px rgba(212,168,67,.5);
  }
  .qf-btn--submit {
    background: linear-gradient(135deg, #16A34A, #22C55E); color: #fff;
    box-shadow: 0 4px 14px rgba(22,163,106,.3);
  }
  .qf-btn--submit:hover { transform: translateY(-2px); }
  .qf-btn--submit:disabled { opacity: .6; cursor: not-allowed; transform: none; }
  @keyframes qfPulse {
    0%,100% { box-shadow: 0 4px 18px rgba(212,168,67,.35); }
    50% { box-shadow: 0 4px 30px rgba(212,168,67,.6), 0 0 48px rgba(245,158,11,.15); }
  }

  /* ===== PROGRESS BAR ===== */
  .qf-progress { margin-bottom: 1.5rem; }
  .qf-progress__bar { height: 8px; background: #E5E7EB; border-radius: 4px; overflow: hidden; }
  .qf-progress__fill { height: 100%; background: linear-gradient(90deg, #D4A843, #F59E0B); border-radius: 4px; transition: width .5s ease; }
  .qf-progress__text { text-align: right; font-size: .78rem; color: #999; margin-top: .35rem; font-weight: 600; }

  /* ===== QUESTION ===== */
  .qf-question { font-family: Montserrat, sans-serif; font-size: 1.15rem; font-weight: 700; color: #1F4E79; margin-bottom: 1.25rem; line-height: 1.4; }

  /* ===== OPTIONS ===== */
  .qf-options { display: flex; flex-direction: column; gap: .65rem; }
  .qf-option {
    display: flex; align-items: center; gap: .85rem;
    padding: 1rem 1.25rem; border: 2px solid #E5E7EB; border-radius: 14px;
    background: #fff; cursor: pointer; transition: all .2s ease;
    text-align: left; font-size: .95rem; color: #374151;
  }
  .qf-option:hover { border-color: #D4A843; background: rgba(212,168,67,.04); transform: translateX(4px); }
  .qf-option--selected { border-color: #16A34A !important; background: #F0FDF4 !important; }
  .qf-option--selected .qf-option__letter { background: #16A34A; color: #fff; }
  .qf-option__letter {
    width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    background: #F3F4F6; font-weight: 700; font-size: .85rem; color: #6B7280;
    font-family: Montserrat, sans-serif; transition: all .2s;
  }
  .qf-option__text { font-weight: 500; line-height: 1.4; }

  /* ===== BACK BUTTON ===== */
  .qf-back {
    display: inline-block; margin-top: 1rem;
    background: none; border: none; color: #999; cursor: pointer;
    font-size: .85rem; font-weight: 500; padding: .5rem;
    transition: color .2s;
  }
  .qf-back:hover { color: #1F4E79; }

  /* ===== RESULT ===== */
  .qf-result-icon { font-size: 3rem; margin-bottom: .75rem; }
  .qf-result-title { font-family: Montserrat, sans-serif; font-size: 1.5rem; font-weight: 800; margin-bottom: .5rem; }
  .qf-result-score { display: flex; align-items: baseline; justify-content: center; gap: .4rem; margin-bottom: .75rem; }
  .qf-result-score__number { font-family: Montserrat, sans-serif; font-size: 2.5rem; font-weight: 800; color: #1F4E79; }
  .qf-result-score__max { font-size: .95rem; color: #999; }
  .qf-result-desc { font-size: .95rem; color: #555; line-height: 1.65; margin-bottom: 1.5rem; max-width: 460px; margin-left: auto; margin-right: auto; }

