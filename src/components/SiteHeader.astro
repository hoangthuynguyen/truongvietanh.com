---
import { contactLinks, mainNavLeft, mainNavRight } from '../lib/site-content';

type NavItem = {
  label: string;
  href: string;
  children?: Array<{
    label: string;
    href: string;
  }>;
};

type Props = {
  currentPath: string;
};

const { currentPath } = Astro.props;

function isActive(item: NavItem, path: string): boolean {
  if (item.href === '/') return path === '/';
  if (item.href.startsWith('#')) return false;
  return path === item.href || path.startsWith(`${item.href}/`);
}

function isChildActive(item: NavItem, path: string): boolean {
  return item.children?.some(child => path === child.href || path.startsWith(`${child.href}/`)) ?? false;
}
---

<!-- TOP BAR -->
<div class="wp-top-bar">
  <div class="wp-container wp-top-bar__inner">
    <div class="wp-top-bar__left">
      <a href={contactLinks.phoneHref} class="wp-top-bar__link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        <span>Hotline: {contactLinks.phoneDisplay}</span>
      </a>
      <a href={contactLinks.zaloHref} target="_blank" rel="noreferrer" class="wp-top-bar__link wp-top-bar__link--zalo">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
        <span>Zalo: {contactLinks.phoneDisplay}</span>
      </a>
      <a href="https://www.facebook.com/truongvietanhhcm" target="_blank" rel="noreferrer" class="wp-top-bar__link wp-top-bar__link--facebook">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        <span>Facebook Page</span>
      </a>
      <a href="https://m.me/truongvietanhhcm" target="_blank" rel="noreferrer" class="wp-top-bar__link wp-top-bar__link--messenger">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 4.974 0 11.111c0 3.498 1.744 6.614 4.469 8.654V24l4.088-2.242c1.092.301 2.246.464 3.443.464 6.627 0 12-4.975 12-11.111S18.627 0 12 0zm1.191 14.963l-3.055-3.26-5.963 3.26L10.733 8.2l3.13 3.26 5.889-3.26-6.561 6.763z"/></svg>
        <span>Chat Facebook</span>
      </a>
    </div>
    <div class="wp-top-bar__right">
      <a href="/tuyen-sinh" class="wp-top-bar__cta">Tư vấn tuyển sinh</a>
    </div>
  </div>
</div>

<!-- MAIN NAVIGATION -->
<header class="wp-header" id="wp-header">
  <nav class="wp-container wp-nav" aria-label="Điều hướng chính">
    <!-- Left nav items -->
    <ul class="wp-nav__list wp-nav__list--left">
      {mainNavLeft.map((item) => (
        <li class={`wp-nav__item ${item.children ? 'wp-nav__item--dropdown' : ''} ${isActive(item, currentPath) || isChildActive(item, currentPath) ? 'is-active' : ''}`}>
          <a href={item.href} class="wp-nav__link">
            {item.label}
            {item.children && (
              <svg class="wp-nav__chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            )}
          </a>
          {item.children && (
            <ul class="wp-dropdown">
              {item.children.map(child => (
                <li>
                  <a href={child.href} class={currentPath === child.href ? 'is-active' : ''}>{child.label}</a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>

    <!-- Center logo -->
    <div class="wp-nav__logo">
      <a href="/">
        <img src="/logo-vietanh.webp" alt="Trường Việt Anh" width="200" height="65" style="height: 60px; width: auto; max-width: 200px; object-fit: contain;" />
      </a>
    </div>

    <!-- Right nav items -->
    <ul class="wp-nav__list wp-nav__list--right">
      {mainNavRight.map((item) => (
        <li class={`wp-nav__item ${item.children ? 'wp-nav__item--dropdown' : ''} ${isActive(item, currentPath) || isChildActive(item, currentPath) ? 'is-active' : ''}`}>
          <a href={item.href} class="wp-nav__link">
            {item.label}
            {item.children && (
              <svg class="wp-nav__chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            )}
          </a>
          {item.children && (
            <ul class="wp-dropdown">
              {item.children.map(child => (
                <li>
                  <a href={child.href} class={currentPath === child.href ? 'is-active' : ''}>{child.label}</a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>

    <!-- Mobile hamburger -->
    <button class="wp-hamburger" id="wp-hamburger" aria-label="Mở menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </nav>

  <!-- Mobile menu overlay -->
  <div class="wp-mobile-menu" id="wp-mobile-menu">
    <div class="wp-mobile-menu__inner">
      {[...mainNavLeft, ...mainNavRight].map((item) => (
        <div class={`wp-mobile-menu__item ${item.children ? 'wp-mobile-menu__item--has-children' : ''}`}>
          <a href={item.href} class="wp-mobile-menu__link">{item.label}</a>
          {item.children && (
            <div class="wp-mobile-menu__sub">
              {item.children.map(child => (
                <a href={child.href}>{child.label}</a>
              ))}
            </div>
          )}
        </div>
      ))}
      <div class="wp-mobile-menu__cta">
        <a href={contactLinks.phoneHref} class="wp-mobile-menu__phone">Gọi {contactLinks.phoneDisplay}</a>
        <a href="/tuyen-sinh" class="wp-mobile-menu__btn">Tư vấn tuyển sinh</a>
      </div>
    </div>
  </div>
</header>

<script>
  const hamburger = document.getElementById('wp-hamburger');
  const mobileMenu = document.getElementById('wp-mobile-menu');
  const header = document.getElementById('wp-header');

  if (hamburger && mobileMenu) {
    hamburger.addEventListener('click', () => {
      hamburger.classList.toggle('is-open');
      mobileMenu.classList.toggle('is-open');
      document.body.classList.toggle('menu-open');
    });

    // Toggle submenus on mobile
    const parentItems = mobileMenu.querySelectorAll('.wp-mobile-menu__item--has-children');
    parentItems.forEach(item => {
      const link = item.querySelector('.wp-mobile-menu__link');
      if (link) {
        link.addEventListener('click', (e) => {
          if (window.innerWidth <= 1024) {
            e.preventDefault();
            item.classList.toggle('is-expanded');
          }
        });
      }
    });
  }
</script>
