---
import SqueezePageLayout from '../layouts/SqueezePageLayout.astro';
import LeadFormTwoStepEmailFirst from './LeadFormTwoStepEmailFirst.astro';
import FAQSection from './FAQSection.astro';
import { formatVnd, type SummerCampPage } from '../lib/summer-camps';

type Props = { page: SummerCampPage };
const { page } = Astro.props;

const canonicalUrl = `https://truongvietanh.com/${page.slug}`;
const zaloHref = `https://zalo.me/${(page.hotline || '0916961409').replace(/\s/g, '').replace(/^0/, '84')}`;
const thankYouHref = `/${page.slug}/cam-on`;
const savings = page.price_original && page.price_discounted ? page.price_original - page.price_discounted : 0;
const discountPct = page.price_original && savings ? Math.round((savings / page.price_original) * 100) : 0;
---

<SqueezePageLayout
  title={page.seo_title}
  description={page.seo_description}
  canonicalUrl={canonicalUrl}
  schoolLevel={page.level as any}
  funnelCode={page.slug}
>
  <section slot="hero">
    {page.pre_headline && <p class="scs-pre">{page.pre_headline}</p>}
    {page.hero_badge && <span class="squeeze-hero__badge">{page.hero_badge}</span>}
    <h1 class="squeeze-hero__heading">{page.headline}</h1>
    {page.subheadline && <p class="squeeze-hero__subheading">{page.subheadline}</p>}
    {page.hero_bullets && page.hero_bullets.length > 0 && (
      <ul class="scs-hero-bullets">
        {page.hero_bullets.map((b) => <li>✔ {b}</li>)}
      </ul>
    )}
    <div class="scs-hero-cta">
      <a href="#dang-ky" class="scs-btn scs-btn--primary">👉 {page.primary_cta_text}</a>
      {page.secondary_cta_text && (
        <a href={zaloHref} target="_blank" rel="noopener" class="scs-btn scs-btn--zalo">💬 {page.secondary_cta_text}</a>
      )}
    </div>
  </section>

  <section slot="content">
    <div class="scs-wrap">
      {page.problems_title && (
        <div class="scs-block scs-problems">
          <h2>{page.problems_title}</h2>
          {page.problems_intro && <p class="scs-lead">{page.problems_intro}</p>}
          {page.problems_list && (
            <ul class="scs-list scs-list--x">
              {page.problems_list.map((p) => <li>{p}</li>)}
            </ul>
          )}
          {page.problems_conclusion && <p class="scs-note">{page.problems_conclusion}</p>}
        </div>
      )}

      {page.transformation_title && (
        <div class="scs-block">
          <h2>{page.transformation_title}</h2>
          {page.timeline_mode && page.timeline_items ? (
            <div class="scs-timeline">
              {page.timeline_items.map((t) => (
                <div class="scs-timeline__item">
                  <h3>{t.phase}</h3>
                  <p>{t.body}</p>
                </div>
              ))}
            </div>
          ) : (
            <div class="scs-ba">
              <div class="scs-ba__col scs-ba__col--before">
                <h3>{page.before_title || 'Trước Trại hè'}</h3>
                <ul>{(page.before_items || []).map((i) => <li>{i}</li>)}</ul>
              </div>
              <div class="scs-ba__col scs-ba__col--after">
                <h3>{page.after_title || 'Sau Lion Camp'}</h3>
                <ul>{(page.after_items || []).map((i) => <li>{i}</li>)}</ul>
              </div>
            </div>
          )}
          {page.results_title && page.results_items && (
            <div class="scs-results">
              <h3>{page.results_title}</h3>
              <ul class="scs-list scs-list--check">
                {page.results_items.map((r) => <li>{r}</li>)}
              </ul>
            </div>
          )}
        </div>
      )}

      {page.offerings_title && page.offerings && (
        <div class="scs-block">
          <h2>{page.offerings_title}</h2>
          <div class="scs-offer-grid">
            {page.offerings.map((o) => (
              <div class="scs-offer-card">
                {o.icon && <span class="scs-offer-card__icon">{o.icon}</span>}
                <h3>{o.title}</h3>
                {o.description && <p>{o.description}</p>}
              </div>
            ))}
          </div>
        </div>
      )}

      {page.pricing_title && (
        <div class="scs-block scs-pricing">
          <h2>{page.pricing_title}</h2>
          {page.pricing_breakdown && (
            <ul class="scs-list scs-list--check">
              {page.pricing_breakdown.map((i) => <li>{i}</li>)}
            </ul>
          )}
          {page.price_compare_title && page.price_compare_items && (
            <div class="scs-compare">
              <h3>{page.price_compare_title}</h3>
              <ul>{page.price_compare_items.map((i) => <li>{i}</li>)}</ul>
              {page.price_compare_conclusion && <p class="scs-compare__concl">{page.price_compare_conclusion}</p>}
            </div>
          )}
          <div class="scs-price-box">
            {page.price_original && (
              <div class="scs-price-old">Giá gốc: <s>{formatVnd(page.price_original)}</s></div>
            )}
            {page.price_discounted && (
              <div class="scs-price-new">
                Chỉ còn <strong>{formatVnd(page.price_discounted)}</strong>
                {discountPct > 0 && <span class="scs-price-pct">–{discountPct}%</span>}
              </div>
            )}
            {page.price_note && <div class="scs-price-note">{page.price_note}</div>}
          </div>
          {page.early_bird_title && (
            <div class="scs-early">
              <h3>🎁 {page.early_bird_title}</h3>
              {page.early_bird_items && (
                <ul>{page.early_bird_items.map((i) => <li>{i}</li>)}</ul>
              )}
            </div>
          )}
        </div>
      )}

      {page.guarantee_title && (
        <div class="scs-block scs-guarantee">
          <h2>{page.guarantee_title}</h2>
          {page.guarantee_body && <p>{page.guarantee_body}</p>}
          {page.guarantee_tagline && <p class="scs-guarantee__tag"><strong>{page.guarantee_tagline}</strong></p>}
        </div>
      )}

      {page.testimonials && page.testimonials.length > 0 && (
        <div class="scs-block">
          {page.testimonials_title && <h2>{page.testimonials_title}</h2>}
          <div class="scs-testi-grid">
            {page.testimonials.map((t) => (
              <blockquote class="scs-testi">
                <p>"{t.quote}"</p>
                <cite>— {t.author}</cite>
              </blockquote>
            ))}
          </div>
        </div>
      )}

      {page.objections && page.objections.length > 0 && (
        <div class="scs-block scs-objections">
          {page.objections_title && <h2>{page.objections_title}</h2>}
          {page.objections.map((o) => (
            <div class="scs-objection">
              <strong>{o.q}</strong>
              <p>→ {o.a}</p>
            </div>
          ))}
        </div>
      )}

      <div class="scs-block scs-final-cta" id="final-cta">
        {page.final_cta_title && <h2>{page.final_cta_title}</h2>}
        {page.final_cta_body && <p>{page.final_cta_body}</p>}
        <div class="scs-hero-cta">
          <a href="#dang-ky" class="scs-btn scs-btn--primary">👉 {page.primary_cta_text}</a>
          {page.secondary_cta_text && (
            <a href={zaloHref} target="_blank" rel="noopener" class="scs-btn scs-btn--zalo">💬 {page.secondary_cta_text}</a>
          )}
        </div>
        <p class="scs-hotline">Hotline / Zalo tư vấn nhanh: <a href={`tel:${(page.hotline || '0916961409').replace(/\s/g, '')}`}>{page.hotline || '0916 961 409'}</a></p>
        {page.seats_remaining && (
          <p class="scs-seats">⚠️ Hiện tại lớp {page.class_label} chỉ còn {page.seats_remaining} chỗ.</p>
        )}
      </div>
    </div>
  </section>

  <section slot="form">
    <div id="dang-ky">
      <h2 class="squeeze-form-section__heading">Giữ suất 500.000 VNĐ & Nhận học bổng Early Bird</h2>
      <p class="squeeze-form-section__description">Để lại thông tin, tư vấn viên sẽ liên hệ Ba/Mẹ trong 24 giờ để xác nhận suất và hướng dẫn chuyển khoản.</p>
      <LeadFormTwoStepEmailFirst
        formId="squeeze-form"
        funnelCode={page.slug}
        schoolLevel={page.level}
        submitText="Giữ suất & nhận học bổng ngay"
        successMessage="Cảm ơn! Đang chuyển đến trang xác nhận..."
      />
    </div>
  </section>

  {page.faq_items && page.faq_items.length > 0 && (
    <section slot="faq">
      <FAQSection title={page.faq_title || 'Câu hỏi thường gặp'} items={page.faq_items} />
    </section>
  )}
</SqueezePageLayout>

<script is:inline define:vars={{ funnelCode: page.slug, thankYouHref }}>
  (function(){
    var formEl = document.querySelector('#squeeze-form-' + funnelCode);
    if (!formEl) return;
    var obs = new MutationObserver(function(){
      var success = formEl.querySelector('.form-step[data-step="success"]');
      if (success && !success.hidden) {
        var nameInput = formEl.querySelector('input[name="parent_name"]');
        var n = nameInput ? nameInput.value : '';
        setTimeout(function(){
          window.location.href = thankYouHref + '?name=' + encodeURIComponent(n);
        }, 1800);
        obs.disconnect();
      }
    });
    obs.observe(formEl, { attributes: true, subtree: true, attributeFilter: ['hidden'] });
  })();
</script>

<style is:inline>
  .scs-pre{font-size:.82rem;font-weight:700;letter-spacing:.6px;color:#ffd89a;margin-bottom:.75rem;text-transform:uppercase}
  .scs-hero-bullets{list-style:none;padding:0;margin:1.25rem 0 1.5rem;display:flex;flex-direction:column;gap:.35rem;align-items:center}
  .scs-hero-bullets li{font-size:.98rem;font-weight:600;color:#fff}
  .scs-hero-cta{display:flex;flex-wrap:wrap;gap:.75rem;justify-content:center;margin-top:1rem}
  .scs-btn{display:inline-block;padding:1rem 1.5rem;border-radius:10px;font-weight:700;text-decoration:none;font-size:1rem;line-height:1.3;transition:transform .15s,box-shadow .15s;text-align:center}
  .scs-btn--primary{background:linear-gradient(135deg,#D4A843 0%,#ff9a4a 100%);color:#fff;box-shadow:0 6px 18px rgba(212,168,67,.35)}
  .scs-btn--primary:hover{transform:translateY(-2px);box-shadow:0 8px 22px rgba(212,168,67,.5)}
  .scs-btn--zalo{background:#0068ff;color:#fff}
  .scs-btn--zalo:hover{background:#0052cc}
  .scs-wrap{max-width:900px;margin:0 auto;padding:0 1rem}
  .scs-block{margin:3rem 0;padding:2rem 1.5rem;background:#fff;border-radius:14px;box-shadow:0 2px 10px rgba(0,0,0,.04)}
  .scs-block h2{font-family:Montserrat,sans-serif;font-size:1.6rem;font-weight:800;color:#1F4E79;margin-bottom:1rem;text-align:center;line-height:1.3}
  .scs-block h3{font-family:Montserrat,sans-serif;font-size:1.1rem;font-weight:700;color:#1F4E79;margin-bottom:.5rem}
  .scs-block p{font-size:1rem;line-height:1.7;color:#2a2a2a;margin-bottom:.75rem}
  .scs-lead{font-weight:600;text-align:center}
  .scs-note{background:#fff6ed;border-left:4px solid #D4A843;padding:1rem 1.25rem;border-radius:8px;margin-top:1rem}
  .scs-list{list-style:none;padding:0;margin:1rem 0;display:flex;flex-direction:column;gap:.6rem}
  .scs-list li{padding:.7rem 1rem;border-radius:8px;font-size:.98rem;line-height:1.6}
  .scs-list--x li{background:#fff5f5;border-left:3px solid #e74c3c}
  .scs-list--x li::before{content:"✗ ";color:#e74c3c;font-weight:700}
  .scs-list--check li{background:#f0faf4;border-left:3px solid #27ae60}
  .scs-list--check li::before{content:"✓ ";color:#27ae60;font-weight:700}
  .scs-problems{background:linear-gradient(135deg,#fff8e1 0%,#fff3e0 100%)}
  .scs-ba{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-top:1.5rem}
  .scs-ba__col{padding:1.25rem;border-radius:12px}
  .scs-ba__col--before{background:#fff5f5;border:1px solid #fad0d0}
  .scs-ba__col--before h3{color:#c0392b}
  .scs-ba__col--after{background:#f0faf4;border:1px solid #c8e9d4}
  .scs-ba__col--after h3{color:#1e8449}
  .scs-ba__col ul{list-style:none;padding:0;margin:0}
  .scs-ba__col ul li{padding:.45rem 0;font-size:.95rem;line-height:1.55}
  .scs-ba__col--before li::before{content:"• "}
  .scs-ba__col--after li::before{content:"✓ ";color:#27ae60;font-weight:700}
  .scs-timeline{display:flex;flex-direction:column;gap:1rem;margin-top:1.5rem}
  .scs-timeline__item{padding:1.25rem 1.5rem;background:linear-gradient(135deg,#f8faff 0%,#eef4ff 100%);border-left:4px solid #1a1a5e;border-radius:10px}
  .scs-results{margin-top:1.5rem;padding:1.25rem;background:#f0faf4;border-radius:10px}
  .scs-results h3{text-align:center;color:#1e8449}
  .scs-offer-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1rem;margin-top:1rem}
  .scs-offer-card{padding:1.25rem;border:1px solid #e0e0e0;border-radius:12px;background:#fff;transition:all .2s}
  .scs-offer-card:hover{border-color:#D4A843;box-shadow:0 6px 18px rgba(212,168,67,.12);transform:translateY(-2px)}
  .scs-offer-card__icon{font-size:1.75rem;display:block;margin-bottom:.5rem}
  .scs-offer-card h3{margin-bottom:.4rem}
  .scs-offer-card p{font-size:.92rem;color:#555;margin:0;line-height:1.55}
  .scs-pricing{background:linear-gradient(135deg,#fff 0%,#fff8f0 100%)}
  .scs-compare{margin-top:1.5rem;padding:1.25rem;background:#fff8e1;border-radius:10px;border-left:4px solid #D4A843}
  .scs-compare ul{padding-left:1.25rem;margin:.5rem 0}
  .scs-compare ul li{margin:.3rem 0}
  .scs-compare__concl{font-weight:700;margin-top:.75rem;color:#1F4E79}
  .scs-price-box{margin:1.5rem 0;padding:1.5rem;background:linear-gradient(135deg,#1F4E79 0%,#2a5f8f 100%);color:#fff;border-radius:12px;text-align:center}
  .scs-price-old{font-size:1rem;opacity:.8;margin-bottom:.4rem}
  .scs-price-new{font-size:1.4rem}
  .scs-price-new strong{font-size:2rem;color:#ffd89a;font-weight:800;display:inline-block;margin:0 .35rem}
  .scs-price-pct{display:inline-block;background:#D4A843;color:#fff;padding:.25rem .6rem;border-radius:6px;font-size:.9rem;margin-left:.5rem;vertical-align:middle}
  .scs-price-note{margin-top:.65rem;font-size:.95rem;opacity:.92}
  .scs-early{margin-top:1.5rem;padding:1.25rem 1.5rem;background:#fff8e1;border:2px dashed #D4A843;border-radius:12px}
  .scs-early h3{color:#8a6914;margin-bottom:.6rem;text-align:center}
  .scs-early ul{padding-left:1.25rem;margin:0}
  .scs-early ul li{margin:.4rem 0;font-size:.96rem}
  .scs-guarantee{background:linear-gradient(135deg,#f0faf4 0%,#e8f5ee 100%);border:2px solid #27ae60}
  .scs-guarantee h2{color:#1e8449}
  .scs-guarantee__tag{text-align:center;font-size:1.05rem;color:#1e8449;margin-top:1rem}
  .scs-testi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.25rem;margin-top:1rem}
  .scs-testi{background:#fff8f0;border-left:4px solid #D4A843;padding:1.25rem 1.5rem;border-radius:10px;margin:0}
  .scs-testi p{font-style:italic;font-size:.98rem;line-height:1.65;margin-bottom:.5rem}
  .scs-testi cite{font-style:normal;font-weight:700;color:#D4A843;font-size:.9rem}
  .scs-objections .scs-objection{padding:1rem 1.25rem;background:#f9faff;border-left:3px solid #1F4E79;border-radius:8px;margin:.75rem 0}
  .scs-objections .scs-objection strong{color:#1F4E79;display:block;margin-bottom:.3rem}
  .scs-objections .scs-objection p{margin:0;font-size:.95rem}
  .scs-final-cta{background:linear-gradient(135deg,#1a1a5e 0%,#2a2a7e 100%);color:#fff;text-align:center}
  .scs-final-cta h2{color:#fff}
  .scs-final-cta p{color:#e0e0ff}
  .scs-hotline{margin-top:1rem;font-size:.95rem}
  .scs-hotline a{color:#ffd89a;font-weight:700;text-decoration:none}
  .scs-seats{margin-top:.75rem;font-weight:700;color:#ffd89a}
  @media(max-width:768px){
    .scs-ba{grid-template-columns:1fr}
    .scs-block{padding:1.5rem 1rem;margin:2rem 0}
    .scs-block h2{font-size:1.35rem}
    .scs-price-new strong{font-size:1.55rem}
  }
</style>
