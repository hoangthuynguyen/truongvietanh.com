---
type MetricItem = {
  number: string | number;
  label: string;
};

type Props = {
  metrics: MetricItem[];
  title?: string;
};

const { metrics, title } = Astro.props;
---

<div class="trust-metrics-wrapper">
  {title && (
    <h2 class="trust-metrics-title">{title}</h2>
  )}

  <div class="trust-metrics-grid">
    {metrics.map((metric) => (
      <div class="metric-item">
        <div class="metric-number" data-target={metric.number}>{metric.number}</div>
        <div class="metric-divider"></div>
        <div class="metric-label">{metric.label}</div>
      </div>
    ))}
  </div>
</div>

<style is:inline>.trust-metrics-wrapper{
    width: 100%;
    text-align: center;
    color: white;
  }.trust-metrics-title{
    font-family: "Montserrat", sans-serif;
    font-size: clamp(1.5rem, 3vw, 1.75rem);
    font-weight: 700;
    margin-bottom: 2rem;
    color: white;
  }.trust-metrics-grid{
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    align-items: start;
  }.metric-item{
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.25rem .5rem;
    border-radius: 12px;
    background: rgba(255,255,255,.05);
    border: 1px solid rgba(255,255,255,.08);
    transition: all .3s ease;
  }.metric-item:hover{
    background: rgba(255,255,255,.08);
    transform: translateY(-3px);
  }.metric-number{
    font-family: "Montserrat", sans-serif;
    font-size: clamp(2rem, 6vw, 3.25rem);
    font-weight: 800;
    line-height: 1;
    color: #ffff00;
    text-shadow: 0 2px 8px rgba(255, 255, 0,.3);
  }.metric-divider{
    width: 30px;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 0,.6), transparent);
    border-radius: 1px;
  }.metric-label{
    font-size: clamp(1rem, 2vw, 1.05rem);
    font-weight: 500;
    line-height: 1.3;
    opacity: 0.92;
  }

  /* Counter animation via CSS */
  @keyframes countFadeIn {0%{ opacity: 0; transform: translateY(10px); }100%{ opacity: 1; transform: translateY(0); }
  }.metric-item{
    animation: countFadeIn .6s ease-out both;
  }.metric-item:nth-child(1){ animation-delay: .1s; }.metric-item:nth-child(2){ animation-delay: .25s; }.metric-item:nth-child(3){ animation-delay: .4s; }.metric-item:nth-child(4){ animation-delay: .55s; }.metric-item:nth-child(5){ animation-delay: .7s; }

  @media (max-width: 768px) {.trust-metrics-grid{ grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }.metric-number{ font-size: 2rem; }.metric-label{ font-size: 1rem; }.metric-item{ padding: 1rem .5rem; }
  }
  @media (max-width: 480px) {.trust-metrics-title{ margin-bottom: 1.5rem; }.trust-metrics-grid{ gap: 1rem; }.metric-item{ gap: 0.35rem; padding: .85rem .5rem; }.metric-number{ font-size: 1.75rem; }.metric-label{ font-size: 1rem; }.metric-divider{ width: 20px; }
  }
</style>
