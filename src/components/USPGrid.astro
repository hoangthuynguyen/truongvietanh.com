---
type USPItem = {
  icon: string;
  text: string;
};

type Props = {
  title?: string;
  items: USPItem[];
};

const { title = 'Tại sao chọn Trường Việt Anh?', items } = Astro.props;
---

<div class="usp-grid-wrapper">
  {title && (
    <h2 class="usp-grid-title">{title}</h2>
  )}

  <div class="usp-grid">
    {items.map((item) => (
      <div class="usp-item">
        <div class="usp-icon">
          {typeof item.icon === 'string' && item.icon.startsWith('<') ? (
            <span set:html={item.icon} />
          ) : (
            <span>{item.icon}</span>
          )}
        </div>
        <p class="usp-text">{item.text}</p>
      </div>
    ))}
  </div>
</div>

<style is:inline>.usp-grid-wrapper{ width: 100%; }.usp-grid-title{
    font-family: "Montserrat", sans-serif;
    font-size: clamp(1.5rem, 3.8vw, 1.95rem);
    font-weight: 800;
    margin-bottom: 1.5rem;
    text-align: center;
    color: #000080;
    line-height: 1.3;
  }.usp-grid{
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.9rem;
    max-width: 1100px;
    margin: 0 auto;
  }.usp-item{
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.4rem 1.1rem;
    border-radius: 12px;
    background-color: white;
    border: 1px solid #e8e8ec;
    transition: all 0.25s cubic-bezier(.25,.46,.45,.94);
    position: relative;
    overflow: hidden;
  }.usp-item::after{
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #ffff00, #ffff66);
    transform: scaleX(0);
    transition: transform 0.35s ease;
  }.usp-item:hover{
    border-color: rgba(255, 255, 0,.3);
    box-shadow: 0 12px 32px rgba(0,0,128,.08);
    transform: translateY(-6px);
  }.usp-item:hover::after{
    transform: scaleX(1);
  }.usp-icon{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 68px;
    height: 68px;
    margin-bottom: 1.25rem;
    font-size: 2.25rem;
    line-height: 1;
    background: linear-gradient(135deg, rgba(0,0,128,.06), rgba(255, 255, 0,.08));
    border-radius: 50%;
    transition: all 0.35s ease;
  }.usp-item:hover .usp-icon{
    background: linear-gradient(135deg, rgba(0,0,128,.1), rgba(255, 255, 0,.15));
    transform: scale(1.08);
  }.usp-icon svg{
    width: 36px;
    height: 36px;
    color: #000080;
    stroke-width: 1.5;
  }.usp-text{
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.5;
    color: #1a1a1a;
    margin: 0;
  }

  @media (max-width: 900px) {.usp-grid{ grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {.usp-grid-title{ margin-bottom: 1.5rem; }.usp-grid{ gap: 1rem; }.usp-item{ padding: 1.25rem 1rem; }.usp-icon{ width: 56px; height: 56px; font-size: 1.85rem; margin-bottom: 1rem; }.usp-text{ font-size: 1rem; }
  }
  @media (max-width: 480px) {.usp-grid{ grid-template-columns: 1fr; gap: 0.85rem; }.usp-item{ padding: 1.1rem 1rem; flex-direction: row; gap: 1rem; text-align: left; }.usp-icon{ width: 48px; height: 48px; font-size: 1.6rem; margin-bottom: 0; flex-shrink: 0; }.usp-text{ font-size: 1rem; }.usp-item::after{ display: none; }
  }
</style>
