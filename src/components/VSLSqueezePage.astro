---
import LeadFormTwoStepEmailFirst from './LeadFormTwoStepEmailFirst.astro';

export interface Props {
  pageTitle: string;
  pageDescription: string;
  canonicalUrl: string;
  schoolLevel: 'tieu-hoc' | 'thcs' | 'thpt';
  funnelCode: string;
  location: string;
  headline: string;
  microProof: string[];
  subheadline: string;
  hookParagraph: string;
  hookBullets: string;
  videoEmbedUrl?: string;
  benefits: string[];
  finalHookLine: string;
  ctaPrimary: string;
  ctaZalo: string;
  zaloUrl: string;
  slotsLeft: string;
  thankYouUrl: string;
}

const {
  pageTitle, pageDescription, canonicalUrl, schoolLevel, funnelCode,
  location, headline, microProof, subheadline, hookParagraph, hookBullets,
  videoEmbedUrl = '', benefits, finalHookLine, ctaPrimary, ctaZalo,
  zaloUrl, slotsLeft, thankYouUrl
} = Astro.props;
---

<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <style is:inline>@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Open+Sans:wght@400;600;700&display=swap&subset=vietnamese');</style>
  <style is:inline>
    :root{--b:#1F4E79;--o:#E8792B;--o-d:#D96A1F;--w:#fff;--zalo:#0068FF;--g6:#666}
    *{margin:0;padding:0;box-sizing:border-box}
    body{font-family:'Open Sans',system-ui,-apple-system,sans-serif;color:#1C2A3A;background:linear-gradient(180deg,#FFF7ED 0%,#fff 320px);min-height:100vh;line-height:1.6;-webkit-font-smoothing:antialiased}
    h1,h2,h3{font-family:'Montserrat',sans-serif}
    .logo-bar{text-align:center;padding:18px 16px 0}
    .logo-bar img{height:52px;width:auto}
    .wrap{max-width:760px;margin:0 auto;padding:20px 18px 60px}
    .headline{font-size:1.75rem;font-weight:800;color:var(--o);line-height:1.25;text-align:center;margin:16px 0 14px}
    .micro{display:flex;flex-direction:column;gap:6px;background:#FFF7ED;border:1px solid #FED7AA;border-radius:12px;padding:14px 18px;margin:0 auto 16px;max-width:620px;font-size:.92rem;color:#7C2D12}
    .micro div{padding-left:22px;position:relative}
    .micro div::before{content:'✔';position:absolute;left:0;color:#16A34A;font-weight:800}
    .sub{text-align:center;font-size:1.05rem;color:#374151;font-weight:600;margin:8px 0 20px;line-height:1.5}
    .hook{background:#fff;border:1px solid #E5E7EB;border-radius:16px;padding:22px 20px;margin-bottom:22px;box-shadow:0 6px 20px rgba(31,78,121,.06)}
    .hook p{font-size:1rem;margin-bottom:10px;color:#1C2A3A}
    .hook .big{font-weight:700;font-size:1.05rem;color:var(--b);margin:14px 0 6px}
    .video-box{aspect-ratio:16/9;border-radius:14px;overflow:hidden;background:#000;margin:18px 0 22px;box-shadow:0 10px 30px rgba(0,0,0,.15);position:relative}
    .video-box iframe,.video-box video{width:100%;height:100%;border:0;display:block}
    .video-placeholder{display:flex;align-items:center;justify-content:center;height:100%;color:#fff;font-size:1rem;text-align:center;padding:20px;background:linear-gradient(135deg,#1F4E79 0%,#2a5d8a 100%)}
    .video-placeholder .play{font-size:3rem;margin-bottom:8px}
    .benefits{background:linear-gradient(135deg,#FFF7ED 0%,#FFE8D1 100%);border:2px solid var(--o);border-radius:16px;padding:22px 22px;margin-bottom:20px}
    .benefits h3{color:var(--o);font-size:1.1rem;font-weight:800;margin-bottom:12px;text-align:center}
    .benefits ul{list-style:none;padding:0}
    .benefits li{padding:10px 0 10px 34px;position:relative;font-size:1rem;color:#1C2A3A;font-weight:600;border-bottom:1px dashed rgba(232,121,43,.3)}
    .benefits li:last-child{border-bottom:0}
    .benefits li::before{content:'⭐';position:absolute;left:4px;top:9px;font-size:1.2rem}
    .final-hook{text-align:center;font-size:1.02rem;color:#1C2A3A;margin:16px 0 22px;padding:0 10px;font-style:italic}
    .final-hook strong{color:var(--o);font-weight:800;font-style:normal}
    .urgency{text-align:center;background:#FEE2E2;color:#991B1B;padding:12px 18px;border-radius:12px;font-weight:700;margin-bottom:14px;font-size:.95rem}
    .urgency .countdown{font-family:'Montserrat',sans-serif;font-size:1.1rem;letter-spacing:.5px}
    .cta-stack{display:flex;flex-direction:column;gap:12px;margin:10px 0 20px}
    .cta{display:block;padding:18px 22px;border-radius:14px;text-decoration:none;font-weight:800;font-size:1.02rem;text-align:center;font-family:'Montserrat',sans-serif;transition:all .2s;cursor:pointer;border:0;width:100%}
    .cta-primary{background:var(--o);color:var(--w);box-shadow:0 6px 20px rgba(232,121,43,.4);animation:pulse 2s infinite}
    .cta-primary:hover{background:var(--o-d);transform:translateY(-2px)}
    @keyframes pulse{0%,100%{box-shadow:0 6px 20px rgba(232,121,43,.4)}50%{box-shadow:0 6px 28px rgba(232,121,43,.7)}}
    .cta-zalo{background:var(--zalo);color:var(--w)}
    .cta-zalo:hover{background:#0056D6}
    .form-wrap{background:#fff;border-radius:16px;padding:22px 20px;box-shadow:0 10px 30px rgba(31,78,121,.1);margin-top:18px}
    .form-wrap h2{color:var(--b);text-align:center;font-size:1.25rem;margin-bottom:8px}
    .form-wrap .sub-form{text-align:center;color:var(--g6);font-size:.9rem;margin-bottom:14px}
    .sticky-zalo{position:fixed;bottom:18px;right:18px;z-index:999;background:var(--zalo);color:#fff;padding:12px 16px;border-radius:50px;text-decoration:none;font-weight:700;font-size:.9rem;box-shadow:0 6px 20px rgba(0,104,255,.4);display:flex;align-items:center;gap:8px}
    .footer-note{text-align:center;font-size:.78rem;color:#999;margin-top:20px;padding:0 20px}
    @media(max-width:560px){.headline{font-size:1.4rem}.sub{font-size:.98rem}.benefits li{font-size:.94rem}.cta{font-size:.95rem;padding:16px 18px}}
  </style>
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-KPL2NSR9');</script>
</head>
<body>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KPL2NSR9" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<div class="logo-bar"><img src="/logo-vietanh.webp" alt="Trường Việt Anh" /></div>
<div class="wrap">
  <h1 class="headline">{headline}</h1>
  <div class="micro">{microProof.map(m => <div>{m}</div>)}</div>
  <p class="sub">{subheadline}</p>

  <div class="hook">
    <p>{hookParagraph}</p>
    <p class="big">Video 60 giây này sẽ cho Ba/Mẹ thấy:</p>
    <p>{hookBullets}</p>
  </div>

  <div class="video-box">
    {videoEmbedUrl ? (
      <iframe src={videoEmbedUrl} title="VSL Trại hè Lion Camp" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen loading="lazy"></iframe>
    ) : (
      <div class="video-placeholder"><div><div class="play">▶</div><div>Video VSL 60 giây<br/><span style="font-size:.85rem;opacity:.8">(Sẽ cập nhật sớm)</span></div></div></div>
    )}
  </div>

  <div class="benefits">
    <h3>Chỉ sau 6 tuần tại Lion Camp {location}:</h3>
    <ul>{benefits.map(b => <li>{b}</li>)}</ul>
  </div>

  <p class="final-hook">Nhưng điều quan trọng nhất không nằm ở những kỹ năng này…<br/><strong>→ Mà là sự thay đổi mà Ba/Mẹ sẽ thấy rõ trong video.</strong></p>

  <div class="urgency">⏳ Chỉ còn <strong>{slotsLeft}</strong> suất — Ưu đãi kết thúc trong <span class="countdown" id="cd">23:59:59</span></div>

  <div class="cta-stack">
    <a href="#vsl-form" class="cta cta-primary">👉 {ctaPrimary}</a>
    <a href={zaloUrl} target="_blank" rel="noopener" class="cta cta-zalo">💬 {ctaZalo}</a>
  </div>

  <div class="form-wrap" id="vsl-form">
    <h2>Đăng ký giữ chỗ & nhận báo cáo cá nhân hóa</h2>
    <p class="sub-form">Điền thông tin — tư vấn viên liên hệ trong 24 giờ qua Zalo</p>
    <LeadFormTwoStepEmailFirst formId={`vsl-${funnelCode}`} funnelCode={funnelCode} schoolLevel={schoolLevel} submitText="Giữ chỗ ngay — Nhận học bổng Early Bird" successMessage="Đang chuyển đến trang xác nhận..." />
  </div>

  <p class="footer-note">© Trường Việt Anh {location} — Hotline: 0916 961 409</p>
</div>

<a href={zaloUrl} target="_blank" rel="noopener" class="sticky-zalo">💬 Chat Zalo</a>

<script is:inline define:vars={{ thankYouUrl }}>
// Countdown 24h evergreen per session
(function(){
  const key='vsl_deadline_'+location.pathname;
  let d=localStorage.getItem(key);
  if(!d){d=String(Date.now()+24*3600*1000);localStorage.setItem(key,d)}
  const el=document.getElementById('cd');
  function tick(){
    let diff=parseInt(d)-Date.now();
    if(diff<0)diff=0;
    const h=String(Math.floor(diff/3600000)).padStart(2,'0');
    const m=String(Math.floor(diff/60000)%60).padStart(2,'0');
    const s=String(Math.floor(diff/1000)%60).padStart(2,'0');
    if(el)el.textContent=h+':'+m+':'+s;
  }
  tick();setInterval(tick,1000);
})();
// Redirect to thank-you on form submit success
window.addEventListener('message',function(){});
document.addEventListener('DOMContentLoaded',function(){
  const dl=window.dataLayer=window.dataLayer||[];
  const origPush=dl.push.bind(dl);
  dl.push=function(evt){
    if(evt && evt.event==='form_submit'){
      setTimeout(function(){window.location.href=thankYouUrl},800);
    }
    return origPush(evt);
  };
});
</script>
</body>
</html>
