---
import LeadFormTwoStepEmailFirst from './LeadFormTwoStepEmailFirst.astro';

export interface Props {
  pageTitle: string;
  pageDescription: string;
  canonicalUrl: string;
  schoolLevel: 'tieu-hoc' | 'thcs' | 'thpt';
  funnelCode: string;
  location: string;
  headline: string;
  microProof: string[];
  subheadline: string;
  hookParagraph: string;
  hookBullets: string;
  videoEmbedUrl?: string;
  benefits: string[];
  finalHookLine: string;
  ctaPrimary: string;
  ctaZalo: string;
  zaloUrl: string;
  slotsLeft: string;
  thankYouUrl: string;
  testimonialQuote?: string;
  testimonialAuthor?: string;
}

const {
  pageTitle, pageDescription, canonicalUrl, schoolLevel, funnelCode,
  location, headline, microProof, subheadline, hookParagraph, hookBullets,
  videoEmbedUrl = '', benefits, finalHookLine, ctaPrimary, ctaZalo,
  zaloUrl, slotsLeft, thankYouUrl,
  testimonialQuote = '',
  testimonialAuthor = ''
} = Astro.props;

const levelBadge: Record<string, string> = {
  'tieu-hoc': 'Tiểu học',
  'thcs': 'THCS',
  'thpt': 'THPT'
};
const shortLocation = location.replace(/^(Tiểu học|THCS|THPT)\s*/,'');
const badge = `Lion Camp 2026 — ${levelBadge[schoolLevel] || ''} ${shortLocation}`;
---

<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://truongvietanh.com/og-image.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <style is:inline>@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&family=Open+Sans:wght@400;500;600;700&display=swap&subset=vietnamese');</style>

  <style is:inline>
    :root{--navy:#1F4E79;--navy-dk:#163A5C;--orange:#E8792B;--orange-dk:#D06A22;--white:#fff;--cream:#FFF9F3;--text:#1C2A3A;--sub:#5A6577;--muted:#9CA3AF;--zalo:#0068FF;--r:12px}
    *{margin:0;padding:0;box-sizing:border-box}
    body{font-family:'Open Sans',system-ui,sans-serif;color:var(--text);background:var(--white);min-height:100vh;line-height:1.6;-webkit-font-smoothing:antialiased}
    h1,h2,h3{font-family:'Montserrat',sans-serif}

    /* === HERO — white bg, navy text === */
    .hero{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px 16px 24px;background:var(--white)}
    .hero-inner{width:100%;max-width:820px;display:flex;flex-direction:column;align-items:center;gap:10px}

    /* Logo — centered, large */
    .logo{padding:0;margin-bottom:4px}
    .logo img{display:block;max-width:300px;width:100%;height:auto}

    /* Badge */
    .badge{display:inline-block;background:var(--navy);color:var(--white);font-size:.72rem;font-weight:700;padding:5px 16px;border-radius:50px;letter-spacing:.4px;text-transform:uppercase}

    /* Headline + Subheadline */
    .hl{font-size:1.45rem;font-weight:900;color:var(--navy);line-height:1.25;text-align:center;max-width:700px;margin:0}
    .shl{font-size:.92rem;color:var(--sub);text-align:center;max-width:600px;line-height:1.55;margin:0}
    .shl strong{color:var(--navy)}

    /* Video — centered, prominent */
    .vid-wrap{width:100%;max-width:600px;margin:4px 0}
    .vid{border-radius:14px;overflow:hidden;background:#000;box-shadow:0 6px 24px rgba(0,0,0,.12);aspect-ratio:16/9;position:relative}
    .vid iframe,.vid video{width:100%;height:100%;border:0;display:block}
    .vid-ph{display:flex;align-items:center;justify-content:center;height:100%;background:linear-gradient(135deg,#0F172A 0%,var(--navy-dk) 100%);color:var(--white);flex-direction:column;gap:10px;cursor:pointer}
    .vid-ph .play{width:64px;height:64px;background:var(--orange);border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 24px rgba(232,121,43,.5);animation:pp 2s ease infinite;transition:transform .2s}
    .vid-ph:hover .play{transform:scale(1.1)}
    .vid-ph .play svg{width:24px;height:24px;fill:var(--white);margin-left:3px}
    @keyframes pp{0%,100%{box-shadow:0 4px 24px rgba(232,121,43,.5)}50%{box-shadow:0 4px 36px rgba(232,121,43,.8)}}
    .vid-ph span{font-size:.82rem;opacity:.7;font-weight:600}

    /* Benefits list below video */
    .vid-benefits{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;width:100%;max-width:720px}
    .vid-benefit{display:inline-flex;align-items:center;gap:5px;background:#F8FAFC;border:1px solid #E2E8F0;border-radius:8px;padding:6px 12px;font-size:.78rem;color:var(--navy);font-weight:600}
    .vid-benefit::before{content:'✓';color:var(--orange);font-weight:900;font-size:.72rem}

    /* CTA group — below video */
    .hero-cta{display:flex;flex-direction:column;gap:8px;width:100%;max-width:480px}
    .cta{display:flex;align-items:center;justify-content:center;gap:6px;padding:14px 16px;border-radius:var(--r);text-decoration:none;font-weight:800;font-size:.88rem;text-align:center;font-family:'Montserrat',sans-serif;transition:all .2s;cursor:pointer;border:0;width:100%;line-height:1.3}
    .cta-o{background:var(--orange);color:var(--white);box-shadow:0 4px 20px rgba(232,121,43,.35);position:relative;overflow:hidden}
    .cta-o::after{content:'';position:absolute;top:0;left:-100%;width:60%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.2),transparent);animation:shine 2.5s ease infinite}
    @keyframes shine{0%{left:-100%}100%{left:150%}}
    .cta-o:hover{background:var(--orange-dk);transform:translateY(-1px)}
    .cta-sub{text-align:center;font-size:.76rem;color:var(--muted)}

    /* Urgency strip */
    .urg{display:flex;align-items:center;justify-content:center;gap:6px;font-size:.84rem;font-weight:700;color:var(--navy)}
    .urg .cd{background:var(--orange);color:var(--white);padding:2px 8px;border-radius:4px;font-family:'Montserrat',sans-serif;font-weight:900;font-size:.82rem;letter-spacing:.3px}

    /* === BELOW FOLD CONTENT === */
    .content{max-width:820px;margin:0 auto;padding:24px 16px 80px;background:#F8FAFC;border-top:1px solid #E2E8F0}

    /* Proof pills */
    .pills{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin:0 0 16px}
    .pill{display:inline-flex;align-items:center;gap:4px;background:var(--white);border:1px solid #E5E7EB;border-radius:20px;padding:6px 12px;font-size:.78rem;color:var(--navy);font-weight:600}
    .pill::before{content:'✓';color:var(--orange);font-weight:900;font-size:.7rem}

    /* Hook */
    .hook{background:var(--white);border-radius:var(--r);padding:16px 18px;margin:0 0 14px;border-left:3px solid var(--orange)}
    .hook p{font-size:.92rem;margin-bottom:6px;color:var(--sub)}
    .hook .lbl{font-weight:700;color:var(--navy);font-size:.92rem}

    /* Benefits */
    .bens{background:var(--white);border-radius:var(--r);padding:16px 18px;margin:0 0 14px;border:1px solid #E5E7EB}
    .bens h3{color:var(--navy);font-size:.95rem;font-weight:800;margin-bottom:10px;text-align:center}
    .bens ul{list-style:none;padding:0}
    .bens li{padding:8px 0 8px 28px;position:relative;font-size:.9rem;font-weight:600;color:var(--text);border-bottom:1px solid #F3F4F6}
    .bens li:last-child{border-bottom:0}
    .bens li::before{content:'✓';position:absolute;left:0;top:8px;color:var(--orange);font-weight:900;font-size:.9rem}

    /* Final hook */
    .fhook{text-align:center;font-size:.9rem;color:var(--sub);padding:14px;margin:0 0 14px;background:var(--white);border-radius:var(--r);border:1px dashed var(--orange)}
    .fhook strong{color:var(--orange);display:block;margin-top:4px}

    /* Testimonial */
    .testi{background:var(--white);border-radius:var(--r);padding:16px 18px;margin:0 0 14px;border:1px solid #E5E7EB;position:relative}
    .testi::before{content:'"';position:absolute;top:4px;left:12px;font-size:2.2rem;color:var(--orange);opacity:.15;font-family:Georgia,serif;line-height:1}
    .testi blockquote{font-size:.88rem;color:var(--sub);font-style:italic;line-height:1.65;margin:0 0 6px;padding-left:6px}
    .testi cite{display:block;font-size:.78rem;font-weight:700;color:var(--navy);font-style:normal;padding-left:6px}
    .testi .stars{color:var(--orange);font-size:.8rem;padding-left:6px;margin-top:2px}

    /* Mid CTA */
    .mcta{background:var(--white);border-radius:var(--r);overflow:hidden;margin:0 0 14px;border:2px solid var(--orange)}
    .mcta-head{background:var(--navy);color:var(--white);padding:10px 14px;text-align:center;font-size:.84rem;font-weight:700}
    .mcta-head .cd2{background:rgba(255,255,255,.2);padding:2px 8px;border-radius:4px;font-family:'Montserrat',sans-serif;font-weight:900}
    .mcta-body{padding:12px 14px;display:flex;flex-direction:column;gap:8px}

    /* Guarantee */
    .guar{display:flex;align-items:center;gap:8px;background:var(--white);border:1px solid #E5E7EB;border-radius:var(--r);padding:12px 14px;margin:0 0 14px}
    .guar .ic{font-size:1.4rem;flex-shrink:0}
    .guar p{font-size:.82rem;color:var(--sub);line-height:1.5}
    .guar b{color:var(--navy)}

    /* Form */
    .form-sec{background:var(--white);border-radius:var(--r);padding:20px 16px;border:2px solid var(--navy);position:relative}
    .form-sec::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--orange);border-radius:var(--r) var(--r) 0 0}
    .form-sec h2{color:var(--navy);text-align:center;font-size:1.05rem;margin-bottom:4px}
    .form-sec .fsub{text-align:center;color:var(--muted);font-size:.82rem;margin-bottom:12px}
    .form-lock{display:flex;align-items:center;justify-content:center;gap:4px;font-size:.72rem;color:var(--muted);margin-top:8px}
    .form-lock svg{width:12px;height:12px;fill:var(--navy)}

    /* Sticky bottom (mobile) — no Zalo button */
    .sticky-bot{position:fixed;bottom:0;left:0;right:0;z-index:998;background:var(--white);padding:8px 12px;box-shadow:0 -2px 12px rgba(0,0,0,.08);display:none;border-top:2px solid var(--orange)}
    .sticky-bot .sb{display:block;padding:12px 10px;border-radius:10px;text-decoration:none;font-weight:800;font-size:.88rem;text-align:center;font-family:'Montserrat',sans-serif;color:var(--white);background:var(--orange);width:100%}

    /* Social notif */
    .snotif{position:fixed;bottom:80px;left:12px;z-index:997;background:var(--white);border-radius:10px;padding:8px 12px;box-shadow:0 4px 18px rgba(0,0,0,.1);display:flex;align-items:center;gap:8px;max-width:270px;transform:translateX(-110%);transition:transform .35s ease;font-size:.78rem;border:1px solid #F0F0F0}
    .snotif.show{transform:translateX(0)}
    .snotif .sa{width:30px;height:30px;border-radius:50%;background:var(--cream);display:flex;align-items:center;justify-content:center;font-size:.8rem;flex-shrink:0}
    .snotif b{color:var(--navy)}
    .snotif .st{font-size:.68rem;color:var(--muted);display:block;margin-top:1px}

    /* Footer */
    .foot{text-align:center;font-size:.72rem;color:var(--muted);margin-top:16px}

    /* === RESPONSIVE === */
    @media(max-width:560px){
      .hero{padding:14px 12px 18px}
      .hl{font-size:1.15rem}
      .shl{font-size:.82rem}
      .logo img{max-width:260px}
      .sticky-bot{display:block}
      .snotif{bottom:70px}
    }
    @media(min-width:561px){
      .logo img{max-width:340px}
      .hl{font-size:1.5rem}
      .shl{font-size:.9rem}
    }
    @media(min-width:800px){
      .hl{font-size:1.65rem}
      .vid-wrap{max-width:600px}
    }
  </style>

  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-KPL2NSR9');</script>
</head>
<body>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KPL2NSR9" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<!-- ===== HERO — Full-screen centered video ===== -->
<section class="hero">
  <div class="hero-inner">
    <!-- Logo — centered, large -->
    <div class="logo">
      <img src="/logo-vietanh.webp" alt="Trường TH - THCS - THPT Việt Anh" />
    </div>

    <!-- Badge -->
    <span class="badge">{badge}</span>

    <!-- Headline + Subheadline -->
    <h1 class="hl">{headline}</h1>
    <p class="shl" set:html={subheadline} />

    <!-- Video — centered -->
    <div class="vid-wrap">
      <div class="vid">
        {videoEmbedUrl ? (
          <iframe src={videoEmbedUrl} title="VSL Lion Camp" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen loading="lazy"></iframe>
        ) : (
          <div class="vid-ph">
            <div class="play"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
            <span>Nhấn để xem Video 60 giây</span>
          </div>
        )}
      </div>
    </div>

    <!-- Benefits below video -->
    <div class="vid-benefits">
      {benefits.slice(0, 4).map(b => <span class="vid-benefit">{b}</span>)}
    </div>

    <!-- CTA right after video -->
    <div class="hero-cta">
      <a href="#vsl-form" class="cta cta-o">👉 {ctaPrimary}</a>
    </div>
    <p class="cta-sub">Tư vấn miễn phí · Không cam kết · Phản hồi trong 24h</p>

    <!-- Urgency -->
    <div class="urg">⏳ Còn <strong>{slotsLeft}</strong> suất — hết trong <span class="cd" id="cd">23:59:59</span></div>
  </div>
</section>

<!-- ===== BELOW FOLD ===== -->
<div class="content">

  <!-- Proof pills -->
  <div class="pills">
    {microProof.map(m => <span class="pill">{m}</span>)}
  </div>

  <!-- Hook -->
  <div class="hook">
    <p>{hookParagraph}</p>
    <p class="lbl">🎬 Xem video để thấy:</p>
    <p>{hookBullets}</p>
  </div>

  <!-- Benefits (full list) -->
  <div class="bens">
    <h3>Chỉ sau 6 tuần tại Lion Camp {location}:</h3>
    <ul>{benefits.map(b => <li>{b}</li>)}</ul>
  </div>

  <!-- Final hook -->
  <div class="fhook">
    Nhưng điều quan trọng nhất không nằm ở những kỹ năng này…
    <strong>→ Mà là sự thay đổi Ba/Mẹ sẽ thấy rõ trong video.</strong>
  </div>

  <!-- Testimonial -->
  <div class="testi">
    <blockquote>{testimonialQuote || 'Trước khi đi trại hè, bé nhà mình rất rụt rè, cả ngày ôm iPad. Chỉ sau 3 tuần đầu, cô giáo gửi video bé tự tin thuyết trình bằng tiếng Anh. Mình không tin vào mắt mình!'}</blockquote>
    <cite>{testimonialAuthor || '— Phụ huynh bé tại ' + location}</cite>
    <div class="stars">★★★★★</div>
  </div>

  <!-- Mid CTA -->
  <div class="mcta">
    <div class="mcta-head">⏳ Còn <strong>{slotsLeft}</strong> suất — hết trong <span class="cd2" id="cd2">23:59:59</span></div>
    <div class="mcta-body">
      <a href="#vsl-form" class="cta cta-o">👉 {ctaPrimary}</a>
    </div>
  </div>

  <!-- Guarantee -->
  <div class="guar">
    <div class="ic">🛡️</div>
    <p><b>Tư vấn miễn phí, không cam kết.</b> Ba/Mẹ chỉ quyết định sau khi trao đổi trực tiếp với tư vấn viên.</p>
  </div>

  <!-- Form -->
  <div class="form-sec" id="vsl-form">
    <h2>Đăng ký tư vấn 1:1 miễn phí</h2>
    <p class="fsub">Tư vấn viên gọi/Zalo trong 24 giờ để trao đổi chi tiết</p>
    <LeadFormTwoStepEmailFirst formId={`vsl-${funnelCode}`} funnelCode={funnelCode} schoolLevel={schoolLevel} submitText="Đăng ký tư vấn miễn phí ngay" successMessage="Đang chuyển đến trang xác nhận..." />
    <div class="form-lock">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M10 2a5 5 0 00-5 5v2a2 2 0 00-2 2v5a2 2 0 002 2h10a2 2 0 002-2v-5a2 2 0 00-2-2V7a5 5 0 00-5-5zm3 7V7a3 3 0 10-6 0v2h6z"/></svg>
      Bảo mật tuyệt đối
    </div>
  </div>

  <p class="foot">© 2026 Trường Việt Anh — 0916 961 409</p>
</div>

<!-- Sticky bottom (mobile) — CTA only, no Zalo -->
<div class="sticky-bot" id="sBot">
  <a href="#vsl-form" class="sb">👉 Đăng ký tư vấn — {slotsLeft} suất còn lại</a>
</div>

<!-- Social notif -->
<div class="snotif" id="sn">
  <div class="sa" id="snA">👩</div>
  <div><b id="snN">Chị Nguyễn T.</b> <span id="snAc">vừa đăng ký tư vấn</span><span class="st" id="snT">2p trước</span></div>
</div>

<script is:inline define:vars={{ thankYouUrl, location }}>
// Countdown
(function(){
  var k='vsl_'+window.location.pathname,d=localStorage.getItem(k);
  if(!d){d=String(Date.now()+864e5);localStorage.setItem(k,d)}
  function t(){
    var df=parseInt(d)-Date.now();if(df<0)df=0;
    var h=String(Math.floor(df/36e5)).padStart(2,'0'),m=String(Math.floor(df/6e4)%60).padStart(2,'0'),s=String(Math.floor(df/1e3)%60).padStart(2,'0'),v=h+':'+m+':'+s;
    var a=document.getElementById('cd'),b=document.getElementById('cd2');
    if(a)a.textContent=v;if(b)b.textContent=v;
  }
  t();setInterval(t,1000);
})();

// Sticky bottom
(function(){var s=document.getElementById('sBot');if(!s)return;window.addEventListener('scroll',function(){s.style.display=window.scrollY>400?'block':'none'},{passive:true})})();

// Social notif
(function(){
  var ns=['Chị Nguyễn T.','Anh Trần V.','Chị Lê H.','Anh Phạm D.','Chị Hoàng M.'],
      ac=[' vừa đăng ký tư vấn',' vừa nhận báo cáo',' vừa đăng ký tại '+location,' vừa đăng ký'],
      ts=['1p trước','2p trước','3p trước','5p trước'],
      av=['👩','👨','👩‍🦰','👨‍🦱','👩‍💼'],
      el=document.getElementById('sn');if(!el)return;
  function r(a){return a[Math.floor(Math.random()*a.length)]}
  function go(){
    var n=document.getElementById('snN'),a=document.getElementById('snAc'),t=document.getElementById('snT'),v=document.getElementById('snA');
    if(n)n.textContent=r(ns);if(a)a.textContent=r(ac);if(t)t.textContent=r(ts);if(v)v.textContent=r(av);
    el.classList.add('show');setTimeout(function(){el.classList.remove('show')},4e3);
  }
  setTimeout(go,7e3);setInterval(go,2e4+Math.random()*1e4);
})();

// Redirect on submit
document.addEventListener('DOMContentLoaded',function(){
  var dl=window.dataLayer=window.dataLayer||[],op=dl.push.bind(dl);
  dl.push=function(e){if(e&&e.event==='form_submit')setTimeout(function(){window.location.href=thankYouUrl},800);return op(e)};
});
</script>
</body>
</html>
