---
import type { BlockFaq } from '../../types/cms';
interface Props { data: BlockFaq; context: string; }
const { data } = Astro.props;
---
<section class="block-faq">
  <div class="block-faq-inner">
    {data.eyebrow && <p class="block-eyebrow">{data.eyebrow}</p>}
    {data.title && <h2 class="block-title">{data.title}</h2>}
    <div class="block-faq-list">
      {data.items.map((item, i) => (
        <details class="block-faq-item" open={i === 0}>
          <summary>{item.question}</summary>
          <div class="block-faq-answer" set:html={item.answer} />
        </details>
      ))}
    </div>
  </div>
</section>
