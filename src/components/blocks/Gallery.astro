---
import type { BlockGallery } from '../../types/cms';
interface Props { data: BlockGallery; context: string; }
const { data } = Astro.props;
---
<section class="b-gallery">
  <div class="b-container">
    {data.eyebrow && <p class="b-eyebrow">{data.eyebrow}</p>}
    {data.title && <h2 class="b-title">{data.title}</h2>}
    {data.intro && <p class="b-intro">{data.intro}</p>}
    <div class="b-gallery-grid">
      {data.items?.map((item) => (
        <figure class="b-gallery-item">
          <img src={item.image} alt={item.alt} loading="lazy" />
          {item.caption && <figcaption>{item.caption}</figcaption>}
        </figure>
      ))}
    </div>
  </div>
</section>
