<section class="section-block closing-cta anchor-section" id="lien-he">
  <div class="closing-cta__inner">
    <div class="closing-cta__text">
      <p class="closing-cta__eyebrow">Bước tiếp theo</p>
      <h2>Đặt Lịch Tham Quan Miễn Phí</h2>
      <p class="closing-cta__desc">Gặp trực tiếp giáo viên, dự một tiết học mẫu và tìm hiểu lộ trình phù hợp cho con — hoàn toàn không ràng buộc.</p>
      <ul class="closing-cta__perks">
        <li>✓ Bảng học phí đầy đủ theo từng cấp học</li>
        <li>✓ Lịch tuyển sinh &amp; ngày tham quan mở</li>
        <li>✓ Lộ trình học xuyên suốt 4 cấp</li>
        <li>✓ Ưu đãi Early bird chỉ gửi qua email</li>
      </ul>
    </div>
    <div class="closing-cta__action">
      <a href="/tuyen-sinh/tham-quan-truong" class="closing-cta__btn">
        Đặt lịch tham quan miễn phí →
      </a>
      <p class="closing-cta__note">Hoặc gọi <a href="tel:0916961409" class="closing-cta__tel">0916 961 409</a> · <a href="https://zalo.me/1678310120468101523" target="_blank" rel="noopener" class="closing-cta__tel">Nhắn Zalo</a></p>
    </div>
  </div>
</section>

<style>
  /* Band GOLD kết trang — nổi bật giữa khối Cam kết (navy) và footer */
  .closing-cta {
    background: linear-gradient(135deg, #FFE95C 0%, #f9dd0e 50%, #F0CF00 100%);
    border-radius: 24px;
    padding: clamp(2rem, 5vw, 3.5rem);
  }
  .closing-cta__inner {
    max-width: 900px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: center;
  }
  .closing-cta__eyebrow {
    color: rgba(38,39,93,0.75);
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 0.5rem;
  }
  .closing-cta__text h2 { color: #26275D; margin: 0 0 0.85rem; font-size: clamp(1.5rem, 3vw, 2rem); }
  .closing-cta__desc { color: rgba(38,39,93,0.85); line-height: 1.7; font-size: 1rem; margin: 0 0 1.25rem; }
  .closing-cta__perks { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .closing-cta__perks li { color: #26275D; font-size: 1rem; line-height: 1.5; font-weight: 500; }
  .closing-cta__action { display: flex; flex-direction: column; align-items: center; gap: 1rem; min-width: 260px; }
  .closing-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #26275D;
    color: #fff;
    font-weight: 800;
    font-size: 1.1rem;
    padding: 1rem 2rem;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
    text-align: center;
    transition: transform 0.18s, box-shadow 0.18s;
    box-shadow: 0 8px 26px rgba(38,39,93,0.35);
  }
  .closing-cta__btn:hover { transform: translateY(-3px); box-shadow: 0 14px 34px rgba(38,39,93,0.45); }
  .closing-cta__note { color: rgba(38,39,93,0.75); font-size: 0.9rem; text-align: center; margin: 0; }
  .closing-cta__tel { color: #26275D; text-decoration: underline; font-weight: 700; }
  .closing-cta__tel:hover { text-decoration: none; }

  @media (max-width: 768px) {
    .closing-cta__inner { grid-template-columns: 1fr; gap: 2rem; }
    .closing-cta__action { align-items: flex-start; }
  }
</style>
