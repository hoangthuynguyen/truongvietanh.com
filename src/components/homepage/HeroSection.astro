---
import { schoolFacts } from '../../data/school-facts';
---
<section class="wp-hero wp-hero--split">
  <div class="wp-hero__overlay"></div>
  <div class="wp-container wp-hero__inner">
    <div class="wp-hero__left">
      <p class="wp-hero__eyebrow">🏅 Hệ thống giáo dục liên cấp · Thành lập 2011 tại TP.HCM</p>
      <h1 class="wp-hero__title">Nơi Con Học Vui,<br class="hero-br"/>Lớn Lên Tự Tin,<br class="hero-br"/>Ra Đời Vững Vàng</h1>
      <p class="wp-hero__subtitle">Mầm Non - Tiểu Học - THCS - THPT</p>
      <p class="hero-differentiator">
        Hệ thống liên cấp duy nhất tại TP.HCM
        <strong>cam kết IELTS 6.0+ bằng văn bản ký kết</strong>
      </p>
      <ul class="wp-hero__proof">
        <li><span class="proof-check">✓</span> IELTS 6.0–8.0 — cam kết đầu ra khi tốt nghiệp THPT</li>
        <li><span class="proof-check">✓</span> 99% học sinh vào được đại học yêu thích</li>
        <li><span class="proof-check">✓</span> Học phí lớp 1–12 tại TP.HCM 9,2–13,7 triệu/tháng — trường quốc tế 19–83 triệu</li>
      </ul>
      <div class="wp-hero__actions">
        <a class="wp-hero__btn wp-hero__btn--primary" href="/tuyen-sinh/tham-quan-truong">
          Đặt lịch tham quan miễn phí →
        </a>
        <a class="wp-hero__btn wp-hero__btn--outline" href="/hoc-phi">Xem học phí</a>
        <a class="wp-hero__btn wp-hero__btn--zalo" href="https://zalo.me/1678310120468101523" target="_blank" rel="noreferrer">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          Chat Zalo
        </a>
      </div>
      <div class="wp-hero__badges">
        <span class="wp-hero__badge">⭐ {schoolFacts.rating}/5 — {schoolFacts.reviewCount} đánh giá</span>
        <span class="wp-hero__badge">🎓 IELTS {schoolFacts.ielts}</span>
        <span class="wp-hero__badge">🏆 {schoolFacts.yearsRunning}+ năm kinh nghiệm</span>
        <span class="wp-hero__badge">✅ {schoolFacts.collegeRate} đỗ ĐH</span>
      </div>
    </div>
  </div>
</section>

<style>
  .wp-hero {
    position: relative;
    background: url('/hero-bg-home.webp') center/cover no-repeat, #26275D;
    min-height: 520px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 3rem 1.5rem;
    overflow: hidden;
  }
  .wp-hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(38, 39, 93, 0.62);
    pointer-events: none;
  }
  .wp-hero__title {
    font-family: "Montserrat", "Be Vietnam Pro", sans-serif;
    font-size: clamp(1.9rem, 4vw, 2.9rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.12;
    margin: 0;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
  }
  .wp-hero__subtitle {
    font-family: "Montserrat", "Be Vietnam Pro", sans-serif;
    font-size: clamp(1.1rem, 2.5vw, 1.6rem);
    font-weight: 600;
    color: #f9dd0e;
    margin: 0;
    letter-spacing: 0.02em;
  }
  .hero-differentiator {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.9);
    font-style: italic;
    margin: 0;
  }
  .hero-differentiator strong { font-style: normal; color: #f9dd0e; }
  .wp-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 0.5rem;
  }
  .wp-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.6rem;
    border-radius: 4px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: transform 0.15s, box-shadow 0.15s, background 0.2s;
  }
  .wp-hero__btn:hover { transform: translateY(-1px); box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25); }
  .wp-hero__btn--primary { background: #f9dd0e; color: #26275D; }
  .wp-hero__btn--primary:hover { background: #fae34a; }
  .wp-hero__btn--outline { background: transparent; color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.35); }
  .wp-hero__btn--outline:hover { background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.55); }
  .wp-hero__btn--zalo {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.85rem 1.4rem;
    border-radius: 4px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    background: #0068ff;
    color: #fff;
    transition: transform 0.15s, background 0.2s;
  }
  .wp-hero__btn--zalo:hover { background: #0058e0; transform: translateY(-1px); }
  .wp-hero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
    margin-top: 0.5rem;
  }
  .wp-hero__badge {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.85);
    font-size: 1rem;
    font-weight: 600;
  }
  .wp-hero__proof {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    align-items: center;
  }
  .wp-hero__proof li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.9);
    font-size: 1rem;
    line-height: 1.5;
  }
  .proof-check { color: #f9dd0e; font-weight: 700; flex-shrink: 0; margin-top: 0.1rem; }
  .wp-hero__eyebrow { font-size: 0.95rem; font-weight: 600; color: rgba(255,255,255,0.75); letter-spacing: 0.02em; margin: 0; }

  /* Split layout */
  .wp-hero--split { min-height: 620px; align-items: center; padding: 0; background-size: 100% auto; background-position: center; }
  .wp-hero__inner {
    display: flex;
    justify-content: center;
    padding: 2.5rem 1.5rem;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  .wp-hero__left {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    text-align: center;
    align-items: center;
    max-width: 820px;
  }

  @media (max-width: 1024px) {
    .wp-hero--split { min-height: 480px; background-size: cover; }
    .wp-hero__inner { padding: 2.5rem 1.5rem; }
  }
  @media (max-width: 640px) {
    .wp-hero { min-height: 420px; padding: 2rem 1rem; }
    .wp-hero__inner { padding: 2rem 1rem; }
    .wp-hero__actions { flex-direction: column; width: 100%; }
    .wp-hero__btn { width: 100%; }
  }
</style>
