---
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  ogImage?: string;
  robots?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
};

const {
  title = 'Trường Việt Anh',
  description = 'Website Trường Việt Anh với cấu trúc tối ưu cho SEO, AI Overviews và tốc độ tải.',
  canonical,
  noindex = canonical?.includes('staging.') || canonical?.includes('workers.dev') || canonical?.includes('hoc.'),
  ogImage,
  robots = noindex ? 'noindex, nofollow' : 'index, follow',
  structuredData,
} = Astro.props;

const schemaPayload = structuredData
  ? JSON.stringify(Array.isArray(structuredData) ? structuredData : [structuredData])
  : null;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#123967" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://media.truongvietanh.com" />
    <link rel="preconnect" href="https://media.truongvietanh.com" crossorigin />
    <link rel="preload" as="image" href="/logo-crest-80.webp" />
    <link rel="preload" as="image" href="/logo-vietanh.webp" />
    <style is:inline>
      body,h1,h2,h3,h4,h5,h6,button,input,select,textarea{font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}
      /* Page load animation */
      body{animation:pageIn 0.4s ease-out}
      @keyframes pageIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
    </style>
    <script is:inline>
      (function(){var l=document.createElement('link');l.rel='stylesheet';l.href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap&subset=vietnamese';document.head.appendChild(l)})();
    </script>
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap&subset=vietnamese" />
    </noscript>
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={robots} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Trường Việt Anh" />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {schemaPayload && <script is:inline type="application/ld+json" set:html={schemaPayload} />}
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-KPL2NSR9');</script>
    <!-- End Google Tag Manager -->
    <meta name="google-site-verification" content="google-site-verification-placeholder" />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KPL2NSR9"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <!-- Announcement Bar -->
    <div class="announcement-bar" id="announcementBar">
      <div class="announcement-bar__inner">
        <span class="announcement-bar__text">
          Tuyển sinh 2026–2027 đang mở — Ưu đãi Early Bird giảm đến 15% học phí.
          <a href="/tuyen-sinh" class="announcement-bar__link">Đăng ký ngay</a>
        </span>
        <button class="announcement-bar__close" id="closeAnnouncement" aria-label="Đóng thông báo">&times;</button>
      </div>
    </div>

    <main>
      <slot />
    </main>

    <!-- Zalo chat floating widget -->
    <a href="https://zalo.me/0916961409" target="_blank" rel="noopener" class="zalo-float" aria-label="Chat qua Zalo">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
      <span class="zalo-float__label">Chat Zalo</span>
    </a>

    <!-- Back to top button -->
    <button class="back-to-top" aria-label="Cuộn lên đầu trang">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
    </button>

    <!-- Sticky CTA mobile -->
    <div class="mobile-sticky-cta">
      <a href="tel:0916961409" class="mobile-sticky-cta__call">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Gọi ngay
      </a>
      <a href="/tuyen-sinh" class="mobile-sticky-cta__register">Đăng ký tư vấn</a>
    </div>

    <!-- Scroll animations + FAQ smooth + Animated counter -->
    <script is:inline>
    (function(){
      /* === Scroll fade-in === */
      var targets = document.querySelectorAll('section, .gi-faq-item, .news-card, .topic-card, .link-card, .facility-card, .why-card, .content-card');
      if(targets.length && 'IntersectionObserver' in window){
        targets.forEach(function(el){ el.classList.add('reveal'); });
        var obs = new IntersectionObserver(function(entries){
          entries.forEach(function(e){
            if(e.isIntersecting){ e.target.classList.add('revealed'); obs.unobserve(e.target); }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        targets.forEach(function(el){ obs.observe(el); });
      }

      /* === FAQ smooth toggle === */
      document.querySelectorAll('details.gi-faq-item, details.faq-item').forEach(function(d){
        var summary = d.querySelector('summary');
        var content = d.querySelector('.gi-faq-answer, .faq-answer');
        if(!summary || !content) return;
        summary.addEventListener('click', function(e){
          e.preventDefault();
          if(d.open){
            content.style.maxHeight = content.scrollHeight + 'px';
            requestAnimationFrame(function(){ content.style.maxHeight = '0'; });
            content.addEventListener('transitionend', function handler(){ d.open = false; content.removeEventListener('transitionend', handler); }, {once:true});
          } else {
            d.open = true;
            content.style.maxHeight = '0';
            requestAnimationFrame(function(){ content.style.maxHeight = content.scrollHeight + 'px'; });
            content.addEventListener('transitionend', function handler(){ content.style.maxHeight = 'none'; content.removeEventListener('transitionend', handler); }, {once:true});
          }
        });
      });

      /* === Announcement bar dismiss === */
      var annBar = document.getElementById('announcementBar');
      var closeAnn = document.getElementById('closeAnnouncement');
      if(annBar && closeAnn){
        if(sessionStorage.getItem('ann_closed')){annBar.style.display='none';}
        closeAnn.addEventListener('click',function(){annBar.style.display='none';sessionStorage.setItem('ann_closed','1');});
      }

      /* === Back to top === */
      var btt = document.querySelector('.back-to-top');
      if(btt){
        window.addEventListener('scroll', function(){
          btt.classList.toggle('is-visible', window.scrollY > 400);
        }, {passive:true});
        btt.addEventListener('click', function(){ window.scrollTo({top:0,behavior:'smooth'}); });
      }

      /* === Image skeleton loading === */
      document.querySelectorAll('img[loading="lazy"]').forEach(function(img){
        if(img.complete) return;
        img.style.background = 'linear-gradient(110deg, #f1f5f9 30%, #e8edf3 50%, #f1f5f9 70%)';
        img.style.backgroundSize = '200% 100%';
        img.style.animation = 'shimmer 1.5s ease-in-out infinite';
        img.addEventListener('load', function(){ img.style.background = ''; img.style.animation = ''; }, {once:true});
      });

      /* === Animated counter === */
      document.querySelectorAll('.stat-num, .gi-stat-value, [data-counter]').forEach(function(el){
        var text = el.textContent.trim();
        var match = text.match(/^([\d,.]+)(\+?)(.*)$/);
        if(!match) return;
        var target = parseFloat(match[1].replace(/,/g, ''));
        var suffix = (match[2] || '') + (match[3] || '');
        var isFloat = match[1].indexOf('.') > -1;
        el.textContent = '0' + suffix;
        var counted = false;
        var cobs = new IntersectionObserver(function(entries){
          if(entries[0].isIntersecting && !counted){
            counted = true; cobs.disconnect();
            var start = performance.now();
            var duration = 1200;
            function step(now){
              var p = Math.min((now - start) / duration, 1);
              var ease = 1 - Math.pow(1 - p, 3);
              var val = ease * target;
              el.textContent = (isFloat ? val.toFixed(1) : Math.round(val)) + suffix;
              if(p < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
          }
        }, { threshold: 0.3 });
        cobs.observe(el);
      });
    })();
    </script>

    <style is:inline>
      /* === Scroll reveal animation === */
      .reveal { opacity: 0; transform: translateY(28px); transition: opacity 0.6s cubic-bezier(0.22,1,0.36,1), transform 0.6s cubic-bezier(0.22,1,0.36,1); }
      .revealed { opacity: 1 !important; transform: translateY(0) !important; }

      /* === FAQ smooth animation === */
      details.gi-faq-item .gi-faq-answer,
      details.faq-item .faq-answer {
        overflow: hidden;
        transition: max-height 0.35s cubic-bezier(0.22,1,0.36,1);
      }
      details.gi-faq-item summary,
      details.faq-item summary {
        position: relative;
        padding-right: 2rem;
        list-style: none;
      }
      details.gi-faq-item summary::-webkit-details-marker,
      details.faq-item summary::-webkit-details-marker { display: none; }
      details.gi-faq-item summary::marker,
      details.faq-item summary::marker { display: none; content: ''; }
      details.gi-faq-item summary::after,
      details.faq-item summary::after {
        content: '+';
        position: absolute;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        font-size: 1.4rem;
        font-weight: 300;
        color: #94a3b8;
        transition: transform 0.3s ease, color 0.3s ease;
        line-height: 1;
      }
      details[open].gi-faq-item summary::after,
      details[open].faq-item summary::after {
        content: '−';
        color: #2563eb;
        transform: translateY(-50%) rotate(0deg);
      }
      details[open].gi-faq-item summary,
      details[open].faq-item summary {
        color: #2563eb;
      }

      /* === Announcement bar === */
      .announcement-bar {
        background: linear-gradient(90deg, #1a1a5e, #2563eb);
        color: #fff; text-align: center;
        padding: 0.55rem 1rem; font-size: 0.88rem;
        position: relative; z-index: 101;
      }
      .announcement-bar__inner {
        max-width: 1200px; margin: 0 auto;
        display: flex; align-items: center; justify-content: center; gap: 0.5rem;
      }
      .announcement-bar__text { line-height: 1.4; }
      .announcement-bar__link {
        color: #fde047; font-weight: 700; text-decoration: underline;
        text-underline-offset: 2px; white-space: nowrap;
      }
      .announcement-bar__close {
        background: none; border: none; color: rgba(255,255,255,0.6);
        font-size: 1.3rem; cursor: pointer; padding: 0 0.25rem; line-height: 1;
        transition: color 0.2s; position: absolute; right: 1rem;
      }
      .announcement-bar__close:hover { color: #fff; }
      @media(max-width:600px){ .announcement-bar { font-size: 0.82rem; padding: 0.5rem 2.5rem 0.5rem 0.75rem; } }

      /* === Zalo floating widget === */
      .zalo-float {
        position: fixed;
        bottom: 5.5rem;
        left: 1.25rem;
        z-index: 998;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: #0068ff;
        color: #fff;
        padding: 0.7rem 1rem 0.7rem 0.8rem;
        border-radius: 50px;
        text-decoration: none;
        box-shadow: 0 4px 20px rgba(0,104,255,0.35);
        transition: transform 0.25s, box-shadow 0.25s;
        animation: zaloFloat 3s ease-in-out infinite;
      }
      .zalo-float:hover {
        transform: scale(1.05);
        box-shadow: 0 6px 24px rgba(0,104,255,0.45);
        animation: none;
      }
      .zalo-float__label {
        font-size: 0.85rem;
        font-weight: 700;
        white-space: nowrap;
      }
      @keyframes zaloFloat {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-4px); }
      }
      @media(max-width:768px){
        .zalo-float { bottom: 5.5rem; left: 0.75rem; padding: 0.6rem; border-radius: 50%; }
        .zalo-float__label { display: none; }
      }
      @media(min-width:769px){ .zalo-float { bottom: 2rem; left: 2rem; } }

      /* === Back to top button === */
      .back-to-top {
        position: fixed;
        bottom: 5.5rem;
        right: 1.25rem;
        z-index: 998;
        width: 44px; height: 44px;
        border-radius: 50%;
        background: #fff;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 16px rgba(0,0,0,0.1);
        cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        opacity: 0; visibility: hidden;
        transform: translateY(12px);
        transition: opacity 0.3s, visibility 0.3s, transform 0.3s, background 0.2s;
      }
      .back-to-top.is-visible { opacity: 1; visibility: visible; transform: translateY(0); }
      .back-to-top:hover { background: #f1f5f9; }
      .back-to-top svg { color: #1B2A5B; }
      @media(min-width:769px){ .back-to-top { bottom: 2rem; right: 2rem; } }

      /* === Image shimmer skeleton === */
      @keyframes shimmer {
        0% { background-position: -200% 0; }
        100% { background-position: 200% 0; }
      }

      /* === Sticky CTA mobile === */
      .mobile-sticky-cta {
        display: none;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 999;
        background: #fff;
        border-top: 1px solid #e2e8f0;
        box-shadow: 0 -4px 20px rgba(0,0,0,0.1);
        padding: 0.6rem 1rem;
        gap: 0.6rem;
      }
      .mobile-sticky-cta__call {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        padding: 0.7rem 1rem;
        background: #f1f5f9;
        color: #1B2A5B;
        font-weight: 600;
        font-size: 0.9rem;
        border-radius: 8px;
        text-decoration: none;
        white-space: nowrap;
      }
      .mobile-sticky-cta__register {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 1;
        padding: 0.7rem 1rem;
        background: linear-gradient(135deg, #f5c518, #e8a912);
        color: #1a1a5e;
        font-weight: 700;
        font-size: 0.95rem;
        border-radius: 8px;
        text-decoration: none;
        text-align: center;
        box-shadow: 0 2px 8px rgba(245,197,24,0.3);
      }
      @media(max-width:768px){
        .mobile-sticky-cta { display: flex; }
        body { padding-bottom: 4.5rem; }
      }
    </style>
  </body>
</html>
