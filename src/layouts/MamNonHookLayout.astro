---
/**
 * MamNonHookLayout — Long-scroll landing for Mầm non hook campaigns
 * Brand: Navy #000080 + Yellow #ffff00
 * Two-step form (email → name+phone) → POST /api/lead → redirect cam-on
 */
interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  location: string;            // "Gò Vấp" | "Cần Giuộc"
  locationSlug: string;        // "go-vap" | "can-giuoc"
  address: string;             // "123 Phan Huy Ích, P.15, Q.Gò Vấp, TPHCM"
  mapsUrl?: string;
  fomoText?: string;
  hookHeadline: string;        // "Bé 12 tháng – 5 tuổi cần trường nào ở Gò Vấp?"
  hookSubline: string;
  source: string;
  funnelCode: string;
  redirectUrl: string;
  testimonial1: { quote: string; author: string };
  testimonial2: { quote: string; author: string };
  testimonial3?: { quote: string; author: string };
}

const {
  title, description, canonicalUrl,
  location, locationSlug, address, mapsUrl,
  fomoText = '🔥 Đang nhận hồ sơ Mầm Non 2026 · Lớp giới hạn dưới 15 bé · Đặt lịch tham quan miễn phí',
  hookHeadline, hookSubline,
  source, funnelCode, redirectUrl,
  testimonial1, testimonial2, testimonial3,
} = Astro.props;

const HOTLINE = '0916 961 409';
const HOTLINE_TEL = '+84916961409';
const ZALO = 'https://zalo.me/1678310120468101523';

const schema = [
  { '@context': 'https://schema.org', '@type': 'EducationalOrganization', name: 'Trường Mầm Non Việt Anh — ' + location, url: canonicalUrl, description, address: { '@type': 'PostalAddress', streetAddress: address }, telephone: HOTLINE_TEL },
  { '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: canonicalUrl, inLanguage: 'vi' },
];
---
<!doctype html>
<html lang="vi">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content="https://media.truongvietanh.com/og/og-default.jpg" />
<meta name="twitter:card" content="summary_large_image" />
<title>{title}</title>
<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-KPL2NSR9');</script>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&family=Open+Sans:wght@400;500;600;700&display=swap&subset=vietnamese" rel="stylesheet" />

<style is:inline>
:root{
  --navy:#000080;
  --navy-2:#0a0a99;
  --navy-dk:#00004d;
  --navy-soft:#f3f4ff;
  --gold:#ffff00;
  --gold-dk:#e6e600;
  --gold-soft:#fffde6;
  --text:#1a1a2e;
  --text-muted:#5a5a70;
  --border:#e5e7eb;
  --bg:#ffffff;
  --bg-alt:#fafbff;
  --shadow-sm:0 1px 3px rgba(0,0,128,.08);
  --shadow:0 4px 16px rgba(0,0,128,.10);
  --shadow-lg:0 12px 40px rgba(0,0,128,.18);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{font-family:'Open Sans',system-ui,sans-serif;color:var(--text);background:var(--bg);line-height:1.6;font-size:16px;-webkit-font-smoothing:antialiased}
h1,h2,h3,h4{font-family:'Montserrat',sans-serif;color:var(--navy);line-height:1.2;font-weight:800}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
.wrap{max-width:1180px;margin:0 auto;padding:0 20px}

/* ─── TOP BAR ─── */
.topbar{background:var(--navy);color:#fff;padding:8px 0;font-size:13px;font-weight:600}
.topbar .wrap{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px}
.topbar a{color:var(--gold);font-weight:700}
.topbar .pill{display:inline-flex;align-items:center;gap:6px}

/* ─── HEADER ─── */
.header{background:#fff;border-bottom:1px solid var(--border);padding:12px 0;position:sticky;top:0;z-index:50;box-shadow:var(--shadow-sm)}
.header .wrap{display:flex;justify-content:space-between;align-items:center;gap:12px}
.brand{display:flex;align-items:center;gap:10px}
.brand img{height:40px;width:auto}
.brand-txt{font-family:'Montserrat',sans-serif;font-weight:800;color:var(--navy);font-size:14px;line-height:1.1}
.brand-txt span{display:block;font-size:10px;color:var(--text-muted);font-weight:600;letter-spacing:.5px}
.h-cta{display:flex;align-items:center;gap:8px}
.btn-call{background:var(--gold);color:var(--navy-dk);padding:9px 16px;border-radius:30px;font-weight:800;font-size:13px;display:inline-flex;align-items:center;gap:6px}
.btn-call:hover{background:var(--gold-dk)}
.btn-zalo{background:#0068ff;color:#fff;padding:9px 14px;border-radius:30px;font-weight:700;font-size:13px;display:inline-flex;align-items:center;gap:6px}

/* ─── HERO ─── */
.hero{background:linear-gradient(135deg,var(--navy) 0%,var(--navy-dk) 100%);color:#fff;padding:32px 0 56px;position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;top:-100px;right:-100px;width:400px;height:400px;background:radial-gradient(circle,rgba(255,255,0,.12) 0%,transparent 70%);pointer-events:none}
.hero::after{content:'';position:absolute;bottom:-200px;left:-150px;width:500px;height:500px;background:radial-gradient(circle,rgba(255,255,0,.08) 0%,transparent 70%);pointer-events:none}
.hero .wrap{position:relative;z-index:1}
.hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:48px;align-items:start}
.fomo{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,0,.15);border:1px solid rgba(255,255,0,.4);color:var(--gold);padding:8px 16px;border-radius:30px;font-size:13px;font-weight:700;margin-bottom:18px}
.h1{font-size:clamp(1.85rem,3.6vw,3rem);font-weight:900;line-height:1.12;color:#fff;margin-bottom:14px;letter-spacing:-.5px}
.h1 .mark{color:var(--gold);display:inline}
.h1 em{display:block;color:var(--gold);font-style:normal;font-weight:800;font-size:.85em;margin-top:6px}
.h-sub{font-size:17px;color:rgba(255,255,255,.88);line-height:1.6;font-weight:500;margin-bottom:22px;border-left:4px solid var(--gold);padding-left:14px}
.h-bullets{list-style:none;display:flex;flex-direction:column;gap:11px;margin-bottom:22px}
.h-bullets li{display:flex;gap:11px;font-size:15.5px;color:#fff;line-height:1.5}
.h-bullets .ico{flex:0 0 28px;height:28px;border-radius:50%;background:var(--gold);color:var(--navy-dk);display:inline-flex;align-items:center;justify-content:center;font-weight:900;font-size:14px;margin-top:1px}
.h-bullets strong{color:var(--gold)}
.h-trust{display:flex;flex-wrap:wrap;gap:18px;font-size:13px;color:rgba(255,255,255,.72);font-weight:600}
.h-trust span{display:inline-flex;align-items:center;gap:6px}
.h-trust span::before{content:'✓';color:var(--gold);font-weight:900;font-size:14px}

/* ─── FORM CARD ─── */
.fcard{background:#fff;color:var(--text);border-radius:16px;box-shadow:var(--shadow-lg);border:1px solid rgba(255,255,0,.6);position:relative;overflow:hidden}
.fcard-tag{background:var(--gold);color:var(--navy-dk);font-size:11.5px;font-weight:900;padding:9px 16px;letter-spacing:.7px;text-align:center;border-bottom:2px solid var(--navy);text-transform:uppercase}
.fcard-body{padding:24px 24px 20px}
.fcard-title{font-size:1.32rem;font-weight:900;color:var(--navy);text-align:center;margin-bottom:6px;line-height:1.25}
.fcard-sub{font-size:13px;color:var(--text-muted);text-align:center;margin-bottom:18px;font-weight:500}
.steps{display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:16px;padding-bottom:16px;border-bottom:1px dashed var(--border)}
.sdot{width:24px;height:24px;border-radius:50%;background:#e5e7eb;color:#999;font-size:11.5px;font-weight:800;display:flex;align-items:center;justify-content:center;transition:.3s;flex-shrink:0}
.sdot.active{background:var(--navy);color:var(--gold)}
.sdot.done{background:#22c55e;color:#fff}
.sline{width:30px;height:2px;background:#e5e7eb}
.slabel{font-size:12px;color:var(--navy);font-weight:700;margin-left:8px}
.sin{width:100%;padding:13px 14px;border:1.5px solid var(--border);border-radius:10px;font-size:15px;font-family:inherit;margin-bottom:10px;transition:.2s;background:var(--bg-alt)}
.sin:focus{outline:none;border-color:var(--navy);background:#fff;box-shadow:0 0 0 3px rgba(0,0,128,.1)}
.sin.error{border-color:#ef4444;background:#fff5f5}
.btn-step{width:100%;background:var(--gold);color:var(--navy-dk);border:none;padding:14px;border-radius:10px;font-size:14.5px;font-weight:900;font-family:'Montserrat',sans-serif;cursor:pointer;transition:.15s;text-transform:uppercase;letter-spacing:.4px;box-shadow:0 4px 14px rgba(255,255,0,.45)}
.btn-step:hover{background:var(--gold-dk);transform:translateY(-1px);box-shadow:0 6px 20px rgba(255,255,0,.55)}
.btn-back{background:none;border:none;color:var(--text-muted);font-size:12.5px;font-weight:600;cursor:pointer;text-decoration:underline;padding:8px 0 0;width:100%;text-align:center}
.fcard-foot{display:flex;justify-content:space-around;gap:8px;flex-wrap:wrap;font-size:11.5px;color:var(--text-muted);margin-top:14px;padding-top:12px;border-top:1px solid var(--border);font-weight:600}
.fcard-foot span{display:inline-flex;align-items:center;gap:4px}
.fcard-success{display:none;text-align:center;padding:14px 4px}
.fcard-success .icon{font-size:48px;margin-bottom:8px}
.fcard-success h3{color:var(--navy);margin-bottom:6px}
.fcard-success p{font-size:13.5px;color:var(--text-muted)}

/* ─── TRUST BAR ─── */
.tbar{background:var(--gold);padding:18px 0;border-bottom:4px solid var(--navy)}
.tbar .wrap{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;text-align:center}
.tbar-item{display:flex;flex-direction:column;align-items:center;gap:4px}
.tbar-num{font-family:'Montserrat',sans-serif;font-weight:900;font-size:1.8rem;color:var(--navy);line-height:1}
.tbar-lbl{font-size:11.5px;color:var(--navy);font-weight:700;text-transform:uppercase;letter-spacing:.4px}

/* ─── SECTION BASE ─── */
.section{padding:64px 0}
.section-alt{background:var(--bg-alt)}
.eyebrow{display:inline-block;background:var(--navy-soft);color:var(--navy);padding:6px 14px;border-radius:20px;font-size:12px;font-weight:800;letter-spacing:.6px;text-transform:uppercase;margin-bottom:12px}
.h2{font-size:clamp(1.6rem,3vw,2.3rem);font-weight:900;line-height:1.18;margin-bottom:14px;color:var(--navy)}
.h2 em{color:var(--gold-dk);font-style:normal;background:linear-gradient(180deg,transparent 60%,var(--gold) 60%);padding:0 4px}
.lead{font-size:17px;color:var(--text-muted);max-width:680px;line-height:1.6}
.section-head{text-align:center;margin-bottom:40px}
.section-head .lead{margin:0 auto}

/* ─── PAIN ─── */
.pain-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:34px}
.pain-card{background:#fff;border:1px solid var(--border);border-radius:14px;padding:22px;box-shadow:var(--shadow-sm);transition:.2s}
.pain-card:hover{transform:translateY(-3px);box-shadow:var(--shadow);border-color:var(--gold)}
.pain-card .ico{font-size:32px;margin-bottom:10px}
.pain-card h3{font-size:1.1rem;color:var(--navy);margin-bottom:8px}
.pain-card p{font-size:14.5px;color:var(--text-muted);line-height:1.55}
.pain-card .ans{margin-top:12px;padding-top:12px;border-top:2px dashed var(--gold);font-size:14px;color:var(--navy);font-weight:600}
.pain-card .ans::before{content:'✓ ';color:#16a34a;font-weight:900}

/* ─── USPs ─── */
.usp-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:34px}
.usp{background:#fff;border:1px solid var(--border);border-radius:16px;padding:26px;text-align:center;transition:.25s;position:relative;overflow:hidden}
.usp::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,var(--navy),var(--gold));transform:scaleX(0);transform-origin:left;transition:.3s}
.usp:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg);border-color:var(--gold)}
.usp:hover::before{transform:scaleX(1)}
.usp .ico{width:64px;height:64px;border-radius:50%;background:var(--navy-soft);color:var(--navy);display:inline-flex;align-items:center;justify-content:center;font-size:30px;margin-bottom:14px}
.usp h3{font-size:1.15rem;color:var(--navy);margin-bottom:10px}
.usp p{font-size:14.5px;color:var(--text-muted);line-height:1.6}

/* ─── DAY TIMELINE ─── */
.day{background:linear-gradient(180deg,var(--navy) 0%,var(--navy-dk) 100%);color:#fff;border-radius:20px;padding:36px;margin-top:24px;position:relative;overflow:hidden}
.day::before{content:'🌅';position:absolute;top:18px;right:24px;font-size:48px;opacity:.15}
.day h3{color:var(--gold);font-size:1.5rem;margin-bottom:6px}
.day p.day-sub{color:rgba(255,255,255,.75);font-size:14.5px;margin-bottom:22px}
.tl{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
.tl-row{display:flex;gap:14px;align-items:flex-start;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:11px;padding:13px 15px;transition:.2s}
.tl-row:hover{background:rgba(255,255,0,.08);border-color:var(--gold)}
.tl-time{flex:0 0 auto;font-family:'Montserrat',sans-serif;font-weight:900;color:var(--gold);font-size:13px;background:rgba(255,255,0,.12);padding:5px 10px;border-radius:7px;white-space:nowrap}
.tl-act{font-size:14px;color:#fff;line-height:1.45;font-weight:500}

/* ─── TESTIMONIALS ─── */
.tstm-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:34px}
.tstm{background:#fff;border:1px solid var(--border);border-radius:16px;padding:26px;position:relative;box-shadow:var(--shadow-sm)}
.tstm::before{content:'"';position:absolute;top:6px;left:18px;font-family:'Montserrat',sans-serif;font-size:80px;color:var(--gold);line-height:1;font-weight:900;opacity:.7}
.tstm .stars{color:var(--gold-dk);font-size:18px;margin-bottom:10px;position:relative;z-index:1}
.tstm-quote{font-size:15px;color:var(--text);line-height:1.65;margin-bottom:14px;position:relative;z-index:1;font-style:italic}
.tstm-author{display:flex;align-items:center;gap:11px;border-top:1px solid var(--border);padding-top:14px}
.tstm-avatar{width:42px;height:42px;border-radius:50%;background:linear-gradient(135deg,var(--navy),var(--navy-2));color:var(--gold);display:flex;align-items:center;justify-content:center;font-weight:900;font-family:'Montserrat',sans-serif}
.tstm-name{font-size:13px;color:var(--navy);font-weight:800;line-height:1.3}
.tstm-name span{display:block;color:var(--text-muted);font-weight:500;font-size:12px}

/* ─── LOCATION ─── */
.loc{background:linear-gradient(135deg,var(--gold-soft) 0%,#fff 100%);border:2px solid var(--gold);border-radius:20px;padding:36px;display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:center;margin-top:24px}
.loc-info h3{font-size:1.5rem;color:var(--navy);margin-bottom:14px}
.loc-info p{font-size:15px;color:var(--text);margin-bottom:8px;display:flex;gap:8px;align-items:flex-start}
.loc-info p strong{color:var(--navy);min-width:90px;display:inline-block}
.loc-cta{text-align:center}
.loc-cta a{display:block;margin-bottom:10px}
.btn-big-call{background:var(--navy);color:#fff;padding:18px 24px;border-radius:14px;font-weight:900;font-size:18px;font-family:'Montserrat',sans-serif;display:flex;align-items:center;justify-content:center;gap:10px;box-shadow:var(--shadow);transition:.2s}
.btn-big-call:hover{background:var(--navy-2);transform:translateY(-2px);box-shadow:var(--shadow-lg)}
.btn-big-zalo{background:#0068ff;color:#fff;padding:14px 20px;border-radius:12px;font-weight:800;font-size:15px;display:flex;align-items:center;justify-content:center;gap:8px;transition:.15s}
.btn-big-zalo:hover{background:#0055d6}
.btn-big-map{background:#fff;color:var(--navy);border:2px solid var(--navy);padding:13px 20px;border-radius:12px;font-weight:800;font-size:14px;display:flex;align-items:center;justify-content:center;gap:8px;transition:.15s}
.btn-big-map:hover{background:var(--navy);color:#fff}

/* ─── FAQ ─── */
.faq{max-width:820px;margin:34px auto 0}
.faq-item{background:#fff;border:1px solid var(--border);border-radius:14px;margin-bottom:12px;overflow:hidden;transition:.2s}
.faq-item[open]{border-color:var(--gold);box-shadow:var(--shadow)}
.faq-q{padding:18px 22px;font-weight:800;color:var(--navy);font-size:15.5px;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:12px;list-style:none;font-family:'Montserrat',sans-serif}
.faq-q::-webkit-details-marker{display:none}
.faq-q::after{content:'+';color:var(--gold-dk);font-size:24px;font-weight:900;flex-shrink:0;transition:.2s;line-height:1}
.faq-item[open] .faq-q::after{transform:rotate(45deg);color:var(--navy)}
.faq-a{padding:0 22px 20px;color:var(--text-muted);font-size:14.5px;line-height:1.65}

/* ─── FINAL CTA ─── */
.final{background:linear-gradient(135deg,var(--navy) 0%,var(--navy-dk) 100%);color:#fff;padding:64px 0;text-align:center;position:relative;overflow:hidden}
.final::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 30% 30%,rgba(255,255,0,.1) 0%,transparent 60%);pointer-events:none}
.final .wrap{position:relative;z-index:1;max-width:820px}
.final h2{color:#fff;font-size:clamp(1.6rem,3.4vw,2.4rem)}
.final h2 em{background:none;color:var(--gold);font-style:normal}
.final p{font-size:17px;color:rgba(255,255,255,.85);margin:14px 0 26px}
.final-cta{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
.final-cta .btn{padding:18px 30px;border-radius:14px;font-weight:900;font-size:16px;font-family:'Montserrat',sans-serif;text-transform:uppercase;letter-spacing:.4px;transition:.2s;display:inline-flex;align-items:center;gap:8px}
.final-cta .btn-y{background:var(--gold);color:var(--navy-dk);box-shadow:0 6px 20px rgba(255,255,0,.4)}
.final-cta .btn-y:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(255,255,0,.55)}
.final-cta .btn-w{background:transparent;color:#fff;border:2px solid #fff}
.final-cta .btn-w:hover{background:#fff;color:var(--navy)}

/* ─── FOOTER ─── */
.foot{background:#0a0a3a;color:rgba(255,255,255,.6);padding:24px 0;font-size:13px;text-align:center}
.foot strong{color:var(--gold)}

/* ─── STICKY MOBILE CTA ─── */
.mcta{display:none}

/* ─── RESPONSIVE ─── */
@media (max-width:960px){
  .hero-grid{grid-template-columns:1fr;gap:30px}
  .pain-grid,.usp-grid,.tstm-grid{grid-template-columns:1fr}
  .tl{grid-template-columns:1fr}
  .loc{grid-template-columns:1fr;padding:26px}
  .tbar .wrap{grid-template-columns:repeat(2,1fr);gap:20px}
}
@media (max-width:640px){
  .topbar{font-size:12px}
  .topbar .wrap{justify-content:center;text-align:center}
  .header{padding:10px 0}
  .brand img{height:34px}
  .brand-txt{font-size:12px}
  .brand-txt span{font-size:9px}
  .h-cta .btn-zalo{display:none}
  .btn-call{padding:8px 12px;font-size:12px}
  .hero{padding:24px 0 40px}
  .h1{font-size:1.8rem}
  .h-sub{font-size:15px}
  .h-bullets li{font-size:14.5px}
  .section{padding:48px 0}
  .day{padding:24px 18px}
  .tl-row{padding:11px 13px}
  .tbar-num{font-size:1.4rem}
  .tbar-lbl{font-size:10px}
  .final-cta{flex-direction:column}
  .final-cta .btn{width:100%;justify-content:center}
  body{padding-bottom:72px}
  .mcta{display:flex;position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:2px solid var(--gold);padding:10px 12px;gap:8px;z-index:100;box-shadow:0 -4px 16px rgba(0,0,0,.12)}
  .mcta a{flex:1;padding:12px;border-radius:10px;font-weight:800;font-size:14px;display:flex;align-items:center;justify-content:center;gap:6px}
  .mcta .m-call{background:var(--navy);color:#fff}
  .mcta .m-form{background:var(--gold);color:var(--navy-dk)}
}
</style>
</head>
<body>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KPL2NSR9" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<!-- TOP BAR -->
<div class="topbar">
  <div class="wrap">
    <span class="pill">📍 Cơ sở {location} · Đang nhận hồ sơ Mầm Non 2026</span>
    <span class="pill">📞 Hotline: <a href={`tel:${HOTLINE_TEL}`}>{HOTLINE}</a></span>
  </div>
</div>

<!-- HEADER -->
<header class="header">
  <div class="wrap">
    <a href="/" class="brand" aria-label="Trường Việt Anh">
      <img src="/logo-vietanh.webp" alt="Trường Việt Anh" />
      <div class="brand-txt">Trường Việt Anh<span>15 năm K12 từ 2011</span></div>
    </a>
    <div class="h-cta">
      <a href={ZALO} target="_blank" rel="noopener" class="btn-zalo">💬 Zalo</a>
      <a href={`tel:${HOTLINE_TEL}`} class="btn-call">📞 {HOTLINE}</a>
    </div>
  </div>
</header>

<!-- HERO -->
<section class="hero">
  <div class="wrap">
    <div class="hero-grid">
      <div>
        <div class="fomo">{fomoText}</div>
        <h1 class="h1" set:html={hookHeadline} />
        <p class="h-sub">{hookSubline}</p>
        <ul class="h-bullets">
          <li><span class="ico">📹</span><span><strong>Camera online 24/7</strong> — mẹ xem con mọi lúc qua app, đi làm vẫn yên tâm</span></li>
          <li><span class="ico">👶</span><span><strong>Lớp siêu nhỏ &lt; 15 bé</strong> · 2 cô/lớp — từng bé được quan tâm riêng</span></li>
          <li><span class="ico">💛</span><span><strong>Cô tận tâm như mẹ thứ hai</strong> — gắn bó nhiều năm, hiểu tính cách từng bé</span></li>
          <li><span class="ico">🍱</span><span><strong>Bếp ăn tại trường</strong> — thực đơn dinh dưỡng xoay vòng theo lứa tuổi</span></li>
        </ul>
        <div class="h-trust">
          <span>Bộ GD&ĐT cấp phép</span>
          <span>15 năm kinh nghiệm</span>
          <span>3 cơ sở TPHCM + Long An</span>
        </div>
      </div>

      <!-- FORM CARD -->
      <aside class="fcard" id="formArea">
        <div class="fcard-tag">⏰ Tư vấn miễn phí · Phản hồi 24h</div>
        <div class="fcard-body">
          <h3 class="fcard-title">Đặt lịch tham quan Mầm Non {location}</h3>
          <p class="fcard-sub">45–60 phút · Gặp cô · Xem lớp · Xem bếp ăn</p>

          <div class="steps">
            <div class="sdot active" id="dot1">1</div>
            <div class="sline"></div>
            <div class="sdot" id="dot2">2</div>
            <span class="slabel" id="slabel">Email của Ba/Mẹ</span>
          </div>

          <div id="step1">
            <input class="sin" type="email" id="sq-email" placeholder="email@cuabame.com" autocomplete="email" />
            <button type="button" class="btn-step" onclick="sqNext()">Tiếp tục →</button>
          </div>

          <div id="step2" style="display:none">
            <input class="sin" type="text" id="sq-name" placeholder="Họ tên Ba/Mẹ" autocomplete="name" />
            <input class="sin" type="tel" id="sq-phone" placeholder="Số điện thoại" autocomplete="tel" />
            <button type="button" class="btn-step" onclick="sqSubmit()">🏫 Đặt lịch tham quan</button>
            <button type="button" class="btn-back" onclick="sqBack()">← Quay lại</button>
          </div>

          <div class="fcard-foot">
            <span>🔒 Bảo mật</span>
            <span>📞 Phản hồi 24h</span>
            <span>💯 Miễn phí</span>
          </div>
        </div>
      </aside>

      <div class="fcard fcard-success" id="sqSuccess" style="display:none;grid-column:2;align-self:start">
        <div class="icon">🎉</div>
        <h3>Đã nhận đăng ký!</h3>
        <p>Đang chuyển hướng…</p>
      </div>
    </div>
  </div>
</section>

<!-- TRUST BAR -->
<section class="tbar">
  <div class="wrap">
    <div class="tbar-item"><div class="tbar-num">15+</div><div class="tbar-lbl">Năm kinh nghiệm</div></div>
    <div class="tbar-item"><div class="tbar-num">3.000+</div><div class="tbar-lbl">Học sinh đang học</div></div>
    <div class="tbar-item"><div class="tbar-num">&lt;15</div><div class="tbar-lbl">Bé / lớp Mầm non</div></div>
    <div class="tbar-item"><div class="tbar-num">24/7</div><div class="tbar-lbl">Camera online</div></div>
  </div>
</section>

<!-- PAIN -->
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">3 NỖI LO LỚN NHẤT CỦA MẸ</div>
      <h2 class="h2">Bé 12 tháng – 5 tuổi: <em>Mẹ đang lo điều gì?</em></h2>
      <p class="lead">Tôi hiểu — gửi con đi học là quyết định khó khăn. Hãy xem Việt Anh đã giải quyết 3 nỗi lo phổ biến nhất như thế nào.</p>
    </div>

    <div class="pain-grid">
      <div class="pain-card">
        <div class="ico">😰</div>
        <h3>Sợ con bị quên, không được quan tâm riêng</h3>
        <p>Lớp đông 30-40 bé, cô không xuể, con khóc cả ngày mà mẹ không biết.</p>
        <div class="ans">Lớp Mầm non Việt Anh dưới 15 bé · 2 cô/lớp — từng bé có hồ sơ theo dõi riêng hàng tuần</div>
      </div>
      <div class="pain-card">
        <div class="ico">📵</div>
        <h3>Đi làm cả ngày, không biết con ổn không</h3>
        <p>Trường không cho xem camera, gọi điện cô không bắt máy, tâm trạng lo cả ngày.</p>
        <div class="ans">Camera online 24/7 ngay trên app — mẹ xem con bất cứ lúc nào, từ đâu cũng được</div>
      </div>
      <div class="pain-card">
        <div class="ico">🥗</div>
        <h3>Ăn uống bên ngoài, không biết sạch không</h3>
        <p>Trường thuê đối tác nấu ăn rẻ tiền, thực đơn lặp đi lặp lại, con biếng ăn.</p>
        <div class="ans">Bếp ăn riêng tại trường · thực đơn xoay vòng 4 tuần · chuẩn dinh dưỡng theo lứa tuổi</div>
      </div>
    </div>
  </div>
</section>

<!-- USPs -->
<section class="section section-alt">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">VÌ SAO PHỤ HUYNH CHỌN VIỆT ANH</div>
      <h2 class="h2">6 lý do mẹ <em>yên tâm gửi con</em> tại Mầm Non Việt Anh {location}</h2>
    </div>

    <div class="usp-grid">
      <div class="usp"><div class="ico">📹</div><h3>Camera online 24/7</h3><p>Phụ huynh xem con mọi lúc qua app — đi làm vẫn yên tâm. Không phải xin phép, không hạn chế giờ.</p></div>
      <div class="usp"><div class="ico">👶</div><h3>Lớp siêu nhỏ &lt; 15 bé</h3><p>2 cô/lớp · tỷ lệ 1 cô : 7-8 bé — từng bé được ôm ấp, dạy dỗ, hiểu tính cách riêng.</p></div>
      <div class="usp"><div class="ico">💛</div><h3>Cô tận tâm như mẹ thứ hai</h3><p>Đội ngũ giáo viên gắn bó nhiều năm — không thay đổi liên tục. Hiểu nhịp sinh hoạt từng bé.</p></div>
      <div class="usp"><div class="ico">🍱</div><h3>Dinh dưỡng chuẩn — bếp tại trường</h3><p>Thực đơn xoay vòng 4 tuần · cân đối 4 nhóm chất · kiểm tra ATTP hàng tháng.</p></div>
      <div class="usp"><div class="ico">🎨</div><h3>Học qua chơi — phát triển toàn diện</h3><p>Ngôn ngữ song ngữ · vận động · cảm xúc · xã hội · STEM nhí — không ép, học vui mỗi ngày.</p></div>
      <div class="usp"><div class="ico">📋</div><h3>PDR — Báo cáo cá nhân hàng tuần</h3><p>Personal Development Record: theo dõi 4 trụ cột. Mẹ nhận báo cáo hàng tuần qua email.</p></div>
    </div>
  </div>
</section>

<!-- DAY TIMELINE -->
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">MỘT NGÀY CỦA BÉ</div>
      <h2 class="h2">Lịch sinh hoạt <em>khoa học, vui vẻ</em></h2>
      <p class="lead">Cân bằng giữa học, chơi, ăn, ngủ — phù hợp với nhịp sinh học của bé Mầm non.</p>
    </div>

    <div class="day">
      <h3>📅 Một ngày tại Mầm Non Việt Anh</h3>
      <p class="day-sub">Thứ 2 – Thứ 6 · Bán trú đến 17:00 · Ăn xế và đón muộn linh hoạt</p>
      <div class="tl">
        <div class="tl-row"><span class="tl-time">7:30 – 8:00</span><span class="tl-act">Đón trẻ · Chơi tự do · Tâm sự với cô</span></div>
        <div class="tl-row"><span class="tl-time">8:00 – 9:00</span><span class="tl-act">Circle Time · Hát · Chào ngày mới (song ngữ)</span></div>
        <div class="tl-row"><span class="tl-time">9:00 – 10:00</span><span class="tl-act">Học theo chủ đề · Tiếng Anh với cô bản ngữ</span></div>
        <div class="tl-row"><span class="tl-time">10:00 – 10:30</span><span class="tl-act">Ăn nhẹ · Vận động ngoài trời</span></div>
        <div class="tl-row"><span class="tl-time">10:30 – 11:30</span><span class="tl-act">Nghệ thuật · Âm nhạc · STEM nhí</span></div>
        <div class="tl-row"><span class="tl-time">11:30 – 13:00</span><span class="tl-act">Ăn trưa · Ngủ trưa</span></div>
        <div class="tl-row"><span class="tl-time">13:00 – 14:30</span><span class="tl-act">Hoạt động chiều tự chọn (theo nhóm sở thích)</span></div>
        <div class="tl-row"><span class="tl-time">14:30 – 15:00</span><span class="tl-act">Ăn xế · Tắm rửa · Thay đồ</span></div>
        <div class="tl-row"><span class="tl-time">15:00 – 17:00</span><span class="tl-act">CLB ngoại khóa · Chơi tự do · Đón trẻ</span></div>
        <div class="tl-row" style="background:rgba(255,255,0,.12);border-color:var(--gold)"><span class="tl-time">CẢ NGÀY</span><span class="tl-act"><strong style="color:var(--gold)">📹 Camera online</strong> — mẹ xem bất cứ lúc nào</span></div>
      </div>
    </div>
  </div>
</section>

<!-- TESTIMONIALS -->
<section class="section section-alt">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">PHỤ HUYNH NÓI GÌ</div>
      <h2 class="h2">Hơn 3.000 gia đình đã <em>tin tưởng Việt Anh</em></h2>
      <p class="lead">Những chia sẻ thật từ phụ huynh đang gửi con tại cơ sở {location}.</p>
    </div>

    <div class="tstm-grid">
      <div class="tstm">
        <div class="stars">★★★★★</div>
        <p class="tstm-quote">{testimonial1.quote}</p>
        <div class="tstm-author">
          <div class="tstm-avatar">{testimonial1.author.replace(/^—\s*/,'').charAt(0)}</div>
          <div class="tstm-name">{testimonial1.author.replace(/^—\s*/,'').split(',')[0]}<span>{testimonial1.author.split(',').slice(1).join(',').trim()}</span></div>
        </div>
      </div>
      <div class="tstm">
        <div class="stars">★★★★★</div>
        <p class="tstm-quote">{testimonial2.quote}</p>
        <div class="tstm-author">
          <div class="tstm-avatar">{testimonial2.author.replace(/^—\s*/,'').charAt(0)}</div>
          <div class="tstm-name">{testimonial2.author.replace(/^—\s*/,'').split(',')[0]}<span>{testimonial2.author.split(',').slice(1).join(',').trim()}</span></div>
        </div>
      </div>
      {testimonial3 && (
        <div class="tstm">
          <div class="stars">★★★★★</div>
          <p class="tstm-quote">{testimonial3.quote}</p>
          <div class="tstm-author">
            <div class="tstm-avatar">{testimonial3.author.replace(/^—\s*/,'').charAt(0)}</div>
            <div class="tstm-name">{testimonial3.author.replace(/^—\s*/,'').split(',')[0]}<span>{testimonial3.author.split(',').slice(1).join(',').trim()}</span></div>
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<!-- LOCATION -->
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">CƠ SỞ {location.toUpperCase()}</div>
      <h2 class="h2">Đến tham quan <em>trực tiếp</em></h2>
      <p class="lead">Gặp cô · Xem lớp · Xem bếp · Đặt mọi câu hỏi của Ba/Mẹ — 45-60 phút, miễn phí, không ràng buộc.</p>
    </div>

    <div class="loc">
      <div class="loc-info">
        <h3>📍 Mầm Non Việt Anh — {location}</h3>
        <p><strong>Địa chỉ:</strong> <span>{address}</span></p>
        <p><strong>Giờ làm việc:</strong> <span>Thứ 2 – Thứ 7 · 7:30 – 17:00</span></p>
        <p><strong>Đối tượng:</strong> <span>Bé 12 tháng – 5 tuổi · Bán trú · Xe đưa rước</span></p>
        <p><strong>Học phí:</strong> <span>Từ 7 triệu/tháng (đã bao gồm ăn 3 bữa)</span></p>
      </div>
      <div class="loc-cta">
        <a href={`tel:${HOTLINE_TEL}`} class="btn-big-call">📞 Gọi {HOTLINE}</a>
        <a href={ZALO} target="_blank" rel="noopener" class="btn-big-zalo">💬 Nhắn Zalo ngay</a>
        {mapsUrl && <a href={mapsUrl} target="_blank" rel="noopener" class="btn-big-map">🗺️ Xem trên Google Maps</a>}
      </div>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="section section-alt">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">CÂU HỎI THƯỜNG GẶP</div>
      <h2 class="h2">Mẹ thường <em>thắc mắc</em> điều gì?</h2>
    </div>

    <div class="faq">
      <details class="faq-item" open>
        <summary class="faq-q">Bé bao nhiêu tuổi nhận học?</summary>
        <div class="faq-a">Mầm Non Việt Anh nhận bé từ <strong>12 tháng đến 5 tuổi</strong>. Lớp được chia theo nhóm tuổi: nhà trẻ (12-24 tháng), mầm (2-3 tuổi), chồi (3-4 tuổi), lá (4-5 tuổi).</div>
      </details>
      <details class="faq-item">
        <summary class="faq-q">Học phí bao nhiêu?</summary>
        <div class="faq-a">Học phí Mầm non từ <strong>7 triệu/tháng</strong> (đã bao gồm 3 bữa ăn + tiếng Anh hàng ngày). Có ưu đãi đăng ký sớm và anh chị em học cùng. Đặt lịch tham quan để nhận bảng giá chi tiết.</div>
      </details>
      <details class="faq-item">
        <summary class="faq-q">Có xe đưa rước không?</summary>
        <div class="faq-a">Có. Xe đưa rước có GPS tracking, giám sát viên đi kèm mỗi chuyến, phụ huynh nhận thông báo realtime qua app. Phủ sóng khu vực {location} và lân cận.</div>
      </details>
      <details class="faq-item">
        <summary class="faq-q">Camera online hoạt động thế nào?</summary>
        <div class="faq-a">Mỗi lớp có camera HD ghi hình 24/7. Phụ huynh đăng nhập app riêng (chỉ xem được lớp con mình) — xem trực tiếp bất cứ lúc nào, không hạn chế giờ.</div>
      </details>
      <details class="faq-item">
        <summary class="faq-q">Tham quan có mất phí không?</summary>
        <div class="faq-a"><strong>Hoàn toàn miễn phí và không ràng buộc.</strong> Buổi tham quan kéo dài 45-60 phút: gặp giáo viên chủ nhiệm, xem lớp học, sân chơi, bếp ăn. Phụ huynh được đặt mọi câu hỏi.</div>
      </details>
      <details class="faq-item">
        <summary class="faq-q">PDR là gì?</summary>
        <div class="faq-a">Personal Development Record — hệ thống theo dõi cá nhân từng bé hàng tuần trên 4 trụ cột: Nhận thức, Ngôn ngữ, Vận động, Cảm xúc-Xã hội. Phụ huynh nhận báo cáo qua email mỗi tuần.</div>
      </details>
    </div>
  </div>
</section>

<!-- FINAL CTA -->
<section class="final">
  <div class="wrap">
    <h2>Sẵn sàng cho bé một <em>khởi đầu tuyệt vời</em>?</h2>
    <p>Đặt lịch tham quan miễn phí ngay hôm nay — gặp cô, xem lớp, cảm nhận không khí Việt Anh.</p>
    <div class="final-cta">
      <a href="#formArea" class="btn btn-y">🏫 Đặt lịch tham quan</a>
      <a href={`tel:${HOTLINE_TEL}`} class="btn btn-w">📞 Gọi {HOTLINE}</a>
    </div>
  </div>
</section>

<!-- FOOTER -->
<footer class="foot">
  <div class="wrap">
    © 2026 <strong>Trường Việt Anh</strong> — 15 năm K12 từ 2011 · Mầm non · Tiểu học · THCS · THPT · 3 cơ sở TPHCM + Long An
  </div>
</footer>

<!-- STICKY MOBILE CTA -->
<div class="mcta">
  <a href={`tel:${HOTLINE_TEL}`} class="m-call">📞 Gọi ngay</a>
  <a href="#formArea" class="m-form">🏫 Đặt lịch</a>
</div>

<script define:vars={{ source, funnelCode, redirectUrl }}>
(function(){
  var SRC = source, FC = funnelCode, REDIRECT = redirectUrl;

  if (localStorage.getItem('sq_' + SRC)) {
    var fa = document.getElementById('formArea');
    var su = document.getElementById('sqSuccess');
    if (fa) fa.style.display = 'none';
    if (su) su.style.display = 'block';
  }

  window.sqNext = function(){
    var el = document.getElementById('sq-email');
    var v = el ? el.value.trim() : '';
    if (!v || v.indexOf('@') < 1) { if (el){ el.classList.add('error'); el.focus(); } return; }
    el.classList.remove('error');
    document.getElementById('step1').style.display = 'none';
    document.getElementById('step2').style.display = 'block';
    var d1 = document.getElementById('dot1'), d2 = document.getElementById('dot2'), sl = document.getElementById('slabel');
    if (d1){ d1.classList.remove('active'); d1.classList.add('done'); }
    if (d2) d2.classList.add('active');
    if (sl) sl.textContent = 'Họ tên & SĐT';
    var n = document.getElementById('sq-name'); if (n) n.focus();
  };

  window.sqBack = function(){
    document.getElementById('step2').style.display = 'none';
    document.getElementById('step1').style.display = 'block';
    var d1 = document.getElementById('dot1'), d2 = document.getElementById('dot2'), sl = document.getElementById('slabel');
    if (d2) d2.classList.remove('active');
    if (d1){ d1.classList.remove('done'); d1.classList.add('active'); }
    if (sl) sl.textContent = 'Email của Ba/Mẹ';
  };

  window.sqSubmit = function(){
    var nameEl = document.getElementById('sq-name');
    var phoneEl = document.getElementById('sq-phone');
    var name = nameEl ? nameEl.value.trim() : '';
    var phone = phoneEl ? phoneEl.value.trim() : '';
    if (!name){ if (nameEl){ nameEl.classList.add('error'); nameEl.focus(); } return; }
    nameEl.classList.remove('error');
    if (!phone || phone.replace(/[^0-9]/g,'').length < 9){ if (phoneEl){ phoneEl.classList.add('error'); phoneEl.focus(); } return; }
    phoneEl.classList.remove('error');
    var emailEl = document.getElementById('sq-email');
    var email = emailEl ? emailEl.value.trim() : '';

    localStorage.setItem('sq_' + SRC, '1');
    var fa = document.getElementById('formArea');
    var su = document.getElementById('sqSuccess');
    if (fa) fa.style.display = 'none';
    if (su) su.style.display = 'block';

    fetch('https://truongvietanh.com/api/lead', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        fullName: name, phone: phone, email: email,
        source: SRC, funnel_code: FC, school_level: 'mam-non',
        page_url: location.href,
        submitted_at: new Date().toISOString()
      }),
      mode: 'cors'
    }).catch(function(){});

    setTimeout(function(){ window.location.href = REDIRECT; }, 1500);
  };

  var ein = document.getElementById('sq-email');
  if (ein) ein.addEventListener('keydown', function(e){ if (e.key === 'Enter'){ e.preventDefault(); sqNext(); } });
  var pin = document.getElementById('sq-phone');
  if (pin) pin.addEventListener('keydown', function(e){ if (e.key === 'Enter'){ e.preventDefault(); sqSubmit(); } });
})();
</script>
</body>
</html>
