      <a href="https://zalo.me/1678310120468101523" target="_blank" rel="noopener" class="sp-chat-btn sp-chat-btn--zalo">
        <img src="https://page.zalo.me/static/img/zalo-logo.svg" alt="Zalo" width="18" height="18" onerror="this.style.display='none'" />
        Zalo OA
