<style is:inline>*{box-sizing:border-box;margin:0;padding:0}html{font-size:16px;scroll-behavior:smooth}body{font-family:"Inter","Open Sans",system-ui,-apple-system,sans-serif;line-height:1.65;color:#1a1a2e;background:#fff}h1,h2,h3,h4{font-family:"Montserrat","Inter",sans-serif;line-height:1.25;text-wrap:balance}a{color:inherit}img{max-width:100%;height:auto;display:block}/* === NAV === */
.sp-nav{position:sticky;top:0;z-index:1000;background:#26275D;padding:.25rem 1.5rem;box-shadow:0 2px 12px rgba(38,39,93,.3)}.sp-nav__inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1rem}.sp-nav__brand{display:flex;align-items:center;justify-content:center;text-decoration:none;color:#fff;margin:-.4rem 0}.sp-nav__logo{height:52px;width:auto;display:block}.sp-nav__btns{display:flex;gap:.5rem;align-items:center;justify-content:flex-end}.sp-btn{display:inline-flex;align-items:center;gap:.4rem;padding:.5rem 1rem;border-radius:6px;font-size:1rem;font-weight:700;text-decoration:none;border:none;cursor:pointer;transition:all .2s;white-space:nowrap}.sp-btn--gold{background:#f9dd0e;color:#26275D}.sp-btn--gold:hover{background:#f9dd0e}.sp-btn--ghost{background:transparent;color:#fff;border:1.5px solid rgba(255,255,255,.5)}.sp-btn--ghost:hover{background:rgba(255,255,255,.12);border-color:#fff}
