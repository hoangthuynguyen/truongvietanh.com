<!-- MOBILE STICKY CTA -->
<div class="sp-mobile-cta">
  <a href="#sp-form1">Nhận tư vấn ngay →</a>
</div>

<script is:inline>
// Scroll depth tracking
(function(){
  let maxD=0;
  window.addEventListener('scroll',function(){
    var p=Math.round((window.scrollY/(document.documentElement.scrollHeight-window.innerHeight))*100);
    if(p>maxD){maxD=p;[25,50,75,90].forEach(function(d){if(p>=d&&maxD<=d+1&&window.dataLayer){window.dataLayer.push({event:'scroll_depth',depth:String(d)});}});}
  },{passive:true});
})();
</script>
</body>
</html>
