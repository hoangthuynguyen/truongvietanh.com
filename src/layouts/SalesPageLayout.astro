}/* === PAIN (Block 2) === */
.sp-pain{background:#fff;color:#1a1a2e;padding:4rem 1.5rem;border-top:3px solid #f1f5f9}.sp-pain__inner{max-width:780px;margin:0 auto}.sp-pain__eyebrow{font-size:1rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#26275D;margin-bottom:1rem}.sp-pain h2{font-size:1.85rem;color:#26275D;margin-bottom:1.5rem;line-height:1.2}.sp-pain p{font-size:1.05rem;color:#475569;line-height:1.8;margin-bottom:1rem}.sp-pain__list{list-style:none;padding:0;margin:1.5rem 0 0;display:flex;flex-direction:column;gap:.85rem}.sp-pain__list li{display:flex;align-items:flex-start;gap:.75rem;font-size:1rem;color:#475569}.sp-pain__list li::before{content:'→';color:#26275D;font-weight:700;flex-shrink:0;margin-top:.15rem}
@media(max-width:640px){.sp-pain h2{font-size:1.45rem}}/* === FEATURES (Block 3) === */
.sp-features{padding:4rem 1.5rem;background:#f8fafc}.sp-features__inner{max-width:1100px;margin:0 auto}.sp-features__eyebrow{font-size:1rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#26275D;text-align:center;margin-bottom:.75rem}.sp-features h2{text-align:center;font-size:1.85rem;color:#26275D;margin-bottom:.75rem;line-height:1.25}.sp-features__sub{text-align:center;color:#64748b;font-size:1rem;margin-bottom:2.5rem;max-width:600px;margin-left:auto;margin-right:auto}.sp-features__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem}.sp-feat-card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:1.5rem;transition:box-shadow .2s,transform .2s}.sp-feat-card:hover{box-shadow:0 8px 30px rgba(38,39,93,.1);transform:translateY(-3px)}.sp-feat-card__icon{font-size:2rem;margin-bottom:.85rem}.sp-feat-card h3{font-size:1.5rem;font-weight:700;color:#26275D;margin-bottom:.5rem}.sp-feat-card p{font-size:1rem;color:#64748b;line-height:1.6}.sp-feat-card__tag{display:inline-block;background:#eff6ff;color:#2563eb;font-size:1rem;font-weight:700;padding:.2rem .6rem;border-radius:50px;margin-top:.75rem}
@media(max-width:900px){.sp-features__grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:560px){.sp-features__grid{grid-template-columns:1fr}}
@media(max-width:640px){.sp-features h2{font-size:1.45rem}}/* === TEXT WITH IMAGE (Block 4) === */
.sp-textimg{padding:4rem 1.5rem;background:#fff}.sp-textimg__inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:center}.sp-textimg__inner--reverse{direction:rtl}.sp-textimg__inner--reverse>*{direction:ltr}.sp-textimg__text{}.sp-textimg__eyebrow{font-size:1rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#26275D;margin-bottom:.75rem}.sp-textimg h2{font-size:1.75rem;color:#26275D;margin-bottom:1rem;line-height:1.25}.sp-textimg p{color:#475569;font-size:1rem;line-height:1.8;margin-bottom:.85rem}.sp-textimg__img{border-radius:16px;overflow:hidden;box-shadow:0 12px 40px rgba(0,0,0,.12)}.sp-textimg__img img{width:100%;height:340px;object-fit:cover}
@media(max-width:768px){.sp-textimg__inner{grid-template-columns:1fr}.sp-textimg h2{font-size:1.45rem}}/* === STATS (Block 5) === */
.sp-stats{padding:4rem 1.5rem;background:linear-gradient(135deg,#26275D 0%,#18193a 100%);color:#fff;text-align:center}.sp-stats__inner{max-width:1240px;margin:0 auto}.sp-stats__eyebrow{font-size:1rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#f9dd0e;margin-bottom:.75rem}.sp-stats h2{font-size:1.85rem;color:#fff;margin-bottom:2.5rem}.sp-stats__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.5rem}.sp-stat{padding:1.5rem 1.25rem;border:1px solid rgba(249, 221, 14,.25);border-radius:14px;background:rgba(255,255,255,.04)}.sp-stat__num{font-size:clamp(1.8rem,2.5vw,2.4rem);font-weight:800;color:#f9dd0e;line-height:1.05;display:block;margin-bottom:.4rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.sp-stat__label{font-size:1rem;color:rgba(226,232,240,.75);line-height:1.45}
@media(max-width:640px){.sp-stats h2{font-size:1.45rem}.sp-stat__num{font-size:2.2rem}}/* === QUOTE (Block 6) === */
.sp-quote{padding:4rem 1.5rem;background:#fffbf0}.sp-quote__inner{max-width:800px;margin:0 auto;text-align:center}.sp-quote__eyebrow{font-size:1rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#26275D;margin-bottom:1.5rem}.sp-quote__card{background:#fff;border-radius:20px;padding:2.5rem 2rem;box-shadow:0 4px 30px rgba(0,0,0,.08);position:relative}.sp-quote__card::before{content:'"';position:absolute;top:-1rem;left:1.5rem;font-size:5rem;color:#f9dd0e;font-family:Georgia,serif;line-height:1;opacity:.4}.sp-quote__text{font-size:1.15rem;color:#334155;line-height:1.8;font-style:italic;margin-bottom:1.5rem}.sp-quote__author{display:flex;align-items:center;justify-content:center;gap:1rem}.sp-quote__avatar{width:52px;height:52px;border-radius:50%;object-fit:cover;border:3px solid #f9dd0e}.sp-quote__name{font-weight:700;color:#26275D;font-size:1rem}.sp-quote__meta{font-size:1rem;color:#64748b}.sp-quote__stars{color:#b8920a;font-size:1.1rem;margin-bottom:.4rem}
@media(max-width:640px){.sp-quote__text{font-size:1rem}.sp-quote__card{padding:2rem 1.25rem}}/* === PRICING (Block 7) === */
.sp-pricing{padding:4rem 1.5rem;background:#f8fafc}.sp-pricing__inner{max-width:860px;margin:0 auto;text-align:center}.sp-pricing__eyebrow{font-size:1rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#26275D;margin-bottom:.75rem}.sp-pricing h2{font-size:1.85rem;color:#26275D;margin-bottom:.75rem}.sp-pricing__sub{color:#64748b;font-size:1rem;margin-bottom:2.5rem}.sp-pricing__table{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:2rem}.sp-pricing-col{border-radius:16px;padding:2rem 1.5rem;text-align:center}.sp-pricing-col--regular{background:#fff;border:1.5px solid #e2e8f0}.sp-pricing-col--promo{background:#26275D;color:#fff;border:none;position:relative;box-shadow:0 8px 30px rgba(38,39,93,.25)}.sp-pricing-col--promo::before{display:none}.sp-pricing-col__label{font-size:1rem;font-weight:600;opacity:.7;margin-bottom:.75rem}.sp-pricing-col__price{font-size:2.5rem;font-weight:800;line-height:1;margin-bottom:.5rem}.sp-pricing-col--regular .sp-pricing-col__price{color:#94a3b8;text-decoration:line-through}.sp-pricing-col--promo .sp-pricing-col__price{color:#f9dd0e}.sp-pricing-col__unit{font-size:1rem;opacity:.65;margin-bottom:1rem}.sp-pricing-col__features{list-style:none;padding:0;text-align:left;font-size:1rem;display:flex;flex-direction:column;gap:.6rem}.sp-pricing-col--regular .sp-pricing-col__features li{color:#475569 !important}.sp-pricing-col--regular .sp-pricing-col__features li::before{color:#26275D !important}.sp-pricing-col--promo .sp-pricing-col__features li{color:rgba(226,232,240,.85)}.sp-pricing-col__features li::before{content:'✓ ';font-weight:700;color:#f9dd0e}.sp-pricing__note{font-size:1rem;color:#64748b;margin-top:1rem}
@media(max-width:600px){.sp-pricing__table{grid-template-columns:1fr}.sp-pricing h2{font-size:1.45rem}}/* === CTA BLOCK (Block 8) === */
.sp-cta-block{padding:3.5rem 1.5rem;background:linear-gradient(135deg,#f9dd0e 0%,#f9dd0e 100%);text-align:center}.sp-cta-block__inner{max-width:680px;margin:0 auto}.sp-cta-block h2{font-size:1.75rem;font-weight:800;color:#26275D;margin-bottom:.75rem;line-height:1.2}.sp-cta-block p{font-size:1rem;color:rgba(38,39,93,.75);margin-bottom:2rem}.sp-cta-btn{display:inline-block;background:#26275D;color:#fff;font-size:1.1rem;font-weight:700;padding:1rem 2.5rem;border-radius:10px;text-decoration:none;box-shadow:0 6px 24px rgba(38,39,93,.35);transition:transform .2s,box-shadow .2s}.sp-cta-btn:hover{transform:translateY(-2px);box-shadow:0 10px 32px rgba(38,39,93,.45)}.sp-cta-block__note{margin-top:1rem;font-size:1rem;color:rgba(38,39,93,.6)}
@media(max-width:640px){.sp-cta-block h2{font-size:1.4rem}}/* === FORM BLOCKS (Block 9 & 11) === */
.sp-form-block{padding:4rem 1.5rem;text-align:center}.sp-form-block--alt{background:#f0f4fa}.sp-form-block__inner{max-width:580px;margin:0 auto;text-align:center}.sp-form-block__eyebrow{font-size:1rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#26275D;margin-bottom:.75rem}.sp-form-block h2{font-size:1.6rem;color:#26275D;margin-bottom:.75rem;line-height:1.25}.sp-form-block p{color:#64748b;font-size:1rem;margin-bottom:1.75rem}.sp-form-block__badges{display:flex;gap:.65rem;justify-content:center;flex-wrap:wrap;margin-top:1.25rem}.sp-form-badge{display:inline-flex;align-items:center;gap:.35rem;background:rgba(38,39,93,.06);border:1px solid rgba(38,39,93,.1);padding:.35rem .8rem;border-radius:50px;font-size:1rem;font-weight:600;color:#26275D}
@media(max-width:640px){.sp-form-block h2{font-size:1.3rem}}/* === FAQ (Block 10) === */
.sp-faq{padding:4rem 1.5rem;background:#fff}.sp-faq__inner{max-width:760px;margin:0 auto}.sp-faq__eyebrow{font-size:1rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#26275D;margin-bottom:.75rem;text-align:center}.sp-faq h2{font-size:1.75rem;color:#26275D;margin-bottom:.75rem;line-height:1.25;text-align:center}.sp-faq__sub{text-align:center;color:#64748b;font-size:1rem;margin-bottom:2rem}.sp-faq-item{border:1.5px solid #e2e8f0;border-radius:12px;overflow:hidden;margin-bottom:.75rem}.sp-faq-item summary{list-style:none;padding:1.1rem 1.25rem;font-weight:600;color:#26275D;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:.75rem;font-size:1rem;user-select:none}.sp-faq-item summary::-webkit-details-marker{display:none}.sp-faq-item summary::after{content:'+';font-size:1.4rem;font-weight:300;color:#64748b;flex-shrink:0;transition:transform .3s}.sp-faq-item[open] summary::after{content:'−';color:#26275D}.sp-faq-item[open] summary{color:#26275D;background:#fffbf0}.sp-faq-answer{padding:.25rem 1.25rem 1.1rem;color:#475569;font-size:1rem;line-height:1.75}
