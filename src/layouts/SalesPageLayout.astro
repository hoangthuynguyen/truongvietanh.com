.sp-hero{position:relative;color:#fff;padding:3.5rem 1.5rem 3rem;text-align:center;overflow:hidden;background-color:#26275D}.sp-hero__bg{position:absolute;inset:0;background-size:cover;background-position:center;background-repeat:no-repeat;z-index:0}.sp-hero__overlay{position:absolute;inset:0;background:linear-gradient(160deg,rgba(15,10,50,.88) 0%,rgba(38,39,93,.82) 50%,rgba(10,20,60,.88) 100%);z-index:1}.sp-hero__inner{position:relative;z-index:2;max-width:760px;margin:0 auto}.sp-hero__badge{display:inline-block;background:rgba(249, 221, 14,.18);border:1px solid rgba(249, 221, 14,.45);color:#f9dd0e;font-size:1rem;font-weight:700;padding:.35rem 1rem;border-radius:50px;margin-bottom:1.25rem;letter-spacing:.06em;text-transform:uppercase}/* === HERO VARIANT: white + 2-step form xanh === */
.sp-hero--white{background:linear-gradient(160deg,rgba(24,25,58,.65) 0%,rgba(38,39,93,.55) 50%,rgba(16,16,36,.70) 100%);color:#fff;padding:1.75rem 1.5rem 1.5rem;text-align:left;position:relative;overflow:hidden}
.sp-hero--white .sp-hero__bg{display:block !important}
.sp-hero--white .sp-hero__overlay{display:block !important;background:linear-gradient(160deg,rgba(24,25,58,.62) 0%,rgba(38,39,93,.50) 50%,rgba(16,16,36,.68) 100%)}
.sp-hero--white .sp-hero__inner{max-width:1100px;display:grid;grid-template-columns:1.05fr .95fr;gap:2rem;align-items:center}
.mn-hero__eyebrow{display:inline-block;background:#f9dd0e;border:none;color:#26275D;font-size:.82rem;font-weight:800;padding:.3rem 1rem;border-radius:50px;margin-bottom:1rem;letter-spacing:.06em;text-transform:uppercase}
.mn-hero h1{font-size:clamp(1.5rem,2.8vw,2.05rem);font-weight:900;color:#fff;margin:0 0 .75rem;line-height:1.2}
