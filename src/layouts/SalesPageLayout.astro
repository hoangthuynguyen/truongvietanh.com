.mn-hero__form .form-progress__step--active .form-progress__label,
.mn-hero__form .form-progress__step--done .form-progress__label{color:#fff !important}
.mn-hero__form .form-progress__step:not(.form-progress__step--active) .form-progress__dot{background:rgba(255,255,255,.18) !important;color:rgba(255,255,255,.6) !important;border-color:rgba(255,255,255,.25) !important}
.mn-hero__form .form-progress__line{background:rgba(255,255,255,.2) !important}
@media(max-width:900px){
