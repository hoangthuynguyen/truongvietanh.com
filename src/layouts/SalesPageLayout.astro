---
// src/layouts/SalesPageLayout.astro — 11-block sales page layout
import { getSiteSettings } from '../lib/directus';
const settings = await getSiteSettings();
const hotline = settings?.hotline || '0916 961 409';

type Props = {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  heroImage?: string;
  programCode?: string;
  schoolLevel?: string;
  noindex?: boolean;
  heroVariant?: 'classic' | 'white-form';
  logoSrc?: string;
  logoAlt?: string;
};

const {
  title,
  description,
  canonical,
  ogImage = 'https://truongvietanh.com/og-image.png',
  heroImage = 'https://media.truongvietanh.com/images/Block%20Hero%20_%20BG%20-%20website/banner-chinh.jpg',
  programCode = 'sales',
  schoolLevel = 'tieu-hoc',
  noindex = false,
  heroVariant = 'classic',
  logoSrc = '/logo-th-thcs-thpt-trans.png',
  logoAlt = 'Trường TH - THCS - THPT Việt Anh',
} = Astro.props;
const heroClass = heroVariant === 'white-form' ? 'sp-hero sp-hero--white' : 'sp-hero';

const robots = noindex ? 'noindex, nofollow' : 'index, follow';
const phoneClean = hotline.replace(/\s/g, '');
