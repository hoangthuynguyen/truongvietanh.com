.mn-hero__form .mn-hero__form-sub,.mn-hero__form p.mn-hero__form-sub{color:rgba(255,255,255,.78) !important;font-size:.95rem;margin:0 0 1rem;line-height:1.55}
.mn-hero__form .form-step-title{color:#fff !important}
.mn-hero__form .form-step-description{color:rgba(255,255,255,.75) !important}
.mn-hero__form .form-social-proof{color:rgba(255,255,255,.85) !important}
