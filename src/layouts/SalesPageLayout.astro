.sp-chat-footer{background:linear-gradient(135deg,#f9dd0e 0%,#f9dd0e 100%);padding:2.25rem 1.5rem}.sp-chat-footer__inner{max-width:1000px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:2rem;flex-wrap:wrap}.sp-chat-footer__text h3{font-family:"Montserrat",sans-serif;font-size:1.5rem;font-weight:700;color:#26275D;margin:0 0 .2rem}.sp-chat-footer__text p{font-size:1rem;color:rgba(38,39,93,.7);margin:0}.sp-chat-footer__btns{display:flex;gap:.65rem;flex-wrap:wrap}.sp-chat-btn{display:inline-flex;align-items:center;gap:.45rem;padding:.7rem 1.2rem;border-radius:8px;font-size:1rem;font-weight:700;text-decoration:none;transition:transform .15s,box-shadow .15s;white-space:nowrap}.sp-chat-btn:hover{transform:translateY(-1px);box-shadow:0 4px 14px rgba(0,0,0,.15)}.sp-chat-btn--zalo{background:#fff;color:#26275D}.sp-chat-btn--fb{background:#fff;color:#26275D}.sp-chat-btn--phone{background:#26275D;color:#fff}
@media(max-width:640px){.sp-chat-footer__inner{flex-direction:column;text-align:center}.sp-chat-footer__btns{justify-content:center}.sp-chat-btn{flex:1;min-width:140px;justify-content:center}}/* === MOBILE STICKY === */
.sp-mobile-cta{display:none;position:fixed;bottom:0;left:0;right:0;z-index:999;background:#26275D;padding:.75rem 1rem;text-align:center;box-shadow:0 -4px 20px rgba(38,39,93,.4)}.sp-mobile-cta a{display:inline-block;padding:.75rem 2rem;background:#f9dd0e;color:#26275D;font-weight:700;font-size:1rem;border-radius:8px;text-decoration:none}
@media(max-width:768px){.sp-mobile-cta{display:block}body{padding-bottom:72px}}/* === SECTION DIVIDER === */
.sp-divider{text-align:center;padding:0 1.5rem}.sp-divider__line{border:none;border-top:1.5px solid #e2e8f0;max-width:1100px;margin:0 auto}/* === VIDEO + FORM (optional, between Hero & Pain) === */
.sp-video{padding:3.5rem 1.5rem;background:linear-gradient(180deg,#101024 0%,#26275D 100%);color:#fff}.sp-video__inner{max-width:880px;margin:0 auto;display:grid;gap:2rem}.sp-video__head{text-align:center}.sp-video__eyebrow{display:inline-block;background:rgba(249,221,14,.18);border:1px solid rgba(249,221,14,.45);color:#f9dd0e;font-size:1rem;font-weight:700;padding:.3rem .9rem;border-radius:50px;margin-bottom:.75rem;letter-spacing:.06em;text-transform:uppercase}.sp-video__title{font-family:"Montserrat","Inter",sans-serif;font-size:1.55rem;color:#fff;line-height:1.3;margin:0 0 .5rem}.sp-video__sub{color:rgba(255,255,255,.78);font-size:1rem;line-height:1.7;margin:0}.sp-video__frame{position:relative;width:100%;padding-top:56.25%;border-radius:16px;overflow:hidden;box-shadow:0 18px 50px rgba(0,0,0,.45);background:#000}.sp-video__frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}.sp-video__form{background:#fff;color:#1a1a2e;border-radius:18px;padding:2rem 1.5rem;box-shadow:0 14px 40px rgba(0,0,0,.25);text-align:center}.sp-video__form-eyebrow{font-size:1rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#26275D;margin-bottom:.5rem}.sp-video__form h3{font-family:"Montserrat","Inter",sans-serif;font-size:1.35rem;color:#26275D;line-height:1.3;margin:0 0 .5rem}.sp-video__form p{color:#64748b;font-size:1rem;margin:0 0 1.25rem}.sp-video__chat{margin-top:1.25rem;padding-top:1.25rem;border-top:1px dashed #e2e8f0;display:flex;flex-direction:column;align-items:center;gap:.6rem}.sp-video__chat-or{font-size:.85rem;color:#64748b;font-weight:600;letter-spacing:.04em}.sp-video__chat-btn{display:inline-flex;align-items:center;gap:.5rem;background:#0068ff;color:#fff;font-weight:700;font-size:.95rem;padding:.7rem 1.4rem;border-radius:10px;text-decoration:none;box-shadow:0 4px 14px rgba(0,104,255,.3);transition:transform .15s,box-shadow .15s}.sp-video__chat-btn:hover{transform:translateY(-2px);box-shadow:0 8px 22px rgba(0,104,255,.42);color:#fff}
@media(max-width:640px){.sp-video{padding:2.75rem 1rem}.sp-video__title{font-size:1.25rem}.sp-video__form{padding:1.5rem 1rem}.sp-video__form h3{font-size:1.15rem}}
</style>
</head>
<body>
