.mn-hero__badges{display:flex;gap:.5rem;flex-wrap:wrap;margin:.7rem 0 .85rem}
.mn-hero__badges span{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);color:rgba(255,255,255,.9);font-size:.9rem;font-weight:600;padding:.35rem .9rem;border-radius:50px;backdrop-filter:blur(4px)}
.mn-hero__trust{display:flex;gap:1.5rem;flex-wrap:wrap;margin-top:.5rem;font-size:.92rem;color:rgba(255,255,255,.7)}
.mn-hero__trust b{color:#f9dd0e}
