<title>{title}</title>
<style is:inline>:root{--nav-primary:#1a1a5e;--nav-primary-light:#2a2a7e;--nav-primary-dark:#12123e;--nav-accent:#D4A843;--nav-accent-hover:#c09530;--nav-accent-light:rgba(212,168,67,.15);--text-dark:#1a1a1a;--text-light:#666;--bg-light:#f9f9f9;--bg-white:#fff;--border-color:#e0e0e0;--success-color:#27ae60}*{box-sizing:border-box;margin:0;padding:0}html{font-size:16px;scroll-behavior:smooth}body{font-family:"Open Sans",-apple-system,BlinkMacSystemFont,"Segoe UI","Roboto","Helvetica","Arial",sans-serif;line-height:1.6;color:var(--text-dark);background-color:var(--bg-white)}main{width:100%}/* ===== HEADER ===== */
.squeeze-header{position:sticky;top:0;z-index:1000;background-color:var(--nav-primary);color:#fff;padding:.6rem 1rem;box-shadow:0 2px 12px rgba(26,26,94,.25)}.squeeze-header__inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:.75rem}.squeeze-header__left{display:flex;align-items:center;justify-content:flex-start}.squeeze-header__right{display:flex;align-items:center;justify-content:flex-end}.squeeze-brand{display:flex;align-items:center;justify-content:center;text-decoration:none;color:#fff}.squeeze-brand__img{height:72px;width:auto;object-fit:contain;background:rgba(255,255,255,.97);padding:6px 14px;border-radius:10px;box-shadow:0 2px 10px rgba(0,0,0,.18);display:block}.squeeze-brand__text{display:none}.squeeze-header-btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;padding:.5rem 1rem;border-radius:6px;font-size:1rem;font-weight:600;text-decoration:none;border:none;cursor:pointer;transition:all .3s ease}.squeeze-header-btn--hotline{background-color:var(--nav-accent);color:#fff}.squeeze-header-btn--hotline:hover{background-color:var(--nav-accent-hover)}.squeeze-header-btn--zalo{background-color:transparent;color:#fff;border:1.5px solid rgba(255,255,255,.6)}.squeeze-header-btn--zalo:hover{background-color:rgba(255,255,255,.1);border-color:#fff}/* ===== TRUST BAR ===== */
.squeeze-trust-bar{background:linear-gradient(90deg,var(--nav-accent) 0%,#e8c36a 100%);color:var(--nav-primary-dark);padding:.5rem 1rem;text-align:center;font-size:1rem;font-weight:600;letter-spacing:.3px}.squeeze-trust-bar__inner{max-width:1200px;margin:0 auto;display:flex;align-items:center;justify-content:center;gap:1.5rem;flex-wrap:wrap}.squeeze-trust-bar__item{display:inline-flex;align-items:center;gap:.35rem;white-space:nowrap}/* ===== HERO — WHITE BG, NAVY TEXT ===== */
.squeeze-hero{background:#fff;color:var(--nav-primary);padding:2rem 1.5rem 2.5rem;text-align:center;position:relative;overflow:hidden;border-bottom:1px solid var(--border-color)}.squeeze-hero__content{max-width:860px;margin:0 auto;position:relative;z-index:1}.squeeze-hero__crest{width:auto;height:auto;max-width:380px;max-height:130px;margin:0 auto 1.25rem;display:block;object-fit:contain}
@media(max-width:560px){.squeeze-hero__crest{max-width:280px;max-height:100px}}.squeeze-hero h1,.squeeze-hero h2{color:var(--nav-primary) !important;text-align:center;font-weight:800;font-size:1.75rem;line-height:1.3;margin-bottom:.75rem}.squeeze-hero p,.squeeze-hero__sub{color:var(--text-dark);text-align:center;font-size:1.05rem;line-height:1.65;max-width:720px;margin:0 auto 1rem;font-weight:500}
@media(min-width:769px){.squeeze-hero h1,.squeeze-hero h2{font-size:2.15rem}}.squeeze-hero__badge{display:inline-block;background:var(--nav-primary);color:#fff;font-size:1rem;font-weight:700;padding:.45rem 1.25rem;border-radius:50px;margin-bottom:1rem;letter-spacing:.3px}/* ===== USP SECTION — tighter spacing ===== */
.squeeze-usp{background-color:#fff;padding:2rem 1rem}.squeeze-usp__inner{max-width:1100px;margin:0 auto}/* ===== TRUST METRICS SECTION — navy on white ===== */
.squeeze-trust{background:var(--nav-primary);color:#fff;padding:2rem 1rem;position:relative;overflow:hidden}.squeeze-trust__inner{max-width:1100px;margin:0 auto;position:relative;z-index:1}/* ===== CONTENT — tighter spacing ===== */
.squeeze-content{padding:2rem 1.5rem;max-width:1100px;margin:0 auto}/* ===== FORM SECTION ===== */
.squeeze-form-section{background:linear-gradient(180deg,#f0ebe4 0%,#faf7f3 50%,var(--bg-light) 100%);padding:3.5rem 1.5rem;text-align:center;position:relative}.squeeze-form-section::before{content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);width:80px;height:4px;background:linear-gradient(90deg,var(--nav-accent),#e8c36a);border-radius:2px}.squeeze-form-section__inner{max-width:600px;margin:0 auto}.squeeze-form-section__badges{display:flex;align-items:center;justify-content:center;gap:1rem;margin-top:1.5rem;flex-wrap:wrap}.squeeze-form-badge{display:inline-flex;align-items:center;gap:.4rem;background:rgba(26,26,94,.06);border:1px solid rgba(26,26,94,.1);padding:.4rem .85rem;border-radius:50px;font-size:1rem;font-weight:500;color:var(--nav-primary)}/* ===== URGENCY BAR ===== */
.squeeze-urgency{background:linear-gradient(90deg,#fff3dc 0%,#fff9ed 100%);border-top:2px solid var(--nav-accent);border-bottom:2px solid var(--nav-accent);padding:.85rem 1rem;text-align:center}.squeeze-urgency__inner{max-width:900px;margin:0 auto;display:flex;align-items:center;justify-content:center;gap:.75rem;flex-wrap:wrap}.squeeze-urgency__text{font-size:1rem;font-weight:600;color:var(--nav-primary)}.squeeze-urgency__timer{font-family:"Montserrat",sans-serif;font-weight:800;background:var(--nav-primary);color:var(--nav-accent);padding:2px 10px;border-radius:6px;letter-spacing:.5px;font-size:1rem}.squeeze-urgency__cta{display:inline-flex;align-items:center;gap:.4rem;padding:.45rem 1.1rem;border-radius:8px;background:var(--nav-primary);color:#fff;text-decoration:none;font-size:1rem;font-weight:700;transition:all .2s;white-space:nowrap}.squeeze-urgency__cta:hover{background:var(--nav-primary-light);transform:translateY(-1px)}.squeeze-urgency__pulse{display:inline-block;width:10px;height:10px;background:var(--nav-accent);border-radius:50%;animation:urgencyPulse 1.5s ease-in-out infinite;flex-shrink:0}
@keyframes urgencyPulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.3)}}/* ===== FAQ — wider ===== */
.squeeze-faq{padding:2rem 1.5rem;max-width:1100px;margin:0 auto}/* ===== MOBILE CTA ===== */
.squeeze-mobile-cta{display:none;position:fixed;bottom:0;left:0;right:0;z-index:999;background:linear-gradient(135deg,var(--nav-primary) 0%,var(--nav-primary-dark) 100%);color:#fff;padding:.85rem 1rem;text-align:center;box-shadow:0 -4px 20px rgba(26,26,94,.3)}.squeeze-mobile-cta__inner{display:flex;align-items:center;justify-content:center;gap:.75rem}.squeeze-mobile-cta__btn{display:inline-block;padding:.75rem 2rem;background:linear-gradient(135deg,var(--nav-accent),#e8c36a);color:var(--nav-primary-dark);text-decoration:none;border-radius:8px;font-weight:700;border:none;cursor:pointer;transition:all .3s ease;font-size:1rem;animation:ctaPulse 2s ease-in-out infinite;box-shadow:0 4px 15px rgba(212,168,67,.4)}
@keyframes ctaPulse{0%,100%{box-shadow:0 4px 15px rgba(212,168,67,.4)}50%{box-shadow:0 4px 25px rgba(212,168,67,.7),0 0 40px rgba(212,168,67,.2)}}.squeeze-mobile-cta__btn:hover{transform:translateY(-1px)}.squeeze-mobile-cta__zalo{display:inline-flex;align-items:center;gap:.3rem;padding:.6rem 1rem;background:#0068FF;color:#fff;text-decoration:none;border-radius:8px;font-weight:700;font-size:1rem;white-space:nowrap;transition:background .2s}.squeeze-mobile-cta__zalo:hover{background:#0056D6}/* ===== FOOTER ===== */
.squeeze-footer{background-color:#111;color:#fff;padding:2.5rem 1.5rem;font-size:1rem}.squeeze-footer__inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1.5rem}.squeeze-footer__contact{margin-bottom:1.5rem}.squeeze-footer__contact-title{font-size:1.5rem;font-weight:600;margin-bottom:.5rem;color:var(--nav-accent)}.squeeze-footer__contact-item{margin-bottom:.35rem;opacity:.9}.squeeze-footer__contact-item a{color:var(--nav-accent);text-decoration:none}.squeeze-footer__copyright{grid-column:1/-1;border-top:1px solid rgba(255,255,255,.1);padding-top:1.25rem;text-align:center;opacity:.6;font-size:1rem}

/* ===== RESPONSIVE ===== */
@media(max-width:768px){.squeeze-brand__img{height:56px;padding:4px 10px}.squeeze-hero{padding:2.5rem 1rem 2rem}.squeeze-content{padding:2rem 1rem}.squeeze-form-section{padding:2.5rem 1rem}.squeeze-faq{padding:2rem 1rem}.squeeze-mobile-cta{display:block}main{padding-bottom:80px}.squeeze-footer__inner{grid-template-columns:1fr}.squeeze-trust-bar__inner{gap:.75rem;font-size:1rem}}
@media(max-width:480px){.squeeze-header-btn{padding:.45rem .6rem;font-size:1rem}.squeeze-header-btn--hotline .ph-text{display:none}.squeeze-brand__img{height:48px;padding:3px 8px}.squeeze-hero{padding:2rem 1rem 1.5rem}.squeeze-trust-bar__item:nth-child(n+3){display:none}.squeeze-urgency__text{font-size:1rem}}
</style>
</head>
<body>
