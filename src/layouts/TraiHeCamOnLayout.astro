<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<meta name="robots" content="noindex, nofollow" />
<link rel="canonical" href={canonicalUrl} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800;900&family=Open+Sans:wght@400;500;600;700&display=swap&subset=vietnamese" rel="stylesheet" />
<style is:inline>
:root{
  --navy:#000080;--navy-dk:#00004d;--navy-soft:#f0f0ff;
  --gold:#907000;--gold-dk:#705400;--gold-soft:#FFFBEB;--gold-border:rgba(144,112,0,.4);
  --text:#1a1a2e;--text-muted:#5a5a70;--border:#e5e7eb;
  --green:#16a34a;
  --r:14px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Open Sans',system-ui,sans-serif;color:var(--text);background:#fff;
  line-height:1.65;font-size:16px;font-weight:400;-webkit-font-smoothing:antialiased;
  overflow-x:hidden;display:flex;flex-direction:column;min-height:100vh;padding-bottom:80px}
h1,h2,h3,h4{font-family:'Montserrat',sans-serif;line-height:1.25;font-weight:800}
h1{font-size:24px}h2{font-size:22px}h3{font-size:18px}
img{max-width:100%;height:auto;display:block}
a{text-decoration:none;color:inherit}
.wrap{max-width:900px;margin:0 auto;padding:0 24px;width:100%}

/* ─── CONFETTI ─── */
#confetti-canvas{position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9999}

/* ─── LOGO BAR — logo left + Zalo CTA right ─── */
.logo-bar{background:#fff;padding:8px 0;border-bottom:3px solid var(--gold);
  position:sticky;top:0;z-index:200;box-shadow:0 2px 8px rgba(0,0,0,.06)}
.logo-bar .lb-inner{max-width:900px;margin:0 auto;padding:0 24px;
  display:flex;align-items:center;justify-content:space-between;gap:16px}
.logo-bar img{display:block;height:88px;width:auto}
.lb-zalo{display:inline-flex;align-items:center;gap:8px;
  background:var(--navy);color:var(--gold);
  padding:12px 20px;border-radius:10px;font-weight:900;font-size:14px;
  font-family:'Montserrat',sans-serif;white-space:nowrap;text-decoration:none;
  box-shadow:0 4px 14px rgba(0,0,128,.25);transition:.15s}
.lb-zalo:hover{background:var(--navy-dk);transform:translateY(-1px)}

/* ─── PROGRESS ─── */
.progress{display:flex;align-items:center;justify-content:center;gap:0;
  padding:16px 20px 4px;max-width:480px;margin:0 auto}
.pstep{display:flex;align-items:center;gap:7px;font-size:14px;font-weight:700;
  color:var(--navy);font-family:'Montserrat',sans-serif}
.pstep--done{color:var(--navy)}
.pstep--active{color:var(--navy)}
.pstep--pending{color:#aaa}
.pdot{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;
  justify-content:center;font-size:1rem;font-weight:900;flex-shrink:0}
.pstep--done .pdot{background:var(--navy);color:var(--gold)}
.pstep--active .pdot{background:var(--gold);color:var(--navy-dk);animation:pulse 2s ease-in-out infinite}
.pstep--pending .pdot{background:#ddd;color:#aaa}
.pline{flex:1;height:2px;background:var(--navy);min-width:28px}
.pline--pending{background:#ddd}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(255,255,0,.45)}50%{box-shadow:0 0 0 8px rgba(255,255,0,0)}}

/* ─── MAIN ─── */
.main{flex:1;padding:20px 0 48px}

/* ─── HERO — white bg, emoji inline with title ─── */
.hero-section{text-align:center;padding:28px 0 24px;border-bottom:1px solid #f0f0f0;margin-bottom:28px}
.hero-section h1{font-size:26px;color:var(--navy);margin-bottom:14px;line-height:1.2}
.hero-section h1 .hi{font-size:1.3em;vertical-align:middle;margin-right:8px}
.hero-section h1 .hl{color:var(--navy)}
.hero-intro{font-size:16px;color:var(--text-muted);line-height:1.75;
  max-width:680px;margin:0 auto 20px}
.hero-intro strong{color:var(--navy)}
.meta-row{display:flex;flex-wrap:wrap;gap:10px;justify-content:center}
.meta-chip{display:inline-flex;align-items:center;gap:6px;background:#f0f2f8;
  color:var(--navy);padding:7px 14px;border-radius:20px;font-size:14px;font-weight:600}

/* ─── ZALO PRIMARY — white bg, full content width ─── */
.zalo-primary{background:#fff;padding:0;margin-bottom:28px}
.zalo-primary-header{text-align:center;margin-bottom:20px;padding:24px 0 0}
.zalo-primary-header .urgency{display:inline-block;background:var(--navy);color:var(--gold);
  font-size:13px;font-weight:900;font-family:'Montserrat',sans-serif;
  text-transform:uppercase;letter-spacing:.6px;
  padding:7px 18px;border-radius:20px;margin-bottom:14px}
.zalo-primary-header h2{font-size:22px;color:var(--navy);margin-bottom:10px;line-height:1.3}
.zalo-primary-header p{font-size:16px;color:var(--text-muted);line-height:1.7;max-width:620px;margin:0 auto}
.receive-list{list-style:none;padding:0;margin:0 0 24px;display:flex;flex-direction:column;gap:12px}
.receive-list li{display:flex;align-items:flex-start;gap:12px;font-size:16px;
  color:var(--text);line-height:1.6}
.receive-list li::before{content:'✅';font-size:14px;flex-shrink:0;margin-top:3px}
.receive-list strong{color:var(--navy)}

/* CTA — Zalo full width, Call below */
.btn-zalo-primary{display:flex;align-items:center;justify-content:center;gap:10px;
  width:100%;background:var(--navy);color:var(--gold);border:none;
  padding:18px 24px;border-radius:12px;font-size:16px;font-weight:900;
  font-family:'Montserrat',sans-serif;cursor:pointer;transition:.15s;
  text-decoration:none;box-shadow:0 6px 24px rgba(0,0,128,.25);
  white-space:nowrap;overflow:hidden;
  animation:cta-pulse 3s ease-in-out infinite;margin-bottom:12px}
@keyframes cta-pulse{0%,100%{box-shadow:0 6px 24px rgba(0,0,128,.25)}
  50%{box-shadow:0 6px 32px rgba(0,0,128,.45),0 0 0 6px rgba(255,255,0,.15)}}
.btn-zalo-primary:hover{background:var(--navy-dk);transform:translateY(-2px)}
.btn-zalo-primary:active{transform:translateY(0)}
.btn-call-primary{display:flex;align-items:center;justify-content:center;gap:10px;
  width:100%;background:#f0f2f8;color:var(--navy);border:none;
  padding:14px 24px;border-radius:12px;font-size:16px;font-weight:700;
  font-family:'Open Sans',system-ui,sans-serif;cursor:pointer;transition:.15s;
  text-decoration:none;white-space:nowrap;overflow:hidden}
.btn-call-primary:hover{background:#e4e8f5;transform:translateY(-1px)}
.btn-call-primary:active{transform:translateY(0)}
.zalo-subtext{text-align:center;font-size:14px;color:var(--text-muted);
  margin-top:12px;line-height:1.65}
.zalo-subtext span{color:var(--green);font-weight:700}

/* ─── MESSAGE TEMPLATE ─── */
.msg-template{background:#fff;padding:20px 0;margin-top:16px}
.msg-template .msg-title{font-size:13px;font-weight:700;color:var(--text-muted);
  text-transform:uppercase;letter-spacing:.6px;margin-bottom:12px}
.msg-box{background:#f8f9fc;border-radius:10px;
  padding:16px;font-size:15px;color:var(--text);line-height:1.75;
  white-space:pre-line;font-family:'Open Sans',system-ui,sans-serif}
.btn-copy{display:inline-flex;align-items:center;gap:6px;margin-top:10px;
  background:var(--navy);color:#fff;border:none;padding:9px 18px;
  border-radius:8px;font-size:14px;font-weight:700;cursor:pointer;
  font-family:'Open Sans',system-ui,sans-serif;transition:.15s}
.btn-copy:hover{background:var(--navy-dk)}
.btn-copy.copied{background:var(--green);color:#fff}

/* ─── DIVIDER ─── */
.divider{height:1px;background:#f0f0f0;margin:28px 0}

/* ─── NEXT STEPS ─── */
.steps-box{background:#fff;padding:0;margin-bottom:28px}
.steps-box .stitle{font-size:18px;font-weight:900;color:var(--navy);margin-bottom:16px;
  font-family:'Montserrat',sans-serif}
.sitem{display:flex;align-items:flex-start;gap:14px;padding:12px 0;
  border-bottom:1px solid #f0f0f0;font-size:16px;color:var(--text-muted);line-height:1.65;
  font-family:'Open Sans',system-ui,sans-serif}
.sitem:last-child{border-bottom:none}
.sitem.done{color:var(--navy)}
.sitem.active{color:var(--navy);font-weight:600}
.sdot2{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;
  justify-content:center;font-size:14px;font-weight:900;flex-shrink:0;margin-top:2px;
  font-family:'Montserrat',sans-serif}
.sitem.done .sdot2{background:var(--navy);color:var(--gold)}
.sitem.active .sdot2{background:var(--gold);color:var(--navy-dk);animation:pulse 2s infinite}
.sitem.pending .sdot2{background:#e8e8e8;color:#aaa}

/* ─── NOTE ─── */
.note-box{background:#fff;border-left:4px solid var(--navy);
  padding:16px 20px;font-size:15px;color:var(--text-muted);line-height:1.7;
  margin-bottom:28px;font-family:'Open Sans',system-ui,sans-serif}
.note-box strong{color:var(--navy)}

/* ─── FOOTER ─── */
.footer{background:var(--navy-dk);color:rgba(255,255,255,.55);text-align:center;
  padding:16px;font-size:13px;font-family:'Open Sans',system-ui,sans-serif}
.footer a{color:var(--gold)}

/* ─── STICKY BAR ─── */
.sticky-bar{position:fixed;bottom:0;left:0;right:0;background:#fff;
  border-top:3px solid var(--gold);z-index:300;padding:10px 16px;display:flex;gap:10px}
.sb-btn{flex:1;display:flex;align-items:center;justify-content:center;gap:8px;
  padding:14px 10px;border-radius:10px;font-weight:900;font-size:14px;
  font-family:'Montserrat',sans-serif;text-decoration:none;transition:.15s;
  white-space:nowrap;overflow:hidden}
.sb-zalo{background:var(--navy);color:var(--gold)}
.sb-call{background:#f0f2f8;color:var(--navy)}
.sb-btn:active{opacity:.8}

/* ─── RESPONSIVE ─── */
@media(max-width:640px){
  .main{padding:14px 0 32px}
  .hero-section{padding:20px 0 18px}
  .hero-section h1{font-size:22px}
  .zalo-primary-header h2{font-size:18px}
  .btn-zalo-primary{font-size:15px;padding:16px 16px}
  .btn-call-primary{font-size:15px;padding:13px 16px}
  .lb-zalo{font-size:13px;padding:10px 14px}
  .logo-bar img{height:64px}
  .wrap{padding:0 16px}
  .logo-bar .lb-inner{padding:0 16px}
}
</style>
<script is:inline define:vars={{ schoolLevel, funnelCode }}>
window.dataLayer = window.dataLayer || [];
window.dataLayer.push({
  event: 'generate_lead',
  page_title: document.title,
  school_level: schoolLevel,
  funnel_code: funnelCode
});
</script>
</head>
<body>
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TMPPWX29" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KPL2NSR9" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->

<canvas id="confetti-canvas"></canvas>

<!-- LOGO BAR — logo left, Zalo CTA right -->
<div class="logo-bar">
  <div class="lb-inner">
    <a href="https://truongvietanh.com" aria-label="Trường Việt Anh">
      <img src="/logo-vietanh.webp" alt="Trường Việt Anh" height="88" width="264" />
    </a>
    <a href={ZALO_URL} target="_blank" rel="noopener" class="lb-zalo">
      💬 Tư vấn Zalo
    </a>
  </div>
</div>

<!-- PROGRESS STEPS -->
<div class="progress">
  <div class="pstep pstep--done">
    <div class="pdot">✓</div>
    <span>Đăng ký</span>
  </div>
  <div class="pline"></div>
  <div class="pstep pstep--active">
    <div class="pdot">2</div>
    <span>Tư vấn</span>
  </div>
  <div class="pline pline--pending"></div>
  <div class="pstep pstep--pending">
    <div class="pdot">3</div>
    <span>Tham gia</span>
  </div>
</div>

<!-- MAIN -->
<main class="main">
  <div class="wrap">

    <!-- HERO -->
    <div class="hero-section">
      <h1><span class="hi">{heroIcon}</span> {heroTitle} <span class="hl">{heroHighlight}</span></h1>
      <p class="hero-intro" set:html={resolvedHeroIntro} />
      <div class="meta-row">
        {resolvedMetaChips.map(chip => (
          <span class="meta-chip">{chip}</span>
        ))}
      </div>
    </div>

    <!-- ZALO PRIMARY CTA -->
    <div class="zalo-primary">
      <div class="zalo-primary-header">
        <div class="urgency">⚡ Bước tiếp theo — Quan trọng</div>
        <h2>{zaloTitle}</h2>
        {zaloIntro && <p set:html={zaloIntro} />}
        {!zaloIntro && <p>Ba mẹ nhắn Zalo để nhận đầy đủ thông tin chương trình và học bổng từ tư vấn viên ngay hôm nay.</p>}
      </div>

      <ul class="receive-list">
