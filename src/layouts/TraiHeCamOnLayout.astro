<style is:inline>
:root{
  --navy:#000080;--navy-dk:#00004d;--navy-soft:#f0f0ff;
  --gold:#ffff00;--gold-dk:#e6e600;--gold-soft:#fffde6;--gold-border:rgba(255,255,0,.4);
  --text:#1a1a2e;--text-muted:#5a5a70;--border:#e5e7eb;
  --green:#16a34a;
  --r:14px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Open Sans',system-ui,sans-serif;color:var(--text);background:#f7f8fc;
  line-height:1.65;font-size:16px;-webkit-font-smoothing:antialiased;overflow-x:hidden;
  display:flex;flex-direction:column;min-height:100vh;padding-bottom:72px}
h1,h2,h3,h4{font-family:'Montserrat',sans-serif;line-height:1.2;font-weight:800}
img{max-width:100%;height:auto;display:block}
a{text-decoration:none;color:inherit}
.wrap{max-width:720px;margin:0 auto;padding:0 20px;width:100%}

/* ─── CONFETTI ─── */
#confetti-canvas{position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9999}

/* ─── LOGO BAR ─── */
.logo-bar{background:var(--navy);padding:14px 0;text-align:center;border-bottom:3px solid var(--gold)}
.logo-bar img{display:inline-block;height:44px;width:auto}

/* ─── PROGRESS ─── */
.progress{display:flex;align-items:center;justify-content:center;gap:0;
  padding:16px 20px 4px;max-width:420px;margin:0 auto}
.pstep{display:flex;align-items:center;gap:7px;font-size:13.5px;font-weight:700;
  color:var(--navy);font-family:'Montserrat',sans-serif}
.pstep--done{color:var(--navy)}
.pstep--active{color:var(--navy)}
.pstep--pending{color:#aaa}
.pdot{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;
  justify-content:center;font-size:1rem;font-weight:900;flex-shrink:0}
.pstep--done .pdot{background:var(--navy);color:var(--gold)}
.pstep--active .pdot{background:var(--gold);color:var(--navy-dk);animation:pulse 2s ease-in-out infinite}
.pstep--pending .pdot{background:#ddd;color:#aaa}
.pline{flex:1;height:2px;background:var(--navy);min-width:28px}
.pline--pending{background:#ddd}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(255,255,0,.45)}50%{box-shadow:0 0 0 8px rgba(255,255,0,0)}}

/* ─── MAIN ─── */
.main{flex:1;padding:20px 0 40px}

/* ─── HERO CARD ─── */
.hero-card{background:linear-gradient(135deg,var(--navy) 0%,var(--navy-dk) 100%);
  color:#fff;border-radius:var(--r);padding:28px 28px 24px;text-align:center;
  margin-bottom:16px;position:relative;overflow:hidden}
.hero-card::before{content:'';position:absolute;top:-60px;right:-60px;width:200px;height:200px;
  background:radial-gradient(circle,rgba(255,255,0,.18) 0%,transparent 70%);pointer-events:none}
.hero-card::after{content:'';position:absolute;bottom:-80px;left:-60px;width:240px;height:240px;
  background:radial-gradient(circle,rgba(255,255,0,.1) 0%,transparent 70%);pointer-events:none}
.hero-icon{font-size:3rem;margin-bottom:10px;position:relative;z-index:1}
.hero-card h1{font-size:clamp(1.3rem,3vw,1.7rem);color:#fff;margin-bottom:10px;
  position:relative;z-index:1}
.hero-card h1 .hl{color:var(--gold)}
.hero-intro{font-size:15px;color:rgba(255,255,255,.88);line-height:1.7;
  max-width:540px;margin:0 auto 16px;position:relative;z-index:1}
.meta-row{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;position:relative;z-index:1}
.meta-chip{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.12);
  border:1px solid rgba(255,255,255,.2);color:#fff;padding:6px 12px;border-radius:20px;
  font-size:13px;font-weight:600}

/* ─── ZALO PRIMARY BOX ─── */
.zalo-primary{background:#fff;border:3px solid var(--gold);border-radius:var(--r);
  padding:24px;margin-bottom:16px;box-shadow:0 6px 32px rgba(255,255,0,.2)}
.zalo-primary-header{text-align:center;margin-bottom:16px}
.zalo-primary-header .urgency{display:inline-block;background:var(--gold);color:var(--navy-dk);
  font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.6px;
  padding:5px 14px;border-radius:20px;margin-bottom:10px}
.zalo-primary-header h2{font-size:1.1rem;color:var(--navy);margin-bottom:6px;line-height:1.35}
.zalo-primary-header p{font-size:14px;color:var(--text-muted);line-height:1.6}
.receive-list{list-style:none;padding:0;margin:0 0 20px;display:flex;flex-direction:column;gap:9px}
.receive-list li{display:flex;align-items:flex-start;gap:10px;font-size:14.5px;
  color:var(--text);line-height:1.5}
.receive-list li::before{content:'✅';font-size:13px;flex-shrink:0;margin-top:2px}
.receive-list strong{color:var(--navy)}
.btn-zalo-primary{display:flex;align-items:center;justify-content:center;gap:10px;
  width:100%;background:var(--navy);color:var(--gold);border:none;
  padding:18px 20px;border-radius:12px;font-size:16px;font-weight:900;
  font-family:'Montserrat',sans-serif;cursor:pointer;transition:.15s;
  text-decoration:none;box-shadow:0 6px 24px rgba(0,0,128,.3);
  letter-spacing:.3px;animation:cta-pulse 3s ease-in-out infinite}
@keyframes cta-pulse{0%,100%{box-shadow:0 6px 24px rgba(0,0,128,.3)}
  50%{box-shadow:0 6px 32px rgba(0,0,128,.5),0 0 0 6px rgba(255,255,0,.15)}}
.btn-zalo-primary:hover{background:var(--navy-dk);transform:translateY(-2px);
  box-shadow:0 8px 32px rgba(0,0,128,.4)}
.btn-zalo-primary:active{transform:translateY(0)}
.zalo-subtext{text-align:center;font-size:13px;color:var(--text-muted);
  margin-top:10px;line-height:1.6}
.zalo-subtext span{color:var(--green);font-weight:700}

/* ─── MESSAGE TEMPLATE ─── */
.msg-template{background:#f8f9ff;border:1px solid #d0d5ff;border-radius:10px;
  padding:16px;margin-top:16px}
.msg-template .msg-title{font-size:12px;font-weight:700;color:var(--text-muted);
  text-transform:uppercase;letter-spacing:.6px;margin-bottom:10px}
.msg-box{background:#fff;border:1px solid var(--border);border-radius:8px;
  padding:12px;font-size:13.5px;color:var(--text);line-height:1.7;
  white-space:pre-line;font-family:inherit}
.btn-copy{display:inline-flex;align-items:center;gap:6px;margin-top:10px;
  background:var(--navy);color:#fff;border:none;padding:9px 16px;
  border-radius:8px;font-size:13px;font-weight:700;cursor:pointer;
  font-family:inherit;transition:.15s}
.btn-copy:hover{background:var(--navy-dk)}
.btn-copy.copied{background:var(--green);color:#fff}

/* ─── NEXT STEPS ─── */
.steps-box{background:#fff;border:1px solid var(--border);border-radius:var(--r);
  padding:20px 22px;margin-bottom:16px}
.steps-box .stitle{font-size:1rem;font-weight:900;color:var(--navy);margin-bottom:14px}
.sitem{display:flex;align-items:flex-start;gap:12px;padding:10px 0;
  border-bottom:1px solid #f0f0f0;font-size:14px;color:var(--text-muted);line-height:1.6}
.sitem:last-child{border-bottom:none}
.sitem.done{color:var(--navy)}
.sitem.active{color:var(--navy);font-weight:600}
.sdot2{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;
  justify-content:center;font-size:13px;font-weight:900;flex-shrink:0;margin-top:1px}
.sitem.done .sdot2{background:var(--navy);color:var(--gold)}
.sitem.active .sdot2{background:var(--gold);color:var(--navy-dk);animation:pulse 2s infinite}
.sitem.pending .sdot2{background:#e0e0e0;color:#aaa}

/* ─── PHONE BOX ─── */
.phone-box{background:#fff;border:1px solid var(--border);border-radius:var(--r);
  padding:20px 22px;text-align:center;margin-bottom:16px}
.phone-box p{font-size:14.5px;color:var(--text-muted);margin-bottom:12px;line-height:1.6}
.btn-call{display:inline-flex;align-items:center;justify-content:center;gap:8px;
  background:var(--gold);color:var(--navy-dk);padding:14px 28px;border-radius:10px;
  font-size:15px;font-weight:900;font-family:'Montserrat',sans-serif;
  transition:.15s;border:none;cursor:pointer;text-decoration:none;
  box-shadow:0 4px 14px rgba(255,255,0,.3)}
.btn-call:hover{background:var(--gold-dk);transform:translateY(-2px)}

/* ─── NOTE ─── */
.note-box{background:var(--navy-soft);border:1px solid #c7c7ff;border-radius:10px;
  padding:14px 16px;font-size:13.5px;color:var(--text-muted);line-height:1.6;
  margin-bottom:16px}
.note-box strong{color:var(--navy)}

/* ─── FOOTER ─── */
.footer{background:var(--navy-dk);color:rgba(255,255,255,.55);text-align:center;
  padding:16px;font-size:12px}
.footer a{color:var(--gold)}

/* ─── STICKY BAR ─── */
.sticky-bar{position:fixed;bottom:0;left:0;right:0;background:#fff;
  border-top:2px solid var(--gold);z-index:300;padding:10px 16px;display:flex;gap:10px}
.sb-btn{flex:1;display:flex;align-items:center;justify-content:center;gap:7px;
  padding:12px 10px;border-radius:9px;font-weight:900;font-size:13.5px;
  font-family:'Montserrat',sans-serif;text-decoration:none;transition:.15s}
.sb-zalo{background:var(--navy);color:var(--gold)}
.sb-call{background:var(--gold);color:var(--navy-dk)}
.sb-btn:active{opacity:.8}

/* ─── RESPONSIVE ─── */
@media(max-width:560px){
  .main{padding:14px 0 32px}
  .hero-card{padding:22px 18px 18px;border-radius:10px}
  .zalo-primary{padding:18px 16px;border-radius:10px}
  .btn-zalo-primary{font-size:15px;padding:16px 16px}
  .steps-box,.phone-box{padding:16px 16px}
}
</style>
<script is:inline define:vars={{ schoolLevel, funnelCode }}>
window.dataLayer = window.dataLayer || [];
window.dataLayer.push({
  event: 'generate_lead',
  page_title: document.title,
  school_level: schoolLevel,
  funnel_code: funnelCode
});
</script>
</head>
<body>
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TMPPWX29" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KPL2NSR9" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->

<canvas id="confetti-canvas"></canvas>

<!-- LOGO BAR -->
<div class="logo-bar">
  <a href="https://truongvietanh.com" aria-label="Trường Việt Anh">
    <img src="/logo-vietanh-yellow.png" alt="Trường Việt Anh" height="44" />
  </a>
</div>

<!-- PROGRESS STEPS -->
<div class="progress">
  <div class="pstep pstep--done">
    <div class="pdot">✓</div>
    <span>Đăng ký</span>
  </div>
  <div class="pline"></div>
  <div class="pstep pstep--active">
    <div class="pdot">2</div>
    <span>Tư vấn</span>
  </div>
  <div class="pline pline--pending"></div>
  <div class="pstep pstep--pending">
    <div class="pdot">3</div>
    <span>Tham gia</span>
  </div>
</div>

<!-- MAIN -->
<main class="main">
  <div class="wrap">

    <!-- HERO CARD -->
    <div class="hero-card">
      <div class="hero-icon">{heroIcon}</div>
      <h1>{heroTitle} <span class="hl">{heroHighlight}</span></h1>
      <p class="hero-intro" set:html={resolvedHeroIntro} />
      <div class="meta-row">
        {resolvedMetaChips.map(chip => (
          <span class="meta-chip">{chip}</span>
        ))}
      </div>
    </div>

    <!-- ZALO PRIMARY CTA -->
    <div class="zalo-primary">
      <div class="zalo-primary-header">
        <div class="urgency">⚡ Bước tiếp theo — Quan trọng</div>
        <h2>{zaloTitle}</h2>
        {zaloIntro && <p set:html={zaloIntro} />}
        {!zaloIntro && <p>Ba mẹ nhắn Zalo để nhận đầy đủ thông tin chương trình và học bổng từ tư vấn viên ngay hôm nay.</p>}
      </div>

      <ul class="receive-list">
        {resolvedReceive.map(item => (
          <li><span set:html={item} /></li>
        ))}
      </ul>

      <a href={ZALO_URL} target="_blank" rel="noopener" class="btn-zalo-primary">
        💬 {zaloBtnText}
      </a>
      <p class="zalo-subtext">
        <span>✅ Phản hồi 15–30 phút</span> · Hoàn toàn miễn phí · Không ràng buộc
      </p>

      <!-- Copyable Zalo message -->
      <div class="msg-template">
        <div class="msg-title">📋 Mẫu tin nhắn — Ba mẹ copy và gửi Zalo:</div>
        <div class="msg-box" id="msgTemplate">{resolvedZaloMsg}</div>
        <button class="btn-copy" onclick="copyMsg()" id="btnCopy">📋 Copy tin nhắn</button>
      </div>
    </div>

    <!-- NEXT STEPS -->
    <div class="steps-box">
      <div class="stitle">{nextStepsTitle}</div>
      {resolvedNextSteps.map((step, i) => (
        <div class={`sitem ${step.state ?? 'pending'}`}>
          <div class="sdot2">
            {step.state === 'done' ? '✓' : (i + 1)}
          </div>
          <span set:html={step.label} />
        </div>
      ))}
    </div>

    <!-- PHONE BOX -->
    <div class="phone-box">
      <p>Muốn được tư vấn nhanh hơn? Ba mẹ có thể gọi trực tiếp để được hỗ trợ ngay về lịch học, học phí và lớp phù hợp cho con.</p>
      <a href={`tel:${HOTLINE_TEL}`} class="btn-call">
        📞 GỌI TƯ VẤN NGAY — {HOTLINE}
      </a>
    </div>

    <!-- NOTE -->
    <div class="note-box" set:html={resolvedNoteText} />

    <!-- FOOTER NOTE -->
    <p style="text-align:center;font-size:13px;color:var(--text-muted);line-height:1.6" set:html={resolvedFooterNote} />

  </div>
</main>

