---
/**
 * TraiHeCamOnLayout — Reusable Thank-You Page Layout for Trại Hè campaigns
 * ──────────────────────────────────────────────────────────────────────────
 * Optimized for post-form-submit conversion: primary CTA = Tư vấn Zalo.
 * Features:
 *  - Confetti animation on load
 *  - Progress steps (Đăng ký ✓ → Tư vấn → Tham gia)
 *  - Large Zalo CTA (primary) + Call CTA (secondary)
 *  - Copyable Zalo message template
 *  - What they'll receive list
 *  - Next steps checklist
 *  - GTM generate_lead event + GTM-TMPPWX29 & GTM-KPL2NSR9
 *  - Sticky mobile bar (Zalo + Call)
 *
 * Usage: create a page, import this layout, pass props.
 *
 * To create a new thank-you page:
 *   1. Copy src/pages/tuyen-sinh/trai-he-tieu-hoc-go-vap-cam-on/index.astro
 *   2. Change props to match the new campaign
 *   3. Done.
 */

interface Props {
  /* ── SEO ── */
  title?: string;
  description?: string;
  canonicalUrl: string;

  /* ── Campaign info ── */
  location: string;          // "Gò Vấp"
  levelLabel?: string;       // "Tiểu Học" | "THCS" | "THPT"
  schoolLevel?: string;      // 'tieu-hoc' | 'thcs' | 'thpt'
  khaigiang?: string;        // "15/06/2026"
  duration?: string;         // "6 tuần"
  ageRange?: string;         // "6–10 tuổi"
  address?: string;
  funnelCode?: string;

  /* ── Hero card ── */
  heroIcon?: string;         // "🎉"
  heroTitle?: string;        // "Cảm ơn ba mẹ! Đăng ký thành công"
  heroHighlight?: string;    // text to highlight in gold
  heroIntro?: string;        // paragraph below title
  metaChips?: string[];      // ["📅 Khai giảng 15/06/2026", ...]

  /* ── Zalo section ── */
  zaloTitle?: string;        // "💬 Nhắn Zalo để nhận ngay bộ thông tin trại hè"
  zaloIntro?: string;        // Short paragraph before receive list
  receiveItems?: string[];   // What they receive via Zalo
  zaloBtnText?: string;      // "NHẮN ZALO TƯ VẤN NGAY"
  zaloSubtext?: string;      // "Tư vấn viên phản hồi trong vòng 15–30 phút"
  zaloMessage?: string;      // Template message to copy

  /* ── Next steps ── */
  nextStepsTitle?: string;
  nextSteps?: { label: string; state?: 'done' | 'active' | 'pending' }[];

  /* ── Note box ── */
  noteText?: string;

  /* ── Footer note ── */
  footerNote?: string;
}

const {
  title,
  description,
  canonicalUrl,
  location,
  levelLabel = 'Tiểu Học',
  schoolLevel = 'tieu-hoc',
  khaigiang = '15/06/2026',
  duration = '6 tuần',
  ageRange = '6–10 tuổi',
  address = '160/72 Phan Huy Ích, P.15, Q.Gò Vấp, TPHCM',
  funnelCode = '',
  heroIcon = '🎉',
  heroTitle = `Cảm ơn ba mẹ!`,
  heroHighlight = 'Đăng ký thành công',
  heroIntro,
  metaChips,
  zaloTitle = '💬 Nhắn Zalo để nhận thông tin chi tiết chương trình',
  zaloIntro,
  receiveItems,
  zaloBtnText = 'TƯ VẤN ZALO VỚI TƯ VẤN VIÊN NGAY',
  zaloSubtext = 'Tư vấn viên phản hồi trong vòng 15–30 phút · Hoàn toàn miễn phí',
  zaloMessage,
  nextStepsTitle = '🗺️ Các bước tiếp theo',
  nextSteps,
  noteText,
  footerNote,
} = Astro.props;

const HOTLINE     = '0916 961 409';
const HOTLINE_TEL = '+84916961409';
const ZALO_URL    = 'https://zalo.me/1678310120468101523';

const pageTitle       = title       ?? `Đăng Ký Thành Công — Trại Hè ${levelLabel} ${location} ${new Date().getFullYear()} | Trường Việt Anh`;
const pageDescription = description ?? `Cảm ơn ba mẹ đã đăng ký. Nhắn Zalo để nhận lịch học ${duration}, học phí, học bổng và tư vấn lớp phù hợp cho con.`;

const defaultHeroIntro = `Thông tin đăng ký <strong style="color:var(--gold)">Trại hè ${levelLabel} Việt Anh ${location}</strong> đã được ghi nhận. Để nhận nhanh nhất lịch học ${duration}, học phí, <strong style="color:var(--gold)">học bổng</strong> và tư vấn lớp phù hợp cho con — ba mẹ nhắn Zalo ngay cho đội ngũ tư vấn.`;

const defaultMetaChips = [
  `📅 Khai giảng ${khaigiang}`,
  `👦 Bé ${ageRange}`,
  `🏫 Việt Anh ${location}`,
  `⏱️ ${duration}`,
];

const defaultReceiveItems = [
  `File <strong>lịch học chi tiết ${duration}</strong> của Trại hè ${levelLabel} ${location}`,
  `Thông tin <strong>học bổng và ưu đãi early bird</strong> đang áp dụng`,
  `Gợi ý <strong>nhóm lớp phù hợp</strong> theo tuổi / lớp hiện tại của con`,
  `Hướng dẫn <strong>đăng ký giữ chỗ</strong> trước ngày khai giảng ${khaigiang}`,
];

const defaultZaloMessage = `Tôi vừa đăng ký tư vấn Trại hè ${levelLabel} Việt Anh ${location}.\nCon tôi hiện đang học lớp __ / tuổi __.\nNhờ tư vấn giúp lịch học ${duration}, học phí, học bổng và lớp phù hợp cho con ạ.`;

const defaultNextSteps = [
  { label: 'Hoàn thành đăng ký nhận tư vấn', state: 'done' as const },
  { label: `<strong>Nhắn Zalo</strong> để nhận lịch ${duration}, học phí, học bổng và tư vấn lớp phù hợp cho con (5 phút)`, state: 'active' as const },
  { label: 'Trao đổi với tư vấn viên, giữ chỗ nếu gia đình thấy phù hợp', state: 'pending' as const },
  { label: `Tham gia Trại hè ${levelLabel} ${location} — Khai giảng ${khaigiang} 🏕️`, state: 'pending' as const },
];

const resolvedHeroIntro   = heroIntro     ?? defaultHeroIntro;
const resolvedMetaChips   = metaChips     ?? defaultMetaChips;
const resolvedReceive     = receiveItems  ?? defaultReceiveItems;
const resolvedZaloMsg     = zaloMessage   ?? defaultZaloMessage;
const resolvedNextSteps   = nextSteps     ?? defaultNextSteps;
const resolvedNoteText    = noteText      ?? `💡 <strong>Lưu ý:</strong> Các nhóm lớp trại hè được sắp xếp theo độ tuổi để con học vui hơn, hòa nhập tốt hơn. Ba mẹ nên trao đổi sớm với tư vấn viên để con được gợi ý nhóm lớp phù hợp <strong>trước ngày khai giảng ${khaigiang}</strong>.`;
const resolvedFooterNote  = footerNote    ?? `Cảm ơn ba mẹ đã quan tâm <strong>Trại hè ${levelLabel} Việt Anh ${location}</strong>.<br/>Chúc con có một mùa hè vui hơn, tự tin hơn và sẵn sàng cho năm học mới 🌟`;
---
<!doctype html>
<html lang="vi">
