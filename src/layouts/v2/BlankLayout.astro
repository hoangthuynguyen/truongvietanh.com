---
/**
 * BlankLayout — no chrome at all.
 * Used for: thank-you auto-redirect pages, print views, email previews, embed widgets.
 */
import '../../styles/global.css';
import '../../styles/v2.css';
import { getSiteSettings } from '../../lib/cms';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  funnelCode?: string;
}

const { title, description = '', noindex = true, funnelCode } = Astro.props;
const settings = await getSiteSettings();
---
<!DOCTYPE html>
<html lang="vi">
<head>
<!-- Google Tag Manager -->
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-TMPPWX29');</script>
<!-- End Google Tag Manager -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  {funnelCode && <meta name="x-funnel-code" content={funnelCode} />}

  {settings.gtm_id && (
    <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${settings.gtm_id}');`} />
  )}
</head>
<body data-layout="blank">
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TMPPWX29"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
  <slot />
</body>
</html>
