            <span class="diff__so">{d.soCau} câu</span>
            <p>{d.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CÂU HỎI: 3 MỞ + 9 KHOÁ ═══ -->
  <section class="sec" id="cau-hoi">
    <div class="wrap">
      <span class="sec__eyebrow">Xem trước</span>
      <h2 class="sec__title">Ba câu trong bảng, và lý do vì sao nên hỏi</h2>
