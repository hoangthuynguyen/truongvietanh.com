</header>

<main>
  <!-- ═══ HERO ═══ -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div>
        <span class="badge">🎁 Bảng in miễn phí · dùng được ở mọi trường</span>
        <h1>Buổi họp 60 phút, 45 gia đình.<br />Con mình được <span class="hl">80 giây</span>.</h1>
        <p class="hero__sub">
          Tám mươi giây đó chỉ dùng được nếu ba mẹ <strong>biết trước sẽ hỏi gì</strong>.
          Bảng in 4 trang: 12 câu nên hỏi cô, chỗ ghi câu trả lời, và cách đọc một câu trả lời né tránh.
        </p>

        <div class="hero__pills">
          <span class="pill"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> 12 câu, chia 3 nhóm</span>
          <span class="pill"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> Chỗ ghi câu trả lời của cô</span>
          <span class="pill"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> In ra, gấp đôi, bỏ túi</span>
        </div>

        <button type="button" class="btn btn--gold" data-open-form>
          <span class="btn__label">Nhận bảng in miễn phí</span>
          <svg class="btn__arrow" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>

        <div class="hero__micro">
          <span>📄 4 trang A4</span>
          <span>⏱️ Điền 20 giây</span>
          <span>🔒 Không spam</span>
        </div>
      </div>

      <div class="mockup">
        <span class="mockup__ribbon">MIỄN PHÍ</span>
        <div class="mockup__frame">
          <picture>
            <source srcset="/mockup-12-cau-hoi-hop-phu-huynh.webp" type="image/webp" />
            <img
              src="/mockup-12-cau-hoi-hop-phu-huynh.jpg"
              width="900" height="1273"
              alt="Trang 1 bảng in 12 câu nên hỏi trong buổi họp phụ huynh — nhóm A về lớp học, có dòng ghi câu trả lời của cô"
              fetchpriority="high" decoding="async"
            />
          </picture>
