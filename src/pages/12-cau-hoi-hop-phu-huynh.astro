<!-- ═══ THANH CTA MOBILE ═══ -->
<div class="mbar">
  <button type="button" class="btn btn--gold btn--block" data-open-form>
    <span class="btn__label">Nhận bảng in miễn phí</span>
  </button>
</div>

<!-- ═══ MODAL FORM 2 BƯỚC ═══ -->
<div class="ov" id="ov" role="dialog" aria-modal="true" aria-labelledby="mTitle" hidden>
  <div class="modal">
    <button type="button" class="modal__x" id="mClose" aria-label="Đóng">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>

    <div class="modal__head">
      <h2 id="mTitle">Nhận bảng in 12 câu hỏi</h2>
      <p>Bản PDF 4 trang gửi vào email ba mẹ — tải được ngay sau khi điền.</p>
    </div>

    <div class="modal__body">
      <div class="prog" id="prog">
        <div class="prog__track"><div class="prog__fill" id="pFill"></div></div>
        <span class="prog__txt" id="pTxt">Bước 1 / 2</span>
      </div>

      <!-- BƯỚC 1 — chỉ email -->
      <div class="step on" id="s1">
        <div class="fld">
          <label for="fEmail">Email của ba mẹ</label>
          <input type="email" id="fEmail" name="email" placeholder="vidu@gmail.com"
                 autocomplete="email" inputmode="email" required />
          <span class="err-msg" id="eEmail" role="alert">Ba mẹ kiểm tra lại email giúp em nhé.</span>
        </div>
        <button type="button" class="btn btn--navy btn--block" id="btnNext">
          <span class="btn__label">Tiếp tục</span>
          <svg class="btn__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>
        <p class="form-note">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          Chỉ dùng để gửi tài liệu và nội dung hữu ích cho ba mẹ. Không chia sẻ cho bên thứ ba.
        </p>
      </div>

      <!-- BƯỚC 2 — tên + SĐT (+ lớp, không bắt buộc) -->
      <div class="step" id="s2">
        <div class="fld">
          <label for="fName">Ba mẹ tên gì ạ?</label>
          <input type="text" id="fName" name="parent_name" placeholder="Nguyễn Thị Lan" autocomplete="name" required />
          <span class="err-msg" id="eName" role="alert">Ba mẹ điền giúp em tên nhé.</span>
        </div>
        <div class="fld">
          <label for="fPhone">Số điện thoại</label>
          <input type="tel" id="fPhone" name="phone" placeholder="0912 345 678" autocomplete="tel" inputmode="numeric" required />
          <span class="err-msg" id="ePhone" role="alert">Số điện thoại chưa đúng, ba mẹ xem lại giúp em.</span>
        </div>
        <div class="fld">
          <label for="fGrade">Con đang học lớp <span class="opt">(không bắt buộc)</span></label>
          <select id="fGrade" name="school_level">
            <option value="">— Chọn lớp của con —</option>
            <option value="mam-non">Mầm non</option>
            <option value="lop-1">Lớp 1</option>
            <option value="lop-2">Lớp 2</option>
            <option value="lop-3">Lớp 3</option>
            <option value="lop-4">Lớp 4</option>
            <option value="lop-5">Lớp 5</option>
            <option value="lop-6">Lớp 6</option>
            <option value="lop-7">Lớp 7</option>
            <option value="lop-8">Lớp 8</option>
            <option value="lop-9">Lớp 9</option>
            <option value="lop-10">Lớp 10</option>
            <option value="lop-11">Lớp 11</option>
            <option value="lop-12">Lớp 12</option>
          </select>
        </div>
        <button type="button" class="btn btn--gold btn--block" id="btnSubmit">
          <span class="btn__label">Gửi bảng in cho tôi</span>
        </button>
        <button type="button" class="back" id="btnBack">← Quay lại</button>
      </div>

      <!-- THÀNH CÔNG -->
      <div class="step" id="sSuc">
        <div class="succ">
          <div class="succ__ic">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          </div>
          <h3>Xong rồi ạ!</h3>
          <p>Bảng in đang được gửi vào email của ba mẹ. Em chuyển ba mẹ sang trang tải file ngay đây…</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ FUNNEL, PDF_URL, CAM_ON }}>
(function () {
  'use strict';

  var API = '/api/lead';
  var FORM_ID = '12-cau-hoi-hop-phu-huynh-form';

  var ov = document.getElementById('ov');
  var s1 = document.getElementById('s1');
  var s2 = document.getElementById('s2');
  var sSuc = document.getElementById('sSuc');
  var prog = document.getElementById('prog');
  var pFill = document.getElementById('pFill');
  var pTxt = document.getElementById('pTxt');
  var btnNext = document.getElementById('btnNext');
  var btnBack = document.getElementById('btnBack');
  var btnSubmit = document.getElementById('btnSubmit');
  var email = '';
  var lastFocus = null;

  function noop() {}

  // Bộ thu UTM dùng chung (/js/va-utm.js). Gọi lại mỗi lần gửi để luôn lấy bản mới nhất.
  function utm() { return window.__vaUTM ? window.__vaUTM() : {}; }

  function gtm(evt, extra) {
    try {
      var p = { event: evt, form_id: FORM_ID, funnel_code: FUNNEL };
      if (extra) for (var k in extra) p[k] = extra[k];
      var u = utm();
      for (var j in u) p[j] = u[j];
      (window.dataLayer = window.dataLayer || []).push(p);
    } catch (e) {}
  }

  /* ---------- Mở / đóng modal ---------- */
  function openForm() {
    lastFocus = document.activeElement;
    ov.hidden = false;
    // ép trình duyệt vẽ frame đầu để transition chạy
    void ov.offsetWidth;
    ov.classList.add('open');
    document.body.style.overflow = 'hidden';
    gtm('popup_open');
    setTimeout(function () {
      var f = s1.classList.contains('on') ? document.getElementById('fEmail')
                                          : document.getElementById('fName');
      if (f) f.focus();
    }, 300);
  }

  function closeForm() {
    ov.classList.remove('open');
    document.body.style.overflow = '';
    setTimeout(function () { ov.hidden = true; }, 240);
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }

  Array.prototype.forEach.call(document.querySelectorAll('[data-open-form]'), function (b) {
    b.addEventListener('click', openForm);
  });
  document.getElementById('mClose').addEventListener('click', closeForm);
  ov.addEventListener('click', function (e) { if (e.target === ov) closeForm(); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && ov.classList.contains('open')) closeForm();
  });

  /* ---------- Điều hướng bước ---------- */
  function show(step) {
    [s1, s2, sSuc].forEach(function (el) { el.classList.remove('on'); });
    step.classList.add('on');
  }
  function setProgress(n) {
    if (n === 1) { pFill.style.width = '50%'; pTxt.textContent = 'Bước 1 / 2'; }
    else { pFill.style.width = '100%'; pTxt.textContent = 'Bước 2 / 2'; }
  }

  /* ---------- Kiểm tra dữ liệu ---------- */
  function okEmail(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v); }
  function okPhone(v) {
    v = String(v).replace(/[\s\-.()]/g, '').replace(/^\+?84/, '0');
    return /^0[35789][0-9]{8}$/.test(v);
  }
  function mark(inputId, errId, bad) {
    var i = document.getElementById(inputId), e = document.getElementById(errId);
    if (i) i.classList.toggle('err', bad);
    if (e) e.classList.toggle('on', bad);
  }
  ['fEmail', 'fName', 'fPhone'].forEach(function (id) {
    var el = document.getElementById(id);
    if (el) el.addEventListener('input', function () {
      mark(id, 'e' + id.slice(1), false);
    });
  });

  /* ---------- BƯỚC 1 → gửi partial_capture ---------- */
  btnNext.addEventListener('click', function () {
    var v = (document.getElementById('fEmail').value || '').trim();
    if (!okEmail(v)) { mark('fEmail', 'eEmail', true); document.getElementById('fEmail').focus(); return; }
    mark('fEmail', 'eEmail', false);
    email = v;

    // Bắt email sớm: worker nhận diện bằng đúng khoá step='partial_capture'
    try {
      var body1 = {
        step: 'partial_capture',
        email: email,
        form_id: FORM_ID,
        funnel_code: FUNNEL,
        source: FUNNEL
      };
      Object.assign(body1, utm());
      fetch(API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body1),
        keepalive: true
      }).catch(noop);
    } catch (e) {}

    gtm('lead_step1');
    show(s2);
    setProgress(2);
    setTimeout(function () { document.getElementById('fName').focus(); }, 90);
  });

  btnBack.addEventListener('click', function () { show(s1); setProgress(1); });

  /* ---------- BƯỚC 2 → gửi lead đầy đủ ---------- */
  btnSubmit.addEventListener('click', function () {
    var name = (document.getElementById('fName').value || '').trim();
    var phone = (document.getElementById('fPhone').value || '').trim();
    var grade = document.getElementById('fGrade').value || '';
    var ok = true;

    if (!name) { mark('fName', 'eName', true); ok = false; } else mark('fName', 'eName', false);
    if (!okPhone(phone)) { mark('fPhone', 'ePhone', true); ok = false; } else mark('fPhone', 'ePhone', false);
    if (!ok) return;

    btnSubmit.classList.add('loading');

    var body = {
      email: email,
      parent_name: name,
      phone: phone,
      form_id: FORM_ID,
      funnel_code: FUNNEL,
      source: FUNNEL
    };
    if (grade) body.school_level = grade;
    Object.assign(body, utm());

    fetch(API, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    })
      .catch(noop)
      .finally(function () {
        gtm('generate_lead', grade ? { school_level: grade } : null);
        btnSubmit.classList.remove('loading');
        prog.style.display = 'none';
        show(sSuc);
        setTimeout(function () {
          window.location.href = CAM_ON + '?name=' + encodeURIComponent(name);
        }, 1600);
      });
  });

  /* ---------- Enter để đi tiếp ---------- */
  document.getElementById('fEmail').addEventListener('keydown', function (e) {
    if (e.key === 'Enter') { e.preventDefault(); btnNext.click(); }
  });
  ['fName', 'fPhone'].forEach(function (id) {
    document.getElementById(id).addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { e.preventDefault(); btnSubmit.click(); }
    });
  });

  /* ---------- Thanh CTA mobile: chỉ hiện khi nút hero đã trôi khỏi màn ---------- */
  var mbar = document.querySelector('.mbar');
  var heroBtn = document.querySelector('.hero .btn--gold');
  if (mbar && heroBtn && 'IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      mbar.classList.toggle('show', !entries[0].isIntersecting);
    }, { threshold: 0 }).observe(heroBtn);
  } else if (mbar) {
    mbar.classList.add('show');   // trình duyệt cũ: cứ hiện, còn hơn không có CTA
  }

  /* ---------- Nạp sẵn file PDF khi khách kéo tới giữa trang ---------- */
  var warmed = false;
  window.addEventListener('scroll', function () {
    if (warmed || window.scrollY < 600) return;
    warmed = true;
    var l = document.createElement('link');
    l.rel = 'prefetch'; l.href = PDF_URL; l.as = 'document';
    document.head.appendChild(l);
  }, { passive: true });
})();
</script>

<script src="/js/phone-vn.js" defer></script>
