---
// Trang cảm ơn của squeeze /12-cau-hoi-hop-phu-huynh.
// Kích cỡ file lấy từ file thật lúc build (statSync), đừng gõ tay.
// Tự bấm nút tải sau 1,2s (chỉ 1 lần/phiên) rồi vẫn để nút to cho ba mẹ bấm lại.
import { statSync } from 'node:fs';

const FUNNEL = 'squeeze-12-cau-hoi-hop-phu-huynh';
const PDF_FILE = '12-cau-nen-hoi-trong-buoi-hop-phu-huynh.pdf';
const PDF_URL = '/downloads/' + PDF_FILE;

let pdfKb = 0;
try {
  pdfKb = Math.round(statSync(new URL('../../../public/downloads/' + PDF_FILE, import.meta.url)).size / 1024);
} catch {
  pdfKb = 0;
}
const pdfMeta = 'PDF · 4 trang A4' + (pdfKb ? ` · ${pdfKb} KB` : '') + ' · in ra, gấp đôi, bỏ túi';

const title = 'Đã xong — Nhận bảng in 12 câu nên hỏi | Trường Việt Anh';
const description = 'Cảm ơn ba mẹ. Bản PDF "12 câu nên hỏi trong buổi họp phụ huynh" đã sẵn sàng để tải, và đang được gửi vào email của ba mẹ.';
const canonicalUrl = 'https://truongvietanh.com/12-cau-hoi-hop-phu-huynh/cam-on';

// Zalo OA của trường — cùng OA mà bản PDF in mã QR ở trang 4
const ZALO_OA = 'https://zalo.me/1678310120468101523';
const zaloDeepLink =
  ZALO_OA + '?text=' +
  encodeURIComponent('Chào thầy/cô, em vừa tải "12 câu nên hỏi trong buổi họp phụ huynh" và muốn hỏi thêm ạ.');
---

<!doctype html>
<html lang="vi">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="noindex, nofollow" />
<link rel="canonical" href={canonicalUrl} />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800;900&family=Inter:wght@400;500;600;700&display=swap&subset=vietnamese" rel="stylesheet" />

<style is:inline>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --navy:#26275D;--navy-dk:#1B1C45;--gold:#F9DD0E;--ink:#1E2140;
  --muted:#5C6180;--line:#E3E8F2;--soft:#F5F8FD;--cream:#FFF8DE;--green:#16A34A;
}
body{
  font-family:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif;
  color:var(--ink);background:var(--soft);font-size:16px;line-height:1.65;
  -webkit-font-smoothing:antialiased;min-height:100vh;
}
h1,h2,h3{font-family:'Montserrat',sans-serif;color:var(--navy);line-height:1.3}
img{max-width:100%;height:auto;display:block}
.wrap{max-width:760px;margin:0 auto;padding:0 20px}

.logo{text-align:center;padding:26px 20px 6px}
.logo img{display:inline-block;height:32px;width:auto}

.steps{display:flex;align-items:center;justify-content:center;gap:0;max-width:460px;margin:14px auto 0;padding:0 16px}
.st{display:flex;align-items:center;gap:7px;font-size:13px;font-weight:600;color:var(--navy);white-space:nowrap}
.st--pend{color:#A6ADC4}
.st__d{width:26px;height:26px;border-radius:50%;display:grid;place-items:center;font-size:13px;font-weight:800;color:#fff;flex:none}
.st--done .st__d{background:var(--navy)}
.st--act .st__d{background:var(--gold);color:var(--navy-dk);animation:pulse 2s ease-in-out infinite}
.st--pend .st__d{background:#CDD4E4}
.st__l{flex:1;height:2px;background:var(--navy);min-width:20px;margin:0 8px}
.st__l--pend{background:#DDE3EF}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(249,221,14,.45)}50%{box-shadow:0 0 0 8px rgba(249,221,14,0)}}

.card{
  background:#fff;border:1px solid var(--line);border-radius:22px;
  box-shadow:0 8px 34px rgba(38,39,93,.09);
  padding:34px 34px 30px;margin:22px 0 40px;text-align:center;
}
.tick{
  width:70px;height:70px;border-radius:50%;margin:0 auto 16px;
  background:rgba(22,163,74,.12);color:var(--green);display:grid;place-items:center;
}
h1{font-size:clamp(21px,3.4vw,28px);font-weight:900;margin-bottom:12px}
h1 .nm{color:#B99B00}
.lead{color:var(--muted);max-width:540px;margin:0 auto 26px;font-size:16px}

.dl{
  display:grid;grid-template-columns:auto minmax(0,1fr);gap:18px;align-items:center;
  text-align:left;background:linear-gradient(180deg,#FFFDF3 0%,#fff 100%);
  border:1.5px solid rgba(249,221,14,.75);border-radius:18px;padding:18px;margin-bottom:14px;
}
.dl__thumb{width:92px;border-radius:9px;overflow:hidden;box-shadow:0 4px 16px rgba(38,39,93,.16);flex:none}
.dl__meta{font-size:13px;color:var(--muted);margin-top:5px}
.dl h2{font-size:16.5px;font-weight:800;line-height:1.4}

.btn{
  display:flex;align-items:center;justify-content:center;gap:10px;
  font-family:'Montserrat',sans-serif;font-weight:800;font-size:16.5px;
  padding:16px 24px;border-radius:14px;border:0;cursor:pointer;
  text-decoration:none;line-height:1.35;width:100%;
  transition:transform .18s ease,box-shadow .18s ease,background .18s ease;
}
.btn--gold{background:var(--gold);color:var(--navy-dk);box-shadow:0 8px 24px rgba(249,221,14,.4)}
.btn--gold:hover{background:#FFE838;transform:translateY(-2px)}
.btn--ghost{background:#fff;color:var(--navy);border:2px solid var(--navy);font-size:15.5px;padding:13px 20px}
.btn--ghost:hover{background:var(--navy);color:#fff}
.stack{display:flex;flex-direction:column;gap:10px;max-width:520px;margin:0 auto}
.stack--row{flex-direction:row}
.stack--row .btn{flex:1}

.next{
  text-align:left;background:var(--soft);border:1px solid var(--line);
  border-radius:16px;padding:20px 22px;margin:26px 0 6px;
}
.next h3{font-size:15.5px;font-weight:800;margin-bottom:13px}
.next__i{display:flex;align-items:flex-start;gap:11px;padding:8px 0;font-size:14.7px;color:var(--muted);line-height:1.6}
.next__i + .next__i{border-top:1px solid #EAEFF8}
.next__d{
  width:24px;height:24px;min-width:24px;border-radius:50%;background:#D6DCEA;color:#fff;
  display:grid;place-items:center;font-size:12.5px;font-weight:800;margin-top:2px;
}
.next__i--done{color:var(--navy)}
.next__i--done .next__d{background:var(--navy)}
.next__i--act{color:var(--navy);font-weight:600}
.next__i--act .next__d{background:var(--gold);color:var(--navy-dk);animation:pulse 2s infinite}

.oa{
  display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:14px;align-items:center;
  text-align:left;background:#fff;border:1px solid var(--line);border-radius:16px;
  padding:16px 18px;margin-top:16px;
}
.oa__ic{width:44px;height:44px;border-radius:12px;background:#E9F1FB;display:grid;place-items:center;font-size:22px;flex:none}
.oa h3{font-size:15px;font-weight:800;margin-bottom:3px}
.oa p{font-size:13.5px;color:var(--muted);line-height:1.5}
.oa a{
  display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;
  font-family:'Montserrat',sans-serif;font-weight:800;font-size:14px;
  background:var(--navy);color:#fff;text-decoration:none;padding:11px 16px;border-radius:12px;
  min-height:44px;
}
.oa a:hover{background:var(--navy-dk)}

.tip{
  display:flex;gap:11px;text-align:left;background:var(--cream);
  border:1px solid rgba(249,221,14,.6);border-radius:14px;
  padding:15px 18px;margin-top:18px;font-size:14.5px;color:#5E4A00;line-height:1.6;
  overflow-wrap:anywhere;
}
.tip strong{color:var(--navy)}

.foot-trust{display:flex;flex-wrap:wrap;justify-content:center;gap:10px 22px;margin-top:24px;padding-top:20px;border-top:1px solid var(--line)}
.foot-trust span{font-size:13.5px;color:var(--muted);font-weight:500}
.foot-note{text-align:center;font-size:13px;color:#8A90AB;padding-bottom:34px}
.foot-note a{color:var(--navy);font-weight:600}

@media(max-width:600px){
  .card{padding:24px 18px;border-radius:18px;margin:16px 0 26px}
  .dl{grid-template-columns:1fr;gap:14px;text-align:center}
  .dl__thumb{width:78px;margin:0 auto}
  .stack--row{flex-direction:column}
  .st span:not(.st__d){display:none}
  .st__l{min-width:28px}
  .oa{grid-template-columns:auto minmax(0,1fr)}
  .oa a{grid-column:1 / -1;width:100%}
}
@media (prefers-reduced-motion:reduce){*{animation-duration:.01ms !important;transition-duration:.01ms !important}}
</style>

<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-KPL2NSR9');</script>
<script is:inline define:vars={{ FUNNEL }}>
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({ event: 'generate_lead', funnel_code: FUNNEL });
</script>
</head>

<body>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KPL2NSR9" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<div class="logo">
  <img src="/logo-vietanh.webp" alt="Trường Việt Anh" width="65" height="32" />
</div>

<div class="steps">
  <div class="st st--done"><span class="st__d">✓</span><span>Đăng ký</span></div>
  <div class="st__l"></div>
  <div class="st st--act"><span class="st__d">2</span><span>Tải bảng in</span></div>
  <div class="st__l st__l--pend"></div>
  <div class="st st--pend"><span class="st__d">3</span><span>Đi họp</span></div>
</div>

<div class="wrap">
  <div class="card">
    <div class="tick">
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
    </div>
    <h1>Cảm ơn ba mẹ<span class="nm" id="nm"></span>! Bảng in đã sẵn sàng.</h1>
    <p class="lead">
      Bản PDF đang được gửi vào email của ba mẹ. Nếu không muốn chờ, bấm nút bên dưới để tải ngay.
    </p>

    <div class="dl">
      <div class="dl__thumb">
        <picture>
          <source srcset="/mockup-12-cau-hoi-hop-phu-huynh.webp" type="image/webp" />
          <img src="/mockup-12-cau-hoi-hop-phu-huynh.jpg" width="900" height="1273"
               alt="12 câu nên hỏi trong buổi họp phụ huynh — bản PDF" />
        </picture>
      </div>
      <div>
        <h2>12 câu nên hỏi trong buổi họp phụ huynh</h2>
        <p class="dl__meta">{pdfMeta}</p>
      </div>
    </div>

    <div class="stack">
      <a href={PDF_URL} class="btn btn--gold" id="dlBtn" download={PDF_FILE}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>
        Tải bản PDF ngay
      </a>
      <div class="stack stack--row">
        <a href={zaloDeepLink} target="_blank" rel="noopener" class="btn btn--ghost">💬 Nhắn Zalo cho trường</a>
        <a href="tel:+84916961409" class="btn btn--ghost">📞 0916 961 409</a>
      </div>
    </div>

    <div class="next">
      <h3>Ba bước tiếp theo</h3>
      <div class="next__i next__i--done"><span class="next__d">✓</span><span>Đăng ký xong</span></div>
      <div class="next__i next__i--act"><span class="next__d">2</span><span><strong>In ra, gấp đôi, bỏ túi.</strong> Ở trang 1 có ô “Ba câu tôi sẽ hỏi hôm nay” — khoanh ba câu trước khi ra khỏi nhà. Ba câu là đủ.</span></div>
      <div class="next__i"><span class="next__d">3</span><span><strong>Mang theo một cây bút.</strong> Mỗi câu có dòng “Cô trả lời:” để ghi tại chỗ — và ở lại năm phút sau khi họp xong, năm phút đó giá trị hơn cả tiếng vừa rồi.</span></div>
    </div>

    <div class="oa">
      <span class="oa__ic">📬</span>
      <div>
        <h3>Mỗi tuần một công cụ nhỏ như tài liệu này</h3>
        <p>Theo dõi Zalo OA của Trường Việt Anh — mỗi tuần một công cụ dùng được ngay cho cha mẹ, không quảng cáo, không tuyển sinh.</p>
      </div>
      <a href={ZALO_OA} target="_blank" rel="noopener">Theo dõi Zalo OA</a>
    </div>

    <div class="tip">
      <span style="font-size:18px;line-height:1.2">📧</span>
      <span>
        Email chưa thấy? Ba mẹ kiểm tra hộp <strong>Spam</strong> hoặc <strong>Quảng cáo / Promotions</strong>,
        tìm thư từ <strong>Nguyễn Mạnh Dương &lt;duong@reply.truongvietanh.com&gt;</strong> rồi bấm
        <strong>“Không phải spam”</strong> để nhận được các thư sau.
      </span>
    </div>

    <div class="foot-trust">
      <span>🔒 Thông tin được bảo mật</span>
      <span>🏫 Dùng được ở mọi trường</span>
      <span>💬 Tư vấn miễn phí</span>
    </div>
  </div>

  <p class="foot-note">
    © 2026 Trường TH – THCS – THPT Việt Anh ·
    <a href="https://truongvietanh.com" target="_blank" rel="noopener">truongvietanh.com</a>
  </p>
</div>

<script is:inline>
(function () {
  var p = new URLSearchParams(window.location.search);
  var n = p.get('name');
  if (n) {
    var last = decodeURIComponent(n).trim().split(/\s+/).pop();
    if (last) document.getElementById('nm').textContent = ' ' + last;
  }

  // Tự tải 1 lần mỗi phiên — ba mẹ quay lại trang không bị tải chồng file.
  var b = document.getElementById('dlBtn');
  try {
    if (b && !sessionStorage.getItem('va12ch_dl')) {
      setTimeout(function () {
        try { sessionStorage.setItem('va12ch_dl', '1'); } catch (e) {}
        b.click();
      }, 1200);
    }
  } catch (e) {}
})();
</script>
</body>
</html>
