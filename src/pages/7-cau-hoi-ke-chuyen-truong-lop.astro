<main>
  <!-- ═══ HERO ═══ -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div>
        <span class="badge">🎁 Tài liệu miễn phí dành cho ba mẹ</span>
        <h1>7 câu hỏi khiến con <span class="hl">kể chuyện</span> trường lớp</h1>
