---
/**
 * Trại Hè Thank-You Page — CMS-driven template
 *
 * Standalone HTML (no shared layout) for fast, noindex thank-you pages.
 * All text and lists come from the same Directus record as the squeeze page.
 * {name} in thank_you_headline is replaced client-side from ?name= query.
 */
import { getAllTraiHeSlugs, getTraiHePageBySlug } from '../../../lib/trai-he-pages';

export async function getStaticPaths() {
  const slugs = await getAllTraiHeSlugs();
  return slugs
    .filter((s) => s && s.startsWith('trai-he-'))
    .map((slug) => ({ params: { trai_he_slug: slug } }));
}

const { trai_he_slug } = Astro.params;
const page = await getTraiHePageBySlug(trai_he_slug!);

if (!page) {
  return Astro.redirect('/404');
}

const canonicalUrl = `https://truongvietanh.com/${page.slug}/cam-on`;

// Split headline around {name} so we can render server HTML statically and
// let a small inline script insert the submitted name on the client.
const headlineParts = page.thank_you_headline.split('{name}');
const headlineBefore = headlineParts[0] ?? page.thank_you_headline;
const headlineAfter = headlineParts.length > 1 ? headlineParts.slice(1).join('{name}') : '';
---

<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{page.thank_you_title}</title>
  <meta name="description" content={page.thank_you_description} />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="canonical" href={canonicalUrl} />
  <style is:inline>
    :root{--b:#1F4E79;--o:#E8792B;--w:#fff;--g6:#666;--f:'Open Sans',system-ui,-apple-system,sans-serif}
    *{margin:0;padding:0;box-sizing:border-box}
    body{font-family:var(--f);-webkit-font-smoothing:antialiased;font-size:16px;color:#1C2A3A;background:linear-gradient(165deg,#FFF7ED 0%,#FED7AA 40%,#FDBA74 100%);min-height:100vh;display:flex;flex-direction:column}
    .logo-bar{text-align:center;padding:24px 16px 0}
    .main{flex:1;display:flex;align-items:center;justify-content:center;padding:24px 16px 40px}
    .card{background:var(--w);border-radius:24px;box-shadow:0 12px 40px rgba(0,0,0,.1);max-width:580px;width:100%;padding:36px 28px;text-align:center}
    .icon{width:72px;height:72px;border-radius:50%;background:#FFF7ED;display:flex;align-items:center;justify-content:center;font-size:36px;margin:0 auto 18px}
    h1{font-family:'Montserrat',sans-serif;font-size:1.4rem;font-weight:800;color:var(--o);margin-bottom:10px;line-height:1.35}
    h1 .name{color:var(--b)}
    .msg{font-size:1rem;color:#333;line-height:1.7;margin-bottom:20px;text-align:left}
    .msg strong{color:#1C2A3A}
    .report-list{background:#F9FAFB;border:1px solid #E5E7EB;border-radius:12px;padding:16px 20px;margin-bottom:20px;text-align:left}
    .report-list .title{font-weight:700;color:var(--b);margin-bottom:8px;font-size:.95rem}
    .report-list ul{list-style:none;padding:0;margin:0}
    .report-list li{padding:6px 0 6px 22px;position:relative;font-size:.92rem;color:#374151}
    .report-list li::before{content:'✓';position:absolute;left:0;color:#16A34A;font-weight:700}
    .bonus-box{background:#FFF7ED;border:2px solid var(--o);border-radius:14px;padding:18px 20px;margin-bottom:18px;text-align:left}
    .bonus-box .title{font-weight:800;color:var(--o);margin-bottom:10px;font-size:1rem;font-family:'Montserrat',sans-serif}
    .bonus-box ul{list-style:none;padding:0;margin:0}
    .bonus-box li{padding:5px 0 5px 22px;position:relative;font-size:.92rem;color:#7C2D12;line-height:1.5}
    .bonus-box li::before{content:'•';position:absolute;left:6px;color:var(--o);font-weight:700;font-size:1.2rem}
    .choices-title{font-weight:700;color:var(--b);margin-bottom:10px;font-family:Montserrat,sans-serif}
    .choices{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:20px}
    .choice{padding:14px 12px;border-radius:12px;text-align:left;font-size:.85rem;line-height:1.5}
    .choice-bad{background:#FEF2F2;border:1.5px solid #FCA5A5}
    .choice-bad .label{color:#991B1B;font-weight:700;font-size:.9rem;margin-bottom:6px}
    .choice-good{background:#F0FDF4;border:1.5px solid #86EFAC}
    .choice-good .label{color:#166534;font-weight:700;font-size:.9rem;margin-bottom:6px}
    .countdown-box{display:inline-flex;align-items:center;gap:8px;background:#FEE2E2;color:#991B1B;padding:10px 18px;border-radius:14px;font-size:.9rem;font-weight:600;margin-bottom:18px}
    .countdown-box .time{font-weight:800;font-family:'Montserrat',sans-serif;letter-spacing:.5px}
    .secondary-countdown{font-size:.82rem;color:#666;margin-bottom:20px}
    .cta-stack{display:flex;flex-direction:column;gap:10px;margin-bottom:18px}
    .cta-btn{display:block;padding:15px 20px;border-radius:14px;text-decoration:none;font-weight:700;font-size:1rem;text-align:center;transition:all .2s;font-family:'Montserrat',sans-serif}
    .cta-primary{background:var(--o);color:var(--w);box-shadow:0 4px 14px rgba(232,121,43,.35)}
    .cta-primary:hover{background:#D96A1F;transform:translateY(-2px)}
    .cta-zalo{background:#0068FF;color:var(--w)}
    .cta-zalo:hover{background:#0056D6}
    .contact-info{display:flex;gap:10px;justify-content:center;margin-bottom:14px}
    .contact-btn{padding:10px 16px;border-radius:10px;text-decoration:none;font-size:.85rem;font-weight:600;background:#1F4E79;color:var(--w)}
    .footer-note{font-size:.75rem;color:#999;margin-top:14px}
    @media(max-width:480px){.card{padding:28px 20px}h1{font-size:1.2rem}.choices{grid-template-columns:1fr}}
  </style>
  <script is:inline define:vars={{ pageTitle: page.thank_you_title, schoolLevel: page.school_level, funnelCode: page.funnel_code }}>
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: 'generate_lead',
      page_title: pageTitle,
      school_level: schoolLevel,
      funnel_code: funnelCode,
    });
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <style is:inline>@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=Open+Sans:wght@400;600&display=swap&subset=vietnamese');</style>
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-KPL2NSR9');</script>
</head>
<body>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KPL2NSR9" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <div class="logo-bar"><img src="/logo-vietanh.webp" alt="Trường Việt Anh" style="height:56px;width:auto" /></div>
  <div class="main">
    <div class="card">
      <div class="icon">{page.thank_you_icon}</div>
      <h1>{headlineBefore}<span class="name" id="parentName"></span>{headlineAfter}</h1>
      <p class="msg" set:html={page.thank_you_intro} />

      <div class="report-list">
        <div class="title">{page.thank_you_report_title}</div>
        <ul>
          {page.thank_you_report_items.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="bonus-box">
        <div class="title">{page.thank_you_bonus_title}</div>
        <ul>
          {page.thank_you_bonus_items.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      {page.thank_you_show_two_choices && (
        <>
          {page.thank_you_two_choices_title && (
            <div class="choices-title">{page.thank_you_two_choices_title}</div>
          )}
          <div class="choices">
            <div class="choice choice-bad">
              <div class="label">❌ Chờ đợi</div>
              {page.thank_you_waiting_text}
            </div>
            <div class="choice choice-good">
              <div class="label">✅ Giữ chỗ an toàn</div>
              {page.thank_you_reserve_text}
            </div>
          </div>
        </>
      )}

      <div class="countdown-box">⏰ Ưu đãi kết thúc trong <span class="time" id="countdown">24:00:00</span></div>
      <div class="secondary-countdown">📞 Tư vấn viên sẽ gọi trong 5 phút để hỗ trợ giữ chỗ</div>
      <div class="cta-stack">
        <a href="https://zalo.me/1678310120468101523" target="_blank" rel="noopener" class="cta-btn cta-primary">👉 TÔI MUỐN GIỮ SUẤT 500K &amp; NHẬN HỌC BỔNG NGAY!</a>
        <a href="https://zalo.me/1678310120468101523" target="_blank" rel="noopener" class="cta-btn cta-zalo">💬 Tôi cần xem báo cáo và tư vấn nhanh qua Zalo</a>
      </div>
      <div class="contact-info">
        <a href="tel:+84916961409" class="contact-btn">📞 Gọi 0916 961 409</a>
      </div>
      <p class="footer-note">Thông tin được bảo mật tuyệt đối theo chính sách của Trường Việt Anh.</p>
    </div>
  </div>
  <script is:inline>
    (function () {
      var p = new URLSearchParams(window.location.search);
      var n = p.get('name');
      if (n) document.getElementById('parentName').textContent = n;
      var s = 24 * 3600, el = document.getElementById('countdown');
      var t = setInterval(function () {
        s--;
        if (s <= 0) { clearInterval(t); el.textContent = 'Đã kết thúc'; return; }
        var h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sc = s % 60;
        el.textContent = (h < 10 ? '0' : '') + h + ':' + (m < 10 ? '0' : '') + m + ':' + (sc < 10 ? '0' : '') + sc;
      }, 1e3);
    })();
  </script>
</body>
</html>
