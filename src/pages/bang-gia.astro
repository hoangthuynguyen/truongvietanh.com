---
// src/pages/bang-gia.astro
// Pricing poster — sent to parents after registration
// noindex, nofollow — private page
const title = "Bang Hoc Phi 2025-2026 Truong Viet Anh";
---
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Bảng Học Phí Chi Tiết 2025–2026 – Trường Việt Anh</title>
<meta name="robots" content="noindex,nofollow"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --navy:#000080;--yellow:#ffff00;--navy-dk:#00004d;--navy-lt:#2222cc;
  --white:#fff;--g50:#f8f8fc;--g100:#ececf8;--g300:#b0b0cc;--g700:#333355;--text:#1a1a2e
}
body{font-family:Arial,sans-serif;background:var(--g50);color:var(--text);font-size:15px;line-height:1.6}
a{color:var(--navy-lt);text-decoration:none}a:hover{text-decoration:underline}
.wrap{max-width:760px;margin:0 auto;background:var(--white)}

/* Banner */
.banner{background:var(--navy);color:var(--yellow);text-align:center;padding:36px 24px 28px}
.banner .eyebrow{font-size:12px;letter-spacing:3px;text-transform:uppercase;opacity:.7;margin-bottom:8px}
.banner h1{font-size:clamp(20px,4vw,30px);font-weight:900;line-height:1.2;color:var(--yellow);margin-bottom:8px}
.banner .sub{font-size:13px;color:rgba(255,255,0,.75)}
.banner .bdg{display:inline-block;background:var(--yellow);color:var(--navy);font-size:10px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;padding:3px 12px;border-radius:20px;margin-top:12px}

/* Accent bar */
.abar{background:var(--yellow);color:var(--navy);text-align:center;font-size:13px;font-weight:700;padding:9px 16px;border-bottom:2px solid var(--navy)}
.abar a{color:var(--navy);font-weight:800}

/* Section */
.sec{padding:28px 24px 22px;border-bottom:1px solid var(--g100)}
.sec:last-child{border-bottom:none}
.stitle{display:flex;align-items:center;gap:10px;font-size:17px;font-weight:800;color:var(--navy);margin-bottom:16px}
.num{background:var(--navy);color:var(--yellow);width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:900;flex-shrink:0}

/* Tables */
table{width:100%;border-collapse:collapse;font-size:13px}
th{background:var(--navy);color:var(--yellow);padding:9px 10px;text-align:left;font-weight:700;font-size:11.5px;letter-spacing:.3px}
th:first-child{border-radius:6px 0 0 0}
th:last-child{border-radius:0 6px 0 0}
td{padding:8px 10px;border-bottom:1px solid var(--g100);vertical-align:top}
tr:last-child td{border-bottom:none}
tr:nth-child(even) td{background:var(--g50)}
.fv{font-weight:700;color:var(--navy)}
.orig{text-decoration:line-through;color:var(--g300);font-size:11px;display:block}
.promo{color:#c00;font-weight:700;font-size:13.5px}
.free{background:#e8ffe8;color:#006600;border:1px solid #99dd99;border-radius:4px;padding:2px 6px;font-size:10.5px;font-weight:700}
.tgt{font-size:10.5px;color:var(--g700);background:var(--g100);border-radius:4px;padding:2px 6px;white-space:nowrap}

/* Sub-heading */
.sub-h{font-weight:700;color:var(--navy);font-size:13px;margin:16px 0 8px;padding-bottom:4px;border-bottom:2px solid var(--yellow)}

/* Bullet list */
.il{list-style:none;padding:0}
.il li{padding:7px 0;border-bottom:1px solid var(--g100);display:flex;gap:8px;font-size:13.5px}
.il li:last-child{border-bottom:none}
.il li::before{content:"\25B8";color:var(--navy);font-weight:900;flex-shrink:0;margin-top:2px}

/* Grid cards */
.hg{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-bottom:14px}
.hc{border:2px solid var(--navy);border-radius:8px;padding:12px 14px}
.hc.y{background:var(--yellow);border-color:var(--yellow)}
.hc .lb{font-size:10px;text-transform:uppercase;letter-spacing:.5px;color:var(--g700);margin-bottom:3px}
.hc .vl{font-size:16px;font-weight:800;color:var(--navy)}
.hc.y .lb{color:var(--navy);opacity:.8}.hc.y .vl{color:var(--navy)}

/* Two-col grid */
.pg{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.pc{background:var(--g50);border-left:4px solid var(--navy);border-radius:0 8px 8px 0;padding:12px 14px;font-size:13px}
.pc strong{display:block;color:var(--navy);font-size:13px;margin-bottom:3px}

/* Notice */
.notice{background:#fffbe6;border:1.5px solid #e6c000;border-radius:8px;padding:12px 14px;font-size:13px;color:#4a3800;margin-top:14px}
.notice strong{color:var(--navy)}

/* CTA */
.cta{background:var(--yellow);text-align:center;padding:18px 20px}
.cta p{font-size:13px;color:var(--navy);margin-bottom:8px}
.cta a{display:inline-block;background:var(--navy);color:var(--yellow)!important;font-weight:800;padding:10px 28px;border-radius:6px;font-size:14px;text-decoration:none!important}

/* Footer */
.foot{background:var(--navy);color:rgba(255,255,255,.75);text-align:center;padding:22px 20px 18px;font-size:12px}
.foot .sn{color:var(--yellow);font-size:15px;font-weight:800;letter-spacing:1px;margin-bottom:8px}
.foot a{color:var(--yellow)}
.foot hr{border:none;border-top:1px solid rgba(255,255,255,.2);margin:10px 0}
.foot .ct{display:flex;flex-wrap:wrap;justify-content:center;gap:14px;margin-bottom:6px}

@media(max-width:540px){
  .pg{grid-template-columns:1fr}
  th,td{font-size:11px;padding:5px 7px}
  .sec{padding:18px 12px 14px}
  .banner h1{font-size:18px}
}
@media print{
  body{background:#fff;font-size:11px}
  .wrap{max-width:100%}
  .cta{display:none}
}
</style>
</head>
