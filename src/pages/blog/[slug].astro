---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeaderBase from '../../components/HeaderBase.astro';
import FooterBase from '../../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../../components/LeadFormTwoStepEmailFirst.astro';
import { createDirectus, readItems, rest, staticToken } from '@directus/sdk';

type Post = {
  id: number | string;
  title: string;
  slug: string;
  status: string;
  excerpt?: string | null;
  content?: string | null;
  published_at?: string | null;
};

type DirectusSchema = {
  posts: Post[];
};

export async function getStaticPaths() {
  const url = (import.meta.env.PUBLIC_DIRECTUS_URL || 'http://45.88.188.169:8055').trim();
  const token = (import.meta.env.DIRECTUS_TOKEN || 'tva_0b80f9b6cc9c494d98faf0a2a1a966e7').trim();

  const client = token
    ? createDirectus<DirectusSchema>(url).with(staticToken(token)).with(rest())
    : createDirectus<DirectusSchema>(url).with(rest());

  // Fetch all published posts — paginate to get all 552+
  let allPosts: Post[] = [];
  let page = 1;
  const perPage = 100;
  let hasMore = true;

  while (hasMore) {
    const batch = await client.request(
      readItems('posts', {
        fields: ['id', 'title', 'slug', 'status', 'excerpt', 'content', 'published_at'],
        filter: { status: { _eq: 'published' } },
        sort: ['-published_at', '-id'],
        limit: perPage,
        offset: (page - 1) * perPage,
      }),
    );
    allPosts = [...allPosts, ...batch];
    hasMore = batch.length === perPage;
    page++;
  }

  return allPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post, allPosts },
  }));
}

const { post, allPosts } = Astro.props as { post: Post; allPosts: Post[] };

// Smart related posts — match by title keywords instead of random
const otherPosts = allPosts.filter((p: Post) => p.slug !== post.slug);
const titleWords = post.title.toLowerCase().split(/[\s,–—:]+/).filter(w => w.length > 3);
const scored = otherPosts.map(p => {
  const pTitle = p.title.toLowerCase();
  const score = titleWords.reduce((s, w) => s + (pTitle.includes(w) ? 1 : 0), 0);
  return { post: p, score };
}).sort((a, b) => b.score - a.score);
const relatedPosts = scored.slice(0, 3).map(s => s.post);

function formatDate(dateStr?: string | null): string {
  if (!dateStr) return '';
  try {
    return new Date(dateStr).toLocaleDateString('vi-VN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    });
  } catch {
    return '';
  }
}

function formatISO(dateStr?: string | null): string {
  if (!dateStr) return '';
  try {
    return new Date(dateStr).toISOString();
  } catch {
    return '';
  }
}

// Clean CMS content: remove duplicate H1, fix placeholder phone/zalo
function cleanContent(html: string | null | undefined): string {
  if (!html) return '';
  let cleaned = html
    // Remove first H1 (template already has H1)
    .replace(/<h1[^>]*>[\s\S]*?<\/h1>\s*/i, '')
    // Remove CMS "Bước Tiếp Theo" section (template already has this)
    .replace(/<h2[^>]*>\s*Bước Tiếp Theo\s*<\/h2>[\s\S]*?(?=<h2|$)/i, '')
    // Fix placeholder phone numbers
    .replace(/0909\.xxx\.xxx/g, '0916 961 409')
    .replace(/0909\.?xxx\.?xxx/g, '0916 961 409')
    .replace(/href="tel:0909[^"]*"/g, 'href="tel:0916961409"')
    // Fix wrong Zalo links
    .replace(/zalo\.me\/truongvietanh/g, 'zalo.me/0916961409')
    // Convert markdown-style tables to HTML tables
    .replace(/(<p>)?\|([^\n]+)\|\s*\n\s*\|[-\s|]+\|\s*\n((?:\s*\|[^\n]+\|\s*\n?)+)(<\/p>)?/g, (_match, _p1, headerRow, bodyRows) => {
      const headers = headerRow.split('|').map((h: string) => h.trim()).filter(Boolean);
      const rows = bodyRows.trim().split('\n').map((row: string) =>
        row.split('|').map((c: string) => c.trim()).filter(Boolean)
      );
      let html = '<div class="blog-table-wrap"><table><thead><tr>';
      headers.forEach((h: string) => { html += `<th>${h}</th>`; });
      html += '</tr></thead><tbody>';
      rows.forEach((cols: string[]) => {
        html += '<tr>';
        cols.forEach((c: string) => { html += `<td>${c}</td>`; });
        html += '</tr>';
      });
      html += '</tbody></table></div>';
      return html;
    });
  return cleaned;
}

const cleanedContent = cleanContent(post.content);
const pageTitle = post.title.length > 55 ? post.title : `${post.title} | Trường Việt Anh`;
const pageDesc = post.excerpt || `${post.title} — Tìm hiểu chi tiết tại blog Trường Việt Anh.`;
const canonicalUrl = `https://truongvietanh.com/blog/${post.slug}`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.title,
    description: pageDesc,
    datePublished: formatISO(post.published_at),
    dateModified: formatISO(post.published_at),
    url: canonicalUrl,
    inLanguage: 'vi',
    wordCount: cleanedContent ? cleanedContent.replace(/<[^>]*>/g, '').split(/\s+/).length : 0,
    author: {
      '@type': 'Organization',
      name: 'Ban Truyền Thông Trường Việt Anh',
      url: 'https://truongvietanh.com',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Trường Việt Anh',
      url: 'https://truongvietanh.com',
      logo: {
        '@type': 'ImageObject',
        url: 'https://truongvietanh.com/logo-crest-80.webp',
      },
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': canonicalUrl,
    },
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['.blog-article h1', '.blog-article > p:first-of-type'],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: 'https://truongvietanh.com/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://truongvietanh.com/tin-tuc' },
      { '@type': 'ListItem', position: 3, name: post.title, item: canonicalUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Trường Việt Anh dạy chương trình gì?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Trường Việt Anh áp dụng chương trình song ngữ tích hợp: 100% chương trình Bộ GD&ĐT Việt Nam kết hợp chương trình Cambridge International cho các môn Toán, Khoa học, ICT và Computing.',
        },
      },
      {
        '@type': 'Question',
        name: 'Học sinh tốt nghiệp đạt IELTS bao nhiêu?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Học sinh THPT Việt Anh tốt nghiệp đạt IELTS từ 6.0 đến 8.0, trung bình đầu ra 6.5 — đủ điều kiện xét tuyển vào các trường đại học xếp hạng cao trên thế giới.',
        },
      },
      {
        '@type': 'Question',
        name: 'Học phí Trường Việt Anh bao nhiêu?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Học phí dao động từ 5 đến 12 triệu đồng/tháng tuỳ cấp học, bao gồm giáo viên bản ngữ, chương trình Cambridge và 16 kỹ năng thế kỷ 21 theo WEF.',
        },
      },
      {
        '@type': 'Question',
        name: 'Trường có bao nhiêu cơ sở?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Trường Việt Anh hiện có 9 cơ sở tại TP.HCM (Gò Vấp, Phú Nhuận, Bình Tân), Cần Giuộc - Long An và TP. Rạch Giá - Kiên Giang.',
        },
      },
      {
        '@type': 'Question',
        name: 'Làm sao để đăng ký tuyển sinh?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Phụ huynh có thể đăng ký tư vấn trên trang tuyển sinh, gọi hotline 0916 961 409, hoặc đặt lịch tham quan trường.',
        },
      },
    ],
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonical={canonicalUrl}
  structuredData={structuredData}
  ogImage="https://media.truongvietanh.com/images/extra-giao-vien-va-hoc-sinh-2.webp"
>
  <div class="cf-layout page-wrapper">
    <HeaderBase currentPath={`/blog/${post.slug}`} />

    <!-- Reading Progress Bar -->
    <div class="reading-progress" id="readingProgress" aria-hidden="true">
      <div class="reading-progress__bar" id="readingBar"></div>
    </div>

    <!-- Breadcrumb -->
    <nav class="blog-breadcrumb" aria-label="Breadcrumb">
      <div class="blog-container">
        <ol class="blog-breadcrumb__list">
          <li><a href="/">Trang chủ</a></li>
          <li><a href="/tin-tuc">Blog</a></li>
          <li aria-current="page">{post.title}</li>
        </ol>
      </div>
    </nav>

    <!-- Article -->
    <article class="blog-article">
      <div class="blog-container">
        <header class="blog-article__header">
          <h1 class="blog-article__title">{post.title}</h1>
          <div class="blog-article__meta">
            {post.published_at && (
              <time class="blog-article__date" datetime={post.published_at}>
                {formatDate(post.published_at)}
              </time>
            )}
            <span class="blog-article__badge">Blog</span>
            <span class="blog-article__readtime" id="readTime"></span>
          </div>
          <!-- Share buttons -->
          <div class="blog-share">
            <span class="blog-share__label">Chia sẻ:</span>
            <a class="blog-share__btn blog-share__btn--fb" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonicalUrl)}`} target="_blank" rel="noopener" aria-label="Chia sẻ lên Facebook">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
            </a>
            <a class="blog-share__btn blog-share__btn--zalo" href={`https://zalo.me/share?url=${encodeURIComponent(canonicalUrl)}`} target="_blank" rel="noopener" aria-label="Chia sẻ qua Zalo">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            </a>
            <button class="blog-share__btn blog-share__btn--copy" id="copyLink" aria-label="Sao chép link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            </button>
          </div>
        </header>

        {post.excerpt && (
          <p class="blog-article__excerpt">{post.excerpt}</p>
        )}

        <!-- Auto TOC (generated by JS from H2/H3 in content) -->
        <nav class="blog-toc" id="blogToc" aria-label="Mục lục bài viết" style="display:none">
          <p class="blog-toc__title">Mục lục</p>
          <ol class="blog-toc__list" id="blogTocList"></ol>
        </nav>

        <div class="blog-article__body" set:html={cleanedContent} />

        <!-- Author Bio -->
        <div class="blog-author-bio">
          <div class="blog-author-bio__avatar">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
          </div>
          <div class="blog-author-bio__info">
            <p class="blog-author-bio__name">Ban Truyền Thông Trường Việt Anh</p>
            <p class="blog-author-bio__desc">Biên soạn bởi đội ngũ truyền thông với hơn 13 năm kinh nghiệm trong giáo dục song ngữ. Kiểm duyệt bởi Ban Giám Hiệu.</p>
          </div>
        </div>

        <!-- Inline CTA Banner -->
        <div class="blog-cta-inline">
          <div class="blog-cta-inline__inner">
            <h3 class="blog-cta-inline__title"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:middle;margin-right:6px"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>Tìm hiểu thêm về Trường Việt Anh</h3>
            <p class="blog-cta-inline__desc">Khám phá chương trình giáo dục liên cấp chất lượng cao từ Mầm non đến THPT.</p>
            <div class="blog-cta-inline__actions">
              <a href="/tuyen-sinh" class="blog-cta-inline__btn blog-cta-inline__btn--primary">Tư vấn tuyển sinh</a>
              <a href="/gioi-thieu" class="blog-cta-inline__btn blog-cta-inline__btn--secondary">Giới thiệu trường</a>
            </div>
          </div>
        </div>

        <!-- FAQ Section -->
        <section class="blog-faq">
          <h2 class="blog-faq__title"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:middle;margin-right:6px"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>Câu hỏi thường gặp về Trường Việt Anh</h2>
          <div class="blog-faq__list">
            <details class="blog-faq__item" open>
              <summary class="blog-faq__question">Trường Việt Anh dạy chương trình gì?</summary>
              <p class="blog-faq__answer">Trường Việt Anh áp dụng chương trình song ngữ tích hợp: 100% chương trình <a href="https://moet.gov.vn" target="_blank" rel="noopener">Bộ GD&ĐT Việt Nam</a> kết hợp chương trình <a href="https://www.cambridgeinternational.org" target="_blank" rel="noopener">Cambridge International</a> cho các môn Toán, Khoa học, ICT và Computing.</p>
            </details>
            <details class="blog-faq__item">
              <summary class="blog-faq__question">Học sinh tốt nghiệp đạt IELTS bao nhiêu?</summary>
              <p class="blog-faq__answer">Học sinh THPT Việt Anh tốt nghiệp đạt <a href="https://www.ielts.org" target="_blank" rel="noopener">IELTS</a> từ 6.0 đến 8.0, trung bình đầu ra 6.5 — đủ điều kiện xét tuyển vào các trường đại học xếp hạng cao trên thế giới.</p>
            </details>
            <details class="blog-faq__item">
              <summary class="blog-faq__question">Học phí Trường Việt Anh bao nhiêu?</summary>
              <p class="blog-faq__answer">Học phí dao động từ 5 đến 12 triệu đồng/tháng tuỳ cấp học, bao gồm giáo viên bản ngữ, chương trình Cambridge và 16 kỹ năng thế kỷ 21 theo <a href="https://www.weforum.org" target="_blank" rel="noopener">WEF</a>.</p>
            </details>
            <details class="blog-faq__item">
              <summary class="blog-faq__question">Trường có bao nhiêu cơ sở?</summary>
              <p class="blog-faq__answer">Trường Việt Anh hiện có 9 cơ sở tại TP.HCM (Gò Vấp, Phú Nhuận, Bình Tân), Cần Giuộc - Long An và TP. Rạch Giá - Kiên Giang.</p>
            </details>
            <details class="blog-faq__item">
              <summary class="blog-faq__question">Làm sao để đăng ký tuyển sinh?</summary>
              <p class="blog-faq__answer">Phụ huynh có thể đăng ký tư vấn trên <a href="/tuyen-sinh">trang tuyển sinh</a>, gọi hotline <a href="tel:0916961409">0916 961 409</a>, hoặc đặt lịch tham quan trường.</p>
            </details>
          </div>
        </section>

        <!-- Internal Links to Pillar Pages -->
        <nav class="blog-pillar-links" aria-label="Tìm hiểu thêm">
          <h3 class="blog-pillar-links__title"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:middle;margin-right:6px"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg>Khám phá chương trình các cấp</h3>
          <div class="blog-pillar-links__grid">
            <a href="/mam-non" class="blog-pillar-links__item">Mầm Non</a>
            <a href="/tieu-hoc" class="blog-pillar-links__item">Tiểu Học</a>
            <a href="/trung-hoc-co-so" class="blog-pillar-links__item">THCS</a>
            <a href="/trung-hoc-pho-thong" class="blog-pillar-links__item">THPT</a>
            <a href="/hoc-phi" class="blog-pillar-links__item">Học Phí</a>
            <a href="/co-so" class="blog-pillar-links__item">Cơ Sở Vật Chất</a>
            <a href="/thanh-tich" class="blog-pillar-links__item">Thành Tích</a>
            <a href="/ngoai-khoa" class="blog-pillar-links__item">Ngoại Khóa</a>
          </div>
        </nav>

        <!-- Related Posts -->
        {relatedPosts.length > 0 && (
          <section class="blog-related">
            <h2 class="blog-related__title"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:middle;margin-right:6px"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg>Bài viết liên quan</h2>
            <div class="blog-related__grid">
              {relatedPosts.map((rp) => (
                <a href={`/blog/${rp.slug}`} class="blog-related__card">
                  <h3 class="blog-related__card-title">{rp.title}</h3>
                  {rp.excerpt && (
                    <p class="blog-related__card-excerpt">{rp.excerpt}</p>
                  )}
                  {rp.published_at && (
                    <time class="blog-related__card-date" datetime={rp.published_at}>
                      {formatDate(rp.published_at)}
                    </time>
                  )}
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- Bottom CTA: Lead Form -->
        <section class="blog-bottom-cta">
          <h2 class="blog-bottom-cta__title"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:middle;margin-right:6px"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>Đăng ký nhận tư vấn miễn phí</h2>
          <p class="blog-bottom-cta__desc">Để lại thông tin để được đội ngũ tuyển sinh tư vấn chi tiết về chương trình phù hợp cho con bạn.</p>
          <div class="blog-bottom-cta__form-wrap">
            <LeadFormTwoStepEmailFirst
              formId="blog-lead-form"
              funnelCode="blog-post"
              schoolLevel="lien-cap"
              submitText="Nhận tư vấn miễn phí"
            />
          </div>
          <div class="blog-bottom-cta__contact">
            <p class="blog-bottom-cta__contact-title">Bước Tiếp Theo</p>
            <div class="blog-bottom-cta__contact-links">
              <a href="/tuyen-sinh" class="blog-contact-btn blog-contact-btn--tour">Đặt Lịch Tham Quan</a>
              <a href="tel:0916961409" class="blog-contact-btn blog-contact-btn--phone">📞 0916 961 409</a>
              <a href="https://zalo.me/0916961409" class="blog-contact-btn blog-contact-btn--zalo">💬 Nhắn Zalo</a>
            </div>
          </div>
        </section>
      </div>
    </article>

    <FooterBase />
  </div>
</BaseLayout>

<style is:global>
  /* ===== BLOG CONTAINER ===== */
  .blog-container {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ===== BREADCRUMB ===== */
  .blog-breadcrumb {
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    padding: 0.75rem 0;
  }

  .blog-breadcrumb__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: #64748b;
  }

  .blog-breadcrumb__list li:not(:last-child)::after {
    content: '›';
    margin-left: 0.4rem;
    color: #94a3b8;
  }

  .blog-breadcrumb__list a {
    color: #1a1a5e;
    text-decoration: none;
  }

  .blog-breadcrumb__list a:hover {
    text-decoration: underline;
    color: #D4A843;
  }

  .blog-breadcrumb__list li[aria-current="page"] {
    color: #334155;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 300px;
  }

  /* ===== ARTICLE ===== */
  .blog-article {
    padding: 2.5rem 0 3rem;
  }

  .blog-article__header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid #e2e8f0;
  }

  .blog-article__title {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 800;
    color: #1a1a5e;
