    .ai-blog .blog-hero-img { padding: 0; margin-top: 0; }
    .ai-blog .blog-hero-img img { border-radius: 0; max-height: 240px; }
    .ai-blog .blog-breadcrumb__list li[aria-current="page"] { max-width: 180px; }
  }
</style>

<script>
  // Reading progress bar
  const bar = document.getElementById('readingBar');
  const article = document.querySelector('.ai-blog .blog-article');
  if (bar && article) {
    window.addEventListener('scroll', () => {
      const rect = (article as HTMLElement).getBoundingClientRect();
      const total = (article as HTMLElement).offsetHeight - window.innerHeight;
      const scrolled = -rect.top;
      const pct = Math.max(0, Math.min(100, (scrolled / total) * 100));
      (bar as HTMLElement).style.width = pct + '%';
    }, { passive: true });
  }

  // Copy link button
  const copyBtn = document.getElementById('copyLinkBtn');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        copyBtn.classList.add('blog-share__btn--copied');
        setTimeout(() => copyBtn.classList.remove('blog-share__btn--copied'), 2000);
      } catch {}
    });
  }
</script>
