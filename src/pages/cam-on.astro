---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout
  title="Cảm ơn bạn đã đăng ký! | Trường Việt Anh"
  description="Chúng tôi đã nhận được thông tin của bạn. Đội ngũ tư vấn sẽ liên hệ trong 24 giờ."
  noindex={true}
  noPopup={true}
>
  <div class="site-shell">
    <SiteHeader currentPath="/cam-on" />

    <main class="thankyou-page">
      <div class="thankyou-container">

        <!-- Top: icon + title -->
        <div class="thankyou-top">
          <div class="thankyou-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          </div>
          <div>
            <h1>Đăng ký thành công!</h1>
            <p class="thankyou-subtitle" id="thankyou-text">Cảm ơn bạn đã quan tâm đến Trường Việt Anh</p>
          </div>
        </div>

        <script is:inline>
          const params = new URLSearchParams(window.location.search);
          const name = params.get('name');
          // Lead magnet "Cẩm nang dùng AI đúng cách" → chuyển sang trang tải PDF riêng.
          if (params.get('funnel') === 'leadmagnet-ai-cam-nang') {
            window.location.replace('/cam-on-cam-nang-ai' + (name ? '?name=' + encodeURIComponent(name) : ''));
          }
          if (name) {
            document.getElementById('thankyou-text').textContent =
              'Cảm ơn ' + decodeURIComponent(name) + ' đã quan tâm đến Trường Việt Anh';
          }
        </script>

        <!-- Main 2-column grid -->
        <div class="thankyou-grid">

          <!-- Left: 3 steps -->
          <div class="thankyou-steps">
            <h2>Hoàn tất 3 bước để nhận nội dung</h2>
            <div class="step-cards">
              <div class="step-card step-card--highlight">
                <span class="step-number">1</span>
                <div>
                  <strong>Mở email ngay bây giờ</strong>
                  <p>Email từ <strong>Nguyễn Mạnh Dương &lt;duong@reply.truongvietanh.com&gt;</strong> vừa được gửi đến hộp thư của bạn.</p>
                </div>
              </div>
              <div class="step-card step-card--highlight">
                <span class="step-number">2</span>
                <div>
                  <strong>Nhấp "Xác nhận đăng ký" trong email</strong>
                  <p>Bạn <strong>phải nhấp link xác nhận</strong> thì mới nhận được chuỗi email giá trị từ thầy Dương.</p>
                </div>
              </div>
              <div class="step-card">
                <span class="step-number">3</span>
                <div>
                  <strong>Tư vấn viên sẽ liên hệ bạn</strong>
                  <p>Đội ngũ tuyển sinh gọi điện hoặc nhắn Zalo trong vòng 24 giờ.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Right: spam notice + contact + links -->
          <div class="thankyou-right">
            <div class="thankyou-spam-notice">
              <h3>Không thấy email?</h3>
              <ul>
                <li><strong>Gmail:</strong> Tab <em>Quảng cáo</em> hoặc <em>Thư rác</em> → "Không phải thư rác"</li>
                <li><strong>Yahoo / Outlook:</strong> Thư mục <em>Spam / Junk</em></li>
                <li><strong>Điện thoại:</strong> Tìm "truongvietanh" trong ứng dụng email</li>
                <li><strong>Vẫn không thấy?</strong> Đợi 5 phút, hoặc gọi hotline bên dưới</li>
              </ul>
              <p class="spam-tip">Thêm <strong>duong@reply.truongvietanh.com</strong> vào danh bạ email để tránh bị spam lần sau.</p>
            </div>

            <div class="thankyou-contact">
              <p>Cần hỗ trợ ngay?</p>
              <a href="tel:0916961409" class="thankyou-phone">0916 961 409</a>
              <span class="thankyou-divider">hoặc</span>
              <a href="https://zalo.me/1678310120468101523" class="thankyou-zalo" target="_blank" rel="noopener">Nhắn Zalo</a>
            </div>

            <div class="thankyou-links">
              <a href="/" class="btn-cta--outline">Về trang chủ</a>
              <a href="/tuyen-sinh" class="btn-cta">Xem lộ trình tuyển sinh</a>
            </div>
          </div>
        </div>

      </div>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>

<style>.thankyou-page{
    min-height: calc(100vh - 140px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 1.5rem;
  }.thankyou-container{
    max-width: 960px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }/* Top row: icon + title inline */
  .thankyou-top{
    display: flex;
    align-items: center;
    gap: 1rem;
  }.thankyou-icon{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    border-radius: 50%;
    background: linear-gradient(135deg, #26275D, #363876);
    color: #f9dd0e;
    animation: popIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    box-shadow: 0 6px 24px rgba(38, 39, 93, 0.2);
  }

  @keyframes popIn {0%{ transform: scale(0); opacity: 0; }60%{ transform: scale(1.1); }100%{ transform: scale(1); opacity: 1; }
  }h1{
    font-family: "Montserrat", "Be Vietnam Pro", sans-serif;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: #26275D;
    margin: 0 0 0.2rem;
  }.thankyou-subtitle{
    font-size: 1rem;
    color: #5c6e80;
    margin: 0;
  }/* 2-column grid */
  .thankyou-grid{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    align-items: start;
  }/* Left: steps */
  .thankyou-steps{
    text-align: left;
    background: #f8fafc;
    border-radius: 14px;
    padding: 1.25rem;
    border: 1px solid #e2e8f0;
    height: 100%;
    box-sizing: border-box;
  }.thankyou-steps h2{
    font-size: 1.5rem;
    color: #26275D;
    margin: 0 0 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }.step-cards{
    display: grid;
    gap: 0.75rem;
  }.step-card{
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }.step-number{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    height: 28px;
    border-radius: 50%;
    background: linear-gradient(135deg, #26275D, #363876);
    color: #f9dd0e;
    font-weight: 800;
    font-size: 1rem;
    flex-shrink: 0;
  }.step-card strong{
    display: block;
    color: #26275D;
    font-size: 1rem;
    margin-bottom: 0.2rem;
  }.step-card p{
    color: #5c6e80;
    font-size: 1rem;
    line-height: 1.45;
    margin: 0;
  }.step-card--highlight{
    background: linear-gradient(135deg, #fef9ef, #fdf6e3);
    border-left: 3px solid #f9dd0e;
    padding: 0.65rem 0.75rem;
    border-radius: 8px;
  }/* Right column */
  .thankyou-right{
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }.thankyou-spam-notice{
    text-align: left;
    background: #fff8f0;
    border: 1px solid #fed7aa;
    border-radius: 12px;
    padding: 1.1rem;
  }.thankyou-spam-notice h3{
    font-size: 1.5rem;
    color: #9a3412;
    margin: 0 0 0.5rem;
    font-weight: 700;
  }.thankyou-spam-notice ul{
    margin: 0;
    padding-left: 1.1rem;
  }.thankyou-spam-notice li{
    font-size: 1rem;
    color: #78350f;
    line-height: 1.5;
    margin-bottom: 0.35rem;
  }.spam-tip{
    margin: 0.65rem 0 0;
    padding: 0.55rem 0.75rem;
    background: #fefce8;
    border-radius: 6px;
    font-size: 1rem;
    color: #713f12;
  }.thankyou-contact{
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }.thankyou-contact p{
    color: #5c6e80;
    font-size: 1rem;
    margin: 0;
  }.thankyou-phone{
    font-weight: 700;
    color: #26275D;
    font-size: 1rem;
    text-decoration: none;
  }.thankyou-divider{
    color:#64748b;
    font-size: 1rem;
  }.thankyou-zalo{
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.85rem;
    background: #0068ff;
    color: #fff;
    border-radius: 7px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
  }.thankyou-links{
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }.thankyou-links .btn-cta{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.5rem;
    border-radius: 9px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    background: linear-gradient(135deg, #26275D, #363876);
    color: #fff;
    transition: transform 0.2s, box-shadow 0.2s;
  }.thankyou-links .btn-cta:hover{
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(26, 25, 60, 0.25);
  }.thankyou-links .btn-cta--outline{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.5rem;
    border-radius: 9px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    background: transparent;
    color: #26275D;
    border: 2px solid rgba(26, 25, 60, 0.2);
    transition: background 0.2s;
  }.thankyou-links .btn-cta--outline:hover{
    background: rgba(26, 25, 60, 0.04);
  }

  /* Mobile: back to single column */
  @media (max-width: 680px) {.thankyou-top{
      flex-direction: column;
      text-align: center;
    }.thankyou-grid{
      grid-template-columns: 1fr;
    }.thankyou-links{
      flex-direction: column;
    }.thankyou-links a{
      width: 100%;
      text-align: center;
    }.thankyou-contact{
      justify-content: center;
    }
  }
</style>
