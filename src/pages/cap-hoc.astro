---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import { getPillarPage } from '../lib/directus';

const cmsPage = await getPillarPage('cap-hoc');
const cmsFaqs = cmsPage?.faq_items || null;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Trường Việt Anh",
    "alternateName": "Trường Liên Cấp Việt Anh",
    "url": "https://truongvietanh.com",
    "logo": "https://truongvietanh.com/logo-crest-80.webp",
    "foundingDate": "2011",
    "description": "Hệ thống giáo dục liên cấp song ngữ từ Mầm non đến THPT tại TP.HCM, Tây Ninh, Kiên Giang. 4 cấp học — lộ trình phát triển toàn diện cho học sinh từ 2 đến 18 tuổi.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Hồ Chí Minh",
      "addressCountry": "VN"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "bestRating": "5",
      "ratingCount": "300"
    },
    "numberOfEmployees": { "@type": "QuantitativeValue", "value": 500 },
    "areaServed": ["TP. Hồ Chí Minh", "Tây Ninh", "Kiên Giang"]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Trường Việt Anh có những cấp học nào?",
        "acceptedAnswer": { "@type": "Answer", "text": "Trường Việt Anh đào tạo 4 cấp học liên tục: Mầm non (2-6 tuổi), Tiểu học (lớp 1-5), THCS (lớp 6-9) và THPT (lớp 10-12). Học sinh được học xuyên suốt từ 2 đến 18 tuổi trong cùng hệ thống." }
      },
      {
        "@type": "Question",
        "name": "Học sinh có thể chuyển cấp trong nội bộ Trường Việt Anh không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Có. Học sinh chuyển cấp nội bộ được ưu tiên xét tuyển, không cần thi đầu vào lại. Hồ sơ học tập và kế hoạch phát triển cá nhân được chuyển giao liên tục giữa các cấp." }
      },
      {
        "@type": "Question",
        "name": "Chương trình tiếng Anh có liên tục giữa các cấp không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Có. Lộ trình tiếng Anh được thiết kế xuyên suốt: Immersion ở Mầm non, UK Oxford ở Tiểu học, Academic English ở THCS, và luyện thi IELTS chuyên sâu ở THPT. Đầu ra tối thiểu IELTS 6.0." }
      },
      {
        "@type": "Question",
        "name": "Học phí các cấp học tại Trường Việt Anh là bao nhiêu?",
        "acceptedAnswer": { "@type": "Answer", "text": "Học phí dao động từ 5 đến 8 triệu đồng/tháng tuỳ cấp học, bao gồm ăn trưa và hoạt động ngoại khoá cơ bản. Xem chi tiết tại trang học phí." }
      },
      {
        "@type": "Question",
        "name": "Lợi ích của hệ thống liên cấp so với học nhiều trường khác nhau là gì?",
        "acceptedAnswer": { "@type": "Answer", "text": "Hệ thống liên cấp giúp học sinh không bị gián đoạn khi chuyển cấp, giáo viên nắm rõ lộ trình từng em, tiếng Anh tiến bộ liên tục, và phụ huynh yên tâm không phải tìm trường mới mỗi 3-4 năm." }
      },
      {
        "@type": "Question",
        "name": "Trường Việt Anh nhận học sinh chuyển trường giữa chừng không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Có. Trường nhận học sinh chuyển trường ở tất cả các cấp học, bất kỳ thời điểm nào trong năm nếu còn chỗ. Học sinh sẽ được kiểm tra đầu vào để xếp lớp phù hợp." }
      },
      {
        "@type": "Question",
        "name": "Chương trình tiếng Anh khác nhau như thế nào giữa các cấp?",
        "acceptedAnswer": { "@type": "Answer", "text": "Mầm Non: 100% immersion. Tiểu Học: song ngữ Việt-Anh, một số môn theo giáo trình UK. THCS: nâng cao giao tiếp + học thuật, chuẩn bị IELTS. THPT: luyện thi IELTS chuyên sâu, đạt 6.0-8.0 trước khi tốt nghiệp." }
      },
      {
        "@type": "Question",
        "name": "Lợi ích của hệ thống liên cấp so với học nhiều trường là gì?",
        "acceptedAnswer": { "@type": "Answer", "text": "Hệ thống liên cấp giúp học sinh không bị gián đoạn khi chuyển cấp: bạn bè quen, giáo viên nắm rõ lộ trình, tiếng Anh tiến bộ liên tục. Hơn 70% phụ huynh Việt Anh cho con học liên cấp từ Mầm non đến THPT." }
      },
      {
        "@type": "Question",
        "name": "Sĩ số mỗi lớp là bao nhiêu?",
        "acceptedAnswer": { "@type": "Answer", "text": "Mầm Non: 15-20 trẻ/lớp (2 giáo viên + 1 trợ giảng). Tiểu Học: 24 học sinh/lớp. THCS-THPT: 24 học sinh/lớp." }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://truongvietanh.com" },
      { "@type": "ListItem", "position": 2, "name": "Cấp học", "item": "https://truongvietanh.com/cap-hoc" }
    ]
  }
];
---

<BaseLayout
  title={cmsPage?.title || "Các Cấp Học Tại Trường Việt Anh — Mầm Non Đến THPT"}
  description={cmsPage?.description || "4 cấp học Trường Việt Anh: Mầm non, Tiểu học, THCS, THPT. Lộ trình liên cấp song ngữ 2-18 tuổi, IELTS xuyên suốt. Đăng ký tham quan."}
  canonical="https://truongvietanh.com/cap-hoc"
  ogImage="https://media.truongvietanh.com/images/extra-giao-vien-va-hoc-sinh-2.webp"
  structuredData={structuredData}
>
  <div class="gi-page">
    <HeaderBase />

    <!-- ====== HERO WITH FORM ====== -->
    <section class="gi-hero">
      <div class="gi-container gi-hero-inner">
        <div class="gi-hero-left">
          <nav class="gi-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Trang chủ</a>
            <span aria-hidden="true">/</span>
            <span>Cấp học</span>
          </nav>

          <h1 class="gi-h1">Hệ Thống Liên Cấp Trường Việt Anh</h1>
          <p class="gi-subtitle">Từ Mầm non đến THPT — Lộ trình phát triển toàn diện cho con từ 2 đến 18 tuổi</p>
          <p class="gi-last-updated">Cập nhật lần cuối: Tháng 4, 2026</p>

          <div class="gi-hero-rating">
            <span class="gi-stars" aria-label="4.9 trên 5 sao">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            <span class="gi-rating-text">4.9/5 (300+ đánh giá)</span>
          </div>

          <div class="gi-trust-badges">
            <div class="gi-badge"><strong>4</strong> cấp học</div>
            <div class="gi-badge"><strong>15+</strong> năm</div>
            <div class="gi-badge"><strong>IELTS</strong> 6-8</div>
            <div class="gi-badge"><strong>9</strong> cơ sở</div>
          </div>
        </div>

        <div class="gi-hero-right">
          <div class="gi-form-card">
            <p class="gi-form-heading">Đăng ký tham quan trường miễn phí</p>
            <LeadFormTwoStepEmailFirst
              formId="cap-hoc-form"
              funnelCode="cap-hoc-pillar"
              schoolLevel="lien-cap"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ====== TOC SIDEBAR + CONTENT ====== -->
    <div class="gi-container gi-body">
      <p class="gi-last-updated">Cập nhật lần cuối: Tháng 4/2026</p>
      <!-- Sticky TOC sidebar -->
      <nav class="gi-toc" aria-label="Mục lục">
        <p class="gi-toc-title">Mục lục</p>
        <ol class="gi-toc-list">
          <li><a href="#tong-quan">Các cấp học</a></li>
          <li><a href="#mam-non">Mầm non</a></li>
          <li><a href="#tieu-hoc">Tiểu học</a></li>
          <li><a href="#thcs">THCS</a></li>
          <li><a href="#thpt">THPT</a></li>
          <li><a href="#loi-ich">Lợi ích liên cấp</a></li>
          <li><a href="#faq">Câu hỏi thường gặp</a></li>
        </ol>
        <a href="#cap-hoc-form-cap-hoc-pillar" class="gi-toc-cta">Đăng ký tham quan</a>
      </nav>

      <!-- Main content -->
      <article class="gi-main">

        <!-- Section 1: Tổng quan các cấp học -->
        <section id="tong-quan" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg></span>Trường Việt Anh có những cấp học nào?</h2>
          <p>Trường Việt Anh là hệ thống giáo dục <strong>liên cấp song ngữ</strong> duy nhất tại TP.HCM cung cấp lộ trình học tập xuyên suốt từ 2 đến 18 tuổi. Với 4 cấp học được thiết kế nối tiếp nhau, học sinh không bị gián đoạn khi chuyển cấp — mọi kiến thức, kỹ năng và nền tảng tiếng Anh đều được kế thừa liên tục.</p>
          <p>Phụ huynh chọn Trường Việt Anh không chỉ chọn một ngôi trường, mà chọn <strong>cả hành trình 16 năm</strong> phát triển toàn diện cho con. Mỗi cấp học được xây dựng dựa trên nền tảng của cấp trước — từ phương pháp giảng dạy, chương trình tiếng Anh đến kỹ năng lãnh đạo.</p>

          <img src="https://media.truongvietanh.com/images/giao-vien-10.webp" alt="Giáo viên giảng dạy tại Trường Việt Anh" loading="lazy" width="1200" height="auto" class="section-img" />

          <div class="gi-roadmap">
            <h3>4 cấp học tại Trường Việt Anh</h3>
            <div class="gi-roadmap-grid">
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">MN</div>
                <strong>Mầm non (2-6 tuổi)</strong>
                <p>Học qua vui chơi, phương pháp PDR, tiếng Anh Immersion 100% với giáo viên bản ngữ.</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">TH</div>
                <strong>Tiểu học (Lớp 1-5)</strong>
                <p>UK Oxford Curriculum, 50% thời lượng bằng tiếng Anh, rèn 16 kỹ năng WEF.</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">THCS</div>
                <strong>THCS (Lớp 6-9)</strong>
                <p>Academic English, mục tiêu IELTS B1-B2, chương trình Leader in Me.</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">THPT</div>
                <strong>THPT (Lớp 10-12)</strong>
                <p>Luyện thi IELTS chuyên sâu, đầu ra 6.0-8.0, hướng nghiệp và chuẩn bị du học.</p>
              </div>
            </div>
          </div>

          <div class="gi-evidence-bar">
            <div class="gi-evidence-item">
              <strong>4</strong>
              <span>Cấp học</span>
            </div>
            <div class="gi-evidence-item">
              <strong>2-18</strong>
              <span>Độ tuổi</span>
            </div>
            <div class="gi-evidence-item">
              <strong>5.000+</strong>
              <span>Học sinh</span>
            </div>
            <div class="gi-evidence-item">
              <strong>99%</strong>
              <span>Vào đại học</span>
            </div>
          </div>
        </section>

        <!-- Section 2: Mầm non -->
        <section id="mam-non" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></span>Chương trình Mầm non (2-6 tuổi)</h2>
          <p><strong>Trả lời ngắn:</strong> Chương trình Mầm non Trường Việt Anh dành cho trẻ 2-6 tuổi, áp dụng phương pháp PDR và tiếng Anh Immersion 100% với giáo viên bản ngữ. <a href="/mam-non">Xem chi tiết chương trình Mầm non</a>.</p>
          <p>Chương trình Mầm non tại Trường Việt Anh được xây dựng theo phương pháp <strong>PDR (Plan - Do - Review)</strong> — giúp trẻ hình thành tư duy có kế hoạch ngay từ nhỏ. Trẻ tự lên kế hoạch hoạt động, thực hiện và tự đánh giá kết quả dưới sự hướng dẫn của giáo viên.</p>
          <p>Điểm nổi bật nhất là chương trình <strong>tiếng Anh Immersion 100%</strong> — trẻ được tiếp xúc hoàn toàn bằng tiếng Anh qua vui chơi, hát, kể chuyện và tương tác với giáo viên bản ngữ. Phương pháp này giúp trẻ tiếp thu ngôn ngữ một cách tự nhiên, không gò ép, tạo nền tảng vững chắc cho các cấp học tiếp theo.</p>

          <div class="gi-level-highlight">
            <h3>Điểm nổi bật chương trình Mầm non</h3>
            <ul>
              <li><strong>Phương pháp PDR:</strong> Trẻ tự lập, có tư duy logic từ nhỏ</li>
              <li><strong>100% English Immersion:</strong> Giáo viên bản ngữ dạy toàn thời gian</li>
              <li><strong>Học qua chơi:</strong> Không gò bó, không áp lực bài tập về nhà</li>
              <li><strong>Bữa ăn dinh dưỡng:</strong> Thực đơn chuẩn Viện Dinh dưỡng Quốc gia</li>
              <li><strong>Lớp nhỏ 20-25 bé:</strong> Giáo viên quan tâm sát từng trẻ</li>
            </ul>
          </div>

          <div class="gi-level-cards">
            <a href="/mam-non" class="gi-level-link">Tìm hiểu chi tiết chương trình Mầm non &rarr;</a>
          </div>
        </section>

        <!-- Section 3: Tiểu học -->
        <section id="tieu-hoc" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></span>Chương trình Tiểu học (Lớp 1-5)</h2>
          <p><strong>Trả lời ngắn:</strong> Tiểu học Trường Việt Anh kết hợp chương trình Bộ GD&DT với UK Oxford, 50% thời lượng bằng tiếng Anh, tích hợp 16 kỹ năng WEF. <a href="/tieu-hoc">Xem chi tiết chương trình Tiểu học</a>.</p>
          <p>Chương trình Tiểu học tại Trường Việt Anh kết hợp <strong>chương trình Bộ GD&ĐT</strong> với <strong>UK Oxford Curriculum</strong> — đảm bảo học sinh đạt chuẩn kiến thức quốc gia đồng thời phát triển năng lực quốc tế. Khoảng 50% thời lượng học được giảng dạy bằng tiếng Anh, bao gồm Toán, Khoa học và các môn kỹ năng.</p>
          <p>Trường Việt Anh là một trong số ít trường tại Việt Nam tích hợp <strong>16 kỹ năng thế kỷ 21</strong> do Diễn đàn Kinh tế Thế giới (WEF) công bố vào chương trình chính khoá. Học sinh được rèn tư duy phản biện, sáng tạo, hợp tác và giải quyết vấn đề thông qua các dự án thực tế hàng tháng.</p>

          <div class="gi-level-highlight">
            <h3>Điểm nổi bật chương trình Tiểu học</h3>
            <ul>
              <li><strong>UK Oxford:</strong> Chương trình Toán và Khoa học quốc tế</li>
              <li><strong>50% thời lượng tiếng Anh:</strong> Academic Reading & Writing từ lớp 1</li>
              <li><strong>16 kỹ năng WEF:</strong> Tích hợp vào giảng dạy hàng ngày</li>
              <li><strong>STEAM Education:</strong> Coding, Robotics, dự án sáng tạo</li>
              <li><strong>Dự án thực tế:</strong> Học sinh thực hành kiến thức qua dự án mỗi tháng</li>
            </ul>
          </div>

          <div class="gi-level-cards">
            <a href="/tieu-hoc" class="gi-level-link">Tìm hiểu chi tiết chương trình Tiểu học &rarr;</a>
          </div>
        </section>

        <!-- Section 4: THCS -->
        <section id="thcs" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></span>Chương trình THCS (Lớp 6-9)</h2>
          <p><strong>Trả lời ngắn:</strong> THCS Trường Việt Anh tập trung phát triển kỹ năng lãnh đạo (Leader in Me), tiếng Anh học thuật mục tiêu IELTS B1-B2, và hướng nghiệp sớm từ lớp 8. <a href="/trung-hoc-co-so">Xem chi tiết chương trình THCS</a>.</p>
          <p>Giai đoạn THCS là bước ngoặt quan trọng — học sinh bắt đầu phát triển tư duy độc lập, hình thành bản sắc cá nhân và chuẩn bị cho giai đoạn THPT. Tại Trường Việt Anh, chương trình THCS được thiết kế để học sinh không chỉ giỏi kiến thức mà còn <strong>tự tin lãnh đạo</strong> và <strong>thành thạo tiếng Anh học thuật</strong>.</p>
          <p>Chương trình <strong>Leader in Me</strong> (bản quyền Franklin Covey) được triển khai mạnh mẽ ở cấp THCS — học sinh thực hành 7 thói quen lãnh đạo hiệu quả, tham gia quản lý lớp học, tổ chức sự kiện và dẫn dắt các dự án cộng đồng. Về tiếng Anh, mục tiêu đầu ra là <strong>IELTS B1-B2 (4.5-5.5)</strong> — đủ để học sinh đọc hiểu tài liệu quốc tế và giao tiếp tự tin.</p>

          <img src="https://media.truongvietanh.com/images/thuyet-trinh-03.webp" alt="Học sinh thuyết trình tại Trường Việt Anh" loading="lazy" width="1200" height="auto" class="section-img" />

          <div class="gi-level-highlight">
            <h3>Điểm nổi bật chương trình THCS</h3>
            <ul>
              <li><strong>Leader in Me:</strong> 7 thói quen lãnh đạo hiệu quả của Franklin Covey</li>
              <li><strong>IELTS B1-B2:</strong> Mục tiêu đầu ra tiếng Anh cuối lớp 9</li>
              <li><strong>Thuyết trình & phản biện:</strong> Rèn kỹ năng trình bày bằng cả hai ngôn ngữ</li>
              <li><strong>Trao đổi văn hoá quốc tế:</strong> Chương trình giao lưu với trường đối tác</li>
              <li><strong>Hướng nghiệp sớm:</strong> Khám phá sở trường và định hướng nghề nghiệp từ lớp 8</li>
            </ul>
          </div>

          <div class="gi-level-cards">
            <a href="/trung-hoc-co-so" class="gi-level-link">Tìm hiểu chi tiết chương trình THCS &rarr;</a>
          </div>
        </section>

        <!-- Section 5: THPT -->
        <section id="thpt" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></span>Chương trình THPT (Lớp 10-12)</h2>
          <p><strong>Trả lời ngắn:</strong> THPT Trường Việt Anh cam kết đầu ra IELTS 6.0-8.0, tỷ lệ 99% học sinh vào đại học, chương trình hướng nghiệp cá nhân hoá và hỗ trợ du học. <a href="/trung-hoc-pho-thong">Xem chi tiết chương trình THPT</a>.</p>
          <p>THPT tại Trường Việt Anh là giai đoạn <strong>chạy nước rút</strong> — mọi nền tảng từ 10 năm trước được tổng hợp lại, giúp học sinh sẵn sàng cho đại học trong nước hoặc du học. Trường cam kết đầu ra tối thiểu <strong>IELTS 6.0</strong>, với nhiều học sinh đạt 7.0-8.0 khi tốt nghiệp.</p>
          <p>Chương trình hướng nghiệp được cá nhân hoá cho từng học sinh — bao gồm tư vấn ngành nghề, hỗ trợ hồ sơ du học, chuẩn bị phỏng vấn học bổng, và kết nối với mạng lưới cựu học sinh đang học tại các trường đại học hàng đầu trong và ngoài nước. Kết quả: <strong>99% học sinh Việt Anh vào đại học</strong> ngay năm đầu tiên.</p>

          <div class="gi-level-highlight">
            <h3>Điểm nổi bật chương trình THPT</h3>
            <ul>
              <li><strong>IELTS 6.0-8.0:</strong> Cam kết đầu ra, luyện thi chuyên sâu với giáo viên bản ngữ</li>
              <li><strong>99% vào đại học:</strong> Trong nước và quốc tế ngay năm đầu tiên</li>
              <li><strong>Hướng nghiệp cá nhân:</strong> Tư vấn 1-1, hỗ trợ hồ sơ du học</li>
              <li><strong>Kỹ năng khởi nghiệp:</strong> Dự án kinh doanh thực tế, Digital Literacy</li>
              <li><strong>Mạng lưới cựu học sinh:</strong> Kết nối mentorship với alumni thành công</li>
            </ul>
          </div>

          <div class="gi-level-cards">
            <a href="/trung-hoc-pho-thong" class="gi-level-link">Tìm hiểu chi tiết chương trình THPT &rarr;</a>
          </div>
        </section>

        <!-- Section 6: Lợi ích liên cấp -->
        <section id="loi-ich" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg></span>Lợi ích của hệ thống liên cấp là gì?</h2>
          <p>Nhiều phụ huynh tại TP.HCM gặp tình trạng con phải chuyển trường liên tục — từ trường mầm non sang tiểu học khác, rồi THCS khác, THPT khác. Mỗi lần chuyển trường, con phải <strong>thích nghi lại từ đầu</strong>: bạn bè mới, giáo viên mới, phương pháp mới, chương trình tiếng Anh bị đứt gãy.</p>
          <p>Hệ thống liên cấp Trường Việt Anh giải quyết triệt để vấn đề này. Con học từ 2 tuổi đến 18 tuổi trong cùng một hệ thống — <strong>giáo viên nắm rõ lộ trình của từng em</strong>, chương trình tiếng Anh được xây dựng liên tục, và phụ huynh yên tâm không phải lo tìm trường mới mỗi 3-4 năm.</p>

          <img src="https://media.truongvietanh.com/images/du-an-02.webp" alt="Học sinh làm dự án nhóm tại Trường Việt Anh" loading="lazy" width="1200" height="auto" class="section-img" />

          <div class="gi-comparison-box">
            <h3>So sánh: Học nhiều trường vs Hệ thống liên cấp Việt Anh</h3>
            <div class="gi-table-responsive">
              <table class="gi-table">
                <thead>
                  <tr>
                    <th>Tiêu chí</th>
                    <th>Học nhiều trường</th>
                    <th>Liên cấp Việt Anh</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Chuyển cấp</td>
                    <td>Phải thi đầu vào lại, xin hồ sơ</td>
                    <td>Chuyển nội bộ, ưu tiên xét tuyển</td>
                  </tr>
                  <tr>
                    <td>Tiếng Anh</td>
                    <td>Mỗi trường dạy khác nhau, bị đứt gãy</td>
                    <td>Lộ trình liên tục từ Immersion đến IELTS</td>
                  </tr>
                  <tr>
                    <td>Hồ sơ học sinh</td>
                    <td>Mất dữ liệu, GV mới không biết con</td>
                    <td>Theo dõi xuyên suốt 16 năm</td>
                  </tr>
                  <tr>
                    <td>Thích nghi</td>
                    <td>Stress mỗi lần chuyển trường</td>
                    <td>Môi trường quen thuộc, bạn bè cũ</td>
                  </tr>
                  <tr>
                    <td>Phụ huynh</td>
                    <td>Lo tìm trường mới mỗi 3-4 năm</td>
                    <td>Yên tâm suốt 16 năm</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div class="gi-leader-grid">
            <div class="gi-leader-card">
              <h4>Lợi ích cho học sinh</h4>
              <ul>
                <li>Không bị gián đoạn khi chuyển cấp — bạn bè, giáo viên quen thuộc</li>
                <li>Tiếng Anh tiến bộ liên tục, không phải bắt đầu lại từ đầu</li>
                <li>Kỹ năng lãnh đạo được rèn luyện xuyên suốt với Leader in Me</li>
                <li>Giáo viên hiểu rõ điểm mạnh, điểm yếu của từng em qua nhiều năm</li>
                <li>Tự tin hơn nhờ môi trường ổn định và nhất quán</li>
              </ul>
            </div>
            <div class="gi-leader-card">
              <h4>Lợi ích cho phụ huynh</h4>
              <ul>
                <li>Không phải lo tìm trường mới mỗi lần con lên cấp</li>
                <li>Tiết kiệm thời gian và chi phí so với chuyển trường liên tục</li>
                <li>Theo dõi sự phát triển toàn diện của con qua hệ thống báo cáo liên tục</li>
                <li>Một đầu mối liên lạc — nhà trường luôn nắm rõ tình hình</li>
                <li>Ưu đãi học phí cho gia đình có con học lâu năm và anh chị em ruột</li>
              </ul>
            </div>
          </div>

          <p>Đây chính là lý do hơn <strong>70% phụ huynh Trường Việt Anh</strong> cho con học liên cấp từ Mầm non đến THPT — họ tin tưởng vào lộ trình dài hạn thay vì phải tìm kiếm giải pháp ngắn hạn mỗi vài năm.</p>
          <p>Quý phụ huynh quan tâm đến quy trình nhập học có thể tham khảo <a href="/tuyen-sinh"><strong>thông tin tuyển sinh</strong></a> hoặc đăng ký tham quan trường miễn phí ngay bên dưới.</p>
        </section>

        <!-- Section 7: FAQ -->
        <section id="faq" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></span>Câu hỏi thường gặp về các cấp học tại Trường Việt Anh</h2>
          <p>Tổng hợp những thắc mắc phổ biến nhất khi phụ huynh tìm hiểu về hệ thống cấp học Trường Việt Anh.</p>

          <div class="gi-faq-list">
            {cmsFaqs ? (
              cmsFaqs.map((faq, i) => (
                <details class="gi-faq-item" open={i === 0}>
                  <summary>{faq.question}</summary>
                  <div class="gi-faq-answer">
                    <p set:html={faq.answer} />
                  </div>
                </details>
              ))
            ) : (
              <>
            
            <details class="gi-faq-item" open>
              <summary>Trường Việt Anh có những cấp học nào?</summary>
              <div class="gi-faq-answer">
                <p>Trường Việt Anh đào tạo 4 cấp học liên tục: Mầm non (2-6 tuổi), Tiểu học (lớp 1-5), THCS (lớp 6-9) và THPT (lớp 10-12). Học sinh có thể theo học từ 2 tuổi đến 18 tuổi trong cùng hệ thống mà không bị gián đoạn.</p>
              </div>
            </details>
            <details class="gi-faq-item">
              <summary>Học sinh có thể chuyển cấp trong nội bộ Trường Việt Anh không?</summary>
              <div class="gi-faq-answer">
                <p>Có. Học sinh chuyển cấp nội bộ được ưu tiên xét tuyển, không cần thi đầu vào lại. Toàn bộ hồ sơ học tập, kế hoạch phát triển cá nhân và đánh giá năng lực tiếng Anh đều được chuyển giao liên tục giữa các cấp học.</p>
              </div>
            </details>
            <details class="gi-faq-item">
              <summary>Chương trình tiếng Anh có liên tục giữa các cấp không?</summary>
              <div class="gi-faq-answer">
                <p>Có. Lộ trình tiếng Anh được thiết kế xuyên suốt 4 cấp: Immersion (Mầm non) &rarr; UK Oxford (Tiểu học) &rarr; Academic English (THCS) &rarr; IELTS Prep (THPT). Nhờ đó, học sinh tiến bộ tự nhiên mà không bị lặp lại hoặc bỏ sót nội dung.</p>
              </div>
            </details>
            <details class="gi-faq-item">
              <summary>Học phí các cấp học tại Trường Việt Anh là bao nhiêu?</summary>
              <div class="gi-faq-answer">
                <p>Học phí dao động từ 5 đến 8 triệu đồng/tháng tuỳ cấp học và cơ sở, bao gồm ăn trưa, nước uống và các hoạt động ngoại khoá cơ bản. Gia đình có anh chị em ruột hoặc con học liên cấp sẽ được ưu đãi. <a href="/hoc-phi">Xem bảng học phí chi tiết</a>.</p>
              </div>
            </details>
            <details class="gi-faq-item">
              <summary>Trường Việt Anh nhận học sinh chuyển trường giữa chừng không?</summary>
              <div class="gi-faq-answer">
                <p>Có. Trường nhận học sinh chuyển trường ở tất cả các cấp học, bất kỳ thời điểm nào trong năm nếu còn chỗ. Học sinh mới sẽ được kiểm tra đầu vào tiếng Anh và học lực để xếp lớp phù hợp, đồng thời có chương trình hỗ trợ hoà nhập trong 4 tuần đầu.</p>
              </div>
            </details>
            <details class="gi-faq-item">
              <summary>Lợi ích của hệ thống liên cấp so với học nhiều trường là gì?</summary>
              <div class="gi-faq-answer">
                <p>Hệ thống liên cấp giúp học sinh không bị gián đoạn khi chuyển cấp: bạn bè quen, giáo viên nắm rõ lộ trình, tiếng Anh tiến bộ liên tục, và phụ huynh yên tâm không phải tìm trường mới mỗi 3-4 năm. Hơn 70% phụ huynh Việt Anh cho con học liên cấp từ Mầm non đến THPT.</p>
              </div>
            </details>
            <details class="gi-faq-item">
              <summary>Làm sao đăng ký tham quan trường để tìm hiểu các cấp học?</summary>
              <div class="gi-faq-answer">
                <p>Quý phụ huynh có thể đăng ký trực tuyến ngay tại trang này (form phía trên) hoặc gọi số <a href="tel:0916961409"><strong>0916 961 409</strong></a> để được sắp xếp lịch tham quan. Buổi tham quan hoàn toàn miễn phí, không ràng buộc — phụ huynh sẽ được tham quan cơ sở vật chất, gặp giáo viên và tìm hiểu chương trình chi tiết từng cấp.</p>
              </div>
            </details>
            <details class="gi-faq-item">
              <summary>Chương trình tiếng Anh khác nhau như thế nào giữa các cấp?</summary>
              <div class="gi-faq-answer">
                <p><strong>Mầm Non:</strong> 100% tiếng Anh immersion — trẻ học tiếng Anh như ngôn ngữ thứ hai tự nhiên. <strong>Tiểu Học:</strong> Song ngữ Việt-Anh, một số môn dạy bằng tiếng Anh theo giáo trình UK (Toán, Khoa học). <strong>THCS:</strong> Nâng cao giao tiếp + học thuật, chuẩn bị cho IELTS. <strong>THPT:</strong> Luyện thi IELTS chuyên sâu, đạt 6.0-8.0 trước khi tốt nghiệp. Lộ trình liên cấp giúp con tiến bộ liên tục mà không bị gián đoạn.</p>
              </div>
            </details>
            <details class="gi-faq-item">
              <summary>Sĩ số mỗi lớp là bao nhiêu?</summary>
              <div class="gi-faq-answer">
                <p><strong>Mầm Non:</strong> 15-20 trẻ/lớp (2 giáo viên + 1 trợ giảng). <strong>Tiểu Học:</strong> 24 học sinh/lớp. <strong>THCS:</strong> 24 học sinh/lớp. <strong>THPT:</strong> 24 học sinh/lớp. Tỷ lệ giáo viên/học sinh thấp đảm bảo mỗi em được quan tâm cá nhân, đặc biệt trong các hoạt động nhóm và dự án.</p>
              </div>
            </details>
              </>
            )}
          </div>
        </section>
      </article>
    </div>

