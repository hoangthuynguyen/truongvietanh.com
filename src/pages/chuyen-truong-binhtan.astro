---
import SqueezePageLayout from '../layouts/SqueezePageLayout.astro';
import USPGrid from '../components/USPGrid.astro';
import TrustMetrics from '../components/TrustMetrics.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import FAQSection from '../components/FAQSection.astro';

const pageTitle = "Chuyển Trường về Trường Việt Anh tại Bình Tân | Trường Việt Anh";
const pageDescription = "Thủ tục đơn giản — Hỗ trợ học bạ, kiểm tra đầu vào miễn phí. Đảm bảo con hòa nhập trong 2 tuần đầu.";
const pageCanonical = "https://truongvietanh.com/chuyen-truong-binhtan";

const uspItems = [
    {
      "icon": "📋",
      "text": "Hỗ trợ trọn gói thủ tục học bạ — phụ huynh không phải chạy nhiều nơi"
    },
    {
      "icon": "🎯",
      "text": "Test đầu vào miễn phí — đánh giá học lực, tiếng Anh, kỹ năng mềm"
    },
    {
      "icon": "🤝",
      "text": "Buddy program — bạn cùng lớp dẫn dắt 2 tuần đầu để con không bỡ ngỡ"
    },
    {
      "icon": "👨‍🏫",
      "text": "Giáo viên chủ nhiệm gặp riêng phụ huynh trước khi con nhập học"
    },
    {
      "icon": "💸",
      "text": "Học bổng chuyển trường giữa năm đến 30% học phí"
    },
    {
      "icon": "✅",
      "text": "Cam kết tiến bộ trong 1 học kỳ hoặc hoàn lại học phí"
    }
  ];

const metrics = [
  { number: '15+', label: 'Năm kinh nghiệm giáo dục song ngữ' },
  { number: '3,000+', label: 'Học sinh đã và đang theo học' },
  { number: '95%', label: 'Phụ huynh hài lòng & giới thiệu bạn bè' },
  { number: '9', label: 'Cơ sở tại TP.HCM, Long An, Kiên Giang' },
];

const faqItems = [
    {
      "question": "Con tôi đang học giữa năm có chuyển được không?",
      "answer": "Có. Trường Việt Anh nhận chuyển trường giữa năm cho cả 4 cấp học (Mầm Non / Tiểu Học / THCS / THPT). Quy trình hoàn tất trong 5–7 ngày làm việc kể từ khi nộp đủ hồ sơ."
    },
    {
      "question": "Cần chuẩn bị giấy tờ gì?",
      "answer": "Học bạ gốc (bản chính + photo công chứng), giấy giới thiệu của trường cũ, giấy khai sinh, sổ hộ khẩu/CCCD phụ huynh, 4 ảnh 3x4. Trường hỗ trợ phụ huynh nếu thiếu."
    },
    {
      "question": "Có học bổng cho học sinh chuyển trường không?",
      "answer": "Có. Học sinh chuyển trường giữa năm được xét học bổng đầu vào (10–30% học phí) dựa trên kết quả test + hồ sơ học tập trường cũ."
    },
    {
      "question": "Con tôi không biết tiếng Anh có theo kịp không?",
      "answer": "Trường có lớp Tiếng Anh dự bị (Bridge Class) cho học sinh mới nền tảng yếu. Sau 2–3 tháng học cường độ, con sẽ chuyển vào lớp chính khóa cùng các bạn."
    },
    {
      "question": "Sau khi chuyển có được rút lại nếu không phù hợp?",
      "answer": "Trong 30 ngày đầu, nếu phụ huynh thấy con không phù hợp, trường hoàn lại 100% học phí (đã trừ ngày con đã học). Cam kết bằng văn bản."
    }
  ];
---

<SqueezePageLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={pageCanonical}
  schoolLevel="tieu-hoc"
  funnelCode="chuyen-truong-binhtan"
>
  <section slot="hero">
    <h1 class="squeeze-hero__heading">Chuyển Trường về Trường Việt Anh tại Bình Tân</h1>
    <p class="squeeze-hero__subheading">Thủ tục đơn giản — Hỗ trợ học bạ, kiểm tra đầu vào miễn phí. Đảm bảo con hòa nhập trong 2 tuần đầu.</p>
  </section>

  <section slot="usp"><USPGrid title="Vì sao chọn Trường Việt Anh?" items={uspItems} /></section>
  <section slot="trust"><TrustMetrics title="Trường Việt Anh trong số liệu" metrics={metrics} /></section>

  <section slot="content">
    <div class="page-content">
      <h2>Chuyển trường về Việt Anh — An tâm, không gián đoạn việc học</h2>
      <p>Trường Việt Anh hiểu rằng <strong>quyết định chuyển trường giữa năm</strong> không hề đơn giản. Chúng tôi đã đồng hành với hàng trăm gia đình trong 15 năm qua, xây dựng quy trình chuyển trường <strong>đơn giản — minh bạch — hỗ trợ tối đa</strong>.</p>
        <p>Cơ sở Bình Tân: <strong>951/7 Tỉnh lộ 10, Bình Tân, TP.HCM</strong>. Vui lòng đăng ký để được tư vấn riêng về học phí, học bổng chuyển trường và lộ trình hòa nhập cho con.</p>
    </div>
  </section>

  <section slot="form">
    <h2 class="squeeze-form-section__heading">Đăng ký tư vấn chuyển trường</h2>
    <p class="squeeze-form-section__description">Đội tuyển sinh sẽ liên hệ trong 24h, hướng dẫn thủ tục và sắp xếp test đầu vào.</p>
    <LeadFormTwoStepEmailFirst
      formId="chuyen-truong-binhtan-form"
      funnelCode="chuyen-truong-binhtan"
      schoolLevel="tieu-hoc"
      submitText="Đăng ký tư vấn chuyển trường"
      successMessage="Cảm ơn! Đội tuyển sinh sẽ liên hệ trong 24h."
    />
  </section>

  <section slot="faq"><FAQSection title="Câu hỏi thường gặp" items={faqItems} /></section>
</SqueezePageLayout>

<style is:inline>
  .page-content { max-width: 800px; margin: 0 auto; padding: 1rem 0; }
  .page-content h2 { color: #1a1a5e; font-size: 1.6rem; margin-bottom: 1rem; text-align: center; }
  .page-content p { font-size: 1rem; line-height: 1.75; color: #333; margin-bottom: 1rem; }
  .page-content ul { margin: 1rem 0 1rem 1.5rem; }
  .page-content li { margin-bottom: .5rem; line-height: 1.7; }
  .page-content strong { color: #1a1a5e; font-weight: 700; }
</style>
