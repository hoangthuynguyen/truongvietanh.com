---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import TestimonialVideoGrid from '../components/TestimonialVideoGrid.astro';
import { videoTestimonials } from '../data/testimonials-video';
import { getTestimonials } from '../lib/directus';

// Fetch testimonials from Directus CMS
const cmsTestimonials = await getTestimonials();

// Fallback testimonials nếu CMS trống
const fallbackTestimonials = [
  {
    name: 'Chị Phạm Thuỳ Dung',
    role: 'Phụ huynh bé lớp 3 · Cơ sở Gò Vấp',
    quote: 'Tôi chọn Trường Việt Anh vì con được học tiếng Anh chuẩn mà học phí chỉ bằng 1/3 trường quốc tế. Sau 2 năm, bé đã tự tin nói chuyện với giáo viên nước ngoài. Gia đình rất hài lòng.',
    initials: 'PD',
    stars: 5,
  },
  {
    name: 'Anh Nguyễn Hoàng Minh',
    role: 'Phụ huynh bé lớp 7 · Cơ sở Bình Tân',
    quote: 'Điều tôi ấn tượng nhất là chương trình Leader in Me. Con trai tôi từ một đứa nhút nhát, giờ dám đứng lên thuyết trình trước cả trường. Sự thay đổi rõ rệt chỉ sau 1 học kỳ.',
    initials: 'HM',
    stars: 5,
  },
  {
    name: 'Chị Trần Thị Bích Ngọc',
    role: 'Phụ huynh có 2 con · Cơ sở Bình Chánh',
    quote: 'Nhà tôi có 2 con cùng học Việt Anh. Bé lớn lớp 9 vừa đạt IELTS 5.5, bé nhỏ lớp 4 đã đọc sách tiếng Anh trôi chảy. Được giảm học phí anh em ruột nữa, rất đáng đồng tiền.',
    initials: 'BN',
    stars: 5,
  },
  {
    name: 'Anh Lê Văn Thành',
    role: 'Phụ huynh bé lớp 5 · Cơ sở Tân Phú',
    quote: 'Con gái tôi vào Việt Anh từ Mầm non, giờ lớp 5. Bé không chỉ giỏi tiếng Anh mà còn tự giác, biết lập kế hoạch và có trách nhiệm. Tôi thấy đó mới là giá trị thực sự.',
    initials: 'LT',
    stars: 5,
  },
  {
    name: 'Chị Mai',
    role: 'Phụ huynh bé Phúc · Tiểu học lớp 3',
    quote: 'Những gì mà lúc đầu thầy cô tư vấn cho chị thì sau 2 năm, chị thấy là đều có trong chương trình học của con hết. Sự cam kết của trường rất rõ ràng.',
    initials: 'M',
    stars: 5,
  },
  {
    name: 'Anh Quốc Long',
    role: 'Phụ huynh có nhiều con theo học',
    quote: 'Bé có những sở thích như coi điện thoại hay chơi game nhưng bé tự mình điều tiết nó, không có quá sa đà vào nó. Con đã tự kỷ luật rõ rệt.',
    initials: 'QL',
    stars: 5,
  },
  {
    name: 'Chị Kim Trinh',
    role: 'Phụ huynh Tiểu học',
    quote: 'Cô giáo cũng đồng cảm, cũng chia sẻ và giúp cho mình làm sao để mình có thể gần con hơn. Tôi cảm nhận được sự quan tâm thật sự.',
    initials: 'KT',
    stars: 5,
  },
  {
    name: 'Chị Hoàng Diễm',
    role: 'Phụ huynh có 2 con theo học',
    quote: 'Trường Việt Anh luôn luôn cải tiến chương trình học và cập nhật kiến thức. Các con tôi được học những gì mới nhất và phù hợp với thời đại.',
    initials: 'HD',
    stars: 5,
  },
  {
    name: 'Em Gia Bảo',
    role: 'Học sinh lớp 11 · IELTS 7.0',
    quote: 'Nhờ có chương trình luyện IELTS tại trường, em không cần học thêm ở trung tâm nào mà vẫn đạt 7.0. Thầy cô tận tâm, bạn bè cùng quyết tâm luyện đề mỗi ngày.',
    initials: 'GB',
    stars: 5,
  },
];

const testimonials = cmsTestimonials.length > 0
  ? cmsTestimonials.map((t: any) => ({
      name: t.name,
      role: t.role,
      quote: t.quote,
      initials: t.initials || t.name?.split(' ').slice(-2).map((w: string) => w[0]).join('').toUpperCase() || 'VA',
      stars: 5,
    }))
  : fallbackTestimonials;

const totalReviews = testimonials.length + videoTestimonials.length;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'EducationalOrganization',
    name: 'Trường Liên Cấp Việt Anh',
    url: 'https://truongvietanh.com',
    logo: 'https://truongvietanh.com/logo-crest-80.webp',
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: '4.9',
      bestRating: '5',
      ratingCount: String(totalReviews),
    },
    review: [
      ...videoTestimonials.slice(0, 10).map(t => ({
        '@type': 'Review',
        author: { '@type': 'Person', name: t.name },
        reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
        reviewBody: t.longQuote,
      })),
      ...testimonials.slice(0, 10).map(t => ({
        '@type': 'Review',
        author: { '@type': 'Person', name: t.name },
        reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
        reviewBody: t.quote,
      })),
    ],
  },
  ...videoTestimonials.map(t => ({
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: t.shortQuote,
    description: t.longQuote,
    thumbnailUrl: `https://i.ytimg.com/vi/${t.videoId}/hqdefault.jpg`,
    uploadDate: '2025-01-01',
    contentUrl: `https://www.youtube.com/watch?v=${t.videoId}`,
    embedUrl: `https://www.youtube-nocookie.com/embed/${t.videoId}`,
    publisher: {
      '@type': 'Organization',
      name: 'Trường Liên Cấp Việt Anh',
      logo: { '@type': 'ImageObject', url: 'https://truongvietanh.com/logo-crest-80.webp' },
    },
  })),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: 'https://truongvietanh.com' },
      { '@type': 'ListItem', position: 2, name: 'Đánh giá phụ huynh', item: 'https://truongvietanh.com/danh-gia-cua-phu-huynh' },
    ],
  },
];
---

<BaseLayout
  title="Đánh giá từ phụ huynh & học sinh | Trường Việt Anh"
  description="Tổng hợp 30+ video chia sẻ thực tế từ phụ huynh và học sinh Trường Việt Anh — quay tại trường, không dàn dựng. Hơn 12.000 gia đình tin tưởng, đánh giá 4.9/5."
  canonical="https://truongvietanh.com/danh-gia-cua-phu-huynh"
  ogImage="https://media.truongvietanh.com/images/trang-chu-3.webp"
  structuredData={structuredData}
>
  <div class="dg-page">
    <HeaderBase />

    <!-- HERO -->
    <section class="dg-hero">
      <div class="dg-hero__deco" aria-hidden="true"></div>
      <div class="dg-container dg-hero__inner">
        <nav class="dg-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Trang chủ</a>
          <span aria-hidden="true">/</span>
          <span>Đánh giá phụ huynh</span>
        </nav>
        <span class="dg-eyebrow">★ Đánh giá thực tế từ cộng đồng phụ huynh</span>
        <h1 class="dg-h1">Phụ huynh & học sinh nói gì<br/>về <span class="dg-h1__hl">Trường Việt Anh</span>?</h1>
        <p class="dg-sub">Hơn <strong>12.000 gia đình</strong> đã gửi gắm niềm tin từ năm 2011. Dưới đây là những chia sẻ thực tế — quay tại trường, không dàn dựng.</p>

        <div class="dg-stats">
          <div class="dg-stat">
            <div class="dg-stat__num">12.000<span>+</span></div>
            <div class="dg-stat__label">Gia đình tin tưởng</div>
          </div>
          <div class="dg-stat">
            <div class="dg-stat__num"><span class="dg-stat__stars">★</span> 4.9<span>/5</span></div>
            <div class="dg-stat__label">Trên {totalReviews}+ đánh giá</div>
          </div>
          <div class="dg-stat">
            <div class="dg-stat__num">{videoTestimonials.length}<span>+</span></div>
            <div class="dg-stat__label">Video chia sẻ thực tế</div>
          </div>
        </div>
      </div>
    </section>

    <!-- VIDEO TESTIMONIALS -->
    <TestimonialVideoGrid />

    <!-- CTA -->
    <section class="dg-cta">
      <div class="dg-container dg-cta__inner">
        <div class="dg-cta__text">
          <div class="dg-cta__badge">Tư vấn miễn phí</div>
          <h2 class="dg-cta__h2">Để lại số điện thoại —<br/>chúng tôi gọi lại trong 30 phút</h2>
          <p class="dg-cta__desc">Chuyên viên tư vấn sẽ lắng nghe mục tiêu của con, giới thiệu chương trình phù hợp và giải đáp mọi thắc mắc của phụ huynh.</p>
          <ul class="dg-cta__perks">
            <li>Tư vấn 1-1, không đại trà</li>
            <li>Xem thực tế lớp học &amp; gặp giáo viên</li>
            <li>Nhận bảng học phí và ưu đãi hiện hành</li>
          </ul>
          <p class="dg-cta__hotline">Hotline: <a href="tel:0916961409">0916 961 409</a> · <a href="https://zalo.me/1678310120468101523" target="_blank" rel="noopener">Zalo OA</a></p>
        </div>
        <div class="dg-cta__form-wrap" data-form-bg="light">
          <LeadFormTwoStepEmailFirst
            formId="danh-gia-form"
            funnelCode="danh-gia-pillar"
            schoolLevel="lien-cap"
          />
        </div>
      </div>
    </section>

    <FooterBase />
  </div>
</BaseLayout>

<style is:global>
  .dg-page { background: #f7f9fc; }
  .dg-container { max-width: 1180px; margin: 0 auto; padding: 0 1.25rem; }

  /* ============ HERO (navy + yellow accents) ============ */
  .dg-hero {
    position: relative;
    padding: 3rem 0 4rem;
    background:
      radial-gradient(ellipse at top right, rgba(255, 255, 0, 0.12) 0%, transparent 55%),
      linear-gradient(135deg, #000080 0%, #000064 60%, #00004d 100%);
    color: #fff;
    overflow: hidden;
  }
  .dg-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.06) 1px, transparent 0);
    background-size: 24px 24px;
    pointer-events: none;
    mask-image: linear-gradient(180deg, rgba(0,0,0,0.6), transparent 80%);
  }
  .dg-hero__deco {
    position: absolute;
    right: -120px;
    top: -120px;
    width: 360px;
    height: 360px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 0, 0.18) 0%, transparent 70%);
    filter: blur(20px);
    pointer-events: none;
  }
  .dg-hero__inner { position: relative; z-index: 1; }

  .dg-breadcrumb { font-size: 0.85rem; color: rgba(255, 255, 255, 0.75); margin-bottom: 1rem; }
  .dg-breadcrumb a { color: #ffff00; text-decoration: none; font-weight: 600; }
  .dg-breadcrumb a:hover { text-decoration: underline; }
  .dg-breadcrumb span[aria-hidden] { margin: 0 0.4rem; opacity: 0.5; }

  .dg-eyebrow {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ffff00;
    background: rgba(255, 255, 0, 0.1);
    border: 1px solid rgba(255, 255, 0, 0.4);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  .dg-h1 {
    font-size: clamp(1.85rem, 4vw, 2.8rem);
    font-weight: 800;
    color: #fff;
    margin: 0 0 1rem;
    line-height: 1.18;
    letter-spacing: -0.02em;
  }
  .dg-h1__hl {
    color: #ffff00;
    position: relative;
    display: inline-block;
    white-space: nowrap;
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    letter-spacing: inherit;
  }
  .dg-h1__hl::after {
    content: '';
    position: absolute;
    left: 0; right: 0;
    bottom: -4px;
    height: 4px;
    background: #ffff00;
    border-radius: 2px;
    opacity: 0.6;
  }

  .dg-sub {
    font-size: clamp(1rem, 1.3vw, 1.1rem);
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.65;
    margin: 0 0 2rem;
    max-width: 720px;
  }
  .dg-sub strong { color: #ffff00; font-weight: 700; }

  /* HERO STATS */
  .dg-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    max-width: 760px;
  }
  .dg-stat {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 0, 0.25);
    border-radius: 14px;
    padding: 1.1rem 1.2rem;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: border-color 0.25s, transform 0.25s;
  }
  .dg-stat:hover { border-color: #ffff00; transform: translateY(-2px); }
  .dg-stat__num {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 800;
    color: #ffff00;
    line-height: 1;
    letter-spacing: -0.02em;
    font-family: "Montserrat", sans-serif;
  }
  .dg-stat__num span { font-size: 0.7em; opacity: 0.85; margin-left: 0.1em; }
  .dg-stat__stars { font-size: 0.85em; }
  .dg-stat__label {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 0.45rem;
    line-height: 1.4;
  }
  @media (max-width: 600px) {
    .dg-stats { grid-template-columns: 1fr; gap: 0.6rem; }
    .dg-stat { padding: 0.85rem 1rem; }
  }

  /* ============ CTA (navy + yellow) ============ */
  .dg-cta {
    background:
      radial-gradient(ellipse at bottom left, rgba(255, 255, 0, 0.1) 0%, transparent 55%),
      linear-gradient(135deg, #000080 0%, #00004d 100%);
    color: #fff;
    padding: 3.5rem 0;
    position: relative;
    overflow: hidden;
  }
  .dg-cta::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: linear-gradient(90deg, transparent, #ffff00, transparent);
  }
  .dg-cta__inner { display: grid; grid-template-columns: 1fr 420px; gap: 2.5rem; align-items: center; position: relative; z-index: 1; }
  .dg-cta__h2 { font-size: clamp(1.5rem, 2.6vw, 2rem); font-weight: 800; color: #fff; margin: 0 0 0.85rem; line-height: 1.25; letter-spacing: -0.015em; }
  .dg-cta__h2 br + * { color: #ffff00; }
  .dg-cta__desc { color: rgba(255, 255, 255, 0.88); font-size: 1rem; line-height: 1.65; margin: 0 0 1rem; }
  .dg-cta__hotline { margin: 0.5rem 0 0; font-size: 1.02rem; color: rgba(255, 255, 255, 0.92); }
  .dg-cta__hotline a { color: #ffff00; font-weight: 800; text-decoration: none; border-bottom: 1px dashed rgba(255,255,0,0.5); padding-bottom: 1px; }
  .dg-cta__hotline a:hover { border-bottom-style: solid; }
  @media (max-width: 900px) {
    .dg-cta__inner { grid-template-columns: 1fr; }
  }

  .dg-cta__badge {
    display: inline-block;
    background: #ffff00;
    color: #000080;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    margin-bottom: 1rem;
    box-shadow: 0 4px 14px rgba(255, 255, 0, 0.3);
  }
  .dg-cta__text { display: flex; flex-direction: column; }
  .dg-cta__perks {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .dg-cta__perks li {
    font-size: 0.98rem;
    color: rgba(255,255,255,0.92);
    line-height: 1.55;
    padding-left: 1.7rem;
    position: relative;
  }
  .dg-cta__perks li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0;
    width: 1.25rem;
    height: 1.25rem;
    background: #ffff00;
    color: #000080;
    border-radius: 50%;
    font-size: 0.75rem;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
  .dg-cta__form-wrap {
    background: #fff;
    border-radius: 18px;
    padding: 1.85rem 1.6rem;
    box-shadow: 0 18px 50px rgba(0,0,0,0.3);
    border-top: 4px solid #ffff00;
  }
</style>
