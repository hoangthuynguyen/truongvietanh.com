---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Giải Mã Tiềm Năng – Việt Anh",
    "url": "https://truongvietanh.com/giai-ma-tiem-nang",
    "description": "Giải Mã Tiềm Năng: giúp học sinh hiểu bản thân từ gốc — nhận diện điểm mạnh, cách vận hành, và xu hướng phát triển phù hợp.",
    "address": { "@type": "PostalAddress", "addressLocality": "Hồ Chí Minh", "addressCountry": "VN" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Con tôi chưa biết mình thích gì, có phù hợp không?", "acceptedAnswer": { "@type": "Answer", "text": "Đây chính là nhóm cần nhất. Chương trình giúp con hiểu mình trước khi chọn hướng đi." } },
      { "@type": "Question", "name": "Chương trình có giúp chọn ngành không?", "acceptedAnswer": { "@type": "Answer", "text": "Giúp con hiểu bản thân trước, từ đó chọn đúng ngành phù hợp với cách vận hành của mình." } },
      { "@type": "Question", "name": "Bao lâu thấy kết quả?", "acceptedAnswer": { "@type": "Answer", "text": "Sự rõ ràng trong suy nghĩ xuất hiện rất sớm sau quá trình đánh giá và làm việc cùng chuyên viên." } },
      { "@type": "Question", "name": "Có thay thế tư vấn hướng nghiệp không?", "acceptedAnswer": { "@type": "Answer", "text": "Không thay thế — đây là nền tảng để mọi tư vấn hướng nghiệp sau đó chính xác hơn." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://truongvietanh.com" },
      { "@type": "ListItem", "position": 2, "name": "Giải Mã Tiềm Năng", "item": "https://truongvietanh.com/giai-ma-tiem-nang" }
    ]
  }
];
---

<BaseLayout
  title="Giải Mã Tiềm Năng – Giúp Con Hiểu Chính Mình Từ Gốc"
  description="Con không thiếu tiềm năng — chỉ thiếu người giúp con nhìn thấy. Đánh giá khoa học giúp học sinh hiểu cách mình suy nghĩ, học tập và ra quyết định."
  canonical="https://truongvietanh.com/giai-ma-tiem-nang"
  ogImage="https://media.truongvietanh.com/images/thuyet-trinh-09.webp"
  structuredData={structuredData}
>
  <div class="pp-page">
    <HeaderBase />

    <!-- BLOCK 1: HERO -->
    <section class="pp-hero">
      <div class="pp-hero-inner">
        <h1 class="pp-h1">
          Bạn có chắc mình hiểu con?
          <span class="pp-h1-accent">Con học không tệ… nhưng không có động lực. Con học nhiều… nhưng không biết mình thích gì.</span>
        </h1>
        <p class="pp-subtitle">
          Nếu bạn thấy con mình ở đâu đó trong những điều này — vấn đề có thể không nằm ở việc con học chưa đủ. Mà là con chưa hiểu chính mình.
        </p>
        <div class="pp-cta-row">
          <a href="#pp-form" class="pp-btn pp-btn-gold">Nhận khảo sát MIỄN PHÍ →</a>
          <a href="https://zalo.me/truongvietanh" class="pp-btn pp-btn-outline">Chat 1-1 với chúng tôi →</a>
        </div>
      </div>
    </section>

    <!-- BLOCK 2: RICH TEXT -->
    <section class="pp-richtext">
      <div class="pp-richtext-inner">
        <h2>Học sinh nào cũng có năng lực đặc biệt riêng<br/>nhưng hầu hết không hiểu đúng về bản thân</h2>
        <p>Một sự thật ít được nói: rất nhiều học sinh hiện nay đang <strong>"đi theo lối mòn của người khác… mà không biết vì sao"</strong>.</p>
        <p>Các em:</p>
        <ul class="pp-bullet">
          <li>Học theo định hướng của gia đình</li>
          <li>Chọn theo số đông</li>
          <li>Làm tốt… nhưng không có cảm giác thuộc về</li>
          <li>Thành công… nhưng cảm thấy mệt mỏi và trống rỗng</li>
        </ul>
        <div class="pp-callout">Và rồi: mất động lực · mất phương hướng · hoặc chọn sai con đường</div>
        <p>Điều đáng tiếc nhất không phải là con không giỏi. Mà là: <strong>con có tiềm năng… nhưng không biết cách sử dụng nó.</strong></p>
      </div>
    </section>

    <!-- BLOCK 3: FEATURES -->
    <section class="pp-features">
      <div class="pp-features-inner">
        <h2>Giải mã tiềm năng không phải là "tư vấn nghề"<br/>mà là giúp con hiểu mình từ gốc</h2>
        <div class="pp-feat-grid">
          <div class="pp-feat-card">
            <span class="pp-icon">🧠</span>
            <strong>Đánh giá tiềm năng cá nhân</strong>
            <p>Hiểu cách con suy nghĩ, học tập và ra quyết định</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">🎯</span>
            <strong>Nhận diện điểm mạnh – điểm yếu</strong>
            <p>Không dựa trên điểm số, mà dựa trên bản chất</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">🧭</span>
            <strong>Làm rõ xu hướng phát triển</strong>
            <p>Con phù hợp với môi trường và con đường nào</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">🔍</span>
            <strong>Hiểu cách con vận hành</strong>
            <p>Vì sao con dễ chán, dễ bỏ cuộc hoặc mất động lực</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">🚀</span>
            <strong>Xây nền tảng định hướng</strong>
            <p>Không đưa ra quyết định, mà hiểu cách đưa quyết định đúng</p>
          </div>
        </div>
      </div>
    </section>

    <!-- BLOCK 4: TEXT WITH IMAGE -->
    <section class="pp-textimg">
      <div class="pp-textimg-inner">
        <div class="pp-textimg-text">
          <h2>Con không thiếu tiềm năng<br/>chỉ thiếu người giúp con nhìn thấy</h2>
          <p>Phần lớn trẻ không biết mình mạnh ở đâu, không hiểu vì sao mình thích hoặc không thích điều gì.</p>
          <p>Và phụ huynh: muốn giúp con — nhưng không có công cụ để hiểu con sâu hơn.</p>
          <div class="pp-callout">Kết quả: cả hai cùng "đoán" — và hy vọng chọn đúng</div>
          <p>Tại Việt Anh, <strong>chúng tôi không đoán</strong>. Chúng tôi dùng khoa học để giúp học sinh nhìn rõ bản thân, hiểu cách mình vận hành, và nhận ra con đường phù hợp.</p>
        </div>
        <div class="pp-textimg-img">
          <img src="https://media.truongvietanh.com/images/thuyet-trinh-09.webp" alt="Học sinh Việt Anh hiểu bản thân qua đánh giá khoa học" loading="lazy" width="600" height="400" />
        </div>
      </div>
    </section>

    <!-- BLOCK 5: STATS -->
    <section class="pp-stats">
      <div class="pp-stats-inner">
        <h2>Hậu quả của việc không hiểu bản thân</h2>
        <div class="pp-stats-cols">
          <div class="pp-stats-col pp-stats-warn">
            <h3>Khi không hiểu bản thân…</h3>
            <ul>
              <li>50% sinh viên đổi ngành sau năm 1–2</li>
              <li>Học sinh chọn ngành theo cảm tính</li>
              <li>Nhiều người đi làm nhưng không phù hợp</li>
            </ul>
          </div>
          <div class="pp-stats-col">
            <h3>Khi hiểu bản thân sớm…</h3>
            <ul>
              <li>Học tập có mục tiêu</li>
              <li>Quyết định chính xác hơn</li>
              <li>Ít sai lầm hơn — đi nhanh hơn</li>
            </ul>
          </div>
        </div>
        <p class="pp-stats-note">Không phải vì họ thiếu năng lực — mà vì họ chưa bao giờ được hiểu đúng về chính mình.</p>
      </div>
    </section>

    <!-- BLOCK 6: PRICING (Decision framing) -->
    <section class="pp-pricing">
      <div class="pp-pricing-inner">
        <h2>Đây không phải là một khoá học<br/>mà là một quyết định quan trọng</h2>
        <div class="pp-pricing-cols">
          <div class="pp-pricing-col pp-pricing-bad">
            <span class="pp-pricing-tag">Lựa chọn 1</span>
            <p>Để con <strong>tự tìm hiểu bản thân qua thử sai</strong> — mất 3–5 năm đi sai đường rồi mới biết mình là ai.</p>
          </div>
          <div class="pp-pricing-col pp-pricing-good">
            <span class="pp-pricing-tag">Lựa chọn 2</span>
            <p>Giúp con <strong>hiểu mình sớm hơn, chọn đúng hơn, và đi nhanh hơn</strong> — có nền tảng vững để ra quyết định.</p>
          </div>
        </div>
        <div class="pp-pricing-summary">
          <p>Giá trị không nằm ở chi phí. Mà nằm ở: <strong>việc con có phải trả giá bằng 3–5 năm sai đường hay không</strong>.</p>
        </div>
      </div>
    </section>

    <!-- BLOCK 7: CTA -->
    <section class="pp-ctablock">
      <div class="pp-ctablock-inner">
        <h2>Đừng đợi đến khi con chọn sai<br/>mới bắt đầu hiểu con</h2>
        <p>Bạn không cần quyết định ngay. Nhưng bạn nên bắt đầu bằng việc <strong>hiểu con đúng cách</strong>.</p>
        <div class="pp-cta-row">
          <a href="#pp-form" class="pp-btn pp-btn-gold">Nhận khảo sát MIỄN PHÍ →</a>
          <a href="https://zalo.me/truongvietanh" class="pp-btn pp-btn-outline-dark">Chat 1-1 với chúng tôi →</a>
        </div>
      </div>
    </section>

    <!-- BLOCK 8: FORM -->
    <section class="pp-form-block" id="pp-form">
      <div class="pp-form-block-inner">
        <h2>Nhận tư vấn cho con</h2>
        <p>Để lại thông tin — chúng tôi sẽ liên hệ lại trong vòng 24 giờ.</p>
        <ul>
          <li>Đánh giá sơ bộ tiềm năng của con</li>
          <li>Gợi ý định hướng phát triển phù hợp</li>
          <li>Tư vấn cá nhân hoá 1-1 với chuyên viên</li>
        </ul>
        <LeadFormTwoStepEmailFirst
          formId="giai-ma-tiem-nang-form"
          funnelCode="giai-ma-tiem-nang"
          schoolLevel="thpt"
        />
      </div>
    </section>

    <!-- BLOCK 9: FAQ -->
    <section class="pp-faq">
      <div class="pp-faq-inner">
        <h2>Câu hỏi phụ huynh thường gặp</h2>
        <div class="pp-faq-item">
          <p class="pp-faq-q">Con tôi chưa biết mình thích gì, có phù hợp không?</p>
          <p class="pp-faq-a">Đây chính là nhóm cần nhất. Khi con chưa rõ mình thích gì, đó không phải là "con có vấn đề" — mà là con chưa có công cụ để nhìn vào bên trong. Chương trình sẽ giúp con bắt đầu từ đó.</p>
        </div>
        <div class="pp-faq-item">
          <p class="pp-faq-q">Chương trình có giúp chọn ngành không?</p>
          <p class="pp-faq-a">Giúp con hiểu bản thân trước — từ đó chọn đúng ngành phù hợp với cách con vận hành, thay vì chọn theo số đông hay cảm tính.</p>
        </div>
        <div class="pp-faq-item">
          <p class="pp-faq-q">Bao lâu thấy kết quả?</p>
          <p class="pp-faq-a">Sự rõ ràng trong suy nghĩ thường xuất hiện rất sớm — ngay sau quá trình đánh giá và làm việc cùng chuyên viên, con đã có góc nhìn mới về chính mình.</p>
        </div>
        <div class="pp-faq-item">
          <p class="pp-faq-q">Có thay thế tư vấn hướng nghiệp không?</p>
          <p class="pp-faq-a">Không thay thế. Đây là <strong>nền tảng</strong> để mọi tư vấn hướng nghiệp sau đó chính xác hơn — vì bất kỳ lời khuyên nào cũng cần bắt đầu từ việc hiểu con là ai.</p>
        </div>
      </div>
    </section>

    <FooterBase />
  </div>

  <style>*, *::before, *::after{ box-sizing: border-box; }.pp-page{ font-family: 'Be Vietnam Pro', 'Segoe UI', system-ui, -apple-system, sans-serif; color: #1a1a2e; line-height: 1.6; }/* HERO */
    .pp-hero{ background: linear-gradient(135deg, #0d2b55 0%, #000080 100%); color: white; padding: 5rem 1.5rem; text-align: center; }.pp-hero-inner{ max-width: 820px; margin: 0 auto; }.pp-h1{ font-size: 2.4rem; font-weight: 800; line-height: 1.3; margin-bottom: 1.25rem; color: #f5a623; }.pp-h1-accent{ color: #fff; display: block; margin-top: .75rem; font-size: 1rem; font-weight: 600; line-height: 1.5; }.pp-subtitle{ font-size: 1.1rem; opacity: .9; margin-bottom: 2.5rem; line-height: 1.75; }.pp-cta-row{ display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }.pp-btn{ display: inline-block; padding: .9rem 2rem; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 1rem; transition: opacity .2s, transform .15s; }.pp-btn:hover{ opacity: .9; transform: translateY(-1px); }.pp-btn-gold{ background: #f07d00; color: #fff; }.pp-btn-outline{ background: transparent; color: white; border: 2px solid rgba(255,255,255,.7); }.pp-btn-outline-dark{ background: transparent; color: #0d2b55; border: 2px solid #0d2b55; }/* RICH TEXT */
    .pp-richtext{ background: #fff; padding: 4.5rem 1.5rem; }.pp-richtext-inner{ max-width: 820px; margin: 0 auto; }.pp-richtext h2{ font-size: 1.5rem; font-weight: 800; color: #D4B637; text-transform: uppercase; margin-bottom: 1.5rem; line-height: 1.4; text-align: center; }.pp-richtext p{ font-size: 1.05rem; color: #334155; line-height: 1.8; margin-bottom: 1rem; }.pp-bullet{ list-style: none; padding: 0; margin: 1rem 0 1.25rem; }.pp-bullet li{ padding: .4rem 0 .4rem 1.75rem; position: relative; color: #334155; font-size: 1.02rem; line-height: 1.7; }.pp-bullet li::before{ content: '→'; position: absolute; left: 0; color: #f07d00; font-weight: 700; }.pp-callout{ color: #0d2b55; font-weight: 700; font-size: 1.05rem; padding: .75rem 1.1rem; border-left: 4px solid #f07d00; margin: 1.25rem 0; background: #fff7ed; border-radius: 0 6px 6px 0; }/* FEATURES */
    .pp-features{ background: #0d2b55; color: white; padding: 4.5rem 1.5rem; }.pp-features-inner{ max-width: 1050px; margin: 0 auto; }.pp-features h2{ font-size: 1.5rem; font-weight: 800; text-align: center; text-transform: uppercase; margin-bottom: 2.5rem; line-height: 1.45; color: #f5a623; }.pp-feat-grid{ display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }.pp-feat-card{ background: rgba(255,255,255,.08); border-radius: 12px; padding: 1.75rem 1.5rem; border: 1px solid rgba(255,255,255,.12); }.pp-feat-card .pp-icon{ font-size: 2rem; display: block; margin-bottom: .75rem; }.pp-feat-card strong{ display: block; font-size: 1.05rem; margin-bottom: .5rem; }.pp-feat-card p{ font-size: 1rem; opacity: .85; line-height: 1.65; margin: 0; }/* TEXT WITH IMAGE */
    .pp-textimg{ background: white; padding: 4.5rem 1.5rem; }.pp-textimg-inner{ max-width: 1050px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 3.5rem; align-items: center; }.pp-textimg-text h2{ font-size: 1.5rem; font-weight: 800; color: #D4B637; text-transform: uppercase; margin-bottom: 1.25rem; line-height: 1.4; }.pp-textimg-text p{ color: #334155; line-height: 1.8; margin-bottom: .9rem; font-size: 1.02rem; }.pp-textimg-img img{ width: 100%; border-radius: 16px; box-shadow: 0 8px 30px rgba(0,0,0,.12); display: block; }/* STATS */
    .pp-stats{ background: #f0f4f8; padding: 4.5rem 1.5rem; border-top: 3px solid #e2e8f0; }.pp-stats-inner{ max-width: 900px; margin: 0 auto; }.pp-stats-inner > h2{ font-size: 1.5rem; font-weight: 800; color: #D4B637; text-transform: uppercase; text-align: center; margin-bottom: 2rem; }.pp-stats-cols{ display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }.pp-stats-col{ background: white; border-radius: 12px; padding: 1.75rem; box-shadow: 0 2px 10px rgba(0,0,0,.05); border-top: 4px solid #22c55e; }.pp-stats-col.pp-stats-warn{ border-top-color: #ef4444; }.pp-stats-col h3{ font-size: 1.5rem; font-weight: 700; color: #0d2b55; margin-bottom: 1rem; padding-bottom: .5rem; border-bottom: 1px solid #e2e8f0; }.pp-stats-col ul{ list-style: none; padding: 0; margin: 0; }.pp-stats-col li{ padding: .45rem 0 .45rem 1.75rem; position: relative; color: #475569; font-size: 1rem; line-height: 1.55; }.pp-stats-col li::before{ content: '✓'; position: absolute; left: 0; color: #22c55e; font-weight: 700; }.pp-stats-col.pp-stats-warn li::before{ content: '✕'; color: #ef4444; }.pp-stats-note{ text-align: center; margin-top: 1.75rem; color: #475569; font-size: 1rem; line-height: 1.7; font-style: italic; }/* PRICING */
