const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: 'https://truongvietanh.com' },
    { '@type': 'ListItem', position: 2, name: 'Giới thiệu', item: 'https://truongvietanh.com/gioi-thieu' },
    { '@type': 'ListItem', position: 3, name: 'Giáo viên', item: 'https://truongvietanh.com/giao-vien' },
  ],
};

function initials(name: string): string {
  const parts = name.replace(/^(Cô|Thầy|Mr\.|Ms\.|Mrs\.)\s*/i, '').split(/\s+/);
  return parts.slice(-2).map(p => p[0]).join('').toUpperCase();
}
---

<BaseLayout
  title="Đội ngũ giáo viên – Trường Việt Anh"
  description="Giáo viên Trường Việt Anh: GV Chủ nhiệm, GV Bộ môn (Toán, Văn, Anh bản ngữ, STEAM, Thể dục, Mỹ thuật), Đội ngũ tư vấn. Đội ngũ 500+ cán bộ giàu kinh nghiệm."
  canonical="https://truongvietanh.com/giao-vien"
  ogImage="https://media.truongvietanh.com/images/thuyet-trinh-09.webp"
  structuredData={structuredData}
>
  <div class="gv-page">
    <HeaderBase />

    <!-- HERO -->
    <section class="gv-hero">
      <div class="gv-container">
        <nav class="gv-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Trang chủ</a>
          <span aria-hidden="true">/</span>
          <a href="/gioi-thieu">Giới thiệu</a>
          <span aria-hidden="true">/</span>
          <span>Giáo viên</span>
        </nav>
        <h1 class="gv-h1">Đội ngũ giáo viên & tư vấn</h1>
        <p class="gv-sub">Đội ngũ giáo viên giàu kinh nghiệm, trong đó có giáo viên bản ngữ và thạc sĩ chuyên ngành — đồng hành cùng con suốt hành trình học tập.</p>
        <div class="gv-stats">
          <div class="gv-stat"><strong>{schoolFacts.yearsRunning}</strong><span>Năm kinh nghiệm</span></div>
          <div class="gv-stat"><strong>{schoolFacts.campuses}</strong><span>Cơ sở</span></div>
        </div>
      </div>
    </section>

    <!-- TABS -->
    <section class="gv-tabs-section">
      <div class="gv-tabs-bar">
        <div class="gv-container">
          <div class="gv-tabs" role="tablist" aria-label="Danh mục giáo viên">
            {tabs.map((tab, idx) => (
              <button
                class={`gv-tab ${idx === 0 ? 'is-active' : ''}`}
                role="tab"
                aria-selected={idx === 0 ? 'true' : 'false'}
                aria-controls={`panel-${tab.id}`}
                id={`tab-${tab.id}`}
                data-tab={tab.id}
                type="button"
              >
                <span class="gv-tab__icon">{tab.icon}</span>
                <span class="gv-tab__label">{tab.label}</span>
              </button>
            ))}
          </div>
        </div>
      </div>

      <div class="gv-container gv-panels-wrap">

        <!-- Panel 1: Chủ nhiệm -->
        <div class="gv-panel is-active" id="panel-chu-nhiem" role="tabpanel" aria-labelledby="tab-chu-nhiem">
          <p class="gv-panel__intro">Giáo viên chủ nhiệm trực tiếp đồng hành cùng lớp — chịu trách nhiệm về kỷ luật, liên lạc phụ huynh và kế hoạch học tập từng học sinh. Tỷ lệ <strong>1 GVCN / 15–18 học sinh</strong>.</p>
          <div class="gv-grid">
            {teachersCN.map(t => (
              <article class="gv-card">
                <div class="gv-card__photo">
                  {t.photo
                    ? <img src={t.photo} alt={`Ảnh ${t.name}`} loading="lazy" width="72" height="72" />
                    : <span class="gv-card__initials">{initials(t.name)}</span>
                  }
                </div>
                <div class="gv-card__body">
                  <h3 class="gv-card__name">{t.name}</h3>
                  <p class="gv-card__role">{t.role}</p>
                </div>
              </article>
            ))}
          </div>
        </div>

        <!-- Panel 2: Bộ môn -->
        <div class="gv-panel" id="panel-bo-mon" role="tabpanel" aria-labelledby="tab-bo-mon" hidden>
          <p class="gv-panel__intro">Giáo viên bộ môn chuyên sâu từng môn học — Toán, Văn, Tiếng Anh, Lý, Hoá, Sinh, Sử, Địa, Tin học, Âm nhạc, Thể dục, Mỹ thuật, STEAM.</p>
          <div class="gv-grid">
            {teachersBM.map(t => (
              <article class="gv-card">
                <div class="gv-card__photo">
                  {t.photo
                    ? <img src={t.photo} alt={`Ảnh ${t.name}`} loading="lazy" width="72" height="72" />
                    : <span class="gv-card__initials">{initials(t.name)}</span>
                  }
                </div>
                <div class="gv-card__body">
                  <h3 class="gv-card__name">{t.name}</h3>
                  <p class="gv-card__role">{t.role}</p>
                </div>
              </article>
            ))}
          </div>
        </div>

        <!-- Panel 3: Bản ngữ -->
        <div class="gv-panel" id="panel-ban-ngu" role="tabpanel" aria-labelledby="tab-ban-ngu" hidden>
          <p class="gv-panel__intro">Đội ngũ giáo viên bản ngữ người Anh, Mỹ, Úc, Canada đang giảng dạy trực tiếp tại các cơ sở Trường Việt Anh. <strong>100% có chứng chỉ CELTA / TEFL</strong> quốc tế.</p>
          <div class="gv-grid">
            {teachersBN.map(t => (
              <article class="gv-card">
                <div class="gv-card__photo">
                  {t.photo
                    ? <img src={t.photo} alt={`Ảnh ${t.name}`} loading="lazy" width="72" height="72" />
                    : <span class="gv-card__initials gv-card__initials--intl">{t.name.split(' ').slice(0,2).map((p:string)=>p[0]).join('')}</span>
                  }
                </div>
                <div class="gv-card__body">
                  <h3 class="gv-card__name">{t.name}</h3>
                  <p class="gv-card__role">{t.role}</p>
                </div>
              </article>
            ))}
          </div>
        </div>

        <!-- Panel 4: Tư vấn -->
        <div class="gv-panel" id="panel-tu-van" role="tabpanel" aria-labelledby="tab-tu-van" hidden>
          <p class="gv-panel__intro">Đội ngũ tư vấn tuyển sinh và giáo viên tư vấn học tập — hỗ trợ phụ huynh tìm hiểu về chương trình, lộ trình học và đăng ký nhập học tại tất cả cơ sở.</p>
          <div class="gv-grid gv-grid--tv">
            {tuVan.map(t => (
              <article class="gv-tvcard">
                <div class="gv-tvcard__photo">
                  {t.photo
                    ? <img src={t.photo} alt={`Ảnh ${t.name}`} loading="lazy" width="600" height="800" />
                    : <span class="gv-card__initials">{initials(t.name)}</span>
                  }
                </div>
                <div class="gv-tvcard__body">
                  <h3 class="gv-tvcard__name">{t.name}</h3>
                  <p class="gv-tvcard__role">{t.role}</p>
                  {t.mission && (
                    <div class="gv-tvcard__text">
                      <p class="gv-tvcard__quote">“{t.mission}”</p>
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>

      </div>
    </section>

    <!-- CTA -->
    <section class="gv-cta">
      <div class="gv-container gv-cta__inner">
        <h2 class="gv-cta__h2">Muốn gặp trực tiếp giáo viên phụ trách con?</h2>
        <p class="gv-cta__desc">Đăng ký tham quan trường để gặp ban giám hiệu, GVCN dự kiến và đội ngũ tư vấn. Buổi tham quan miễn phí, kéo dài 60–90 phút.</p>
        <div class="gv-cta__actions">
          <a href="/lien-he" class="gv-btn gv-btn--primary">Đặt lịch tham quan</a>
          <a href="tel:0916961409" class="gv-btn gv-btn--ghost">Gọi 0916 961 409</a>
        </div>
      </div>
    </section>

    <FooterBase />
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    const tabs = document.querySelectorAll('.gv-tab');
    const panels = document.querySelectorAll('.gv-panel');

    function ids() {
      return Array.prototype.map.call(tabs, function (t) { return t.getAttribute('data-tab'); });
    }

    // Bat mot tab theo id (vd "tu-van"). tuCuon = true khi mo bang link co hash.
    function activate(target, tuCuon) {
      let found = null;
      tabs.forEach(function (t) {
        const on = t.getAttribute('data-tab') === target;
        if (on) found = t;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      if (!found) return false;
      panels.forEach(function (p) {
        const match = p.id === 'panel-' + target;
        p.classList.toggle('is-active', match);
        if (match) p.removeAttribute('hidden');
        else p.setAttribute('hidden', '');
      });
      if (tuCuon) {
        const wrap = document.querySelector('.gv-tabs-section') || found;
        wrap.scrollIntoView({ block: 'start' });
        // Thanh tab truot ngang tren dien thoai: keo tab dang chon vao tam nhin,
        // block:'nearest' de khong pha vi tri cuon doc vua dat o tren
        found.scrollIntoView({ block: 'nearest', inline: 'center' });
      } else {
        found.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      }
      return true;
    }

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        const target = tab.getAttribute('data-tab');
        activate(target, false);
        // Ghi vao URL de copy link duoc; replaceState nen nut Back khong bi ket trong cac tab
        if (window.history && window.history.replaceState) {
          window.history.replaceState(null, '', '#' + target);
        }
      });
    });

    // Mo dung tab khi vao bang /giao-vien#tu-van
    function tuHash(tuCuon) {
      const h = (window.location.hash || '').replace('#', '');
      if (h && ids().indexOf(h) !== -1) return activate(h, tuCuon);
      return false;
    }
    tuHash(true);
    window.addEventListener('hashchange', function () { tuHash(true); });

    // Rut gon tuyen ngon dai o the Tu van; chi gan nut khi that su bi tran
    document.querySelectorAll('.gv-tvcard__text').forEach(function (el) {
      el.classList.add('is-clamped');
      // Duoi ~1,5 dong thi hien du luon, khoi gan nut vo nghia
      if (el.scrollHeight - el.clientHeight < 34) {
        el.classList.remove('is-clamped');
        return;
      }
      var nut = document.createElement('button');
      nut.type = 'button';
      nut.className = 'gv-tvcard__more';
      nut.textContent = 'Xem thêm';
      nut.setAttribute('aria-expanded', 'false');
      nut.addEventListener('click', function () {
        var dangCat = el.classList.toggle('is-clamped');
        nut.textContent = dangCat ? 'Xem thêm' : 'Thu gọn';
        nut.setAttribute('aria-expanded', dangCat ? 'false' : 'true');
      });
      el.parentNode.appendChild(nut);
    });
  })();
</script>

