---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';

const tabs = [
  { id: 'chu-nhiem', label: 'Giáo viên Chủ Nhiệm', icon: '👩‍🏫' },
  { id: 'bo-mon', label: 'Giáo viên Bộ Môn', icon: '📚' },
  { id: 'noi-tru', label: 'Quản nhiệm nội trú', icon: '🏠' },
];

// Danh sách giáo viên chủ nhiệm (sample — CMS-driven in production)
const teachersCN = [
  { name: 'Cô Nguyễn Thị Lan', role: 'GVCN Lớp 1A · Tiểu học Gò Vấp', exp: '12 năm kinh nghiệm', photo: '' },
  { name: 'Cô Trần Thu Hương', role: 'GVCN Lớp 3C · Tiểu học Phú Nhuận', exp: '9 năm kinh nghiệm', photo: '' },
  { name: 'Thầy Lê Minh Tuấn', role: 'GVCN Lớp 6B · THCS Bình Tân', exp: '15 năm kinh nghiệm', photo: '' },
  { name: 'Cô Phạm Ngọc Anh', role: 'GVCN Lớp 8A · THCS Gò Vấp', exp: '11 năm kinh nghiệm', photo: '' },
  { name: 'Thầy Hoàng Văn Khoa', role: 'GVCN Lớp 10A · THPT Bình Tân', exp: '18 năm kinh nghiệm', photo: '' },
  { name: 'Cô Đinh Thị Mai', role: 'GVCN Lớp 12B · THPT Gò Vấp', exp: '20 năm kinh nghiệm', photo: '' },
];

// Giáo viên bộ môn
const teachersBM = [
  { name: 'Mr. James Wilson', role: 'Giáo viên bản ngữ · Tiếng Anh THPT', exp: 'CELTA · 10 năm', photo: '' },
  { name: 'Ms. Sarah Johnson', role: 'Giáo viên bản ngữ · Tiếng Anh Tiểu học', exp: 'TEFL · 8 năm', photo: '' },
  { name: 'Cô Nguyễn Thị Thanh', role: 'Giáo viên Toán · THCS/THPT', exp: 'Thạc sĩ · 14 năm', photo: '' },
  { name: 'Thầy Trần Đức Anh', role: 'Giáo viên Vật Lý · THPT', exp: 'Thạc sĩ · 13 năm', photo: '' },
  { name: 'Cô Lê Thị Hồng', role: 'Giáo viên Ngữ Văn · THCS', exp: '16 năm kinh nghiệm', photo: '' },
  { name: 'Thầy Phan Quốc Hùng', role: 'Giáo viên Tin học & STEAM', exp: 'Kỹ sư CNTT · 9 năm', photo: '' },
  { name: 'Cô Võ Thu Trang', role: 'Giáo viên Âm nhạc', exp: 'Cử nhân · 7 năm', photo: '' },
  { name: 'Thầy Nguyễn Hoài Nam', role: 'Giáo viên Thể dục', exp: 'HLV quốc gia · 11 năm', photo: '' },
];

// Quản nhiệm nội trú
const noiTru = [
  { name: 'Cô Đặng Thị Thuỷ', role: 'Trưởng phòng Quản nhiệm nội trú', exp: 'Chuyên gia tâm lý học · 15 năm', photo: '' },
  { name: 'Thầy Bùi Văn Hải', role: 'Quản nhiệm nam · Khối THCS', exp: '12 năm kinh nghiệm nội trú', photo: '' },
  { name: 'Cô Ngô Thị Liên', role: 'Quản nhiệm nữ · Khối THCS', exp: '10 năm kinh nghiệm nội trú', photo: '' },
  { name: 'Thầy Trần Minh Sơn', role: 'Quản nhiệm nam · Khối THPT', exp: '14 năm kinh nghiệm nội trú', photo: '' },
  { name: 'Cô Lê Thị Phương', role: 'Quản nhiệm nữ · Khối THPT', exp: '11 năm kinh nghiệm nội trú', photo: '' },
  { name: 'Thầy Phạm Quang Huy', role: 'Y tế học đường · Nội trú', exp: 'Bác sĩ Đa khoa · 8 năm', photo: '' },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: 'https://truongvietanh.com' },
    { '@type': 'ListItem', position: 2, name: 'Giới thiệu', item: 'https://truongvietanh.com/gioi-thieu' },
    { '@type': 'ListItem', position: 3, name: 'Giáo viên', item: 'https://truongvietanh.com/giao-vien' },
  ],
};

function initials(name: string): string {
  const parts = name.replace(/^(Cô|Thầy|Mr\.|Ms\.|Mrs\.)\s*/i, '').split(/\s+/);
  return parts.slice(-2).map(p => p[0]).join('').toUpperCase();
}
---

<BaseLayout
  title="Đội ngũ giáo viên & quản nhiệm | Trường Việt Anh"
  description="Giáo viên Trường Việt Anh: GV Chủ nhiệm, GV Bộ môn (Toán, Văn, Anh bản ngữ, STEAM, Thể dục, Âm nhạc), Quản nhiệm nội trú. Đội ngũ 500+ cán bộ giàu kinh nghiệm."
  canonical="https://truongvietanh.com/giao-vien"
  ogImage="https://media.truongvietanh.com/images/trang-chu-3.webp"
  structuredData={structuredData}
>
  <div class="gv-page">
    <HeaderBase />

    <!-- HERO -->
    <section class="gv-hero">
      <div class="gv-container">
        <nav class="gv-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Trang chủ</a>
          <span aria-hidden="true">/</span>
          <a href="/gioi-thieu">Giới thiệu</a>
          <span aria-hidden="true">/</span>
          <span>Giáo viên</span>
        </nav>
        <h1 class="gv-h1">Đội ngũ giáo viên & quản nhiệm</h1>
        <p class="gv-sub">Hơn <strong>500 giáo viên</strong> giàu kinh nghiệm, trong đó có giáo viên bản ngữ, thạc sĩ, chuyên gia tâm lý — đồng hành cùng con suốt hành trình học tập & nội trú.</p>
      </div>
    </section>

    <!-- TABS -->
    <section class="gv-tabs-section">
      <div class="gv-container">
        <div class="gv-tabs" role="tablist" aria-label="Danh mục giáo viên">
          {tabs.map((tab, idx) => (
            <button
              class={`gv-tab ${idx === 0 ? 'is-active' : ''}`}
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
              aria-controls={`panel-${tab.id}`}
              id={`tab-${tab.id}`}
              data-tab={tab.id}
              type="button"
            >
              <span class="gv-tab__icon">{tab.icon}</span>
              <span class="gv-tab__label">{tab.label}</span>
            </button>
          ))}
        </div>

        <!-- Panel 1: Chủ nhiệm -->
        <div class="gv-panel is-active" id="panel-chu-nhiem" role="tabpanel" aria-labelledby="tab-chu-nhiem">
          <p class="gv-panel__intro">Giáo viên chủ nhiệm là người trực tiếp đồng hành với lớp — chịu trách nhiệm kỷ luật, liên lạc phụ huynh, kế hoạch học tập từng học sinh. Trường Việt Anh có <strong>1 GVCN/lớp</strong> (không kiêm nhiều lớp) với tỷ lệ sĩ số 15–18 học sinh.</p>
          <div class="gv-grid">
            {teachersCN.map(t => (
              <article class="gv-card">
                <div class="gv-card__photo">
                  {t.photo ? <img src={t.photo} alt={t.name} loading="lazy" /> : <span class="gv-card__initials">{initials(t.name)}</span>}
                </div>
                <div class="gv-card__body">
                  <h3 class="gv-card__name">{t.name}</h3>
                  <p class="gv-card__role">{t.role}</p>
                  <p class="gv-card__exp">{t.exp}</p>
                </div>
              </article>
            ))}
          </div>
        </div>

        <!-- Panel 2: Bộ môn -->
        <div class="gv-panel" id="panel-bo-mon" role="tabpanel" aria-labelledby="tab-bo-mon" hidden>
          <p class="gv-panel__intro">Giáo viên bộ môn chuyên sâu từng môn học — Toán, Văn, Anh, Lý, Hoá, Sinh, Sử, Địa, Tin học, Âm nhạc, Thể dục, STEAM. 30% đội ngũ là <strong>giáo viên bản ngữ</strong> (UK/US/AUS) có chứng chỉ CELTA/TEFL.</p>
          <div class="gv-grid">
            {teachersBM.map(t => (
              <article class="gv-card">
                <div class="gv-card__photo">
                  {t.photo ? <img src={t.photo} alt={t.name} loading="lazy" /> : <span class="gv-card__initials">{initials(t.name)}</span>}
                </div>
                <div class="gv-card__body">
                  <h3 class="gv-card__name">{t.name}</h3>
                  <p class="gv-card__role">{t.role}</p>
                  <p class="gv-card__exp">{t.exp}</p>
                </div>
              </article>
            ))}
          </div>
        </div>

        <!-- Panel 3: Nội trú -->
        <div class="gv-panel" id="panel-noi-tru" role="tabpanel" aria-labelledby="tab-noi-tru" hidden>
          <p class="gv-panel__intro">Quản nhiệm nội trú chăm sóc học sinh ngoài giờ học — ăn uống, sinh hoạt, học bài tối, thể chất, tâm lý. Khu nội trú có <strong>1 quản nhiệm/20 học sinh</strong>, y tế trực 24/7, camera an ninh toàn khu.</p>
          <div class="gv-grid">
            {noiTru.map(t => (
              <article class="gv-card">
                <div class="gv-card__photo">
                  {t.photo ? <img src={t.photo} alt={t.name} loading="lazy" /> : <span class="gv-card__initials">{initials(t.name)}</span>}
                </div>
                <div class="gv-card__body">
                  <h3 class="gv-card__name">{t.name}</h3>
                  <p class="gv-card__role">{t.role}</p>
                  <p class="gv-card__exp">{t.exp}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="gv-cta">
      <div class="gv-container gv-cta__inner">
        <h2 class="gv-cta__h2">Muốn gặp trực tiếp giáo viên phụ trách con?</h2>
        <p class="gv-cta__desc">Đăng ký tham quan trường để gặp ban giám hiệu, GVCN dự kiến và quản nhiệm nội trú. Buổi tham quan miễn phí, kéo dài 60–90 phút.</p>
        <div class="gv-cta__actions">
          <a href="/lien-he" class="gv-btn gv-btn--primary">Đặt lịch tham quan</a>
          <a href="tel:0916961409" class="gv-btn gv-btn--ghost">Gọi 0916 961 409</a>
        </div>
      </div>
    </section>

    <FooterBase />
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    const tabs = document.querySelectorAll('.gv-tab');
    const panels = document.querySelectorAll('.gv-panel');
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-tab');
        tabs.forEach(t => {
          t.classList.toggle('is-active', t === tab);
          t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
        });
        panels.forEach(p => {
          const match = p.id === `panel-${target}`;
          p.classList.toggle('is-active', match);
          if (match) p.removeAttribute('hidden');
          else p.setAttribute('hidden', '');
        });
      });
    });
  })();
</script>

<style is:global>
  .gv-page { background: #f7f9fc; }
  .gv-container { max-width: 1180px; margin: 0 auto; padding: 0 1.25rem; }

  .gv-hero { padding: 2.5rem 0 1.75rem; background: linear-gradient(180deg, #fff 0%, #f7f9fc 100%); }
  .gv-breadcrumb { font-size: 0.85rem; color: #64748b; margin-bottom: 0.75rem; }
  .gv-breadcrumb a { color: #1a1a5e; text-decoration: none; }
  .gv-breadcrumb a:hover { text-decoration: underline; }
  .gv-h1 { font-size: clamp(1.75rem, 3.5vw, 2.4rem); font-weight: 800; color: #0f172a; margin: 0 0 0.75rem; line-height: 1.2; }
  .gv-sub { font-size: 1.05rem; color: #475569; line-height: 1.65; margin: 0; max-width: 780px; }
  .gv-sub strong { color: #1a1a5e; font-weight: 700; }

  /* TABS */
  .gv-tabs-section { padding: 1.5rem 0 3rem; }
  .gv-tabs {
    display: flex;
    gap: 0.5rem;
    border-bottom: 2px solid #e2e8f0;
    margin-bottom: 1.75rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .gv-tabs::-webkit-scrollbar { display: none; }
  .gv-tab {
    background: transparent;
    border: none;
    padding: 0.85rem 1.25rem;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    color: #64748b;
    cursor: pointer;
    border-bottom: 3px solid transparent;
    margin-bottom: -2px;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    transition: color 0.2s, border-color 0.2s;
  }
  .gv-tab:hover { color: #1a1a5e; }
  .gv-tab.is-active {
    color: #1a1a5e;
    border-bottom-color: #F0D048;
  }
  .gv-tab__icon { font-size: 1.1rem; line-height: 1; }

  /* PANELS */
  .gv-panel { display: none; }
  .gv-panel.is-active { display: block; }
  .gv-panel__intro { font-size: 1rem; color: #475569; line-height: 1.7; margin: 0 0 1.5rem; max-width: 820px; }
  .gv-panel__intro strong { color: #1a1a5e; font-weight: 700; }

  /* GRID */
  .gv-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  @media (max-width: 900px) { .gv-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .gv-grid { grid-template-columns: 1fr; } }

  .gv-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 1.25rem;
    display: flex;
    gap: 1rem;
    align-items: center;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }
  .gv-card:hover {
    border-color: #F0D048;
    box-shadow: 0 10px 30px rgba(26, 26, 94, 0.08);
    transform: translateY(-2px);
  }
  .gv-card__photo {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: linear-gradient(135deg, #1a1a5e, #0d2f55);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }
  .gv-card__photo img { width: 100%; height: 100%; object-fit: cover; }
  .gv-card__initials { font-family: "Montserrat", sans-serif; font-weight: 800; font-size: 1rem; letter-spacing: 0.05em; }
  .gv-card__body { min-width: 0; }
  .gv-card__name { font-family: "Montserrat", sans-serif; font-size: 1rem; font-weight: 700; color: #1a1a5e; margin: 0 0 0.25rem; }
  .gv-card__role { font-size: 0.88rem; color: #475569; line-height: 1.45; margin: 0 0 0.2rem; }
  .gv-card__exp { font-size: 0.8rem; color: #F0D048; font-weight: 600; margin: 0; }

  /* CTA */
  .gv-cta { background: linear-gradient(135deg, #0d1b3e 0%, #1a1a5e 100%); color: #fff; padding: 2.5rem 0; }
  .gv-cta__inner { text-align: center; max-width: 720px; margin: 0 auto; }
  .gv-cta__h2 { font-size: clamp(1.4rem, 2.3vw, 1.75rem); font-weight: 800; color: #fff; margin: 0 0 0.75rem; }
  .gv-cta__desc { color: rgba(255, 255, 255, 0.85); font-size: 1rem; line-height: 1.65; margin: 0 0 1.25rem; }
  .gv-cta__actions { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
  .gv-btn { display: inline-flex; align-items: center; justify-content: center; padding: 0.75rem 1.5rem; border-radius: 10px; font-weight: 700; font-size: 0.95rem; text-decoration: none; transition: all 0.2s; }
  .gv-btn--primary { background: #F0D048; color: #1a1a5e; }
  .gv-btn--primary:hover { background: #D4B637; transform: translateY(-2px); }
  .gv-btn--ghost { background: transparent; color: #fff; border: 1.5px solid rgba(255, 255, 255, 0.6); }
  .gv-btn--ghost:hover { background: rgba(255, 255, 255, 0.12); border-color: #fff; }
</style>
