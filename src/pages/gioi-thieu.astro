---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Trường Việt Anh",
    "alternateName": "Trường Liên Cấp Việt Anh",
    "url": "https://truongvietanh.com",
    "logo": "https://truongvietanh.com/logo-crest-80.webp",
    "foundingDate": "2011",
    "description": "Hệ thống giáo dục liên cấp song ngữ từ Mầm non đến THPT tại TP.HCM, Long An, Kiên Giang.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Hồ Chí Minh",
      "addressCountry": "VN"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "bestRating": "5",
      "ratingCount": "300"
    },
    "numberOfEmployees": { "@type": "QuantitativeValue", "value": 500 },
    "areaServed": ["TP. Hồ Chí Minh", "Long An", "Kiên Giang"]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Trường Việt Anh có bao nhiêu cơ sở?",
        "acceptedAnswer": { "@type": "Answer", "text": "Trường Việt Anh có 9 cơ sở tại TP.HCM (4), Long An (3) và Kiên Giang (2)." }
      },
      {
        "@type": "Question",
        "name": "Học phí Trường Việt Anh bao nhiêu 1 tháng?",
        "acceptedAnswer": { "@type": "Answer", "text": "Học phí dao động 5-8 triệu/tháng tuỳ cấp học. Xem chi tiết tại trang học phí." }
      },
      {
        "@type": "Question",
        "name": "Trường có xe đưa rước không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Có, hệ thống xe đưa rước phủ khắp các quận tại TP.HCM." }
      },
      {
        "@type": "Question",
        "name": "Chương trình tiếng Anh khác gì trường quốc tế?",
        "acceptedAnswer": { "@type": "Answer", "text": "Immersion từ Mầm non, UK curriculum Tiểu học, đầu ra IELTS 6.0-8.0 tại THPT." }
      },
      {
        "@type": "Question",
        "name": "Trường nhận học sinh từ mấy tuổi?",
        "acceptedAnswer": { "@type": "Answer", "text": "Từ 2 tuổi (Mầm non) đến 18 tuổi (THPT)." }
      },
      {
        "@type": "Question",
        "name": "Có chính sách học bổng không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Có, dành cho học sinh xuất sắc và gia đình có hoàn cảnh. Liên hệ tư vấn để biết chi tiết." }
      },
      {
        "@type": "Question",
        "name": "Làm sao đăng ký tham quan trường?",
        "acceptedAnswer": { "@type": "Answer", "text": "Đăng ký trực tuyến tại trang web hoặc gọi 0916 961 409." }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://truongvietanh.com" },
      { "@type": "ListItem", "position": 2, "name": "Giới thiệu", "item": "https://truongvietanh.com/gioi-thieu" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Trường Việt Anh",
    "image": "https://truongvietanh.com/logo-crest-80.webp",
    "telephone": "+84916961409",
    "email": "tuyensinh@truongvietanh.com",
    "url": "https://truongvietanh.com",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "168/2 Phan Huy Ích",
      "addressLocality": "Gò Vấp",
      "addressRegion": "TP. Hồ Chí Minh",
      "addressCountry": "VN"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 10.8431,
      "longitude": 106.6422
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "07:30",
      "closes": "17:00"
    },
    "priceRange": "$$"
  }
];
---

<BaseLayout
  title="Giới Thiệu Trường Việt Anh – Liên Cấp Song Ngữ"
  description="Trường Việt Anh thành lập 2011: hệ thống liên cấp Mầm non – THPT tại TP.HCM. IELTS, 16 kỹ năng thế kỷ 21, 9 cơ sở. Tham quan miễn phí."
  canonical="https://truongvietanh.com/gioi-thieu"
  ogImage="https://media.truongvietanh.com/images/extra-giao-vien-va-hoc-sinh-2.webp"
  structuredData={structuredData}
>
  <div class="gi-page">
    <HeaderBase />

    <!-- ====== LAYER 2: HERO WITH FORM ====== -->
    <section class="gi-hero">
      <div class="gi-container gi-hero-inner">
        <div class="gi-hero-left">
          <nav class="gi-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Trang chủ</a>
            <span aria-hidden="true">/</span>
            <span>Giới thiệu</span>
          </nav>

          <h1 class="gi-h1">Trường Việt Anh: Hệ Thống Giáo Dục Liên Cấp Song Ngữ Tại TP.HCM</h1>
          <p class="gi-subtitle">Tạo ra môi trường học tập vui vẻ và thực dụng kể từ năm 2011</p>
          <p class="gi-last-updated">Cập nhật lần cuối: Tháng 4, 2026</p>

          <div class="gi-hero-rating">
            <span class="gi-stars" aria-label="4.9 trên 5 sao">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            <span class="gi-rating-text">4.9/5 (300+ đánh giá)</span>
          </div>

          <div class="gi-trust-badges">
            <div class="gi-badge"><strong>15+</strong> năm</div>
            <div class="gi-badge"><strong>9</strong> cơ sở</div>
            <div class="gi-badge"><strong>IELTS</strong> 6-8</div>
            <div class="gi-badge"><strong>99%</strong> vào đại học</div>
          </div>
        </div>

        <div class="gi-hero-right">
          <div class="gi-form-card">
            <p class="gi-form-heading">Đăng ký tham quan trường miễn phí</p>
            <LeadFormTwoStepEmailFirst
              formId="gioi-thieu-form"
              funnelCode="gioi-thieu-pillar"
              schoolLevel="tieu-hoc"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ====== IMAGE: Giáo viên và học sinh ====== -->
    <div class="gi-container" style="padding-top:2.5rem">
      <img src="https://media.truongvietanh.com/images/giao-vien-01.webp" alt="Giáo viên và học sinh Trường Việt Anh" loading="lazy" width="1200" height="auto" style="border-radius:12px;width:100%;height:auto;margin:1.5rem 0" />
    </div>

    <!-- ====== LAYER 3 + 4: TOC SIDEBAR + CONTENT ====== -->
    <div class="gi-container gi-body">
      <p class="gi-last-updated">Cập nhật lần cuối: Tháng 4/2026</p>
      <!-- Sticky TOC sidebar -->
      <nav class="gi-toc" aria-label="Mục lục">
        <p class="gi-toc-title">Mục lục</p>
        <ol class="gi-toc-list">
          <li><a href="#tam-nhin">Tầm nhìn & Sứ mệnh</a></li>
          <li><a href="#noi-dung-hoc">Nội dung học thực dụng</a></li>
          <li><a href="#tieng-anh">Tiếng Anh đủ du học</a></li>
          <li><a href="#truong-thanh">Học sinh sớm trưởng thành</a></li>
          <li><a href="#chuong-trinh">Chương trình đào tạo</a></li>
          <li><a href="#co-so">Hệ thống cơ sở</a></li>
          <li><a href="#danh-gia">Đánh giá phụ huynh</a></li>
          <li><a href="#faq">Câu hỏi thường gặp</a></li>
        </ol>
        <a href="#gioi-thieu-form-gioi-thieu-pillar" class="gi-toc-cta">Đăng ký tham quan</a>
      </nav>

      <!-- Main content -->
      <article class="gi-main">

        <!-- Section 1: Tầm nhìn -->
        <section id="tam-nhin" class="gi-section">
          <h2>Tầm nhìn và sứ mệnh của Trường Việt Anh là gì?</h2>
          <p>Trường Việt Anh được thành lập năm 2011 với sứ mệnh <strong>"Tạo ra môi trường học tập vui vẻ và thực dụng"</strong>. Tầm nhìn của trường: tất cả học sinh hạnh phúc, ra trường với 16 kỹ năng thế kỷ 21 và nền tảng tiếng Anh đủ du học.</p>
          <p>Sau hơn 15 năm hoạt động, Trường Việt Anh đã xây dựng hệ thống 9 cơ sở tại 3 tỉnh thành, phục vụ hơn 5.000 học sinh mỗi năm — từ Mầm non đến THPT.</p>

          <div class="gi-values-grid">
            <h3>5 giá trị cốt lõi</h3>
            <div class="gi-values-items">
              <div class="gi-value-card">
                <span class="gi-value-icon">&#9878;</span>
                <strong>Chính trực</strong>
                <p>Làm đúng, nói thật, sống ngay thẳng</p>
              </div>
              <div class="gi-value-card">
                <span class="gi-value-icon">&#9829;</span>
                <strong>Tử tế</strong>
                <p>Quan tâm và giúp đỡ người khác</p>
              </div>
              <div class="gi-value-card">
                <span class="gi-value-icon">&#9881;</span>
                <strong>Kỷ luật</strong>
                <p>Tự giác, có trách nhiệm với bản thân</p>
              </div>
              <div class="gi-value-card">
                <span class="gi-value-icon">&#9733;</span>
                <strong>Sáng tạo</strong>
                <p>Dám nghĩ khác, làm khác, đi đầu</p>
              </div>
              <div class="gi-value-card">
                <span class="gi-value-icon">&#9889;</span>
                <strong>Bền bỉ</strong>
                <p>Không bỏ cuộc trước khó khăn</p>
              </div>
            </div>
          </div>

          <img src="https://media.truongvietanh.com/images/thuyet-trinh-01.webp" alt="Học sinh thuyết trình tại Trường Việt Anh" loading="lazy" width="1200" height="auto" style="border-radius:12px;width:100%;height:auto;margin:1.5rem 0" />

          <div class="gi-evidence-bar">
            <div class="gi-evidence-item">
              <strong>2011</strong>
              <span>Năm thành lập</span>
            </div>
            <div class="gi-evidence-item">
              <strong>9</strong>
              <span>Cơ sở</span>
            </div>
            <div class="gi-evidence-item">
              <strong>5.000+</strong>
              <span>Học sinh</span>
            </div>
            <div class="gi-evidence-item">
              <strong>3</strong>
              <span>Tỉnh thành</span>
            </div>
          </div>
        </section>

        <!-- Section 2: Nội dung học -->
        <section id="noi-dung-hoc" class="gi-section">
          <h2>Nội dung học tại Trường Việt Anh có gì khác biệt?</h2>
          <p>Chương trình học tại Trường Việt Anh được thiết kế dựa trên 16 kỹ năng thế kỷ 21 do Diễn đàn Kinh tế Thế giới (WEF) công bố. Học sinh không chỉ học lý thuyết mà còn ứng dụng trực tiếp vào dự án thực tế, rèn tư duy phản biện và giải quyết vấn đề.</p>
          <p>Mỗi năm, giáo trình được cập nhật để phù hợp với xu thế mới — bao gồm cách sử dụng AI có trách nhiệm, kỹ năng số (digital literacy), và khởi nghiệp (entrepreneurship).</p>

          <div class="gi-comparison-box">
            <h3>So sánh: Giáo dục Việt Nam truyền thống vs Trường Việt Anh</h3>
            <div class="gi-table-responsive">
              <table class="gi-table">
                <thead>
                  <tr>
                    <th>Tiêu chí</th>
                    <th>Truyền thống</th>
                    <th>Trường Việt Anh</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Phương pháp</td>
                    <td>Học thuộc, thi cử</td>
                    <td>Dự án thực tế, tư duy phản biện</td>
                  </tr>
                  <tr>
                    <td>Kỹ năng</td>
                    <td>Tập trung kiến thức sách</td>
                    <td>16 kỹ năng WEF + lãnh đạo</td>
                  </tr>
                  <tr>
                    <td>Tiếng Anh</td>
                    <td>4-8 tiết/tuần</td>
                    <td>30-50% thời lượng bằng Tiếng Anh</td>
                  </tr>
                  <tr>
                    <td>Công nghệ</td>
                    <td>Tin học cơ bản</td>
                    <td>AI, Coding, Digital Literacy</td>
                  </tr>
                  <tr>
                    <td>Đầu ra</td>
                    <td>Điểm thi cao</td>
                    <td>Kỹ năng + IELTS + Tự tin</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>Học sinh Trường Việt Anh thường xuyên tham gia các cuộc thi quốc tế, dự án cộng đồng và chương trình trao đổi văn hoá — giúp các em có tầm nhìn toàn cầu từ nhỏ.</p>
        </section>

        <!-- Section 3: Tiếng Anh -->
        <section id="tieng-anh" class="gi-section">
          <h2>Chương trình tiếng Anh của Trường Việt Anh đạt chuẩn IELTS như thế nào?</h2>
          <p>Trường Việt Anh cam kết đầu ra tối thiểu IELTS 6.0 cho học sinh tốt nghiệp THPT. Lộ trình tiếng Anh được thiết kế liên tục từ Mầm non đến lớp 12, đảm bảo học sinh tiến bộ tự nhiên mà không bị áp lực quá tải.</p>

          <div class="gi-roadmap">
            <h3>Lộ trình Tiếng Anh 4 giai đoạn</h3>
            <div class="gi-roadmap-grid">
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">MN</div>
                <strong>Mầm non (2-5 tuổi)</strong>
                <p>100% Immersion — Trẻ tiếp xúc tiếng Anh tự nhiên qua vui chơi, hát, kể chuyện với giáo viên bản ngữ.</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">TH</div>
                <strong>Tiểu học (6-10 tuổi)</strong>
                <p>UK Curriculum — Học Toán, Khoa học bằng tiếng Anh. Rèn kỹ năng đọc-viết học thuật (Academic Reading & Writing).</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">THCS</div>
                <strong>THCS (11-14 tuổi)</strong>
                <p>Giao tiếp + Học thuật — Học sinh tự tin thuyết trình, viết luận bằng tiếng Anh. Mục tiêu: IELTS 4.5-5.5.</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">THPT</div>
                <strong>THPT (15-18 tuổi)</strong>
                <p>Luyện thi IELTS chuyên sâu — Giáo viên bản ngữ + trung tâm khảo thí. Đầu ra: IELTS 6.0-8.0.</p>
              </div>
            </div>
          </div>

          <p>Ngoài ra, Trường Việt Anh còn hợp tác triển khai chương trình tiếng Anh cho hơn <strong>100 trường tại TP.HCM</strong>, chứng minh chất lượng giáo trình đã được kiểm chứng trên quy mô lớn.</p>
        </section>

        <!-- Section 4: Trưởng thành -->
        <section id="truong-thanh" class="gi-section">
          <h2>Trường Việt Anh rèn luyện kỹ năng lãnh đạo cho học sinh như thế nào?</h2>
          <p>Trường Việt Anh áp dụng chương trình <strong>Leader in Me</strong> (bản quyền Franklin Covey) — một framework giáo dục lãnh đạo hàng đầu thế giới, kết hợp với 5 giá trị cốt lõi của trường.</p>

          <div class="gi-leader-grid">
            <div class="gi-leader-card">
              <h4>7 thói quen lãnh đạo</h4>
              <ol>
                <li>Chủ động (Be Proactive)</li>
                <li>Bắt đầu từ mục tiêu (Begin with the End in Mind)</li>
                <li>Ưu tiên việc quan trọng (Put First Things First)</li>
                <li>Tư duy cùng thắng (Think Win-Win)</li>
                <li>Hiểu người trước (Seek First to Understand)</li>
                <li>Hợp tác sáng tạo (Synergize)</li>
                <li>Rèn luyện bản thân (Sharpen the Saw)</li>
              </ol>
            </div>
            <div class="gi-leader-card">
              <h4>Học sinh tham gia quản lý trường</h4>
              <ul>
                <li>Hội đồng học sinh tự tổ chức sự kiện</li>
                <li>Chương trình "Đại sứ trường học" cho lớp lớn</li>
                <li>Dự án cộng đồng do học sinh dẫn dắt</li>
                <li>Thuyết trình và phản biện hàng tuần</li>
                <li>Cuộc thi lãnh đạo "Việt Anh Young Leaders"</li>
              </ul>
            </div>
          </div>
          <p>Kết quả: học sinh Trường Việt Anh tự tin giao tiếp, có khả năng tổ chức và đảm nhận trách nhiệm sớm hơn bạn bè cùng lứa tuổi. Nhiều cựu học sinh hiện đang học bổng tại các trường đại học hàng đầu trong và ngoài nước. <a href="/thanh-tich">Xem thành tích học sinh nổi bật &rarr;</a></p>
        </section>

        <!-- Section 5: Chương trình đào tạo -->
        <section id="chuong-trinh" class="gi-section">
          <h2>So sánh chương trình đào tạo các cấp tại Trường Việt Anh</h2>
          <p>Trường Việt Anh cung cấp chương trình liên cấp từ 2 tuổi đến 18 tuổi, đảm bảo sự liên tục trong phát triển kỹ năng và tiếng Anh. Dưới đây là bảng so sánh chi tiết giữa các cấp học.</p>

          <div class="gi-table-responsive">
            <table class="gi-table gi-table-programs">
              <thead>
                <tr>
                  <th>Cấp học</th>
                  <th>Độ tuổi</th>
                  <th>Chương trình Tiếng Anh</th>
                  <th>Kỹ năng trọng tâm</th>
                  <th>Đặc điểm nổi bật</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Mầm non</strong></td>
                  <td>2-5 tuổi</td>
                  <td>100% Immersion với GV bản ngữ</td>
                  <td>Giao tiếp, sáng tạo, tự lập</td>
                  <td>Hệ thống PDR (Plan-Do-Review), học qua chơi</td>
                </tr>
                <tr>
                  <td><strong>Tiểu học</strong></td>
                  <td>6-10 tuổi</td>
                  <td>UK Curriculum, 50% thời lượng TA</td>
                  <td>Tư duy phản biện, giải quyết vấn đề</td>
                  <td>STEAM, Coding, dự án thực tế hàng tháng</td>
                </tr>
                <tr>
                  <td><strong>THCS</strong></td>
                  <td>11-14 tuổi</td>
                  <td>Academic English, mục tiêu IELTS 4.5-5.5</td>
                  <td>Lãnh đạo, hợp tác, thuyết trình</td>
                  <td>Leader in Me, trao đổi văn hoá quốc tế</td>
                </tr>
                <tr>
                  <td><strong>THPT</strong></td>
                  <td>15-18 tuổi</td>
                  <td>IELTS Prep, đầu ra 6.0-8.0</td>
                  <td>Tự học, nghiên cứu, khởi nghiệp</td>
                  <td>Hướng nghiệp, du học, 99% vào đại học</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="gi-level-cards">
