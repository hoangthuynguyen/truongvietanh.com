/* Giu cho Lion Camp — standalone deposit/hold-seat page */
---

<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Giu Cho Lion Camp 2026 | Truong Viet Anh</title>
  <meta name="description" content="Giu cho Lion Camp He 2026 — Chi 500.000d, hoan 100% neu doi y." />
  <meta name="robots" content="noindex, nofollow" />

  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <style is:inline>@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=Open+Sans:wght@400;600;700&display=swap&subset=vietnamese');</style>

