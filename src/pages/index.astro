<script>
  // Grade pill selection
  document.querySelectorAll('.grade-pill').forEach(pill => {
    pill.addEventListener('click', () => {
      document.querySelectorAll('.grade-pill').forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
    });
  });

  // Quick lead form submission
  const form = document.getElementById('homepage-lead-form');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('.quick-submit');
      const originalText = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'Đang gửi…';

      const activePill = form.querySelector('.grade-pill.active');
      const level = activePill ? activePill.dataset.level : 'lien-cap';
      const name = form.querySelector('[name="fullName"]').value.trim();
      const phone = form.querySelector('[name="phone"]').value.trim();

      // Synthetic email from phone if no email provided
      const phoneDigits = phone.replace(/\D/g,'');
      const syntheticEmail = phoneDigits ? `${phoneDigits}@lead.truongvietanh.com` : 'unknown@lead.truongvietanh.com';

      const payload = {
        fullName: name,
        phone: phone,
        email: syntheticEmail,
        schoolLevel: level,
        source: 'homepage-quick-form',
        page: window.location.href,
        utm_source: new URLSearchParams(window.location.search).get('utm_source') || '',
        utm_medium: new URLSearchParams(window.location.search).get('utm_medium') || '',
        utm_campaign: new URLSearchParams(window.location.search).get('utm_campaign') || '',
      };

      try {
        const resp = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        form.hidden = true;
        form.closest('.quick-lead-card').querySelector('.quick-lead-success').hidden = false;
      } catch (err) {
        btn.disabled = false;
        btn.innerHTML = originalText;
        alert('Có lỗi xảy ra. Vui lòng gọi trực tiếp: 0916 961 409');
      }
    });
  }
</script>
