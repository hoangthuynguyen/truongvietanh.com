---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import { defaultSiteUrl } from '../lib/site-content';
import { getTestimonials } from '../lib/directus';

const siteUrl = import.meta.env.PUBLIC_SITE_URL || defaultSiteUrl;

// Fetch from CMS
const cmsTestimonials = await getTestimonials('index');

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'EducationalOrganization',
    name: 'Trường Liên Cấp Việt Anh',
    alternateName: 'Truong Viet Anh',
    url: 'https://truongvietanh.com',
    logo: 'https://truongvietanh.com/logo-crest-80.webp',
    telephone: '+84-916-961-409',
    description: 'Hệ thống giáo dục liên cấp song ngữ tại TP.HCM, đào tạo từ Mầm Non đến THPT với chương trình tích hợp 16 kỹ năng thế kỷ 21, cam kết IELTS 6.0+ đầu ra.',
    foundingDate: '2011',
    address: [
      { '@type': 'PostalAddress', streetAddress: '160/72 Phan Huy Ích, Phường 12', addressLocality: 'Quận Gò Vấp', addressRegion: 'TP.HCM', addressCountry: 'VN' },
      { '@type': 'PostalAddress', streetAddress: '269A Nguyễn Trọng Tuyển, Phường 10', addressLocality: 'Quận Phú Nhuận', addressRegion: 'TP.HCM', addressCountry: 'VN' },
      { '@type': 'PostalAddress', streetAddress: '951/7 Tỉnh lộ 10, Phường Tân Tạo', addressLocality: 'Quận Bình Tân', addressRegion: 'TP.HCM', addressCountry: 'VN' },
    ],
    sameAs: ['https://www.facebook.com/truongvietanhhcm', 'https://www.youtube.com/@truongvietanh', 'https://www.instagram.com/truongvietanh', 'https://zalo.me/0916961409'],
    numberOfEmployees: { '@type': 'QuantitativeValue', value: 500 },
    contactPoint: { '@type': 'ContactPoint', telephone: '+84916961409', contactType: 'customer service', areaServed: 'VN', availableLanguage: ['vi', 'en'] },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Trường Việt Anh',
    alternateName: 'Trường Liên Cấp Việt Anh',
    url: 'https://truongvietanh.com',
    inLanguage: 'vi',
    description: 'Hệ thống giáo dục liên cấp song ngữ Anh-Việt từ Mầm Non đến THPT tại TP.HCM, Long An, Kiên Giang.',
    potentialAction: {
      '@type': 'SearchAction',
      target: 'https://truongvietanh.com/tin-tuc?q={search_term_string}',
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Trường Việt Anh dạy từ cấp nào đến cấp nào?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Trường Việt Anh là hệ thống giáo dục liên cấp, đào tạo từ Mầm Non (2 tuổi) đến THPT (lớp 12), với 9 cơ sở tại TP.HCM, Long An và Kiên Giang.',
        },
      },
      {
        '@type': 'Question',
        name: 'Học phí Trường Việt Anh bao nhiêu?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Học phí Trường Việt Anh dao động từ 5 đến 12 triệu đồng/tháng tuỳ cấp học, bao gồm chương trình song ngữ tích hợp Cambridge, giáo viên bản ngữ và 16 kỹ năng thế kỷ 21.',
        },
      },
      {
        '@type': 'Question',
        name: 'Học sinh tốt nghiệp Trường Việt Anh đạt IELTS bao nhiêu?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Học sinh THPT Việt Anh tốt nghiệp đạt IELTS từ 6.0 đến 8.0, trung bình đầu ra là IELTS 6.5. Trường cũng là trung tâm khảo thí IELTS tại TP.HCM.',
        },
      },
      {
        '@type': 'Question',
        name: 'Trường Việt Anh có bao nhiêu cơ sở?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Trường Việt Anh hiện có 9 cơ sở tại 3 tỉnh thành: TP.HCM (Gò Vấp, Phú Nhuận, Bình Tân), Cần Giuộc - Long An và TP. Rạch Giá - Kiên Giang.',
        },
      },
      {
        '@type': 'Question',
        name: 'Phương pháp giáo dục PDR của Trường Việt Anh là gì?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'PDR (Play – Discover – Reflect) là phương pháp giáo dục do Trường Việt Anh nghiên cứu và phát triển từ 2011, đặt học sinh làm trung tâm qua 3 giai đoạn: vui chơi có mục đích, khám phá chuyên sâu và phản tư tự đánh giá.',
        },
      },
      {
        '@type': 'Question',
        name: 'Làm sao để đăng ký tuyển sinh Trường Việt Anh?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Phụ huynh có thể đăng ký tư vấn tuyển sinh trực tiếp trên website truongvietanh.com, gọi hotline 0916 961 409, hoặc đặt lịch tham quan trường để được tư vấn chi tiết.',
        },
      },
      {
        '@type': 'Question',
        name: 'Học phí Trường Việt Anh bao nhiêu?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Học phí dao động từ 5-12 triệu/tháng tùy cấp học và chương trình. So với trường quốc tế (15-30 triệu), Việt Anh mang đến chất lượng tương đương với mức phí hợp lý hơn nhiều.',
        },
      },
      {
        '@type': 'Question',
        name: 'Trình độ tiếng Anh đầu ra của học sinh Trường Việt Anh?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Học sinh tốt nghiệp THPT đạt tối thiểu IELTS 6.0, nhiều em đạt 7.0-8.0. Đây là mức đủ để xét tuyển vào hầu hết đại học thế giới và nhận học bổng du học.',
        },
      },
    ],
  },
];

const productLinks = [
  { label: 'Mầm non', href: '/mam-non' },
  { label: 'Tiểu học', href: '/tieu-hoc' },
  { label: 'THCS', href: '/trung-hoc-co-so' },
  { label: 'THPT', href: '/trung-hoc-pho-thong' },
  { label: 'Trại hè', href: '/tuyen-sinh' },
  { label: 'Tiếng Anh Trẻ Em', href: '/tuyen-sinh' },
  { label: 'Toán Tư Duy', href: '/tuyen-sinh' },
  { label: 'Giải Mã Tiềm Năng', href: '/tuyen-sinh' },
];

const campusLinks = [
  { label: 'Trường Mầm non Việt Anh Gò Vấp - HCM', href: '/co-so' },
  { label: 'Trường TiH THCS THPT Việt Anh Gò Vấp - HCM', href: '/co-so' },
  { label: 'Trường TiH THCS THPT Việt Anh Bình Tân - HCM', href: '/co-so' },
  { label: 'Trường Mầm non Nhân Lễ - Xã Cần Giuộc - Tây Ninh', href: '/co-so' },
  { label: 'Trường MN và TiH Thái Sơn - Xã Cần Giuộc - Tây Ninh', href: '/co-so' },
  { label: 'Trường MN và TiH Mekong Xanh - TP Rạch Giá - An Giang', href: '/co-so' },
];


// Testimonials — nội dung từ thư viện testimonial, ảnh từ thumbnail YouTube
const testimonials = cmsTestimonials.length > 0
  ? cmsTestimonials.map((t: any) => ({ name: t.name, role: t.role, quote: t.quote, img: t.image || '', videoUrl: t.video_url || '' }))
  : [
    {
      name: 'Chị Linh',
      role: 'Phụ huynh mầm non – bé 2 tuổi',
      quote: 'Từ em bé bướng bỉnh, con đã biết tự ăn và vào nề nếp. Con thay đổi rõ rệt chỉ sau vài tháng đầu.',
      img: 'https://img.youtube.com/vi/Bt1yyMil3Tg/hqdefault.jpg',
      videoUrl: 'https://www.youtube.com/watch?v=Bt1yyMil3Tg',
    },
    {
      name: 'Anh Công',
      role: 'Phụ huynh lớp 1 – chuyển từ mầm non',
      quote: 'Con luôn háo hức và mong chờ được đến trường mỗi ngày. Đi học vui vẻ, không áp lực.',
      img: 'https://img.youtube.com/vi/b9eNSFUDd98/hqdefault.jpg',
      videoUrl: 'https://www.youtube.com/watch?v=b9eNSFUDd98',
    },
    {
      name: 'Chị Nga',
      role: 'Phụ huynh lớp 3 – cơ sở Gò Vấp',
      quote: 'Sau 2 năm, con thay đổi rõ rệt cả về học tập và kỹ năng — đúng như thầy cô tư vấn từ đầu.',
      img: 'https://img.youtube.com/vi/3jwB87z-Keg/hqdefault.jpg',
      videoUrl: 'https://www.youtube.com/watch?v=3jwB87z-Keg',
    },
    {
      name: 'Chị Quỳnh',
      role: 'Phụ huynh lớp 7 – chuyển trường mới',
      quote: 'Chỉ sau hơn 1 tháng, con đã hòa nhập rất tốt với bạn bè và học tập vui vẻ mỗi ngày.',
      img: 'https://img.youtube.com/vi/cZ6S_3MG1Vo/hqdefault.jpg',
      videoUrl: 'https://www.youtube.com/watch?v=cZ6S_3MG1Vo',
    },
    {
      name: 'Anh Lê Trung Thành',
      role: 'Phụ huynh THPT – lựa chọn môi trường',
      quote: 'Gia đình chọn trường vì môi trường giúp con phát triển toàn diện — từ kiến thức đến thái độ.',
      img: 'https://img.youtube.com/vi/5T8j_k5VCW4/hqdefault.jpg',
      videoUrl: 'https://www.youtube.com/watch?v=5T8j_k5VCW4',
    },
    {
      name: 'Bạn Chu Anh Tài',
      role: 'Học sinh lớp 12 – Chủ tịch Hội học sinh',
      quote: 'Từ một người khép kín, em đã khám phá khả năng lãnh đạo và đảm nhận Chủ tịch Hội học sinh.',
      img: 'https://img.youtube.com/vi/NAYd7sM0d-8/hqdefault.jpg',
      videoUrl: 'https://www.youtube.com/watch?v=NAYd7sM0d-8',
    },
  ];

const newsCards = [
  {
    eyebrow: 'Tuyển sinh 2026–2027',
    title: 'Quy trình tuyển sinh Trường Việt Anh: Từ đăng ký đến nhập học',
    body: 'Hướng dẫn đầy đủ các bước đăng ký tuyển sinh, hồ sơ cần chuẩn bị, lịch thi đầu vào và thời hạn nộp hồ sơ năm học 2026–2027.',
    href: '/tuyen-sinh',
    cta: 'Xem lộ trình tuyển sinh →',
    img: 'https://media.truongvietanh.com/images/trang-chu-3.webp',
  },
  {
    eyebrow: 'Học phí & học bổng',
    title: 'Học phí Trường Việt Anh 2026–2027 và các chính sách học bổng',
    body: 'Chi tiết học phí theo từng cấp học, chính sách học bổng dành cho học sinh xuất sắc và ưu đãi Early Bird cho phụ huynh đăng ký sớm.',
    href: '/hoc-phi',
    cta: 'Xem học phí chi tiết →',
    img: 'https://media.truongvietanh.com/images/trang-chu-5.webp',
  },
  {
    eyebrow: 'Đời sống học đường',
    title: 'Một ngày ở Trường Việt Anh: Học sinh làm gì từ 7 giờ sáng đến 5 giờ chiều?',
    body: 'Lịch học, giờ nghỉ ngơi, hoạt động ngoại khóa, bữa ăn và không gian tự học — tất cả để phụ huynh hình dung rõ cuộc sống của con tại trường.',
    href: '/tin-tuc',
    cta: 'Đọc câu chuyện →',
    img: 'https://media.truongvietanh.com/images/trang-chu-7.webp',
  },
];
---

<BaseLayout
  title="Trường Việt Anh | Hệ thống trường học liên cấp từ Mầm non đến THPT"
  description="Trường Việt Anh — hệ thống giáo dục liên cấp song ngữ tại TP.HCM. Tiếng Anh IELTS 6.0-8.0, kỹ năng thế kỷ 21, 99% đỗ ĐH. Học phí từ 5 triệu/tháng."
  canonical="https://truongvietanh.com"
  noPopup={true}
  ogImage="https://media.truongvietanh.com/images/trang-chu-3.webp"
  structuredData={structuredData}
  noPopup={true}
>
  <div class="site-shell site-shell--home">
    <SiteHeader currentPath="/" />

    <main>
      <!-- URGENCY STRIP -->
      <div class="urgency-strip">
        <span class="urgency-strip__dot"></span>
        🎓 Tuyển sinh 2026–2027 đang mở · Ưu đãi Early bird giảm đến 46% học phí
        <a href="/tuyen-sinh" class="urgency-strip__link">Xem ưu đãi →</a>
      </div>

      <!-- DARK HERO -->
      <section class="wp-hero">
        <div class="wp-hero__overlay"></div>
        <div class="wp-hero__content">
          <h1 class="wp-hero__title">Trường Việt Anh</h1>
          <p class="wp-hero__subtitle">Hệ thống trường học Mầm non, Tiểu học, THCS và THPT</p>
          <p class="wp-hero__desc">
            Từ bình thường trở nên phi thường.
          </p>
          <div class="wp-hero__actions">
            <a class="wp-hero__btn wp-hero__btn--primary" href="#danh-gia">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15 8.5 22 9.3 17 14 18.2 21 12 17.8 5.8 21 7 14 2 9.3 9 8.5 12 2"/></svg>
              Xem đánh giá
            </a>
            <a class="wp-hero__btn wp-hero__btn--outline" href="/hoc-phi">Xem học phí</a>
            <a class="wp-hero__btn wp-hero__btn--outline" href="https://zalo.me/1678310120468101523" target="_blank" rel="noreferrer">Chat ngay</a>
          </div>
          <div class="wp-hero__badges">
            <span class="wp-hero__badge">99% vào đại học</span>
            <span class="wp-hero__badge">IELTS 6.0–8.0</span>
            <span class="wp-hero__badge">16 kỹ năng TK21</span>
            <span class="wp-hero__badge">Ngày càng khoẻ mạnh</span>
          </div>
        </div>
      </section>

      <!-- AIO Quick Answer -->
      <section class="aio-answer">
        <div class="aio-answer__inner">
          <p class="aio-answer__text">
            <strong>Trường Việt Anh</strong> thành lập năm 2011 tại TP HCM, là lựa chọn yêu thích của các gia đình trí thức trung lưu, khao khát với giáo dục hiện đại, kỳ vọng cao ở kỹ năng và phẩm chất của học sinh. Học sinh Việt Anh trải nghiệm quãng thời gian học tập vui vẻ, hạnh phúc, ra trường với các kỹ năng, phẩm chất lãnh đạo của thế kỷ 21, giành được quyền chọn của riêng mình với các trường đại học danh giá trong và ngoài nước.
          </p>
        </div>
      </section>

      <!-- REST OF HOMEPAGE CONTENT -->
      <div class="page-flow">

        <section class="section-block section-block--stats anchor-section">
          <div class="stats-grid">
            <article class="stat-tile">
              <strong>2011</strong>
              <span>Năm hình thành</span>
            </article>
            <article class="stat-tile">
              <strong>6.0+</strong>
              <span>IELTS là tiêu chuẩn tiếng Anh đầu ra tối thiểu</span>
            </article>
            <article class="stat-tile">
              <strong>99%</strong>
              <span>Tỷ lệ học sinh vào đại học</span>
            </article>
            <article class="stat-tile">
              <strong>95%</strong>
              <span>Học sinh tiến bộ hàng năm trên 4 lĩnh vực phát triển</span>
            </article>
          </div>

          <!-- TRUST LOGOS -->
          <div class="trust-logos">
            <span class="trust-logos__label">Được công nhận bởi</span>
            <div class="trust-logos__row">
              <div class="trust-logo-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1B2A5B" stroke-width="2"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg>
                <span>Franklin Covey — Leader in Me</span>
              </div>
              <div class="trust-logo-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1B2A5B" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2zM22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                <span>Oxford University Press</span>
              </div>
              <div class="trust-logo-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1B2A5B" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                <span>British Council — IELTS Test Center</span>
              </div>
              <div class="trust-logo-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1B2A5B" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                <span>Birmingham City University</span>
              </div>
            </div>
          </div>
        </section>

        <!-- 5 NEN TANG TRIET LY GIAO DUC -->
        <section class="section-block anchor-section">
          <div class="section-heading">
            <p class="section-eyebrow">Triết lý giáo dục</p>
            <h2>Trường Việt Anh xây dựng triết lý giáo dục trên 5 nền tảng</h2>
          </div>
          <div class="pillar-grid">
            <article class="pillar-card">
              <span class="pillar-card__num">01</span>
              <h3 class="pillar-card__title">Tiếp thu tinh hoa thế giới, nhưng triển khai phù hợp với Việt Nam</h3>
              <p class="pillar-card__lead">Trường Việt Anh học hỏi từ thế giới, không phải "bắt chước".</p>
              <p>Chúng ta chọn cái tiến bộ nhất của thế giới, rồi biến nó thành trải nghiệm học tập thực sự vận hành được với học sinh Việt Nam và gia đình Việt Nam.</p>
            </article>
            <article class="pillar-card">
              <span class="pillar-card__num">02</span>
              <h3 class="pillar-card__title">Chất lượng cao nhưng không xây trên logic xa xỉ</h3>
              <p class="pillar-card__lead">Giáo dục tốt không nên là đặc quyền của nhà giàu.</p>
              <p>Chúng ta xây dựng nền giáo dục chất lượng, nhưng chỉ có giá trị nếu vẫn trong tầm với của những gia đình trung lưu có trách nhiệm.</p>
            </article>
            <article class="pillar-card">
              <span class="pillar-card__num">03</span>
              <h3 class="pillar-card__title">Không hy sinh tuổi thơ để đổi lấy thành tích</h3>
              <p class="pillar-card__lead">Trẻ em xứng đáng có được niềm vui học tập, sự an toàn cảm xúc, và động lực phát triển bền vững.</p>
              <p>Chúng ta không để đứa trẻ nào phải trả giá bằng sự mệt mỏi để có kết quả.</p>
            </article>
            <article class="pillar-card">
              <span class="pillar-card__num">04</span>
              <h3 class="pillar-card__title">Học là để dùng được, sống được, phát triển được</h3>
              <p class="pillar-card__lead">Thực dụng là chỉ học cái có giá trị thật, rèn cái dùng được thật, phát triển cái giúp trẻ sống tốt thật.</p>
              <p>Năng lực học tập không chỉ thể hiện trên bài thi, mà phải có thể chuyển hóa thành kết quả dài hạn.</p>
            </article>
            <article class="pillar-card pillar-card--wide">
              <span class="pillar-card__num">05</span>
