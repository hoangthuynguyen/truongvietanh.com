---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import { defaultSiteUrl } from '../lib/site-content';
import { getTestimonials } from '../lib/directus';

const siteUrl = import.meta.env.PUBLIC_SITE_URL || defaultSiteUrl;

// Fetch from CMS
const cmsTestimonials = await getTestimonials('index');

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'EducationalOrganization',
    name: 'Trường Liên Cấp Việt Anh',
    alternateName: 'Truong Viet Anh',
    url: 'https://truongvietanh.com',
    logo: 'https://truongvietanh.com/logo-crest-80.webp',
    telephone: '+84-916-961-409',
    description: 'Hệ thống giáo dục liên cấp song ngữ tại TP.HCM, đào tạo từ Mầm Non đến THPT với chương trình tích hợp 16 kỹ năng thế kỷ 21, cam kết IELTS 6.0+ đầu ra.',
    foundingDate: '2011',
    address: [
      { '@type': 'PostalAddress', streetAddress: '160/72 Phan Huy Ích, Phường 12', addressLocality: 'Quận Gò Vấp', addressRegion: 'TP.HCM', addressCountry: 'VN' },
      { '@type': 'PostalAddress', streetAddress: '269A Nguyễn Trọng Tuyển, Phường 10', addressLocality: 'Quận Phú Nhuận', addressRegion: 'TP.HCM', addressCountry: 'VN' },
      { '@type': 'PostalAddress', streetAddress: '951/7 Tỉnh lộ 10, Phường Tân Tạo', addressLocality: 'Quận Bình Tân', addressRegion: 'TP.HCM', addressCountry: 'VN' },
    ],
    sameAs: ['https://www.facebook.com/truongvietanhhcm', 'https://www.youtube.com/@truongvietanh', 'https://www.instagram.com/truongvietanh', 'https://zalo.me/0916961409'],
    numberOfEmployees: { '@type': 'QuantitativeValue', value: 500 },
    contactPoint: { '@type': 'ContactPoint', telephone: '+84916961409', contactType: 'customer service', areaServed: 'VN', availableLanguage: ['vi', 'en'] },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Trường Việt Anh',
    alternateName: 'Trường Liên Cấp Việt Anh',
    url: 'https://truongvietanh.com',
    inLanguage: 'vi',
    description: 'Hệ thống giáo dục liên cấp song ngữ Anh-Việt từ Mầm Non đến THPT tại TP.HCM, Long An, Kiên Giang.',
    potentialAction: {
      '@type': 'SearchAction',
      target: 'https://truongvietanh.com/tin-tuc?q={search_term_string}',
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Trường Việt Anh dạy từ cấp nào đến cấp nào?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Trường Việt Anh là hệ thống giáo dục liên cấp, đào tạo từ Mầm Non (2 tuổi) đến THPT (lớp 12), với 9 cơ sở tại TP.HCM, Long An và Kiên Giang.',
        },
      },
      {
        '@type': 'Question',
        name: 'Học phí Trường Việt Anh bao nhiêu?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Học phí Trường Việt Anh dao động từ 5 đến 12 triệu đồng/tháng tuỳ cấp học, bao gồm chương trình song ngữ tích hợp Cambridge, giáo viên bản ngữ và 16 kỹ năng thế kỷ 21.',
        },
      },
      {
        '@type': 'Question',
        name: 'Học sinh tốt nghiệp Trường Việt Anh đạt IELTS bao nhiêu?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Học sinh THPT Việt Anh tốt nghiệp đạt IELTS từ 6.0 đến 8.0, trung bình đầu ra là IELTS 6.5. Trường cũng là trung tâm khảo thí IELTS tại TP.HCM.',
        },
      },
      {
        '@type': 'Question',
        name: 'Trường Việt Anh có bao nhiêu cơ sở?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Trường Việt Anh hiện có 9 cơ sở tại 3 tỉnh thành: TP.HCM (Gò Vấp, Phú Nhuận, Bình Tân), Cần Giuộc - Long An và TP. Rạch Giá - Kiên Giang.',
        },
      },
      {
        '@type': 'Question',
        name: 'Phương pháp giáo dục PDR của Trường Việt Anh là gì?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'PDR (Play – Discover – Reflect) là phương pháp giáo dục do Trường Việt Anh nghiên cứu và phát triển từ 2011, đặt học sinh làm trung tâm qua 3 giai đoạn: vui chơi có mục đích, khám phá chuyên sâu và phản tư tự đánh giá.',
        },
      },
      {
        '@type': 'Question',
        name: 'Làm sao để đăng ký tuyển sinh Trường Việt Anh?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Phụ huynh có thể đăng ký tư vấn tuyển sinh trực tiếp trên website truongvietanh.com, gọi hotline 0916 961 409, hoặc đặt lịch tham quan trường để được tư vấn chi tiết.',
        },
      },
      {
        '@type': 'Question',
        name: 'Học phí Trường Việt Anh bao nhiêu?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Học phí dao động từ 5-12 triệu/tháng tùy cấp học và chương trình. So với trường quốc tế (15-30 triệu), Việt Anh mang đến chất lượng tương đương với mức phí hợp lý hơn nhiều.',
        },
      },
      {
        '@type': 'Question',
        name: 'Trình độ tiếng Anh đầu ra của học sinh Trường Việt Anh?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Học sinh tốt nghiệp THPT đạt tối thiểu IELTS 6.0, nhiều em đạt 7.0-8.0. Đây là mức đủ để xét tuyển vào hầu hết đại học thế giới và nhận học bổng du học.',
        },
      },
    ],
  },
];

const productLinks = [
  { label: 'Mầm non', href: '/mam-non' },
  { label: 'Tiểu học', href: '/tieu-hoc' },
  { label: 'THCS', href: '/trung-hoc-co-so' },
  { label: 'THPT', href: '/trung-hoc-pho-thong' },
  { label: 'Trại hè', href: '/tuyen-sinh' },
  { label: 'Tiếng Anh Trẻ Em', href: '/tuyen-sinh' },
  { label: 'Toán Tư Duy', href: '/tuyen-sinh' },
  { label: 'Giải Mã Tiềm Năng', href: '/tuyen-sinh' },
];

const campusLinks = [
  { label: 'Trường Mầm non Việt Anh Gò Vấp - HCM', href: '/co-so' },
  { label: 'Trường TiH THCS THPT Việt Anh Gò Vấp - HCM', href: '/co-so' },
  { label: 'Trường TiH THCS THPT Việt Anh Bình Tân - HCM', href: '/co-so' },
  { label: 'Trường Mầm non Nhân Lễ - Xã Cần Giuộc - Tây Ninh', href: '/co-so' },
  { label: 'Trường MN và TiH Thái Sơn - Xã Cần Giuộc - Tây Ninh', href: '/co-so' },
  { label: 'Trường MN và TiH Mekong Xanh - TP Rạch Giá - An Giang', href: '/co-so' },
];


// Testimonials — from Google Sheet data, with individual photos
const testimonials = cmsTestimonials.length > 0
  ? cmsTestimonials.map((t: any) => ({ name: t.name, role: t.role, quote: t.quote, img: t.image || '' }))
  : [
    {
      name: 'Chị Mai',
      role: 'Phụ huynh bé Phúc, Tiểu học lớp 3',
      quote: 'Những gì mà lúc đầu thầy cô tư vấn cho chị thì sau 2 năm, chị thấy là đều có trong chương trình học của con hết.',
      img: 'https://media.truongvietanh.com/images/phu-huynh-mai.webp',
    },
    {
      name: 'Phụ huynh Quốc Long',
      role: 'Phụ huynh có nhiều con theo học',
      quote: 'Bé có những sở thích như coi điện thoại hay chơi game nhưng bé tự mình điều tiết nó, không có quá sa đà vào nó.',
      img: 'https://media.truongvietanh.com/images/phu-huynh-quoclong.webp',
    },
    {
      name: 'Chị Kim Trinh',
      role: 'Phụ huynh Tiểu học',
      quote: 'Cô giáo cũng đồng cảm, cũng chia sẻ và giúp cho mình làm sao để mình có thể gần con hơn.',
      img: 'https://media.truongvietanh.com/images/phu-huynh-kimtrinh.webp',
    },
    {
      name: 'Chị Hoàng Diễm',
      role: 'Phụ huynh có 2 con theo học',
      quote: 'Trường Việt Anh luôn luôn cải tiến chương trình học và cập nhật kiến thức.',
      img: 'https://media.truongvietanh.com/images/phu-huynh-hoangdiem.webp',
    },
    {
      name: 'Chị Anh Đào',
      role: 'Nhà giáo dục & Phụ huynh',
      quote: 'Phụ huynh phải là người hiểu con mình nhất, hiểu được cái điểm mạnh cũng như điểm yếu của con.',
      img: 'https://media.truongvietanh.com/images/phu-huynh-anhdao.webp',
    },
    {
      name: 'Chị Nguyễn Tuyết Trinh',
      role: 'Phụ huynh THPT',
      quote: 'Rất an tâm, nhiệt huyết và tin tưởng vào sự tận tụy của thầy cô.',
      img: 'https://media.truongvietanh.com/images/phu-huynh-tuyettrinh.webp',
    },
  ];

const newsCards = [
  {
    eyebrow: 'Tuyển sinh 2026 - 2027',
    title: 'Lộ trình tuyển sinh nên là một trong những đường đi rõ nhất từ trang chủ',
    body:
      'Phụ huynh cần biết quy trình, hồ sơ, lịch tuyển sinh và bước tiếp theo ngay từ trang chủ mà không phải lạc vào các bài nội dung phụ.',
    href: '/tuyen-sinh',
    cta: 'Xem lộ trình tuyển sinh',
    img: 'https://media.truongvietanh.com/images/trang-chu-3.webp',
  },
  {
    eyebrow: 'Học phí & học bổng',
    title: 'Học phí minh bạch nên đi cùng tư vấn rõ ràng và định vị giá trị thật',
    body:
      'Đây là nhóm nội dung có tác động chuyển đổi cao, nên được đặt đủ sớm để phụ huynh có thể tiếp tục hành trình mà không phải đoán.',
    href: '/hoc-phi',
    cta: 'Xem học phí',
    img: 'https://media.truongvietanh.com/images/trang-chu-5.webp',
  },
  {
    eyebrow: 'Hoạt động & câu chuyện',
    title: 'Tin tức nên ưu tiên hoạt động học sinh, sự kiện gần và câu chuyện tiến bộ',
    body:
      'Đây là nơi phù hợp để đưa phụ huynh tới những nội dung tạo niềm tin như hoạt động học sinh, ngày hội tuyển sinh và cảm nhận thật từ phụ huynh.',
    href: '/tin-tuc',
    cta: 'Xem tin tức mới nhất',
    img: 'https://media.truongvietanh.com/images/trang-chu-7.webp',
  },
];
---

<BaseLayout
  title="Trường Việt Anh | Hệ thống trường học liên cấp từ Mầm non đến THPT"
  description="Trường Việt Anh — hệ thống giáo dục liên cấp song ngữ tại TP.HCM. Tiếng Anh IELTS 6.0-8.0, kỹ năng thế kỷ 21, 99% đỗ ĐH. Học phí từ 5 triệu/tháng."
  canonical="https://truongvietanh.com"
  ogImage="https://media.truongvietanh.com/images/trang-chu-3.webp"
  structuredData={structuredData}
>
  <div class="site-shell site-shell--home">
    <SiteHeader currentPath="/" />

    <main>
      <!-- DARK HERO -->
      <section class="wp-hero">
        <div class="wp-hero__overlay"></div>
        <div class="wp-hero__content">
          <h1 class="wp-hero__title">Trường Việt Anh</h1>
          <p class="wp-hero__subtitle">Hệ thống trường học liên cấp từ Mầm non đến THPT</p>
          <p class="wp-hero__desc">
            Môi trường học tập vui vẻ và thực dụng
          </p>
          <div class="wp-hero__actions">
            <a class="wp-hero__btn wp-hero__btn--primary" href="#danh-gia">Xem đánh giá</a>
            <a class="wp-hero__btn wp-hero__btn--outline" href="/hoc-phi">Xem học phí</a>
            <a class="wp-hero__btn wp-hero__btn--outline" href="https://zalo.me/1678310120468101523" target="_blank" rel="noreferrer">Chat ngay</a>
          </div>
          <div class="wp-hero__badges">
            <span class="wp-hero__badge">Đầu ra tiếng Anh IELTS 6.0-8.0</span>
            <span class="wp-hero__badge">99% vào đại học</span>
            <span class="wp-hero__badge">Kỹ năng và phẩm chất thế kỷ 21</span>
          </div>
        </div>
      </section>

      <!-- AIO Quick Answer -->
      <section class="aio-answer">
        <div class="aio-answer__inner">
          <p class="aio-answer__text">
            <strong>Trường Việt Anh</strong> thành lập năm 2011 tại TP HCM, là lựa chọn yêu thích của các gia đình trí thức trung lưu, khao khát với giáo dục hiện đại, kỳ vọng cao ở kỹ năng và phẩm chất của học sinh. Học sinh Việt Anh trải nghiệm quãng thời gian học tập vui vẻ, hạnh phúc, ra trường với các kỹ năng, phẩm chất lãnh đạo của thế kỷ 21, giành được quyền chọn của riêng mình với các trường đại học danh giá trong và ngoài nước.
          </p>
        </div>
      </section>

      <!-- REST OF HOMEPAGE CONTENT -->
      <div class="page-flow">

        <section class="section-block section-block--stats anchor-section">
          <div class="stats-grid">
            <article class="stat-tile">
              <strong>2011</strong>
              <span>Năm hình thành</span>
            </article>
            <article class="stat-tile">
              <strong>6.0+</strong>
              <span>IELTS là tiêu chuẩn tiếng Anh đầu ra tối thiểu</span>
            </article>
            <article class="stat-tile">
              <strong>99%</strong>
              <span>Tỷ lệ học sinh vào đại học</span>
            </article>
            <article class="stat-tile">
              <strong>95%</strong>
              <span>Học sinh tiến bộ hàng năm trên 4 lĩnh vực phát triển</span>
            </article>
          </div>
        </section>

        <!-- 3 KHAC BIET CUA HOC SINH VIET ANH -->
        <section class="section-block anchor-section">
          <div class="section-heading">
            <p class="section-eyebrow">Điểm khác biệt</p>
            <h2>3 khác biệt của học sinh Việt Anh</h2>
          </div>

          <div class="why-blocks">
            <!-- Block 1 -->
            <article class="why-block why-block--with-img">
              <div class="why-block__text">
                <h3 class="why-block__title">1. Nội dung học thực dụng</h3>
                <div class="why-block__content">
                  <p>Học sinh được phát triển đầy đủ 16 kỹ năng thế kỷ 21 theo chuẩn WEF, nội dung mà các trường K-12 hàng đầu thế giới đang thực hiện.</p>
                  <details class="why-block__more">
                    <summary>Đọc thêm</summary>
                    <p>Nghiên cứu của WEF chỉ ra, trong khi các nước tiên tiến đã đầu tư đủ 16 kỹ năng trong giáo dục, mặt bằng chung của Việt Nam còn đang thiếu hụt. Trường Việt Anh dày công xây dựng chương trình phát triển đầy đủ 16 kỹ năng qua các môn học, hoạt động ngoại khoá và văn hoá trường học. Giáo trình cập nhật mỗi năm để đáp ứng sự biến đổi của xã hội do cách mạng AI mang lại.</p>
                  </details>
                </div>
              </div>
              <img src="https://media.truongvietanh.com/images/hoc-sinh-stem-01.webp" alt="Học sinh Việt Anh trong giờ STEM" loading="lazy" width="500" height="340" class="why-block__img" />
            </article>

            <!-- Block 2 -->
            <article class="why-block why-block--with-img">
              <div class="why-block__text">
                <h3 class="why-block__title">2. Tiếng Anh đủ du học</h3>
                <div class="why-block__content">
                  <p>Học sinh đạt tối thiểu IELTS 6.0 trước khi tốt nghiệp THPT — đủ điều kiện xét tuyển hầu hết các đại học trên thế giới.</p>
                  <details class="why-block__more">
                    <summary>Đọc thêm</summary>
                    <p>Lộ trình tiếng Anh xuyên suốt từ Mầm Non (100% immersion), Tiểu học (giáo trình UK Cambridge), THCS (giao tiếp + học thuật), đến THPT (luyện IELTS). Tổ Tiếng Anh do giáo viên bản ngữ phụ trách, trường cũng là trung tâm khảo thí IELTS tại TP HCM. Chương trình tiếng Anh được hợp tác triển khai ở hơn 100 trường công tư khác.</p>
                  </details>
                </div>
              </div>
              <img src="https://media.truongvietanh.com/images/tieng-anh-02.webp" alt="Học sinh Việt Anh học tiếng Anh" loading="lazy" width="500" height="340" class="why-block__img" />
            </article>

            <!-- Block 3 -->
            <article class="why-block why-block--with-img">
              <div class="why-block__text">
                <h3 class="why-block__title">3. Học sinh sớm trưởng thành</h3>
                <div class="why-block__content">
                  <p>Học sinh được rèn năng lực lãnh đạo bản thân từ sớm, dần mở rộng ảnh hưởng ra đội nhóm, lớp học và xã hội.</p>
                  <details class="why-block__more">
                    <summary>Đọc thêm</summary>
                    <p>Chương trình xây dựng trên 5 giá trị cốt lõi và 7 thói quen lãnh đạo (chương trình "Leader in Me" từ Franklin Covey). Phụ huynh tham quan trường đều ngạc nhiên khi thấy dấu ấn của học sinh ở khắp nơi — từ cơ sở vật chất, ngày lễ đến văn hoá và chính sách nhà trường.</p>
                  </details>
                </div>
              </div>
              <img src="https://media.truongvietanh.com/images/lanh-dao-03.webp" alt="Học sinh Việt Anh phát triển kỹ năng lãnh đạo" loading="lazy" width="500" height="340" class="why-block__img" />
            </article>
          </div>
        </section>


        <!-- DANH GIA CUA PHU HUYNH -->
        <section class="section-block anchor-section" id="danh-gia">
          <div class="section-heading">
            <p class="section-eyebrow">Đánh giá của phụ huynh</p>
            <h2>Lời chia sẻ từ học sinh và phụ huynh là một trong những bằng chứng thuyết phục nhất.</h2>
          </div>

          <div class="testimonial-grid">
            {testimonials.map((item) => (
              <article class="testimonial-card">
                <div class="testimonial-card__avatar">
                  <img src={item.img || 'https://media.truongvietanh.com/images/phu-huynh-04.webp'} alt={item.name} loading="lazy" width="80" height="80" />
                </div>
                <blockquote class="testimonial-card__quote">
                  <p>&ldquo;{item.quote}&rdquo;</p>
                </blockquote>
                <div class="testimonial-card__info">
                  <strong>{item.name}</strong>
                  <span>{item.role}</span>
                </div>
              </article>
            ))}
          </div>
        </section>

        <!-- BLOCK LINKS - San pham va co so -->
        <section class="section-block anchor-section" id="san-pham">
          <div class="section-heading">
            <p class="section-eyebrow">Sản phẩm giáo dục</p>
            <h2>Khám phá các chương trình của Trường Việt Anh</h2>
          </div>

          <div class="program-grid">
            {productLinks.map((card) => (
              <a class="program-card" href={card.href}>
                <span class="program-card__label">{card.label}</span>
                <span class="program-card__arrow">&#8594;</span>
              </a>
            ))}
          </div>

          <div class="section-heading" style="margin-top:2.5rem">
            <p class="section-eyebrow">Hệ thống cơ sở</p>
            <h2>Các trường trong hệ thống Việt Anh</h2>
          </div>

          <div class="program-grid program-grid--campuses">
            {campusLinks.map((card) => (
              <a class="program-card" href={card.href}>
                <span class="program-card__label">{card.label}</span>
                <span class="program-card__arrow">&#8594;</span>
              </a>
            ))}
          </div>
        </section>

        <!-- BLOG -->
        <section class="section-block anchor-section" id="tin-tuc">
          <div class="section-heading">
            <p class="section-eyebrow">Blog</p>
            <h2>Tin tức, hoạt động và câu chuyện từ cộng đồng Việt Anh.</h2>
          </div>

          <div class="card-grid card-grid--3">
            {newsCards.map((item) => (
              <article class="content-card">
                {item.img && <img src={item.img} alt={item.title} class="card-img" width="600" height="400" loading="lazy" decoding="async" />}
                <p class="card-eyebrow">{item.eyebrow}</p>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
                <a class="card-link" href={item.href}>
                  {item.cta}
                </a>
              </article>
            ))}
          </div>
        </section>

        <!-- FAQ cho homepage -->
        <section class="section-block anchor-section" id="faq">
          <div class="section-heading">
            <p class="section-eyebrow">Câu hỏi thường gặp</p>
            <h2>Phụ huynh thường hỏi gì về Trường Việt Anh?</h2>
          </div>
          <div class="faq-list" style="max-width:800px">
            <details class="faq-item">
              <summary class="faq-question">Trường Việt Anh tuyển sinh những cấp học nào?</summary>
              <p class="faq-answer">Trường Việt Anh tuyển sinh 4 cấp: Mầm Non (từ 18 tháng), Tiểu Học (lớp 1-5), THCS (lớp 6-9) và THPT (lớp 10-12). Hệ thống liên cấp giúp con được đào tạo xuyên suốt mà không bị gián đoạn chương trình.</p>
            </details>
            <details class="faq-item">
              <summary class="faq-question">Học phí Trường Việt Anh bao nhiêu?</summary>
              <p class="faq-answer">Học phí dao động từ 5-12 triệu/tháng tùy cấp học và chương trình. So với trường quốc tế (15-30 triệu), Việt Anh mang đến chất lượng tương đương với mức phí hợp lý hơn nhiều. Xem chi tiết tại trang <a href="/hoc-phi">Học phí</a>.</p>
            </details>
            <details class="faq-item">
              <summary class="faq-question">Trường Việt Anh có mấy cơ sở?</summary>
              <p class="faq-answer">Hiện tại Trường Việt Anh có 9 cơ sở tại 3 tỉnh thành: TP.HCM (Gò Vấp, Phú Nhuận, Bình Tân), Long An (Cần Giuộc) và Kiên Giang (Rạch Giá). Xem chi tiết tại trang <a href="/co-so">Hệ thống cơ sở</a>.</p>
            </details>
            <details class="faq-item">
              <summary class="faq-question">Làm sao để đăng ký tham quan trường?</summary>
              <p class="faq-answer">Phụ huynh đăng ký tham quan miễn phí bằng 3 cách: (1) Điền form trên website, (2) Gọi hotline <a href="tel:0916961409">0916 961 409</a>, hoặc (3) Nhắn Zalo. Buổi tham quan kéo dài 60-90 phút, bao gồm thăm cơ sở, gặp giáo viên và dự giờ lớp học.</p>
            </details>
            <details class="faq-item">
              <summary class="faq-question">Trình độ tiếng Anh đầu ra của học sinh Trường Việt Anh?</summary>
              <p class="faq-answer">Học sinh tốt nghiệp THPT tại Trường Việt Anh đạt tối thiểu IELTS 6.0, nhiều em đạt 7.0-8.0. Đây là mức đủ để xét tuyển vào hầu hết các đại học trên thế giới và nhận học bổng du học.</p>
            </details>
          </div>
        </section>

        <!-- People Also Ask / Related Topics -->
        <section class="section-block anchor-section" id="xem-them">
          <div class="section-heading">
            <p class="section-eyebrow">Phụ huynh cũng tìm hiểu</p>
            <h2>Các chủ đề liên quan</h2>
          </div>
          <div class="paa-grid">
            <a href="/mam-non" class="paa-card">
              <strong>Chương trình Mầm Non song ngữ phù hợp cho bé mấy tuổi?</strong>
              <span>Nhận trẻ từ 18 tháng, 100% tiếng Anh immersion, Montessori + STEAM</span>
            </a>
            <a href="/hoc-phi" class="paa-card">
              <strong>So sánh học phí Trường Việt Anh với trường quốc tế?</strong>
              <span>Chỉ bằng 1/3 trường quốc tế — 5 đến 15 triệu/tháng tùy cấp học</span>
            </a>
            <a href="/triet-ly-giao-duc" class="paa-card">
              <strong>Phương pháp PDR là gì và khác gì trường truyền thống?</strong>
              <span>Play – Discover – Reflect: học qua trải nghiệm thay vì nhồi nhét</span>
            </a>
            <a href="/thanh-tich" class="paa-card">
              <strong>Học sinh Trường Việt Anh thi đại học và du học thế nào?</strong>
              <span>99% đỗ ĐH nguyện vọng 1, 30% nhận học bổng du học, IELTS 6.0-8.0</span>
            </a>
            <a href="/co-so" class="paa-card">
              <strong>Trường Việt Anh có ở gần nhà tôi không?</strong>
              <span>9 cơ sở tại TP.HCM, Long An, Kiên Giang — có xe đưa đón</span>
            </a>
            <a href="/ngoai-khoa" class="paa-card">
              <strong>Con có thể tham gia CLB ngoại khóa nào?</strong>
              <span>20+ CLB: bóng đá, robotics, piano, debate, bơi lội và nhiều hơn</span>
            </a>
          </div>
        </section>

        <!-- CTA: NHAN BROCHURE -->
        <section class="section-block section-block--contact anchor-section" id="lien-he">
          <div class="section-heading">
            <p class="section-eyebrow">Brochure trường</p>
            <h2>Nhận Brochure của trường Việt Anh</h2>
            <p class="section-block--contact__desc">Để lại email để nhận brochure đầy đủ về chương trình, học phí và cơ sở</p>
          </div>

          <div class="form-wrapper">
            <LeadFormTwoStepEmailFirst
              formId="homepage-brochure-form"
              funnelCode="brochure-homepage"
              schoolLevel="lien-cap"
              submitText="Nhận Brochure miễn phí"
            />
          </div>
        </section>
      </div>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>

