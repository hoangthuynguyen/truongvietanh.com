<style is:global>
  /* Hero section - dark background */
  .wp-hero {
    position: relative;
    background: url('/hero-bg-home.jpg') center/cover no-repeat, linear-gradient(135deg, #0d1b3e 0%, #1a1a5e 40%, #162040 100%);
