<script>
  // Hero inline lead form — grade pill selection + POST to /api/lead
  (function () {
    const form = document.getElementById('hero-lead-form');
    if (!form) return;

    const successEl = form.parentElement?.querySelector('.hero-lead-success') as HTMLElement | null;
    let selectedLevel = '';

    // Grade pill toggle
    form.querySelectorAll<HTMLButtonElement>('.hlf-pill').forEach((btn) => {
      btn.addEventListener('click', () => {
        form.querySelectorAll('.hlf-pill').forEach((p) => p.classList.remove('is-active'));
        btn.classList.add('is-active');
        selectedLevel = btn.dataset.level || '';
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const phoneInput = form.querySelector<HTMLInputElement>('[name="phone"]');
      const phone = phoneInput?.value.trim() || '';
      if (!phone) { phoneInput?.focus(); return; }

      const submit = form.querySelector<HTMLButtonElement>('.hlf-submit');
      if (submit) { submit.disabled = true; submit.textContent = 'Đang gửi…'; }

      try {
        await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            step: 'hero_inline',
            phone,
            email: `hero-${Date.now()}@truongvietanh.com`,
            school_level: selectedLevel || 'unknown',
            source: 'homepage-hero',
            page: location.href,
            timestamp: new Date().toISOString(),
          }),
        });
      } catch (_) { /* silent — best-effort */ }

      // Show success regardless
      form.style.display = 'none';
      if (successEl) successEl.hidden = false;
    });
  })();
</script>
