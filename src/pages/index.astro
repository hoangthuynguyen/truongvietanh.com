---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { defaultSiteUrl } from '../lib/site-content';
import { getTestimonials, getCampuses } from '../lib/directus';

const siteUrl = import.meta.env.PUBLIC_SITE_URL || defaultSiteUrl;

// Fetch from CMS
const cmsTestimonials = await getTestimonials('index');
const cmsCampuses = await getCampuses();

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'EducationalOrganization',
    name: 'Trường Liên Cấp Việt Anh',
    alternateName: 'Truong Viet Anh',
    url: 'https://truongvietanh.com',
    logo: 'https://truongvietanh.com/logo-crest-80.webp',
    telephone: '+84-916-961-409',
    description: 'Hệ thống giáo dục liên cấp song ngữ tại TP.HCM, đào tạo từ Mầm Non đến THPT với chương trình tích hợp 16 kỹ năng thế kỷ 21, cam kết IELTS 6.0+ đầu ra.',
    foundingDate: '2011',
    address: [
      { '@type': 'PostalAddress', streetAddress: '160/72 Phan Huy Ích, Phường 12', addressLocality: 'Quận Gò Vấp', addressRegion: 'TP.HCM', addressCountry: 'VN' },
      { '@type': 'PostalAddress', streetAddress: '160/72 Phan Huy Ích, phường An Hội Tây, Thành phố Hồ Chí Minh', addressCountry: 'VN' },
      { '@type': 'PostalAddress', streetAddress: '951/7 Tỉnh lộ 10, Phường Tân Tạo', addressLocality: 'Quận Bình Tân', addressRegion: 'TP.HCM', addressCountry: 'VN' },
    ],
    sameAs: ['https://www.facebook.com/truongvietanhhcm', 'https://www.youtube.com/@truongvietanh', 'https://www.instagram.com/truongvietanh', 'https://zalo.me/1678310120468101523'],
    numberOfEmployees: { '@type': 'QuantitativeValue', value: 500 },
    contactPoint: { '@type': 'ContactPoint', telephone: '+84916961409', contactType: 'customer service', areaServed: 'VN', availableLanguage: ['vi', 'en'] },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Trường Việt Anh',
    alternateName: 'Trường Liên Cấp Việt Anh',
    url: 'https://truongvietanh.com',
    inLanguage: 'vi',
    description: 'Hệ thống giáo dục liên cấp song ngữ Anh-Việt từ Mầm Non đến THPT tại TP.HCM, Long An, Kiên Giang.',
    potentialAction: {
      '@type': 'SearchAction',
      target: 'https://truongvietanh.com/tin-tuc?q={search_term_string}',
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Trường Việt Anh dạy từ cấp nào đến cấp nào?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Trường Việt Anh là hệ thống giáo dục liên cấp, đào tạo từ Mầm Non (2 tuổi) đến THPT (lớp 12), với 9 cơ sở tại TP.HCM, Long An và Kiên Giang.',
        },
      },
      {
        '@type': 'Question',
        name: 'Học phí Trường Việt Anh bao nhiêu?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Học phí Trường Việt Anh dao động từ 5 đến 12 triệu đồng/tháng tuỳ cấp học, bao gồm chương trình song ngữ tích hợp Cambridge, giáo viên bản ngữ và 16 kỹ năng thế kỷ 21.',
        },
      },
      {
        '@type': 'Question',
        name: 'Học sinh tốt nghiệp Trường Việt Anh đạt IELTS bao nhiêu?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Học sinh THPT Việt Anh tốt nghiệp đạt IELTS từ 6.0 đến 8.0, trung bình đầu ra là IELTS 6.5. Trường cũng là trung tâm khảo thí IELTS tại TP.HCM.',
        },
      },
      {
        '@type': 'Question',
        name: 'Trường Việt Anh có bao nhiêu cơ sở?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Trường Việt Anh hiện có 9 cơ sở tại 3 tỉnh thành: TP.HCM (Gò Vấp, Phú Nhuận, Bình Tân), Cần Giuộc - Long An và TP. Rạch Giá - Kiên Giang.',
        },
      },
      {
        '@type': 'Question',
        name: 'Phương pháp giáo dục PDR của Trường Việt Anh là gì?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'PDR (Play – Discover – Reflect) là phương pháp giáo dục do Trường Việt Anh nghiên cứu và phát triển từ 2011, đặt học sinh làm trung tâm qua 3 giai đoạn: vui chơi có mục đích, khám phá chuyên sâu và phản tư tự đánh giá.',
        },
      },
      {
        '@type': 'Question',
        name: 'Làm sao để đăng ký tuyển sinh Trường Việt Anh?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Phụ huynh có thể đăng ký tư vấn tuyển sinh trực tiếp trên website truongvietanh.com, gọi hotline 0916 961 409, hoặc đặt lịch tham quan trường để được tư vấn chi tiết.',
        },
      },
      {
        '@type': 'Question',
        name: 'Học phí Trường Việt Anh bao nhiêu?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Học phí dao động từ 5-12 triệu/tháng tùy cấp học và chương trình. So với trường quốc tế (15-30 triệu), Việt Anh mang đến chất lượng tương đương với mức phí hợp lý hơn nhiều.',
        },
      },
      {
        '@type': 'Question',
        name: 'Trình độ tiếng Anh đầu ra của học sinh Trường Việt Anh?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Học sinh tốt nghiệp THPT đạt tối thiểu IELTS 6.0, nhiều em đạt 7.0-8.0. Đây là mức đủ để xét tuyển vào hầu hết đại học thế giới và nhận học bổng du học.',
        },
      },
    ],
  },
];

const programCards = [
  { label: 'Mầm non', href: '/mam-non' },
  { label: 'Tiểu học', href: '/tieu-hoc' },
  { label: 'THCS', href: '/trung-hoc-co-so' },
  { label: 'THPT', href: '/trung-hoc-pho-thong' },
  { label: 'Trại hè', href: '/tuyen-sinh' },
  { label: 'Ngoại khoá', href: '/tuyen-sinh' },
  { label: 'Toán Tư Duy (SAM)', href: '/tuyen-sinh' },
  { label: 'Tiếng Anh Trẻ Em', href: '/tuyen-sinh' },
  { label: 'Tiếng Anh Thực Dụng', href: '/tuyen-sinh' },
  { label: 'Bơi', href: '/tuyen-sinh' },
];

// Campuses — 100% from CMS, fallback if CMS down
const campusGroups = (() => {
  if (cmsCampuses.length > 0) {
    const cities = [...new Set(cmsCampuses.map((c: any) => c.city))];
    return cities.map(city => ({
      city, campuses: cmsCampuses.filter((c: any) => c.city === city).map((c: any) => ({ name: c.name, address: c.address }))
    }));
  }
  return [
    { city: 'TP. Hồ Chí Minh', campuses: [{ name: 'Trường Việt Anh Phan Huy Ích', address: '160/72 Phan Huy Ích, phường An Hội Tây, Thành phố Hồ Chí Minh' }] },
    { city: 'Long An', campuses: [{ name: 'Trường Mầm non Thái Sơn', address: 'KDC Thái Sơn' }] },
    { city: 'Kiên Giang', campuses: [{ name: 'Trường MN QT Mekong Xanh', address: 'Lô E7, Rạch Giá' }] },
  ];
})();

// Testimonials — 100% from CMS, fallback if CMS down
const testimonials = cmsTestimonials.length > 0
  ? cmsTestimonials.map((t: any) => ({ name: t.name, role: t.role, quote: t.quote }))
  : [
    { name: 'Nguyễn Ngọc Thị Giang', role: 'Học sinh lớp 7', quote: 'Từ một học sinh còn rụt rè, em dần tự tin hơn khi được khuyến khích nói và tìm ra điểm mạnh của mình.' },
    { name: 'Phụ huynh Hoàng Diễm', role: 'Cảm nhận phụ huynh', quote: 'Niềm tin đến từ cách trường chăm học sinh, cách giao tiếp với phụ huynh và tiến bộ nhìn thấy được.' },
    { name: 'Phụ huynh Thanh Hà', role: 'Cảm nhận phụ huynh', quote: 'Con thay đổi rõ rệt về tiếng Anh chỉ sau một học kỳ. Con thích đi học mỗi ngày.' },
  ];

const newsCards = [
  {
    eyebrow: 'Tuyển sinh 2026 - 2027',
    title: 'Lộ trình tuyển sinh nên là một trong những đường đi rõ nhất từ trang chủ',
    body:
      'Phụ huynh cần biết quy trình, hồ sơ, lịch tuyển sinh và bước tiếp theo ngay từ trang chủ mà không phải lạc vào các bài nội dung phụ.',
    href: '/tuyen-sinh',
    cta: 'Xem lộ trình tuyển sinh',
    img: 'https://media.truongvietanh.com/images/trang-chu-3.webp',
  },
  {
    eyebrow: 'Học phí & học bổng',
    title: 'Học phí minh bạch nên đi cùng tư vấn rõ ràng và định vị giá trị thật',
    body:
      'Đây là nhóm nội dung có tác động chuyển đổi cao, nên được đặt đủ sớm để phụ huynh có thể tiếp tục hành trình mà không phải đoán.',
    href: '/hoc-phi',
    cta: 'Xem học phí',
    img: 'https://media.truongvietanh.com/images/trang-chu-5.webp',
  },
  {
    eyebrow: 'Hoạt động & câu chuyện',
    title: 'Tin tức nên ưu tiên hoạt động học sinh, sự kiện gần và câu chuyện tiến bộ',
    body:
      'Đây là nơi phù hợp để đưa phụ huynh tới những nội dung tạo niềm tin như hoạt động học sinh, ngày hội tuyển sinh và cảm nhận thật từ phụ huynh.',
    href: '/tin-tuc',
    cta: 'Xem tin tức mới nhất',
    img: 'https://media.truongvietanh.com/images/trang-chu-7.webp',
  },
];
---

<BaseLayout
  title="Trường Việt Anh | Hệ thống trường học liên cấp từ Mầm non đến THPT"
  description="Trường Việt Anh — hệ thống giáo dục liên cấp song ngữ tại TP.HCM. Tiếng Anh IELTS 6.0-8.0, kỹ năng thế kỷ 21, 99% đỗ ĐH. Học phí từ 5 triệu/tháng."
  canonical="https://truongvietanh.com"
  ogImage="https://media.truongvietanh.com/images/trang-chu-3.webp"
  structuredData={structuredData}
>
  <div class="site-shell site-shell--home">
    <SiteHeader currentPath="/" />

    <main>
      <!-- DARK HERO -->
      <section class="wp-hero">
        <div class="wp-hero__overlay"></div>
        <div class="wp-hero__content">
          <div class="wp-hero__urgency">🎓 Tuyển sinh năm học 2025–2026 đang mở — <a href="/tuyen-sinh" style="color:#D4A843;text-decoration:underline">Xem lịch tuyển sinh</a></div>
          <h1 class="wp-hero__title">Trường Việt Anh</h1>
          <p class="wp-hero__subtitle">Hệ thống trường học liên cấp từ Mầm non đến THPT</p>
          <p class="wp-hero__desc">
            Song ngữ Cambridge · IELTS 6.0–8.0 đầu ra · Học phí chỉ bằng ⅓ trường quốc tế
          </p>
          <div class="wp-hero__trust">
            <span><strong>13+</strong> năm</span>
            <span class="wp-hero__trust-dot">·</span>
            <span><strong>9</strong> cơ sở</span>
            <span class="wp-hero__trust-dot">·</span>
            <span><strong>99%</strong> đỗ ĐH NV1</span>
            <span class="wp-hero__trust-dot">·</span>
            <span>IELTS <strong>6–8</strong></span>
          </div>
          <div class="wp-hero__actions">
            <a class="wp-hero__btn wp-hero__btn--primary" href="/tuyen-sinh/tham-quan-truong">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
              Đăng ký tham quan miễn phí
            </a>
            <a class="wp-hero__btn wp-hero__btn--zalo" href="https://zalo.me/1678310120468101523" target="_blank" rel="noopener">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              Nhắn Zalo OA
            </a>
            <a class="wp-hero__btn wp-hero__btn--phone" href="tel:0916961409">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.13 12 19.79 19.79 0 0 1 1.06 3.43 2 2 0 0 1 3.05 1.25h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.09 8.91A16 16 0 0 0 13.09 14.91l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              0916 961 409
            </a>
          </div>
          <div class="wp-hero__badges">
            <span class="wp-hero__badge">Song ngữ Cambridge</span>
            <span class="wp-hero__badge">Leader in Me — Franklin Covey</span>
            <span class="wp-hero__badge">STEM từ lớp 3</span>
            <span class="wp-hero__badge">Xe đưa đón GPS</span>
          </div>
        </div>
      </section>

      <!-- AIO Quick Answer -->
      <section class="aio-answer">
        <div class="aio-answer__inner">
          <p class="aio-answer__text">
            <strong>Trường Việt Anh</strong> là hệ thống giáo dục liên cấp song ngữ tại TP.HCM, đào tạo từ Mầm Non đến THPT. Thành lập năm 2011, trường có 3 cơ sở tại Gò Vấp, Phú Nhuận và Bình Tân. Học sinh tốt nghiệp đạt IELTS 6.0–8.0, 99% đỗ đại học nguyện vọng 1, và 30% du học thành công. Học phí từ 5–12 triệu/tháng. Hotline tư vấn: <a href="tel:0916961409">0916 961 409</a>.
          </p>
        </div>
      </section>

      <!-- QUICK LEAD CAPTURE -->
      <section class="quick-lead-wrap">
        <div class="quick-lead-card">
          <div class="quick-lead-header">
            <h2 class="quick-lead-title">Nhận tư vấn miễn phí trong hôm nay</h2>
            <p class="quick-lead-sub">Để lại SĐT — đội ngũ tư vấn gọi lại trong vòng 30 phút</p>
          </div>
          <form class="quick-lead-form" id="homepage-lead-form" novalidate>
            <div class="quick-lead-grades">
              <span class="quick-lead-label">Con đang học:</span>
              <div class="grade-pills">
                <button type="button" class="grade-pill" data-level="mam-non">Mầm non</button>
                <button type="button" class="grade-pill" data-level="tieu-hoc">Tiểu học</button>
                <button type="button" class="grade-pill" data-level="thcs">THCS</button>
                <button type="button" class="grade-pill" data-level="thpt">THPT</button>
              </div>
            </div>
            <div class="quick-lead-inputs">
              <input type="text" name="fullName" placeholder="Tên phụ huynh" required autocomplete="name" class="quick-input" />
              <input type="tel" name="phone" placeholder="Số điện thoại" required autocomplete="tel" inputmode="numeric" class="quick-input" />
              <button type="submit" class="quick-submit">
                Gọi tôi tư vấn
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </button>
            </div>
            <p class="quick-lead-privacy">🔒 Thông tin được bảo mật — không spam, không chia sẻ</p>
          </form>
          <div class="quick-lead-success" hidden>
            <div class="quick-lead-success-inner">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              <div>
                <strong>Đã nhận thông tin!</strong>
                <p>Tư vấn viên sẽ gọi cho bạn trong vòng 30 phút (trong giờ làm việc 7:00–17:00).</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- REST OF HOMEPAGE CONTENT -->
      <div class="page-flow">

        <section class="section-block section-block--stats anchor-section">
          <div class="section-heading">
            <p class="section-eyebrow">Con số nổi bật</p>
            <h2>Những chỉ dấu giúp phụ huynh hình dung nhanh quy mô, định hướng và kết quả học tập của Việt Anh.</h2>
          </div>

          <div class="stats-grid">
            <article class="stat-tile">
              <strong>2011</strong>
              <span>Năm hình thành và phát triển hệ thống giáo dục Việt Anh</span>
            </article>
            <article class="stat-tile">
              <strong>6.0+</strong>
              <span>IELTS là chuẩn đầu ra tiếng Anh được nhấn mạnh xuyên suốt trong thông điệp tuyển sinh</span>
            </article>
            <article class="stat-tile">
              <strong>99%</strong>
              <span>Tỷ lệ học sinh vào đại học là chỉ số tạo niềm tin mạnh với nhiều phụ huynh</span>
            </article>
            <article class="stat-tile">
              <strong>16/16</strong>
              <span>16 kỹ năng thế kỷ 21 cho thấy định hướng phát triển toàn diện, không chỉ tập trung điểm số</span>
            </article>
          </div>

          <img src="https://media.truongvietanh.com/images/giao-vien-30.webp" alt="Đội ngũ giáo viên Trường Việt Anh" loading="lazy" width="1200" height="auto" class="section-img" />
        </section>

        <!-- TAI SAO CHON TRUONG VIET ANH -->
        <section class="section-block anchor-section">
          <div class="section-heading">
            <p class="section-eyebrow">Tại sao chọn Trường Việt Anh</p>
            <h2>Những lý do cốt lõi khiến Việt Anh khác biệt trong mắt nhiều gia đình đang tìm trường tại TP.HCM.</h2>
          </div>

          <div class="why-blocks">
            <!-- Block 1 -->
            <article class="why-block">
              <h3 class="why-block__title">Nội dung học thực dụng</h3>
              <div class="why-block__content">
                <p>Học sinh được học tập đầy đủ <strong>16 kỹ năng thế kỷ 21</strong> theo tiêu chuẩn WEF — nền tảng để thành công trong thế giới AI và toàn cầu hóa.</p>
                <ul class="why-list">
                  <li>16/16 kỹ năng WEF tích hợp trong chương trình học, ngoại khóa và văn hóa trường</li>
                  <li>Chương trình cập nhật hàng năm — không cứng nhắc, không nhồi nhét thuộc lòng</li>
                  <li>STEM, Robotics, Lập trình từ lớp 3 — thực hành qua dự án thực tế</li>
                  <li>20+ CLB ngoại khóa: bóng đá, debate, piano, bơi lội, robotics…</li>
                </ul>
              </div>
            </article>

            <!-- Block 2 -->
            <article class="why-block">
              <h3 class="why-block__title">Tiếng Anh đủ du học</h3>
              <div class="why-block__content">
                <p><strong>Cam kết đầu ra IELTS 6.0–8.0</strong> trước khi tốt nghiệp THPT — đủ xét tuyển đại học quốc tế và nhận học bổng.</p>
                <ul class="why-list">
                  <li>Mầm Non: 100% tiếng Anh immersion với giáo viên bản ngữ</li>
