---
// =====================================================================
// /ketnoi-mam-non/ — Trang kết nối phụ huynh MẦM NON
// Một trang tĩnh: 3 kênh chính thức, mỗi kênh một MÃ QR + một NÚT bấm.
// Không có ?lop= như /ketnoi — mầm non không chia nhóm Zalo theo lớp.
//
// Vì sao vừa QR vừa nút (đừng bỏ bớt một trong hai):
//   · Chiếu lên màn hình ở buổi họp phụ huynh / in dán bảng tin → ba mẹ QUÉT mã.
//   · Ba mẹ mở link trên điện thoại (quét mã CHUNG, nhận qua Zalo) → điện thoại
//     không tự quét được mã đang hiện trên chính màn hình của nó → cần NÚT.
//
// Link nằm ở src/data/ketnoi-mam-non.ts — sửa ở đó rồi sinh lại QR bằng
// scripts/sinh-qr-ketnoi-mam-non.mjs. Trang này KHÔNG có form lead (không POST
// /api/lead) nên không gắn UTM. Trang tiện ích → noindex, đã loại khỏi sitemap
// trong astro.config.mjs.
// =====================================================================
import {
  KENH,
  HOTLINE,
  HOTLINE_TEL,
  DIA_CHI,
  EMAIL,
  URL_TRANG,
  duongDanQR,
} from '../data/ketnoi-mam-non';

// Icon nền tảng — cùng path với /ketnoi để hai trang nhìn giống nhau.
const ICON = {
  facebook: {
    mau: '#1877F2',
    d: 'M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.96h-1.51c-1.49 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07Z',
  },
  youtube: {
    mau: '#FF0000',
    d: 'M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19C0 8.08 0 12 0 12s0 3.92.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14C24 15.92 24 12 24 12s0-3.92-.5-5.81ZM9.6 15.57V8.43L15.82 12 9.6 15.57Z',
  },
} as const;

// Bơm xuống client cho hàm track(): chỉ cần id + tên sự kiện GA4.
const KNMN = { trang: 'ketnoi-mam-non', kenh: KENH.map((k) => ({ id: k.id, ev: k.ev })) };

const canonical = URL_TRANG;
const title = 'Kết nối cùng Mầm non Việt Anh — Facebook & YouTube chính thức';
const description =
  'Ba mẹ quét mã QR hoặc bấm nút để theo dõi 3 kênh chính thức: Facebook Mầm non Việt Anh, Facebook Trường Việt Anh và YouTube Trường Việt Anh.';
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#26275D" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <!-- JPG chứ không phải WebP: Zalo không dựng được preview từ WebP, dán link
         vào nhóm lớp sẽ ra thẻ trắng. 1200×630 là cỡ chuẩn Facebook/Zalo. -->
    <meta property="og:image" content="https://truongvietanh.com/ketnoi-mam-non-og.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://truongvietanh.com/ketnoi-mam-non-og.jpg" />
    <link rel="preload" as="image" href="/ketnoi-mam-non-hero.webp" />

    <!-- ĐO LƯỢT BẤM: gắn THẲNG GA4, CỐ Ý không nạp GTM — cùng lý do với /ketnoi
         (2 container GTM kéo theo pixel Facebook/TikTok/Zalo + remarketing Google Ads,
         nặng gấp đôi và đẩy phụ huynh ĐANG HỌC vào tệp quảng cáo). Trang standalone
         không thừa hưởng tag từ BaseLayout nên bắt buộc phải có khối này, nếu không
         dataLayer.push ở cuối trang chỉ ghi vào mảng rỗng. Chi tiết: src/pages/ketnoi.astro -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-Q2V9JWSXCK"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', 'G-Q2V9JWSXCK');
    </script>
    <script is:inline define:vars={{ KNMN }}>
      window.__KNMN = KNMN;
    </script>

    <style>
      :root {
        --navy: #26275d;
        --navy-2: #1b1c45;
        --yellow: #f9dd0e;
        --bg: #f0f4f8;
        --ink: #1a1c33;
        --muted: #55597a;
        --line: #dde4ee;
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        font-size: 16px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }
      img { max-width: 100%; display: block; }
      a { color: inherit; }
      .sr-only {
        position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
        overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
      }

      /* ---------- Khung ---------- */
      .kn-shell { max-width: 560px; margin: 0 auto; }
      .kn-topbar {
        background: #fff;
        border-bottom: 3px solid var(--yellow);
        padding: 8px 16px;
        text-align: center;
      }
      .kn-topbar a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px; /* vùng chạm tối thiểu — ảnh logo chỉ cao 40px */
      }
      .kn-topbar img { height: 40px; width: auto; margin: 0 auto; }
      main { padding: 0 0 8px; }

      /* ---------- Hero ---------- */
      .kn-head {
        background: linear-gradient(160deg, var(--navy) 0%, var(--navy-2) 100%);
        color: #fff;
        padding: 20px 16px 20px;
        text-align: center;
      }
      /* Logo chữ "Trường Mầm non Việt Anh" — chữ vàng, chỉ đọc được trên nền navy,
         nên đặt trong hero chứ không đặt lên thanh trắng phía trên. */
      .kn-wordmark {
        width: min(280px, 84%);
        height: auto;
        margin: 0 auto 12px;
      }
      .kn-head h1 {
        margin: 0;
        font-size: 1.45rem;
        line-height: 1.22;
        font-weight: 800;
        letter-spacing: 0.2px;
        text-transform: uppercase;
      }
      .kn-sub {
        margin: 10px auto 0;
        max-width: 34rem;
        font-size: 0.95rem;
        color: #d8ddf2;
      }
      .kn-sub strong { color: var(--yellow); font-weight: 700; }
      .kn-photo {
        width: 100%;
        height: auto; /* bắt buộc: có height="540" thì aspect-ratio bị vô hiệu */
        aspect-ratio: 16 / 9;
        object-fit: cover;
        object-position: center 30%;
        background: var(--navy);
      }

      /* ---------- 3 kênh ---------- */
      .kn-steps { padding: 16px 16px 4px; }
      .kn-step + .kn-step { margin-top: 18px; }
      .kn-cta {
        display: flex;
        align-items: center;
        gap: 12px;
        min-height: 68px;
        padding: 12px 16px;
        border-radius: 14px;
        text-decoration: none;
        background: var(--navy);
        color: #fff;
        box-shadow: 0 4px 14px rgba(38, 39, 93, 0.22);
        transition: transform 0.12s ease, box-shadow 0.12s ease;
      }
      .kn-cta:active { transform: translateY(1px); box-shadow: 0 2px 8px rgba(38, 39, 93, 0.22); }
      .kn-num {
        flex: 0 0 auto;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-weight: 900;
        font-size: 0.95rem;
        background: rgba(255, 255, 255, 0.16);
        color: #fff;
      }
      .kn-icon {
        flex: 0 0 auto;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #fff;
        display: grid;
        place-items: center;
      }
      .kn-icon svg { width: 21px; height: 21px; display: block; }
      /* Nhãn 2 tầng: "FACEBOOK" lớn + "Mầm non Việt Anh" nhỏ — xuống dòng có
         chủ ý, để một dòng thì máy 360px tự tràn thành 2 dòng lệch. */
      .kn-label { flex: 1 1 auto; min-width: 0; line-height: 1.2; }
      .kn-label b {
        display: block;
        font-weight: 900;
        font-size: 1.02rem;
        text-transform: uppercase;
        letter-spacing: 0.4px;
      }
      .kn-label span {
        display: block;
        font-weight: 600;
        font-size: 0.82rem;
        opacity: 0.82;
        margin-top: 1px;
      }
      .kn-arrow { flex: 0 0 auto; opacity: 0.7; font-size: 1.1rem; }
      /* Bấm xong thì số thứ tự đổi thành dấu tích. */
      .kn-cta[data-done='1'] .kn-num { font-size: 0; background: #1a9d5c; color: #fff; }
      .kn-cta[data-done='1'] .kn-num::after { content: '✓'; font-size: 1rem; line-height: 1; }

      /* Mã QR: ảnh SVG có sẵn viền trắng (quiet zone 4 ô) nên không cần đệm thêm
         quanh ảnh. Mobile xếp ngang (mã trái, chữ phải) để tiết kiệm chiều cao. */
      .kn-qr {
        margin: 10px 0 0;
        padding: 10px 12px 10px 8px;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .kn-qr img { width: 132px; height: 132px; flex: 0 0 auto; }
      .kn-qr figcaption { font-size: 0.86rem; color: var(--muted); line-height: 1.45; }
      .kn-qr figcaption strong { color: var(--navy); }
      .kn-note { margin: 8px 4px 0; font-size: 0.875rem; color: var(--muted); }
      .kn-note strong { color: var(--navy); }

      /* ---------- Hoàn tất ---------- */
      .kn-done {
        margin: 20px 16px 18px;
        padding: 18px 16px;
        background: #fff;
        border: 1px solid var(--line);
        border-top: 4px solid var(--yellow);
        border-radius: 14px;
      }
      .kn-done h2 {
        margin: 0 0 12px;
        font-size: 1.05rem;
        text-transform: uppercase;
        color: var(--navy);
        letter-spacing: 0.4px;
      }
      .kn-done ul { margin: 0; padding: 0; list-style: none; }
      .kn-done li { position: relative; padding: 0 0 0 28px; margin-bottom: 7px; font-size: 0.93rem; }
      .kn-done li::before {
        content: '✓';
        position: absolute;
        left: 0;
        top: -1px;
        font-weight: 900;
        color: #1a9d5c;
      }
      .kn-thanks {
        margin: 14px 0 0;
        padding-top: 13px;
        border-top: 1px dashed var(--line);
        font-weight: 700;
        color: var(--navy);
        text-align: center;
      }

      /* ---------- Footer ---------- */
      footer {
        background: var(--navy);
        color: #cdd3ea;
        text-align: center;
        padding: 24px 16px 30px;
      }
      footer .kn-brand {
        font-weight: 900;
        color: #fff;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin: 0 0 4px;
      }
      footer p { margin: 0; font-size: 0.9rem; }
      footer .kn-addr { margin-bottom: 4px; }
      footer a { color: var(--yellow); text-decoration: none; }
      footer p a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 4px; }
      .kn-flinks {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 6px 18px;
        margin: 10px 0 0;
        padding: 0;
        list-style: none;
      }
      .kn-flinks a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: 0 4px;
        font-weight: 600;
        font-size: 0.9rem;
      }

      /* Bàn phím phải thấy được mình đang ở đâu. */
      a:focus-visible { outline: 3px solid #0b63d6; outline-offset: 3px; border-radius: 8px; }
      .kn-topbar a:focus-visible { outline-offset: 1px; }

      /* ---------- Từ 560px: khung thành thẻ nổi ---------- */
      @media (min-width: 560px) {
        .kn-shell { box-shadow: 0 10px 40px rgba(38, 39, 93, 0.1); background: #fff; }
        .kn-head h1 { font-size: 1.6rem; }
        .kn-qr img { width: 150px; height: 150px; }
      }

      /* ---------- Từ 760px: hero chia 2 cột (ảnh trái / chữ phải) ---------- */
      @media (min-width: 760px) {
        .kn-shell { max-width: 900px; }
        .kn-hero {
          display: grid;
          grid-template-columns: 1fr 1fr;
          background: linear-gradient(160deg, var(--navy) 0%, var(--navy-2) 100%);
        }
        .kn-head {
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: flex-start;
          text-align: left;
          padding: 28px 30px 28px 26px;
          background: none;
        }
        .kn-wordmark { width: min(300px, 100%); margin-left: 0; }
        .kn-sub { margin-left: 0; }
        .kn-qr img { width: 170px; height: 170px; } /* ô rộng cả khung → mã to hơn cho khỏi trống */
        .kn-photo {
          order: -1; /* ảnh sang cột trái */
          height: 100%;
          min-height: 300px;
          aspect-ratio: auto;
        }
      }

      /* ---------- Từ 1000px: 3 kênh xếp ngang, mã QR to để chiếu màn hình ---------- */
      @media (min-width: 1000px) {
        .kn-shell { max-width: 1060px; }
        .kn-photo { min-height: 340px; }
        .kn-head { padding: 34px 40px 34px 32px; }
        .kn-wordmark { width: 340px; }
        .kn-topbar { padding: 12px 16px; }
        .kn-topbar img { height: 52px; }
        .kn-head h1 { font-size: 1.85rem; }
        .kn-steps {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          gap: 18px;
          align-items: stretch;
          padding: 26px 26px 6px;
        }
        .kn-step + .kn-step { margin-top: 0; }
        .kn-step {
          display: flex;
          flex-direction: column;
          background: #f7f9fc;
          border: 1px solid var(--line);
          border-radius: 16px;
          padding: 16px 16px 18px;
        }
        .kn-label b { font-size: 0.95rem; letter-spacing: 0.2px; }
        .kn-cta { min-height: 76px; }
        /* Cột hẹp → mã QR xếp dọc, to hơn: đây là thứ ba mẹ quét từ màn chiếu. */
        .kn-qr { flex-direction: column; text-align: center; padding: 14px 14px 12px; margin-top: 14px; }
        .kn-qr img { width: 196px; height: 196px; }
        .kn-done { margin: 22px 26px 24px; }
        .kn-done ul { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 24px; }
        .kn-note { margin-left: 2px; margin-right: 2px; }
      }

      /* Chuột mới có hover — đừng để trạng thái hover dính trên màn cảm ứng. */
      @media (hover: hover) {
        .kn-cta:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(38, 39, 93, 0.28); }
        footer a:hover { text-decoration: underline; }
      }
      @media (prefers-reduced-motion: reduce) {
        .kn-cta { transition: none; }
        .kn-cta:hover { transform: none; }
      }

      /* ---------- In giấy: chỉ giữ tiêu đề + 3 mã QR, bỏ nút và trang trí ----------
         Ctrl+P là ra tờ dán bảng tin. Bản in đầy đủ hơn (kèm mã CHUNG) nằm ở
         docs/ketnoi-mam-non/qr/in-qr.html. */
      @media print {
        @page { margin: 12mm; }
        body { background: #fff; }
        .kn-shell { max-width: none; box-shadow: none; }
        .kn-topbar, .kn-photo, .kn-wordmark, .kn-done, footer, .kn-note, .kn-arrow,
        .kn-qr figcaption /* "bấm nút phía trên" vô nghĩa trên giấy */ { display: none !important; }
        .kn-hero { display: block; background: none; }
        .kn-head { background: none; color: var(--navy); padding: 0 0 6mm; text-align: center; }
        .kn-sub { color: var(--muted); }
        .kn-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6mm; padding: 0; }
        .kn-step { break-inside: avoid; }
        .kn-step + .kn-step { margin: 0; }
        .kn-cta { box-shadow: none; background: #fff; color: var(--navy); border: 1px solid var(--line); min-height: 0; }
        .kn-num { background: var(--navy); color: #fff; }
        .kn-qr { flex-direction: column; border: 0; padding: 0; text-align: center; }
        .kn-qr img { width: 52mm; height: 52mm; }
      }
    </style>
  </head>

  <body>
    <div class="kn-shell">
      <header class="kn-topbar">
        <a href="https://truongvietanh.com" aria-label="Trường Việt Anh">
          <img
            src="/logo-vietanh.webp"
            alt="Trường TH - THCS - THPT Việt Anh"
            width="432"
            height="216"
            fetchpriority="high"
          />
        </a>
      </header>

      <main>
        <div class="kn-hero">
          <section class="kn-head">
            <img
              class="kn-wordmark"
              src="/ketnoi-mam-non/logo-mam-non.webp"
              alt="Trường Mầm non Việt Anh — Học tiếng Anh như trẻ em bản xứ"
              width="560"
              height="188"
              fetchpriority="high"
            />
            <h1>Kết nối cùng Trường của con</h1>
            <p class="kn-sub">
              Ba mẹ <strong>quét mã QR</strong> bằng camera điện thoại — hoặc <strong>bấm nút</strong>
              nếu đang xem trên điện thoại — để theo dõi 3 kênh chính thức của Mầm non Việt Anh.
              Chỉ mất khoảng 60 giây.
            </p>
          </section>

          <img
            class="kn-photo"
            src="/ketnoi-mam-non-hero.webp"
            alt="Cô giáo và các bé Mầm non Việt Anh trong giờ hoạt động ngoài sân"
            width="960"
            height="540"
            fetchpriority="high"
          />
        </div>

        <section class="kn-steps" aria-labelledby="kn-steps-title">
          <h2 id="kn-steps-title" class="sr-only">3 kênh chính thức</h2>
          {KENH.map((k, i) => (
            <div class="kn-step">
              <a class="kn-cta" id={`kn-${k.id}`} href={k.url} target="_blank" rel="noopener" data-ev={k.ev}>
                <span class="kn-num">{i + 1}</span>
                <span class="kn-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill={ICON[k.nen].mau}><path d={ICON[k.nen].d}></path></svg>
                </span>
                <span class="kn-label"><b>{k.ten}</b><span>{k.phu}</span></span>
                <span class="kn-arrow" aria-hidden="true">›</span>
              </a>
              <figure class="kn-qr">
                <img
                  src={duongDanQR(k.id)}
                  alt={`Mã QR mở ${k.ten} ${k.phu}`}
                  width="160"
                  height="160"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
                <figcaption>
                  <strong>Quét mã</strong> bằng camera điện thoại. Đang xem trên điện thoại?
                  <strong>Bấm nút phía trên.</strong>
                </figcaption>
              </figure>
              <p class="kn-note"><strong>{k.hanhDong}.</strong> {k.moTa}</p>
            </div>
          ))}
        </section>

        <section class="kn-done">
          <h2>Hoàn tất kết nối</h2>
          <ul>
            <li>Theo dõi Facebook Mầm non Việt Anh</li>
            <li>Theo dõi Facebook Trường Việt Anh</li>
            <li>Đăng ký YouTube Trường Việt Anh</li>
            <li>Bật thông báo (🔔) để không bỏ lỡ hình ảnh và thông báo của lớp con</li>
          </ul>
          <p class="kn-thanks">Cảm ơn ba mẹ đã đồng hành cùng Mầm non Việt Anh 💛</p>
        </section>
      </main>

      <footer>
        <p class="kn-brand">Mầm non Việt Anh</p>
        <p class="kn-addr">{DIA_CHI}</p>
        <p>Hotline: <a href={`tel:${HOTLINE_TEL}`}>{HOTLINE}</a></p>
        <p><a href={`mailto:${EMAIL}`}>{EMAIL}</a> · <a href="https://truongvietanh.com">truongvietanh.com</a></p>
        <ul class="kn-flinks">
          {KENH.map((k) => (
            <li><a href={k.url} target="_blank" rel="noopener">{k.ten} {k.phu}</a></li>
          ))}
        </ul>
      </footer>
    </div>

    <script is:inline>
      (function () {
        var C = window.__KNMN;
        if (!C) return;
        function track(ev, id) {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: ev, trang: C.trang, kenh: id });
          if (typeof window.gtag === 'function') {
            window.gtag('event', ev, { trang: C.trang, kenh: id });
          }
        }
        // Đánh dấu kênh đã bấm, giữ trong phiên để ba mẹ biết còn thiếu kênh nào.
        var KEY = 'knmn_done';
        function daBam() {
          try { return JSON.parse(sessionStorage.getItem(KEY) || '{}'); } catch (e) { return {}; }
        }
        C.kenh.forEach(function (k) {
          var el = document.getElementById('kn-' + k.id);
          if (!el) return;
          if (daBam()[k.ev]) el.setAttribute('data-done', '1');
          el.addEventListener('click', function () {
            track(k.ev, k.id);
            el.setAttribute('data-done', '1');
            var d = daBam();
            d[k.ev] = 1;
            try { sessionStorage.setItem(KEY, JSON.stringify(d)); } catch (e) {}
          });
        });
      })();
    </script>
  </body>
</html>
