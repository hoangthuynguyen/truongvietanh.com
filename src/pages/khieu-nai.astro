<script is:inline>
(function(){
  const form = document.getElementById('kn-form');
  const successBox = document.getElementById('kn-success');
  const maEl = document.getElementById('kn-ma');
  const errEl = form.querySelector('.kn-error');
  const submitBtn = form.querySelector('.kn-submit');
  if (!form) return;

  function showError(msg){
    errEl.textContent = msg || '';
  }

  function validate(){
    const required = form.querySelectorAll('[required]');
    for (const el of required){
      if (el.type === 'checkbox'){
        if (!el.checked){
          showError('Vui lòng tích đầy đủ các cam kết bắt buộc.');
          el.focus();
          return false;
        }
      } else if (!el.value.trim()){
        showError('Vui lòng điền đầy đủ các trường bắt buộc (*).');
        el.focus();
        return false;
      }
    }
    const email = form.querySelector('[name="email"]').value;
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){
      showError('Email không hợp lệ.');
      form.querySelector('[name="email"]').focus();
      return false;
    }
    const phone = form.querySelector('[name="phone"]').value.replace(/[\s\-\.\(\)]/g,'').replace(/^\+?84/,'0');
    if (!/^0[35789][0-9]{8}$/.test(phone)){
      showError('Số điện thoại không hợp lệ — nhập số di động VN 10 số (VD: 0912 345 678).');
      form.querySelector('[name="phone"]').focus();
      return false;
    }
    showError('');
    return true;
  }

  form.addEventListener('submit', async function(e){
    e.preventDefault();
    if (!validate()) return;

    submitBtn.disabled = true;
    const originalLabel = submitBtn.innerHTML;
    submitBtn.innerHTML = 'Đang gửi...';

    const fd = new FormData(form);
    const payload = {};
    fd.forEach((v, k) => { payload[k] = v; });
    payload.page = window.location.href;
    payload.user_agent = navigator.userAgent;
    payload.submitted_at = new Date().toISOString();

    try {
      const resp = await fetch('/api/khieu-nai', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify(payload)
      });
      const data = await resp.json().catch(() => ({}));

      if (!resp.ok || !data.ok){
        const msg = data?.error === 'duplicate'
          ? 'Đơn khiếu nại với nội dung tương tự vừa được gửi. Vui lòng kiểm tra email xác nhận hoặc liên hệ tu@truongvietanh.com.'
          : 'Gửi đơn không thành công. Vui lòng thử lại hoặc gửi trực tiếp email tu@truongvietanh.com.';
        showError(msg);
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalLabel;
        return;
      }

      maEl.textContent = data.ma_khieu_nai || 'KN-PENDING';
      form.hidden = true;
      successBox.hidden = false;
      successBox.scrollIntoView({behavior: 'smooth', block: 'start'});

      if (window.dataLayer){
        window.dataLayer.push({
          event: 'khieu_nai_submitted',
          ma_khieu_nai: data.ma_khieu_nai,
          co_so: payload.co_so
        });
      }
    } catch (err){
      showError('Lỗi kết nối. Vui lòng kiểm tra mạng và thử lại, hoặc gửi email trực tiếp tu@truongvietanh.com.');
      submitBtn.disabled = false;
      submitBtn.innerHTML = originalLabel;
    }
  });

  form.querySelectorAll('input, select, textarea').forEach(el => {
    el.addEventListener('input', () => showError(''));
    el.addEventListener('change', () => showError(''));
  });
})();
</script>
