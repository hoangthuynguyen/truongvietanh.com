---
import SalesPageLayout from '../../layouts/SalesPageLayout.astro';
import LeadFormTwoStepEmailFirst from '../../components/LeadFormTwoStepEmailFirst.astro';
---

<SalesPageLayout
  title="Lớp 10 Nội trú Việt Anh — Con đi xa, ba mẹ vẫn an tâm"
  description="Nội trú lớp 10 tại Trường Việt Anh TP.HCM: Mentor 1-1 báo cáo ba mẹ mỗi tuần, ăn ở an toàn, lộ trình ĐH Anh Quốc. Nhận học sinh từ Đà Nẵng, Cà Mau, Kiên Giang, Phú Quốc toàn quốc."
  canonical="https://truongvietanh.com/lop-10-noi-tru"
  programCode="thpt-lop10-noitru"
  schoolLevel="thpt"
  heroVariant="white-form"
>
  <!-- HERO — 2 cột: nội dung trái · form giữ chỗ nội trú phải (điền ngay, không phải cuộn) -->
  <Fragment slot="hero">
    <div class="mn-hero">
      <span class="mn-hero__eyebrow">🏠 Lớp 10 Nội trú · Việt Anh · TP.HCM</span>
      <h1>
        <span class="mn-hl">Gửi ba mẹ ở Cà Mau, Kiên Giang,</span>
        <span class="mn-sub">Phú Quốc, Đà Nẵng và các tỉnh</span>
      </h1>
      <p class="mn-hero__lead">
        Ở quê mình chưa có trường quốc tế tốt — điều đó <strong>không có nghĩa con mình phải chịu thiệt</strong>.
      </p>
      <div class="mn-hero__badges">
        <span>🛏️ Nội trú trọn gói</span>
        <span>🧑‍🏫 Mentor 1-1 báo cáo mỗi tuần</span>
        <span>🏅 Cam kết IELTS 6.0</span>
      </div>
      <div class="mn-hero__trust">
        <div>🏠 <b>Số chỗ nội trú có hạn</b> theo sức chứa ký túc xá — giữ chỗ cho con</div>
      </div>
      <p style="margin-top:.9rem">
        <a href="https://zalo.me/1678310120468101523" style="display:inline-block;background:transparent;color:#fff;font-weight:600;padding:.65rem 1.4rem;border-radius:8px;text-decoration:none;font-size:.95rem;border:2px solid rgba(255,255,255,.6)">
          Nhắn Zalo ngay →
        </a>
      </p>
    </div>

    <div class="mn-hero__form" id="mn-hero-form">
      <span class="mn-hero__form-eyebrow">🏠 Giữ chỗ nội trú</span>
      <h2>Giữ chỗ nội trú cho con — để lại số điện thoại</h2>
      <p class="mn-hero__form-sub">Đội tư vấn sẽ gọi lại và gửi ba mẹ thông tin chi tiết về nội trú, học phí, lịch thăm trường.</p>
      <LeadFormTwoStepEmailFirst formId="lop10-noitru-hero" funnelCode="lop10-noitru-hero" schoolLevel="thpt" submitText="Giữ chỗ nội trú cho con" title="" description="" askProvince provinceLabel="Gia đình ở tỉnh/thành nào?" provincePlaceholder="VD: Cà Mau, Kiên Giang, Phú Quốc, Đà Nẵng..." />
    </div>
  </Fragment>

  <div slot="pain">
    <section style="padding:2rem 0 1rem">
      <p style="font-size:1.05rem;line-height:1.75">
        Tôi là Dương, Chủ tịch Trường Việt Anh. Nhiều ba mẹ muốn cho con học môi trường tốt hơn,
        nhưng nghĩ tới cảnh <strong>"gửi con đi xa, ai lo cho con"</strong> là lại thôi. Tôi hiểu.
      </p>
      <p style="font-size:1.05rem;line-height:1.75;margin-top:.75rem">
        Nên ở Việt Anh, con không chỉ có nội trú an toàn.
        <strong>Mỗi con có một Mentor riêng đồng hành suốt 3 năm, mỗi tuần</strong> —
        và báo cáo lại cho ba mẹ qua PDR. Ba mẹ ở xa vẫn nắm được con từng bước.
      </p>
    </section>
  </div>

  <div slot="features" style="max-width:780px;margin:0 auto">
    <h2 style="font-size:1.6rem;font-weight:800;color:#26275D;margin-bottom:1rem">Con rời tỉnh — được chăm kỹ hơn ở nhà</h2>
    <ul style="list-style:none;padding:0;margin:0">
      {[
        "Nội trú trọn gói an toàn — ăn ở, nề nếp, theo dõi sức khoẻ",
        "Mentor 1-1 ba năm — mỗi tuần một người lớn đồng hành con, báo cáo định kỳ cho ba mẹ",
        "Lộ trình xét tuyển thẳng có điều kiện ĐH Birmingham City (UK) + cam kết IELTS 6.0 — con ở tỉnh vẫn chạm tới bằng quốc tế",
        "Tặng Macbook + Học bổng Trại hè Lion Camp 100% — hoà nhập nhanh ngay từ hè",
        "Hỗ trợ gia đình xa: lịch thăm, kênh liên lạc cố định với Mentor + GVCN, hỗ trợ đưa đón đầu/cuối kỳ",
      ].map((item) => (
        <li style="display:flex;align-items:flex-start;gap:.75rem;padding:.8rem 0;border-bottom:1px solid #eef0f6;font-size:1rem;line-height:1.6">
          <span style="flex-shrink:0;width:26px;height:26px;background:#26275D;color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.8rem;font-weight:700;margin-top:.1rem">✓</span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
    <div style="background:#fff8d6;border-left:5px solid #F9DD0E;padding:1rem 1.2rem;border-radius:8px;margin-top:1.25rem;font-size:.95rem">
      <strong>Minh bạch:</strong> "Tuyển thẳng + học bổng" theo điều kiện thoả thuận UIT–BCU. Cam kết IELTS 6.0 theo điều khoản bảo hành (đi học đủ, dự các buổi kèm). Đội tư vấn nói rõ từng trường hợp.
    </div>
  </div>

  <div slot="form1">
    <h2 style="color:#26275D;font-size:1.5rem;font-weight:800;margin:0 0 .5rem">Giữ chỗ nội trú cho con — để lại số điện thoại</h2>
    <p style="color:#475569;margin:0 0 1.5rem">Đội tư vấn sẽ gọi lại và gửi ba mẹ thông tin chi tiết về nội trú, học phí, lịch thăm trường.</p>
    <div style="background:#fff;border-radius:16px;padding:1.75rem 1.5rem;max-width:440px;margin:0 auto;box-shadow:0 16px 44px rgba(38,39,93,.16);border:1px solid #e8ecf5" data-form-bg="light">
      <LeadFormTwoStepEmailFirst formId="lop10-noitru" funnelCode="lop10-noitru" schoolLevel="thpt" submitText="Giữ chỗ nội trú cho con" title="" description="" askProvince provinceLabel="Gia đình ở tỉnh/thành nào?" provincePlaceholder="VD: Cà Mau, Kiên Giang, Phú Quốc, Đà Nẵng..." />
    </div>
  </div>

  <div slot="quote">
    <blockquote style="border:none;padding:0;margin:0">
      <p style="font-size:1.15rem;line-height:1.8;color:#334155;font-style:italic">"Con ở tỉnh lẻ ít trường chất lượng không phải là giới hạn của con — đó chỉ là giới hạn của địa phương. Một môi trường đúng, một người Mentor đúng, có thể mở ra cả một con đường khác."</p>
      <footer style="margin-top:.75rem;font-size:.95rem;color:#475569">— <strong>Nguyễn Mạnh Dương</strong>, Chủ tịch / Nhà sáng lập Trường Việt Anh</footer>
    </blockquote>
  </div>
</SalesPageLayout>

