---
/**
 * /lop-10 — Landing tuyển sinh Lớp 10 (remarketing + chờ điểm thi)
 * Hero + form 2 bước qua MamNonHookLayout → POST /api/lead → redirect /cam-on
 * Long-form sales sections (Problem→Agitation→Solution→Value stack→Lộ trình
 * →Social proof→Guarantee→FAQ→Urgency→Final CTA) render qua <slot/>.
 *
 * Hàng rào chính trực: IELTS 6.0 (không phải 6.5) · giữ cụm "lộ trình xét
 * tuyển thẳng" cho tới khi có văn bản phạm vi UIT–BCU.
 */
import MamNonHookLayout from '../layouts/MamNonHookLayout.astro';

const FAQ = [
  {
    q: 'Con chưa có điểm thi lớp 10, đăng ký được không?',
    a: 'Được. Việt Anh xét học bạ — con có chỗ ngay, không cần chờ điểm, không cần thi lại.',
  },
  {
    q: '"Bằng Cử nhân Anh Quốc tại Sài Gòn" nghe khó tin — thực hư thế nào?',
    a: 'Con học theo lộ trình xét tuyển thẳng vào chương trình Cử nhân của Đại học Birmingham City (Anh Quốc), học ngay tại TP.HCM, dùng học bạ — không qua kỳ thi đại học. Đội ngũ sẽ gửi bạn lộ trình cụ thể khi bạn để lại thông tin.',
  },
  {
    q: 'Cam kết IELTS 6.0 nghĩa là sao?',
    a: 'Chúng tôi cam kết đầu ra IELTS 6.0 và kèm con đến khi đạt. Con học để nói được, dùng được — đủ để bước vào một chương trình đại học Anh Quốc.',
  },
  {
    q: '"Học thử 4 tuần hoàn 100% học phí" có điều kiện gì không?',
    a: 'Bốn tuần đầu (học kỳ Foundation) con học thật, bạn nhìn thật. Nếu không hài lòng, chúng tôi hoàn lại toàn bộ học phí. Bạn không mất gì để thử.',
  },
  {
    q: 'Con tôi mất gốc / mất tự tin sau kỳ thi, có theo kịp không?',
    a: '6 tuần đầu chúng tôi giúp con lấy lại nền tảng và sự tự tin trước khi vào guồng. Mỗi con có một Mentor riêng đồng hành suốt 3 năm.',
  },
  {
    q: 'Còn nhận hồ sơ không?',
    a: 'Còn, nhưng điểm thi sắp công bố — khi đó hồ sơ về rất nhanh và 100 suất Hồ sơ Vàng đóng lại. Để lại thông tin sớm để giữ suất cho con.',
  },
];

// Bật/tắt khối testimonial. Để false = ẩn; đổi true khi cần hiện lại.
const SHOW_TESTIMONIALS = false;

// Testimonial video THẬT từ kho testimonials-video.ts (cấp THPT).
// Phụ huynh THPT hiện có 1 video; bổ sung 2 học sinh THPT để phần social proof đủ dày.
const TESTIMONIALS = [
  {
    videoId: '5T8j_k5VCW4',
    role: 'Phụ huynh',
    name: 'Anh Lê Trung Thành',
    meta: 'Phụ huynh bạn Quỳnh Anh · lớp 11, cơ sở Gò Vấp',
    quote: 'Khi chọn trường cho con ở giai đoạn quan trọng, gia đình không chỉ quan tâm đến học tập mà còn là môi trường. Điều khiến chúng tôi tin tưởng là môi trường giúp con phát triển toàn diện — từ kiến thức đến kỹ năng và thái độ.',
  },
  {
    videoId: 'wqYxSOZMIAE',
    role: 'Học sinh',
    name: 'Bạn Huyền',
    meta: 'Học sinh lớp 10A1, cơ sở Gò Vấp',
    quote: 'Trước đây em học theo sự sắp xếp và chưa thực sự chủ động. Khi học tại trường, em dần biết tự học, tự định hướng và tham gia nhiều hoạt động — em trưởng thành và tự tin hơn rất nhiều.',
  },
  {
    videoId: 'v2MRJXlEPWE',
    role: 'Học sinh',
    name: 'Mỹ Uyên',
    meta: 'Học sinh lớp 11, cơ sở Gò Vấp',
    quote: 'Trước đây em phải học thêm rất nhiều, kéo dài đến tối muộn nên khá áp lực. Khi chuyển sang học tại trường, em thấy nhẹ nhàng hơn, có nhiều thời gian tự học và chủ động hơn.',
  },
];

const STACK = [
  { icon: '🛡️', t: 'Học thử 4 tuần', d: 'Không hài lòng, tôi hoàn lại 100% học phí. Con thử mà không mất gì.' },
  { icon: '🎓', t: 'Lộ trình xét tuyển thẳng Cử nhân ĐH Anh Quốc', d: 'Bằng học bạ, không thi đại học, học ngay tại Sài Gòn.' },
  { icon: '🗣️', t: 'Cam kết IELTS 6.0', d: 'Kèm con đến khi đạt — tiếng Anh dùng được, không học để quên sau kỳ thi.' },
  { icon: '📈', t: '95% học sinh tiến bộ mỗi năm', d: 'Đo bằng 4 khía cạnh, không chỉ điểm số.' },
  { icon: '🤖', t: 'AI Education', d: 'Con học nhanh gấp 3 lần — kỹ năng cả thế giới đang đòi hỏi.' },
  { icon: '👤', t: 'Một Mentor riêng', d: 'Đi cùng con suốt 3 năm.' },
  { icon: '💻', t: 'Tặng Macbook', d: 'Công cụ học tập theo đúng thời đại.' },
  { icon: '🏕️', t: 'Học bổng Trại hè Lion Camp 100%', d: 'Trị giá 29 triệu.' },
  { icon: '🏅', t: 'Học bổng Tài năng + 100 suất Hồ sơ Vàng', d: 'Dành cho người ghi danh sớm.' },
];
---
<MamNonHookLayout
  title="Tuyển Sinh Lớp 10 — Lộ Trình Cử Nhân Anh Quốc Tại Sài Gòn | Trường Việt Anh"
  description="Vào lớp 10 bằng học bạ, 3 năm sau lộ trình xét tuyển thẳng Cử nhân Đại học Anh Quốc ngay tại Sài Gòn — không thi đại học. Cam kết IELTS 6.0 kèm đến khi đạt. Học thử 4 tuần, không hài lòng hoàn 100% học phí."
  canonicalUrl="https://truongvietanh.com/lop-10"
  location="Gò Vấp & Bình Tân"
  address="Gò Vấp: 160/72 Phan Huy Ích, P.15, Q.Gò Vấp · Bình Tân: Số 7 Đường 38A, Tân Tạo, Q.Bình Tân, TPHCM"
  hookHeadline={`Vào <span class="mark">Lớp 10 bằng học bạ</span> — 3 năm sau cầm bằng Cử nhân Anh Quốc<em>Không thi đại học · Không tiền tỷ du học · Ngay tại Sài Gòn</em>`}
  hookSubline="Cam kết IELTS 6.0 kèm con đến khi đạt. Học thử 4 tuần — không hài lòng hoàn 100% học phí. Mentor riêng 3 năm + AI Education giúp con học nhanh gấp 3 lần."
  source="lop-10"
  funnelCode="lop-10"
  heroImage="https://media.truongvietanh.com/images/Block%20Hero%20_%20BG%20-%20website/thpt-banner-chinh-1.jpg"
  redirectUrl="/cam-on"
  schoolLevel="thpt"
  levelLabel="Lớp 10"
  fomoText="🔥 Điểm thi lớp 10 sắp công bố · 100 suất Hồ sơ Vàng cho người ghi danh sớm · Tặng Macbook + Lion Camp 29tr"
  cardTitle="Giữ một suất Lớp 10 cho con"
  cardSub="Tư vấn lộ trình · Đội ngũ gọi lại trong hôm nay · Miễn phí"
  ctaStep2="🎓 GIỮ SUẤT LỚP 10 CHO CON"
  trustMarks={['15 năm K12 từ 2011', 'Lộ trình bằng Cử nhân Birmingham City (Anh Quốc)', 'Hoàn 100% học phí nếu thử không hài lòng']}
  bullets={[
    { icon: '🎓', html: '<strong>Lộ trình xét tuyển thẳng Cử nhân ĐH Anh Quốc</strong> — bằng học bạ, không thi đại học' },
    { icon: '🗣️', html: '<strong>Cam kết IELTS 6.0</strong> — kèm con đến khi đạt' },
    { icon: '🛡️', html: '<strong>Học thử 4 tuần</strong> — không hài lòng hoàn 100% học phí' },
    { icon: '🤖', html: '<strong>AI Education + Mentor riêng 3 năm</strong> — học nhanh gấp 3 lần' },
  ]}
>
  <!-- ============ VSL VIDEO ============ -->
  <section class="lp-sec lp-sec--vsl">
    <div class="lp-wrap">
      <span class="lp-kicker">Xem trước 1 phút</span>
      <h2 class="lp-h2 lp-h2--light">Tôi gói toàn bộ lộ trình lớp 10 trong video này</h2>
      <p class="lp-vsl-sub">Trước khi đọc tiếp, hãy nghe tôi nói trực tiếp — đủ để bạn quyết hôm nay.</p>
      <div class="lp-video">
        <iframe
          src="https://www.youtube-nocookie.com/embed/ZawrgluGkk4?rel=0&modestbranding=1"
          title="Lộ trình Lớp 10 Trường Việt Anh — Nguyễn Mạnh Dương"
          loading="lazy"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </div>
      <div class="lp-cta-row">
        <a href="#formArea" class="lp-btn">🎓 Giữ suất Lớp 10 cho con</a>
      </div>
    </div>
  </section>

  <!-- ============ PROBLEM ============ -->
  <section class="lp-sec lp-sec--soft">
    <div class="lp-wrap">
      <h2 class="lp-h2">Bạn có đang ở trong tình cảnh này?</h2>
      <ul class="lp-pain">
        <li>Con vừa thi xong lớp 10, cả nhà <strong>nín thở chờ điểm</strong> — chưa biết con sẽ học ở đâu.</li>
        <li>Lỡ điểm không như ý, <strong>không biết phương án 2</strong> là gì.</li>
        <li>Con học tiếng Anh 7 năm vẫn <strong>không nói được một câu cho ra hồn</strong>.</li>
        <li>Muốn cho con học trường tốt, định hướng quốc tế, nhưng <strong>sợ chi phí du học tiền tỷ</strong>.</li>
        <li>Lo con vào cấp 3 rồi <strong>trôi đi 3 năm</strong>, không ai đồng hành, không có đích đến rõ ràng.</li>
      </ul>
      <p class="lp-note">Bạn không đơn độc. Những ngày này tôi gặp rất nhiều cha mẹ cùng một nỗi lo. Vấn đề không nằm ở con bạn — mà ở chỗ con chưa được đặt vào một <strong>con đường có đích đến thật</strong>.</p>
    </div>
  </section>

  <!-- ============ AGITATION ============ -->
  <section class="lp-sec lp-sec--dark">
    <div class="lp-wrap">
      <h2 class="lp-h2 lp-h2--light">Vì sao không nên để mọi thứ "chờ tới ngày báo điểm"?</h2>
      <div class="lp-warn">
        <p>⚠️ Điểm thi lớp 10 chỉ đo <strong>một lát cắt rất hẹp</strong> của con — nó không nói được 3 năm tới con đi xa tới đâu.</p>
        <p>⚠️ Khi điểm công bố, <strong>hồ sơ về rất nhanh</strong> và các suất ưu đãi đóng lại trong vài ngày.</p>
        <p>⚠️ Càng chờ, con càng dễ rơi vào trường "có chỗ thì học" — rồi 3 năm trôi qua không định hướng.</p>
        <p>⚠️ <strong>100 suất Hồ sơ Vàng</strong> cho người ghi danh sớm hết rất nhanh — chờ thêm là mất phần ưu đãi lớn nhất.</p>
      </div>
      <p class="lp-cost">Cái giá thật của việc chờ không phải mất một suất học. Là mất cơ hội đặt con lên một lộ trình mà rất ít cha mẹ biết tới — trong khi con nhà người khác đã bắt đầu.</p>
    </div>
  </section>

  <!-- ============ SOLUTION ============ -->
  <section class="lp-sec">
    <div class="lp-wrap">
      <span class="lp-kicker">Giải pháp</span>
      <h2 class="lp-h2">Lớp 10 Trường Việt Anh — lộ trình bằng Cử nhân Anh Quốc tại Sài Gòn</h2>
      <p class="lp-lead">Tôi là <strong>Nguyễn Mạnh Dương, Chủ tịch Trường Việt Anh</strong>. 15 năm làm giáo dục K12 từ 2011, tôi xây một con đường cụ thể cho con bạn:</p>
      <blockquote class="lp-quote">Con học lớp 10 ở Việt Anh hôm nay. Ba năm sau, con dùng <strong>chính học bạ của mình</strong> để xét tuyển thẳng vào chương trình Cử nhân của <strong>Đại học Birmingham City — Vương quốc Anh — học ngay tại TP.HCM</strong>.</blockquote>
      <ul class="lp-check">
        <li><strong>Vào lớp 10 bằng xét học bạ</strong> — con có chỗ ngay, không phải chờ điểm, không thi lại.</li>
        <li><strong>Bằng Anh Quốc thật, học phí nội địa</strong> — không một kỳ thi đại học nào.</li>
        <li><strong>6 tuần đầu (Foundation)</strong> — giúp con lấy lại nền tảng và sự tự tin trước khi vào guồng.</li>
      </ul>
    </div>
  </section>

  <!-- ============ VALUE STACK ============ -->
  <section class="lp-sec lp-sec--soft">
    <div class="lp-wrap">
      <h2 class="lp-h2">Đây là toàn bộ cam kết của tôi với con bạn</h2>
      <div class="lp-stack">
        {STACK.map((s) => (
          <div class="lp-card">
            <div class="lp-card__ico">{s.icon}</div>
            <div>
              <h3 class="lp-card__t">{s.t}</h3>
              <p class="lp-card__d">{s.d}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="lp-note">Bạn đếm thử xem — chỉ riêng cam kết hoàn 100% học phí thôi đã đủ để con bạn thử mà không mất gì. Còn lại, là một con đường có đích đến thật.</p>
      <div class="lp-cta-row">
        <a href="#formArea" class="lp-btn">🎓 Giữ suất Lớp 10 cho con</a>
      </div>
    </div>
  </section>

  <!-- ============ LỘ TRÌNH / HOW IT WORKS ============ -->
  <section class="lp-sec">
    <div class="lp-wrap">
      <h2 class="lp-h2">Con đường của con — rõ ràng từng bước</h2>
      <ol class="lp-steps">
        <li><span class="lp-steps__n">1</span><div><strong>Ghi danh &amp; xét học bạ</strong><br/>Con có chỗ ngay, không chờ điểm thi.</div></li>
        <li><span class="lp-steps__n">2</span><div><strong>6 tuần Foundation</strong><br/>Lấy lại nền tảng, tìm lại sự tự tin.</div></li>
        <li><span class="lp-steps__n">3</span><div><strong>Lớp 10 – 11 – 12</strong><br/>Học cùng Mentor riêng + AI Education, đạt cam kết IELTS 6.0.</div></li>
        <li><span class="lp-steps__n">4</span><div><strong>Tốt nghiệp</strong><br/>Dùng học bạ xét tuyển thẳng vào Cử nhân ĐH Birmingham City — học tại TP.HCM.</div></li>
      </ol>
    </div>
  </section>

  <!-- ============ SOCIAL PROOF ============ -->
  <section class="lp-sec lp-sec--soft">
    <div class="lp-wrap">
      <h2 class="lp-h2">Vì sao cha mẹ tin Việt Anh?</h2>
      <div class="lp-stats">
        <div><b>15 năm</b><span>Xây dựng giáo dục K12 (từ 2011)</span></div>
        <div><b>95%</b><span>Học sinh tiến bộ mỗi năm — đo bằng 4 khía cạnh</span></div>
        <div><b>BCU</b><span>Lộ trình tới bằng Cử nhân Birmingham City (Anh Quốc)</span></div>
        <div><b>IELTS 6.0</b><span>Cam kết đầu ra, kèm đến khi đạt</span></div>
      </div>

      {/* Đổi SHOW_TESTIMONIALS = true ở frontmatter để hiện lại khối testimonial */}
      {SHOW_TESTIMONIALS && (
        <>
          <h3 class="lp-tm-head">Phụ huynh &amp; học sinh THPT nói gì</h3>
          <div class="lp-tm-grid">
            {TESTIMONIALS.map((t) => (
              <a class="lp-tm" href={`https://www.youtube.com/watch?v=${t.videoId}`} target="_blank" rel="noopener" aria-label={`Xem video: ${t.name}`}>
                <div class="lp-tm__thumb" style={`background-image:url(https://img.youtube.com/vi/${t.videoId}/hqdefault.jpg)`}>
                  <span class="lp-tm__role">{t.role}</span>
                  <span class="lp-tm__play" aria-hidden="true">▶</span>
                </div>
                <div class="lp-tm__body">
                  <div class="lp-tm__stars">★★★★★</div>
                  <p class="lp-tm__quote">“{t.quote}”</p>
                  <div class="lp-tm__name">{t.name}</div>
                  <div class="lp-tm__meta">{t.meta} · <span class="lp-tm__watch">Xem video ▶</span></div>
                </div>
              </a>
            ))}
          </div>
        </>
      )}
    </div>
  </section>

  <!-- ============ GUARANTEE ============ -->
  <section class="lp-sec lp-sec--guarantee">
    <div class="lp-wrap">
      <div class="lp-badge">🛡️ Bảo đảm</div>
      <h2 class="lp-h2">Học thử 4 tuần — không hài lòng, hoàn 100% học phí</h2>
      <p class="lp-lead">Phần lớn nỗi sợ của cha mẹ khi chọn trường là: <em>lỡ chọn sai thì sao?</em> Nên tôi nhận lấy rủi ro đó về phía mình.</p>
      <ol class="lp-flow">
        <li>Ghi danh hôm nay</li>
        <li>Con học thật 4 tuần Foundation</li>
        <li>Bạn quan sát kết quả thật</li>
        <li>Không hài lòng, báo với chúng tôi</li>
        <li>Hoàn lại toàn bộ học phí</li>
      </ol>
      <p class="lp-note"><strong>Vì sao tôi dám?</strong> Vì 95% học sinh của chúng tôi tiến bộ mỗi năm — và chúng tôi đo được điều đó. Một ngôi trường dám cam kết như vậy, vì nó biết con bạn sẽ tiến bộ.</p>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="lp-sec">
    <div class="lp-wrap">
      <h2 class="lp-h2">Câu hỏi thường gặp</h2>
      <div class="lp-faq">
        {FAQ.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ URGENCY + FINAL CTA ============ -->
  <section class="lp-sec lp-sec--final">
    <div class="lp-wrap">
      <div class="lp-urgency">
        <span>⏰ Điểm thi lớp 10 sắp công bố — sau đó hồ sơ về rất nhanh, ưu đãi đóng lại</span>
        <span>🔥 100 suất Hồ sơ Vàng cho người ghi danh sớm — hết là dừng</span>
        <span>🎁 Ghi danh đợt này mới trọn bộ quà: Macbook + Lion Camp 29 triệu + Học bổng Tài năng</span>
      </div>
      <h2 class="lp-h2 lp-h2--light">Cho con — và cho chính mình — một quyết định đúng lúc này</h2>
