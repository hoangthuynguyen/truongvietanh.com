const canonicalUrl = 'https://truongvietanh.com/mam-non-go-vap-cam-on';
const zaloUrl = 'https://zalo.me/1678310120468101523';
const zaloDeepLink = 'https://zalo.me/1678310120468101523?text=' + encodeURIComponent('Chào thầy/cô, em vừa đăng ký tham quan Mầm Non Việt Anh cơ sở Gò Vấp. Em muốn xác nhận lịch tham quan.');
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <style is:inline>@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=Open+Sans:wght@400;600&display=swap&subset=vietnamese');</style>
  <style is:inline>:root{--navy:#000080;--navy-dk:#00004d;--navy-soft:rgba(0,0,128,.08);--gold:#ffff00;--gold-soft:rgba(255,255,0,.12);--text:#1a1a2e;--text-muted:#5a5a70;--border:#E5E7EB;--bg:#fff}*{margin:0;padding:0;box-sizing:border-box}body{font-family:'Open Sans',system-ui,sans-serif;color:var(--text);background:var(--bg);min-height:100vh;-webkit-font-smoothing:antialiased;line-height:1.65;font-size:16px}h1,h2{font-family:'Montserrat',sans-serif}.logo-bar{text-align:center;padding:20px 16px 8px}.logo-bar img{display:inline-block;max-width:260px;width:100%;height:auto}.progress-steps{display:flex;align-items:center;justify-content:center;gap:0;margin:8px auto 0;max-width:440px;padding:0 16px}.step{display:flex;align-items:center;gap:6px;font-size:1rem;font-weight:600;color:var(--navy)}.step--pending{color:#aaa}.step__dot{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1rem;font-weight:800;color:#fff}.step--done .step__dot{background:var(--navy)}.step--active .step__dot{background:var(--gold);color:var(--navy-dk);animation:stepPulse 2s ease-in-out infinite}.step--pending .step__dot{background:#ccc}.step__line{flex:1;height:2px;background:var(--navy);min-width:24px}.step__line--pending{background:#e0e0e0}@keyframes stepPulse{0%,100%{box-shadow:0 0 0 0 rgba(255,255,0,.4)}50%{box-shadow:0 0 0 8px rgba(255,255,0,0)}}.main{display:flex;align-items:flex-start;justify-content:center;padding:24px 24px 60px}.card{max-width:760px;width:100%;padding:1.5rem 2rem;text-align:center}.icon{width:72px;height:72px;border-radius:50%;background:var(--gold-soft);display:flex;align-items:center;justify-content:center;font-size:2.2rem;margin:0 auto 14px;border:2px solid var(--gold)}h1{font-size:1.55rem;font-weight:800;color:var(--navy);margin-bottom:12px;line-height:1.4}h1 .name{color:var(--gold)}.intro{font-size:1rem;color:var(--text);line-height:1.75;margin-bottom:22px;max-width:620px;margin-left:auto;margin-right:auto}.intro strong{color:var(--navy)}.next-steps{background:#FAFAFA;border:1px solid var(--border);border-radius:14px;padding:20px 24px;margin-bottom:20px;text-align:left}.next-steps__title{font-weight:800;color:var(--navy);margin-bottom:14px;font-size:1.5rem;font-family:'Montserrat',sans-serif}.next-steps__item{display:flex;align-items:flex-start;gap:12px;padding:10px 0;font-size:1rem;color:var(--text-muted);border-bottom:1px solid #F0F0F0;line-height:1.6}.next-steps__item:last-child{border-bottom:none}.next-steps__item--done{color:var(--navy)}.next-steps__item--done .next-steps__dot{background:var(--navy);color:#fff}.next-steps__item--active{color:var(--navy);font-weight:600}.next-steps__item--active .next-steps__dot{background:var(--gold);color:var(--navy-dk);animation:stepPulse 2s infinite}.next-steps__dot{width:26px;height:26px;min-width:26px;border-radius:50%;background:#D1D5DB;color:#fff;display:flex;align-items:center;justify-content:center;font-size:1rem;font-weight:800;margin-top:1px}.info-box{background:var(--navy-soft);border:1px solid rgba(0,0,128,.18);border-radius:14px;padding:18px 22px;margin-bottom:20px;text-align:left}.info-box__title{font-weight:800;color:var(--navy);margin-bottom:10px;font-size:1.15rem;font-family:'Montserrat',sans-serif}.info-box p{font-size:.95rem;color:var(--text);margin-bottom:6px}.info-box strong{color:var(--navy)}.cta-stack{display:flex;flex-direction:column;gap:10px;max-width:520px;margin:16px auto}.cta-btn{display:block;padding:16px 22px;border-radius:12px;text-decoration:none;font-weight:800;font-size:1rem;text-align:center;transition:all .2s;font-family:'Montserrat',sans-serif;line-height:1.35}.cta-primary{background:var(--gold);color:var(--navy-dk);box-shadow:0 4px 16px rgba(255,255,0,.3)}.cta-primary:hover{background:#ffff00}.cta-secondary{background:var(--bg);color:var(--navy);border:2px solid var(--navy)}.cta-secondary:hover{background:var(--navy);color:#fff}.trust-footer{display:flex;align-items:center;justify-content:center;gap:1.75rem;flex-wrap:wrap;margin-top:20px;padding-top:18px;border-top:1px solid var(--border)}.trust-footer__item{display:flex;align-items:center;gap:5px;font-size:1rem;color:var(--text-muted);font-weight:500}.footer-note{font-size:1rem;color:var(--text-muted);margin-top:12px}@media(max-width:560px){.main{padding:16px 14px 60px}.card{padding:1rem}h1{font-size:1.2rem}.info-box,.next-steps{padding:16px 18px}}</style>
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-KPL2NSR9');</script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'generate_lead', funnel_code: 'mam-non-go-vap', school_level: 'mam-non' });
  </script>
</head>
<body>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KPL2NSR9" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<div class="logo-bar">
  <img src="/logo-vietanh.webp" alt="Trường Việt Anh" />
</div>

<div class="progress-steps">
  <div class="step step--done"><span class="step__dot">✓</span><span>Đăng ký</span></div>
  <div class="step__line"></div>
  <div class="step step--active"><span class="step__dot">2</span><span>Xác nhận lịch</span></div>
  <div class="step__line step__line--pending"></div>
  <div class="step step--pending"><span class="step__dot">3</span><span>Tham quan</span></div>
</div>

<div class="main">
  <div class="card">
    <div class="icon">🎉</div>
    <h1>Cảm ơn Ba/Mẹ<span class="name" id="parentName"></span>! Đã nhận đăng ký tham quan Mầm Non Gò Vấp.</h1>
    <p class="intro">
      Bộ phận tuyển sinh Trường Việt Anh sẽ <strong>gọi xác nhận lịch tham quan</strong> trong vòng <strong>24 giờ</strong> tới.
      Buổi tham quan kéo dài 45–60 phút: gặp giáo viên, xem lớp học, khu vui chơi, bếp ăn — và đặt mọi câu hỏi của Ba/Mẹ.
    </p>

    <div class="next-steps">
      <div class="next-steps__title">Các bước tiếp theo</div>
      <div class="next-steps__item next-steps__item--done"><span class="next-steps__dot">✓</span><span>Đã gửi thông tin đăng ký</span></div>
      <div class="next-steps__item next-steps__item--active"><span class="next-steps__dot">2</span><span><strong>Tư vấn viên gọi xác nhận</strong> — chốt ngày & giờ tham quan phù hợp với Ba/Mẹ</span></div>
      <div class="next-steps__item"><span class="next-steps__dot">3</span><span>Đến tham quan trực tiếp tại <strong>123 Phan Huy Ích, P.15, Gò Vấp</strong> — gặp cô, xem lớp, xem camera</span></div>
      <div class="next-steps__item"><span class="next-steps__dot">4</span><span>Nhận tư vấn học phí, ưu đãi & lộ trình nhập học (không ràng buộc)</span></div>
    </div>

    <div class="info-box">
      <div class="info-box__title">📍 Mầm Non Việt Anh — cơ sở Gò Vấp</div>
      <p><strong>Địa chỉ:</strong> 123 Phan Huy Ích, P.15, Q.Gò Vấp, TPHCM</p>
      <p><strong>Giờ làm việc:</strong> Thứ 2 – Thứ 7 · 7:30 – 17:00</p>
      <p><strong>Hotline tuyển sinh:</strong> 0916 961 409</p>
    </div>

    <div class="cta-stack">
      <a href={zaloDeepLink} target="_blank" rel="noopener" class="cta-btn cta-primary">💬 Nhắn Zalo để được phản hồi nhanh nhất</a>
      <a href="tel:+84916961409" class="cta-btn cta-secondary">📞 Gọi ngay 0916 961 409</a>
    </div>

    <div class="trust-footer">
      <div class="trust-footer__item"><span>🔒</span> Bảo mật thông tin</div>
      <div class="trust-footer__item"><span>💬</span> Tư vấn miễn phí</div>
      <div class="trust-footer__item"><span>🏫</span> 15 năm K12 từ 2011</div>
    </div>
    <p class="footer-note">Thông tin được bảo mật tuyệt đối theo chính sách của Trường Việt Anh.</p>
  </div>
</div>

<script is:inline>
  (function(){
    var p = new URLSearchParams(window.location.search);
    var n = p.get('name');
    if (n) document.getElementById('parentName').textContent = ' ' + n.trim().split(/\s+/).pop();
  })();
</script>
</body>
</html>
