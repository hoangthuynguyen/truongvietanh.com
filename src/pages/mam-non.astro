---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Mầm Non Việt Anh",
    "url": "https://hoc.truongvietanh.com/mam-non",
    "description": "Mầm Non Việt Anh – kích hoạt bản năng siêu học tập từ 2–6 tuổi.",
    "address": { "@type": "PostalAddress", "addressLocality": "Hồ Chí Minh", "addressCountry": "VN" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Trẻ có cần học trước lớp 1 không?", "acceptedAnswer": { "@type": "Answer", "text": "Không. Quan trọng là phát triển nền tảng học tập." } },
      { "@type": "Question", "name": "Nếu không học trước, con có bị chậm không?", "acceptedAnswer": { "@type": "Answer", "text": "Không. Trẻ có nền tảng tốt sẽ học nhanh hơn khi cần." } },
      { "@type": "Question", "name": "Làm sao biết con đang phát triển tốt?", "acceptedAnswer": { "@type": "Answer", "text": "Qua giao tiếp, sự tự tin và khả năng tự học." } },
      { "@type": "Question", "name": "Trường khác gì so với các trường khác?", "acceptedAnswer": { "@type": "Answer", "text": "Tập trung kích hoạt bản năng học, không nhồi nhét kiến thức." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://hoc.truongvietanh.com" },
      { "@type": "ListItem", "position": 2, "name": "Mầm non", "item": "https://hoc.truongvietanh.com/mam-non" }
    ]
  }
];
---

<BaseLayout
  title="Mầm Non Việt Anh – Kích Hoạt Bản Năng Siêu Học Tập"
  description="Mầm Non Việt Anh: môi trường kích hoạt bản năng siêu học tập từ 2–6 tuổi. Không nhồi ép, học qua chơi có chủ đích, phát triển toàn diện."
  canonical="https://hoc.truongvietanh.com/mam-non"
  ogImage="https://lh3.googleusercontent.com/d/1KFTzfN4Fe40bhmiJEmY_k9p3uClLUgiT"
  structuredData={structuredData}
>
  <div class="pp-page">
    <HeaderBase />

    <!-- BLOCK 1: HERO -->
    <section class="pp-hero">
      <div class="pp-hero-inner">
        <h1 class="pp-h1">
          Mỗi đứa trẻ đều sinh ra với bản năng siêu học tập
          <span class="pp-h1-accent">nhưng không phải môi trường nào cũng giúp kích hoạt điều đó</span>
        </h1>
        <p class="pp-subtitle">
          6 năm đầu đời không phải để "học trước", mà là để hình thành cách trẻ học, phát triển và khám phá thế giới. Mầm non Việt Anh tập trung vào việc kích hoạt bản năng siêu học tập thông qua môi trường an toàn, trải nghiệm và có chủ đích.
        </p>
        <div class="pp-cta-row">
          <a href="#pp-form" class="pp-btn pp-btn-gold">Nhận brochure →</a>
          <a href="https://zalo.me/1678310120468101523" target="_blank" rel="noopener" class="pp-btn pp-btn-outline">Chat ngay →</a>
        </div>
      </div>
    </section>

    <!-- BLOCK 2: RICH TEXT -->
    <section class="pp-richtext">
      <div class="pp-richtext-inner">
        <h2>Giáo dục mầm non không phải là dạy sớm<br/>mà là kích hoạt đúng</h2>
        <p>Có một hiểu lầm rất phổ biến: <strong>Trẻ học càng sớm → càng giỏi</strong></p>
        <p>Nhưng thực tế: trẻ có thể biết chữ sớm, có thể làm toán sớm —</p>
        <div class="pp-callout">nhưng lại dễ mất đi: sự tò mò, niềm vui học, khả năng tự khám phá</div>
        <p>Trong khi đó, những năng lực quan trọng nhất — <strong>tò mò, sáng tạo, giao tiếp, tự học</strong> — đều xuất hiện tự nhiên trong những năm đầu đời.</p>
        <div class="pp-callout">Vấn đề không phải là "dạy thêm" — mà là có môi trường đúng để những năng lực này phát triển hay không</div>
      </div>
    </section>

    <!-- BLOCK 3: STATS -->
    <section class="pp-stats">
      <div class="pp-stats-inner">
        <h2>6 năm đầu đời quyết định cách trẻ học suốt đời</h2>
        <div class="pp-stats-cols">
          <div class="pp-stats-col">
            <h3>Nếu giai đoạn này bị bỏ lỡ…</h3>
            <ul>
              <li>Bị ép học → mất động lực học</li>
              <li>Thiếu trải nghiệm → không tự học được</li>
              <li>Không được hiểu đúng → chán học sớm</li>
            </ul>
          </div>
          <div class="pp-stats-col">
            <h3>Nếu được đầu tư đúng…</h3>
            <ul>
              <li>Trẻ yêu học tự nhiên</li>
              <li>Học nhanh và học sâu hơn</li>
              <li>Phát triển bền vững suốt hành trình</li>
            </ul>
          </div>
        </div>
        <p style="text-align:center;margin-top:1.5rem;color:#64748b;font-size:.95rem;">90% não bộ phát triển trước 6 tuổi · Trẻ học nhanh nhất qua trải nghiệm · Thói quen học tập hình thành từ rất sớm</p>
      </div>
    </section>

    <!-- BLOCK 4: FEATURES -->
    <section class="pp-features">
      <div class="pp-features-inner">
        <h2>Môi trường kích hoạt bản năng siêu học tập</h2>
        <div class="pp-feat-grid">
          <div class="pp-feat-card">
            <span class="pp-icon">🛡️</span>
            <strong>An toàn thể chất & cảm xúc</strong>
            <p>Trẻ dám thử, dám sai và dám khám phá</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">🎯</span>
            <strong>Học qua chơi có chủ đích</strong>
            <p>Mỗi hoạt động đều giúp phát triển tư duy và kỹ năng</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">🧠</span>
            <strong>Không nhồi ép học sớm</strong>
            <p>Tập trung vào cách học, không phải học trước</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">👀</span>
            <strong>Quan sát cá nhân hoá</strong>
            <p>Mỗi trẻ được hiểu và hỗ trợ theo tiến trình riêng</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">💬</span>
            <strong>Môi trường giàu ngôn ngữ</strong>
            <p>Giúp trẻ phát triển giao tiếp tự nhiên</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">🤝</span>
            <strong>Đồng hành cùng phụ huynh</strong>
            <p>Không chỉ dạy trẻ, mà hướng dẫn cả gia đình</p>
          </div>
        </div>
      </div>
    </section>

    <!-- BLOCK 5: TEXT WITH IMAGE -->
    <section class="pp-textimg">
      <div class="pp-textimg-inner">
        <div class="pp-textimg-text">
          <h2>Trẻ không cần bị dạy để học<br/>Trẻ cần môi trường để tự học</h2>
          <p>Tại Việt Anh: Trẻ không ngồi yên để nghe giảng. Không bị ép làm theo một khuôn mẫu.</p>
          <p>Thay vào đó, trẻ được <strong>khám phá</strong>, đặt câu hỏi, tương tác liên tục.</p>
          <div class="pp-callout">Giáo viên không chỉ dạy — mà quan sát, dẫn dắt và khơi gợi</div>
          <p>Đây là cách trẻ: học tự nhiên, học sâu, và giữ được niềm yêu thích học tập.</p>
        </div>
        <div class="pp-textimg-img">
          <img src="https://lh3.googleusercontent.com/d/1YPDc_ytJS5kzmaoszabZ6pJ0UEbwjD3c" alt="Học sinh mầm non Việt Anh" loading="lazy" width="600" height="400" />
        </div>
      </div>
    </section>

    <!-- BLOCK 6: VALUE CARDS -->
    <section class="pp-valuecards">
      <div class="pp-valuecards-inner">
        <h2>Những giá trị trẻ nhận được</h2>
        <div class="pp-value-grid">
          <div class="pp-value-card">
            <span class="pp-icon">🌟</span>
            <strong>Yêu việc học</strong>
            <p>Không học vì bị ép, mà học vì muốn khám phá</p>
          </div>
          <div class="pp-value-card">
            <span class="pp-icon">🧠</span>
            <strong>Phát triển toàn diện</strong>
            <p>Ngôn ngữ – cảm xúc – thể chất – xã hội</p>
          </div>
          <div class="pp-value-card">
            <span class="pp-icon">💪</span>
            <strong>Tự tin & tự lập</strong>
            <p>Dám thử, dám sai, dám thể hiện</p>
          </div>
          <div class="pp-value-card">
            <span class="pp-icon">🗣️</span>
            <strong>Giao tiếp tốt</strong>
            <p>Biết nói, biết lắng nghe, biết tương tác</p>
          </div>
          <div class="pp-value-card">
            <span class="pp-icon">🎯</span>
            <strong>Nền tảng lâu dài</strong>
            <p>Không chỉ cho lớp 1, mà cho cả hành trình học tập</p>
          </div>
        </div>
      </div>
    </section>

    <!-- BLOCK 7: FAQ -->
    <section class="pp-faq">
      <div class="pp-faq-inner">
        <h2>Câu hỏi phụ huynh thường gặp</h2>
        <div class="pp-faq-item">
          <p class="pp-faq-q">Trẻ có cần học trước lớp 1 không?</p>
          <p class="pp-faq-a">Không. Quan trọng là phát triển nền tảng học tập — sự tò mò, khả năng tập trung và thói quen học — chứ không phải biết chữ hay làm toán sớm.</p>
        </div>
        <div class="pp-faq-item">
          <p class="pp-faq-q">Nếu không học trước, con có bị chậm không?</p>
          <p class="pp-faq-a">Không. Trẻ có nền tảng tốt — tự tin, tò mò, biết cách học — sẽ học nhanh hơn khi cần, thay vì sớm mất đi động lực.</p>
        </div>
        <div class="pp-faq-item">
          <p class="pp-faq-q">Làm sao biết con đang phát triển tốt?</p>
          <p class="pp-faq-a">Qua giao tiếp tự nhiên, sự tự tin khi thử điều mới, và khả năng tự chơi, tự học mà không cần người lớn hướng dẫn liên tục.</p>
        </div>
        <div class="pp-faq-item">
          <p class="pp-faq-q">Trường khác gì so với các trường khác?</p>
          <p class="pp-faq-a">Thay vì nhồi nhét kiến thức, Việt Anh tập trung kích hoạt bản năng học của trẻ — giúp trẻ tự muốn học, tự biết cách học và duy trì điều đó bền vững.</p>
        </div>
      </div>
    </section>

    <!-- BLOCK 8: FORM -->
    <section class="pp-form-block" id="pp-form">
      <div class="pp-form-block-inner">
        <h2>Nhận tư vấn cho con</h2>
        <p>Để lại thông tin — nhận Brochure chi tiết, tư vấn cá nhân hoá và lộ trình phù hợp cho con.</p>
        <ul>
          <li>Brochure chương trình mầm non chi tiết</li>
          <li>Tư vấn cá nhân hoá theo độ tuổi của bé</li>
          <li>Lộ trình phát triển phù hợp cho con</li>
        </ul>
        <LeadFormTwoStepEmailFirst
          formId="mam-non-pillar-form"
          funnelCode="mam-non-pillar"
          schoolLevel="mau-non"
        />
      </div>
    </section>

    <!-- BLOCK 9: LINKS -->
    <section class="pp-links">
      <div class="pp-links-inner">
        <h2>Khám phá các chương trình phù hợp</h2>
        <div class="pp-link-grid">
          <a href="/tuyen-sinh/mam-non" class="pp-link-card">
            <strong>Mầm non Việt Anh</strong>
            <span>Môi trường kích hoạt bản năng siêu học tập</span>
          </a>
          <a href="https://truongvietanh.com/tien-tieu-hoc" class="pp-link-card">
            <strong>Tiền Tiểu học</strong>
            <span>Giúp trẻ sẵn sàng bước vào lớp 1 đúng cách</span>
          </a>
          <a href="https://truongvietanh.com/toan-tu-duy" class="pp-link-card">
            <strong>Toán Tư Duy</strong>
            <span>Phát triển tư duy logic và giải quyết vấn đề</span>
          </a>
          <a href="https://truongvietanh.com/sieu-an-gioi" class="pp-link-card">
            <strong>Siêu Ăn Giỏi</strong>
            <span>Hình thành thói quen ăn uống lành mạnh và tự lập</span>
          </a>
          <a href="https://truongvietanh.com/thoi-khoa-bieu-mau-cac-khoi-lop/" class="pp-link-card" style="grid-column:1/-1">
            <strong>Thời khoá biểu mẫu các lớp</strong>
            <span>truongvietanh.com/thoi-khoa-bieu-mau-cac-khoi-lop/</span>
          </a>
        </div>
      </div>
    </section>

    <FooterBase />
  </div>

  <style>
    /* ===== PILLAR PAGE STYLES ===== */
    *, *::before, *::after { box-sizing: border-box; }
    .pp-page { font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; color: #1a1a2e; line-height: 1.6; }
    .pp-hero { background: linear-gradient(135deg, #1a1a5e 0%, #2d2d8e 100%); color: white; padding: 5rem 1.5rem; text-align: center; }
    .pp-hero-inner { max-width: 820px; margin: 0 auto; }
    .pp-h1 { font-size: 2.4rem; font-weight: 800; line-height: 1.3; margin-bottom: 1.25rem; color: #f5a623; }
    .pp-h1-accent { color: #ffffff; display: block; margin-top: .5rem; font-size: .9em; }
    .pp-subtitle { font-size: 1.1rem; color: #ffffff; opacity: 1; margin-bottom: 2.5rem; line-height: 1.75; }
    .pp-hero .pp-hero-inner > p { color: #ffffff; }
    .pp-cta-row { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
    .pp-btn { display: inline-block; padding: .9rem 2rem; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 1rem; transition: opacity .2s; }
    .pp-btn:hover { opacity: .88; }
    .pp-btn-gold { background: #f5a623; color: #0d2b55; }
    .pp-btn-outline { background: transparent; color: white; border: 2px solid rgba(255,255,255,.7); }
    .pp-richtext { background: #fff; padding: 4.5rem 1.5rem; }
    .pp-richtext-inner { max-width: 820px; margin: 0 auto; }
    .pp-richtext h2 { font-size: 1.5rem; font-weight: 800; color: #1a1a5e; text-transform: uppercase; margin-bottom: 1.5rem; line-height: 1.4; }
    .pp-richtext p { font-size: 1.05rem; color: #334155; line-height: 1.8; margin-bottom: 1rem; }
    .pp-callout { color: #1a1a5e; font-weight: 700; font-size: 1.05rem; padding: .6rem 1rem; border-left: 3px solid #e8b84b; margin: 1.25rem 0; background: #fffbeb; border-radius: 0 6px 6px 0; }
    .pp-stats { background: #f8fafc; padding: 4rem 1.5rem; border-top: 3px solid #e2e8f0; }
    .pp-stats-inner { max-width: 900px; margin: 0 auto; }
    .pp-stats-inner > h2 { font-size: 1.5rem; font-weight: 800; color: #1a1a5e; text-transform: uppercase; text-align: center; margin-bottom: 2rem; }
    .pp-stats-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
    .pp-stats-col { background: white; border-radius: 12px; padding: 1.75rem; box-shadow: 0 2px 10px rgba(0,0,0,.05); }
    .pp-stats-col h3 { font-size: 1rem; font-weight: 700; color: #1a1a5e; margin-bottom: 1rem; border-bottom: 2px solid #e8b84b; padding-bottom: .5rem; }
    .pp-stats-col ul { list-style: none; padding: 0; margin: 0; }
    .pp-stats-col li { padding: .4rem 0 .4rem 1.5rem; position: relative; color: #475569; font-size: .95rem; }
    .pp-stats-col li::before { content: '✓'; position: absolute; left: 0; color: #22c55e; font-weight: 700; }
    .pp-features { background: #1a1a5e; color: white; padding: 4.5rem 1.5rem; }
    .pp-features-inner { max-width: 1050px; margin: 0 auto; }
    .pp-features h2 { font-size: 1.5rem; font-weight: 800; text-align: center; text-transform: uppercase; margin-bottom: 2.5rem; color: #f5a623; }
    .pp-features, .pp-features .pp-feat-card p, .pp-features .pp-feat-card strong { color: #ffffff; }
    .pp-feat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
    .pp-feat-card { background: rgba(255,255,255,.08); border-radius: 12px; padding: 1.5rem; border: 1px solid rgba(255,255,255,.12); }
    .pp-feat-card .pp-icon { font-size: 2rem; display: block; margin-bottom: .75rem; }
    .pp-feat-card strong { display: block; font-size: 1rem; margin-bottom: .5rem; }
    .pp-feat-card p { font-size: .88rem; opacity: .82; line-height: 1.65; margin: 0; }
    .pp-textimg { background: white; padding: 4.5rem 1.5rem; }
    .pp-textimg-inner { max-width: 1050px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 3.5rem; align-items: center; }
    .pp-textimg-text h2 { font-size: 1.4rem; font-weight: 800; color: #1a1a5e; text-transform: uppercase; margin-bottom: 1.25rem; line-height: 1.4; }
    .pp-textimg-text p { color: #334155; line-height: 1.8; margin-bottom: .8rem; }
    .pp-textimg-img img { width: 100%; border-radius: 16px; box-shadow: 0 8px 30px rgba(0,0,0,.12); }
    .pp-valuecards { background: #f8fafc; padding: 4rem 1.5rem; }
    .pp-valuecards-inner { max-width: 1050px; margin: 0 auto; }
    .pp-valuecards h2 { font-size: 1.5rem; font-weight: 800; color: #1a1a5e; text-transform: uppercase; text-align: center; margin-bottom: 2rem; }
    .pp-value-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
    .pp-value-card { background: white; border-radius: 12px; padding: 1.5rem; box-shadow: 0 2px 12px rgba(0,0,0,.07); border-top: 3px solid #e8b84b; }
    .pp-value-card .pp-icon { font-size: 2rem; display: block; margin-bottom: .75rem; }
    .pp-value-card strong { display: block; color: #1a1a5e; font-size: 1rem; margin-bottom: .4rem; }
    .pp-value-card p { color: #475569; font-size: .88rem; line-height: 1.6; margin: 0; }
    .pp-faq { background: white; padding: 4rem 1.5rem; }
    .pp-faq-inner { max-width: 820px; margin: 0 auto; }
    .pp-faq h2 { font-size: 1.5rem; font-weight: 800; color: #1a1a5e; text-transform: uppercase; text-align: center; margin-bottom: 2rem; }
    .pp-faq-item { border-bottom: 1px solid #e2e8f0; padding: 1.25rem 0; }
    .pp-faq-q { font-size: 1rem; font-weight: 700; color: #1a1a5e; margin-bottom: .6rem; }
    .pp-faq-a { color: #475569; font-size: .95rem; line-height: 1.75; margin: 0; }
    .pp-form-block { background: #1a1a5e; padding: 4.5rem 1.5rem; }
    .pp-form-block-inner { max-width: 580px; margin: 0 auto; text-align: center; }
    .pp-form-block h2 { color: #f5a623; font-size: 1.5rem; font-weight: 800; margin-bottom: .75rem; }
    .pp-form-block p { color: rgba(255,255,255,.82); margin-bottom: 1.5rem; line-height: 1.7; }
