---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import { getPillarPage, buildFaqSchema } from '../lib/directus';

// Fetch FAQ + meta from Directus CMS (fallback to hardcode if API fails)
const cmsPage = await getPillarPage('mam-non');
const cmsFaqs = cmsPage?.faq_items || null;
const cmsTitle = cmsPage?.title || null;
const cmsDescription = cmsPage?.description || null;
const cmsH1 = cmsPage?.h1 || null;
const cmsSubtitle = cmsPage?.subtitle || null;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Trường Mầm Non Việt Anh",
    "alternateName": "Trường Mầm Non Song Ngữ Việt Anh",
    "url": "https://truongvietanh.com/mam-non",
    "logo": "https://truongvietanh.com/logo-crest-80.webp",
    "foundingDate": "2011",
    "description": "Trường Mầm Non Việt Anh với chương trình 100% tiếng Anh, phương pháp immersion, phát triển tự chủ từ 2-6 tuổi. 9 cơ sở tại TP.HCM, Long An, Kiên Giang.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Hồ Chí Minh",
      "addressCountry": "VN"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "bestRating": "5",
      "ratingCount": "300"
    },
    "numberOfEmployees": { "@type": "QuantitativeValue", "value": 500 },
    "areaServed": ["TP. Hồ Chí Minh", "Long An", "Kiên Giang"],
    "educationalLevel": "Preschool",
    "teaches": ["English Immersion", "Life Skills", "SAM Math", "Physical Education", "Arts"],
    "offers": {
      "@type": "Offer",
      "category": "Mầm Non Song Ngữ",
      "price": "5000000",
      "priceCurrency": "VND",
      "priceValidUntil": "2027-08-31",
      "description": "Học phí Mầm Non từ 5-8 triệu VND/tháng, bao gồm ăn bán trú và ngoại khóa cơ bản"
    },
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": [".gi-h1", ".gi-subtitle", ".aio-answer"]
    }
  },
  // FAQ schema — dynamic from CMS or fallback
  cmsFaqs ? buildFaqSchema(cmsFaqs) : {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Trường Mầm Non Việt Anh nhận trẻ từ mấy tuổi?", "acceptedAnswer": { "@type": "Answer", "text": "Trường Mầm Non Việt Anh nhận trẻ từ 18 tháng tuổi." } },
      { "@type": "Question", "name": "Con chưa biết tiếng Anh có theo kịp không?", "acceptedAnswer": { "@type": "Answer", "text": "Phương pháp immersion giúp trẻ tiếp thu tiếng Anh tự nhiên." } },
      { "@type": "Question", "name": "Trường có xe đưa rước không?", "acceptedAnswer": { "@type": "Answer", "text": "Có. Xe phủ khắp các quận tại TP.HCM." } },
      { "@type": "Question", "name": "Giáo viên là người bản ngữ hay Việt Nam?", "acceptedAnswer": { "@type": "Answer", "text": "Cả hai. GV bản ngữ dạy chính, GV Việt hỗ trợ." } },
      { "@type": "Question", "name": "So với trường quốc tế, mầm non Việt Anh khác gì?", "acceptedAnswer": { "@type": "Answer", "text": "Chất lượng tương đương, học phí 5-8 triệu/tháng." } },
      { "@type": "Question", "name": "Trường có xe đưa đón học sinh không?", "acceptedAnswer": { "@type": "Answer", "text": "Có. Xe đạt chuẩn an toàn, có giáo viên phụ trách, GPS theo dõi và bảo hiểm đầy đủ. Phụ huynh nhận thông báo qua app khi con lên/xuống xe." } },
      { "@type": "Question", "name": "Chương trình học mầm non có giúp con chuẩn bị vào lớp 1 không?", "acceptedAnswer": { "@type": "Answer", "text": "Có. Lớp Lá (5-6 tuổi) có chương trình Sẵn sàng vào Lớp 1: chữ cái Việt-Anh, số đếm, kỹ năng viết, rèn tập trung 30-45 phút, kỹ năng xã hội." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://truongvietanh.com" },
      { "@type": "ListItem", "position": 2, "name": "Chương trình", "item": "https://truongvietanh.com/gioi-thieu" },
      { "@type": "ListItem", "position": 3, "name": "Mầm non", "item": "https://truongvietanh.com/mam-non" }
    ]
  }
];
---

<BaseLayout
  title={cmsTitle || "Mầm Non Việt Anh – 100% Tiếng Anh Tại TP.HCM"}
  description={cmsDescription || "Mầm Non Việt Anh: 100% tiếng Anh immersion, phát triển tự chủ 2-6 tuổi. 9 cơ sở tại TP.HCM, Long An, Kiên Giang. Đăng ký tham quan miễn phí."}
  canonical="https://truongvietanh.com/mam-non"
  ogImage="https://media.truongvietanh.com/images/extra-giao-vien-va-hoc-sinh-2.webp"
  structuredData={structuredData}
>
  <div class="gi-page">
    <HeaderBase />

    <!-- ====== LAYER 2: HERO WITH FORM ====== -->
    <section class="gi-hero">
      <div class="gi-container gi-hero-inner">
        <div class="gi-hero-left">
          <nav class="gi-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Trang chủ</a>
            <span aria-hidden="true">/</span>
            <a href="/gioi-thieu">Chương trình</a>
            <span aria-hidden="true">/</span>
            <span>Mầm non</span>
          </nav>

          <h1 class="gi-h1">{cmsH1 || "Trường Mầm Non Việt Anh: Nơi Con Học Tiếng Anh Như Trẻ Bản Xứ"}</h1>
          <p class="gi-subtitle">{cmsSubtitle || "Chương trình 100% tiếng Anh — Phát triển tự chủ từ 2-6 tuổi"}</p>
          <p class="gi-last-updated">Cập nhật lần cuối: Tháng 4, 2026</p>

          <div class="gi-hero-rating">
            <span class="gi-stars" aria-label="4.9 trên 5 sao">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            <span class="gi-rating-text">4.9/5 (300+ đánh giá)</span>
          </div>

          <div class="gi-trust-badges">
            <div class="gi-badge"><strong>100%</strong> Tiếng Anh</div>
            <div class="gi-badge"><strong>GV</strong> Bản ngữ</div>
            <div class="gi-badge"><strong>9</strong> Cơ sở</div>
            <div class="gi-badge"><strong>5-8tr</strong> /tháng</div>
          </div>
        </div>

        <div class="gi-hero-right">
          <div class="gi-form-card">
            <p class="gi-form-heading">Đăng ký tham quan trường mầm non miễn phí</p>
            <LeadFormTwoStepEmailFirst
              formId="mam-non-form"
              funnelCode="mam-non-pillar"
              schoolLevel="mau-non"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ====== LAYER 3 + 4: TOC SIDEBAR + CONTENT ====== -->
    <div class="gi-container gi-body">
      <p class="gi-last-updated">Cập nhật lần cuối: Tháng 4/2026</p>
      <!-- Sticky TOC sidebar -->
      <nav class="gi-toc" aria-label="Mục lục">
        <p class="gi-toc-title">Mục lục</p>
        <ol class="gi-toc-list">
          <li><a href="#tong-quan">Tổng quan khác biệt</a></li>
          <li><a href="#chuong-trinh">Chương trình học</a></li>
          <li><a href="#tieng-anh">Tiếng Anh 100%</a></li>
          <li><a href="#pdr">Hệ thống PDR</a></li>
          <li><a href="#co-so">Các cơ sở</a></li>
          <li><a href="#hoc-phi">Học phí</a></li>
          <li><a href="#danh-gia">Đánh giá phụ huynh</a></li>
          <li><a href="#faq">Câu hỏi thường gặp</a></li>
        </ol>
        <a href="#mam-non-form-mam-non-pillar" class="gi-toc-cta">Đăng ký tham quan</a>
      </nav>

      <!-- Main content -->
      <article class="gi-main">

        <!-- Section 1: Tổng quan -->
        <section id="tong-quan" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg></span>Trường Mầm Non Việt Anh có gì khác biệt?</h2>
          <p>Trường Mầm Non Việt Anh áp dụng phương pháp <strong>immersion</strong> — được <a href="https://www.unicef.org/early-childhood-development" target="_blank" rel="noopener">UNICEF</a> và <a href="https://www.britishcouncil.org" target="_blank" rel="noopener">British Council</a> khuyến nghị cho giáo dục sớm — trẻ 2-6 tuổi học hoàn toàn bằng tiếng Anh với giáo viên bản ngữ. Ngoài tiếng Anh, trẻ được rèn luyện 5 giá trị cốt lõi và phát triển tính tự chủ qua hệ thống PDR (Plan-Do-Review).</p>
          <p>Khác với nhiều trường mầm non "song ngữ" chỉ dạy vài giờ tiếng Anh mỗi tuần, tại Việt Anh <strong>100% thời gian trong lớp là tiếng Anh</strong>. Trẻ được tiếp xúc ngôn ngữ tự nhiên qua vui chơi, hát, kể chuyện, dự án nhóm và các hoạt động ngoài trời — giúp tiếp thu tiếng Anh giống như cách trẻ bản xứ học tiếng mẹ đẻ.</p>
          <p>Đây không phải là "dạy tiếng Anh" theo nghĩa truyền thống. Trẻ không ngồi học bảng chữ cái hay lặp lại từ vựng. Thay vào đó, tiếng Anh là phương tiện giao tiếp hàng ngày — trẻ dùng tiếng Anh để chơi, để hỏi, để giải quyết vấn đề, và để tương tác với bạn bè và giáo viên.</p>
          <p>Mô hình giáo dục mầm non tại Việt Anh kết hợp 3 trụ cột chính: ngôn ngữ (tiếng Anh immersion), nhân cách (5 giá trị cốt lõi + Leader in Me), và tư duy (SAM Math + dự án thực hành). Ba trụ cột này tạo nền tảng vững chắc cho trẻ bước vào bậc tiểu học với sự tự tin và kỹ năng vượt trội.</p>

          <div class="gi-evidence-bar">
            <div class="gi-evidence-item">
              <strong>95%</strong>
              <span>Đạt Cambridge YLE Starters sau 2 năm</span>
            </div>
            <div class="gi-evidence-item">
              <strong>100%</strong>
              <span>Thời gian trong lớp bằng tiếng Anh</span>
            </div>
            <div class="gi-evidence-item">
              <strong>6-8h</strong>
              <span>Tiếp xúc tiếng Anh mỗi ngày</span>
            </div>
            <div class="gi-evidence-item">
              <strong>2-6</strong>
              <span>Tuổi tiếp nhận</span>
            </div>
          </div>

          <p>Phụ huynh thường lo lắng: "Con mới 2-3 tuổi, chưa nói rõ tiếng Việt, làm sao học tiếng Anh?". Thực tế, đây chính là giai đoạn vàng. Não bộ trẻ 2-6 tuổi có khả năng xử lý đồng thời nhiều ngôn ngữ mà không bị nhầm lẫn — điều mà người lớn không thể làm được. Trẻ tại Việt Anh vẫn phát triển tiếng Việt bình thường tại nhà, đồng thời thành thạo tiếng Anh tại trường.</p>

          <img src="https://media.truongvietanh.com/images/vui-ve-06.webp" alt="Bé mầm non vui chơi tại Trường Việt Anh" loading="lazy" width="1200" height="auto" class="section-img" />
        </section>

        <!-- Section 2: Chương trình -->
        <section id="chuong-trinh" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg></span>Chương trình học mầm non tại Trường Việt Anh gồm những gì?</h2>
          <p>Chương trình mầm non tại Trường Việt Anh được thiết kế toàn diện, không chỉ tập trung vào tiếng Anh mà còn phát triển tư duy, thể chất, cảm xúc và kỹ năng xã hội của trẻ. Mỗi ngày học được sắp xếp cân bằng giữa 5 lĩnh vực chính.</p>

          <div class="gi-roadmap">
            <h3>5 lĩnh vực phát triển toàn diện</h3>
            <div class="gi-roadmap-grid mn-program-grid">
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">TA</div>
                <strong>Tiếng Anh Immersion</strong>
                <p>100% tiếng Anh với giáo viên bản ngữ (Anh, Mỹ, Úc). Trẻ học qua vui chơi, hát, kể chuyện, đóng kịch và dự án nhóm. Phương pháp đắm mình (immersion) giúp trẻ tiếp thu tự nhiên, không cần dịch thuật. Mục tiêu: giao tiếp tự tin sau 6 tháng, đạt Cambridge YLE Starters sau 2 năm.</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">TT</div>
                <strong>Toán tư duy (SAM)</strong>
                <p>Chương trình SAM (Singapore Approach to Math) dạy toán qua hình ảnh và vật cụ thể. Trẻ 3-4 tuổi bắt đầu với nhận biết số, hình khối, phân loại. Trẻ 5-6 tuổi giải bài toán tư duy logic, so sánh, sắp xếp và tư duy không gian. Tất cả được dạy bằng tiếng Anh.</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">KN</div>
                <strong>Kỹ năng sống</strong>
                <p>5 giá trị cốt lõi (Tôn trọng & Tự trọng, Trách nhiệm, Tài giỏi, Chính trực, Yêu thương) + 7 thói quen lãnh đạo từ chương trình Leader in Me (Franklin Covey). Trẻ học cách tự phục vụ bản thân, giải quyết xung đột, làm việc nhóm và chịu trách nhiệm với hành vi của mình.</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">TC</div>
                <strong>Thể chất & Vận động</strong>
                <p>Bơi lội (bể bơi tại trường), thể dục buổi sáng, vận động ngoài trời, yoga cho trẻ nhỏ. Trẻ vận động ít nhất 60 phút/ngày theo khuyến nghị của WHO. Phát triển thể lực, sự phối hợp và tinh thần đồng đội.</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">NT</div>
                <strong>Nghệ thuật sáng tạo</strong>
                <p>Âm nhạc (hát, nhạc cụ Orff), mỹ thuật (vẽ, nặn đất sét, cắt dán), kịch nghệ (đóng vai, kể chuyện sáng tạo). Các tiết nghệ thuật được dạy bằng tiếng Anh, kết hợp chủ đề học tập hàng tháng — giúp trẻ thể hiện bản thân và phát triển trí tưởng tượng.</p>
              </div>
            </div>
          </div>

          <h3>Thời khoá biểu mẫu một ngày tại mầm non Việt Anh</h3>
          <div class="gi-table-responsive">
            <table class="gi-table">
              <thead>
                <tr>
                  <th>Thời gian</th>
                  <th>Hoạt động</th>
                  <th>Ngôn ngữ</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>7:30 - 8:00</td>
                  <td>Đón trẻ, hoạt động tự do</td>
                  <td>Tiếng Anh</td>
                </tr>
                <tr>
                  <td>8:00 - 8:30</td>
                  <td>Morning Circle (chào buổi sáng, chia sẻ)</td>
                  <td>Tiếng Anh</td>
                </tr>
                <tr>
                  <td>8:30 - 9:30</td>
                  <td>Tiết học chính (Literacy / Numeracy / Science)</td>
                  <td>Tiếng Anh</td>
                </tr>
                <tr>
                  <td>9:30 - 10:00</td>
                  <td>Snack + Vận động ngoài trời</td>
                  <td>Tiếng Anh</td>
                </tr>
                <tr>
                  <td>10:00 - 11:00</td>
                  <td>Dự án nhóm / Nghệ thuật / Thể chất</td>
                  <td>Tiếng Anh</td>
                </tr>
                <tr>
                  <td>11:00 - 11:30</td>
                  <td>Ăn trưa</td>
                  <td>Tiếng Anh + Tiếng Việt (hỗ trợ)</td>
                </tr>
                <tr>
                  <td>11:30 - 13:30</td>
                  <td>Ngủ trưa</td>
                  <td>—</td>
                </tr>
                <tr>
                  <td>13:30 - 14:00</td>
                  <td>Snack chiều + Đọc sách</td>
                  <td>Tiếng Anh</td>
                </tr>
                <tr>
                  <td>14:00 - 15:00</td>
                  <td>Tiết học chiều (Toán SAM / KNS / PDR)</td>
                  <td>Tiếng Anh</td>
                </tr>
                <tr>
                  <td>15:00 - 16:00</td>
                  <td>Hoạt động ngoài trời / Bơi lội</td>
                  <td>Tiếng Anh</td>
                </tr>
                <tr>
                  <td>16:00 - 16:30</td>
                  <td>Review ngày + Trả trẻ</td>
                  <td>Tiếng Anh</td>
                </tr>
                <tr>
                  <td>16:30 - 17:30</td>
                  <td>Afterschool (tuỳ chọn)</td>
                  <td>Tiếng Anh</td>
                </tr>
              </tbody>
            </table>
          </div>

          <p>Mỗi tháng, chương trình xoay quanh một chủ đề trung tâm (ví dụ: Động vật, Gia đình, Cộng đồng, Thời tiết) — giúp trẻ tích luỹ từ vựng và kiến thức một cách hệ thống. Cuối tháng, trẻ trình bày dự án nhóm trước lớp, rèn kỹ năng thuyết trình từ nhỏ.</p>

          <img src="https://media.truongvietanh.com/images/giao-vien-04.webp" alt="Giáo viên mầm non Trường Việt Anh" loading="lazy" width="1200" height="auto" class="section-img" />
        </section>

        <!-- Section 3: Tiếng Anh -->
        <section id="tieng-anh" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg></span>Trẻ mầm non có thể học tiếng Anh 100% không?</h2>
          <p>Đây là câu hỏi phổ biến nhất mà phụ huynh đặt ra khi tìm hiểu về Trường Mầm Non Việt Anh. Câu trả lời ngắn gọn: <strong>Có, và đây chính là thời điểm tốt nhất.</strong></p>

          <p>Theo nghiên cứu của MIT (2018), trẻ dưới 6 tuổi có khả năng tiếp thu ngôn ngữ thứ hai gần như bản ngữ nếu được tiếp xúc ít nhất 4 giờ mỗi ngày. Sau 6 tuổi, khả năng này giảm dần và gần như mất hoàn toàn sau tuổi dậy thì. Đây là lý do Trường Việt Anh thiết kế chương trình immersion ngay từ bậc mầm non.</p>

          <div class="gi-comparison-box">
            <h3>So sánh: Immersion vs Dạy tiếng Anh truyền thống</h3>
            <div class="gi-table-responsive">
              <table class="gi-table">
                <thead>
                  <tr>
                    <th>Tiêu chí</th>
                    <th>Immersion (Việt Anh)</th>
                    <th>Dạy TA truyền thống</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Thời lượng tiếng Anh</td>
                    <td>6-8 giờ/ngày (100%)</td>
                    <td>2-4 giờ/tuần</td>
                  </tr>
                  <tr>
                    <td>Phương pháp</td>
                    <td>Đắm mình, tự nhiên</td>
                    <td>Dịch thuật, lặp lại</td>
                  </tr>
                  <tr>
                    <td>Giáo viên</td>
                    <td>Bản ngữ (Anh/Mỹ/Úc)</td>
                    <td>Chủ yếu GV Việt Nam</td>
                  </tr>
                  <tr>
                    <td>Cách tiếp thu</td>
                    <td>Như học tiếng mẹ đẻ</td>
                    <td>Dịch từ tiếng Việt sang</td>
                  </tr>
                  <tr>
                    <td>Kết quả sau 2 năm</td>
                    <td>Giao tiếp tự nhiên, Cambridge YLE</td>
                    <td>Biết vài trăm từ rời rạc</td>
                  </tr>
                  <tr>
                    <td>Phát âm</td>
                    <td>Gần chuẩn bản ngữ</td>
                    <td>Ảnh hưởng giọng Việt</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>Tại Trường Mầm Non Việt Anh, trẻ học 6-8 tiếng mỗi ngày hoàn toàn bằng tiếng Anh — gấp hơn 10 lần so với các trường mầm non "song ngữ" thông thường. Đây không phải là phương pháp dịch thuật (trẻ nghe tiếng Việt rồi dịch sang tiếng Anh), mà là <strong>immersion — đắm mình</strong>: trẻ suy nghĩ, cảm nhận và phản hồi trực tiếp bằng tiếng Anh.</p>

          <p>Quá trình tiếp thu ngôn ngữ của trẻ tại Việt Anh thường trải qua 4 giai đoạn rõ rệt:</p>

          <div class="gi-roadmap">
            <h3>4 giai đoạn tiếp thu tiếng Anh theo phương pháp immersion</h3>
            <div class="gi-roadmap-grid">
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">T1-3</div>
                <strong>Giai đoạn im lặng</strong>
                <p>Tháng 1-3: Trẻ chủ yếu nghe và quan sát. Chưa nói nhưng đang tiếp thu rất nhiều. Phụ huynh không cần lo lắng — đây là giai đoạn hoàn toàn bình thường.</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">T3-6</div>
                <strong>Giai đoạn phản hồi</strong>
                <p>Tháng 3-6: Trẻ bắt đầu phản hồi bằng từ đơn, cụm từ ngắn. Hiểu hầu hết chỉ dẫn của giáo viên. Bắt đầu sử dụng tiếng Anh trong giao tiếp hàng ngày.</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">T6-12</div>
                <strong>Giai đoạn giao tiếp</strong>
                <p>Tháng 6-12: Trẻ nói câu ngắn, kể chuyện đơn giản, hát bài hát tiếng Anh. Tự tin hơn khi giao tiếp với giáo viên và bạn bè trong lớp.</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">12+</div>
                <strong>Giai đoạn thành thạo</strong>
                <p>Sau 12 tháng: Trẻ giao tiếp tự nhiên, phát âm gần chuẩn bản ngữ. Có thể hiểu và kể lại câu chuyện, thảo luận chủ đề quen thuộc bằng tiếng Anh.</p>
              </div>
            </div>
          </div>

          <p>Kết quả thực tế tại Trường Việt Anh: <strong>95% trẻ mầm non đạt Cambridge YLE Starters sau 2 năm học</strong>. Nhiều trẻ có thể giao tiếp tự nhiên với người nước ngoài — khiến phụ huynh vô cùng ngạc nhiên khi con "bật" tiếng Anh ở nhà.</p>
        </section>

        <!-- Section 4: PDR -->
        <section id="pdr" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg></span>Hệ thống PDR rèn luyện tự chủ cho trẻ mầm non như thế nào?</h2>
          <p>PDR là viết tắt của <strong>Personal Development Record</strong> (Sổ phát triển cá nhân) — hệ thống đánh giá và rèn luyện riêng biệt của Trường Việt Anh, được thiết kế để phát triển tính tự chủ, kỷ luật và nhân cách cho trẻ ngay từ bậc mầm non.</p>

          <p>Mỗi trẻ tại Trường Mầm Non Việt Anh có một cuốn PDR riêng. Giáo viên theo dõi sự phát triển của trẻ hàng tuần qua 5 lĩnh vực, ghi nhận tiến bộ và đặt mục tiêu phát triển cho tuần tiếp theo. Phụ huynh nhận báo cáo PDR định kỳ để nắm rõ quá trình phát triển của con.</p>

          <div class="gi-values-grid">
            <h3>5 giá trị cốt lõi được rèn luyện qua PDR</h3>
            <div class="gi-values-items">
              <div class="gi-value-card">
                <span class="gi-value-icon">&#9878;</span>
                <strong>Tôn trọng & Tự trọng</strong>
                <p>Tôn trọng sự khác biệt và học tập trong khiêm nhường. Trẻ học cách lắng nghe, chấp nhận bạn bè và trân trọng bản thân.</p>
              </div>
              <div class="gi-value-card">
                <span class="gi-value-icon">&#9829;</span>
                <strong>Trách nhiệm</strong>
                <p>Nhận trách nhiệm về bản thân, mọi người và mọi thứ. Trẻ học cách tự giác và chịu trách nhiệm với hành vi của mình.</p>
              </div>
              <div class="gi-value-card">
                <span class="gi-value-icon">&#9881;</span>
                <strong>Tài giỏi</strong>
                <p>Luôn tìm cách tối ưu năng lực bản thân và cố gắng đến cùng trong mọi việc. Trẻ được khuyến khích phát huy hết tiềm năng.</p>
              </div>
              <div class="gi-value-card">
                <span class="gi-value-icon">&#9733;</span>
                <strong>Chính trực</strong>
                <p>Chỉ làm điều đúng đắn, trở thành tấm gương sáng cho mọi người. Trẻ học cách trung thực và ngay thẳng.</p>
              </div>
              <div class="gi-value-card">
                <span class="gi-value-icon">&#9889;</span>
                <strong>Yêu thương</strong>
                <p>Hành động vì hạnh phúc của người khác. Trẻ được dạy lòng nhân ái và sự quan tâm đến mọi người xung quanh.</p>
              </div>
            </div>
          </div>

          <h3>PDR vận hành như thế nào trong thực tế?</h3>
          <p>Mỗi ngày, giáo viên quan sát và ghi nhận hành vi của trẻ theo 5 giá trị. Cuối tuần, giáo viên tổng hợp nhận xét và đánh giá mức độ tiến bộ. Hàng tháng, phụ huynh nhận báo cáo PDR chi tiết kèm hình ảnh và video minh hoạ hoạt động của trẻ tại trường.</p>
          <p>PDR không phải là "chấm điểm" hay "xếp hạng". Mục đích của PDR là giúp phụ huynh và giáo viên cùng hiểu rõ con đang ở đâu trên hành trình phát triển, từ đó phối hợp tốt hơn giữa nhà và trường.</p>

          <div class="gi-leader-grid">
            <div class="gi-leader-card">
              <h4>Phụ huynh nhận được gì từ PDR?</h4>
              <ul>
                <li>Báo cáo hàng tháng về 5 giá trị cốt lõi</li>
                <li>Nhận xét cụ thể của giáo viên chủ nhiệm</li>
                <li>Hình ảnh và video hoạt động của trẻ</li>
                <li>Đề xuất hoạt động rèn luyện tại nhà</li>
                <li>Buổi họp phụ huynh-giáo viên hàng quý</li>
              </ul>
            </div>
            <div class="gi-leader-card">
              <h4>Trẻ phát triển gì qua PDR?</h4>
              <ul>
                <li>Biết tự phục vụ bản thân (mặc áo, đánh răng, dọn đồ)</li>
                <li>Biết cách giải quyết xung đột với bạn bè</li>
                <li>Tự tin phát biểu và thuyết trình trước lớp</li>
                <li>Có ý thức trách nhiệm với bản thân và cộng đồng</li>
                <li>Kiên trì hoàn thành nhiệm vụ dù khó khăn</li>
              </ul>
            </div>
          </div>

          <p>Hệ thống PDR là một trong những điểm khác biệt lớn nhất của Trường Việt Anh so với các trường mầm non khác. Trong khi hầu hết trường chỉ đánh giá trẻ qua "ngoan" hay "hư", Việt Anh theo dõi sự phát triển nhân cách một cách có hệ thống, khoa học và lâu dài.</p>
        </section>

        <!-- Section 5: Cơ sở -->
        <section id="co-so" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg></span>Các cơ sở mầm non Việt Anh ở đâu tại TP.HCM?</h2>
          <p>Trường Mầm Non Việt Anh hiện có nhiều cơ sở trải rộng tại TP.HCM và các tỉnh lân cận. Mỗi cơ sở đều đạt tiêu chuẩn an toàn, với phòng học máy lạnh, sân chơi rộng rãi, bể bơi (tại một số cơ sở) và hệ thống camera giám sát 24/7.</p>

          <div class="gi-campus-groups">
            <div class="gi-campus-group">
              <h3>TP. Hồ Chí Minh</h3>
              <ul>
                <li><strong>Trường Mầm non Việt Anh Gò Vấp:</strong> 573 Đ. Lê Đức Thọ, Phường An Hội Tây, Q. Gò Vấp. Cơ sở chuyên mầm non, sân chơi rộng, bể bơi, phòng nghệ thuật riêng.</li>
                <li><strong>Trường Việt Anh Gò Vấp (Liên cấp MN-TH-THCS-THPT):</strong> 160/72 Phan Huy Ích, Q. Gò Vấp. Cơ sở liên cấp với khu mầm non riêng biệt, thuận tiện cho gia đình có nhiều con ở các cấp khác nhau.</li>
                <li><strong>Trường Việt Anh Phan Huy Ích:</strong> 160/72 Phan Huy Ích, phường An Hội Tây, Thành phố Hồ Chí Minh. Cơ sở liên cấp hiện đại giữa nội thành.</li>
                <li><strong>Trường Việt Anh Bình Chánh:</strong> Hệ thống liên cấp tại H. Bình Chánh. Khuôn viên rộng rãi, nhiều không gian xanh cho trẻ vận động ngoài trời.</li>
              </ul>
            </div>
            <div class="gi-campus-group">
              <h3>Long An</h3>
              <ul>
                <li><strong>Cơ sở TP. Tân An:</strong> Mầm non + Tiểu học + THCS. Trẻ mầm non học tại khu vực riêng, an toàn.</li>
                <li><strong>Cơ sở Đức Hoà:</strong> Mầm non + Tiểu học. Phù hợp cho gia đình tại khu vực Đức Hoà, Long An.</li>
                <li><strong>Cơ sở Bến Lức:</strong> Mầm non + Tiểu học. Cơ sở mới, trang thiết bị hiện đại.</li>
              </ul>
            </div>
            <div class="gi-campus-group">
              <h3>Kiên Giang</h3>
              <ul>
                <li><strong>Cơ sở TP. Rạch Giá:</strong> Mầm non + Tiểu học + THCS.</li>
                <li><strong>Cơ sở Phú Quốc:</strong> Mầm non + Tiểu học. Môi trường xanh, thoáng mát, kết hợp các hoạt động ngoài trời đặc thù.</li>
              </ul>
            </div>
          </div>

          <p>Tất cả cơ sở mầm non đều có <strong>xe đưa rước</strong> phục vụ phụ huynh. Tại TP.HCM, xe phủ khắp các quận: Gò Vấp, Phú Nhuận, Bình Thạnh, Tân Bình, Tân Phú, Quận 12, Bình Tân. Xe có camera giám sát, GPS thời gian thực và phụ xe chuyên trách. <a href="/co-so">Xem bản đồ và địa chỉ chi tiết &rarr;</a></p>
        </section>

        <!-- Section 6: Học phí -->
        <section id="hoc-phi" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg></span>Học phí trường mầm non Việt Anh bao nhiêu 1 tháng?</h2>
          <p>Học phí mầm non tại Trường Việt Anh dao động từ <strong>5 đến 8 triệu đồng mỗi tháng</strong> tuỳ theo chương trình và cơ sở. Mức học phí này đã bao gồm toàn bộ chi phí: học phí chính khoá, ăn trưa, snack, hoạt động ngoại khoá cơ bản. Phụ huynh không phải lo phát sinh thêm phí ngoài dự kiến.</p>

          <p>So với trường quốc tế (15-30 triệu/tháng), Trường Việt Anh mang đến chất lượng giáo dục tương đương — giáo viên bản ngữ, 100% tiếng Anh, chương trình chuẩn quốc tế — nhưng với mức học phí phù hợp hơn cho đại đa số gia đình Việt Nam.</p>

