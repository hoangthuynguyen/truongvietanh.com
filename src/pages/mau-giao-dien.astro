---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';

const templates = [
  {
    name: 'Pillar Pages (gi-page)',
    file: 'src/styles/global.css → class .gi-*',
    count: 15,
    sample: '/mam-non',
    description: 'Trang chương trình chính: hero + form, TOC, sections nội dung, FAQ, CTA bottom, author bio. Dùng cho tất cả trang giới thiệu chương trình.',
    pages: ['gioi-thieu', 'mam-non', 'tieu-hoc', 'trung-hoc-co-so', 'trung-hoc-pho-thong', 'co-so', 'hoc-phi', 'tuyen-sinh', 'triet-ly-giao-duc', 'he-thong-pdr', 'ngoai-khoa', 'thanh-tich', 'phu-huynh', 'lien-he', 'cap-hoc'],
  },
  {
    name: 'Squeeze Pages',
    file: 'src/layouts/SqueezePageLayout.astro',
    count: 24,
    sample: '/tuyen-sinh/mam-non/gioi-thieu',
    description: 'Trang lead capture: hero ngắn, USP grid, trust metrics, form nổi bật, FAQ ngắn. Tối ưu cho conversion, mobile-first.',
    pages: ['tuyen-sinh/mam-non/*', 'tuyen-sinh/tieu-hoc/*', 'tuyen-sinh/thcs/*', 'tuyen-sinh/thpt/*'],
  },
  {
    name: 'Lop-6 A/B Test',
    file: 'src/pages/tuyen-sinh/thcs/lop-6/checklist-a.astro',
    count: 10,
    sample: '/tuyen-sinh/thcs/lop-6/checklist-a',
    description: 'Squeeze pages inline HTML cho A/B testing lớp 6 THCS. 5 loại x 2 variants (A/B): checklist, early-bird, pain-point, school-tour, webinar.',
    pages: ['checklist-a/b', 'early-bird-a/b', 'pain-point-a/b', 'school-tour-a/b', 'webinar-a/b'],
  },
  {
    name: 'Thank You (Cam-On)',
    file: 'src/pages/tuyen-sinh/thcs/checklist/cam-on/index.astro',
    count: 26,
    sample: '/tuyen-sinh/thcs/checklist/cam-on',
    description: 'Trang cảm ơn sau đăng ký: icon, countdown timer, Zalo/phone CTA, next step links. Compact, conversion-focused.',
    pages: ['*/cam-on/ across all levels'],
  },
  {
    name: 'Blog Post',
    file: 'src/pages/blog/[slug].astro',
    count: 1203,
    sample: '/tin-tuc',
    description: 'Template blog: breadcrumb, article header, reading progress bar, auto TOC, share buttons, related posts, author bio, CTA form.',
    pages: ['1203 bài từ Directus CMS'],
  },
  {
    name: 'Homepage',
    file: 'src/pages/index.astro',
    count: 1,
    sample: '/',
    description: 'Trang chủ: dark hero, AIO answer, stats, "Tại sao chọn VA", chương trình, cơ sở, testimonials, blog, FAQ, form.',
    pages: ['/'],
  },
  {
    name: 'Custom Static',
    file: 'Mỗi trang có <style> riêng',
    count: 5,
    sample: '/so-sanh',
    description: 'Trang đặc biệt với layout riêng: tin-tuc (blog listing), hinh-anh (gallery), so-sanh (bảng so sánh), su-kien (events), hoc-bong (scholarships).',
    pages: ['tin-tuc', 'hinh-anh', 'so-sanh', 'su-kien', 'hoc-bong'],
  },
  {
    name: 'Public HTML',
    file: 'public/tuyen-sinh/*/index.html',
    count: 21,
    sample: '/tuyen-sinh/thcs/chuong-trinh-hoc',
    description: 'Trang HTML tĩnh trong public/ folder — serve trực tiếp, không qua Astro build. Funnel pages cũ.',
    pages: ['tuyen-sinh/*/chuong-trinh-hoc, hoc-phi, phu-huynh-noi-gi, xac-nhan-tour, cam-on'],
  },
];
---

<BaseLayout
  title="Mẫu Giao Diện — Templates Trường Việt Anh"
  description="Danh sách 8 templates đang dùng trên website Trường Việt Anh. Hướng dẫn chỉnh sửa giao diện."
  noindex={true}
>
  <div class="cf-layout page-wrapper">
    <HeaderBase />

    <section class="page-hero">
      <div class="cf-container text-center">
        <h1 class="page-title">Mẫu Giao Diện (Templates)</h1>
        <p class="page-desc">8 templates đang dùng — click "Xem mẫu" để xem trang live, "File cần sửa" để biết sửa ở đâu</p>
      </div>
    </section>

    <section class="templates-section">
      <div class="cf-container">
        <div class="templates-grid">
          {templates.map((t, i) => (
            <article class="template-card">
              <div class="template-header">
                <span class="template-number">{i + 1}</span>
                <div>
                  <h2 class="template-name">{t.name}</h2>
                  <span class="template-count">{t.count} trang</span>
                </div>
              </div>
              <p class="template-desc">{t.description}</p>
              <div class="template-file">
                <strong>File cần sửa:</strong> <code>{t.file}</code>
              </div>
              <div class="template-pages">
                <strong>Trang áp dụng:</strong>
                <div class="template-tags">
                  {t.pages.slice(0, 6).map(p => <span class="template-tag">{p}</span>)}
                  {t.pages.length > 6 && <span class="template-tag">+{t.pages.length - 6} khác</span>}
                </div>
              </div>
              <a href={t.sample} class="template-cta" target="_blank">Xem mẫu live</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <FooterBase />
  </div>
</BaseLayout>

<style>
  .cf-container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  .text-center { text-align: center; }
  .page-hero { background: linear-gradient(135deg, #0d1b3e, #1a1a5e); color: #fff; padding: 3rem 0 2.5rem; }
  .page-title { font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 800; margin: 0 0 0.5rem; }
  .page-desc { font-size: 1rem; color: rgba(255,255,255,0.7); margin: 0; }
  .templates-section { padding: 3rem 0; }
  .templates-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 1.5rem; }
  .template-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 1.75rem; transition: box-shadow 0.2s; display: flex; flex-direction: column; gap: 0.75rem; }
  .template-card:hover { box-shadow: 0 8px 30px rgba(0,0,0,0.08); }
  .template-header { display: flex; align-items: center; gap: 1rem; }
  .template-number { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; background: #1a1a5e; color: #fff; font-weight: 800; border-radius: 10px; font-size: 1.1rem; flex-shrink: 0; }
  .template-name { font-size: 1.1rem; font-weight: 700; color: #1a1a5e; margin: 0; }
  .template-count { font-size: 0.82rem; color: #D4A843; font-weight: 700; }
  .template-desc { font-size: 0.88rem; color: #475569; line-height: 1.6; margin: 0; }
  .template-file { font-size: 0.82rem; color: #64748b; }
  .template-file code { background: #f1f5f9; padding: 0.15rem 0.4rem; border-radius: 4px; font-size: 0.78rem; word-break: break-all; }
  .template-pages { font-size: 0.82rem; color: #64748b; }
  .template-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.3rem; }
  .template-tag { padding: 0.15rem 0.5rem; background: #f1f5f9; border-radius: 4px; font-size: 0.75rem; color: #475569; }
  .template-cta { display: inline-block; margin-top: auto; padding: 0.6rem 1.25rem; background: linear-gradient(135deg, #f5c518, #e8a912); color: #1a1a5e; font-weight: 700; border-radius: 8px; text-decoration: none; text-align: center; font-size: 0.9rem; }
</style>
