---
import SqueezePageLayout from '../layouts/SqueezePageLayout.astro';
import USPGrid from '../components/USPGrid.astro';
import TrustMetrics from '../components/TrustMetrics.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import FAQSection from '../components/FAQSection.astro';

const pageTitle = "Open Day Trường Việt Anh — Trải Nghiệm 1 Ngày Thực Tế | Trường Việt Anh";
const pageDescription = "Tham quan toàn bộ cơ sở · Gặp Ban Lãnh Đạo · Trải nghiệm tiết học · Demo chương trình quốc tế. Hoàn toàn miễn phí.";
const pageCanonical = "https://truongvietanh.com/open-day";

const uspItems = [
    {
      "icon": "🏫",
      "text": "Tham quan toàn bộ cơ sở vật chất — phòng học, sân chơi, thư viện, nhà ăn"
    },
    {
      "icon": "👨‍🏫",
      "text": "Gặp Hiệu trưởng & Trưởng các bộ môn — hỏi đáp trực tiếp"
    },
    {
      "icon": "🎬",
      "text": "Xem demo tiết học chính khóa & ngoại khóa"
    },
    {
      "icon": "👶",
      "text": "Con được tham gia 1 hoạt động trải nghiệm cùng các bạn"
    },
    {
      "icon": "🍱",
      "text": "Bữa trưa miễn phí cho cả gia đình theo thực đơn trường"
    },
    {
      "icon": "🎁",
      "text": "Quà tặng Open Day + voucher giảm 10% học phí nếu đăng ký nhập học trong 30 ngày"
    }
  ];

const metrics = [
  { number: '15+', label: 'Năm kinh nghiệm giáo dục song ngữ' },
  { number: '3,000+', label: 'Học sinh đã và đang theo học' },
  { number: '95%', label: 'Phụ huynh hài lòng & giới thiệu bạn bè' },
  { number: '9', label: 'Cơ sở tại TP.HCM, Long An, Kiên Giang' },
];

const faqItems = [
    {
      "question": "Open Day diễn ra khi nào?",
      "answer": "Trường tổ chức Open Day vào thứ 7 cuối mỗi tháng, từ 8h00 — 12h00. Phụ huynh có thể chọn ngày phù hợp nhất trong 3 tháng tới."
    },
    {
      "question": "Có cần đặt lịch trước không?",
      "answer": "Cần. Mỗi đợt nhận tối đa 30 gia đình để đảm bảo chất lượng tham quan và tương tác. Vui lòng đăng ký trước 7 ngày."
    },
    {
      "question": "Tôi đi cùng cả gia đình được không?",
      "answer": "Hoàn toàn được. Khuyến khích cả Ba và Mẹ cùng đi để có quyết định thống nhất. Trường có khu vực dành riêng cho con khám phá trong khi phụ huynh tham quan."
    },
    {
      "question": "Có cần chuẩn bị gì không?",
      "answer": "Không. Trường chuẩn bị tất cả: tài liệu, đồ dùng, ăn uống, quà tặng. Phụ huynh chỉ cần đến đúng giờ với CMND/CCCD để check-in."
    },
    {
      "question": "Có buổi Open Day online không?",
      "answer": "Có. Nếu Ba/Mẹ ở xa hoặc bận, trường có Virtual Open Day qua Zoom mỗi tháng — tour 360° cơ sở + Q&A trực tiếp với Hiệu trưởng."
    }
  ];
---

<SqueezePageLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={pageCanonical}
  schoolLevel="tieu-hoc"
  funnelCode="open-day"
>
  <section slot="hero">
    <h1 class="squeeze-hero__heading">Open Day Trường Việt Anh — Trải Nghiệm 1 Ngày Thực Tế</h1>
    <p class="squeeze-hero__subheading">Tham quan toàn bộ cơ sở · Gặp Ban Lãnh Đạo · Trải nghiệm tiết học · Demo chương trình quốc tế. Hoàn toàn miễn phí.</p>
  </section>

  <section slot="usp"><USPGrid title="Vì sao chọn Trường Việt Anh?" items={uspItems} /></section>
  <section slot="trust"><TrustMetrics title="Trường Việt Anh trong số liệu" metrics={metrics} /></section>

  <section slot="content">
    <div class="page-content">
      <h2>Open Day — Cách tốt nhất để hiểu Trường Việt Anh</h2>
      <p>Tài liệu, video, đánh giá online đều có giới hạn. <strong>Cách duy nhất để biết trường có phù hợp với con</strong> là đến tận nơi, gặp người thật, nhìn lớp học thật, ăn bữa cơm cùng các bạn.</p>
        <p>Open Day Trường Việt Anh được thiết kế cho phụ huynh trong giai đoạn cân nhắc — bạn sẽ rời đi với <strong>câu trả lời rõ ràng</strong> chứ không phải brochure.</p>
    </div>
  </section>

  <section slot="form">
    <h2 class="squeeze-form-section__heading">Đăng ký Open Day — Chọn ngày tham quan</h2>
    <p class="squeeze-form-section__description">Trường tổ chức Open Day hàng tháng. Để lại thông tin để được gửi lịch và đặt chỗ.</p>
    <LeadFormTwoStepEmailFirst
      formId="open-day-form"
      funnelCode="open-day"
      schoolLevel="tieu-hoc"
      submitText="Đăng ký Open Day"
      successMessage="Cảm ơn! Đội tuyển sinh sẽ liên hệ trong 24h."
    />
  </section>

  <section slot="faq"><FAQSection title="Câu hỏi thường gặp" items={faqItems} /></section>
</SqueezePageLayout>

<style is:inline>
  .page-content { max-width: 800px; margin: 0 auto; padding: 1rem 0; }
  .page-content h2 { color: #1a1a5e; font-size: 1.6rem; margin-bottom: 1rem; text-align: center; }
  .page-content p { font-size: 1rem; line-height: 1.75; color: #333; margin-bottom: 1rem; }
  .page-content ul { margin: 1rem 0 1rem 1.5rem; }
  .page-content li { margin-bottom: .5rem; line-height: 1.7; }
  .page-content strong { color: #1a1a5e; font-weight: 700; }
</style>
