---
import SqueezePageLayout from '../layouts/SqueezePageLayout.astro';
import USPGrid from '../components/USPGrid.astro';
import TrustMetrics from '../components/TrustMetrics.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import FAQSection from '../components/FAQSection.astro';

const pageTitle = "Oxford Pathway Programme tại Gò Vấp — Lộ Trình Du Học Anh Quốc | Trường Việt Anh";
const pageDescription = "Chương trình tích hợp Oxford International Curriculum + IGCSE/A-Level. Cam kết đầu ra IELTS 7.0+ và profile vào top 100 đại học UK/Mỹ.";
const pageCanonical = "https://truongvietanh.com/oxford-pathway-govap";

const uspItems = [
    {
      "icon": "🎓",
      "text": "Curriculum Oxford International + IGCSE / A-Level"
    },
    {
      "icon": "🇬🇧",
      "text": "100% giáo viên bản ngữ — Ph.D / Master từ UK, US, AU"
    },
    {
      "icon": "📜",
      "text": "Đầu ra: IELTS 7.0+ · IGCSE A* · A-Level A*"
    },
    {
      "icon": "🌍",
      "text": "Counselor du học riêng — hỗ trợ apply UK / US / AU / SG"
    },
    {
      "icon": "🏆",
      "text": "92% học sinh vào top 100 thế giới (Oxford, Imperial, NUS, ANU…)"
    },
    {
      "icon": "💰",
      "text": "Học bổng Oxford Pathway 30–70% cho HS xuất sắc"
    }
  ];

const metrics = [
  { number: '15+', label: 'Năm kinh nghiệm giáo dục song ngữ' },
  { number: '3,000+', label: 'Học sinh đã và đang theo học' },
  { number: '95%', label: 'Phụ huynh hài lòng & giới thiệu bạn bè' },
  { number: '9', label: 'Cơ sở tại TP.HCM, Long An, Kiên Giang' },
];

const faqItems = [
    {
      "question": "Chương trình Oxford Pathway dành cho lớp nào?",
      "answer": "Mở từ lớp 7 (Year 8 hệ Anh) đến lớp 12 (Year 13). Lộ trình tối ưu là vào từ lớp 7 để có 6 năm xây nền."
    },
    {
      "question": "Học sinh học chương trình Việt Nam có chuyển sang được không?",
      "answer": "Có. Trường có lớp Bridge 1 năm cho HS từ trường Việt Nam sang, rèn IELTS 5.5+ và lấp đầy gap kiến thức trước khi vào IGCSE chính thức."
    },
    {
      "question": "Học phí Oxford Pathway khoảng bao nhiêu?",
      "answer": "Học phí Oxford Pathway từ 250–450 triệu/năm tùy cấp. Có học bổng 30–70% theo thành tích — vui lòng đăng ký để nhận bảng giá chi tiết."
    },
    {
      "question": "Tỷ lệ vào đại học top thế giới là bao nhiêu?",
      "answer": "92% học sinh tốt nghiệp Oxford Pathway 2024 vào top 100 thế giới (theo QS Rankings), 38% vào top 30 (Oxford, Cambridge, Imperial, UCL, NUS, USYD…)."
    },
    {
      "question": "Có cần đi du học hè để bổ trợ không?",
      "answer": "Khuyến khích. Trường tổ chức summer school tại Oxford UK + Boston US mỗi năm 3 tuần, học phí riêng 80–120 triệu, đã bao gồm vé máy bay + visa + lưu trú."
    }
  ];
---

<SqueezePageLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={pageCanonical}
  schoolLevel="tieu-hoc"
  funnelCode="oxford-pathway-govap"
>
  <section slot="hero">
    <h1 class="squeeze-hero__heading">Oxford Pathway Programme tại Gò Vấp — Lộ Trình Du Học Anh Quốc</h1>
    <p class="squeeze-hero__subheading">Chương trình tích hợp Oxford International Curriculum + IGCSE/A-Level. Cam kết đầu ra IELTS 7.0+ và profile vào top 100 đại học UK/Mỹ.</p>
  </section>

  <section slot="usp"><USPGrid title="Vì sao chọn Trường Việt Anh?" items={uspItems} /></section>
  <section slot="trust"><TrustMetrics title="Trường Việt Anh trong số liệu" metrics={metrics} /></section>

  <section slot="content">
    <div class="page-content">
      <h2>Oxford Pathway — Du học bắt đầu từ lớp 7</h2>
      <p>Oxford Pathway Programme tại Trường Việt Anh tại Gò Vấp là <strong>chương trình du học sớm</strong>, học toàn bộ bằng tiếng Anh theo curriculum Oxford International, lấy bằng IGCSE và A-Level chuẩn quốc tế ngay tại Việt Nam.</p>
        <p>Học sinh tốt nghiệp có hồ sơ <strong>tương đương HS trường British boarding school</strong> với chi phí thấp hơn 5–10 lần, đồng thời được sống cùng gia đình ở Việt Nam đến năm lớp 12.</p>
    </div>
  </section>

  <section slot="form">
    <h2 class="squeeze-form-section__heading">Tư vấn Oxford Pathway 2026</h2>
    <p class="squeeze-form-section__description">Đội tuyển sinh quốc tế sẽ tư vấn lộ trình 4–6 năm và chính sách học bổng riêng.</p>
    <LeadFormTwoStepEmailFirst
      formId="oxford-pathway-govap-form"
      funnelCode="oxford-pathway-govap"
      schoolLevel="tieu-hoc"
      submitText="Đăng ký tư vấn Oxford Pathway"
      successMessage="Cảm ơn! Đội tuyển sinh sẽ liên hệ trong 24h."
    />
  </section>

  <section slot="faq"><FAQSection title="Câu hỏi thường gặp" items={faqItems} /></section>
</SqueezePageLayout>

<style is:inline>
  .page-content { max-width: 800px; margin: 0 auto; padding: 1rem 0; }
  .page-content h2 { color: #1a1a5e; font-size: 1.6rem; margin-bottom: 1rem; text-align: center; }
  .page-content p { font-size: 1rem; line-height: 1.75; color: #333; margin-bottom: 1rem; }
  .page-content ul { margin: 1rem 0 1rem 1.5rem; }
  .page-content li { margin-bottom: .5rem; line-height: 1.7; }
  .page-content strong { color: #1a1a5e; font-weight: 700; }
</style>
