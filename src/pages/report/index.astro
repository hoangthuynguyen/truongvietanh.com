---
/**
 * BÁO CÁO ĐÁNH GIÁ KỸ NĂNG HÈ 2026
 * Personalized quiz report — professional format, wider layout
 * All data from URL query params, rendered client-side
 */
---

<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Báo Cáo Đánh Giá Kỹ Năng Hè 2026 | Lion Camp — Trường Việt Anh</title>
  <meta name="description" content="Báo cáo đánh giá kỹ năng cá nhân hóa — Lion Camp Hè 2026" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <style is:inline>@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&family=Open+Sans:wght@400;500;600;700&display=swap&subset=vietnamese');</style>
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-KPL2NSR9');</script>

  <style is:inline>
    :root { --p:#1a1a5e; --p2:#2a2a7e; --acc:#E8792B; --gold:#F59E0B; --grn:#16A34A; --red:#EF4444; --f:'Open Sans',sans-serif; --fh:'Montserrat',sans-serif; }
    *{margin:0;padding:0;box-sizing:border-box}
    body{font-family:var(--f);-webkit-font-smoothing:antialiased;color:#1C2A3A;background:#F0F4F8;min-height:100vh}

    /* === LAYOUT — wider === */
    .wrap{max-width:820px;margin:0 auto;padding:16px}

    /* === HEADER === */
    .hdr{background:linear-gradient(135deg,var(--p),var(--p2));color:#fff;border-radius:16px 16px 0 0;padding:28px 32px;display:flex;align-items:center;justify-content:space-between;gap:24px}
    .hdr-logo{height:52px;width:auto;flex-shrink:0}
    .hdr-text{text-align:right}
    .hdr h1{font-family:var(--fh);font-size:1.1rem;font-weight:800;letter-spacing:.02em;margin-bottom:2px}
    .hdr .sub{font-size:.82rem;opacity:.8}

    /* === MAIN CARD === */
    .card{background:#fff;border-radius:0 0 16px 16px;box-shadow:0 8px 32px rgba(0,0,0,.06);overflow:hidden}

    /* === SCORE HERO === */
    .score-hero{display:grid;grid-template-columns:1fr 1fr;gap:0}
    .score-left{padding:32px;text-align:center;border-right:1px solid #F0F0F0}
    .score-num{font-family:var(--fh);font-size:4rem;font-weight:900;line-height:1}
    .score-max{font-size:1rem;color:#999;font-weight:500;margin-top:4px}
    .score-bar{height:10px;background:#E5E7EB;border-radius:5px;margin:16px 0 12px;overflow:hidden}
    .score-fill{height:100%;border-radius:5px;transition:width 1.5s ease;width:0}
    .score-badge{display:inline-block;padding:6px 20px;border-radius:50px;font-family:var(--fh);font-weight:700;font-size:.9rem;color:#fff}
    .score-right{padding:32px;display:flex;flex-direction:column;justify-content:center}
    .score-right h2{font-family:var(--fh);font-size:1.15rem;font-weight:800;margin-bottom:8px}
    .score-right p{font-size:.9rem;color:#555;line-height:1.6}

    /* === SECTION === */
    .sec{padding:0 32px}
    .sec-title{font-family:var(--fh);font-size:.95rem;font-weight:700;color:var(--p);padding:20px 0 10px;border-bottom:2px solid #F0F0F0;margin-bottom:0}

    /* === SKILL GRID === */
    .skills{display:grid;grid-template-columns:1fr 1fr;gap:0}
    .skill{padding:14px 0;border-bottom:1px solid #F8F8F8;display:flex;align-items:center;gap:12px}
    .skill:nth-child(odd){padding-right:16px;border-right:1px solid #F0F0F0}
    .skill:nth-child(even){padding-left:16px}
    .skill-icon{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0}
    .skill-info{flex:1;min-width:0}
    .skill-name{font-size:.82rem;font-weight:600;color:#374151;margin-bottom:4px}
    .skill-bar{height:6px;background:#E5E7EB;border-radius:3px;overflow:hidden}
    .skill-bar-fill{height:100%;border-radius:3px;transition:width 1s ease}
    .skill-score{font-family:var(--fh);font-weight:800;font-size:.85rem;min-width:32px;text-align:right}

    /* === INSIGHTS — the key conversion section === */
    .insights{padding:24px 32px;background:linear-gradient(135deg,#FFFBEB,#FEF3C7);border-top:3px solid var(--gold);margin-top:0}
    .insights h3{font-family:var(--fh);font-size:1.05rem;font-weight:800;color:var(--acc);margin-bottom:12px;display:flex;align-items:center;gap:8px}
    .insight-cards{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px}
    .insight-card{background:#fff;border-radius:12px;padding:14px;border-left:4px solid var(--red)}
    .insight-card h4{font-family:var(--fh);font-size:.82rem;font-weight:700;color:#991B1B;margin-bottom:4px}
    .insight-card p{font-size:.8rem;color:#555;line-height:1.5}
    .insight-card--good{border-left-color:var(--grn)}
    .insight-card--good h4{color:#166534}

    /* === CTA SECTION — the money section === */
    .cta-section{padding:28px 32px;background:linear-gradient(135deg,var(--p),var(--p2));color:#fff;text-align:center}
    .cta-section h3{font-family:var(--fh);font-size:1.2rem;font-weight:800;margin-bottom:6px}
    .cta-section .cta-sub{font-size:.88rem;opacity:.85;margin-bottom:20px;max-width:500px;margin-left:auto;margin-right:auto}
    .cta-benefits{display:flex;gap:16px;justify-content:center;margin-bottom:20px;flex-wrap:wrap}
    .cta-benefit{display:flex;align-items:center;gap:6px;font-size:.82rem;font-weight:600;background:rgba(255,255,255,.12);padding:8px 14px;border-radius:50px}
    .cta-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-bottom:16px}
    .cta-btn{display:inline-flex;align-items:center;gap:8px;padding:14px 28px;border-radius:12px;font-family:var(--fh);font-weight:700;font-size:1rem;text-decoration:none;transition:all .2s;border:none;cursor:pointer}
    .cta-btn--primary{background:linear-gradient(135deg,var(--acc),var(--gold));color:#fff;box-shadow:0 4px 18px rgba(232,121,43,.4);animation:pulse 2.5s infinite}
    .cta-btn--primary:hover{transform:translateY(-2px);box-shadow:0 6px 24px rgba(232,121,43,.55)}
    .cta-btn--zalo{background:#0068FF;color:#fff;box-shadow:0 4px 14px rgba(0,104,255,.3)}
    .cta-btn--zalo:hover{background:#0056D6}
    .cta-btn--outline{background:transparent;color:#fff;border:2px solid rgba(255,255,255,.5)}
    .cta-btn--outline:hover{background:rgba(255,255,255,.1);border-color:#fff}
    @keyframes pulse{0%,100%{box-shadow:0 4px 18px rgba(232,121,43,.4)}50%{box-shadow:0 4px 32px rgba(232,121,43,.7),0 0 48px rgba(245,158,11,.2)}}
    .cta-timer{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.1);padding:8px 16px;border-radius:50px;font-size:.82rem;margin-bottom:16px}
    .cta-timer strong{font-family:var(--fh);letter-spacing:.5px}
    .cta-phone{margin-top:8px;font-size:.85rem;opacity:.7}
    .cta-phone a{color:#fff;text-decoration:none}

    /* === FOOTER === */
    .report-footer{text-align:center;padding:16px;font-size:.75rem;color:#999}

    /* === RESPONSIVE === */
    @media(max-width:700px){
      .wrap{padding:8px}
      .hdr{flex-direction:column;text-align:center;padding:20px 16px;gap:12px}
      .hdr-text{text-align:center}
      .hdr-logo{height:44px}
      .score-hero{grid-template-columns:1fr}
      .score-left{border-right:none;border-bottom:1px solid #F0F0F0;padding:24px 20px}
      .score-right{padding:20px}
      .sec{padding:0 20px}
      .skills{grid-template-columns:1fr}
      .skill:nth-child(odd){border-right:none;padding-right:0}
      .skill:nth-child(even){padding-left:0}
      .insights{padding:20px}
      .insight-cards{grid-template-columns:1fr}
      .cta-section{padding:24px 20px}
      .cta-btns{flex-direction:column;align-items:center}
      .cta-btn{width:100%;max-width:320px;justify-content:center}
    }

    /* === PRINT === */
    @media print{
      body{background:#fff}
      .cta-section,.cta-timer,.report-footer{display:none}
      .card{box-shadow:none;border:1px solid #ddd}
      .wrap{max-width:100%;padding:0}
    }
  </style>
</head>
<body>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KPL2NSR9" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<div class="wrap">
  <!-- HEADER -->
  <div class="hdr">
    <img src="/logo-vietanh-header.webp" alt="Trường Việt Anh" class="hdr-logo" />
    <div class="hdr-text">
      <h1>BÁO CÁO ĐÁNH GIÁ KỸ NĂNG HÈ 2026</h1>
      <div class="sub" id="hdrSub">Lion Camp — Trường Việt Anh</div>
    </div>
  </div>

  <div class="card">
    <!-- SCORE HERO — 2 columns -->
    <div class="score-hero">
      <div class="score-left">
        <div class="score-num" id="scoreNum">--</div>
        <div class="score-max">/ 24 điểm</div>
        <div class="score-bar"><div class="score-fill" id="scoreFill"></div></div>
        <span class="score-badge" id="scoreBadge">--</span>
      </div>
      <div class="score-right">
        <h2 id="resultTitle">Đang phân tích...</h2>
        <p id="resultDesc"></p>
      </div>
    </div>

    <!-- SKILL BREAKDOWN — 2-column grid -->
    <div class="sec">
      <div class="sec-title">Chi tiết từng kỹ năng</div>
    </div>
    <div class="skills" id="skillsGrid">
      <!-- Populated by JS -->
    </div>

    <!-- INSIGHTS — weakest areas + recommendations -->
    <div class="insights" id="insightsSection">
      <h3>🔍 Phân tích & Khuyến nghị</h3>
      <div class="insight-cards" id="insightCards">
        <!-- Populated by JS -->
      </div>
    </div>

    <!-- CTA — the conversion section -->
    <div class="cta-section">
      <div class="cta-timer">⏰ Ưu đãi Early Bird còn <strong id="ctaTimer">--:--:--</strong></div>
      <h3>Đặt lịch tư vấn 1:1 MIỄN PHÍ (15 phút)</h3>
      <p class="cta-sub">Chuyên gia giáo dục sẽ phân tích chi tiết kết quả của con và tư vấn lộ trình Lion Camp phù hợp nhất</p>

      <div class="cta-benefits">
        <span class="cta-benefit">✅ Phân tích chi tiết 6 kỹ năng</span>
        <span class="cta-benefit">🎁 Học bổng đến 30%</span>
        <span class="cta-benefit">💯 Hoàn tiền 100% nếu đổi ý</span>
      </div>

      <div class="cta-btns">
        <a href="https://zalo.me/1678310120468101523" target="_blank" rel="noopener" class="cta-btn cta-btn--primary" id="ctaZalo">
          💬 Đặt lịch qua Zalo ngay
        </a>
        <a href="tel:+84916961409" class="cta-btn cta-btn--outline">
          📞 Gọi 0916 961 409
        </a>
      </div>

      <a href="/giu-cho/" class="cta-btn cta-btn--zalo" id="ctaDeposit" style="margin-top:8px">
        🔒 Giữ chỗ Lion Camp — chỉ 500k (hoàn 100%)
      </a>

      <div class="cta-phone">Hotline: <a href="tel:+84916961409">0916 961 409</a></div>
    </div>
  </div>

  <div class="report-footer">
    Báo cáo được tạo tự động bởi hệ thống Lion Camp — Trường Việt Anh.<br>
    Thông tin được bảo mật và chỉ dùng cho mục đích tư vấn giáo dục.
  </div>
</div>

<script is:inline>
(function(){
  var p = new URLSearchParams(window.location.search);
  var name = p.get('name') || '';
  var score = parseInt(p.get('score'),10) || 0;
  var level = p.get('level') || '';
  var school = p.get('school') || 'tieu-hoc';
  var loc = p.get('loc') || '';
  var funnel = p.get('funnel') || '';
  var q = [1,2,3,4,5,6].map(function(i){ return parseInt(p.get('q'+i),10) || 0; });

  // School level label
  var levelMap = {'tieu-hoc':'Tiểu học','thcs':'THCS','thpt':'THPT'};
  var schoolLabel = levelMap[school] || 'Tiểu học';

  // Questions per school level
  var QUESTIONS = {
    'tieu-hoc': [
      {name:'Tự giác & kỷ luật', icon:'🎯', activity:'Chương trình Lãnh đạo Bản thân — rèn nề nếp qua dự án thực tế'},
      {name:'Tự tin giao tiếp', icon:'💬', activity:'Vòng tròn tự tin — tập nói trước nhóm bạn nhỏ mỗi ngày'},
      {name:'Tiếng Anh', icon:'🇬🇧', activity:'Lớp Oxford với giáo viên bản ngữ — "tắm" tiếng Anh hàng ngày'},
      {name:'Quản lý màn hình', icon:'📱', activity:'Hoạt động thể chất + sáng tạo thay thế thời gian điện thoại'},
      {name:'Giải quyết vấn đề', icon:'🧩', activity:'Problem Solving Lab — giải câu đố & thực hành tư duy'},
      {name:'Hoạt động nhóm', icon:'🤝', activity:'Team Building + du lịch trải nghiệm mỗi tuần'}
    ],
    'thcs': [
      {name:'Kiểm soát cảm xúc', icon:'❤️', activity:'Workshop EQ — nhận diện & điều tiết cảm xúc tuổi dậy thì'},
      {name:'Giao tiếp gia đình', icon:'👨‍👩‍👧', activity:'Dự án Gia đình — con học cách mở lòng và chia sẻ'},
      {name:'Tiếng Anh thực chiến', icon:'🇬🇧', activity:'English Debate Club + giáo viên bản ngữ hàng ngày'},
      {name:'Quản lý game/MXH', icon:'🎮', activity:'Digital Detox + dự án AI cơ bản thay thế thói quen game'},
      {name:'Làm việc nhóm', icon:'🤝', activity:'Dự án nhóm thực tế — rèn kỹ năng dẫn dắt & hợp tác'},
      {name:'Quản lý thời gian', icon:'⏰', activity:'Hệ thống Planner cá nhân — tự lập kế hoạch mỗi ngày'}
    ],
    'thpt': [
      {name:'Thuyết trình tiếng Anh', icon:'🎤', activity:'IELTS Speaking + Public Speaking Club hàng tuần'},
      {name:'Định hướng nghề nghiệp', icon:'🎯', activity:'Workshop Hướng nghiệp + mentor 1:1 với chuyên gia'},
      {name:'Công nghệ & AI', icon:'🤖', activity:'Dự án AI nâng cao — ứng dụng ChatGPT, Midjourney vào học tập'},
      {name:'Quản lý áp lực', icon:'🧠', activity:'Mindfulness + Kỹ năng quản lý stress cho học sinh THPT'},
      {name:'Hoạt động ngoại khóa', icon:'⚡', activity:'CLB Lãnh đạo Trẻ + trải nghiệm thực tế mỗi tuần'},
      {name:'Tự học & quản lý TG', icon:'📚', activity:'Hệ thống Study Planner + nhóm học tập hiệu quả'}
    ]
  };

  var questions = QUESTIONS[school] || QUESTIONS['tieu-hoc'];

  // Header
  document.getElementById('hdrSub').textContent = 'Lion Camp ' + schoolLabel + ' ' + loc + ' — Dành cho ' + (name || 'Ba/Mẹ');

  // Score
  var pct = Math.round((score/24)*100);
  var color = score >= 18 ? '#16A34A' : score >= 12 ? '#F59E0B' : '#EF4444';
  var levelText = score >= 18 ? 'Nền tảng tốt' : score >= 12 ? 'Cần hỗ trợ' : 'Cần can thiệp gấp';

  document.getElementById('scoreNum').textContent = score;
  document.getElementById('scoreNum').style.color = color;
  var badge = document.getElementById('scoreBadge');
  badge.textContent = levelText;
  badge.style.background = color;
  setTimeout(function(){
    document.getElementById('scoreFill').style.width = pct + '%';
    document.getElementById('scoreFill').style.background = color;
  }, 300);

  // Result text
  var titles = {
    high: 'Con đã có nền tảng tốt!',
    mid: 'Con cần được hỗ trợ đúng lúc',
    low: 'Thời điểm vàng để can thiệp!'
  };
  var descs = {
    high: 'Lion Camp sẽ giúp con tỏa sáng hơn nữa — phát triển kỹ năng lãnh đạo vượt trội và tạo lợi thế so với bạn bè.',
    mid: 'Chỉ cần 6 tuần đúng phương pháp, con sẽ tiến bộ rõ rệt. Đây là thời điểm lý tưởng để hành động.',
    low: 'Mùa hè này là cơ hội quan trọng nhất để thay đổi. Nếu không can thiệp ngay, con có thể tụt hậu xa hơn.'
  };
  var tier = score >= 18 ? 'high' : score >= 12 ? 'mid' : 'low';
  document.getElementById('resultTitle').textContent = titles[tier];
  document.getElementById('resultDesc').textContent = descs[tier];

  // Skills grid
  var grid = document.getElementById('skillsGrid');
  questions.forEach(function(qn, i){
    var s = q[i] || 0;
    var sc = s >= 4 ? '#16A34A' : s >= 3 ? '#F59E0B' : '#EF4444';
    var w = Math.round((s/4)*100);
    var bgColor = s >= 4 ? 'rgba(22,163,106,.1)' : s >= 3 ? 'rgba(245,158,11,.1)' : 'rgba(239,68,68,.1)';
    grid.innerHTML += '<div class="skill">' +
      '<div class="skill-icon" style="background:'+bgColor+'">' + qn.icon + '</div>' +
      '<div class="skill-info">' +
        '<div class="skill-name">' + qn.name + '</div>' +
        '<div class="skill-bar"><div class="skill-bar-fill" style="width:'+w+'%;background:'+sc+'"></div></div>' +
      '</div>' +
      '<div class="skill-score" style="color:'+sc+'">' + s + '/4</div>' +
    '</div>';
  });

  // Insights — find weakest + strongest
  var sorted = q.map(function(s,i){return {score:s,idx:i}}).sort(function(a,b){return a.score-b.score});
  var weakest = sorted.slice(0,2);
  var strongest = sorted.slice(-1);

  var cards = document.getElementById('insightCards');
  weakest.forEach(function(w){
    var qn = questions[w.idx];
    cards.innerHTML += '<div class="insight-card">' +
      '<h4>⚠️ ' + qn.name + ' (' + w.score + '/4)</h4>' +
      '<p>Khuyến nghị: <strong>' + qn.activity + '</strong></p>' +
    '</div>';
  });
  if (strongest[0]) {
    var sq = questions[strongest[0].idx];
    cards.innerHTML += '<div class="insight-card insight-card--good">' +
      '<h4>💪 Điểm mạnh: ' + sq.name + ' (' + strongest[0].score + '/4)</h4>' +
      '<p>Con đã làm tốt! Lion Camp sẽ phát huy thêm qua: <strong>' + sq.activity + '</strong></p>' +
    '</div>';
  }

  // Deposit link personalization
  var depositLink = '/giu-cho/?loc=' + encodeURIComponent(loc) + '&level=' + school + '&name=' + encodeURIComponent(name);
  document.getElementById('ctaDeposit').href = depositLink;

  // Zalo deep-link
  var zaloMsg = 'Chào thầy/cô, tôi vừa nhận kết quả đánh giá Lion Camp ' + loc + ' cho con (' + score + '/24 điểm). Tôi muốn đặt lịch tư vấn 1:1 ạ.';
  document.getElementById('ctaZalo').href = 'https://zalo.me/1678310120468101523?text=' + encodeURIComponent(zaloMsg);

  // Countdown
  var CK = 'camp_countdown_end';
  var stored = sessionStorage.getItem(CK);
  var endTime = stored ? parseInt(stored,10) : 0;
  if (!endTime || endTime < Date.now()) { endTime = Date.now() + 4*3600*1000; sessionStorage.setItem(CK, endTime.toString()); }
  function tick(){
    var d = Math.max(0, Math.floor((endTime - Date.now())/1000));
    var h=Math.floor(d/3600), m=Math.floor((d%3600)/60), s=d%60;
    document.getElementById('ctaTimer').textContent = (h<10?'0':'')+h+':'+(m<10?'0':'')+m+':'+(s<10?'0':'')+s;
  }
  tick(); setInterval(tick, 1000);

  // GTM
  if (window.dataLayer) window.dataLayer.push({event:'report_viewed', quiz_score:score, school_level:school, location:loc});
})();
</script>
</body>
</html>
