---
// squeeze/checklist-mam-non – CRO rewrite v3
// Traffic: Facebook Ads + Google Ads (cold audience)
// Goal: lead capture (email → name + phone) via popup two-step form
---
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Checklist 15 Tiêu Chí Chọn Trường Mầm Non 2026 – Tải Miễn Phí | Trường Việt Anh</title>
<meta name="description" content="8/10 ba mẹ rời buổi tham quan mà vẫn không chắc quyết định. Checklist 15 tiêu chí + Framework 5C giúp bạn chọn đúng trong 15 phút. Miễn phí." />
<meta name="robots" content="noindex" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,700;0,800;0,900;1,800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

<style>
/* ─────────────────────────────────────────────
   0 · RESET & TOKENS
───────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg:      #071122;
  --surface: #0d1b38;
  --border:  rgba(255,255,255,.08);
  --text:    #f0f4ff;
  --muted:   rgba(240,244,255,.58);
  --red:     #dc2626;
  --orange:  #f97316;
  --amber:   #fbbf24;
  --green:   #22c55e;
  --radius:  10px;
  --shadow-cta: 0 6px 30px rgba(249,115,22,.55), 0 2px 8px rgba(0,0,0,.4);
}

html { height: 100%; }
body {
  min-height: 100%;
  font-family: 'Inter', sans-serif;
  background: var(--bg);
  background-image:
    radial-gradient(ellipse 90% 55% at 75% 110%, rgba(30,80,160,.3) 0%, transparent 55%),
    radial-gradient(ellipse 55% 45% at 5%  -5%,  rgba(15,45,100,.5) 0%, transparent 50%);
  color: var(--text);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* ─────────────────────────────────────────────
   1 · URGENCY BAR
───────────────────────────────────────────── */
.ubar {
  flex-shrink: 0;
  background: var(--red);
  padding: 7px 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-size: 12.5px;
  font-weight: 600;
  letter-spacing: .15px;
  animation: slideDown .4s ease both;
}
.ubar-count {
  background: rgba(0,0,0,.28);
  border-radius: 20px;
  padding: 1px 9px;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}
.ubar-dot {
  width: 7px; height: 7px;
  background: #fca5a5;
  border-radius: 50%;
  animation: blink 1.4s ease infinite;
}

/* ─────────────────────────────────────────────
   2 · LOGO BAR
───────────────────────────────────────────── */
.lbar {
  flex-shrink: 0;
  background: #fff;
  padding: 8px 40px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.lbar img   { height: 40px; display: block; }
.lbar-text  {
  font-family: 'Montserrat', sans-serif;
  font-weight: 900;
  font-size: 16px;
  color: var(--bg);
  display: none;
}

/* ─────────────────────────────────────────────
   3 · HERO
───────────────────────────────────────────── */
.hero {
  flex: 1;
  min-height: 0;
  display: grid;
  grid-template-columns: 1fr 380px;
  align-items: center;
  max-width: 1060px;
  width: 100%;
  margin: 0 auto;
  padding: 16px 40px 18px;
  gap: 44px;
  animation: riseUp .65s ease both .08s;
}

/* ─── LEFT ─── */
.left {
  display: flex;
  flex-direction: column;
  gap: clamp(8px, 1.35vh, 15px);
}

/* Eyebrow */
.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: rgba(220,38,38,.14);
  border: 1px solid rgba(220,38,38,.38);
  border-radius: 30px;
  padding: 4px 14px 4px 6px;
  width: fit-content;
  font-size: 12px;
  font-weight: 700;
  color: #fca5a5;
}
.eyebrow-tag {
  background: var(--red);
  color: #fff;
  font-family: 'Montserrat', sans-serif;
  font-size: 11px;
  font-weight: 900;
  border-radius: 20px;
  padding: 2px 9px;
  letter-spacing: .3px;
  text-transform: uppercase;
}

/* Headline */
.h1 {
  font-family: 'Montserrat', sans-serif;
  font-size: clamp(1.4rem, 2.3vw, 2rem);
  font-weight: 900;
  line-height: 1.22;
  letter-spacing: -.3px;
}
.h1 .stat {
  color: var(--orange);
  font-style: italic;
}
.h1 em {
  font-style: normal;
  border-bottom: 2.5px solid rgba(249,115,22,.5);
}

/* Subheadline */
.sub {
  font-size: 13.5px;
  color: var(--muted);
  line-height: 1.65;
  padding-left: 12px;
  border-left: 3px solid var(--orange);
}
.sub strong { color: var(--text); font-weight: 600; }

/* Bullets */
.bullets { list-style: none; display: flex; flex-direction: column; gap: 7px; }
.bullets li {
  display: flex;
  gap: 9px;
  font-size: 13.5px;
  color: rgba(240,244,255,.85);
  line-height: 1.45;
  align-items: flex-start;
}
.ico-check {
  flex-shrink: 0;
  width: 19px; height: 19px;
  background: var(--green);
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 2px;
}
.ico-check svg { width: 10px; height: 10px; }
.bullets li b { color: var(--text); font-weight: 600; }

/* Social proof row */
.proof-row {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 12.5px;
  color: var(--muted);
}
.stars { color: var(--amber); letter-spacing: -1px; font-size: 13px; }
.proof-row strong { color: var(--amber); font-weight: 700; }
.proof-divider { width: 1px; height: 14px; background: var(--border); }

/* CTA */
.cta-block { display: flex; flex-direction: column; gap: 7px; }

.btn-main {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background: var(--orange);
  background-image: linear-gradient(135deg, #fb923c 0%, #f97316 40%, #ea580c 100%);
  color: #fff;
  font-family: 'Montserrat', sans-serif;
  font-size: clamp(.88rem, 1.1vw, 1rem);
  font-weight: 900;
  letter-spacing: .7px;
  text-transform: uppercase;
  border: none;
  border-radius: var(--radius);
  padding: 16px 28px;
  cursor: pointer;
  max-width: 430px;
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow-cta);
  transition: transform .18s ease, box-shadow .18s ease;
  animation: pulse 2.6s ease-in-out infinite;
}
/* Shimmer sweep */
.btn-main::before {
  content: '';
  position: absolute;
  top: 0; left: -90%;
  width: 55%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.22), transparent);
  transition: left .5s ease;
}
.btn-main:hover {
  transform: translateY(-3px) scale(1.02);
  box-shadow: 0 12px 38px rgba(249,115,22,.7), 0 2px 8px rgba(0,0,0,.4);
  animation: none;
}
.btn-main:hover::before { left: 145%; }
.btn-main:active { transform: scale(.98); }
.btn-main.shake { animation: shake .55s ease; }

.micro {
  font-size: 11px;
  color: rgba(240,244,255,.36);
  display: flex;
  align-items: center;
  gap: 5px;
}

/* ─── RIGHT ─── */
.right {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
}

/* Mockup */
.mockup-wrap {
  position: relative;
  width: 100%;
  max-width: 270px;
}
.mockup-wrap::before,
.mockup-wrap::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 14px;
}
.mockup-wrap::before {
  background: linear-gradient(135deg, #1e3f7a, #0a1e44);
  transform: rotate(9deg) translate(14px, 14px);
  z-index: 0;
  opacity: .65;
  box-shadow: 0 20px 60px rgba(0,0,0,.55);
}
.mockup-wrap::after {
  background: linear-gradient(135deg, #1a3568, #0d1e40);
  transform: rotate(4.5deg) translate(7px, 7px);
  z-index: 1;
  opacity: .5;
}
/* Ambient glow */
.mockup-glow {
  position: absolute;
  inset: -20%;
  background: radial-gradient(ellipse 70% 60% at 50% 60%, rgba(249,115,22,.18) 0%, transparent 65%);
  z-index: 0;
  pointer-events: none;
}
.mockup-img {
  position: relative;
  z-index: 2;
  width: 100%;
  border-radius: 12px;
  box-shadow: 0 14px 44px rgba(0,0,0,.55);
  display: block;
}
.free-badge {
  position: absolute;
  top: -10px; right: -10px;
  z-index: 3;
  background: linear-gradient(135deg, var(--amber), #f59e0b);
  color: #78350f;
  font-family: 'Montserrat', sans-serif;
  font-size: 10px;
  font-weight: 900;
  padding: 5px 12px;
  border-radius: 30px;
  text-transform: uppercase;
  letter-spacing: .5px;
  box-shadow: 0 4px 12px rgba(245,158,11,.45);
  white-space: nowrap;
}

/* Testimonial card */
.tcard {
  background: rgba(255,255,255,.05);
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 10px;
  padding: 11px 14px;
  max-width: 270px;
  width: 100%;
}
.tcard-stars { color: var(--amber); font-size: 12px; letter-spacing: -1px; margin-bottom: 5px; }
.tcard-quote {
  font-size: 12px;
  color: rgba(240,244,255,.72);
  line-height: 1.55;
  font-style: italic;
  margin-bottom: 8px;
}
.tcard-author {
  display: flex;
  align-items: center;
  gap: 7px;
}
.tcard-avatar {
  width: 26px; height: 26px;
  border-radius: 50%;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}
.tcard-name { font-size: 11.5px; font-weight: 600; color: rgba(240,244,255,.75); }
.tcard-meta { font-size: 10.5px; color: rgba(240,244,255,.42); }

/* ─────────────────────────────────────────────
   4 · MOBILE STICKY CTA
───────────────────────────────────────────── */
.sticky { display: none; }

/* ─────────────────────────────────────────────
   5 · POPUP
───────────────────────────────────────────── */
.overlay {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 999;
  background: rgba(4,11,26,.82);
  backdrop-filter: blur(6px);
  align-items: center;
  justify-content: center;
  padding: 20px;
}
.overlay.open {
  display: flex;
  animation: fadeIn .2s ease;
}

.popup {
  background: #fff;
  color: #111827;
  border-radius: 18px;
  width: 100%;
  max-width: 400px;
  padding: 28px 26px 22px;
  position: relative;
  box-shadow: 0 32px 100px rgba(0,0,0,.5);
  animation: springUp .32s cubic-bezier(.34,1.56,.64,1);
}

.p-close {
  position: absolute;
  top: 13px; right: 14px;
  background: #f3f4f6;
  border: none;
  border-radius: 50%;
  width: 28px; height: 28px;
  font-size: 15px;
  color: #6b7280;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background .15s, color .15s;
}
.p-close:hover { background: #e5e7eb; color: #111; }

/* Progress */
.p-prog { margin-bottom: 20px; }
.p-prog-labels {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .5px;
  color: #9ca3af;
  margin-bottom: 6px;
}
.p-prog-track {
  height: 4px;
  background: #e5e7eb;
  border-radius: 99px;
  overflow: hidden;
}
.p-prog-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--orange), #fb923c);
  border-radius: 99px;
  transition: width .4s ease;
}

/* Steps */
.p-step { display: none; }
.p-step.on { display: block; }

.p-ico   { font-size: 28px; margin-bottom: 8px; line-height: 1; }
.p-title {
  font-family: 'Montserrat', sans-serif;
  font-size: 1.1rem;
  font-weight: 800;
  color: #0d1b38;
  line-height: 1.3;
  margin-bottom: 3px;
}
.p-sub   { font-size: 12.5px; color: #6b7280; margin-bottom: 16px; line-height: 1.55; }

/* Fields */
.f-group { margin-bottom: 11px; }
.f-label {
  display: block;
  font-size: 11px;
  font-weight: 700;
  color: #374151;
  text-transform: uppercase;
  letter-spacing: .5px;
  margin-bottom: 5px;
}
.f-input {
  width: 100%;
  padding: 12px 14px;
  border: 1.5px solid #e5e7eb;
  border-radius: 8px;
  font-size: 15px;
  font-family: 'Inter', sans-serif;
  color: #111;
  outline: none;
  transition: border-color .2s, box-shadow .2s;
  background: #fafafa;
}
.f-input:focus {
  border-color: var(--orange);
  box-shadow: 0 0 0 3px rgba(249,115,22,.12);
  background: #fff;
}
.f-input.err { border-color: #ef4444; box-shadow: 0 0 0 3px rgba(239,68,68,.1); }
.f-err { font-size: 11.5px; color: #ef4444; margin-top: 3px; display: none; }
.f-err.on { display: block; }

/* Bonus block */
.bonus {
  background: #f0fdf4;
  border: 1px solid #bbf7d0;
  border-radius: 8px;
  padding: 10px 14px;
  margin-bottom: 13px;
}
.bonus-hd {
  font-size: 10.5px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .5px;
  color: #15803d;
  margin-bottom: 6px;
}
.bonus-item {
  display: flex;
  align-items: flex-start;
  gap: 7px;
  font-size: 12.5px;
  color: #166534;
  line-height: 1.45;
  margin-bottom: 4px;
}
.bonus-item:last-child { margin-bottom: 0; }
.bonus-val {
  margin-left: auto;
  flex-shrink: 0;
  font-size: 11px;
  color: #15803d;
  font-weight: 700;
  text-decoration: line-through;
  opacity: .7;
}

/* Popup CTA */
.p-btn {
  width: 100%;
  background: linear-gradient(135deg, #fb923c, var(--orange), #ea580c);
  color: #fff;
  font-family: 'Montserrat', sans-serif;
  font-size: .95rem;
  font-weight: 900;
  letter-spacing: .7px;
  text-transform: uppercase;
  border: none;
  border-radius: 9px;
  padding: 14px;
  cursor: pointer;
  box-shadow: 0 4px 18px rgba(249,115,22,.45);
  transition: transform .18s, box-shadow .18s;
  margin-top: 8px;
  min-height: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.p-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 26px rgba(249,115,22,.55); }
.p-btn:disabled { opacity: .7; cursor: wait; }
.p-btn .t { display: block; }
.p-btn .s {
  display: none;
  width: 18px; height: 18px;
  border: 2px solid rgba(255,255,255,.35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin .55s linear infinite;
}
.p-btn.loading .t { display: none; }
.p-btn.loading .s { display: block; }

.p-back {
  background: none; border: none;
  font-size: 12px; color: #9ca3af;
  cursor: pointer; padding: 5px 0;
  margin-top: 5px;
  display: flex; align-items: center; gap: 4px;
  transition: color .15s;
}
.p-back:hover { color: #374151; }
.p-sec {
  font-size: 11px; color: #9ca3af;
  text-align: center; margin-top: 9px;
  display: flex; align-items: center; justify-content: center; gap: 4px;
}

/* Success */
.p-suc { display: none; text-align: center; padding: 10px 0; }
.p-suc.on { display: block; }
.suc-ico { font-size: 54px; margin-bottom: 12px; }
.suc-h {
  font-family: 'Montserrat', sans-serif;
  font-size: 1.25rem;
  font-weight: 900;
  color: #16a34a;
  margin-bottom: 8px;
}
.suc-p { font-size: 13.5px; color: #6b7280; line-height: 1.65; }

/* ─────────────────────────────────────────────
   6 · KEYFRAMES
───────────────────────────────────────────── */
@keyframes slideDown {
  from { opacity:0; transform:translateY(-10px); }
  to   { opacity:1; transform:translateY(0); }
}
@keyframes riseUp {
  from { opacity:0; transform:translateY(22px); }
  to   { opacity:1; transform:translateY(0); }
}
@keyframes fadeIn  { from{opacity:0} to{opacity:1} }
@keyframes springUp {
  from { opacity:0; transform:translateY(32px) scale(.95); }
  to   { opacity:1; transform:translateY(0)   scale(1); }
}
@keyframes pulse {
  0%,100% { box-shadow: var(--shadow-cta); }
  50%      { box-shadow: 0 8px 38px rgba(249,115,22,.75), 0 2px 8px rgba(0,0,0,.4); }
}
@keyframes shake {
  0%,100% { transform:translateX(0) rotate(0); }
  15%,45%,75% { transform:translateX(-5px) rotate(-.4deg); }
  30%,60%,90% { transform:translateX(5px)  rotate(.4deg);  }
}
@keyframes blink {
  0%,100% { opacity:1; } 50% { opacity:.3; }
}
@keyframes spin { to { transform:rotate(360deg); } }

/* ─────────────────────────────────────────────
   7 · MOBILE
───────────────────────────────────────────── */
@media (max-width: 860px) {
  html, body { overflow-y: auto; overflow-x: hidden; height: auto; }
  body { padding-bottom: 72px; }

  .hero {
    grid-template-columns: 1fr;
    padding: 14px 18px 20px;
    gap: 0;
  }
  .left  { order: 1; gap: clamp(8px,2vw,12px); }
  .right { order: 2; padding-top: 14px; gap: 10px; }

  .mockup-wrap { max-width: 200px; }
  .tcard       { max-width: 100%; }

  /* Hide desktop CTA, show sticky */
  .btn-main { display: none !important; }
  .sticky   {
    display: block;
    position: fixed;
    bottom: 0; left: 0; right: 0;
    z-index: 800;
    padding: 10px 16px 14px;
    background: rgba(7,17,34,.97);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--border);
  }
  .sticky .btn-main {
    display: inline-flex !important;
    max-width: 100%; width: 100%;
    padding: 16px 20px;
    font-size: .93rem;
    animation: pulse 2.6s ease-in-out infinite;
  }

  .lbar { padding: 8px 20px; }
  .lbar img { height: 34px; }
  .h1   { font-size: 1.25rem; }
  .proof-row { flex-wrap: wrap; gap: 7px; }
}

@media (max-width: 420px) {
  .h1 { font-size: 1.1rem; }
  .mockup-wrap { max-width: 170px; }
}
</style>
</head>
<body>

<!-- ① URGENCY BAR ─────────────────────────── -->
<div class="ubar" role="alert" aria-live="polite">
  <span class="ubar-dot" aria-hidden="true"></span>
  Chỉ còn&nbsp;<strong class="ubar-count" id="seats">13</strong>&nbsp;suất nhận checklist miễn phí trong tháng này
  <span class="ubar-dot" aria-hidden="true"></span>
</div>

<!-- ② LOGO ──────────────────────────────── -->
<div class="lbar">
  <a href="https://truongvietanh.com" tabindex="-1" aria-label="Trường Việt Anh">
    <img src="/logo-th-thcs-thpt.png" alt="Trường Việt Anh"
         onerror="this.style.display='none';document.querySelector('.lbar-text').style.display='block'" />
    <span class="lbar-text">Trường Việt Anh</span>
  </a>
</div>

<!-- ③ HERO ──────────────────────────────── -->
<section class="hero">

  <!-- LEFT: copy + CTA -->
  <div class="left">

    <!-- Eyebrow -->
    <div class="eyebrow" aria-label="Cảnh báo quan trọng">
      <span class="eyebrow-tag">Sai lầm phổ biến</span>
      Của ba mẹ khi chọn trường mầm non
    </div>

    <!-- Headline — shock stat + mistake framing -->
    <h1 class="h1">
      <span class="stat">8/10 ba mẹ</span> rời buổi tham quan<br>
      mà vẫn <em>không chắc quyết định</em> của mình —<br>
      vì không có bộ tiêu chí trong tay
    </h1>

    <!-- Subheadline — promise + specificity -->
    <p class="sub">
      Checklist <strong>15 tiêu chí + Framework 5C</strong> giúp bạn đánh giá
      bất kỳ trường nào trong 15 phút — và <strong>tự tin chọn đúng ngay lần đầu</strong>
    </p>

    <!-- Bullets — 4 mạnh nhất, specific -->
    <ul class="bullets" aria-label="Bạn sẽ nhận được">
      <li>
        <span class="ico-check" aria-hidden="true">
          <svg viewBox="0 0 10 8" fill="none"><path d="M1 4l3 3 5-6" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span><b>15 tiêu chí chuẩn quốc tế</b> — bao gồm những điều trường không chủ động nói với bạn</span>
      </li>
      <li>
        <span class="ico-check" aria-hidden="true">
          <svg viewBox="0 0 10 8" fill="none"><path d="M1 4l3 3 5-6" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span><b>5 Red Flags</b> — thấy bất kỳ dấu hiệu nào: dừng lại, đừng ghi danh</span>
      </li>
      <li>
        <span class="ico-check" aria-hidden="true">
          <svg viewBox="0 0 10 8" fill="none"><path d="M1 4l3 3 5-6" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span><b>Framework 5C</b> — so sánh 3 trường trên cùng 1 bảng, khách quan, không cảm tính</span>
      </li>
      <li>
        <span class="ico-check" aria-hidden="true">
          <svg viewBox="0 0 10 8" fill="none"><path d="M1 4l3 3 5-6" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span><b>File PDF in sẵn</b> — mang đi tham quan, đánh dấu ngay tại chỗ</span>
      </li>
    </ul>

    <!-- Social proof — specific number builds credibility -->
    <div class="proof-row" aria-label="Đánh giá từ phụ huynh">
      <span class="stars" aria-label="5 sao">★★★★★</span>
      <strong>4.9/5</strong>
      <span class="proof-divider" aria-hidden="true"></span>
      <span>Đã có <strong>1.247 ba mẹ</strong> tải và dùng trong mùa tuyển sinh 2025</span>
    </div>

    <!-- CTA — first-person, benefit-driven -->
    <div class="cta-block">
      <button class="btn-main" id="ctaMain" aria-haspopup="dialog">
        <span aria-hidden="true">🎁</span>
        TÔI MUỐN CHỌN ĐÚNG TRƯỜNG CHO CON
      </button>
      <span class="micro">🔒 Miễn phí · Không spam · Hủy bất kỳ lúc nào</span>
    </div>

  </div>

  <!-- RIGHT: mockup + testimonial -->
  <div class="right">

    <div class="mockup-wrap" aria-hidden="true">
      <div class="mockup-glow"></div>
      <span class="free-badge">MIỄN PHÍ 🎁</span>
      <img
        src="/mockup-checklist-mam-non.png"
        alt="Checklist Chọn Trường Mầm Non 2026"
        class="mockup-img"
        onerror="this.style.opacity='.2'"
        loading="eager"
      />
    </div>

    <!-- Testimonial card -->
    <div class="tcard" role="figure" aria-label="Đánh giá từ phụ huynh">
      <div class="tcard-stars" aria-label="5 sao">★★★★★</div>
      <blockquote class="tcard-quote">
        "Tôi đã tham quan 4 trường mà không biết chọn trường nào. Sau khi dùng checklist, tôi tự tin quyết định trong 1 buổi."
      </blockquote>
      <div class="tcard-author">
        <div class="tcard-avatar" aria-hidden="true">HN</div>
        <div>
          <div class="tcard-name">Chị Hồng Ngọc</div>
          <div class="tcard-meta">Mẹ bé 3 tuổi · Quận 7, TP.HCM</div>
        </div>
      </div>
    </div>

  </div>

</section>

<!-- ④ STICKY CTA — mobile ──────────────── -->
<div class="sticky" aria-hidden="true">
  <button class="btn-main" id="ctaMob" tabindex="-1">
    <span>🎁</span> NHẬN CHECKLIST MIỄN PHÍ NGAY
  </button>
</div>

<!-- ⑤ POPUP ─────────────────────────────── -->
<div class="overlay" id="overlay" role="dialog" aria-modal="true" aria-labelledby="pTitle1">

  <div class="popup" id="popup">
    <button class="p-close" id="pClose" aria-label="Đóng">✕</button>

    <!-- Progress bar -->
    <div class="p-prog" aria-hidden="true">
      <div class="p-prog-labels">
        <span id="progLabel">Bước 1 / 2</span>
        <span id="progPct">50%</span>
      </div>
      <div class="p-prog-track">
        <div class="p-prog-fill" id="progFill" style="width:50%"></div>
      </div>
    </div>

    <!-- ─ STEP 1: Email ─ -->
    <div class="p-step on" id="s1">
      <div class="p-ico">📧</div>
      <h2 class="p-title" id="pTitle1">Gửi checklist vào email của bạn</h2>
      <p class="p-sub">Nhập email — nhận file PDF ngay trong vài phút</p>

      <div class="f-group">
        <label class="f-label" for="fEmail">Địa chỉ Email</label>
        <input class="f-input" type="email" id="fEmail" name="email"
               placeholder="ten@gmail.com" autocomplete="email" inputmode="email" />
        <div class="f-err" id="eEmail">Vui lòng nhập email hợp lệ</div>
      </div>

      <button class="p-btn" id="btnNext">
        <span class="t">GỬI CHO TÔI NGAY →</span>
        <span class="s" aria-hidden="true"></span>
      </button>
      <p class="p-sec">🔒 Email của bạn an toàn · Không bao giờ spam</p>
    </div>

    <!-- ─ STEP 2: Name + Phone ─ -->
    <div class="p-step" id="s2">
      <div class="p-ico">📦</div>
      <h2 class="p-title">Một bước cuối — để chúng tôi hỗ trợ bạn</h2>
      <p class="p-sub">Điền xong trong 10 giây · Nhận file ngay lập tức qua Zalo</p>

      <!-- Value stack — makes phone number feel worth it -->
      <div class="bonus" role="note" aria-label="Bạn nhận thêm miễn phí">
        <div class="bonus-hd">🎁 Bạn nhận thêm miễn phí:</div>
        <div class="bonus-item">
          ✅ <span>Tư vấn chọn trường 1:1 với chuyên gia</span>
          <span class="bonus-val">500K</span>
        </div>
        <div class="bonus-item">
          🎟️ <span>Voucher học thử 1 buổi tại trường</span>
          <span class="bonus-val">300K</span>
        </div>
        <div class="bonus-item">
          📅 <span>Suất tham quan thực tế ưu tiên</span>
          <span class="bonus-val">200K</span>
        </div>
      </div>

      <div class="f-group">
        <label class="f-label" for="fName">Họ và tên</label>
        <input class="f-input" type="text" id="fName" name="parent_name"
               placeholder="Nguyễn Thị Lan" autocomplete="name" />
        <div class="f-err" id="eName">Vui lòng nhập họ tên của bạn</div>
      </div>
      <div class="f-group">
        <label class="f-label" for="fPhone">Số điện thoại / Zalo</label>
        <input class="f-input" type="tel" id="fPhone" name="phone"
               placeholder="0912 345 678" autocomplete="tel" inputmode="tel" />
        <div class="f-err" id="ePhone">Vui lòng nhập số điện thoại hợp lệ (9-11 số)</div>
      </div>

      <button class="p-btn" id="btnSubmit">
        <span class="t">NHẬN CHECKLIST + TƯ VẤN MIỄN PHÍ →</span>
        <span class="s" aria-hidden="true"></span>
      </button>
      <button class="p-back" id="btnBack" type="button">← Quay lại</button>
      <p class="p-sec">🔒 Thông tin bảo mật tuyệt đối — không chia sẻ bên thứ ba</p>
    </div>

    <!-- ─ SUCCESS ─ -->
    <div class="p-suc" id="sSuccess">
      <div class="suc-ico">🎉</div>
      <div class="suc-h">Đăng ký thành công!</div>
      <p class="suc-p">
        Checklist đang được gửi vào email của bạn.<br>
        Nhớ kiểm tra <strong>Spam / Promotions</strong> nếu chưa thấy.
      </p>
    </div>

  </div>
</div>

<!-- ⑥ SCRIPT ─────────────────────────────── -->
<script>
(function () {
  'use strict';

  /* ── CONFIG ── */
  var CFG = {
    formId:      'sq-mn',
    funnelCode:  'squeeze-checklist-mam-non',
    schoolLevel: 'mam-non',
    redirect:    '/cam-on/',
    apiUrl:      '/api/lead',
  };

  /* ── CACHED REFS ── */
  var overlay    = document.getElementById('overlay');
  var popup      = document.getElementById('popup');
  var pClose     = document.getElementById('pClose');
  var s1         = document.getElementById('s1');
  var s2         = document.getElementById('s2');
  var sSuc       = document.getElementById('sSuccess');
  var progFill   = document.getElementById('progFill');
  var progLabel  = document.getElementById('progLabel');
  var progPct    = document.getElementById('progPct');
  var btnNext    = document.getElementById('btnNext');
  var btnSubmit  = document.getElementById('btnSubmit');
  var btnBack    = document.getElementById('btnBack');
  var ctaMain    = document.getElementById('ctaMain');
  var ctaMob     = document.getElementById('ctaMob');
  var seatsEl    = document.getElementById('seats');
  var email      = '';

  /* ── POPUP OPEN / CLOSE ── */
  function open() {
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
    setTimeout(function () {
      var el = document.getElementById('fEmail');
      if (el) el.focus();
    }, 340);
    gtm('popup_open');
  }
  function close() {
    overlay.classList.remove('open');
    document.body.style.overflow = '';
  }

  if (ctaMain) ctaMain.addEventListener('click', open);
  if (ctaMob)  ctaMob.addEventListener('click', open);
  pClose.addEventListener('click', close);
  overlay.addEventListener('click', function (e) {
    if (e.target === overlay) close();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') close();
  });

  /* ── PROGRESS ── */
  function setStep(n) {
    if (n === 1) {
      progFill.style.width = '50%';
      progLabel.textContent = 'Bước 1 / 2';
      progPct.textContent   = '50%';
    } else {
      progFill.style.width = '100%';
      progLabel.textContent = 'Bước 2 / 2';
      progPct.textContent   = '100%';
    }
  }

  /* ── VALIDATION ── */
  function validEmail(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v); }
  function validPhone(v) { return /^[0-9+\s\-\.]{9,15}$/.test(v); }
  function err(inputId, errId, show) {
    var inp = document.getElementById(inputId);
    var msg = document.getElementById(errId);
    if (inp) inp.classList.toggle('err', show);
    if (msg) msg.classList.toggle('on', show);
  }

  /* ── STEP 1 → STEP 2 ── */
  btnNext.addEventListener('click', function () {
    var val = (document.getElementById('fEmail') || {}).value || '';
    if (!validEmail(val.trim())) {
      err('fEmail', 'eEmail', true);
      document.getElementById('fEmail').focus();
      return;
    }
    err('fEmail', 'eEmail', false);
    email = val.trim();

    /* Partial capture — don't block UX */
    try {
      localStorage.setItem('va_partial_email', email);
      fetch(CFG.apiUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email:        email,
          form_id:      CFG.formId,
          funnel_code:  CFG.funnelCode,
          school_level: CFG.schoolLevel,
          partial:      true,
        }),
        keepalive: true,
      }).catch(noop);
    } catch (e) {}

    gtm('lead_step1');
    s1.classList.remove('on');
    s2.classList.add('on');
    setStep(2);
    setTimeout(function () {
      var n = document.getElementById('fName');
      if (n) n.focus();
    }, 80);
  });

  /* ── BACK ── */
  btnBack.addEventListener('click', function () {
    s2.classList.remove('on');
    s1.classList.add('on');
    setStep(1);
  });

  /* ── SUBMIT ── */
  btnSubmit.addEventListener('click', function () {
    var name  = (document.getElementById('fName')  || {}).value || '';
    var phone = (document.getElementById('fPhone') || {}).value || '';
    var ok = true;

    if (!name.trim())          { err('fName',  'eName',  true);  ok = false; }
    else                       { err('fName',  'eName',  false); }
    if (!validPhone(phone.trim())) { err('fPhone', 'ePhone', true);  ok = false; }
    else                           { err('fPhone', 'ePhone', false); }

    if (!ok) return;

    btnSubmit.classList.add('loading');
    btnSubmit.disabled = true;

    fetch(CFG.apiUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        email:        email,
        parent_name:  name.trim(),
        phone:        phone.trim(),
        form_id:      CFG.formId,
        funnel_code:  CFG.funnelCode,
        school_level: CFG.schoolLevel,
      }),
    })
    .then(function (r) { return r.json().catch(noop); })
    .catch(noop)
    .finally(function () {
      gtm('lead_submitted');
      try { localStorage.setItem('va_form_submitted', '1'); } catch (e) {}
      btnSubmit.classList.remove('loading');
      btnSubmit.disabled = false;

      s2.classList.remove('on');
      sSuc.classList.add('on');
      setTimeout(function () {
        window.location.href = CFG.redirect;
      }, 2400);
    });
  });

  /* Enter-key UX */
  document.getElementById('fEmail').addEventListener('keydown', function (e) {
    if (e.key === 'Enter') btnNext.click();
  });
  document.getElementById('fPhone').addEventListener('keydown', function (e) {
    if (e.key === 'Enter') btnSubmit.click();
  });

  /* ── SHAKE CTA after 3 s ── */
  setTimeout(function () {
    [ctaMain, ctaMob].forEach(function (b) {
      if (!b) return;
      b.classList.add('shake');
      setTimeout(function () { b.classList.remove('shake'); }, 580);
    });
  }, 3000);

  /* ── URGENCY SEAT COUNTDOWN ── */
  var seats = 11 + Math.floor(Math.random() * 6);   /* 11-16 */
  if (seatsEl) seatsEl.textContent = seats;
  var timer = setInterval(function () {
    if (seats <= 3) { clearInterval(timer); return; }
    seats--;
    if (seatsEl) seatsEl.textContent = seats;
  }, (100 + Math.random() * 110) * 1000);            /* every ~100-210 s */

  /* ── HELPERS ── */
  function gtm(evt) {
    try {
      (window.dataLayer = window.dataLayer || []).push({
        event:        evt,
        form_id:      CFG.formId,
        funnel_code:  CFG.funnelCode,
        school_level: CFG.schoolLevel,
      });
    } catch (e) {}
  }
  function noop() {}

})();
</script>

</body>
</html>
