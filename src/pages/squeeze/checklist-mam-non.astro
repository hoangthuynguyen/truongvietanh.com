---
import LeadFormTwoStepEmailFirst from '../../components/LeadFormTwoStepEmailFirst.astro';
---
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Checklist Chọn Trường Mầm Non 2026 – Tải Miễn Phí | Trường Việt Anh</title>
<meta name="description" content="Tải miễn phí Checklist 15 Tiêu Chí Chọn Trường Mầm Non 2026. Giúp Ba/Mẹ tránh sai lầm, chọn đúng ngay lần đầu." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800;900&family=Open+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
<style>
/* ── RESET ── */
*{box-sizing:border-box;margin:0;padding:0}

/* ── ROOT ── */
html,body{
  height:100%;
  font-family:'Open Sans',sans-serif;
  /* Dark charcoal with subtle vertical stripe — mirrors GetResponse style */
  background-color:#161218;
  background-image:
    repeating-linear-gradient(
      90deg,
      transparent 0px, transparent 38px,
      rgba(255,255,255,.035) 38px, rgba(255,255,255,.035) 40px
    );
  color:#fff;
  overflow:hidden;
  display:flex;
  flex-direction:column;
}

/* ── HEADER ── */
.hdr{
  flex-shrink:0;
  padding:16px 40px;
  display:flex;
  align-items:center;
}
.hdr-logo{height:36px;display:block}

/* ── MAIN STAGE ── */
.stage{
  flex:1;min-height:0;
  display:flex;
  align-items:stretch;
  max-width:1100px;
  width:100%;
  margin:0 auto;
  padding:0 40px 20px;
  gap:0;
  position:relative;
}

/* ── LEFT PANEL ── */
.panel-left{
  flex:0 0 54%;
  display:flex;
  flex-direction:column;
  justify-content:center;
  gap:18px;
  padding-right:32px;
  z-index:2;
}

/* Decorative icons row */
.deco-row{
  display:flex;align-items:center;gap:14px;
  font-size:18px;opacity:.75;
  margin-bottom:-4px;
}

/* Headline */
.h1{
  font-family:'Montserrat',sans-serif;
  font-size:clamp(1.75rem,2.8vw,2.6rem);
  font-weight:900;
  line-height:1.15;
  color:#fff;
}
.h1 .accent{color:#e84e3c}

/* Sub */
.sub{
  font-size:14px;
  color:rgba(255,255,255,.65);
  line-height:1.6;
  max-width:380px;
}

/* ── FORM BLOCK ── */
.form-block{
  background:transparent;
  max-width:400px;
}

/* Override component styles for dark bg context */
.form-block .form-step-title{
  display:none; /* title already in headline */
}
.form-block .form-step-description{
  display:none;
}
.form-block .form-progress{
  margin-bottom:10px;
}
.form-block .form-progress__label{
  color:rgba(255,255,255,.6) !important;
  font-size:.72rem !important;
  text-transform:uppercase;
  letter-spacing:.5px;
}
.form-block .form-progress__step--active .form-progress__label,
.form-block .form-progress__step--done  .form-progress__label{
  color:#fff !important;
}
.form-block .form-progress__dot{
  background:rgba(255,255,255,.12);
  color:rgba(255,255,255,.5);
  font-size:.8rem;
  width:26px;height:26px;
}
.form-block .form-progress__step--active .form-progress__dot{
  background:#e84e3c;
  color:#fff;
  box-shadow:0 2px 10px rgba(232,78,60,.5);
}
.form-block .form-progress__step--done .form-progress__dot{
  background:#22c55e;color:#fff;
}
.form-block .form-progress__line{
  background:rgba(255,255,255,.15);
  height:2px;width:44px;margin:0 8px 18px;
}
.form-block .form-progress__line--active{
  background:linear-gradient(90deg,#22c55e,#e84e3c);
}
/* Inputs */
.form-block .form-input{
  background:#fff;
  border:2px solid transparent;
  border-radius:6px;
  font-size:14.5px;
  padding:.75rem 1rem;
  color:#111;
}
.form-block .form-input:focus{
  border-color:#e84e3c;
  box-shadow:0 0 0 3px rgba(232,78,60,.18);
}
/* CTA button */
.form-block .form-btn--next,
.form-block .form-btn--submit{
  background:#e84e3c;
  color:#fff;
  font-size:1rem;
  font-weight:900;
  letter-spacing:.8px;
  text-transform:uppercase;
  border-radius:6px;
  padding:.9rem 1rem;
  box-shadow:0 4px 18px rgba(232,78,60,.45);
  transition:transform .15s,box-shadow .15s;
}
.form-block .form-btn--next:hover,
.form-block .form-btn--submit:hover{
  background:#d43b2a;
  transform:translateY(-2px);
  box-shadow:0 8px 24px rgba(232,78,60,.55);
}
/* Social proof pulse */
.form-block .form-social-proof{
  color:rgba(255,255,255,.55) !important;
  font-size:.78rem !important;
}
.form-block .form-social-proof::before{
  background:#22c55e;
}
/* Back button */
.form-block .form-btn--back{
  background:rgba(255,255,255,.1);
  color:#fff;
  border:1px solid rgba(255,255,255,.2);
  font-size:.85rem;
}
.form-block .form-btn--back:hover{background:rgba(255,255,255,.18)}
/* Success */
.form-block .form-success .form-step-title{
  display:block !important;
  color:#22c55e;
}
.form-block .form-success .form-step-description{
  display:block !important;
  color:rgba(255,255,255,.7);
}
.form-block .success-next-steps{
  background:rgba(39,174,96,.1);
  border-color:rgba(39,174,96,.3);
}
.form-block .success-next-step{color:rgba(255,255,255,.8)}
/* Error */
.form-block .form-error{color:#f87171}
/* Reset max-width of lead-form */
.form-block .lead-form{max-width:100%}

/* Privacy note */
.privacy{
  font-size:11px;
  color:rgba(255,255,255,.35);
  line-height:1.5;
  max-width:380px;
}
.privacy a{color:rgba(255,255,255,.45);text-decoration:underline}

/* ── RIGHT PANEL — floating mockup ── */
.panel-right{
  flex:1;
  position:relative;
  display:flex;
  align-items:center;
  justify-content:flex-start;
  padding-left:16px;
  overflow:visible;
}
.mockup-img{
  /* Tilted stack effect like GetResponse */
  width:clamp(240px,26vw,360px);
  filter:drop-shadow(-8px 16px 40px rgba(0,0,0,.7));
  transform:rotate(4deg) translateX(16px);
  transform-origin:bottom left;
  display:block;
  position:relative;
  z-index:1;
}
/* Second "shadow" copy for depth */
.mockup-stack{
  position:absolute;
  left:36px;
  width:clamp(240px,26vw,360px);
  opacity:.35;
  filter:drop-shadow(0 10px 20px rgba(0,0,0,.6));
  transform:rotate(9deg) translateX(22px);
  transform-origin:bottom left;
}

/* ── MOBILE ── */
@media(max-width:820px){
  html,body{overflow-y:auto;overflow-x:hidden;height:auto}
  .stage{
    flex-direction:column;
    padding:0 20px 32px;
    gap:0;
  }
  .panel-left{
    padding-right:0;
    order:1;
    gap:14px;
  }
  /* Mockup between headline and form */
  .panel-right{
    order:2;
    justify-content:center;
    padding:12px 0;
    min-height:160px;
    overflow:hidden;
  }
  .mockup-img{
    width:clamp(170px,55vw,240px);
    transform:rotate(4deg);
  }
  .mockup-stack{
    width:clamp(170px,55vw,240px);
    left:24px;
  }
  .panel-left .form-block-wrap{order:3}
  .hdr{padding:12px 20px}
  .hdr-logo{height:30px}
  .h1{font-size:1.5rem}
}
@media(max-width:480px){
  .h1{font-size:1.3rem}
  .mockup-img{width:clamp(150px,50vw,210px)}
}
</style>
</head>
<body>

<!-- HEADER -->
<header class="hdr">
  <a href="https://truongvietanh.com">
    <img src="/logo-th-thcs-thpt.png" alt="Trường Việt Anh" class="hdr-logo"
         onerror="this.outerHTML='<span style=\'font-family:Montserrat,sans-serif;font-weight:900;font-size:15px;color:#fff\'>Trường Việt Anh</span>'" />
  </a>
</header>

<!-- STAGE -->
<section class="stage">

  <!-- LEFT PANEL -->
  <div class="panel-left">

    <!-- Decorative icons -->
    <div class="deco-row" aria-hidden="true">
      <span>🏫</span>
      <span>📋</span>
      <span>✅</span>
      <span>🎁</span>
    </div>

    <!-- Headline -->
    <h1 class="h1">
      Sẵn sàng chọn trường mầm non
      <span class="accent">đúng ngay lần đầu</span>
      cho con bạn!
    </h1>

    <!-- Sub -->
    <p class="sub">
      Đăng ký nhận checklist miễn phí và nhận ngay bộ 15 tiêu chí
      giúp bạn lên kế hoạch, so sánh và chọn đúng trường
      trong mùa tuyển sinh này.
    </p>

    <!-- Form -->
    <div class="form-block">
      <LeadFormTwoStepEmailFirst
        formId="sq-mn"
        funnelCode="squeeze-checklist-mam-non"
        schoolLevel="mam-non"
        submitText="NHẬN CHECKLIST NGAY"
        successMessage="Kiểm tra email ngay — tài liệu gửi trong vài phút. Nhớ kiểm tra Spam / Promotions."
      />
    </div>

    <!-- Privacy -->
    <p class="privacy">
      Trường Việt Anh cần thông tin bạn cung cấp để gửi tài liệu và hỗ trợ tư vấn.
      Xem thêm <a href="/chinh-sach-bao-mat/">Chính sách bảo mật</a>.
    </p>

  </div>

  <!-- RIGHT PANEL — floating mockup stack -->
  <div class="panel-right" aria-hidden="true">
    <img
      src="/mockup-checklist-mam-non.png"
      alt=""
      class="mockup-stack"
      onerror="this.style.display='none'"
    />
    <img
      src="/mockup-checklist-mam-non.png"
      alt="Checklist Chọn Trường Mầm Non 2026"
      class="mockup-img"
      onerror="this.style.display='none'"
    />
  </div>

</section>

<!-- Redirect to /cam-on/ after successful form submission -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const successStep = document.querySelector('[data-step="success"]');
    if (!successStep) return;
    const obs = new MutationObserver(function () {
      if (!successStep.hidden) {
        setTimeout(function () { window.location.href = '/cam-on/'; }, 2000);
      }
    });
    obs.observe(successStep, { attributes: true, attributeFilter: ['hidden'] });
  });
</script>

</body>
</html>
