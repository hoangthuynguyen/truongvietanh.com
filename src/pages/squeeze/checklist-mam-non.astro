---
import LeadFormTwoStepEmailFirst from '../../components/LeadFormTwoStepEmailFirst.astro';
---
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Checklist Chọn Trường Mầm Non 2026 – Tải Miễn Phí | Trường Việt Anh</title>
<meta name="description" content="Tải miễn phí Checklist 15 Tiêu Chí Chọn Trường Mầm Non 2026. Giúp Ba/Mẹ tránh sai lầm, chọn đúng ngay lần đầu." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800;900&family=Open+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
<style>
*{box-sizing:border-box;margin:0;padding:0}

/* DESKTOP: full viewport */
html,body{height:100%;overflow:hidden}
body{font-family:'Open Sans',sans-serif;background:#0b1735;color:#fff;display:flex;flex-direction:column}

/* ── HEADER: logo only — no distractions ── */
.hdr{
  background:#fff;border-bottom:1px solid rgba(0,0,0,.09);
  padding:0 28px;height:60px;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;
}
.hdr-logo{height:46px;display:block}

/* ── HERO: 2-COL GRID ── */
.hero{
  flex:1;min-height:0;
  display:grid;
  grid-template-columns:1.15fr 0.85fr;
  max-width:1280px;width:100%;margin:0 auto;
  padding:20px 44px 16px;gap:44px;
}

/* ── LEFT COLUMN ── */
.col-left{
  display:flex;flex-direction:column;
  justify-content:space-between;gap:12px;
}

/* ── RIGHT COLUMN ── */
.col-right{
  display:flex;flex-direction:column;
  gap:10px;
}

/* ── HEADLINE BLOCK ── */
.fomo{
  display:inline-flex;align-items:center;gap:6px;
  background:rgba(239,68,68,.13);border:1px solid rgba(239,68,68,.38);
  color:#ff8080;padding:4px 12px;border-radius:20px;
  font-size:11px;font-weight:700;letter-spacing:.4px;margin-bottom:10px;
}
.h1{
  font-family:'Montserrat',sans-serif;
  font-size:clamp(1.9rem,3vw,2.95rem);
  font-weight:900;line-height:1.1;color:#fff;margin-bottom:11px;
}
.h1 em{color:#f0c040;font-style:normal;display:block}
.sub{
  font-size:15px;color:rgba(255,255,255,.82);line-height:1.5;font-weight:500;
  border-left:3px solid #d4a843;padding-left:12px;
}

/* ── BULLETS ── */
.bullets{list-style:none;display:flex;flex-direction:column;gap:9px}
.bullets li{display:flex;align-items:flex-start;gap:9px;font-size:13.5px;color:rgba(255,255,255,.86);line-height:1.4}
.bico{width:20px;height:20px;min-width:20px;border-radius:50%;background:rgba(240,192,64,.15);border:1.5px solid rgba(240,192,64,.5);display:flex;align-items:center;justify-content:center;margin-top:1px;flex-shrink:0}
.bico svg{width:10px;height:10px;stroke:#f0c040;fill:none;stroke-width:3;stroke-linecap:round;stroke-linejoin:round}

/* ── TESTIMONIAL — upgraded social proof box ── */
.testimonial{
  background:rgba(255,255,255,.07);
  border:1px solid rgba(240,192,64,.25);
  border-radius:12px;
  padding:12px 14px;
}
.test-stars{color:#f0c040;font-size:13px;letter-spacing:1px;margin-bottom:5px}
.test-quote{font-size:13px;color:rgba(255,255,255,.85);line-height:1.55;font-style:italic;margin-bottom:8px}
.test-author{display:flex;align-items:center;gap:9px}
.test-avatar{
  width:34px;height:34px;border-radius:50%;flex-shrink:0;
  background:linear-gradient(135deg,#d4a843,#f0c040);
  display:flex;align-items:center;justify-content:center;
  font-family:'Montserrat',sans-serif;font-weight:900;font-size:13px;color:#0d1b3e;
}
.test-name{font-size:11.5px;font-weight:700;color:#f0c040;line-height:1.3}
.test-meta{font-size:10.5px;color:rgba(255,255,255,.5);margin-top:1px}

/* ── MOCKUP with FREE badge ── */
.mockup-wrap{
  position:relative;
  flex:1;min-height:0;
  display:flex;align-items:center;justify-content:center;
}
.mockup-wrap img{
  max-height:100%;max-width:100%;
  object-fit:contain;
  filter:drop-shadow(0 10px 32px rgba(0,0,0,.55));
  display:block;
}
.badge-free{
  position:absolute;top:8px;right:4px;
  background:linear-gradient(135deg,#22c55e,#16a34a);
  color:#fff;font-family:'Montserrat',sans-serif;
  font-weight:900;font-size:10.5px;letter-spacing:.5px;
  padding:5px 10px;border-radius:20px;
  box-shadow:0 4px 14px rgba(34,197,94,.5);
  text-transform:uppercase;
}

/* ── FORM CARD wrapper ── */
.card{
  background:#fff;border-radius:16px;overflow:hidden;
  box-shadow:0 20px 60px rgba(0,0,0,.55);flex-shrink:0;
}
.card-top{
  background:linear-gradient(135deg,#0d1b3e,#162550);
  padding:10px 16px;text-align:center;border-bottom:2.5px solid #d4a843;
}
.card-urgency{color:#f0c040;font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;margin-bottom:2px}
.card-title{color:#fff;font-family:'Montserrat',sans-serif;font-weight:800;font-size:.83rem;line-height:1.3}
.card-body{padding:14px 16px 12px}

/* ── MOBILE ── */
@media(max-width:900px){
  html,body{overflow-x:hidden;overflow-y:auto;height:auto}
  .hdr{height:52px}
  .hdr-logo{height:38px}
  .hero{
    display:flex;flex-direction:column;
    padding:14px 16px 28px;gap:14px;flex:unset;
  }
  .col-left,.col-right{display:contents}

  /* mobile order: headline → mockup → form → bullets → testimonial */
  .item-headline {order:1}
  .mockup-wrap   {order:2;min-height:0;flex:unset}
  .mockup-wrap img{max-height:160px}
  .item-form     {order:3}
  .item-bullets  {order:4}
  .item-social   {order:5}

  .h1{font-size:1.55rem}
  .sub{font-size:13.5px}
  .badge-free{top:4px;right:2px;font-size:9.5px;padding:4px 8px}
}
@media(max-width:480px){
  .h1{font-size:1.35rem}
}
</style>
</head>
<body>

<!-- HEADER: logo only, zero distractions -->
<header class="hdr">
  <a href="https://truongvietanh.com">
    <img src="/logo-th-thcs-thpt.png" alt="Trường Việt Anh" class="hdr-logo" />
  </a>
</header>

<!-- HERO -->
<section class="hero">

  <!-- LEFT COLUMN -->
  <div class="col-left">

    <div class="item-headline">
      <div class="fomo">🔥 3,247 phụ huynh đã nhận — Còn miễn phí hôm nay</div>
      <h1 class="h1">
        Chọn sai trường mầm non —
        <em>Con mất nền tảng cả đời</em>
      </h1>
      <p class="sub">Checklist 15 tiêu chí giúp bạn chọn đúng <strong>ngay lần đầu</strong> — chỉ 5 phút, không cần hỏi ai</p>
    </div>

    <div class="item-bullets">
      <ul class="bullets">
        <li>
          <span class="bico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
          <span>Tránh 5 sai lầm tốn kém mà <strong>9/10 phụ huynh không biết mình đang mắc</strong></span>
        </li>
        <li>
          <span class="bico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
          <span>Tự tin chọn trường ngay hôm nay — <strong>không hối hận sau 3 năm</strong></span>
        </li>
        <li>
          <span class="bico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
          <span>Con vào đúng môi trường từ đầu — <strong>không phải chuyển trường tốn kém</strong></span>
        </li>
      </ul>
    </div>

    <!-- UPGRADED TESTIMONIAL -->
    <div class="item-social">
      <div class="testimonial">
        <div class="test-stars">★★★★★</div>
        <div class="test-quote">"Đọc xong checklist, tôi biết ngay trường nào phù hợp với con. Tiếc là không có sớm hơn!"</div>
        <div class="test-author">
          <div class="test-avatar">MT</div>
          <div>
            <div class="test-name">Chị Minh Trang</div>
            <div class="test-meta">Phụ huynh Q.Bình Thạnh · Đã tải 2 tuần trước</div>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- RIGHT COLUMN: mockup on top → form below -->
  <div class="col-right">

    <!-- MOCKUP with FREE badge — creates desire first -->
    <div class="mockup-wrap">
      <img src="/mockup-checklist-mam-non.png" alt="Checklist 15 Tiêu Chí Chọn Trường Mầm Non 2026"
           onerror="this.parentElement.style.display='none'" />
      <span class="badge-free">🎁 Miễn phí</span>
    </div>

    <!-- FORM CARD wrapping the shared component -->
    <div class="item-form">
      <div class="card">
        <div class="card-top">
          <div class="card-urgency">⏰ Miễn phí 100% · Nhận ngay hôm nay</div>
          <div class="card-title">Checklist 15 Tiêu Chí Chọn Trường Mầm Non 2026</div>
        </div>
        <div class="card-body" data-form-bg="light">
          <LeadFormTwoStepEmailFirst
            formId="sq-mn"
            funnelCode="squeeze-checklist-mam-non"
            schoolLevel="mam-non"
            submitText="🎁 Nhận Checklist Miễn Phí"
            successMessage="Kiểm tra email ngay — tài liệu gửi trong vài phút. Nhớ kiểm tra Spam / Promotions."
          />
        </div>
      </div>
    </div>

  </div>

</section>

<!-- Redirect to /cam-on/ after successful form submission -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const successStep = document.querySelector('[data-step="success"]');
    if (!successStep) return;
    const obs = new MutationObserver(function () {
      if (!successStep.hidden) {
        setTimeout(function () { window.location.href = '/cam-on/'; }, 2000);
      }
    });
    obs.observe(successStep, { attributes: true, attributeFilter: ['hidden'] });
  });
</script>

</body>
</html>
