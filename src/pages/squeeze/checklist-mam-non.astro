---
// Standalone squeeze page – custom popup two-step form (no shared component)
---
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>95% Ba Mẹ Chọn Sai Trường Mầm Non – Checklist 15 Tiêu Chí Miễn Phí | Trường Việt Anh</title>
<meta name="description" content="Tải miễn phí Checklist 15 Tiêu Chí Chọn Trường Mầm Non Song Ngữ 2026. Framework 5C + 5 Red Flags. Đánh giá bất kỳ trường nào trong 15 phút. Chỉ 30 suất đầu tiên." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
<style>
/* ══ RESET ══ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

/* ══ ROOT – no scroll on desktop ══ */
html { height: 100%; }
body {
  min-height: 100%;
  font-family: 'Inter', sans-serif;
  background: #0b1628;
  background-image:
    radial-gradient(ellipse 80% 60% at 70% 100%, rgba(22,78,139,.35) 0%, transparent 60%),
    radial-gradient(ellipse 50% 40% at 0% 0%, rgba(14,40,80,.6) 0%, transparent 50%);
  color: #fff;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* ══════════════════════════════════
   1. URGENCY BAR
══════════════════════════════════ */
.urgency-bar {
  flex-shrink: 0;
  background: linear-gradient(90deg, #b91c1c 0%, #dc2626 50%, #b91c1c 100%);
  background-size: 200% 100%;
  animation: barShimmer 4s linear infinite, fadeSlideDown .4s ease both;
  padding: 7px 20px;
  text-align: center;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: .2px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}
.urgency-pill {
  background: rgba(0,0,0,.3);
  border-radius: 20px;
  padding: 1px 10px;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

/* ══════════════════════════════════
   2. LOGO BAR
══════════════════════════════════ */
.logo-bar {
  flex-shrink: 0;
  background: #fff;
  padding: 9px 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 1px 0 rgba(255,255,255,.06);
}
.logo-bar img { height: 42px; display: block; }
.logo-fallback {
  font-family: 'Montserrat', sans-serif;
  font-weight: 900;
  font-size: 16px;
  color: #0b1628;
}

/* ══════════════════════════════════
   3. HERO
══════════════════════════════════ */
.hero {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: stretch;
  max-width: 1080px;
  width: 100%;
  margin: 0 auto;
  padding: 18px 40px 20px;
  gap: 40px;
  animation: fadeSlideUp .65s ease both .1s;
}

/* ── LEFT ── */
.panel-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: clamp(8px, 1.4vh, 15px);
}

/* Eyebrow badge */
.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(220,38,38,.15);
  border: 1px solid rgba(220,38,38,.4);
  border-radius: 30px;
  padding: 4px 14px 4px 8px;
  width: fit-content;
  font-size: 12px;
  font-weight: 700;
  color: #fca5a5;
  letter-spacing: .2px;
}
.eyebrow-num {
  background: #dc2626;
  color: #fff;
  font-family: 'Montserrat', sans-serif;
  font-size: 14px;
  font-weight: 900;
  border-radius: 20px;
  padding: 1px 9px;
}

/* Headline */
.h1 {
  font-family: 'Montserrat', sans-serif;
  font-size: clamp(1.45rem, 2.4vw, 2.1rem);
  font-weight: 900;
  line-height: 1.2;
}
.h1 .stat { color: #f87171; }
.h1 .kw  {
  background: linear-gradient(100deg, #f97316, #ef4444);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Subheadline */
.sub {
  font-size: 13.5px;
  color: rgba(255,255,255,.68);
  line-height: 1.65;
  border-left: 3px solid #dc2626;
  padding-left: 12px;
}
.sub strong { color: rgba(255,255,255,.88); }

/* Bullets */
.bullets {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 7px;
}
.bullets li {
  display: flex;
  align-items: flex-start;
  gap: 9px;
  font-size: 13.5px;
  color: rgba(255,255,255,.82);
  line-height: 1.45;
}
.check {
  flex-shrink: 0;
  width: 18px; height: 18px;
  background: #16a34a;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2px;
}
.check svg { width: 10px; height: 10px; }

/* Trust row */
.trust-row {
  display: flex;
  gap: 4px;
  flex-wrap: wrap;
}
.trust-pill {
  display: flex;
  align-items: center;
  gap: 6px;
  background: rgba(255,255,255,.06);
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 6px;
  padding: 5px 10px;
  font-size: 12px;
  color: rgba(255,255,255,.65);
}
.trust-num {
  font-family: 'Montserrat', sans-serif;
  font-size: 15px;
  font-weight: 800;
  color: #fbbf24;
}

/* CTA block */
.cta-wrap { display: flex; flex-direction: column; gap: 7px; }

.btn-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background: linear-gradient(135deg, #ea580c 0%, #dc2626 100%);
  color: #fff;
  font-family: 'Montserrat', sans-serif;
  font-size: clamp(.9rem, 1.2vw, 1.05rem);
  font-weight: 900;
  letter-spacing: .9px;
  text-transform: uppercase;
  border: none;
  border-radius: 10px;
  padding: 15px 28px;
  cursor: pointer;
  box-shadow: 0 6px 28px rgba(220,38,38,.5), 0 2px 6px rgba(0,0,0,.3);
  transition: transform .2s ease, box-shadow .2s ease;
  max-width: 440px;
  position: relative;
  overflow: hidden;
  animation: btnPulse 2.8s ease-in-out infinite;
}
.btn-cta::after {
  content: '';
  position: absolute;
  top: 0; left: -80%;
  width: 60%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.22), transparent);
  transition: left .55s ease;
}
.btn-cta:hover {
  transform: translateY(-3px) scale(1.025);
  box-shadow: 0 12px 36px rgba(220,38,38,.65), 0 2px 8px rgba(0,0,0,.3);
  animation: none;
}
.btn-cta:hover::after { left: 140%; }
.btn-cta:active { transform: scale(.98); }
.btn-cta.shake { animation: ctaShake .55s ease; }

.micro-copy {
  font-size: 11px;
  color: rgba(255,255,255,.38);
  display: flex;
  align-items: center;
  gap: 5px;
}

/* ── RIGHT ── */
.panel-right {
  flex: 0 0 330px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
}

.mockup-frame {
  position: relative;
  width: 100%;
  max-width: 280px;
}
/* layered shadow cards */
.mockup-frame::before,
.mockup-frame::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 14px;
  background: linear-gradient(135deg, #1d3a6b, #0b1e45);
}
.mockup-frame::before {
  transform: rotate(8deg) translate(14px, 14px);
  z-index: 0;
  opacity: .7;
  box-shadow: 0 16px 50px rgba(0,0,0,.5);
}
.mockup-frame::after {
  transform: rotate(4deg) translate(7px, 7px);
  z-index: 1;
  opacity: .5;
}
.mockup-img {
  position: relative;
  z-index: 2;
  width: 100%;
  border-radius: 12px;
  box-shadow: 0 14px 44px rgba(0,0,0,.55);
  display: block;
}
.free-badge {
  position: absolute;
  top: -10px; right: -10px;
  z-index: 3;
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
  color: #78350f;
  font-family: 'Montserrat', sans-serif;
  font-size: 10px;
  font-weight: 900;
  padding: 5px 11px;
  border-radius: 30px;
  text-transform: uppercase;
  letter-spacing: .6px;
  box-shadow: 0 3px 12px rgba(245,158,11,.45);
  white-space: nowrap;
}

.mockup-meta {
  font-size: 11.5px;
  color: rgba(255,255,255,.45);
  text-align: center;
  line-height: 1.5;
}
.mockup-meta strong { color: #4ade80; }

/* ══════════════════════════════════
   4. STICKY CTA – mobile only
══════════════════════════════════ */
.sticky-cta {
  display: none;
  position: fixed;
  bottom: 0; left: 0; right: 0;
  z-index: 800;
  padding: 10px 16px 14px;
  background: rgba(11,22,40,.96);
  backdrop-filter: blur(10px);
  border-top: 1px solid rgba(255,255,255,.08);
}
.sticky-cta .btn-cta { max-width: 100%; width: 100%; padding: 15px 20px; }

/* ══════════════════════════════════
   5. POPUP OVERLAY
══════════════════════════════════ */
.overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.78);
  z-index: 1000;
  align-items: center;
  justify-content: center;
  padding: 20px;
  backdrop-filter: blur(5px);
}
.overlay.open {
  display: flex;
  animation: fadeIn .22s ease;
}

.popup {
  background: #fff;
  color: #111827;
  border-radius: 18px;
  width: 100%;
  max-width: 410px;
  padding: 26px 26px 22px;
  position: relative;
  box-shadow: 0 30px 100px rgba(0,0,0,.45);
  animation: popupIn .3s cubic-bezier(.34,1.56,.64,1);
}

.popup-close {
  position: absolute;
  top: 12px; right: 14px;
  background: #f3f4f6;
  border: none;
  border-radius: 50%;
  width: 28px; height: 28px;
  display: flex; align-items: center; justify-content: center;
  font-size: 16px; color: #6b7280;
  cursor: pointer;
  transition: background .15s, color .15s;
  line-height: 1;
}
.popup-close:hover { background: #e5e7eb; color: #111; }

/* Progress */
.pbar-wrap { margin-bottom: 18px; }
.pbar-meta {
  display: flex;
  justify-content: space-between;
  font-size: 11.5px;
  color: #9ca3af;
  font-weight: 600;
  margin-bottom: 5px;
  text-transform: uppercase;
  letter-spacing: .4px;
}
.pbar-track {
  height: 5px;
  background: #e5e7eb;
  border-radius: 99px;
  overflow: hidden;
}
.pbar-fill {
  height: 100%;
  border-radius: 99px;
  background: linear-gradient(90deg, #dc2626, #f97316);
  transition: width .45s ease;
}

/* Steps */
.popup-step { display: none; }
.popup-step.active { display: block; }

.step-icon { font-size: 26px; margin-bottom: 6px; }
.step-title {
  font-family: 'Montserrat', sans-serif;
  font-size: 1.1rem;
  font-weight: 800;
  color: #0b1628;
  line-height: 1.3;
  margin-bottom: 3px;
}
.step-sub { font-size: 13px; color: #6b7280; margin-bottom: 14px; }

/* Form fields */
.fg { margin-bottom: 11px; }
.fl {
  display: block;
  font-size: 11px;
  font-weight: 700;
  color: #374151;
  text-transform: uppercase;
  letter-spacing: .5px;
  margin-bottom: 4px;
}
.fi {
  width: 100%;
  padding: 11px 13px;
  border: 2px solid #e5e7eb;
  border-radius: 8px;
  font-size: 15px;
  font-family: 'Inter', sans-serif;
  color: #111;
  outline: none;
  transition: border-color .2s, box-shadow .2s;
}
.fi:focus { border-color: #dc2626; box-shadow: 0 0 0 3px rgba(220,38,38,.12); }
.fi.err   { border-color: #ef4444; box-shadow: 0 0 0 3px rgba(239,68,68,.1); }
.fe { font-size: 11.5px; color: #ef4444; margin-top: 3px; display: none; }
.fe.show { display: block; }

/* Bonus block */
.bonus {
  background: #f0fdf4;
  border: 1px solid #bbf7d0;
  border-radius: 8px;
  padding: 9px 13px;
  margin-bottom: 12px;
}
.bonus-hd {
  font-size: 10.5px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .5px;
  color: #15803d;
  margin-bottom: 6px;
}
.bonus-row {
  display: flex; align-items: center; gap: 7px;
  font-size: 12.5px; color: #166534;
  margin-bottom: 4px;
}
.bonus-row:last-child { margin-bottom: 0; }

/* Popup CTA */
.pbtn {
  width: 100%;
  background: linear-gradient(135deg, #ea580c, #dc2626);
  color: #fff;
  font-family: 'Montserrat', sans-serif;
  font-size: 1rem;
  font-weight: 900;
  letter-spacing: .8px;
  text-transform: uppercase;
  border: none;
  border-radius: 9px;
  padding: 14px;
  cursor: pointer;
  box-shadow: 0 4px 18px rgba(220,38,38,.4);
  transition: transform .2s, box-shadow .2s;
  margin-top: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 50px;
}
.pbtn:hover { transform: translateY(-2px); box-shadow: 0 8px 26px rgba(220,38,38,.5); }
.pbtn:disabled { opacity: .7; cursor: wait; }
.pbtn .btxt { display: block; }
.pbtn .bspin {
  display: none;
  width: 18px; height: 18px;
  border: 2px solid rgba(255,255,255,.35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin .6s linear infinite;
}
.pbtn.loading .btxt { display: none; }
.pbtn.loading .bspin { display: block; }

.back-btn {
  background: none; border: none;
  font-size: 12px; color: #9ca3af;
  cursor: pointer; padding: 5px 0;
  margin-top: 4px;
  display: flex; align-items: center; gap: 4px;
  transition: color .15s;
}
.back-btn:hover { color: #374151; }

.psec {
  font-size: 11px; color: #9ca3af;
  text-align: center; margin-top: 8px;
  display: flex; align-items: center; justify-content: center; gap: 4px;
}

/* Success */
.popup-success { display: none; text-align: center; padding: 10px 0; }
.popup-success.active { display: block; }
.suc-icon { font-size: 52px; margin-bottom: 12px; }
.suc-title {
  font-family: 'Montserrat', sans-serif;
  font-size: 1.3rem;
  font-weight: 900;
  color: #16a34a;
  margin-bottom: 8px;
}
.suc-sub { font-size: 13.5px; color: #6b7280; line-height: 1.65; }

/* ══════════════════════════════════
   KEYFRAMES
══════════════════════════════════ */
@keyframes fadeSlideDown {
  from { opacity: 0; transform: translateY(-8px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes fadeSlideUp {
  from { opacity: 0; transform: translateY(18px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes popupIn {
  from { opacity: 0; transform: translateY(28px) scale(.96); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes ctaShake {
  0%,100% { transform: translateX(0); }
  15%,45%,75% { transform: translateX(-5px) rotate(-.5deg); }
  30%,60%,90% { transform: translateX(5px) rotate(.5deg); }
}
@keyframes btnPulse {
  0%,100% { box-shadow: 0 6px 28px rgba(220,38,38,.5), 0 2px 6px rgba(0,0,0,.3); }
  50%      { box-shadow: 0 8px 36px rgba(220,38,38,.75), 0 2px 8px rgba(0,0,0,.3); }
}
@keyframes barShimmer {
  0%   { background-position: 200% center; }
  100% { background-position: -200% center; }
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ══════════════════════════════════
   MOBILE
══════════════════════════════════ */
@media (max-width: 820px) {
  html, body { overflow-y: auto; overflow-x: hidden; height: auto; }
  body { padding-bottom: 76px; }

  .hero {
    flex-direction: column;
    padding: 16px 18px 20px;
    gap: 18px;
    align-items: center;
  }
  .panel-left {
    order: 1;
    gap: clamp(8px,2vh,12px);
  }
  .panel-right {
    order: 2;
    flex: none;
    max-width: 220px;
    width: 100%;
  }
  .btn-cta { display: none !important; } /* desktop CTA hidden; sticky shows */
  .sticky-cta { display: block; }
  .logo-bar { padding: 9px 20px; }
  .logo-bar img { height: 36px; }
  .h1 { font-size: 1.3rem; }
  .trust-row { gap: 6px; }
}
@media (max-width: 480px) {
  .h1 { font-size: 1.15rem; }
  .panel-right { max-width: 180px; }
  .popup { padding: 22px 18px 18px; }
}
</style>
</head>
<body>

<!-- ① URGENCY BAR -->
<div class="urgency-bar" role="alert">
  <span>🔥</span>
  Chỉ còn <span class="urgency-pill" id="seatCount">14</span> suất đăng ký sớm trong tháng
  <span>⚡</span>
</div>

<!-- ② LOGO -->
<div class="logo-bar">
  <a href="https://truongvietanh.com">
    <img src="/logo-th-thcs-thpt.png" alt="Trường Việt Anh"
         onerror="this.style.display='none';this.nextElementSibling.style.display='block'" />
    <span class="logo-fallback" style="display:none">Trường Việt Anh</span>
  </a>
</div>

<!-- ③ HERO -->
<section class="hero" aria-label="Offer">

  <!-- LEFT -->
  <div class="panel-left">

    <div class="eyebrow">
      <span class="eyebrow-num">95%</span>
      ba mẹ đã từng chọn sai trường mầm non
    </div>

    <h1 class="h1">
      <span class="stat">95%</span> ba mẹ chọn sai trường mầm non<br>
      vì <span class="kw">KHÔNG biết 15 tiêu chí này</span>
    </h1>

    <p class="sub">
      Checklist giúp bạn đánh giá <strong>bất kỳ trường nào trong 15 phút</strong><br>
      → Tránh sai lầm khiến con sợ học, chậm phát triển, mất tiền oan
    </p>

    <ul class="bullets" aria-label="Nội dung checklist">
      <li>
        <span class="check" aria-hidden="true">
          <svg viewBox="0 0 10 8" fill="none"><path d="M1 4l3 3 5-6" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        15 tiêu chí chọn trường mầm non song ngữ chuẩn quốc tế
      </li>
      <li>
        <span class="check" aria-hidden="true">
          <svg viewBox="0 0 10 8" fill="none"><path d="M1 4l3 3 5-6" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        Framework 5C – so sánh 3 trường một cách khách quan
      </li>
      <li>
        <span class="check" aria-hidden="true">
          <svg viewBox="0 0 10 8" fill="none"><path d="M1 4l3 3 5-6" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        5 Red Flags nguy hiểm cần nhận ra ngay khi tham quan
      </li>
      <li>
        <span class="check" aria-hidden="true">
          <svg viewBox="0 0 10 8" fill="none"><path d="M1 4l3 3 5-6" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        File PDF in sẵn – mang đi tham quan trường tiện lợi
      </li>
    </ul>

    <div class="trust-row" aria-label="Điểm tin cậy">
      <div class="trust-pill">
        <span class="trust-num">10+</span>năm kinh nghiệm
      </div>
      <div class="trust-pill">
        <span class="trust-num">1.000+</span>phụ huynh tin tưởng
      </div>
      <div class="trust-pill">
        <span class="trust-num">100%</span>GV đạt chuẩn
      </div>
    </div>

    <div class="cta-wrap">
      <button class="btn-cta" id="ctaBtn" aria-haspopup="dialog" aria-controls="popupDlg">
        <span aria-hidden="true">🎁</span>
        NHẬN CHECKLIST MIỄN PHÍ NGAY
      </button>
      <span class="micro-copy">🔒 Chỉ mất 10 giây – bảo mật thông tin tuyệt đối</span>
    </div>

  </div>

  <!-- RIGHT – mockup -->
  <div class="panel-right" aria-hidden="true">
    <div class="mockup-frame">
      <span class="free-badge">MIỄN PHÍ 🎁</span>
      <img
        src="/mockup-checklist-mam-non.png"
        alt="Checklist Chọn Trường Mầm Non 2026"
        class="mockup-img"
        onerror="this.style.opacity='.25'"
      />
    </div>
    <p class="mockup-meta"><strong>✓ PDF gửi ngay</strong> · không cần thẻ tín dụng</p>
  </div>

</section>

<!-- STICKY CTA – mobile -->
<div class="sticky-cta" aria-hidden="true">
  <button class="btn-cta" id="ctaBtnMobile" tabindex="-1">
    <span>🎁</span>NHẬN CHECKLIST MIỄN PHÍ
  </button>
</div>

<!-- ④ POPUP -->
<div class="overlay" id="overlayEl" role="dialog" id="popupDlg"
     aria-modal="true" aria-labelledby="step1Title">

  <div class="popup" id="popupBox">
    <button class="popup-close" id="popupClose" aria-label="Đóng popup">✕</button>

    <!-- Progress bar -->
    <div class="pbar-wrap">
      <div class="pbar-meta">
        <span id="stepLabel">Bước 1 / 2</span>
        <span id="pctLabel">50%</span>
      </div>
      <div class="pbar-track">
        <div class="pbar-fill" id="pbarFill" style="width:50%"></div>
      </div>
    </div>

    <!-- STEP 1: EMAIL -->
    <div class="popup-step active" id="step1El">
      <div class="step-icon">📧</div>
      <h2 class="step-title" id="step1Title">Nhập email để nhận checklist</h2>
      <p class="step-sub">Checklist được gửi vào email trong vài phút</p>

      <div class="fg">
        <label class="fl" for="inEmail">Địa chỉ Email</label>
        <input class="fi" type="email" id="inEmail" name="email"
               placeholder="vidu@gmail.com" autocomplete="email"
               inputmode="email" />
        <div class="fe" id="errEmail">Vui lòng nhập email hợp lệ</div>
      </div>

      <button class="pbtn" id="btnNext">
        <span class="btxt">TIẾP TỤC →</span>
        <span class="bspin" aria-hidden="true"></span>
      </button>
      <p class="psec">🔒 Bảo mật 100% – Không spam, không quảng cáo</p>
    </div>

    <!-- STEP 2: NAME + PHONE -->
    <div class="popup-step" id="step2El">
      <div class="step-icon">📦</div>
      <h2 class="step-title">Nhận checklist qua Zalo trong 30 giây</h2>
      <p class="step-sub">Điền thông tin để chúng tôi gửi ngay cho bạn</p>

      <div class="bonus">
        <div class="bonus-hd">🎁 Bạn còn nhận thêm miễn phí:</div>
        <div class="bonus-row">✅ Tư vấn 1:1 với chuyên gia tuyển sinh</div>
        <div class="bonus-row">🎟️ Voucher học thử 1 buổi tại trường</div>
        <div class="bonus-row">📅 Suất trải nghiệm thực tế ưu tiên</div>
      </div>

      <div class="fg">
        <label class="fl" for="inName">Họ và tên</label>
        <input class="fi" type="text" id="inName" name="parent_name"
               placeholder="Nguyễn Thị Lan" autocomplete="name" />
        <div class="fe" id="errName">Vui lòng nhập họ tên</div>
      </div>
      <div class="fg">
        <label class="fl" for="inPhone">Số điện thoại / Zalo</label>
        <input class="fi" type="tel" id="inPhone" name="phone"
               placeholder="0912 345 678" autocomplete="tel" inputmode="tel" />
        <div class="fe" id="errPhone">Vui lòng nhập số điện thoại hợp lệ</div>
      </div>

      <button class="pbtn" id="btnSubmit">
        <span class="btxt">NHẬN NGAY →</span>
        <span class="bspin" aria-hidden="true"></span>
      </button>
      <button class="back-btn" id="btnBack" type="button">← Quay lại bước trước</button>
      <p class="psec">🔒 Thông tin được bảo mật tuyệt đối</p>
    </div>

    <!-- SUCCESS -->
    <div class="popup-success" id="stepSuccess">
      <div class="suc-icon">🎉</div>
      <div class="suc-title">Đăng ký thành công!</div>
      <p class="suc-sub">
        Checklist đã được gửi vào email của bạn.<br>
        Kiểm tra hòm thư (kể cả <strong>Spam / Promotions</strong>).
      </p>
    </div>

  </div>
</div>

<script>
(function () {
  'use strict';
  /* ── CONFIG ── */
  var FORM_ID      = 'sq-mn';
  var FUNNEL_CODE  = 'squeeze-checklist-mam-non';
  var SCHOOL_LVL   = 'mam-non';
  var REDIRECT_URL = '/cam-on/';

  /* ── REFS ── */
  var overlay    = document.getElementById('overlayEl');
  var popupClose = document.getElementById('popupClose');
  var step1El    = document.getElementById('step1El');
  var step2El    = document.getElementById('step2El');
  var stepSuc    = document.getElementById('stepSuccess');
  var pbarFill   = document.getElementById('pbarFill');
  var stepLabel  = document.getElementById('stepLabel');
  var pctLabel   = document.getElementById('pctLabel');
  var btnNext    = document.getElementById('btnNext');
  var btnSubmit  = document.getElementById('btnSubmit');
  var btnBack    = document.getElementById('btnBack');
  var ctaBtn     = document.getElementById('ctaBtn');
  var ctaMob     = document.getElementById('ctaBtnMobile');
  var savedEmail = '';

  /* ── POPUP OPEN / CLOSE ── */
  function openPopup() {
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
    setTimeout(function () { document.getElementById('inEmail').focus(); }, 320);
  }
  function closePopup() {
    overlay.classList.remove('open');
    document.body.style.overflow = '';
  }
  if (ctaBtn)  ctaBtn.addEventListener('click', openPopup);
  if (ctaMob)  ctaMob.addEventListener('click', openPopup);
  popupClose.addEventListener('click', closePopup);
  overlay.addEventListener('click', function (e) { if (e.target === overlay) closePopup(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closePopup(); });

  /* ── PROGRESS ── */
  function setProgress(step) {
    if (step === 1) {
      pbarFill.style.width = '50%';
      stepLabel.textContent = 'Bước 1 / 2';
      pctLabel.textContent  = '50%';
    } else {
      pbarFill.style.width = '100%';
      stepLabel.textContent = 'Bước 2 / 2';
      pctLabel.textContent  = '100%';
    }
  }

  /* ── FIELD HELPERS ── */
  function isEmail(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v); }
  function isPhone(v) { return /^[0-9+\s\-\.]{9,15}$/.test(v); }
  function setErr(inputId, errId, hasErr) {
    document.getElementById(inputId).classList.toggle('err', hasErr);
    document.getElementById(errId).classList.toggle('show', hasErr);
  }

  /* ── STEP 1 → 2 ── */
  btnNext.addEventListener('click', function () {
    var email = document.getElementById('inEmail').value.trim();
    if (!isEmail(email)) { setErr('inEmail', 'errEmail', true); document.getElementById('inEmail').focus(); return; }
    setErr('inEmail', 'errEmail', false);
    savedEmail = email;

    /* partial capture */
    try {
      localStorage.setItem('va_partial_email', email);
      fetch('/api/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email, form_id: FORM_ID, funnel_code: FUNNEL_CODE, school_level: SCHOOL_LVL, partial: true }),
        keepalive: true,
      }).catch(function () {});
    } catch (e) {}

    /* GTM */
    if (window.dataLayer) window.dataLayer.push({ event: 'lead_step1', form_id: FORM_ID, funnel_code: FUNNEL_CODE });

    step1El.classList.remove('active');
    step2El.classList.add('active');
    setProgress(2);
    setTimeout(function () { document.getElementById('inName').focus(); }, 80);
  });

  /* ── BACK ── */
  btnBack.addEventListener('click', function () {
    step2El.classList.remove('active');
    step1El.classList.add('active');
    setProgress(1);
  });

  /* ── SUBMIT ── */
  btnSubmit.addEventListener('click', function () {
    var name  = document.getElementById('inName').value.trim();
    var phone = document.getElementById('inPhone').value.trim();
    var ok = true;
    if (!name)          { setErr('inName',  'errName',  true);  ok = false; } else setErr('inName',  'errName',  false);
    if (!isPhone(phone)){ setErr('inPhone', 'errPhone', true);  ok = false; } else setErr('inPhone', 'errPhone', false);
    if (!ok) return;

    btnSubmit.classList.add('loading');
    btnSubmit.disabled = true;

    fetch('/api/lead', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        email: savedEmail, parent_name: name, phone: phone,
        form_id: FORM_ID, funnel_code: FUNNEL_CODE, school_level: SCHOOL_LVL,
      }),
    })
    .then(function (r) { return r.json().catch(function () { return {}; }); })
    .catch(function () { return {}; })
    .finally(function () {
      if (window.dataLayer) window.dataLayer.push({ event: 'lead_submitted', form_id: FORM_ID, funnel_code: FUNNEL_CODE });
      try { localStorage.setItem('va_form_submitted', '1'); } catch (e) {}

      btnSubmit.classList.remove('loading');
      btnSubmit.disabled = false;

      step2El.classList.remove('active');
      stepSuc.classList.add('active');

      setTimeout(function () { window.location.href = REDIRECT_URL; }, 2300);
    });
  });

  /* Enter-key submit */
  document.getElementById('inEmail').addEventListener('keydown', function (e) { if (e.key === 'Enter') btnNext.click(); });
  document.getElementById('inPhone').addEventListener('keydown', function (e) { if (e.key === 'Enter') btnSubmit.click(); });

  /* ── CTA SHAKE after 3 s ── */
  setTimeout(function () {
    [ctaBtn, ctaMob].forEach(function (b) {
      if (!b) return;
      b.classList.add('shake');
      setTimeout(function () { b.classList.remove('shake'); }, 600);
    });
  }, 3000);

  /* ── FAKE SEAT COUNTDOWN ── */
  var seats = 11 + Math.floor(Math.random() * 7); /* 11-17 */
  document.getElementById('seatCount').textContent = seats;
  /* Decrease by 1 every 90-180 s to simulate live registrations */
  var seatsTimer = setInterval(function () {
    if (seats <= 3) { clearInterval(seatsTimer); return; }
    seats--;
    document.getElementById('seatCount').textContent = seats;
  }, (90 + Math.random() * 90) * 1000);
})();
</script>

</body>
</html>
