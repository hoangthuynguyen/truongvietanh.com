---
import SqueezePageLayout from '../../layouts/SqueezePageLayout.astro';
import USPGrid from '../../components/USPGrid.astro';
import TrustMetrics from '../../components/TrustMetrics.astro';
import LeadFormTwoStepEmailFirst from '../../components/LeadFormTwoStepEmailFirst.astro';
import FAQSection from '../../components/FAQSection.astro';

const pageTitle = 'Học Thử Miễn Phí 1 Ngày Tại Trường Việt Anh | Đăng Ký Ngay';
const pageDescription = 'Cho con trải nghiệm 1 ngày học thực tế tại Trường Việt Anh. Không cam kết, không phí. Con được học, chơi, kết bạn — Ba/Mẹ được tham quan trường và gặp Ban Giám Hiệu.';
const pageCanonical = 'https://truongvietanh.com/squeeze/hoc-thu-mien-phi';

const uspItems = [
  { icon: '🏫', text: 'Trải nghiệm 1 ngày học thực tế -- con tham gia lớp học chính khóa cùng các bạn, không phải buổi demo dàn dựng' },
  { icon: '👨‍👩‍👧', text: 'Ba/Mẹ được tham quan toàn bộ cơ sở vật chất -- phòng học, thư viện, sân chơi, nhà ăn, phòng y tế' },
  { icon: '🌟', text: 'Con được học, chơi, kết bạn -- trải nghiệm đầy đủ từ tiết học chính khóa, ngoại khóa đến giờ ăn trưa' },
  { icon: '👩‍🏫', text: 'Gặp gỡ trực tiếp giáo viên và Ban Giám Hiệu -- trao đổi về chương trình, phương pháp giảng dạy' },
  { icon: '📋', text: 'Nhận đánh giá sơ bộ năng lực của con -- giáo viên quan sát và chia sẻ nhận xét sau buổi học thử' },
  { icon: '✅', text: 'Hoàn toàn miễn phí, không cam kết -- quyết định hoàn toàn thuộc về Ba/Mẹ sau khi trải nghiệm thực tế' }
];

const metrics = [
  { number: '500+', label: 'Gia đình đã tham gia học thử' },
  { number: '95%', label: 'Hài lòng sau trải nghiệm' },
  { number: '3', label: 'Cơ sở tại TPHCM cho Ba/Mẹ chọn' },
  { number: '10', label: 'Suất/đợt để đảm bảo chất lượng' }
];

const faqItems = [
  { question: 'Chương trình học thử diễn ra như thế nào?', answer: 'Con sẽ tham gia 1 ngày học thực tế cùng lớp từ 7h30 đến 16h30, bao gồm các tiết học chính khóa (Toán, Tiếng Việt, Tiếng Anh), ngoại khóa (STEM, Mỹ thuật, Thể dục), và giờ ăn trưa. Giáo viên chủ nhiệm sẽ hướng dẫn con hòa nhập với lớp từ đầu buổi.' },
  { question: 'Con tôi cần chuẩn bị gì?', answer: 'Con chỉ cần mang theo bút và sách vở đơn giản. Trường sẽ cung cấp đồng phục tạm thời, sách giáo khoa, và bữa ăn trưa dinh dưỡng hoàn toàn miễn phí. Ba/Mẹ nên cho con ngủ đủ giấc tối hôm trước để con có trải nghiệm tốt nhất.' },
  { question: 'Phụ huynh có được tham quan không?', answer: 'Có. Trong khi con học, Ba/Mẹ sẽ được nhân viên tuyển sinh hướng dẫn tham quan toàn bộ cơ sở vật chất, gặp Ban Giám Hiệu để tìm hiểu chương trình, và được giải đáp mọi thắc mắc về học phí, chính sách hỗ trợ, và quy trình nhập học.' },
  { question: 'Có phải đăng ký trước không?', answer: 'Có. Do số lượng giới hạn mỗi đợt chỉ tối đa 10 em để đảm bảo chất lượng trải nghiệm, Ba/Mẹ cần đăng ký trước ít nhất 3-5 ngày. Chúng tôi sẽ liên hệ xác nhận lịch và sắp xếp lớp phù hợp với độ tuổi và cấp học của con.' },
  { question: 'Học thử có cam kết gì không?', answer: 'Không có bất kỳ cam kết nào. Đây hoàn toàn là cơ hội để Ba/Mẹ và con trải nghiệm thực tế trước khi quyết định. Sau buổi học thử, Ba/Mẹ sẽ nhận nhận xét từ giáo viên về con và có thể từ từ cân nhắc mà không bị áp lực.' }
];
---

<SqueezePageLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={pageCanonical}
  schoolLevel="tieu-hoc"
  funnelCode="squeeze-hoc-thu"
>
  <section slot="hero">
    <h1 class="squeeze-hero__heading">Cho Con Trải Nghiệm 1 Ngày Học Thực Tế -- Hoàn Toàn Miễn Phí</h1>
    <p class="squeeze-hero__subheading">Con được học, chơi, kết bạn trong lớp thật. Ba/Mẹ được tham quan trường và gặp Ban Giám Hiệu. Không cam kết, không chi phí.</p>
  </section>

  <section slot="usp"><USPGrid title="Con và Ba/Mẹ sẽ được gì?" items={uspItems} /></section>
  <section slot="trust"><TrustMetrics title="Trường Việt Anh" metrics={metrics} /></section>

  <section slot="content">
    <div class="hocthu-content">
      <!-- Hero Image -->
      <div class="hocthu-content__image-wrap">
        <img src="https://media.truongvietanh.com/images/vui-ve-02.webp" alt="Học sinh vui vẻ trong ngày học thử tại Trường Việt Anh TPHCM" class="hocthu-content__image" width="900" height="500" loading="lazy" />
      </div>

      <h2 class="hocthu-content__title">1 ngày học thử bao gồm những gì?</h2>

      <!-- Content Cards -->
      <div class="hocthu-grid">
        <div class="hocthu-card">
          <div class="hocthu-card__icon">📚</div>
          <h3>Học chính khóa cùng lớp thật</h3>
          <p>Con tham gia các tiết Toán, Tiếng Việt, Tiếng Anh cùng các bạn trong lớp. Giáo viên bản xứ và giáo viên nước ngoài phối hợp giảng dạy theo phương pháp tương tác, giúp con không cảm thấy xa lạ mà nhanh chóng hòa nhập.</p>
        </div>
        <div class="hocthu-card">
          <div class="hocthu-card__icon">🎨</div>
          <h3>Ngoại khóa phong phú</h3>
          <p>Con được trải nghiệm các hoạt động ngoại khóa như Mỹ thuật, Âm nhạc, Thể dục, và STEM. Đây là cơ hội để Ba/Mẹ thấy con được phát triển toàn diện, không chỉ kiến thức sách vở mà còn kỹ năng sáng tạo, thể chất và tư duy logic.</p>
        </div>
        <div class="hocthu-card">
          <div class="hocthu-card__icon">🍜</div>
          <h3>Bữa trưa dinh dưỡng miễn phí</h3>
          <p>Con được ăn trưa cùng các bạn trong nhà ăn của trường. Thực đơn được chuyên gia dinh dưỡng thiết kế, đảm bảo đủ chất và an toàn vệ sinh thực phẩm. Ba/Mẹ có thể yên tâm về chế độ ăn uống khi con học tại đây.</p>
        </div>
        <div class="hocthu-card">
          <div class="hocthu-card__icon">👨‍👩‍👧</div>
          <h3>Ba/Mẹ tham quan và trao đổi</h3>
          <p>Trong khi con học, Ba/Mẹ được tham quan trường, gặp Ban Giám Hiệu, và trao đổi trực tiếp về chương trình học, phương pháp giáo dục, chính sách học phí. Đây là cách tốt nhất để hiểu trường trước khi đưa ra quyết định.</p>
        </div>
      </div>

      <!-- Bonus Section -->
      <div class="hocthu-bonus">
        <div class="hocthu-bonus__icon">🎁</div>
        <h3 class="hocthu-bonus__title">Bonus: Nhận báo cáo đánh giá sơ bộ năng lực của con</h3>
        <p class="hocthu-bonus__text">Sau ngày học thử, giáo viên sẽ quan sát và đánh giá sơ bộ năng lực học tập, khả năng hòa nhập, và tính cách của con. Ba/Mẹ sẽ nhận báo cáo ngắn qua email trong vòng 48 giờ, kèm gợi ý về cách hỗ trợ con phát triển tốt hơn -- bất kể Ba/Mẹ có chọn Trường Việt Anh hay không.</p>
      </div>

      <!-- Urgency Note -->
      <div class="hocthu-urgency">
        <p><strong>⚠️ Giới hạn:</strong> Mỗi đợt học thử chỉ nhận tối đa 10 em để đảm bảo giáo viên có thể quan sát và chăm sóc từng con. Lịch học thử được tổ chức 2 đợt/tháng. Đăng ký sớm để giữ chỗ cho con trong đợt gần nhất.</p>
      </div>
    </div>
  </section>

  <section slot="form">
    <h2 class="squeeze-form-section__heading">Đăng ký học thử miễn phí</h2>
    <p class="squeeze-form-section__description">Điền thông tin để chúng tôi sắp xếp ngày học thử phù hợp cho con</p>
    <LeadFormTwoStepEmailFirst formId="squeeze-form" funnelCode="squeeze-hoc-thu" schoolLevel="tieu-hoc" submitText="Đăng ký học thử ngay" successMessage="Cảm ơn! Chúng tôi sẽ liên hệ trong 24 giờ để sắp xếp lịch học thử cho con." />
  </section>

  <section slot="faq"><FAQSection title="Câu hỏi thường gặp" items={faqItems} /></section>
</SqueezePageLayout>

<style is:inline>
  .hocthu-content { max-width: 900px; margin: 0 auto; }
  .hocthu-content__image-wrap { margin-bottom: 2rem; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.1); }
  .hocthu-content__image { width: 100%; height: auto; display: block; object-fit: cover; max-height: 420px; }
  .hocthu-content__title { font-family: Montserrat, sans-serif; font-size: 1.75rem; font-weight: 700; margin-bottom: 1.5rem; color: #1F4E79; text-align: center; }
  .hocthu-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; margin: 2rem 0; }
  .hocthu-card { background: white; border: 2px solid #e0e0e0; border-radius: 12px; padding: 1.5rem; text-align: center; transition: all 0.3s ease; }
  .hocthu-card:hover { border-color: #E8792B; box-shadow: 0 8px 20px rgba(232, 121, 43, 0.12); transform: translateY(-4px); }
  .hocthu-card__icon { font-size: 2.5rem; margin-bottom: 0.75rem; }
  .hocthu-card h3 { font-family: Montserrat, sans-serif; font-size: 1.1rem; font-weight: 600; margin-bottom: 0.75rem; color: #1F4E79; }
  .hocthu-card p { font-size: 0.9rem; line-height: 1.7; color: #555; text-align: left; margin: 0; }
  .hocthu-bonus { background: linear-gradient(135deg, #FFF8F0 0%, #FFF3E0 100%); border: 2px solid #E8792B; border-radius: 12px; padding: 2rem; margin: 2.5rem 0; text-align: center; }
  .hocthu-bonus__icon { font-size: 2.5rem; margin-bottom: 0.75rem; }
  .hocthu-bonus__title { font-family: Montserrat, sans-serif; font-size: 1.25rem; font-weight: 700; color: #E8792B; margin-bottom: 1rem; }
  .hocthu-bonus__text { font-size: 0.95rem; line-height: 1.7; color: #555; max-width: 700px; margin: 0 auto; }
  .hocthu-urgency { background-color: #FFF8F0; border-left: 4px solid #E8792B; padding: 1.5rem; border-radius: 8px; margin-top: 2rem; }
  .hocthu-urgency p { margin: 0; font-size: 0.95rem; line-height: 1.7; color: #1a1a1a; }
  @media (max-width: 768px) {
    .hocthu-grid { grid-template-columns: repeat(2, 1fr); }
    .hocthu-content__image { max-height: 280px; }
  }
  @media (max-width: 480px) {
    .hocthu-grid { grid-template-columns: 1fr; }
  }
</style>
