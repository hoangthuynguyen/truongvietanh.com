<!-- Bộ thu UTM dùng chung — BẮT BUỘC với mọi trang có form lead (CLAUDE.md).
     BaseLayout đã nạp sẵn ở <head>; giữ thêm dòng này để trang tự đứng được
     nếu layout đổi, và để lệnh tự kiểm `grep -c "va-utm.js"` chạy đúng. -->
<script src="/js/va-utm.js" is:inline></script>
<script is:inline>
(function () {
  'use strict';

  var C = {
    api: '/api/lead',
    formId: 'steame-2step',
    funnel: 'steame-hoc-thu',   // funnel_code RIÊNG của trang này → cột "Diễn giải nguồn MKT"
  };

  // Tuổi con → khối quan tâm trong Pancake (worker map qua KHOI_QUAN_TAM_MAP).
  var AGE_MAP = {
    '5 tuổi':  { level: 'mam-non',  grade: '5-tuoi' },
    '6 tuổi':  { level: 'tieu-hoc', grade: 'lop-1' },
    '7 tuổi':  { level: 'tieu-hoc', grade: 'lop-2' },
    '8 tuổi':  { level: 'tieu-hoc', grade: 'lop-3' },
    '9 tuổi':  { level: 'tieu-hoc', grade: 'lop-4' },
    '10 tuổi': { level: 'tieu-hoc', grade: 'lop-5' }
  };

  // Regex số điện thoại lấy nguyên từ form Pancake hiện tại của trường,
  // để trang này lọc số giống hệt các form cũ.
  var PHONE_RE = /^(\+84|84|0)(3([2-9])|5(2|5|6|8|9)|7(0|[6-9])|8([1-9])|9([0-4]|[6-9]))([0-9]{7})$/;

  // Lead một phần ở bước 1 KHÔNG bắn ngay, mà chờ 45 giây — hoặc bắn ngay khi
  // phụ huynh rời trang, tuỳ cái nào đến trước. Lý do:
  // Pancake TRÙNG SỐ ĐIỆN THOẠI thì từ chối (422 "already exists") và KHÔNG cập
  // nhật bản ghi cũ. Bắn ngay ở bước 1 → Pancake giữ bản ghi trống tên, rồi bản
  // đầy đủ (tên phụ huynh, cơ sở, buổi học) bị nuốt vì trùng số. Chờ 45 giây thì
  // ai điền xong (form tự nói "khoảng 30 giây") chỉ tạo ĐÚNG MỘT bản ghi đầy đủ,
  // còn ai bỏ dở vẫn để lại số cho đội tuyển sinh gọi — đúng mục đích tách 2 bước.
  var PARTIAL_DELAY_MS = 45000;
  var UTM = (window.__vaUTM ? window.__vaUTM() : {});
  var lead = {};
  var partial = { payload: null, sent: false, timer: null, bound: false };

  function $(id) { return document.getElementById(id); }
  function clean(v) { return (v || '').trim(); }
  function noop() {}

  function post(payload) {
    try {
      return fetch(C.api, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.assign(payload, UTM)),
        keepalive: true
      }).catch(noop);
    } catch (e) { return Promise.resolve(); }
  }

  // Gửi bản một phần đúng một lần. Khi trang đang đóng thì fetch hay bị huỷ giữa
  // chừng → dùng sendBeacon (cùng origin nên không vướng CORS).
  function flushPartial(closing) {
    if (!partial.payload || partial.sent) return;
    partial.sent = true;
    if (partial.timer) { clearTimeout(partial.timer); partial.timer = null; }
    var body = JSON.stringify(Object.assign({}, partial.payload, UTM));
    if (closing && navigator.sendBeacon) {
      try {
        navigator.sendBeacon(C.api, new Blob([body], { type: 'application/json' }));
        return;
      } catch (e) {}
    }
    try {
      fetch(C.api, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: body,
        keepalive: true
      }).catch(noop);
    } catch (e) {}
  }

  function armPartial(payload) {
    partial.payload = payload;
    partial.timer = setTimeout(function () { flushPartial(false); }, PARTIAL_DELAY_MS);
    if (partial.bound) return;
    partial.bound = true;
    window.addEventListener('pagehide', function () { flushPartial(true); });
    document.addEventListener('visibilitychange', function () {
      // Chỉ bắn khi trang bị ẩn hẳn ở cuối vòng đời (đóng tab / chuyển ứng dụng rồi
      // không quay lại). Trình duyệt sẽ gọi tiếp pagehide, nên đây là lưới an toàn.
      if (document.visibilityState === 'hidden' && document.readyState === 'complete') {
        // Chưa bắn vội: đợi thêm 8 giây, quay lại tab trong khoảng đó thì huỷ.
        if (partial.hideTimer) clearTimeout(partial.hideTimer);
        partial.hideTimer = setTimeout(function () { flushPartial(true); }, 8000);
      } else if (document.visibilityState === 'visible' && partial.hideTimer) {
        clearTimeout(partial.hideTimer);
        partial.hideTimer = null;
      }
    });
  }

  function gtm(evt, extra) {
    try {
      (window.dataLayer = window.dataLayer || []).push(
        Object.assign({ event: evt, form_id: C.formId, funnel_code: C.funnel }, extra || {}, UTM)
      );
    } catch (e) {}
  }

  $('se-next1').addEventListener('click', function () {
    var phone = clean($('se-phone').value).replace(/[\s.\-()]/g, '');
    var age = clean($('se-age').value);
    var err = $('se-err1');
    if (!phone) { err.textContent = 'Anh chị nhập giúp số điện thoại.'; $('se-phone').focus(); return; }
    if (!PHONE_RE.test(phone)) { err.textContent = 'Số điện thoại chưa đúng định dạng. Ví dụ: 0901234567'; $('se-phone').focus(); return; }
    if (!age) { err.textContent = 'Anh chị chọn giúp độ tuổi của con.'; $('se-age').focus(); return; }
    err.textContent = '';
    lead.phone = phone;
    lead.age = age;

    // Nạp sẵn lead một phần — đây là lý do form tách hai bước: có số điện thoại là
    // đã có lead, kể cả khi phụ huynh bỏ dở bước 2. Xem chú thích PARTIAL_DELAY_MS
    // ở trên để biết vì sao nó chờ chứ không bắn ngay.
    var m = AGE_MAP[age] || {};
    armPartial({
      phone: phone,
      school_level: m.level || '',
      grade: m.grade || '',
      note: 'STEAM-E · Con ' + age + ' · bỏ dở ở bước 2',
      form_id: C.formId,
      funnel_code: C.funnel,
      partial: true
    });
    gtm('lead_step1');

    $('se-step1').hidden = true;
    $('se-step2').hidden = false;
    $('se-pname').focus();
  });

  $('se-back2').addEventListener('click', function () {
    $('se-step2').hidden = true;
    $('se-step1').hidden = false;
    $('se-phone').focus();
  });

  $('se-submit2').addEventListener('click', function () {
    var name = clean($('se-pname').value);
    var campus = clean($('se-campus').value);
    var slot = clean($('se-slot').value);
    var err = $('se-err2');
    if (!name) { err.textContent = 'Anh chị cho biết tên để đội ngũ tiện xưng hô.'; $('se-pname').focus(); return; }
    if (!campus) { err.textContent = 'Anh chị chọn giúp cơ sở thuận tiện.'; $('se-campus').focus(); return; }
    if (!slot) { err.textContent = 'Anh chị chọn giúp buổi thuận tiện.'; $('se-slot').focus(); return; }
    err.textContent = '';

    // Huỷ bản một phần TRƯỚC khi gửi bản đầy đủ: nếu để nó bắn thì Pancake nhận
    // bản trống tên trước, rồi từ chối bản đầy đủ vì trùng số điện thoại.
    if (partial.timer) { clearTimeout(partial.timer); partial.timer = null; }
    if (partial.hideTimer) { clearTimeout(partial.hideTimer); partial.hideTimer = null; }
    partial.sent = true;

    var m = AGE_MAP[lead.age] || {};
    var btn = $('se-submit2');
    btn.disabled = true;
    btn.textContent = 'Đang gửi…';

    post({
      parent_name: name,
      phone: lead.phone,
      child_name: clean($('se-cname').value),
      school_level: m.level || '',
      grade: m.grade || '',
      province: campus,
      note: 'STEAM-E học thử · Con ' + (lead.age || 'chưa rõ tuổi') + ' · Cơ sở: ' + campus + ' · Buổi: ' + slot,
      form_id: C.formId,
      funnel_code: C.funnel
    }).then(function () {
      gtm('lead_submitted', { campus: campus });
      $('se-step2').hidden = true;
      $('se-done').hidden = false;
      $('se-done').scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  });

  $('se-phone').addEventListener('keydown', function (e) {
    if (e.key === 'Enter') { e.preventDefault(); $('se-next1').click(); }
  });
})();
</script>

<style>
  /* ===================================================================
     STEAM-E — kiểu dáng riêng của trang, giữ nguyên thiết kế bản gốc
     (nền sáng, Navy #26275D + Vàng #F9DD0E, nút vàng luôn chữ Navy).
     Mọi class đặt tiền tố .se- để không đụng bộ .gi-* dùng chung.
     Chữ dùng Inter theo font hệ thống của site, không nạp thêm font.
     =================================================================== */
  .se-page {
    --se-ground: #f1f2f7;
    --se-surface: #ffffff;
    --se-surface-2: #e8eaf3;
    --se-ink: #1a1b33;
    --se-ink-2: #4e5170;
    --se-ink-3: #83879f;
    --se-navy: #26275d;
    /* Đỏ CHỈ còn dùng cho báo lỗi trong form — nó là màu chức năng, đổi sang Navy
       thì người điền không nhận ra là lỗi. Mọi chỗ trang trí/tiêu đề đã về Navy + Vàng. */
    --se-red: #c8102e;
    --se-gold: #f9dd0e;
    --se-gold-soft: #fef7c2;
    --se-gold-line: #e3c400;
    --se-line: #dbdde9;
    --se-line-2: #c2c5d8;
    --se-seg1: #c7c8e6;
    --se-seg2: #9497d2;
    --se-seg3: #6b6ebb;
    --se-seg4: #454885;
    --se-seg5: #26275d;
    background: var(--se-ground);
    color: var(--se-ink);
  }
  .se-page article { font-size: 17px; line-height: 1.68; }
  .se-page p { margin: 0 0 17px; }
  /* Link theo đúng quy ước các trang trụ khác (.gi-section a trong global.css):
     chữ Navy, gạch chân màu vàng nhận diện. Bản dựng gốc để link màu đỏ #C8102E —
     màu đó không nằm trong nhận diện Trường Việt Anh nên đã bỏ khỏi trang. */
  .se-page a { color: var(--se-navy); font-weight: 600; text-decoration: underline; text-decoration-color: var(--se-gold); text-underline-offset: 3px; }
  .se-page a:hover { color: #1f2050; }
  .se-shell { max-width: 1080px; margin: 0 auto; padding: 0 22px; }
  .se-narrow { max-width: 680px; }
  .se-mt22 { margin-top: 22px; }
  .se-mt26 { margin-top: 26px; }
  .se-mt28 { margin-top: 28px; }
  .se-mt30 { margin-top: 30px; }
  .se-mt34 { margin-top: 34px; }
  .se-mb0 { margin-bottom: 0; }

  /* --- nút ---
     Bọc trong .se-page để thắng luật `.se-page a{color:red}` bên trên: nút vàng
     LUÔN phải chữ Navy theo nhận diện thương hiệu, kể cả khi nút là thẻ <a>. */
  .se-page .se-cta {
    display: inline-block; background: var(--se-gold); color: var(--se-navy);
    font-weight: 800; font-size: 1rem; letter-spacing: -0.01em; text-decoration: none;
    padding: 15px 28px; border-radius: 8px; border: 1px solid var(--se-gold-line);
    transition: transform 0.12s ease; font-family: inherit; cursor: pointer;
  }
  .se-page .se-cta:hover { transform: translateY(-1px); color: var(--se-navy); }
  .se-page .se-cta:disabled { opacity: 0.6; cursor: default; transform: none; }

  /* --- hero --- */
  .se-hero { padding: 44px 22px 8px; }
  .se-crumb { font-size: 0.88rem; color: var(--se-ink-3); margin-bottom: 20px; }
  .se-crumb a { color: var(--se-ink-2); text-decoration: none; }
  .se-crumb a:hover { text-decoration: underline; }
  .se-crumb span[aria-hidden] { margin: 0 6px; color: var(--se-line-2); }
  .se-eyebrow { font-size: 0.74rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--se-navy); margin: 0 0 18px; }
  .se-page h1 {
    font-size: clamp(2rem, 5.4vw, 3.2rem); font-weight: 800; letter-spacing: -0.035em;
    line-height: 1.08; margin: 0 0 26px; text-wrap: balance; max-width: 19ch; color: var(--se-ink);
  }
  .se-answer {
    background: var(--se-surface); border: 1px solid var(--se-line);
    border-left: 5px solid var(--se-gold); border-radius: 0 10px 10px 0;
    padding: 22px 26px; max-width: 62ch; margin: 0 0 26px;
  }
  .se-answer p { margin: 0; font-size: 1.05rem; font-weight: 500; }
  .se-herocta { display: flex; flex-wrap: wrap; gap: 14px 20px; align-items: center; margin-bottom: 40px; }
  .se-herocta .se-sub { font-size: 0.88rem; color: var(--se-ink-3); }

  /* --- dải thẻ --- */
  .se-strip { border-top: 1px solid var(--se-line); border-bottom: 1px solid var(--se-line); padding: 22px 22px 24px; }
  .se-lbl { font-size: 0.74rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--se-ink-3); margin: 0 0 12px; }
  .se-tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .se-tag { font-size: 0.85rem; background: var(--se-surface); border: 1px solid var(--se-line-2); color: var(--se-ink-2); padding: 5px 12px; border-radius: 99px; }

  /* --- mục --- */
  .se-sec { padding: 52px 0; }
  .se-sec.se-alt { background: var(--se-surface-2); }
  /* Tiêu đề mục: chữ Navy + gạch vàng bên dưới — đúng bộ nhận diện và khớp với
     .gi-section h2 của các trang trụ khác. inline-block để vạch vàng dừng đúng
     bề ngang chữ, không kéo dài hết cột. */
  .se-page h2 {
    font-size: clamp(1.5rem, 3.2vw, 2rem); font-weight: 800; letter-spacing: -0.028em;
    color: var(--se-navy); margin: 0 0 20px; text-wrap: balance; max-width: 24ch; line-height: 1.18;
    display: inline-block; padding-bottom: 0.5rem; border-bottom: 3px solid var(--se-gold);
  }
  .se-h3 { font-size: 1.08rem; font-weight: 700; color: var(--se-navy); margin: 32px 0 10px; }



  /* --- trích dẫn nổi & chú thích nhỏ --- */
  .se-pull {
    font-size: 1.24rem; line-height: 1.5; border-left: 4px solid var(--se-gold);
    padding: 6px 0 6px 22px; margin: 30px 0; color: var(--se-ink); font-weight: 600; max-width: 34ch;
  }
  .se-quotesrc { color: var(--se-ink-3); font-size: 0.9rem; margin-top: -14px; }
  .se-note { color: var(--se-ink-2); font-size: 0.95rem; }

  /* --- 3 điều chương trình giúp trẻ (mở bài) --- */
  .se-goals { margin: 0 0 17px; padding-left: 22px; }
  .se-goals li { margin-bottom: 6px; font-weight: 600; color: var(--se-navy); }

  /* --- 6 chữ cái --- */
  .se-letters { border-top: 1px solid var(--se-line); margin-top: 8px; }
  .se-letter { display: grid; grid-template-columns: 56px 220px minmax(0, 1fr); gap: 20px; align-items: baseline; padding: 16px 0; border-bottom: 1px solid var(--se-line); }
  .se-ch { font-size: 1.9rem; font-weight: 800; color: var(--se-navy); line-height: 1; letter-spacing: -0.03em; }
  .se-nm { font-weight: 700; font-size: 0.95rem; }
  .se-ds { color: var(--se-ink-2); font-size: 0.95rem; }





  /* --- chủ đề --- */
  .se-themes { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 16px; }
  .se-theme { background: var(--se-surface); border: 1px solid var(--se-line); border-radius: 10px; padding: 20px 22px; }
  /* Tên chủ đề mang màu nhận diện, dòng mô tả lùi về xám dịu — để hai dòng không
     cùng sắc độ mà dính vào nhau. */
  .se-thhd { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin: 0 0 4px; }
  .se-theme h3 { margin: 0; font-size: 1.05rem; font-weight: 800; letter-spacing: -0.015em; color: var(--se-navy); }
  /* Nhãn nhóm tuổi — thứ phụ huynh dò đầu tiên khi lướt 7 thẻ chủ đề. */
  .se-age {
    flex: none; font-size: 0.74rem; font-weight: 700; white-space: nowrap;
    color: var(--se-navy); background: var(--se-gold-soft);
    border: 1px solid var(--se-gold-line); border-radius: 99px; padding: 2px 9px;
  }
  .se-thsub { font-size: 0.86rem; color: var(--se-ink-2); font-weight: 500; margin: 0 0 14px; }
  .se-theme .se-tags { gap: 6px; }
  .se-theme .se-tag { font-size: 0.78rem; padding: 4px 10px; background: var(--se-surface-2); border-color: var(--se-line); }

  /* --- kết quả --- */
  .se-outs { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-top: 8px; }
  .se-out { display: grid; grid-template-columns: 38px minmax(0, 1fr); gap: 14px; align-items: start; }
  .se-onum { width: 34px; height: 34px; border-radius: 50%; background: var(--se-navy); color: #fff; display: grid; place-items: center; font-weight: 800; font-size: 0.92rem; }
  .se-out h3 { margin: 5px 0; font-size: 1rem; font-weight: 700; color: var(--se-ink); }
  .se-out p { font-size: 0.93rem; color: var(--se-ink-2); margin: 0; }



  /* --- cơ sở --- */
  .se-places { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-bottom: 26px; }
  .se-place { background: var(--se-surface); border: 1px solid var(--se-line); border-left: 4px solid var(--se-navy); border-radius: 0 10px 10px 0; padding: 20px 22px; }
  .se-place h3 { margin: 0 0 4px; font-size: 1.1rem; font-weight: 800; color: var(--se-ink); }
  .se-place p { margin: 0; font-size: 0.9rem; color: var(--se-ink-2); }
  .se-facts { border-top: 1px solid var(--se-line); margin: 0; }
  .se-fact { display: grid; grid-template-columns: 170px minmax(0, 1fr); gap: 18px; padding: 13px 0; border-bottom: 1px solid var(--se-line); font-size: 0.95rem; }
  .se-fact dt { font-weight: 700; color: var(--se-ink); }
  .se-fact dd { margin: 0; color: var(--se-ink-2); }

  /* --- ảnh thật chụp tại lớp ---
     Mọi ảnh đều 1400×933 (3:2). Đặt sẵn width/height để trình duyệt chừa đúng
     chỗ trước khi ảnh tải xong, không giật layout khi cuộn. */
  /* min() để cột không bao giờ rộng hơn khung chứa: trên máy 375px, minmax(340px)
     trơ trọi sẽ đẩy ảnh lòi 9px khỏi mép cột chữ. */
  .se-figs { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 20px; margin: 30px 0 0; }
  .se-figs--2 { grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr)); }
  .se-fig { margin: 0; }
  .se-fig img {
    width: 100%; height: auto; display: block; border-radius: 10px;
    border: 1px solid var(--se-line); background: var(--se-surface-2);
  }
  .se-fig figcaption { font-size: 0.86rem; line-height: 1.6; color: var(--se-ink-2); margin-top: 9px; }
