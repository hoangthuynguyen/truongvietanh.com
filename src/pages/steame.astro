// og-steame.webp cắt sẵn 1200×630 — đúng khổ Facebook/Zalo lấy làm ảnh xem trước.
const ogImage = 'https://truongvietanh.com/images/steame/og-steame.webp';
const IMG = (n: string) => `https://truongvietanh.com/images/steame/${n}.webp`;

// 6 câu FAQ — dùng CHUNG cho phần hiển thị và schema FAQPage, không chép tay hai lần.
const faqs = [
  {
    id: 'faq-chua-biet-lap-trinh',
    q: 'Con chưa biết lập trình hay làm thí nghiệm có học được không?',
    a: 'Hoàn toàn được. Chương trình không yêu cầu kiến thức đầu vào. Giáo viên hướng dẫn theo từng lứa tuổi, và nhà trường chuẩn bị sẵn toàn bộ dụng cụ thí nghiệm, vật liệu, bộ kit cùng phần mềm phù hợp. Gia đình không cần mua thêm robot hay thiết bị nào ở nhà.',
  },
  {
    id: 'faq-mot-cap-do-bao-lau',
    q: 'Một cấp độ học trong bao lâu?',
    a: 'Mỗi cấp độ gồm 30 giờ, chia thành 20 buổi, mỗi buổi 90 phút, học vào cuối tuần. Mỗi buổi có mục tiêu riêng và một mốc tiến độ của dự án, nên con luôn biết hôm nay mình cần hoàn thành phần nào chứ không học dàn trải.',
  },
  {
    id: 'faq-san-pham-con-lam-ra',
    q: 'Con sẽ làm ra sản phẩm gì?',
    a: 'Mỗi cấp độ con hoàn thành 1–3 dự án. Sản phẩm có thể là mô hình, báo cáo dữ liệu, video, poster hoặc pitch deck, tùy chủ đề con chọn. Cuối khóa con thuyết trình dự án của mình và trưng bày trong buổi triển lãm có phụ huynh tham dự.',
  },
  {
    id: 'faq-do-tuoi-phu-hop',
    q: 'Độ tuổi nào phù hợp với STEAM-E?',
    a: 'Chương trình dành cho trẻ 5–10 tuổi, chia hai nhóm. Nhóm 5–7 tuổi học bốn chủ đề Habitat Harmony, Rocket to Reality, Disaster on Screen và NextGen Pioneers. Nhóm 8–10 tuổi học ba chủ đề Ha Giang to Ca Mau, EcoArt Revival và SteamE at Home. Đề tài, dụng cụ và mức độ hướng dẫn được điều chỉnh theo từng nhóm. Nếu chưa chắc con nên vào chủ đề nào, anh chị có thể đăng ký một buổi tư vấn để đội ngũ xếp đúng cấp độ.',
  },
  {
    id: 'faq-giup-gi-cho-mon-tren-lop',
    q: 'STEAM-E giúp ích thế nào cho môn học trên lớp?',
    a: 'Con dùng ngay kiến thức Toán, Lý, Hóa, Sinh và Nghệ thuật đang học để giải quyết một vấn đề có thật. Khi kiến thức được dùng vào việc cụ thể, con hiểu bản chất sâu hơn và nhớ lâu hơn, nhờ đó tiến bộ tự nhiên ở các môn chính khóa thay vì phải luyện thêm đề.',
  },
  {
    id: 'faq-hoc-o-dau',
    q: 'STEAM-E học ở đâu?',
    a: 'Chương trình dạy trực tiếp tại các cơ sở Trường Việt Anh ở TP. Hồ Chí Minh và Rạch Giá, học vào cuối tuần, ca sáng hoặc ca chiều tùy từng cơ sở. Không có lớp online, vì con cần thao tác thật với vật liệu và dụng cụ thật.',
  },
];

const description =
  'STEAM-E của Trường Việt Anh: học qua dự án cho trẻ 5–10 tuổi tại TP.HCM và Rạch Giá. 30 giờ mỗi cấp độ, con tự làm 1–3 dự án giải quyết vấn đề đời sống thật.';

const structuredData = [
