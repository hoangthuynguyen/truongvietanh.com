    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: 'STEAM-E là gì? Chương trình dự án thực tế cho trẻ 5–10 tuổi',
    description,
    inLanguage: 'vi-VN',
    dateModified: NGAY_CAP_NHAT,
    primaryImageOfPage: { '@type': 'ImageObject', url: ogImage, width: 1200, height: 630 },
    image: [
      IMG('lop-hoc-che-tao'),
      IMG('mo-hinh-khu-pho'),
      IMG('mo-hinh-co-the-cong-vien'),
      IMG('mo-hinh-nha-va-xe'),
      IMG('ca-lop-khoe-san-pham'),
    ],
    isPartOf: { '@id': 'https://truongvietanh.com/#organization' },
    mainEntity: { '@id': `${canonical}#course` },
    audience: {
      '@type': 'Audience',
      audienceType: 'Phụ huynh có con 5–10 tuổi tại TP. Hồ Chí Minh và Rạch Giá',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    '@id': `${canonical}#course`,
    name: 'STEAM-E — Chương trình học qua dự án cho trẻ 5–10 tuổi',
    description:
      'Chương trình học qua dự án của Trường Việt Anh cho trẻ 5–10 tuổi tại TP. Hồ Chí Minh và Rạch Giá, kết hợp Khoa học, Công nghệ, Kỹ thuật, Nghệ thuật, Toán và Khởi nghiệp. Mỗi cấp độ 30 giờ, 20 buổi cuối tuần, mỗi buổi 90 phút.',
    inLanguage: 'vi-VN',
    url: canonical,
    educationalLevel: 'Mầm non lớn – Tiểu học',
    teaches: [
      'Tư duy giải quyết vấn đề',
      'Học liên môn STEAM',
      'Tư duy khởi nghiệp',
      'Thuyết trình và làm việc nhóm',
    ],
    typicalAgeRange: '5-10',
    image: [IMG('lop-hoc-che-tao'), IMG('mo-hinh-khu-pho'), IMG('ca-lop-khoe-san-pham')],
    provider: { '@id': 'https://truongvietanh.com/#organization' },
