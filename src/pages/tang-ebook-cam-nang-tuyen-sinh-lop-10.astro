---
import SqueezePageLayout from '../layouts/SqueezePageLayout.astro';
import USPGrid from '../components/USPGrid.astro';
import TrustMetrics from '../components/TrustMetrics.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import FAQSection from '../components/FAQSection.astro';

const pageTitle = 'Ebook Cẩm Nang Tuyển Sinh Lớp 10 TP.HCM 2026–2027 — Tặng MIỄN PHÍ | Trường Việt Anh';
const pageDescription = 'Tải MIỄN PHÍ Ebook 9 chủ đề + Bảng tự đánh giá năng lực cho phụ huynh & học sinh lớp 9 thi vào lớp 10 TP.HCM 2026–2027. Quy chế thi, điểm cộng, chiến lược 3 nguyện vọng, lộ trình ôn 3 giai đoạn, tâm lý mùa thi.';
const pageCanonical = 'https://truongvietanh.com/tang-ebook-cam-nang-tuyen-sinh-lop-10';
const funnelCode = 'squeeze-ebook-tuyen-sinh-lop-10';

const uspItems = [
  { icon: '📋', text: 'Hiểu đúng quy chế thi 2026–2027 — 3 môn Toán/Văn/Anh, ngày 1–2/6/2026, ts10.hcm.edu.vn, 151.000 thí sinh' },
  { icon: '➕', text: 'Cách tính điểm & điểm cộng ưu tiên — tối đa cộng 3,5 điểm, đủ quyết định đỗ/rớt' },
  { icon: '🎯', text: 'Chiến lược chọn 3 nguyện vọng — công thức "ước mơ – vừa sức – an toàn", khoảng cách ≥1,5 điểm' },
  { icon: '📅', text: 'Lộ trình ôn 3 giai đoạn — củng cố nền tảng → luyện chuyên đề → luyện đề & về đích' },
  { icon: '✍️', text: 'Kỹ năng làm bài 3 môn — phân bổ thời gian, thứ tự câu, cấu trúc bài, 1–2 điểm cuối' },
  { icon: '🧘', text: 'Tâm lý vững vàng mùa thi — kỹ thuật thở 4-7-8, nhật ký 3 dòng, dấu hiệu stress cần nhận biết' },
  { icon: '💻', text: 'Quy trình đăng ký trực tuyến — 10 bước trên ts10.hcm.edu.vn, mốc thời gian, lưu ý đóng cổng 17h' },
  { icon: '🛡️', text: 'Kịch bản dự phòng — xét tuyển bổ sung GĐ2, trường tư thục, GDTX, trường nghề 9+' },
  { icon: '📊', text: 'Bảng tự đánh giá 9 chủ đề — chấm 1–5 điểm, biết gia đình đang ở đâu trong hành trình chuẩn bị' }
];

const metrics = [
  { number: '9', label: 'Chủ đề chiến lược cho phụ huynh & học sinh' },
  { number: '151.000', label: 'Thí sinh thi lớp 10 TP.HCM 2026–2027' },
  { number: '3,5', label: 'Điểm cộng tối đa cần biết để tận dụng' },
  { number: '15+', label: 'Năm Việt Anh đồng hành tuyển sinh lớp 10' }
];

const faqItems = [
  { question: 'Ebook này phù hợp cho ai?', answer: 'Phụ huynh và học sinh lớp 9 chuẩn bị thi vào lớp 10 công lập TP.HCM năm học 2026–2027. Đặc biệt hữu ích cho gia đình lần đầu có con thi chuyển cấp, chưa nắm rõ quy chế, cách tính điểm và chiến lược nguyện vọng.' },
  { question: 'Ebook gồm những gì?', answer: 'Tài liệu PDF 9 trang gồm: (1) Tổng quan kỳ thi 2026–2027; (2) 9 chủ đề chiến lược — mỗi chủ đề có 3 phần "Tại sao quan trọng / Việt Anh giúp thế nào / Câu hỏi tự đánh giá"; (3) Bảng tự đánh giá tổng 45 điểm để xác định gia đình đang ở giai đoạn nào; (4) Lộ trình đồng hành lớp 9 chia 4 giai đoạn theo tháng.' },
  { question: 'Tài liệu có miễn phí không?', answer: 'Hoàn toàn miễn phí, không cam kết. Đây là tài liệu Trường Việt Anh biên soạn từ 15+ năm kinh nghiệm tuyển sinh lớp 10 tại TP.HCM, chia sẻ để hỗ trợ phụ huynh trong giai đoạn quyết định.' },
  { question: 'Tôi nhận ebook bằng cách nào?', answer: 'Có 2 cách: (1) Điền email để nhận qua mail trong vài phút — kèm tư vấn cá nhân hóa lộ trình cho con qua Zalo; (2) Tải PDF trực tiếp ngay không cần đăng ký (link bên dưới form).' },
  { question: 'Sau khi nhận ebook tôi có được tư vấn không?', answer: 'Có. Trong 24h, chuyên viên Việt Anh sẽ liên hệ qua Zalo để tư vấn 1-1 miễn phí 60 phút: đánh giá năng lực hiện tại của con, gợi ý chiến lược 3 nguyện vọng dựa trên điểm thi thử và lịch sử điểm chuẩn 3 năm gần nhất, lộ trình ôn phù hợp.' },
  { question: 'Việt Anh đồng hành lớp 10 thế nào?', answer: 'Lộ trình 4 giai đoạn: HK1 lớp 9 (củng cố nền tảng + định hướng nghề nghiệp) → HK2 lớp 9 (luyện chuyên đề + thi thử 2 tuần/lần + workshop tâm lý) → Tháng 5–6 (luyện đề + diễn tập ngày thi thử + đồng hành đến cửa phòng thi) → Tháng 7–8 (tư vấn nhập học + kịch bản dự phòng nếu cần).' }
];
---

<SqueezePageLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={pageCanonical}
  schoolLevel="thpt"
  funnelCode={funnelCode}
>
  <section slot="hero">
    <span class="squeeze-hero__badge">🎁 MIỄN PHÍ — Tài liệu chính thức Trường Việt Anh</span>
    <h1 class="squeeze-hero__heading">Ebook Cẩm Nang Tuyển Sinh Lớp 10 TP.HCM 2026–2027</h1>
    <p class="squeeze-hero__sub">Hành trang đầy đủ cho kỳ thi chuyển cấp — 9 chủ đề chiến lược + Bảng tự đánh giá năng lực. Dành cho phụ huynh & học sinh lớp 9 chuẩn bị thi lớp 10 công lập TP.HCM (151.000 thí sinh, ngày 1–2/6/2026).</p>
  </section>

  <section slot="usp"><USPGrid title="Trong ebook có gì?" items={uspItems} /></section>
  <section slot="trust"><TrustMetrics title="Vì sao phụ huynh cần ebook này" metrics={metrics} /></section>

  <section slot="content">
    <div class="ebook-content">
      <h2 class="ebook-title">Vì sao kỳ thi lớp 10 TP.HCM 2026–2027 là bước ngoặt?</h2>
      <p class="ebook-lead">
        Nhiều phụ huynh chuẩn bị cho con thi lớp 10 chỉ tập trung vào: <em>"Con học môn nào yếu?"</em> và <em>"Trường nào điểm chuẩn cao?"</em>. Nhưng kỳ thi lớp 10 đòi hỏi cả <strong>chiến lược chọn nguyện vọng đúng</strong>, <strong>lộ trình ôn tập khoa học</strong> và <strong>tâm lý vững vàng</strong> — 9 chủ đề được bóc tách chi tiết trong ebook.
      </p>

      <div class="ebook-grid">
        <div class="ebook-card">
          <span class="ebook-card__num">01</span>
          <h3>Hiểu đúng quy chế thi</h3>
          <p>Đến muộn 15 phút = mất quyền dự thi buổi đó. Bài thi điểm 0 = mất quyền xét tuyển dù tổng điểm cao. Mang sai vật dụng = đình chỉ thi.</p>
        </div>
        <div class="ebook-card">
          <span class="ebook-card__num">02</span>
          <h3>Cách tính điểm & điểm cộng</h3>
          <p>Cộng tối đa 3,5 điểm — đủ quyết định đỗ/rớt. Diện ưu tiên: con liệt sĩ (+2,0), thương binh (+1,5), dân tộc thiểu số (+1,0), giải HSG cấp tỉnh/thành.</p>
        </div>
        <div class="ebook-card">
          <span class="ebook-card__num">03</span>
          <h3>Chiến lược 3 nguyện vọng</h3>
          <p>Hàng nghìn HS giỏi rớt cả 3 NV mỗi năm vì chọn sai. Công thức: NV1 cao hơn năng lực – NV2 vừa sức – NV3 an toàn, khoảng cách ≥1,5 điểm.</p>
        </div>
        <div class="ebook-card">
          <span class="ebook-card__num">04</span>
          <h3>Lộ trình ôn 3 giai đoạn</h3>
          <p>9–12 tháng chia 3 giai đoạn: củng cố nền tảng → luyện chuyên đề → luyện đề & về đích. Ôn không lộ trình = chạy marathon không chiến thuật.</p>
        </div>
        <div class="ebook-card">
          <span class="ebook-card__num">05</span>
          <h3>Kỹ năng làm bài thi</h3>
          <p>"Biết làm" khác "kịp làm". Toán: dễ trước–khó sau. Văn: cấu trúc 3-4-3. Anh: đoán nghĩa từ ngữ cảnh. Phân bổ thời gian quyết định 1–2 điểm cuối.</p>
        </div>
        <div class="ebook-card">
          <span class="ebook-card__num">06</span>
          <h3>Tâm lý vững vàng</h3>
          <p>Stress mùa thi khiến HS làm bài kém hơn năng lực 1–2 điểm. Kỹ thuật thở 4-7-8, nhật ký 3 dòng, dấu hiệu mất ngủ/cáu kỉnh/sụt cân cần nhận biết.</p>
        </div>
        <div class="ebook-card">
          <span class="ebook-card__num">07</span>
          <h3>Đăng ký trực tuyến</h3>
          <p>Toàn bộ trên ts10.hcm.edu.vn — đóng cổng 17h, không gia hạn. Quy trình 10 bước. Sai một thao tác có thể trả giá đắt.</p>
        </div>
        <div class="ebook-card">
          <span class="ebook-card__num">08</span>
          <h3>Kịch bản dự phòng</h3>
          <p>"Kế hoạch B" cho trường hợp không trúng 3 NV: xét tuyển bổ sung GĐ2, trường tư thục, GDTX, trường nghề 9+, ôn thi lại.</p>
        </div>
        <div class="ebook-card">
          <span class="ebook-card__num">09</span>
          <h3>Đồng hành của phụ huynh</h3>
          <p>Khác các kỳ thi khác, lớp 10 cần phụ huynh tham gia THỰC SỰ. Tránh: so sánh "con nhà người ta", áp đặt NV, thưởng/phạt theo điểm.</p>
        </div>
      </div>

      <div class="ebook-urgency">
        <p><strong>⚠️ Kỳ thi đầu tiên sau sáp nhập:</strong> 2026–2027 có khoảng <strong>151.000 thí sinh</strong> — quy mô lớn nhất từ trước đến nay. Mức cạnh tranh tăng đáng kể, đòi hỏi phụ huynh chuẩn bị sớm và đúng hướng cho con.</p>
      </div>

      <h2 class="ebook-title ebook-title--small">Lộ trình đồng hành lớp 10 tại Việt Anh</h2>
      <div class="ebook-timeline">
        <div class="ebook-timeline__item">
          <div class="ebook-timeline__period">Lớp 9 — HK1<br/><span>Tháng 9–12</span></div>
          <div class="ebook-timeline__body"><strong>Củng cố nền tảng</strong> Toán-Văn-Anh lớp 8 và 9. Đánh giá năng lực đầu năm. Buổi tư vấn định hướng nghề nghiệp cho phụ huynh & học sinh.</div>
        </div>
        <div class="ebook-timeline__item">
          <div class="ebook-timeline__period">Lớp 9 — HK2<br/><span>Tháng 1–4</span></div>
          <div class="ebook-timeline__body"><strong>Luyện chuyên đề & nâng cao.</strong> Thi thử 2 tuần/lần với đề chuẩn cấu trúc Sở. Tư vấn chọn nguyện vọng 1-1. Workshop tâm lý.</div>
        </div>
        <div class="ebook-timeline__item">
          <div class="ebook-timeline__period">Nước rút<br/><span>Tháng 5–6</span></div>
          <div class="ebook-timeline__body"><strong>Luyện đề & về đích.</strong> Hỗ trợ đăng ký nguyện vọng. Diễn tập "ngày thi thử". Sinh hoạt tâm lý trước kỳ thi 1 tuần. Đồng hành đến cửa phòng thi.</div>
        </div>
        <div class="ebook-timeline__item">
          <div class="ebook-timeline__period">Sau thi<br/><span>Tháng 7–8</span></div>
          <div class="ebook-timeline__body"><strong>Tư vấn nhập học & kịch bản dự phòng.</strong> Hỗ trợ thủ tục xác nhận. Tư vấn xét tuyển bổ sung. Kết nối trường tư thục/nghề chất lượng.</div>
        </div>
      </div>
    </div>
  </section>

  <section slot="form">
    <div class="chon-form-intro">
      <h2 class="squeeze-form-section__heading">Tặng Ebook MIỄN PHÍ qua email</h2>
      <p class="squeeze-form-section__description">Điền email — Việt Anh gửi ebook PDF trong vài phút + tư vấn 1-1 lộ trình lớp 10 cho con qua Zalo.</p>
      <ul class="chon-checklist">
        <li>✓ Ebook 9 chủ đề chiến lược (PDF 9 trang)</li>
        <li>✓ Bảng tự đánh giá 45 điểm</li>
        <li>✓ Lộ trình đồng hành lớp 9 — 4 giai đoạn</li>
        <li>✓ Bonus: Tư vấn 1-1 chọn nguyện vọng MIỄN PHÍ</li>
      </ul>
    </div>
    <LeadFormTwoStepEmailFirst
      formId="tang-ebook-lop10-form"
      funnelCode={funnelCode}
      schoolLevel="thpt"
      submitText="Nhận Ebook miễn phí ngay"
      successMessage="Cảm ơn Ba/Mẹ! Ebook đang được gửi vào email..."
    />

    <div class="chon-direct-dl">
      <p>Hoặc tải trực tiếp không cần đăng ký:</p>
      <a href="/downloads/Ebook-Cam-Nang-Tuyen-Sinh-Lop-10.pdf" class="chon-direct-dl__btn" download="Ebook-Cam-Nang-Tuyen-Sinh-Lop-10-VietAnh.pdf">
        📥 Tải Ebook PDF ngay (128 KB)
      </a>
    </div>
  </section>

  <section slot="faq"><FAQSection title="Câu hỏi thường gặp" items={faqItems} /></section>
</SqueezePageLayout>

<style is:inline>
.ebook-content{max-width:1000px;margin:0 auto}
.ebook-title{font-family:Montserrat,sans-serif;font-size:1.75rem;font-weight:800;margin-bottom:1rem;color:#000080;text-align:center;line-height:1.3}
.ebook-title--small{font-size:1.5rem;margin-top:2.5rem}
.ebook-lead{font-size:1.05rem;line-height:1.7;color:#2d2d42;text-align:center;max-width:780px;margin:0 auto 2rem}
.ebook-lead em{font-style:italic;color:#5a5a70}
.ebook-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1rem;margin:1.5rem 0}
.ebook-card{position:relative;background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:1.5rem 1.25rem 1.25rem;transition:border-color .2s,transform .2s,box-shadow .2s}
.ebook-card:hover{border-color:#ffff00;transform:translateY(-3px);box-shadow:0 8px 20px rgba(0,0,128,.08)}
.ebook-card__num{position:absolute;top:.75rem;right:1rem;font-family:Montserrat,sans-serif;font-size:1.5rem;font-weight:800;color:rgba(0,0,128,.12);letter-spacing:-1px}
.ebook-card h3{font-family:Montserrat,sans-serif;font-size:1.1rem;font-weight:700;margin:0 0 .5rem;color:#000080;line-height:1.35;padding-right:2.5rem}
.ebook-card p{font-size:.95rem;line-height:1.6;color:#2d2d42;margin:0}
.ebook-urgency{background:rgba(255,255,0,.14);border-left:4px solid #ffff00;padding:1.1rem 1.4rem;border-radius:8px;margin:2rem 0 1rem}
.ebook-urgency p{margin:0;font-size:1rem;line-height:1.65;color:#1a1a2e}
.ebook-urgency strong{color:#000080}
.ebook-timeline{display:flex;flex-direction:column;gap:.85rem;margin-top:1.5rem}
.ebook-timeline__item{display:grid;grid-template-columns:140px 1fr;gap:1rem;background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:1rem 1.25rem;align-items:start}
.ebook-timeline__period{font-family:Montserrat,sans-serif;font-weight:800;color:#000080;font-size:.95rem;line-height:1.3;border-right:2px solid #ffff00;padding-right:1rem}
.ebook-timeline__period span{display:block;font-weight:500;font-size:.82rem;color:#5a5a70;margin-top:.2rem}
.ebook-timeline__body{font-size:.95rem;line-height:1.6;color:#2d2d42}
.ebook-timeline__body strong{color:#000080}
@media(max-width:768px){.ebook-grid{grid-template-columns:1fr}.ebook-timeline__item{grid-template-columns:1fr;gap:.5rem}.ebook-timeline__period{border-right:none;border-bottom:2px solid #ffff00;padding:0 0 .5rem}.ebook-title{font-size:1.5rem}}
</style>

<script is:inline>
(function(){
  var formEl=document.querySelector('#tang-ebook-lop10-form-squeeze-ebook-tuyen-sinh-lop-10');
  if(!formEl) return;
  var obs=new MutationObserver(function(){
    var success=formEl.querySelector('.form-step[data-step="success"]');
    if(success && !success.hidden){
      var nameInput=formEl.querySelector('input[name="parent_name"]');
      var n=nameInput?nameInput.value:'';
      setTimeout(function(){
        window.location.href='/cam-on?name='+encodeURIComponent(n);
      },1500);
      obs.disconnect();
    }
  });
  obs.observe(formEl,{attributes:true,subtree:true,attributeFilter:['hidden']});
})();
</script>
