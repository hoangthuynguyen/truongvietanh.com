<script is:inline>
  (function(){
    var p = new URLSearchParams(window.location.search);
    var n = p.get('name');
    if (n) document.getElementById('parentName').textContent = ' ' + n.trim().split(/\s+/).pop();

    // Auto-trigger download after 1.5s
    var dlBtn = document.getElementById('dlBtn');
