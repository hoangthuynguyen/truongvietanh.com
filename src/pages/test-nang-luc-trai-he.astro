---
import SqueezePageLayout from '../layouts/SqueezePageLayout.astro';
import USPGrid from '../components/USPGrid.astro';
import TrustMetrics from '../components/TrustMetrics.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import FAQSection from '../components/FAQSection.astro';

const pageTitle = "Test Năng Lực Miễn Phí — Xếp Lớp Trại Hè Lion Camp 2026 | Trường Việt Anh";
const pageDescription = "Làm bài test năng lực tiếng Anh + tư duy miễn phí để xếp lớp phù hợp và xét học bổng Early Bird cho Trại Hè Lion Camp 2026.";
const pageCanonical = "https://truongvietanh.com/test-nang-luc-trai-he";

const uspItems = [
    {
      "icon": "🆓",
      "text": "Test năng lực hoàn toàn miễn phí — không điều kiện"
    },
    {
      "icon": "🎯",
      "text": "Kết quả xếp lớp phù hợp — Starter / Explorer / Leader / Champion"
    },
    {
      "icon": "🏆",
      "text": "Test sớm xét học bổng Early Bird giảm tới 30% học phí trại hè"
    },
    {
      "icon": "⏱️",
      "text": "Bài test ngắn 30 phút — làm online hoặc tại trường"
    },
    {
      "icon": "📊",
      "text": "Nhận báo cáo đánh giá năng lực chi tiết gửi qua email"
    },
    {
      "icon": "👨‍🏫",
      "text": "Chuyên gia tư vấn lộ trình học hè phù hợp dựa trên kết quả test"
    }
  ];

const metrics = [
  { number: '15+', label: 'Năm kinh nghiệm giáo dục song ngữ' },
  { number: '3,000+', label: 'Học sinh đã và đang theo học' },
  { number: '95%', label: 'Phụ huynh hài lòng & giới thiệu bạn bè' },
  { number: '9', label: 'Cơ sở tại TP.HCM, Long An, Kiên Giang' },
];

const faqItems = [
    {
      "question": "Bài test năng lực gồm những phần nào?",
      "answer": "Bài test 30 phút gồm: Tiếng Anh giao tiếp (nghe hiểu + từ vựng + ngữ pháp cơ bản theo CEFR), Toán tư duy (logic + giải toán tình huống) và Kỹ năng mềm (team work, sáng tạo). Phù hợp từ lớp 1 đến lớp 12."
    },
    {
      "question": "Kết quả test được sử dụng như thế nào?",
      "answer": "Kết quả xác định lớp phù hợp trong 4 cấp: Starter (nền tảng), Explorer (phát triển), Leader (nâng cao), Champion (thi đấu). Đảm bảo con học với các bạn cùng trình độ và phát triển tốt nhất."
    },
    {
      "question": "Test sớm có lợi gì?",
      "answer": "Học sinh đăng ký test trước 30/4/2026 được ưu tiên xét học bổng Early Bird giảm 30% học phí. Ngoài ra còn được giữ chỗ lớp phù hợp — các lớp Charter thường đầy trước 2–3 tháng khai giảng."
    },
    {
      "question": "Làm test online được không?",
      "answer": "Được. Trường gửi link bài test sau khi đăng ký, con làm tại nhà trong 30 phút có giám sát webcam nhẹ. Phụ huynh có thể chọn làm tại trường nếu muốn trải nghiệm môi trường lớp học thực tế."
    },
    {
      "question": "Sau test có nhất thiết đăng ký trại hè không?",
      "answer": "Không bắt buộc. Test năng lực là dịch vụ độc lập. Kết quả sẽ được gửi đến phụ huynh dù có đăng ký Lion Camp hay không. Phụ huynh có thể dùng kết quả để tham khảo cho các chương trình học hè khác."
    }
  ];
---

<SqueezePageLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={pageCanonical}
  schoolLevel="tieu-hoc"
  funnelCode="test-nang-luc-trai-he"
>
  <section slot="hero">
    <h1 class="squeeze-hero__heading">Test Năng Lực Miễn Phí — Xếp Lớp Trại Hè Lion Camp 2026</h1>
    <p class="squeeze-hero__subheading">Làm bài test 30 phút để xếp lớp phù hợp và xét học bổng Early Bird giảm tới 30% học phí. Hoàn toàn miễn phí.</p>
  </section>

  <section slot="usp"><USPGrid title="Test năng lực mang lại gì?" items={uspItems} /></section>
  <section slot="trust"><TrustMetrics title="Trường Việt Anh trong số liệu" metrics={metrics} /></section>

  <section slot="content">
    <div class="page-content">
      <h2>Xếp lớp đúng — Con học hiệu quả hơn</h2>
      <p>Trại Hè Lion Camp 2026 tổ chức <strong>bài test năng lực miễn phí</strong> để xếp lớp phù hợp cho từng học sinh. Việc học đúng trình độ giúp con tự tin, tiến bộ nhanh và có trải nghiệm học hè tích cực nhất.</p>
      <p>Bài test ngắn 30 phút đánh giá <strong>Tiếng Anh + Toán tư duy + Kỹ năng mềm</strong>, phù hợp cho học sinh từ lớp 1 đến lớp 12. Kết quả được phân tích bởi chuyên gia và gửi báo cáo chi tiết cho phụ huynh.</p>
      <p><strong>Đăng ký test trước 30/4/2026</strong> để được ưu tiên xét học bổng Early Bird và giữ chỗ lớp phù hợp — các lớp Charter thường đầy trước 2–3 tháng.</p>
    </div>
  </section>

  <section slot="form">
    <h2 class="squeeze-form-section__heading">Đăng ký test năng lực miễn phí</h2>
    <p class="squeeze-form-section__description">Làm test online hoặc tại trường. Nhận kết quả và báo cáo năng lực trong 24h.</p>
    <LeadFormTwoStepEmailFirst
      formId="test-nang-luc-trai-he-form"
      funnelCode="test-nang-luc-trai-he"
      schoolLevel="tieu-hoc"
      submitText="Đăng ký test miễn phí"
      successMessage="Cảm ơn! Đội tuyển sinh sẽ gửi link test trong 2 tiếng."
    />
  </section>

  <section slot="faq"><FAQSection title="Câu hỏi thường gặp" items={faqItems} /></section>
</SqueezePageLayout>

<style is:inline>
  .page-content { max-width: 800px; margin: 0 auto; padding: 1rem 0; }
  .page-content h2 { color: #1a1a5e; font-size: 1.6rem; margin-bottom: 1rem; text-align: center; }
  .page-content p { font-size: 1rem; line-height: 1.75; color: #333; margin-bottom: 1rem; }
  .page-content ul { margin: 1rem 0 1rem 1.5rem; }
  .page-content li { margin-bottom: .5rem; line-height: 1.7; }
  .page-content strong { color: #1a1a5e; font-weight: 700; }
</style>
