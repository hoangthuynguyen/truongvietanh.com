---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "THCS Việt Anh",
    "url": "https://truongvietanh.com/thcs",
    "description": "THCS Việt Anh – bứt phá không lệch hướng, dẫn dắt tuổi dậy thì đúng cách.",
    "address": { "@type": "PostalAddress", "addressLocality": "Hồ Chí Minh", "addressCountry": "VN" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Tuổi dậy thì có nên quản chặt không?", "acceptedAnswer": { "@type": "Answer", "text": "Không. Cần dẫn dắt thay vì kiểm soát để học sinh hợp tác và trưởng thành." } },
      { "@type": "Question", "name": "Con đang nghiện điện thoại thì sao?", "acceptedAnswer": { "@type": "Answer", "text": "Cần dạy cách sử dụng công nghệ đúng, không chỉ cấm đoán." } },
      { "@type": "Question", "name": "Làm sao để con nghe lời hơn?", "acceptedAnswer": { "@type": "Answer", "text": "Khi con được hiểu và được tôn trọng, con sẽ hợp tác hơn tự nhiên." } },
      { "@type": "Question", "name": "Trường khác gì so với nơi khác?", "acceptedAnswer": { "@type": "Answer", "text": "Tập trung vào phát triển con người toàn diện, không chỉ học lực và điểm số." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://truongvietanh.com" },
      { "@type": "ListItem", "position": 2, "name": "THCS", "item": "https://truongvietanh.com/thcs" }
    ]
  }
];
---

<BaseLayout
  title="THCS Việt Anh – Bứt Phá Không Lệch Hướng"
  description="THCS Việt Anh: dẫn dắt tuổi dậy thì đúng cách — phát triển bản lĩnh, tự chủ và định hướng. Không kiểm soát, không bỏ lỏng."
  canonical="https://truongvietanh.com/thcs"
  ogImage="https://media.truongvietanh.com/images/thuyet-trinh-09.webp"
  noPopup={true}
  structuredData={structuredData}
>
  <div class="pp-page">
    <HeaderBase />

    <!-- BLOCK 1: HERO -->
    <section class="pp-hero">
      <div class="pp-hero-inner">
        <h1 class="pp-h1">
          Tuổi dậy thì không phải là giai đoạn<br />"khó bảo"
          <span class="pp-h1-accent">mà là giai đoạn quyết định con bạn sẽ<br />đi theo hướng nào</span>
        </h1>
        <p class="pp-subtitle">
          THCS là lúc học sinh thay đổi mạnh nhất về cảm xúc, hành vi và suy nghĩ. Nếu không được dẫn dắt đúng, đây có thể là giai đoạn lệch hướng. Nhưng nếu được đồng hành đúng cách, đây lại là bước đệm để con bứt phá.
        </p>
        <div class="pp-cta-row">
          <a href="#pp-form" class="pp-btn pp-btn-gold">Nhận brochure →</a>
          <a href="https://zalo.me/1678310120468101523" target="_blank" rel="noopener" class="pp-btn pp-btn-outline">Chat ngay →</a>
        </div>
      </div>
    </section>

    <!-- BLOCK 2: RICH TEXT -->
    <section class="pp-richtext">
      <div class="pp-richtext-inner">
        <h2>Vấn đề không phải là tuổi dậy thì<br/>mà là không có người dẫn dắt đúng</h2>
        <p>Rất nhiều phụ huynh bắt đầu lo lắng khi con vào THCS: con thay đổi tính cách, ít chia sẻ hơn, dễ bị ảnh hưởng bởi bạn bè, dành nhiều thời gian cho điện thoại.</p>
        <div class="pp-callout">Phản ứng phổ biến: siết chặt hơn, ép học nhiều hơn, hoặc buông lỏng — nhưng cả ba đều không hiệu quả</div>
        <p>Thực tế: <strong>đây không phải là "vấn đề cần xử lý"</strong> — mà là giai đoạn năng lượng phát triển mạnh nhất của con. Học sinh muốn khẳng định bản thân, muốn được công nhận, bắt đầu tìm kiếm "mình là ai".</p>
        <div class="pp-callout">Nếu được dẫn dắt đúng: trưởng thành nhanh hơn, có bản lĩnh hơn, và bắt đầu có định hướng</div>
      </div>
    </section>

    <!-- BLOCK 3: STATS -->
    <section class="pp-stats">
      <div class="pp-stats-inner">
        <h2>THCS là giai đoạn biến đổi mạnh nhất</h2>
        <div class="pp-stats-cols">
          <div class="pp-stats-col">
            <h3>Nếu không được định hướng…</h3>
            <ul>
              <li>Dễ lệch hành vi và mất kiểm soát</li>
              <li>Khó quay lại quỹ đạo sau này</li>
              <li>Phụ thuộc và không có mục tiêu</li>
            </ul>
          </div>
          <div class="pp-stats-col">
            <h3>Nếu được dẫn dắt đúng…</h3>
            <ul>
              <li>Phát triển bản lĩnh từ bên trong</li>
              <li>Tự chủ và trưởng thành sớm hơn</li>
              <li>Bắt đầu có định hướng rõ ràng</li>
            </ul>
          </div>
        </div>
        <p style="text-align:center;margin-top:1.5rem;color:#64748b;font-size:1rem;">Cảm xúc thay đổi nhanh và mạnh · Ảnh hưởng từ bạn bè tăng cao · Thời gian dùng thiết bị số tăng đột biến · Đây cũng là lúc hình thành nhân cách lâu dài</p>
      </div>
    </section>

    <!-- BLOCK 4: FEATURES -->
    <section class="pp-features">
      <div class="pp-features-inner">
        <h2>Môi trường giúp học sinh làm chủ tuổi dậy thì</h2>
        <div class="pp-feat-grid">
          <div class="pp-feat-card">
            <span class="pp-icon">📘</span>
            <strong>Học thuật tích hợp tiếp nối</strong>
            <p>Giữ nền tảng học tập ổn định, không bị "tụt nhịp"</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">❤️</span>
            <strong>Phát triển cảm xúc & xã hội</strong>
            <p>Hiểu mình – hiểu người – xây dựng quan hệ lành mạnh</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">🎯</span>
            <strong>PDR – tự chủ & tự dẫn dắt</strong>
            <p>Học sinh học cách đặt mục tiêu và tự chịu trách nhiệm</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">🤝</span>
            <strong>Đồng hành 2 lớp (GVCN + Buddy)</strong>
            <p>Luôn có người hiểu và theo sát học sinh</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">🧭</span>
            <strong>Leader in Me</strong>
            <p>Xây dựng thói quen, giá trị và tư duy lãnh đạo</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">🌐</span>
            <strong>Công dân số & AI</strong>
            <p>Biết dùng công nghệ, không bị công nghệ kiểm soát</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">🌍</span>
            <strong>Trải nghiệm & định hướng</strong>
            <p>Hiểu bản thân thông qua va chạm thực tế</p>
          </div>
        </div>
      </div>
    </section>

    <!-- BLOCK 5: TEXT WITH IMAGE -->
    <section class="pp-textimg">
      <div class="pp-textimg-inner">
        <div class="pp-textimg-text">
          <h2>Tuổi dậy thì không cần kiểm soát<br/>mà cần được dẫn dắt</h2>
          <p>Tại Việt Anh: Học sinh không bị ép buộc, không bị "quản lý cứng".</p>
          <p>Mà được: <strong>lắng nghe, thấu hiểu và dẫn dắt</strong>.</p>
          <div class="pp-callout">Giáo viên không chỉ dạy — mà giúp học sinh hiểu cảm xúc, kiểm soát hành vi và suy nghĩ rõ ràng hơn</div>
          <p>Đây là cách học sinh trưởng thành từ bên trong — không cần bị kiểm soát từ bên ngoài.</p>
        </div>
        <div class="pp-textimg-img">
          <img src="https://media.truongvietanh.com/images/thuyet-trinh-09.webp" alt="Học sinh THCS Việt Anh" loading="lazy" width="600" height="400" />
        </div>
      </div>
    </section>

    <!-- BLOCK 6: VALUE CARDS -->
    <section class="pp-valuecards">
      <div class="pp-valuecards-inner">
        <h2>Những giá trị học sinh nhận được</h2>
        <div class="pp-value-grid">
          <div class="pp-value-card">
            <span class="pp-icon">🧠</span>
            <strong>Bản lĩnh hơn</strong>
            <p>Biết kiểm soát cảm xúc và hành vi của mình</p>
          </div>
          <div class="pp-value-card">
            <span class="pp-icon">🎯</span>
            <strong>Tự chủ hơn</strong>
            <p>Biết mình cần làm gì và chịu trách nhiệm</p>
          </div>
          <div class="pp-value-card">
            <span class="pp-icon">💬</span>
            <strong>Giao tiếp tốt hơn</strong>
            <p>Xây dựng mối quan hệ lành mạnh với mọi người</p>
          </div>
          <div class="pp-value-card">
            <span class="pp-icon">🌐</span>
            <strong>Làm chủ công nghệ</strong>
            <p>Không bị cuốn vào mạng xã hội và điện thoại</p>
          </div>
          <div class="pp-value-card">
            <span class="pp-icon">🚀</span>
            <strong>Có định hướng</strong>
            <p>Bắt đầu hiểu mình và tương lai muốn đi đâu</p>
          </div>
        </div>
      </div>
    </section>

    <!-- BLOCK 7: FAQ -->
    <section class="pp-faq">
      <div class="pp-faq-inner">
        <h2>Câu hỏi phụ huynh thường gặp</h2>
        <div class="pp-faq-item">
          <p class="pp-faq-q">Tuổi dậy thì có nên quản chặt không?</p>
          <p class="pp-faq-a">Không. Kiểm soát chặt thường dẫn đến phản ứng ngược — con càng không chia sẻ. Cần dẫn dắt thay vì kiểm soát để con hợp tác và tự nguyện trưởng thành.</p>
        </div>
        <div class="pp-faq-item">
          <p class="pp-faq-q">Con đang nghiện điện thoại thì sao?</p>
          <p class="pp-faq-a">Cần dạy cách sử dụng công nghệ đúng — kỹ năng công dân số và Digital Quotient — thay vì chỉ cấm, vì cấm không giải quyết được gốc rễ vấn đề.</p>
        </div>
        <div class="pp-faq-item">
          <p class="pp-faq-q">Làm sao để con nghe lời hơn?</p>
          <p class="pp-faq-a">Khi con được lắng nghe, được hiểu và được trao trách nhiệm, con sẽ hợp tác tự nhiên hơn thay vì phải bị ép buộc.</p>
        </div>
        <div class="pp-faq-item">
          <p class="pp-faq-q">Trường khác gì so với nơi khác?</p>
          <p class="pp-faq-a">Chúng tôi tập trung vào phát triển con người toàn diện — bản lĩnh, cảm xúc, tự chủ, định hướng — không chỉ học lực và điểm số.</p>
        </div>
      </div>
    </section>

    <!-- BLOCK 8: FORM -->
    <section class="pp-form-block" id="pp-form">
      <div class="pp-form-block-inner">
        <h2>Nhận "Bản đồ phát triển" riêng cho con</h2>
        <p>Làm bài trắc nghiệm 2 phút — Việt Anh dựng bản đồ 5 trục (Kiến thức · Kỹ năng · Tiếng Anh · Thể chất · Hướng nghiệp) và gợi ý lộ trình phù hợp cho con.</p>
        <ul>
          <li>8 câu hỏi ngắn theo đúng lớp của con</li>
          <li>Kết quả 5 trục + 3 việc làm ngay tuần này</li>
          <li>Tư vấn cá nhân hoá 1:1 theo kết quả của con</li>
        </ul>
        <a href="/quiz?src=thcs-pillar" class="pp-btn pp-btn-gold pp-quiz-cta" style="font-size:1.1rem;padding:1.1rem 2.4rem;margin-top:.25rem">🎯 Làm trắc nghiệm miễn phí — 2 phút →</a>
      </div>
    </section>

    <!-- BLOCK 9: LINKS -->
    <section class="pp-links">
      <div class="pp-links-inner">
        <h2>Khám phá các chương trình phù hợp</h2>
        <div class="pp-link-grid">
          <a href="/tuyen-sinh/thcs" class="pp-link-card">
            <strong>Chương trình THCS Việt Anh</strong>
            <span>Môi trường dẫn dắt tuổi dậy thì đúng cách</span>
          </a>
          <a href="/tuyen-sinh/trai-he-thcs-2026" class="pp-link-card">
            <strong>Lion Camp – Trại hè THCS</strong>
            <span>Giúp con trưởng thành nhanh trong 6 tuần</span>
          </a>
          <a href="/thpt" class="pp-link-card">
            <strong>Chương trình THPT Việt Anh</strong>
            <span>Bước tiếp theo: định hướng tương lai</span>
          </a>
          <a href="https://truongvietanh.com/du-hoc" class="pp-link-card">
            <strong>Du học</strong>
            <span>Mở rộng cơ hội học tập quốc tế</span>
          </a>
          <a href="https://truongvietanh.com/thoi-khoa-bieu-mau-cac-khoi-lop/" class="pp-link-card" style="grid-column:1/-1">
            <strong>Thời khoá biểu mẫu các lớp</strong>
            <span>truongvietanh.com/thoi-khoa-bieu-mau-cac-khoi-lop/</span>
          </a>
        </div>
      </div>
    </section>

    <FooterBase />
  </div>

  <style>*, *::before, *::after{ box-sizing: border-box; }.pp-page{ font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; color: #1a1a2e; line-height: 1.6; }.pp-hero{ background: linear-gradient(160deg, rgba(24,25,58,0.65) 0%, rgba(38,39,93,0.55) 50%, rgba(16,16,36,0.70) 100%), url('https://media.truongvietanh.com/images/Block%20Hero%20_%20BG%20-%20website/thcs-banner-chinh-1.jpg') center/cover no-repeat; color: white; padding: 4rem 1.5rem 3.5rem; text-align: center; }.pp-hero-inner{ max-width: 820px; margin: 0 auto; }.pp-h1{ font-size: 2.4rem; font-weight: 800; line-height: 1.3; margin-bottom: 1.25rem; color: #f9dd0e; }.pp-h1-accent{ color: #ffffff; display: block; margin-top: .5rem; font-size: 1rem; }.pp-subtitle{ font-size: 1.1rem; color: #ffffff; opacity: 1; margin-bottom: 2.5rem; line-height: 1.75; }.pp-hero .pp-hero-inner > p{ color: #ffffff; }.pp-cta-row{ display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }.pp-btn{ display: inline-block; padding: .9rem 2rem; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 1rem; transition: opacity .2s; }.pp-btn:hover{ opacity: .88; }.pp-btn-gold{ background: #f9dd0e; color: #26275D; }.pp-btn-outline{ background: transparent; color: white; border: 2px solid rgba(255,255,255,.7); }.pp-richtext{ background: #fff; padding: 4.5rem 1.5rem; }.pp-richtext-inner{ max-width: 820px; margin: 0 auto; }.pp-richtext h2{ font-size: 1.5rem; font-weight: 800; color: #26275D; text-transform: uppercase; margin-bottom: 1.5rem; line-height: 1.4; }.pp-richtext p{ font-size: 1.05rem; color: #334155; line-height: 1.8; margin-bottom: 1rem; }.pp-callout{ color: #26275D; font-weight: 700; font-size: 1.05rem; padding: .6rem 1rem; border-left: 3px solid #f9dd0e; margin: 1.25rem 0; background: #fffbeb; border-radius: 0 6px 6px 0; }.pp-stats{ background: #f8fafc; padding: 4rem 1.5rem; border-top: 3px solid #e2e8f0; }.pp-stats-inner{ max-width: 900px; margin: 0 auto; }.pp-stats-inner > h2{ font-size: 1.5rem; font-weight: 800; color: #26275D; text-transform: uppercase; text-align: center; margin-bottom: 2rem; }.pp-stats-cols{ display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }.pp-stats-col{ background: white; border-radius: 12px; padding: 1.75rem; box-shadow: 0 2px 10px rgba(0,0,0,.05); }.pp-stats-col h3{ font-size: 1.5rem; font-weight: 700; color: #26275D; margin-bottom: 1rem; border-bottom: 2px solid #f9dd0e; padding-bottom: .5rem; }.pp-stats-col ul{ list-style: none; padding: 0; margin: 0; }.pp-stats-col li{ padding: .4rem 0 .4rem 1.5rem; position: relative; color: #475569; font-size: 1rem; }.pp-stats-col li::before{ content: '✓'; position: absolute; left: 0; color: #22c55e; font-weight: 700; }.pp-features{ background: #26275D; color: white; padding: 4.5rem 1.5rem; }.pp-features-inner{ max-width: 1050px; margin: 0 auto; }.pp-features h2{ font-size: 1.5rem; font-weight: 800; text-align: center; text-transform: uppercase; margin-bottom: 2.5rem; color: #f9dd0e; }.pp-features, .pp-features .pp-feat-card p, .pp-features .pp-feat-card strong{ color: #ffffff; }.pp-feat-grid{ display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }.pp-feat-card{ background: rgba(255,255,255,.08); border-radius: 12px; padding: 1.5rem; border: 1px solid rgba(255,255,255,.12); }.pp-feat-card .pp-icon{ font-size: 2rem; display: block; margin-bottom: .75rem; }.pp-feat-card strong{ display: block; font-size: 1rem; margin-bottom: .5rem; }.pp-feat-card p{ font-size: 1rem; opacity: .82; line-height: 1.65; margin: 0; }.pp-textimg{ background: white; padding: 4.5rem 1.5rem; }.pp-textimg-inner{ max-width: 1050px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 3.5rem; align-items: center; }.pp-textimg-text h2{ font-size: 1.5rem; font-weight: 800; color: #26275D; text-transform: uppercase; margin-bottom: 1.25rem; line-height: 1.4; }.pp-textimg-text p{ color: #334155; line-height: 1.8; margin-bottom: .8rem; }.pp-textimg-img img{ width: 100%; border-radius: 16px; box