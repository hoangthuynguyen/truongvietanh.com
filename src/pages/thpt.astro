---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "THPT Việt Anh",
    "url": "https://truongvietanh.com/thpt",
    "description": "THPT Việt Anh – làm rõ bản thân, chọn đúng con đường.",
    "address": { "@type": "PostalAddress", "addressLocality": "Hồ Chí Minh", "addressCountry": "VN" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Có cần IELTS từ THPT không?", "acceptedAnswer": { "@type": "Answer", "text": "Có, nếu muốn mở rộng cơ hội xét tuyển và học tập quốc tế." } },
      { "@type": "Question", "name": "Nếu con chưa biết mình thích gì thì sao?", "acceptedAnswer": { "@type": "Answer", "text": "Càng cần định hướng sớm — không nên chờ đến lớp 12 mới quyết định." } },
      { "@type": "Question", "name": "Làm sao để chọn đúng ngành?", "acceptedAnswer": { "@type": "Answer", "text": "Cần kết hợp hiểu bản thân, trải nghiệm thực tế và tư vấn chuyên nghiệp." } },
      { "@type": "Question", "name": "Trường khác gì so với nơi khác?", "acceptedAnswer": { "@type": "Answer", "text": "Tập trung vào định hướng và năng lực thật, không chỉ điểm số và kỳ thi." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://truongvietanh.com" },
      { "@type": "ListItem", "position": 2, "name": "THPT", "item": "https://truongvietanh.com/thpt" }
    ]
  }
];
---

<BaseLayout
  title="THPT Việt Anh – Làm Rõ Bản Thân, Chọn Đúng Con Đường"
  description="THPT Việt Anh: 3 năm để hiểu mình, có năng lực thật và chọn đúng con đường. IELTS 6.0+, tư vấn hướng nghiệp, hỗ trợ du học."
  canonical="https://truongvietanh.com/thpt"
  ogImage="https://media.truongvietanh.com/images/thuyet-trinh-04.webp"
  noPopup={true}
  structuredData={structuredData}
>
  <div class="pp-page">
    <HeaderBase />

    <!-- BLOCK 1: HERO -->
    <section class="pp-hero">
      <div class="pp-hero-inner">
        <h1 class="pp-h1">
          THPT không phải là 3 năm để chạy theo kỳ thi
          <span class="pp-h1-accent">mà là 3 năm để học sinh làm rõ bản thân và chọn đúng con đường</span>
        </h1>
        <p class="pp-subtitle">
          Điểm số có thể giúp học sinh bước qua một cánh cửa. Nhưng chỉ khi hiểu mình và có năng lực thật, các em mới chọn đúng cánh cửa đó.
        </p>
        <div class="pp-cta-row">
          <a href="#pp-form" class="pp-btn pp-btn-gold">Nhận brochure →</a>
          <a href="https://zalo.me/1678310120468101523" target="_blank" rel="noopener" class="pp-btn pp-btn-outline">Chat ngay →</a>
        </div>
      </div>
    </section>

    <!-- BLOCK 2: RICH TEXT -->
    <section class="pp-richtext">
      <div class="pp-richtext-inner">
        <h2>Vấn đề không phải là học sinh không giỏi<br/>mà là không biết mình đang học vì điều gì</h2>
        <p>Rất nhiều học sinh THPT: học rất nhiều, làm bài rất tốt — nhưng không biết mình muốn gì.</p>
        <div class="pp-callout">Và đến cuối lớp 12: chọn ngành theo điểm, chọn trường theo số đông, hoặc chọn trong mơ hồ</div>
        <p>Điều đáng lo không phải là <em>"thi có đỗ không"</em> — mà là: <strong>"Sau khi đỗ, con có đi đúng đường không?"</strong></p>
        <p>Nguyên nhân không nằm ở năng lực. Mà ở việc: không hiểu bản thân, không có định hướng, không có trải nghiệm.</p>
        <div class="pp-callout">Giáo dục THPT đúng phải giúp học sinh: hiểu mình, có năng lực thật, và có lộ trình rõ ràng</div>
      </div>
    </section>

    <!-- BLOCK 3: STATS -->
    <section class="pp-stats">
      <div class="pp-stats-inner">
        <h2>3 năm THPT quyết định những lựa chọn quan trọng nhất</h2>
        <div class="pp-stats-cols">
          <div class="pp-stats-col">
            <h3>Nếu không có định hướng…</h3>
            <ul>
              <li>Dễ chọn sai ngành, sai trường</li>
              <li>Mất thêm nhiều năm để sửa lại</li>
              <li>Mất động lực khi vào đại học</li>
            </ul>
          </div>
          <div class="pp-stats-col">
            <h3>Nếu có định hướng đúng…</h3>
            <ul>
              <li>Học tập có mục tiêu rõ ràng</li>
              <li>Đi nhanh và tự tin hơn</li>
              <li>Sẵn sàng cho tương lai thật sự</li>
            </ul>
          </div>
        </div>
        <p style="text-align:center;margin-top:1.5rem;color:#64748b;font-size:1rem;">Đây là giai đoạn chọn ngành học · Quyết định hướng đi đại học · Ảnh hưởng trực tiếp đến 5–10 năm tiếp theo</p>
      </div>
    </section>

    <!-- BLOCK 4: FEATURES -->
    <section class="pp-features">
      <div class="pp-features-inner">
        <h2>Môi trường giúp học sinh không chỉ đỗ — mà còn đi đúng</h2>
        <div class="pp-feat-grid">
          <div class="pp-feat-card">
            <span class="pp-icon">🎯</span>
            <strong>Lộ trình IELTS 6.0+</strong>
            <p>Mở rộng cơ hội xét tuyển và học tập quốc tế</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">💯</span>
            <strong>Quy đổi 10 điểm tiếng Anh</strong>
            <p>Giảm áp lực thi, tập trung vào năng lực thật</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">📘</span>
            <strong>Học thuật vững</strong>
            <p>Đáp ứng yêu cầu tốt nghiệp và xét tuyển đại học</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">🧭</span>
            <strong>PDR – hiểu mình & tự dẫn dắt</strong>
            <p>Học sinh tự đặt mục tiêu và theo dõi tiến trình</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">🎓</span>
            <strong>Tư vấn hướng nghiệp</strong>
            <p>Chọn tổ hợp – chọn ngành – chọn lộ trình phù hợp</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">🌍</span>
            <strong>Hỗ trợ đại học & du học</strong>
            <p>Không chỉ định hướng, mà có lộ trình thực tế</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">🌐</span>
            <strong>Tiếng Anh thật</strong>
            <p>Dùng để học và làm việc, không chỉ để thi</p>
          </div>
        </div>
      </div>
    </section>

    <!-- BLOCK 5: TEXT WITH IMAGE -->
    <section class="pp-textimg">
      <div class="pp-textimg-inner">
        <div class="pp-textimg-text">
          <h2>Học sinh không chỉ học để thi<br/>mà học để chuẩn bị cho cuộc đời</h2>
          <p>Tại Việt Anh: Học sinh không học theo quán tính, không học chỉ để đạt điểm.</p>
          <p>Mà: <strong>học theo mục tiêu cá nhân, học theo định hướng, học để chuẩn bị cho tương lai</strong>.</p>
          <div class="pp-callout">Giáo viên không chỉ dạy — mà giúp học sinh hiểu mình, xây lộ trình và đưa ra lựa chọn đúng</div>
          <p>Đây là cách học sinh không còn mơ hồ — mà học vì biết mình đang đi đâu.</p>
        </div>
        <div class="pp-textimg-img">
          <img src="https://media.truongvietanh.com/images/thuyet-trinh-09.webp" alt="Học sinh THPT Việt Anh" loading="lazy" width="600" height="400" />
        </div>
      </div>
    </section>

    <!-- BLOCK 6: VALUE CARDS -->
    <section class="pp-valuecards">
      <div class="pp-valuecards-inner">
        <h2>Những giá trị học sinh nhận được</h2>
        <div class="pp-value-grid">
          <div class="pp-value-card">
            <span class="pp-icon">🧭</span>
            <strong>Hiểu rõ bản thân</strong>
            <p>Biết mình phù hợp với điều gì và muốn đi đâu</p>
          </div>
          <div class="pp-value-card">
            <span class="pp-icon">🎯</span>
            <strong>Có định hướng rõ ràng</strong>
            <p>Không chọn ngành theo cảm tính hay áp lực</p>
          </div>
          <div class="pp-value-card">
            <span class="pp-icon">🧠</span>
            <strong>Năng lực học tập thật</strong>
            <p>Có thể cạnh tranh trong môi trường thật</p>
          </div>
          <div class="pp-value-card">
            <span class="pp-icon">🌍</span>
            <strong>Cơ hội rộng mở</strong>
            <p>Trong nước và quốc tế đều sẵn sàng</p>
          </div>
          <div class="pp-value-card">
            <span class="pp-icon">🚀</span>
            <strong>Tự tin bước vào tương lai</strong>
            <p>Không còn mơ hồ hay phụ thuộc vào quyết định của người khác</p>
          </div>
        </div>
      </div>
    </section>

    <!-- BLOCK 7: FAQ -->
    <section class="pp-faq">
      <div class="pp-faq-inner">
        <h2>Câu hỏi phụ huynh thường gặp</h2>
        <div class="pp-faq-item">
          <p class="pp-faq-q">Có cần IELTS từ THPT không?</p>
          <p class="pp-faq-a">Có. IELTS mở ra cơ hội xét tuyển đại học theo phương thức quốc tế và cơ hội du học. Càng chuẩn bị sớm từ THPT, học sinh càng có nhiều lựa chọn khi tốt nghiệp.</p>
        </div>
        <div class="pp-faq-item">
          <p class="pp-faq-q">Nếu con chưa biết mình thích gì thì sao?</p>
          <p class="pp-faq-a">Càng cần định hướng sớm. Không nên chờ đến lớp 12 mới bắt đầu — vì khi đó thời gian để thử nghiệm và tìm hiểu gần như không còn.</p>
        </div>
        <div class="pp-faq-item">
          <p class="pp-faq-q">Làm sao để chọn đúng ngành?</p>
          <p class="pp-faq-a">Cần kết hợp 3 yếu tố: hiểu bản thân (sở thích, thế mạnh), trải nghiệm thực tế (thực tập, dự án), và tư vấn chuyên nghiệp từ người có kinh nghiệm.</p>
        </div>
        <div class="pp-faq-item">
          <p class="pp-faq-q">Trường khác gì so với nơi khác?</p>
          <p class="pp-faq-a">Chúng tôi tập trung vào định hướng và năng lực thật — không chỉ điểm số và kỳ thi — để học sinh tốt nghiệp với sự tự tin và lộ trình cụ thể, không phải trong mơ hồ.</p>
        </div>
      </div>
    </section>

    <!-- BLOCK 8: FORM -->
    <section class="pp-form-block" id="pp-form">
      <div class="pp-form-block-inner">
        <h2>Nhận tư vấn định hướng cho con</h2>
        <p>Để lại thông tin — nhận đánh giá định hướng, tư vấn lộ trình học tập và hướng dẫn chọn ngành phù hợp.</p>
        <ul>
          <li>Đánh giá định hướng hiện tại của con</li>
          <li>Tư vấn lộ trình học tập và IELTS</li>
          <li>Hướng dẫn chọn ngành phù hợp với con</li>
        </ul>
        <LeadFormTwoStepEmailFirst
          formId="thpt-pillar-form"
          funnelCode="thpt-pillar"
          schoolLevel="thpt"
        />
      </div>
    </section>

    <!-- BLOCK 9: LINKS -->
    <section class="pp-links">
      <div class="pp-links-inner">
        <h2>Khám phá các chương trình liên quan</h2>
        <div class="pp-link-grid">
          <a href="/tuyen-sinh/thpt" class="pp-link-card">
            <strong>Chương trình THPT Việt Anh</strong>
            <span>Nền tảng học thuật + định hướng tương lai</span>
          </a>
          <a href="/tuyen-sinh/trai-he-thpt-2026" class="pp-link-card">
            <strong>Lion Camp – Trại hè THPT</strong>
            <span>6 tuần giúp học sinh làm rõ bản thân</span>
          </a>
          <a href="https://truongvietanh.com/du-hoc" class="pp-link-card">
            <strong>Du học</strong>
            <span>Mở rộng cơ hội học tập quốc tế</span>
          </a>
          <a href="https://truongvietanh.com/tuyen-sinh/giai-ma-tiem-nang/" class="pp-link-card">
            <strong>Giải mã tiềm năng</strong>
            <span>Hiểu sâu bản thân để chọn đúng hướng</span>
          </a>
          <a href="https://truongvietanh.com/thoi-khoa-bieu-mau-cac-khoi-lop/" class="pp-link-card" style="grid-column:1/-1">
            <strong>Thời khoá biểu mẫu các lớp</strong>
            <span>truongvietanh.com/thoi-khoa-bieu-mau-cac-khoi-lop/</span>
          </a>
        </div>
      </div>
    </section>

    <FooterBase />
  </div>

  <style>*, *::before, *::after{ box-sizing: border-box; }.pp-page{ font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; color: #1a1a2e; line-height: 1.6; }.pp-hero{ background: linear-gradient(160deg, rgba(24,25,58,0.65) 0%, rgba(38,39,93,0.55) 50%, rgba(16,16,36,0.70) 100%), url('https://media.truongvietanh.com/images/Block%20Hero%20_%20BG%20-%20website/thpt-banner-chinh-1.jpg') center/cover no-repeat; color: white; padding: 4rem 1.5rem 3.5rem; text-align: center; }.pp-hero-inner{ max-width: 820px; margin: 0 auto; }.pp-h1{ font-size: 2.4rem; font-weight: 800; line-height: 1.3; margin-bottom: 1.25rem; color: #f9dd0e; }.pp-h1-accent{ color: #ffffff; display: block; margin-top: .5rem; font-size: 1rem; }.pp-subtitle{ font-size: 1.1rem; color: #ffffff; opacity: 1; margin-bottom: 2.5rem; line-height: 1.75; }.pp-hero .pp-hero-inner > p{ color: #ffffff; }.pp-cta-row{ display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }.pp-btn{ display: inline-block; padding: .9rem 2rem; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 1rem; transition: opacity .2s; }.pp-btn:hover{ opacity: .88; }.pp-btn-gold{ background: #f9dd0e; color: #26275D; }.pp-btn-outline{ background: transparent; color: white; border: 2px solid rgba(255,255,255,.7); }.pp-richtext{ background: #fff; padding: 4.5rem 1.5rem; }.pp-richtext-inner{ max-width: 820px; margin: 0 auto; }.pp-richtext h2{ font-size: 1.5rem; font-weight: 800; color: #26275D; text-transform: uppercase; margin-bottom: 1.5rem; line-height: 1.4; }.pp-richtext p{ font-size: 1.05rem; color: #334155; line-height: 1.8; margin-bottom: 1rem; }.pp-callout{ color: #26275D; font-weight: 700; font-size: 1.05rem; padding: .6rem 1rem; border-left: 3px solid #f9dd0e; margin: 1.25rem 0; background: #fffbeb; border-radius: 0 6px 6px 0; }.pp-stats{ background: #f8fafc; padding: 4rem 1.5rem; border-top: 3px solid #e2e8f0; }.pp-stats-inner{ max-width: 900px; margin: 0 auto; }.pp-stats-inner > h2{ font-size: 1.5rem; font-weight: 800; color: #26275D; text-transform: uppercase; text-align: center; margin-bottom: 2rem; }.pp-stats-cols{ display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }.pp-stats-col{ background: white; border-radius: 12px; padding: 1.75rem; box-shadow: 0 2px 10px rgba(0,0,0,.05); }.pp-stats-col h3{ font-size: 1.5rem; font-weight: 700; color: #26275D; margin-bottom: 1rem; border-bottom: 2px solid #f9dd0e; padding-bottom: .5rem; }.pp-stats-col ul{ list-style: none; padding: 0; margin: 0; }.pp-stats-col li{ padding: .4rem 0 .4rem 1.5rem; position: relative; color: #475569; font-size: 1rem; }.pp-stats-col li::before{ content: '✓'; position: absolute; left: 0; color: #22c55e; font-weight: 700; }.pp-features{ background: #26275D; color: white; padding: 4.5rem 1.5rem; }.pp-features-inner{ max-width: 1050px; margin: 0 auto; }.pp-features h2{ font-size: 1.5rem; font-weight: 800; text-align: center; text-transform: uppercase; margin-bottom: 2.5rem; color: #f9dd0e; }.pp-features, .pp-features .pp-feat-card p, .pp-features .pp-feat-card strong{ color: #ffffff; }.pp-feat-grid{ display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }.pp-feat-card{ background: rgba(255,255,255,.08); border-radius: 12px; padding: 1.5rem; border: 1px solid rgba(255,255,255,.12); }.pp-feat-card .pp-icon{ font-size: 2rem; display: block; margin-bottom: .75rem; }.pp-feat-card strong{ display: block; font-size: 1rem; margin-bottom: .5rem; }.pp-feat-card p{ font-size: 1rem; opacity: .82; line-height: 1.65; margin: 0; }.pp-textimg{ background: white; padding: 4.5rem 1.5rem; }.pp-textimg-inner{ max-width: 1050px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 3.5rem; align-items: center; }.pp-textimg-text h2{ font-size: 1.5rem; font-weight: 800; color: #26275D; text-transform: uppercase; margin-bottom: 1.25rem; line-height: 1.4; }.pp-textimg-text p{ color: #334155; line-height: 1.8; margin-bottom: .8rem; }.pp-textimg-img img{ width: 100%; border-radius: 16px; box