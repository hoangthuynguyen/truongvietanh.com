---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import { getPillarPage } from '../lib/directus';

const cmsPage = await getPillarPage('tieu-hoc');
const cmsFaqs = cmsPage?.faq_items || null;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Trường Tiểu Học Việt Anh",
    "alternateName": "Trường Tiểu Học Song Ngữ Việt Anh",
    "url": "https://truongvietanh.com/tieu-hoc",
    "logo": "https://truongvietanh.com/logo-crest-80.webp",
    "foundingDate": "2011",
    "description": "Chương trình tiểu học song ngữ UK Cambridge, tiếng Anh chuyên sâu, 16 kỹ năng thế kỷ 21, hệ thống PDR tại TP.HCM.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Hồ Chí Minh",
      "addressCountry": "VN"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "bestRating": "5",
      "ratingCount": "300"
    },
    "areaServed": ["TP. Hồ Chí Minh", "Long An", "Kiên Giang"],
    "offers": { "@type": "Offer", "category": "Tiểu Học Song Ngữ", "price": "7000000", "priceCurrency": "VND", "priceValidUntil": "2027-08-31", "description": "Học phí Tiểu Học từ 7-10 triệu VND/tháng" },
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": [".gi-h1", ".gi-subtitle"] }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Lớp tiểu học Trường Việt Anh có bao nhiêu học sinh?",
        "acceptedAnswer": { "@type": "Answer", "text": "Mỗi lớp tiểu học tại Trường Việt Anh có tối đa 30-35 học sinh, đảm bảo giáo viên quan tâm từng em." }
      },
      {
        "@type": "Question",
        "name": "Trường Việt Anh có xe đưa rước cho học sinh tiểu học không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Có, hệ thống xe đưa rước phục vụ tất cả cơ sở tại TP.HCM, phủ khắp các quận huyện với camera giám sát và GPS." }
      },
      {
        "@type": "Question",
        "name": "Học sinh từ trường khác có thể chuyển sang tiểu học Việt Anh không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Có, Trường Việt Anh nhận chuyển cấp và chuyển trường bất kỳ lúc nào trong năm học nếu còn chỗ. Trường có chương trình hỗ trợ hội nhập cho học sinh mới." }
      },
      {
        "@type": "Question",
        "name": "Tiểu học Việt Anh có dạy thêm ngoài giờ không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Không cần học thêm. Chương trình bán trú kéo dài đến 16h30, bao gồm tự học có hướng dẫn, ngoại khoá và CLB. Học sinh hoàn thành bài tập tại trường." }
      },
      {
        "@type": "Question",
        "name": "Chương trình Bộ GD&ĐT ở tiểu học Việt Anh có đầy đủ không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Đầy đủ 100%. Học sinh hoàn thành toàn bộ chương trình Bộ GD&ĐT theo đúng chuẩn, đồng thời học thêm UK Cambridge Primary cho Toán, Khoa học và Công nghệ." }
      },
      {
        "@type": "Question",
        "name": "Tốt nghiệp tiểu học Việt Anh, học sinh đi đâu?",
        "acceptedAnswer": { "@type": "Answer", "text": "95% học sinh tiếp tục học THCS tại Trường Việt Anh. Số còn lại chuyển sang các trường quốc tế hoặc trường chuyên với nền tảng tiếng Anh và kỹ năng vượt trội." }
      },
      {
        "@type": "Question",
        "name": "Tiểu học Việt Anh có chính sách học bổng không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Có, Trường Việt Anh dành học bổng cho học sinh có thành tích xuất sắc, năng khiếu đặc biệt và gia đình có hoàn cảnh. Liên hệ tư vấn để biết chi tiết." }
      },
      { "@type": "Question", "name": "Trường có dạy lập trình và STEM cho học sinh tiểu học không?", "acceptedAnswer": { "@type": "Answer", "text": "Có. Từ lớp 3 học Scratch, lớp 4-5 nâng cấp Python và Robotics. Phòng lab STEM với Lego Education, Arduino, 3D Printer. Hàng năm có STEM Fair toàn trường." } },
      { "@type": "Question", "name": "Chương trình tiểu học có nặng quá cho con không?", "acceptedAnswer": { "@type": "Answer", "text": "Không. Thời khóa biểu cân bằng: sáng học kiến thức, chiều CLB ngoại khóa và thể thao. Mỗi tuần ít nhất 4 tiết thể dục, nghệ thuật và kỹ năng sống." } },
      { "@type": "Question", "name": "Con có thể chuyển từ trường công sang tiểu học Việt Anh giữa chừng không?", "acceptedAnswer": { "@type": "Answer", "text": "Hoàn toàn được. Nhận chuyển trường tất cả lớp 1-5. Kiểm tra Toán + Tiếng Anh xếp lớp. Có chương trình bổ trợ tiếng Anh 4-8 tuần cho học sinh chưa có nền tảng." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://truongvietanh.com" },
      { "@type": "ListItem", "position": 2, "name": "Tiểu học", "item": "https://truongvietanh.com/tieu-hoc" }
    ]
  }
];
---

<BaseLayout
  title={cmsPage?.title || "Tiểu Học Việt Anh – Song Ngữ UK &amp; Kỹ Năng Thế Kỷ 21"}
  description={cmsPage?.description || "Trường Tiểu Học Việt Anh tại TP.HCM: chương trình song ngữ UK Cambridge, tiếng Anh chuyên sâu, 16 kỹ năng thế kỷ 21, hệ thống PDR. Đăng ký tham quan miễn phí."}
  canonical="https://truongvietanh.com/tieu-hoc"
  ogImage="https://media.truongvietanh.com/images/extra-giao-vien-va-hoc-sinh-2.webp"
  structuredData={structuredData}
>
  <div class="gi-page">
    <HeaderBase />

    <!-- ====== HERO WITH FORM ====== -->
    <section class="gi-hero">
      <div class="gi-container gi-hero-inner">
        <div class="gi-hero-left">
          <nav class="gi-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Trang chủ</a>
            <span aria-hidden="true">/</span>
            <a href="/gioi-thieu">Giới thiệu</a>
            <span aria-hidden="true">/</span>
            <span>Tiểu học</span>
          </nav>

          <h1 class="gi-h1">Trường Tiểu Học Song Ngữ Việt Anh: Nền Tảng Vững Chắc Cho Tương Lai</h1>
          <p class="gi-subtitle">Chương trình UK Cambridge — 16 kỹ năng thế kỷ 21 — Tiếng Anh chuyên sâu</p>
          <p class="gi-last-updated">Cập nhật lần cuối: Tháng 4, 2026</p>

          <div class="gi-hero-rating">
            <span class="gi-stars" aria-label="4.9 trên 5 sao">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            <span class="gi-rating-text">4.9/5 (300+ đánh giá từ phụ huynh)</span>
          </div>

          <div class="gi-trust-badges">
            <div class="gi-badge"><strong>100%</strong> CT Bộ GD</div>
            <div class="gi-badge"><strong>UK</strong> Cambridge</div>
            <div class="gi-badge"><strong>A2-B1</strong> Tiếng Anh</div>
            <div class="gi-badge"><strong>16</strong> kỹ năng WEF</div>
          </div>
        </div>

        <div class="gi-hero-right">
          <div class="gi-form-card">
            <p class="gi-form-heading">Đăng ký tham quan trường miễn phí</p>
            <LeadFormTwoStepEmailFirst
              formId="tieu-hoc-form"
              funnelCode="tieu-hoc-pillar"
              schoolLevel="tieu-hoc"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ====== TOC SIDEBAR + CONTENT ====== -->
    <div class="gi-container gi-body">
      <p class="gi-last-updated">Cập nhật lần cuối: Tháng 4/2026</p>
      <!-- Sticky TOC sidebar -->
      <nav class="gi-toc" aria-label="Mục lục">
        <p class="gi-toc-title">Mục lục</p>
        <ol class="gi-toc-list">
          <li><a href="#chuong-trinh">Chương trình đặc biệt</a></li>
          <li><a href="#tieng-anh">Tiếng Anh tiểu học</a></li>
          <li><a href="#ky-nang">Kỹ năng & lãnh đạo</a></li>
          <li><a href="#hoc-phi">Học phí tiểu học</a></li>
          <li><a href="#co-so">Cơ sở tiểu học</a></li>
          <li><a href="#danh-gia">Đánh giá phụ huynh</a></li>
          <li><a href="#faq">Câu hỏi thường gặp</a></li>
        </ol>
        <a href="#tieu-hoc-form-tieu-hoc-pillar" class="gi-toc-cta">Đăng ký tham quan</a>
      </nav>

      <!-- Main content -->
      <article class="gi-main">

        <!-- Section 1: Chương trình -->
        <section id="chuong-trinh" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg></span>Chương trình tiểu học tại Trường Việt Anh có gì đặc biệt?</h2>
          <p>Chương trình tiểu học tại Trường Việt Anh được thiết kế theo mô hình <strong>song ngữ tích hợp</strong>: học sinh vừa hoàn thành 100% chương trình Bộ Giáo dục & Đào tạo Việt Nam, vừa học song song chương trình <strong>UK <a href="https://www.cambridgeinternational.org" target="_blank" rel="noopener">Cambridge International</a> Primary</strong> cho các môn Toán (Mathematics), Khoa học (Science), Công nghệ thông tin (ICT) và Máy tính (Computing). Chương trình tiếng Anh được xây dựng theo chuẩn quốc tế với sự tham vấn của <a href="https://www.britishcouncil.vn" target="_blank" rel="noopener">British Council Việt Nam</a>.</p>
          <p>Điều này có nghĩa con bạn không bị thiếu bất kỳ kiến thức nào so với bạn bè ở trường công lập, nhưng đồng thời được bổ sung một nền tảng học thuật quốc tế vững chắc — giúp các em sẵn sàng cho môi trường giáo dục toàn cầu từ sớm.</p>

          <div class="gi-comparison-box">
            <h3>So sánh: Tiểu học Việt Anh vs Trường công lập vs Trường quốc tế</h3>
            <div class="gi-table-responsive">
              <table class="gi-table">
                <thead>
                  <tr>
                    <th>Tiêu chí</th>
                    <th>Trường công lập</th>
                    <th>Trường Việt Anh</th>
                    <th>Trường quốc tế</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Chương trình VN</td>
                    <td>100% Bộ GD&ĐT</td>
                    <td>100% Bộ GD&ĐT</td>
                    <td>Một phần hoặc không có</td>
                  </tr>
                  <tr>
                    <td>Chương trình quốc tế</td>
                    <td>Không có</td>
                    <td>UK Cambridge Primary</td>
                    <td>IB / Cambridge / American</td>
                  </tr>
                  <tr>
                    <td>Tiếng Anh</td>
                    <td>4-8 tiết/tuần</td>
                    <td>40-50% thời lượng</td>
                    <td>70-100% tiếng Anh</td>
                  </tr>
                  <tr>
                    <td>Toán tư duy</td>
                    <td>Theo SGK</td>
                    <td>SAM (Singapore Math) + Cambridge</td>
                    <td>Singapore / IB Math</td>
                  </tr>
                  <tr>
                    <td>STEM / Coding</td>
                    <td>Cơ bản hoặc không</td>
                    <td>Hàng tuần, dự án thực tế</td>
                    <td>Có</td>
                  </tr>
                  <tr>
                    <td>Kỹ năng sống</td>
                    <td>Lồng ghép ít</td>
                    <td>16 kỹ năng WEF + Leader in Me</td>
                    <td>Tuỳ trường</td>
                  </tr>
                  <tr>
                    <td>Học phí/tháng</td>
                    <td>Miễn phí / phí nhỏ</td>
                    <td>6-9 triệu</td>
                    <td>20-50 triệu</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <img src="https://media.truongvietanh.com/images/giao-vien-06.webp" alt="Học sinh tiểu học Trường Việt Anh" loading="lazy" width="1200" height="auto" class="section-img" />

          <p>Ngoài chương trình học thuật, tiểu học Việt Anh còn tích hợp <strong>Toán tư duy SAM</strong> (Singapore Approach to Mathematics) — giúp học sinh hiểu bản chất toán học thay vì chỉ làm theo công thức. Các môn STEM và Coding được dạy hàng tuần thông qua dự án thực tế, giúp trẻ phát triển tư duy logic và sáng tạo từ lớp 1.</p>

          <div class="gi-evidence-bar">
            <div class="gi-evidence-item">
              <strong>100%</strong>
              <span>Hoàn thành CT Bộ GD&ĐT</span>
            </div>
            <div class="gi-evidence-item">
              <strong>100%</strong>
              <span>Hoàn thành Cambridge Primary</span>
            </div>
            <div class="gi-evidence-item">
              <strong>40-50%</strong>
              <span>Thời lượng tiếng Anh</span>
            </div>
            <div class="gi-evidence-item">
              <strong>SAM</strong>
              <span>Toán tư duy Singapore</span>
            </div>
          </div>
        </section>

        <!-- Section 2: Tiếng Anh -->
        <section id="tieng-anh" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg></span>Tiếng Anh tiểu học tại Việt Anh đạt trình độ gì?</h2>
          <p>Chương trình tiếng Anh bậc tiểu học tại Trường Việt Anh là sự tiếp nối tự nhiên từ giai đoạn <strong>Immersion</strong> (đắm chìm ngôn ngữ) ở Mầm non. Khi bước vào lớp 1, trẻ đã có nền tảng nghe-nói cơ bản sau 2-3 năm tiếp xúc 100% tiếng Anh với giáo viên bản ngữ. Giai đoạn tiểu học tập trung phát triển đầy đủ 4 kỹ năng: Nghe — Nói — Đọc — Viết.</p>

          <p>Điểm khác biệt lớn nhất: tại Trường Việt Anh, tiếng Anh không chỉ là một "môn học" mà là <strong>ngôn ngữ giảng dạy</strong> cho các môn UK Cambridge. Học sinh học Toán bằng tiếng Anh, làm thí nghiệm Khoa học bằng tiếng Anh, thuyết trình dự án bằng tiếng Anh — tất cả trong bối cảnh thực tế, không chỉ trên sách giáo khoa.</p>

          <div class="gi-roadmap">
            <h3>Lộ trình Tiếng Anh tiểu học 5 năm</h3>
            <div class="gi-roadmap-grid th-roadmap-5col">
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">Lớp 1</div>
                <strong>Nền tảng Phonics</strong>
                <p>Củng cố phát âm, bắt đầu đọc-viết. Học Toán và Khoa học đơn giản bằng tiếng Anh. Xây dựng vốn từ 500-800 từ.</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">Lớp 2</div>
                <strong>Đọc hiểu cơ bản</strong>
                <p>Đọc truyện ngắn, viết đoạn văn đơn giản. Bắt đầu thuyết trình nhóm bằng tiếng Anh. Vốn từ 1.000-1.500.</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">Lớp 3</div>
                <strong>Giao tiếp tự tin</strong>
                <p>Thảo luận, phản biện trong lớp. Viết báo cáo khoa học đơn giản bằng tiếng Anh. Mục tiêu Pre-A1 Starters.</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">Lớp 4</div>
                <strong>Học thuật Cambridge</strong>
                <p>Làm chủ đọc hiểu học thuật. Viết bài luận có cấu trúc. Dự án STEM trình bày bằng tiếng Anh. Mục tiêu A1 Movers.</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">Lớp 5</div>
                <strong>Sẵn sàng Cambridge A2</strong>
                <p>Tự tin đọc-viết-nghe-nói ở trình độ A2. Chuẩn bị thi Cambridge A2 Key (KET). Sẵn sàng cho THCS Academic English.</p>
              </div>
            </div>
          </div>

          <div class="gi-comparison-box">
            <h3>So sánh trình độ tiếng Anh cuối lớp 5</h3>
            <div class="gi-table-responsive">
              <table class="gi-table">
                <thead>
                  <tr>
                    <th>Tiêu chí</th>
                    <th>Trường công lập</th>
                    <th>Trường Việt Anh</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Trình độ CEFR</td>
                    <td>A1 (cơ bản)</td>
                    <td>A2 — B1 (trung cấp)</td>
                  </tr>
                  <tr>
                    <td>Vốn từ vựng</td>
                    <td>800-1.200 từ</td>
                    <td>2.500-4.000 từ</td>
                  </tr>
                  <tr>
                    <td>Kỹ năng nói</td>
                    <td>Đọc bài trong SGK</td>
                    <td>Thuyết trình, phản biện, phỏng vấn</td>
                  </tr>
                  <tr>
                    <td>Kỹ năng viết</td>
                    <td>Chép bài, điền từ</td>
                    <td>Viết luận, báo cáo, email</td>
                  </tr>
                  <tr>
                    <td>Chứng chỉ</td>
                    <td>Không</td>
                    <td>Cambridge A2 Key (KET)</td>
                  </tr>
                  <tr>
                    <td>Thời lượng TA/tuần</td>
                    <td>4-8 tiết</td>
                    <td>15-20 tiết (gồm môn UK)</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>Với lộ trình này, học sinh tiểu học Trường Việt Anh khi lên THCS đã có đủ nền tảng để học các môn học thuật bằng tiếng Anh, hướng tới mục tiêu IELTS 4.5-5.5 cuối lớp 9 và IELTS 6.0-8.0 khi tốt nghiệp THPT.</p>
        </section>

        <!-- Section 3: Kỹ năng -->
        <section id="ky-nang" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></span>Trường Việt Anh rèn luyện kỹ năng gì cho học sinh tiểu học?</h2>
          <p>Ở bậc tiểu học, ngoài kiến thức học thuật, Trường Việt Anh đặc biệt chú trọng phát triển <strong>phẩm chất và kỹ năng</strong> — những yếu tố quyết định thành công dài hạn của trẻ. Chương trình kỹ năng tại trường dựa trên 3 trụ cột chính.</p>

          <div class="gi-leader-grid">
            <div class="gi-leader-card">
              <h4>16 kỹ năng thế kỷ 21 (WEF)</h4>
              <p style="font-size:0.9rem;color:#5c6e80;margin-bottom:0.75rem;">Theo khung năng lực của Diễn đàn Kinh tế Thế giới, chia thành 3 nhóm:</p>
              <ul>
                <li><strong>Nền tảng:</strong> Đọc-viết, Toán học, Khoa học, Công nghệ thông tin, Tài chính, Văn hoá</li>
                <li><strong>Năng lực:</strong> Tư duy phản biện, Tài giỏi, Giao tiếp, Hợp tác</li>
                <li><strong>Phẩm chất:</strong> Tò mò, Chủ động, Yêu thương, Thích nghi, Lãnh đạo, Nhận thức xã hội</li>
              </ul>
            </div>
            <div class="gi-leader-card">
              <h4>Leader in Me (Franklin Covey)</h4>
              <p style="font-size:0.9rem;color:#5c6e80;margin-bottom:0.75rem;">7 thói quen lãnh đạo được rèn luyện hàng ngày:</p>
              <ol>
                <li>Chủ động (Be Proactive)</li>
                <li>Bắt đầu từ mục tiêu (Begin with the End in Mind)</li>
                <li>Ưu tiên việc quan trọng (Put First Things First)</li>
                <li>Tư duy cùng thắng (Think Win-Win)</li>
                <li>Hiểu người trước (Seek First to Understand)</li>
                <li>Hợp tác sáng tạo (Synergize)</li>
                <li>Rèn luyện bản thân (Sharpen the Saw)</li>
              </ol>
            </div>
          </div>

          <div class="gi-comparison-box">
            <h3>Hệ thống PDR — Theo dõi phát triển cá nhân hàng tuần</h3>
            <p>PDR (Plan — Do — Review) là hệ thống giáo dục độc quyền của Trường Việt Anh, áp dụng từ Mầm non đến THPT. Ở bậc tiểu học, mỗi tuần học sinh sẽ:</p>
            <div class="gi-values-items th-pdr-grid">
              <div class="gi-value-card">
                <span class="gi-value-icon">&#9997;</span>
                <strong>Plan (Lập kế hoạch)</strong>
                <p>Đầu tuần: đặt mục tiêu học tập và phát triển cá nhân cùng giáo viên chủ nhiệm</p>
              </div>
              <div class="gi-value-card">
                <span class="gi-value-icon">&#9881;</span>
                <strong>Do (Thực hiện)</strong>
                <p>Trong tuần: thực hành theo kế hoạch, ghi nhật ký học tập, tham gia hoạt động</p>
              </div>
              <div class="gi-value-card">
                <span class="gi-value-icon">&#9733;</span>
                <strong>Review (Đánh giá)</strong>
                <p>Cuối tuần: tự đánh giá, nhận phản hồi từ thầy cô, điều chỉnh cho tuần tiếp theo</p>
              </div>
            </div>
          </div>

          <h3>Hoạt động ngoại khoá phong phú</h3>
          <p>Ngoài giờ học chính khoá, học sinh tiểu học Trường Việt Anh được tham gia đa dạng câu lạc bộ và hoạt động ngoại khoá, giúp phát triển toàn diện cả thể chất lẫn tinh thần.</p>
          <div class="gi-values-items th-extra-grid">
            <div class="gi-value-card">
              <span class="gi-value-icon">&#127946;</span>
              <strong>Bơi lội</strong>
