---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Lion Camp – Trại Hè Việt Anh 2026",
    "url": "https://hoc.truongvietanh.com/trai-he-2026",
    "description": "Lion Camp 2026 – 6 tuần trải nghiệm phát triển toàn diện cho học sinh Tiểu học, THCS và THPT.",
    "address": { "@type": "PostalAddress", "addressLocality": "Hồ Chí Minh", "addressCountry": "VN" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Lion Camp có phải trại hè vui chơi không?", "acceptedAnswer": { "@type": "Answer", "text": "Không. Đây là chương trình phát triển toàn diện về tư duy, kỹ năng và bản lĩnh." } },
      { "@type": "Question", "name": "Con có bị áp lực không?", "acceptedAnswer": { "@type": "Answer", "text": "Không. Trẻ học qua trải nghiệm thực tế, không bị ép hay áp lực điểm số." } },
      { "@type": "Question", "name": "6 tuần có cần thiết không?", "acceptedAnswer": { "@type": "Answer", "text": "Đây là thời gian tối thiểu để tạo thay đổi thật — thói quen hình thành sau 3–6 tuần liên tục." } },
      { "@type": "Question", "name": "Làm sao biết con thay đổi?", "acceptedAnswer": { "@type": "Answer", "text": "Qua hành vi, thói quen và sự tự chủ mỗi ngày sau khi kết thúc chương trình." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://hoc.truongvietanh.com" },
      { "@type": "ListItem", "position": 2, "name": "Trại hè 2026", "item": "https://hoc.truongvietanh.com/trai-he-2026" }
    ]
  }
];
---

<BaseLayout
  title="Lion Camp 2026 – Trại Hè Phát Triển Toàn Diện Tại Việt Anh"
  description="Lion Camp 2026: 6 tuần mùa hè giúp học sinh Tiểu học, THCS, THPT phát triển tư duy, kỹ năng và bản lĩnh. Không phải trại hè vui chơi — mà là bước ngoặt thật sự."
  canonical="https://hoc.truongvietanh.com/trai-he-2026"
  ogImage="https://media.truongvietanh.com/images/vui-ve-06.webp"
  structuredData={structuredData}
>
  <div class="pp-page">
    <HeaderBase />

    <!-- BLOCK 1: HERO -->
    <section class="pp-hero">
      <div class="pp-hero-inner">
        <h1 class="pp-h1">
          Mùa hè không chỉ để nghỉ ngơi
          <span class="pp-h1-accent">mà là thời điểm tốt nhất để trẻ thay đổi và bứt phá</span>
        </h1>
        <p class="pp-subtitle">
          Trong khi nhiều trẻ "trôi qua" mùa hè với điện thoại và thói quen cũ, Lion Camp tạo ra một môi trường 6 tuần giúp học sinh phát triển mạnh mẽ về tư duy, kỹ năng và bản lĩnh.
        </p>
        <div class="pp-cta-row">
          <a href="#pp-form" class="pp-btn pp-btn-gold">Khám phá Lion Camp →</a>
          <a href="#pp-form" class="pp-btn pp-btn-outline">Nhận tư vấn chọn chương trình →</a>
        </div>
      </div>
    </section>

    <!-- BLOCK 2: RICH TEXT -->
    <section class="pp-richtext">
      <div class="pp-richtext-inner">
        <h2>Vấn đề không phải là trẻ nghỉ hè<br/>mà là nghỉ hè không có định hướng</h2>
        <p>Mỗi mùa hè, rất nhiều phụ huynh đối mặt với: con dành quá nhiều thời gian cho điện thoại, sinh hoạt đảo lộn, mất kỷ luật, quên kiến thức và thói quen học tập.</p>
        <div class="pp-callout">Nhưng điều đáng lo hơn là: con không phát triển thêm, không có trải nghiệm mới, không trưởng thành hơn</div>
        <p>Trong khi đó, mùa hè chính là <strong>khoảng thời gian hiếm hoi trẻ có thể thay đổi nhanh nhất</strong> — không áp lực điểm số, không bị ràng buộc chương trình.</p>
        <div class="pp-callout">Đây là lúc tốt nhất để xây thói quen, rèn kỹ năng và phát triển bản thân</div>
      </div>
    </section>

    <!-- BLOCK 3: STATS -->
    <section class="pp-stats">
      <div class="pp-stats-inner">
        <h2>6 tuần mùa hè có thể tạo ra sự khác biệt rõ rệt</h2>
        <div class="pp-stats-cols">
          <div class="pp-stats-col">
            <h3>Nếu không có môi trường phù hợp…</h3>
            <ul>
              <li>Trẻ dễ quay lại thói quen cũ</li>
              <li>Mất kỷ luật và tự giác</li>
              <li>Phụ thuộc nhiều hơn vào người lớn</li>
            </ul>
          </div>
          <div class="pp-stats-col">
            <h3>Nếu được đặt đúng môi trường…</h3>
            <ul>
              <li>Trẻ thay đổi hành vi rõ rệt</li>
              <li>Tự tin và tự chủ hơn</li>
              <li>Trưởng thành rõ rệt sau 6 tuần</li>
            </ul>
          </div>
        </div>
        <p style="text-align:center;margin-top:1.5rem;color:#64748b;font-size:.95rem;">Thói quen hình thành trong 3–6 tuần · Hành vi thay đổi khi có môi trường liên tục · Trẻ phát triển nhanh nhất qua trải nghiệm thực tế</p>
      </div>
    </section>

    <!-- BLOCK 4: FEATURES -->
    <section class="pp-features">
      <div class="pp-features-inner">
        <h2>Lion Camp – môi trường phát triển toàn diện trong 6 tuần</h2>
        <div class="pp-feat-grid">
          <div class="pp-feat-card">
            <span class="pp-icon">🧠</span>
            <strong>Phát triển tư duy & phản biện</strong>
            <p>Giúp trẻ biết suy nghĩ, không chỉ làm theo người khác</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">🎯</span>
            <strong>Lãnh đạo bản thân</strong>
            <p>Hình thành kỷ luật và trách nhiệm cá nhân</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">💬</span>
            <strong>Giao tiếp & hợp tác</strong>
            <p>Biết làm việc nhóm và thể hiện bản thân</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">🌐</span>
            <strong>Công nghệ & AI</strong>
            <p>Biết sử dụng công nghệ đúng cách, không bị lệ thuộc</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">📱</span>
            <strong>Digital Quotient</strong>
            <p>Không bị cuốn vào điện thoại và mạng xã hội</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">🌍</span>
            <strong>Tiếng Anh giao tiếp</strong>
            <p>Sử dụng tiếng Anh trong môi trường thực tế</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">💪</span>
            <strong>Thể chất & thói quen sống</strong>
            <p>Tăng sức khoẻ và xây dựng kỷ luật cá nhân</p>
          </div>
        </div>
      </div>
    </section>

    <!-- BLOCK 5: TEXT WITH IMAGE -->
    <section class="pp-textimg">
      <div class="pp-textimg-inner">
        <div class="pp-textimg-text">
          <h2>Trẻ không thay đổi vì nghe giảng<br/>mà thay đổi vì trải nghiệm</h2>
          <p>Tại Lion Camp: Trẻ không chỉ ngồi học, không học lý thuyết đơn thuần.</p>
          <p>Mà: <strong>tham gia hoạt động thực tế, làm việc nhóm, giải quyết vấn đề</strong>.</p>
          <div class="pp-callout">Mỗi ngày, trẻ được thử — được sai — được điều chỉnh. Chính sự lặp lại này tạo ra thói quen mới, hành vi mới và sự trưởng thành thật</div>
          <p>Không phải trại hè vui chơi — mà là bước ngoặt phát triển thật sự.</p>
        </div>
        <div class="pp-textimg-img">
          <img src="https://media.truongvietanh.com/images/vui-ve-06.webp" alt="Lion Camp Trại hè Việt Anh 2026" loading="lazy" width="600" height="400" />
        </div>
      </div>
    </section>

    <!-- BLOCK 6: VALUE CARDS -->
    <section class="pp-valuecards">
      <div class="pp-valuecards-inner">
        <h2>Những giá trị trẻ nhận được sau Lion Camp</h2>
        <div class="pp-value-grid">
          <div class="pp-value-card">
            <span class="pp-icon">🧠</span>
            <strong>Tự giác hơn</strong>
            <p>Biết làm việc của mình mà không cần nhắc nhở</p>
          </div>
          <div class="pp-value-card">
            <span class="pp-icon">💬</span>
            <strong>Tự tin hơn</strong>
            <p>Dám giao tiếp và thể hiện bản thân</p>
          </div>
          <div class="pp-value-card">
            <span class="pp-icon">🎯</span>
            <strong>Có trách nhiệm hơn</strong>
            <p>Không đổ lỗi, biết tự giải quyết vấn đề</p>
          </div>
          <div class="pp-value-card">
            <span class="pp-icon">📱</span>
            <strong>Kiểm soát công nghệ</strong>
            <p>Không bị lệ thuộc vào điện thoại</p>
          </div>
          <div class="pp-value-card">
            <span class="pp-icon">🚀</span>
            <strong>Trưởng thành rõ rệt</strong>
            <p>Thay đổi thật sự trong hành vi hằng ngày</p>
          </div>
        </div>
      </div>
    </section>

    <!-- BLOCK 7: FAQ -->
    <section class="pp-faq">
      <div class="pp-faq-inner">
        <h2>Câu hỏi phụ huynh thường gặp</h2>
        <div class="pp-faq-item">
          <p class="pp-faq-q">Lion Camp có phải trại hè vui chơi không?</p>
          <p class="pp-faq-a">Không. Lion Camp là chương trình phát triển toàn diện — có cấu trúc, có mục tiêu và có hệ thống theo dõi tiến bộ. Trẻ học qua trải nghiệm, không phải ngồi nghe giảng, nhưng mọi hoạt động đều có chủ đích rõ ràng.</p>
        </div>
        <div class="pp-faq-item">
          <p class="pp-faq-q">Con có bị áp lực không?</p>
          <p class="pp-faq-a">Không. Không có điểm số, không có bài kiểm tra. Trẻ học qua làm, qua trải nghiệm và qua phản hồi từ người hướng dẫn — trong môi trường an toàn và hỗ trợ.</p>
        </div>
        <div class="pp-faq-item">
          <p class="pp-faq-q">6 tuần có cần thiết không?</p>
          <p class="pp-faq-a">Đây là thời gian tối thiểu để tạo thay đổi thật. Thói quen và hành vi cần ít nhất 3–6 tuần liên tục để hình thành — ngắn hơn thường không đủ để tạo ra sự thay đổi bền vững.</p>
        </div>
        <div class="pp-faq-item">
          <p class="pp-faq-q">Làm sao biết con thay đổi?</p>
          <p class="pp-faq-a">Qua hành vi cụ thể hằng ngày: tự giác hoàn thành việc của mình, tự tin giao tiếp, không cần nhắc điện thoại, và chịu trách nhiệm với hành động của mình.</p>
        </div>
      </div>
    </section>

    <!-- BLOCK 8: FORM -->
    <section class="pp-form-block" id="pp-form">
      <div class="pp-form-block-inner">
        <h2>Nhận tư vấn chọn chương trình phù hợp</h2>
        <p>Để lại thông tin — nhận tư vấn chương trình phù hợp, lộ trình phát triển và thông tin chi tiết Lion Camp 2026.</p>
        <ul>
          <li>Tư vấn chương trình phù hợp theo độ tuổi</li>
          <li>Lộ trình phát triển cá nhân hoá</li>
          <li>Thông tin chi tiết và học bổng Lion Camp 2026</li>
        </ul>
        <LeadFormTwoStepEmailFirst
          formId="trai-he-2026-pillar-form"
          funnelCode="trai-he-2026-pillar"
          schoolLevel="tieu-hoc"
        />
      </div>
    </section>

    <!-- BLOCK 9: LINKS -->
    <section class="pp-links">
      <div class="pp-links-inner">
        <h2>Chọn chương trình Lion Camp phù hợp</h2>
        <div class="pp-link-grid">
          <a href="/tuyen-sinh/trai-he-tieu-hoc-2026" class="pp-link-card">
            <strong>Lion Camp Tiểu học</strong>
            <span>Rèn tự lập – thói quen – kỹ năng sống</span>
          </a>
          <a href="/tuyen-sinh/trai-he-thcs-2026" class="pp-link-card">
            <strong>Lion Camp THCS</strong>
            <span>Dẫn dắt tuổi dậy thì – phát triển bản lĩnh</span>
          </a>
          <a href="/tuyen-sinh/trai-he-thpt-2026" class="pp-link-card">
            <strong>Lion Camp THPT</strong>
            <span>Định hướng tương lai – hiểu mình – chọn đường</span>
          </a>
          <a href="https://truongvietanh.com/thoi-khoa-bieu-mau-cac-khoi-lop/" class="pp-link-card">
            <strong>Thời khoá biểu mẫu các lớp</strong>
            <span>truongvietanh.com/thoi-khoa-bieu-mau-cac-khoi-lop/</span>
          </a>
        </div>
      </div>
    </section>

    <FooterBase />
  </div>

  <style>
    *, *::before, *::after { box-sizing: border-box; }
    .pp-page { font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; color: #1a1a2e; line-height: 1.6; }
    .pp-hero { background: linear-gradient(135deg, #1a1a5e 0%, #2d2d8e 100%); color: white; padding: 5rem 1.5rem; text-align: center; }
    .pp-hero-inner { max-width: 820px; margin: 0 auto; }
    .pp-h1 { font-size: 2.4rem; font-weight: 800; line-height: 1.3; margin-bottom: 1.25rem; }
    .pp-h1-accent { color: #ff5555; display: block; margin-top: .5rem; font-size: .9em; }
    .pp-subtitle { font-size: 1.1rem; opacity: .88; margin-bottom: 2.5rem; line-height: 1.75; }
    .pp-cta-row { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
    .pp-btn { display: inline-block; padding: .9rem 2rem; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 1rem; transition: opacity .2s; }
    .pp-btn:hover { opacity: .88; }
    .pp-btn-gold { background: #e8b84b; color: #1a1a2e; }
    .pp-btn-outline { background: transparent; color: white; border: 2px solid rgba(255,255,255,.7); }
    .pp-richtext { background: #fff; padding: 4.5rem 1.5rem; }
    .pp-richtext-inner { max-width: 820px; margin: 0 auto; }
    .pp-richtext h2 { font-size: 1.5rem; font-weight: 800; color: #1a1a5e; text-transform: uppercase; margin-bottom: 1.5rem; line-height: 1.4; }
    .pp-richtext p { font-size: 1.05rem; color: #334155; line-height: 1.8; margin-bottom: 1rem; }
    .pp-callout { color: #1a1a5e; font-weight: 700; font-size: 1.05rem; padding: .6rem 1rem; border-left: 3px solid #e8b84b; margin: 1.25rem 0; background: #fffbeb; border-radius: 0 6px 6px 0; }
    .pp-stats { background: #f8fafc; padding: 4rem 1.5rem; border-top: 3px solid #e2e8f0; }
    .pp-stats-inner { max-width: 900px; margin: 0 auto; }
    .pp-stats-inner > h2 { font-size: 1.5rem; font-weight: 800; color: #1a1a5e; text-transform: uppercase; text-align: center; margin-bottom: 2rem; }
    .pp-stats-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
    .pp-stats-col { background: white; border-radius: 12px; padding: 1.75rem; box-shadow: 0 2px 10px rgba(0,0,0,.05); }
    .pp-stats-col h3 { font-size: 1rem; font-weight: 700; color: #1a1a5e; margin-bottom: 1rem; border-bottom: 2px solid #e8b84b; padding-bottom: .5rem; }
    .pp-stats-col ul { list-style: none; padding: 0; margin: 0; }
    .pp-stats-col li { padding: .4rem 0 .4rem 1.5rem; position: relative; color: #475569; font-size: .95rem; }
    .pp-stats-col li::before { content: '✓'; position: absolute; left: 0; color: #22c55e; font-weight: 700; }
    .pp-features { background: #1a1a5e; color: white; padding: 4.5rem 1.5rem; }
    .pp-features-inner { max-width: 1050px; margin: 0 auto; }
    .pp-features h2 { font-size: 1.5rem; font-weight: 800; text-align: center; text-transform: uppercase; margin-bottom: 2.5rem; }
    .pp-feat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
    .pp-feat-card { background: rgba(255,255,255,.08); border-radius: 12px; padding: 1.5rem; border: 1px solid rgba(255,255,255,.12); }
    .pp-feat-card .pp-icon { font-size: 2rem; display: block; margin-bottom: .75rem; }
    .pp-feat-card strong { display: block; font-size: 1rem; margin-bottom: .5rem; }
    .pp-feat-card p { font-size: .88rem; opacity: .82; line-height: 1.65; margin: 0; }
    .pp-textimg { background: white; padding: 4.5rem 1.5rem; }
    .pp-textimg-inner { max-width: 1050px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 3.5rem; align-items: center; }
    .pp-textimg-text h2 { font-size: 1.4rem; font-weight: 800; color: #1a1a5e; text-transform: uppercase; margin-bottom: 1.25rem; line-height: 1.4; }
    .pp-textimg-text p { color: #334155; line-height: 1.8; margin-bottom: .8rem; }
    .pp-textimg-img img { width: 100%; border-radius: 16px; box-shadow: 0 8px 30px rgba(0,0,0,.12); }
    .pp-valuecards { background: #f8fafc; padding: 4rem 1.5rem; }
    .pp-valuecards-inner { max-width: 1050px; margin: 0 auto; }
    .pp-valuecards h2 { font-size: 1.5rem; font-weight: 800; color: #1a1a5e; text-transform: uppercase; text-align: center; margin-bottom: 2rem; }
    .pp-value-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
    .pp-value-card { background: white; border-radius: 12px; padding: 1.5rem; box-shadow: 0 2px 12px rgba(0,0,0,.07); border-top: 3px solid #e8b84b; }
    .pp-value-card .pp-icon { font-size: 2rem; display: block; margin-bottom: .75rem; }
    .pp-value-card strong { display: block; color: #1a1a5e; font-size: 1rem; margin-bottom: .4rem; }
    .pp-value-card p { color: #475569; font-size: .88rem; line-height: 1.6; margin: 0; }
    .pp-faq { background: white; padding: 4rem 1.5rem; }
    .pp-faq-inner { max-width: 820px; margin: 0 auto; }
    .pp-faq h2 { font-size: 1.5rem; font-weight: 800; color: #1a1a5e; text-transform: uppercase; text-align: center; margin-bottom: 2rem; }
    .pp-faq-item { border-bottom: 1px solid #e2e8f0; padding: 1.25rem 0; }
    .pp-faq-q { font-size: 1rem; font-weight: 700; color: #1a1a5e; margin-bottom: .6rem; }
    .pp-faq-a { color: #475569; font-size: .95rem; line-height: 1.75; margin: 0; }
    .pp-form-block { background: #1a1a5e; padding: 4.5rem 1.5rem; }
    .pp-form-block-inner { max-width: 580px; margin: 0 auto; text-align: center; }
    .pp-form-block h2 { color: white; font-size: 1.5rem; font-weight: 800; margin-bottom: .75rem; }
    .pp-form-block p { color: rgba(255,255,255,.82); margin-bottom: 1.5rem; line-height: 1.7; }
