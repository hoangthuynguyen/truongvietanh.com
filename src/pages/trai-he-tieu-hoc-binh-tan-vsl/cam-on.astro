  pageDescription="Báo cáo kỹ năng bé đang được gửi. Giữ suất Lion Camp Tiểu học Bình Tân chỉ với 500k."
  canonicalUrl="https://truongvietanh.com/trai-he-tieu-hoc-binh-tan-vsl/cam-on"
  schoolLevel="tieu-hoc"
  funnelCode="vsl-tieu-hoc-binh-tan"
  level="tieu-hoc"
  location="Bình Tân"
  levelLabel={c.levelLabel}
  zaloUrl={ZALO_URL}
  slotsLeft="8"
  messageHtml={c.tyMessage}
  bonusIntro={c.bonusIntro}
  bonusItems={c.bonusItems}
  ctaPrimary={c.ctaPrimaryTY}
  ctaZalo={c.ctaZaloTY}
  signOff={c.signOff}
