  pageDescription="Video 60s: Con Tiểu học sẽ thay đổi thế nào chỉ sau 1 mùa hè tại Lion Camp Cần Giuộc? Đăng ký tư vấn cá nhân hóa 1:1."
  canonicalUrl="https://truongvietanh.com/trai-he-tieu-hoc-can-giuoc-vsl"
  schoolLevel="tieu-hoc"
  funnelCode="vsl-tieu-hoc-can-giuoc"
  location="Tiểu học Cần Giuộc"
  headline={c.headline}
  microProof={c.microProof}
  subheadline={c.subheadline}
  hookParagraph={c.hookParagraph}
  hookBullets={c.hookBullets}
  benefits={c.benefits}
  finalHookLine=""
  ctaPrimary={c.ctaPrimary}
  ctaZalo={c.ctaZalo}
  zaloUrl={ZALO_URL}
