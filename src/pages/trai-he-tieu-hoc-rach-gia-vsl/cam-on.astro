---
import VSLThankYouPage from '../../components/VSLThankYouPage.astro';
import { getVSLContent, ZALO_URL } from '../../lib/vsl-configs.ts';
const c = getVSLContent('tieu-hoc', 'Rạch Giá');
---
<VSLThankYouPage
  pageTitle="Cảm Ơn – Trại Hè Tiểu Học Rạch Giá VSL | Việt Anh"
  pageDescription="Báo cáo kỹ năng bé đang được gửi. Giữ suất Lion Camp Tiểu học Rạch Giá chỉ với 500k."
  canonicalUrl="https://truongvietanh.com/trai-he-tieu-hoc-rach-gia-vsl/cam-on"
  schoolLevel="tieu-hoc"
  funnelCode="vsl-tieu-hoc-rach-gia"
  level="tieu-hoc"
  location="Rạch Giá"
  levelLabel={c.levelLabel}
  zaloUrl={ZALO_URL}
  slotsLeft="10"
  messageHtml={c.tyMessage}
  bonusIntro={c.bonusIntro}
  bonusItems={c.bonusItems}
  ctaPrimary={c.ctaPrimaryTY}
  ctaZalo={c.ctaZaloTY}
  signOff={c.signOff}
/>
