                    <th>Trung tâm IELTS</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Số tiết tiếng Anh/tuần</td>
                    <td>15+ tiết (bao gồm môn học bằng TA)</td>
