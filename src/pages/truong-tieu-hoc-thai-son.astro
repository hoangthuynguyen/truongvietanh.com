---
import SqueezePageLayout from '../layouts/SqueezePageLayout.astro';
import USPGrid from '../components/USPGrid.astro';
import TrustMetrics from '../components/TrustMetrics.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import FAQSection from '../components/FAQSection.astro';

const pageTitle = "Trường Tiểu Học Thái Sơn — Long Hậu, Cần Giuộc | Trường Việt Anh";
const pageDescription = "Trường Tiểu Học Thái Sơn — thuộc hệ thống giáo dục Việt Anh từ 2011. Tư duy phát triển, tiếng Anh bản ngữ, sức khoẻ, phẩm chất Leader in Me. Top 15 toàn cầu Leader in Me 2023. Học phí từ 1.999.500 đ/tháng (học bổng 50% — 100 suất đầu tiên). Hotline 0902 095 956.";
const pageCanonical = "https://truongvietanh.com/truong-tieu-hoc-thai-son";

const uspItems = [
  { icon: "🧠", text: "Tư duy phát triển — con tự tin học tập, hiểu bài, không học vẹt" },
  { icon: "🇬🇧", text: "Tiếng Anh nghe – hiểu – giao tiếp tự nhiên với giáo viên bản ngữ" },
  { icon: "🏆", text: "Top 15 toàn cầu Leader In Me 2023 — phẩm chất là thứ quyết định tương lai" },
  { icon: "💪", text: "Sức khoẻ được đầu tư như học thuật — 5 nguyên tắc sống khoẻ mỗi ngày" },
  { icon: "📊", text: "Hệ thống theo dõi tiến bộ minh bạch — phụ huynh cập nhật qua app hằng tuần" },
  { icon: "🎓", text: "100% học sinh tốt nghiệp đạt điểm 10 Tiếng Anh kỳ thi THPT Quốc gia (hệ thống Việt Anh)" },
];

const metrics = [
  { number: '13+', label: 'Năm hoạt động liên tục (từ 2011)' },
  { number: 'Top 15', label: 'Toàn cầu Leader In Me 2023' },
  { number: '100%', label: 'HS tốt nghiệp đạt điểm 10 TA THPT QG (hệ thống Việt Anh)' },
  { number: '50%', label: 'Học bổng học phí (100 suất đầu tiên)' },
];

const faqItems = [
  {
    question: "Trường nhận học sinh khối lớp nào?",
    answer: "Trường Tiểu Học Thái Sơn nhận học sinh từ lớp 1 đến lớp 5, theo khung chương trình của Bộ Giáo dục &amp; Đào tạo — có bổ trợ tiếng Anh bản ngữ và chương trình phẩm chất Leader In Me của Franklin Covey (Hoa Kỳ)."
  },
  {
    question: "Học phí cụ thể bao nhiêu, có học bổng không?",
    answer: "Học phí niêm yết 3.999.000 đ/tháng. Với học bổng 50% (100 suất đầu tiên), học phí thực tế còn 1.999.500 đ/tháng, tiết kiệm khoảng 19.995.000 đ/năm. Để giữ suất, vui lòng để lại email để được tư vấn và xác nhận sớm."
  },
  {
    question: "4 nền tảng quan trọng của chương trình là gì?",
    answer: "(1) Tư duy phát triển — con tự tin học tập, hiểu bài; (2) Tiếng Anh — nghe, hiểu, giao tiếp tự nhiên với GV bản ngữ; (3) Sức khoẻ — được đầu tư như học thuật; (4) Phẩm chất — thứ quyết định tương lai, rèn qua Leader In Me."
  },
  {
    question: "Leader In Me là chương trình gì?",
    answer: "Là chương trình phẩm chất lãnh đạo bản quyền của Franklin Covey (Hoa Kỳ), dựa trên 7 thói quen hiệu quả của Stephen R. Covey. Hệ thống Việt Anh đã được Top 15 toàn cầu cuộc thi Leader In Me 2023."
  },
  {
    question: "Trường có theo dõi tiến bộ học sinh không?",
    answer: "Có. 'Mọi sự tiến bộ của con đều được theo dõi rõ ràng' — phụ huynh cập nhật qua ứng dụng hằng tuần, không phụ thuộc kỳ họp phụ huynh truyền thống."
  },
  {
    question: "Đầu ra cho học sinh hệ thống Việt Anh thế nào?",
    answer: "Hệ thống Việt Anh ghi nhận: 100% học sinh tốt nghiệp THPT đạt điểm 10 môn Tiếng Anh kỳ thi THPT Quốc gia nhờ quy đổi IELTS; 100% sở hữu chứng chỉ Tin học quốc tế ICDL; nhận thẳng vào Đại học Buckinghamshire / Birmingham City (UK)."
  },
  {
    question: "Giáo viên có được đào tạo bài bản không?",
    answer: "Có. 'Giáo viên được đào tạo bài bản — không tuyển tạm.' Đội ngũ giáo viên được đào tạo theo chuẩn hệ thống Việt Anh (15 năm liên tục). Tiếng Anh do giáo viên bản ngữ đảm nhiệm trực tiếp."
  }
];
---

<SqueezePageLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={pageCanonical}
  schoolLevel="tieu-hoc"
  funnelCode="truong-tieu-hoc-thai-son"
>
  <section slot="hero">
    <h1 class="squeeze-hero__heading">Trường Tiểu Học Thái Sơn — Giáo Dục Tốt Không Phải Đặc Quyền Của Nhà Giàu</h1>
    <p class="squeeze-hero__subheading">
      Một đứa trẻ bình thường có thể trở nên phi thường nếu được lớn lên trong môi trường được thiết kế đúng. Thuộc hệ thống Việt Anh — 13+ năm liên tục, Top 15 toàn cầu Leader In Me 2023. <strong>Học phí chỉ từ 1.999.500 đ/tháng (ưu đãi học bổng 50%).</strong>
    </p>
  </section>

  <section slot="usp"><USPGrid title="Vì sao chọn Trường Tiểu Học Thái Sơn?" items={uspItems} /></section>
  <section slot="trust"><TrustMetrics title="Trường Tiểu Học Thái Sơn trong số liệu" metrics={metrics} /></section>

  <section slot="content">
    <div class="page-content">
      <h2>3 nỗi lo lớn nhất của phụ huynh khi chọn trường tiểu học</h2>
      <p>Trường Tiểu Học Thái Sơn được xây dựng để trả lời <strong>đúng 3 nỗi lo này</strong> — bằng chương trình giáo dục thực chất, hệ thống theo dõi minh bạch và mức học phí mà những gia đình đang làm việc vất vả thực sự có thể chi trả.</p>
      <div class="callout">CHÚNG TÔI KHÔNG XÂY DỰNG TRƯỜNG ĐỂ "GIỮ TRẺ".<br/>MÀ XÂY DỰNG MỘT MÔI TRƯỜNG NƠI MỖI BÉ ĐƯỢC CHĂM SÓC, THEO DÕI VÀ PHÁT TRIỂN ĐÚNG CÁCH MỖI NGÀY.</div>

      <h2>4 nền tảng quan trọng của con</h2>
      <div class="pillars">
        <div class="pillar">
          <div class="pillar-num">1</div>
          <h3>Tư duy phát triển</h3>
          <p>Con tự tin học tập, hiểu bài — không học vẹt, không sợ sai. Học sinh được rèn thói quen tư duy: đặt câu hỏi, đưa giả thuyết, thử nghiệm, rút kinh nghiệm.</p>
        </div>
        <div class="pillar">
          <div class="pillar-num">2</div>
          <h3>Tiếng Anh</h3>
          <p>Nghe, hiểu, giao tiếp tự nhiên với giáo viên bản ngữ — chứ không phải học từ vựng để thi. Lộ trình Tiếng Anh xuyên suốt từ Tiểu Học → THCS → THPT, đạt điểm 10 Tiếng Anh THPT Quốc gia.</p>
        </div>
        <div class="pillar">
          <div class="pillar-num">3</div>
          <h3>Sức khoẻ</h3>
          <p>Được đầu tư như học thuật. 5 nguyên tắc sống khoẻ mỗi ngày: <strong>Ăn tốt · Uống tốt · Nghỉ ngơi tốt · Thể dục thể thao · Niềm vui mỗi ngày</strong>.</p>
        </div>
        <div class="pillar">
          <div class="pillar-num">4</div>
          <h3>Phẩm chất</h3>
          <p>Thứ quyết định tương lai. Triển khai Leader In Me của Franklin Covey (Hoa Kỳ) — 7 thói quen hiệu quả + 5 giá trị cốt lõi. Top 15 toàn cầu Leader In Me 2023.</p>
        </div>
      </div>

      <h2>Mọi sự tiến bộ của con đều được theo dõi rõ ràng</h2>
      <p>Không còn cảnh phụ huynh chờ đến kỳ họp mới biết con đang ở đâu. Hệ thống theo dõi tiến bộ <strong>cập nhật hằng tuần qua ứng dụng</strong> — bố mẹ thấy rõ con tiến bộ về kiến thức, kỹ năng, tiếng Anh và phẩm chất.</p>
      <ul>
        <li><strong>Hằng tuần:</strong> Báo cáo tiến độ học thuật + Leader In Me</li>
        <li><strong>Hằng tháng:</strong> Họp PDR 1-1 — học sinh dẫn dắt buổi họp (không phải giáo viên báo cáo thay)</li>
        <li><strong>Hằng kỳ:</strong> Học sinh thuyết trình hành trình trước phụ huynh — 5 lần/năm</li>
      </ul>

      <h2>Đội ngũ giáo viên</h2>
      <p><strong>"Giáo viên được đào tạo bài bản — không tuyển tạm."</strong> Đội ngũ giáo viên Việt Anh được đào tạo theo chuẩn hệ thống (15 năm liên tục từ 2011). Tiếng Anh do <strong>giáo viên bản ngữ</strong> giảng dạy trực tiếp, đảm bảo phát âm chuẩn và phương pháp giao tiếp tự nhiên.</p>

      <h2>5 USP nổi bật</h2>
      <ol>
        <li><strong>13+ năm hoạt động liên tục</strong> (từ 2011) — không phải dự án thử nghiệm</li>
        <li><strong>Top 15 toàn cầu</strong> cuộc thi Leader In Me 2023</li>
        <li><strong>100% học sinh tốt nghiệp đạt điểm 10 Tiếng Anh</strong> kỳ thi THPT Quốc gia (hệ thống Việt Anh)</li>
        <li><strong>Hệ thống theo dõi tiến bộ minh bạch</strong> — cập nhật hằng tuần qua app</li>
        <li><strong>Học phí phù hợp</strong> — học bổng 50% giúp gia đình lao động tiếp cận được</li>
      </ol>

      <h2>5 nguyên tắc sức khoẻ mỗi ngày</h2>
      <p><strong>Ăn tốt</strong> · <strong>Uống tốt</strong> · <strong>Nghỉ ngơi tốt</strong> · <strong>Thể dục thể thao</strong> · <strong>Niềm vui mỗi ngày</strong> — được tích hợp vào lịch sinh hoạt của học sinh, không phải khẩu hiệu treo tường.</p>

      <h2>Học phí 2026</h2>
      <div class="fee-grid">
        <div class="fee-card">
          <div class="fee-name">Niêm yết</div>
          <div class="fee-price">3.999.000 đ<span>/tháng</span></div>
          <p>Đã bao gồm chương trình tiếng Anh bản ngữ + Leader In Me</p>
        </div>
        <div class="fee-card fee-card--feature">
          <div class="fee-name">Học bổng 50%</div>
          <div class="fee-price">1.999.500 đ<span>/tháng</span></div>
          <p>Chỉ <strong>100 suất đầu tiên</strong> — tiết kiệm ~19.995.000 đ/năm</p>
        </div>
      </div>
      <p><em>Để giữ suất học bổng, vui lòng để lại email — đội tuyển sinh phản hồi và xác nhận lịch tham quan trong 24h.</em></p>

      <h2>Lời từ Nhà sáng lập</h2>
      <blockquote class="founder-quote">
        "Giáo dục tốt không phải đặc quyền của nhà giàu. Tôi tin một đứa trẻ bình thường có thể trở nên phi thường — nếu được lớn lên trong môi trường được thiết kế đúng."<br/>
        <cite>— Nguyễn Mạnh Dương, Chủ tịch Hệ thống Trường Việt Anh</cite>
      </blockquote>

      <h2>Thông tin liên hệ</h2>
      <ul>
        <li><strong>Địa chỉ:</strong> Xã Long Hậu, huyện Cần Giuộc, tỉnh Tây Ninh (Long An cũ)</li>
        <li><strong>Hotline:</strong> 0902 095 956 — <a href="https://zalo.me/84902095956" target="_blank" rel="noopener">Zalo</a></li>
        <li><strong>Email:</strong> khai.nguyen@truongvietanh.com</li>
        <li><strong>Giờ tiếp đón:</strong> Thứ 2 – Thứ 7, 7:00 – 17:00</li>
      </ul>
    </div>
  </section>

  <section slot="form">
    <h2 class="squeeze-form-section__heading">Giữ suất học bổng 50% — Tiểu Học Thái Sơn</h2>
    <p class="squeeze-form-section__description">Chỉ 100 suất đầu tiên — học phí chỉ còn 1.999.500 đ/tháng. Đội tuyển sinh phản hồi trong 24h, đặt lịch tham quan và xác nhận suất.</p>
    <LeadFormTwoStepEmailFirst
      formId="truong-tieu-hoc-thai-son-form"
      funnelCode="truong-tieu-hoc-thai-son"
      schoolLevel="tieu-hoc"
      submitText="Giữ suất học bổng"
      successMessage="Cảm ơn! Đội tuyển sinh sẽ liên hệ trong 24h để xác nhận suất và hẹn tham quan."
    />
  </section>

  <section slot="faq"><FAQSection title="Câu hỏi thường gặp về Trường Tiểu Học Thái Sơn" items={faqItems} /></section>
</SqueezePageLayout>

<style is:inline>
  .page-content { max-width: 820px; margin: 0 auto; padding: 1rem 0; }
  .page-content h2 { color: #000080; font-size: 1.6rem; margin: 2rem 0 1rem; }
  .page-content h3 { color: #000080; font-size: 1.2rem; margin: 1.5rem 0 .75rem; }
  .page-content p { font-size: 1rem; line-height: 1.75; color: #333; margin-bottom: 1rem; }
  .page-content ul, .page-content ol { margin: 1rem 0 1rem 1.5rem; }
  .page-content li { margin-bottom: .5rem; line-height: 1.7; color: #333; }
  .page-content strong { color: #000080; font-weight: 700; }
  .page-content em { color: #475569; }
  .page-content a { color: #000080; }

  .callout { background: linear-gradient(135deg, #000080 0%, #00004d 100%); color: #ffff00; padding: 1.25rem 1.5rem; border-radius: 12px; font-weight: 700; font-family: "Montserrat", sans-serif; text-align: center; letter-spacing: .03em; margin: 1.5rem 0; line-height: 1.5; }

  .pillars { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; margin: 1.5rem 0; }
  .pillar { background: #f8faff; border: 2px solid #e6ecf7; border-radius: 12px; padding: 1.25rem 1.25rem 1.25rem 3.5rem; position: relative; }
  .pillar-num { position: absolute; top: 1.25rem; left: 1rem; width: 2rem; height: 2rem; background: #000080; color: #ffff00; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: "Montserrat", sans-serif; font-weight: 800; font-size: 1.05rem; }
  .pillar h3 { margin: 0 0 .35rem; color: #000080; font-size: 1.1rem; }
  .pillar p { margin: 0; color: #475569; font-size: .95rem; line-height: 1.6; }

  .fee-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; margin: 1.25rem 0; }
  .fee-card { background: #f8faff; border: 2px solid #e6ecf7; border-radius: 12px; padding: 1.25rem; text-align: center; }
  .fee-card--feature { border-color: #ffff00; background: linear-gradient(180deg, #fffceb 0%, #fff 100%); position: relative; }
  .fee-card--feature::before { content: "Ưu đãi"; position: absolute; top: -10px; left: 50%; transform: translateX(-50%); background: #000080; color: #ffff00; font-size: .7rem; padding: .2rem .65rem; border-radius: 999px; font-weight: 700; letter-spacing: .03em; }
  .fee-name { font-family: "Montserrat", sans-serif; font-weight: 800; color: #000080; font-size: 1.05rem; margin-bottom: .35rem; letter-spacing: .03em; text-transform: uppercase; }
  .fee-price { font-family: "Montserrat", sans-serif; font-size: 1.6rem; font-weight: 800; color: #000080; line-height: 1.1; margin-bottom: .35rem; }
  .fee-price span { font-size: .85rem; font-weight: 500; color: #64748b; }
  .fee-card p { font-size: .9rem; color: #475569; margin: 0; }

  .founder-quote { background: #f0f4ff; border-left: 4px solid #ffff00; padding: 1.25rem 1.5rem; border-radius: 8px; font-style: italic; color: #000080; font-size: 1.05rem; margin: 1.5rem 0; }
  .founder-quote cite { display: block; margin-top: .5rem; font-size: .9rem; font-style: normal; color: #475569; font-weight: 600; }
</style>
