---
import BaseLayout from '../../layouts/BaseLayout.astro';

// ============================================================================
// SALES PAGE — 100 CÔNG DÂN TOÀN CẦU — TRƯỜNG THÁI SƠN
// URL: truongvietanh.com/truong-thai-son/hoc-bong-tieng-anh-99k
// Brand: Navy #000080 + Vàng #FFFF00 + Đỏ #C00000 (riêng cho Thái Sơn)
// Mobile-first, single-file Astro page
// ============================================================================

const HERO_IMG = '/giao-vien-ban-ngu.jpg';
const HOTLINE = '0902095956';
const HOTLINE_DISPLAY = '0902 095 956';
const ZALO_OA = 'https://zalo.me/1678310120468101523';
const FB_PAGE = 'https://m.me/truongvietanhhcm';
const MAP_URL = 'https://maps.app.goo.gl/LXGsk3pwninq2WKV8';
const CANONICAL = 'https://truongvietanh.com/truong-thai-son/hoc-bong-tieng-anh-99k';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'EducationalOrganization',
    name: 'Trường Mầm non & Tiểu học Thái Sơn',
    url: CANONICAL,
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'KDC Thái Sơn, KCN Long Hậu',
      addressLocality: 'Cần Giuộc',
      addressRegion: 'Long An',
      addressCountry: 'VN',
    },
    telephone: HOTLINE_DISPLAY,
    offers: {
      '@type': 'Offer',
      name: 'Học bổng Tiếng Anh Trẻ Em',
      price: '99000',
      priceCurrency: 'VND',
    },
  },
];

const reasons = [
  { icon: '🌐', h: 'Giáo viên nước ngoài – có hồ sơ công khai', body: '1 trên 4 tiết một tuần là giáo viên bản ngữ có chứng chỉ TESOL/CELTA. Visa, bằng cấp, kinh nghiệm – tất cả công khai trên website. Anh/Chị có thể xem trước khi quyết định.', link: 'Xem hồ sơ giáo viên →' },
  { icon: '🤖', h: 'Ứng dụng AI – cá nhân hóa lộ trình từng cháu', body: 'Mỗi cháu có lộ trình học riêng do hệ thống AI thiết kế dựa trên trình độ, tốc độ tiếp thu và sở thích. AI đề xuất bài tập phù hợp, nhắc nhở ôn tập đúng thời điểm não bộ cần. Hiệu suất học tập tăng gấp 2 lần so với phương pháp đại trà truyền thống.' },
  { icon: '📊', h: 'Chia lớp theo trình độ – không theo độ tuổi', body: 'Trẻ được test đầu vào và xếp vào lớp đúng trình độ thực tế của mình. Cháu lớp 5 mới học có thể học cùng cháu lớp 2 đã có nền – miễn cùng cấp độ. Cách này khoa học hơn nhiều so với chia theo tuổi vì trẻ tiến bộ nhanh hơn khi học đúng trình độ.' },
  { icon: '📍', h: 'Trường nằm trong KCN Long Hậu', body: 'KDC Thái Sơn, ngay trong Khu công nghiệp Long Hậu, Cần Giuộc, Long An. Cách nhà bạn 5 phút đi xe. Tan ca xong dắt con qua, học xong đi bộ về nhà. Không phải đưa con vào Sài Gòn 30km.', link: 'Xem bản đồ →' },
  { icon: '💰', h: '999.000đ/tháng – tháng đầu chỉ 99.000đ', body: 'Cùng chương trình giáo viên nước ngoài, Apollo thu 3.500.000đ, ILA thu 2.800.000đ, VUS thu 2.500.000đ một tháng. Trường Thái Sơn chỉ 999.000đ. Tháng đầu 99.000đ – để Anh/Chị thử trước.' },
  { icon: '🛡️', h: 'Học thử 30 ngày – hoàn tiền 100%', body: 'Cho con học thử 30 ngày. Nếu Anh/Chị không hài lòng vì BẤT KỲ lý do gì – tôi cá nhân Nguyễn Duy Khải hoàn 100% tiền. Anh/Chị không có gì để mất.' },
];

const lessons = [
  { day: 'Tiết 1 – Thứ Hai/Thứ Ba', flag: '🇬🇧', title: 'GIÁO VIÊN NƯỚC NGOÀI – KỸ NĂNG NÓI VÀ PHÁT ÂM CHUẨN', items: ['45 phút với giáo viên bản ngữ có chứng chỉ TESOL/CELTA', 'Tập trung kỹ năng nói: phát âm, ngữ điệu, sự tự tin', 'Trẻ học theo chủ đề: gia đình, nhà trường, sở thích, du lịch', 'Học liệu chuẩn quốc tế (Cambridge, Oxford)'] },
  { day: 'Tiết 2 – Thứ Tư', flag: '🇻🇳', title: 'GIÁO VIÊN VIỆT NAM – TỪ VỰNG VÀ NGỮ PHÁP CƠ BẢN', items: ['45 phút củng cố từ vựng từ tiết với giáo viên nước ngoài', 'Giảng giải ngữ pháp bằng tiếng Việt (cho trẻ chưa nền)', 'Bài tập viết, đọc hiểu cơ bản'] },
  { day: 'Tiết 3 – Thứ Sáu', flag: '🇻🇳', title: 'GIÁO VIÊN VIỆT NAM – ĐỌC HIỂU VÀ KỸ NĂNG NGHE', items: ['45 phút luyện nghe – đọc – nói tổng hợp', 'Trò chơi tiếng Anh, video ngắn, song karaoke', 'Tăng phản xạ và tình yêu tiếng Anh'] },
  { day: 'Tiết 4 – Thứ Bảy/Chủ Nhật', flag: '🇻🇳', title: 'GIÁO VIÊN VIỆT NAM – ÔN TẬP & THỰC HÀNH GIAO TIẾP', items: ['45 phút thực hành tình huống thực tế', 'Ôn tập và đánh giá tuần học', 'Trẻ trình bày trước lớp – xây sự tự tin'] },
];

const faqs = [
  { q: 'Sau tháng đầu 99.000đ, học phí tiếp theo có linh hoạt không?', a: 'Học phí 999.000đ/tháng đóng theo từng tháng, không bắt buộc đóng cả khoá. Anh/Chị có thể dừng bất cứ lúc nào, chỉ cần báo trước 7 ngày.' },
  { q: 'Có thật là có giáo viên nước ngoài không? Hay chỉ là quảng cáo?', a: 'Có thật. Trường có giáo viên bản ngữ với chứng chỉ TESOL/CELTA, visa và giấy phép lao động Việt Nam đầy đủ. Hồ sơ công khai – Anh/Chị có thể yêu cầu xem trước khi đăng ký. Tốt nhất là Anh/Chị đến Open Day cuối tuần (tại Trường Mầm non Nhân Lễ – cùng hệ thống) để gặp trực tiếp.' },
  { q: 'Con tôi chưa biết tiếng Anh – có học được không?', a: 'Hoàn toàn được. Chương trình thiết kế cho trẻ chưa có nền tảng tiếng Anh. Lớp được chia theo trình độ – không theo độ tuổi – nên cháu sẽ học cùng các bạn cùng cấp độ. Trẻ mới sẽ vào lớp Trình độ 1 (Starters). Giáo viên Việt Nam biết tiếng Việt, hỗ trợ cháu trong giai đoạn đầu. Sau 4 tuần, cháu sẽ tự tin nói được câu đầu tiên.' },
  { q: 'Lớp học vào giờ nào? Tôi đi làm ca không tiện đưa đón.', a: 'Trường có nhiều khung giờ linh hoạt: Buổi tối các ngày trong tuần (17h30 hoặc 18h30), Cuối tuần (sáng/chiều Thứ Bảy, sáng/chiều Chủ Nhật). Đăng ký xong tư vấn viên sẽ liên hệ để xếp lịch phù hợp với Anh/Chị nhất.' },
  { q: 'Trường Thái Sơn nằm ở đâu cụ thể?', a: 'Khu Dân cư Thái Sơn, Khu công nghiệp Long Hậu, xã Long Hậu, huyện Cần Giuộc, tỉnh Long An. Cách KCN Long Hậu chính khoảng 5 phút đi xe, cách KCN Hiệp Phước (Nhà Bè) khoảng 10 phút đi xe.' },
  { q: 'Tôi muốn cho con học chính khoá tại Trường Thái Sơn năm sau – có được giảm thêm không?', a: 'Có. Phụ huynh tham gia chương trình tiếng Anh 99.000đ này được ưu tiên ghi danh chính khoá Mầm non/Tiểu học Thái Sơn năm 2026–2027 với học bổng giảm 50% học phí. Cụ thể: Mầm non được hưởng học bổng 50% trong 2 năm; Tiểu học được hưởng học bổng 50% đến hết tiểu học (5 năm). Tư vấn viên sẽ giới thiệu chi tiết khi Anh/Chị đăng ký.' },
];
---

<BaseLayout
  title="Học Bổng Tiếng Anh Trẻ Em 99.000đ – Trường Thái Sơn KCN Long Hậu"
  description="100 học bổng tiếng Anh trẻ em với giáo viên nước ngoài, chỉ 99.000đ tháng đầu. Tại Trường Thái Sơn, KCN Long Hậu. Cam kết hoàn tiền 30 ngày."
  canonical={CANONICAL}
  ogImage="https://media.truongvietanh.com/images/extra-giao-vien-va-hoc-sinh-2.webp"
  structuredData={structuredData}
  noPopup={true}
>
  <main class="ts-page">

    <!-- ============ HERO ============ -->
    <section class="ts-hero">
      <div class="ts-hero__bg" style={`background-image:url('${HERO_IMG}')`}></div>
      <div class="ts-hero__overlay"></div>
      <div class="ts-container ts-hero__inner">
        <div class="ts-hero__left">
          <p class="ts-hero__pre">🎓 100 SUẤT HỌC BỔNG ĐẶC BIỆT – TRƯỜNG THÁI SƠN</p>
          <h1 class="ts-hero__h1">
            Tiếng Anh Có Giáo Viên Nước Ngoài.<br/>
            Chỉ <span class="ts-accent">99.000đ</span> Tháng Đầu.<br/>
            Tại Trường Thái Sơn – KCN Long Hậu.
          </h1>
          <p class="ts-hero__sub">
            Cách nhà bạn 5 phút. Cam kết hoàn tiền 100% trong 30 ngày
            nếu không hài lòng vì bất kỳ lý do gì.
          </p>
          <ul class="ts-trust">
            <li><span>🏛️</span><strong>15 NĂM Việt Anh</strong> – đào tạo học sinh giỏi chuyên Anh tại TP.HCM</li>
            <li><span>🌐</span><strong>Giáo viên bản ngữ</strong> – có chứng chỉ TESOL/CELTA</li>
            <li><span>🤖</span><strong>AI cá nhân hóa</strong> – hiệu suất học tập x2</li>
            <li><span>🛡️</span><strong>Hoàn tiền 30 ngày</strong> – không cần lý do</li>
          </ul>
          <a href="#dang-ky" class="ts-cta-btn ts-cta-btn--xl ts-cta-track" data-cta="hero">
            NHẬN HỌC BỔNG NGAY – CHỈ CÒN <span data-seats>23</span> SUẤT
          </a>
          <p class="ts-hero__scarcity">⏰ Cập nhật theo thời gian thực: <strong><span data-registered>52</span> / 100</strong> phụ huynh đã đăng ký</p>
        </div>
        <div class="ts-hero__right">
          <div class="ts-video-wrap">
            <div class="ts-video-placeholder">
              <div class="ts-video-play" aria-hidden="true">▶</div>
              <span class="ts-video-text">Video sắp cập nhật</span>
            </div>
          </div>
          <p class="ts-video-caption">▶ Anh Nguyễn Duy Khải – Giám đốc Trường Thái Sơn giới thiệu chương trình</p>
        </div>
      </div>
    </section>

    <!-- ============ SOCIAL PROOF ============ -->
    <section class="ts-proof">
      <div class="ts-container">
        <p class="ts-proof__eyebrow">ĐƯỢC VẬN HÀNH BỞI HỆ THỐNG TRƯỜNG VIỆT ANH<br/>15 NĂM ĐÀO TẠO HỌC SINH GIỎI CHUYÊN ANH TẠI TP.HCM</p>
        <div class="ts-proof__counters">
          <div><strong>15</strong><span>NĂM KINH NGHIỆM VIỆT ANH</span></div>
          <div><strong>100</strong><span>SUẤT HỌC BỔNG</span></div>
          <div><strong>4</strong><span>TIẾT/TUẦN</span></div>
          <div><strong>30</strong><span>NGÀY HOÀN TIỀN VÔ ĐIỀU KIỆN</span></div>
        </div>
      </div>
    </section>

    <!-- ============ STORY ============ -->
    <section class="ts-story" id="cau-chuyen">
      <div class="ts-container ts-story__grid">
        <div class="ts-story__photo">
          <div class="ts-story__photo-frame" aria-hidden="true">
            <span>Anh Nguyễn Duy Khải</span>
          </div>
          <p class="ts-story__sig">
            <em>— Nguyễn Duy Khải</em><br/>
            Regional Manager đương nhiệm – Major Education<br/>
            Giám đốc Trường Mầm non Thái Sơn, Tiểu học Thái Sơn, Mầm non Nhân Lễ
          </p>
        </div>
        <div class="ts-story__body">
          <h2>Vì Sao Một Regional Manager Đương Nhiệm Major Education Lại Mở Trường Ở KCN Long Hậu?</h2>
          <p class="ts-story__sub"><em>Một câu chuyện cá nhân của Anh Nguyễn Duy Khải</em></p>
          <p>Tôi tên là Nguyễn Duy Khải.</p>
          <p>Tôi từng là một đứa trẻ tỉnh lẻ. Vào Sài Gòn lập nghiệp tay trắng. Tôi học tiếng Anh bằng mọi cách – đêm nào cũng nghe BBC, ngày nào cũng ép mình nói chuyện với người nước ngoài dù phát âm sai.</p>
          <p>Tiếng Anh đã đổi đời tôi. Hôm nay tôi đang là Regional Manager của Major Education – một trong những hệ thống giáo dục tiếng Anh lớn nhất Việt Nam.</p>
          <p>Nhưng có một điều tôi không thể quên: con của những phụ huynh ở khu công nghiệp như Long Hậu, Hiệp Phước – họ không có cơ hội như con nhà khá giả Sài Gòn để học tiếng Anh chuẩn từ nhỏ. Một lớp tiếng Anh giáo viên nước ngoài 2,5–3,5 triệu một tháng là quá sức với phụ huynh công nhân.</p>
          <p>Vì vậy tôi mở Trường Thái Sơn ngay trong KDC Thái Sơn, KCN Long Hậu – được vận hành bởi Hệ thống Trường Việt Anh, đơn vị đã có 15 năm kinh nghiệm đào tạo học sinh giỏi chuyên Anh tại TP.HCM. Chúng tôi mang chương trình tiếng Anh giáo viên nước ngoài kết hợp ứng dụng trí tuệ nhân tạo cá nhân hóa lộ trình học – cùng chất lượng tôi vận hành cho con nhà khá giả – về cho khu vực này, chỉ 999.000 đồng một tháng. Tháng đầu chỉ 99.000 đồng để Anh/Chị thử trước.</p>
          <p><strong>Tôi muốn con của Anh/Chị có cơ hội như tôi đã từng có.</strong></p>
        </div>
      </div>
    </section>

    <!-- ============ 6 LÝ DO ============ -->
    <section class="ts-reasons">
      <div class="ts-container">
        <h2 class="ts-h2-center">6 Lý Do Phụ Huynh KCN Long Hậu Đã Chọn Chương Trình Này</h2>
        <div class="ts-reasons__grid">
          {reasons.map(r => (
            <article class="ts-card">
              <div class="ts-card__icon">{r.icon}</div>
              <h3>{r.h}</h3>
              <p>{r.body}</p>
              {r.link && <a href="#dang-ky" class="ts-card__link">{r.link}</a>}
            </article>
          ))}
        </div>
        <div class="ts-center">
          <a href="#dang-ky" class="ts-cta-btn ts-cta-btn--xl ts-cta-track" data-cta="reasons">
            ĐĂNG KÝ NHẬN HỌC BỔNG NGAY
          </a>
        </div>
      </div>
    </section>

    <!-- ============ CHƯƠNG TRÌNH HỌC ============ -->
    <section class="ts-program">
      <div class="ts-container">
        <h2 class="ts-h2-center">Trong 4 Tiết Một Tuần, Con Bạn Sẽ Học Gì?</h2>
        <p class="ts-h2-sub">Chương trình thiết kế bởi đội ngũ chuyên gia có nhiều năm kinh nghiệm tại Major Education và các hệ thống giáo dục tiếng Anh hàng đầu Việt Nam.</p>
        <div class="ts-program__list">
          {lessons.map(l => (
            <article class="ts-lesson">
              <div class="ts-lesson__head">
                <span class="ts-lesson__day">{l.day}</span>
              </div>
              <h3 class="ts-lesson__title"><span class="ts-flag">{l.flag}</span>{l.title}</h3>
              <ul>
                {l.items.map(i => <li>{i}</li>)}
              </ul>
            </article>
          ))}
        </div>
        <div class="ts-program__info">
          <div class="ts-info-row"><span>👥</span><div><strong>SĨ SỐ MỖI LỚP: TỐI ĐA 20 TRẺ</strong><br/>Đảm bảo giáo viên có thời gian cho từng cháu</div></div>
          <div class="ts-info-row"><span>📊</span><div><strong>CHIA LỚP THEO TRÌNH ĐỘ – KHÔNG THEO ĐỘ TUỔI:</strong><ul class="ts-info-sub"><li>Trình độ 1 – Starters (mới bắt đầu, làm quen tiếng Anh)</li><li>Trình độ 2 – Movers (đã biết chữ cái, từ vựng cơ bản)</li><li>Trình độ 3 – Flyers (đã có nền tảng giao tiếp đơn giản)</li><li>Trình độ 4 – Pre-A2 (chuẩn bị nâng cao)</li></ul>Mỗi cháu được test đầu vào miễn phí trước khi xếp lớp.</div></div>
          <div class="ts-info-row"><span>🤖</span><div><strong>ỨNG DỤNG TRÍ TUỆ NHÂN TẠO:</strong><br/>Hệ thống AI cá nhân hóa lộ trình học cho từng cháu, đề xuất bài tập phù hợp, nhắc ôn tập đúng thời điểm – giúp hiệu suất học tập tăng gấp 2 lần.</div></div>
          <div class="ts-info-row"><span>📚</span><div><strong>GIÁO TRÌNH:</strong> Cambridge / Oxford – chuẩn quốc tế</div></div>
        </div>
      </div>
    </section>

    <!-- ============ BẢNG SO SÁNH GIÁ ============ -->
    <section class="ts-compare">
      <div class="ts-container">
        <h2 class="ts-h2-center">So Sánh Học Phí Tiếng Anh Có Giáo Viên Nước Ngoài Tại Khu Vực</h2>
        <div class="ts-compare__wrap">
          <table class="ts-compare__table">
            <thead>
              <tr><th>Hạng mục</th><th>Apollo</th><th>ILA</th><th>VUS</th><th class="ts-th-highlight">Trường Thái Sơn</th></tr>
            </thead>
            <tbody>
              <tr><td>Số tiết/tuần</td><td>4</td><td>4</td><td>4</td><td class="ts-td-highlight"><strong>4</strong></td></tr>
              <tr><td>Giáo viên nước ngoài</td><td>✓</td><td>✓</td><td>✓</td><td class="ts-td-highlight"><strong>✓</strong></td></tr>
              <tr><td>Học phí/tháng</td><td>3.500.000đ</td><td>2.800.000đ</td><td>2.500.000đ</td><td class="ts-td-highlight"><strong>999.000đ</strong></td></tr>
              <tr><td><strong>Tháng đầu (ưu đãi)</strong></td><td>–</td><td>–</td><td>–</td><td class="ts-td-highlight ts-td-pop"><strong>99.000đ</strong></td></tr>
              <tr><td>Khoảng cách từ KCN</td><td>25–30km</td><td>25–30km</td><td>25–30km</td><td class="ts-td-highlight"><strong>5 phút</strong></td></tr>
              <tr><td>Cam kết hoàn tiền</td><td>–</td><td>–</td><td>–</td><td class="ts-td-highlight"><strong>30 ngày</strong></td></tr>
            </tbody>
          </table>
        </div>
        <p class="ts-compare__note">* Giá tham khảo các trung tâm tại TP.HCM (cập nhật tháng 4/2025). Giá có thể thay đổi theo chi nhánh và chương trình.</p>
        <div class="ts-center">
          <a href="#dang-ky" class="ts-cta-btn ts-cta-btn--xl ts-cta-track" data-cta="compare">
