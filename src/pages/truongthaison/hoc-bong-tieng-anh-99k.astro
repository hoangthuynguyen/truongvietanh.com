<script is:inline>
(function () {
  const HOTLINE = '0902095956';
  const ZALO_OA = 'https://zalo.me/1678310120468101523';
  const FB_PAGE = 'https://m.me/truongvietanhhcm';
  const LEAD_API_URL = '/api/lead';
  const SEATS_API_URL = '/api/seats-remaining';

  // ====== Scarcity counter — fetch from API, fallback static ======
  async function loadSeats() {
    try {
      const res = await fetch(SEATS_API_URL);
      if (!res.ok) throw new Error('seat api failed');
      const data = await res.json();
      const seats = data.seats || data.remaining || 23;
      document.querySelectorAll('[data-seats]').forEach(el => { el.textContent = seats; });
      const reg = (data.registered || (100 - seats));
      document.querySelectorAll('[data-registered]').forEach(el => { el.textContent = reg; });
    } catch {
      // fallback already in DOM
    }
  }
  loadSeats();
  setInterval(loadSeats, 30000);

  // ====== Scroll fade-in ======
  const animEls = document.querySelectorAll('.ts-page section, .ts-card, .ts-lesson');
  animEls.forEach(el => el.classList.add('ts-anim-init'));
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('ts-anim-show');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.08 });
  animEls.forEach(el => io.observe(el));

  // ====== Sticky mobile CTA: show after scroll past hero ======
  const sticky = document.getElementById('tsSticky');
  const stickyClose = document.getElementById('tsStickyClose');
  let stickyDismissed = sessionStorage.getItem('ts_sticky_closed') === '1';
  function checkSticky() {
    if (stickyDismissed) return;
    const past = window.scrollY > window.innerHeight * 0.9;
    sticky.hidden = !past;
  }
  window.addEventListener('scroll', checkSticky, { passive: true });
  checkSticky();
  stickyClose && stickyClose.addEventListener('click', () => {
    sticky.hidden = true; stickyDismissed = true;
    sessionStorage.setItem('ts_sticky_closed', '1');
  });

  // ====== CTA click tracking ======
  document.querySelectorAll('.ts-cta-track').forEach(btn => {
    btn.addEventListener('click', () => {
      const loc = btn.dataset.cta || 'unknown';
      if (typeof window.fbq === 'function') {
        window.fbq('trackCustom', 'CTAClick', { cta_location: loc });
      }
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'cta_click', { cta_location: loc });
      }
    });
  });

  // ====== Scroll halfway tracking ======
  let scrollHalfFired = false;
  window.addEventListener('scroll', () => {
    if (scrollHalfFired) return;
    const pct = (window.scrollY + window.innerHeight) / document.documentElement.scrollHeight;
    if (pct >= 0.5) {
      scrollHalfFired = true;
      if (typeof window.fbq === 'function') window.fbq('trackCustom', 'ScrollHalf');
      if (typeof window.gtag === 'function') window.gtag('event', 'scroll_50_percent');
    }
  }, { passive: true });

  // ====== FORM 2-step ======
  const form = document.getElementById('tsForm');
  if (!form) return;
  const progress = form.parentElement.querySelector('.ts-progress');
  const step1 = form.querySelector('[data-step-pane="1"]');
  const step2 = form.querySelector('[data-step-pane="2"]');
  const success = form.querySelector('[data-step-pane="success"]');
  const emailInput = form.querySelector('#tsEmail');
  const nameInput = form.querySelector('#tsName');
  const phoneInput = form.querySelector('#tsPhone');

  // UTM
  const params = new URLSearchParams(window.location.search);
  const utm = {
    utm_source: params.get('utm_source') || '',
    utm_medium: params.get('utm_medium') || '',
    utm_campaign: params.get('utm_campaign') || '',
    utm_content: params.get('utm_content') || '',
    utm_term: params.get('utm_term') || '',
  };

  let leadData = { ...utm };

  function showStep(n) {
    step1.hidden = n !== 1;
    step2.hidden = n !== 2;
    success.hidden = n !== 'success';
    progress.dataset.step = n === 'success' ? 2 : n;
    if (n === 2 && nameInput) setTimeout(() => nameInput.focus(), 100);
  }

  function validEmail(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim()); }
  function validPhone(v) { return /^(0|\+84)[3-9][0-9]{8}$/.test(v.replace(/[\s.\-]/g, '')); }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const currentPane = step1.hidden ? (step2.hidden ? 'success' : 2) : 1;

    if (currentPane === 1) {
      const email = emailInput.value.trim();
      if (!validEmail(email)) {
        emailInput.classList.add('ts-input-error');
        emailInput.focus();
        return;
      }
      emailInput.classList.remove('ts-input-error');
      leadData.email = email;
      // Fire intermediate Lead event
      if (typeof window.fbq === 'function') {
        window.fbq('trackCustom', 'StepOneCompleted', { value: 99000, currency: 'VND' });
      }
      // Send partial lead
      submitLead({ ...leadData, partial: true, funnel_code: 'ts_99k' }).catch(() => {});
      showStep(2);
      return;
    }

    if (currentPane === 2) {
      const name = nameInput.value.trim();
      const phone = phoneInput.value.trim().replace(/[\s.\-]/g, '');
      let bad = false;
      if (!name || name.length < 2) { nameInput.classList.add('ts-input-error'); bad = true; } else nameInput.classList.remove('ts-input-error');
      if (!validPhone(phone)) { phoneInput.classList.add('ts-input-error'); bad = true; } else phoneInput.classList.remove('ts-input-error');
      if (bad) return;

      leadData.name = name;
      leadData.phone = phone;
      leadData.funnel_code = 'ts_99k';
      leadData.school_level = 'tieu-hoc';
      leadData.tag = 'Need_immediate_chat';

      const submitBtn = step2.querySelector('button[type="submit"]');
      submitBtn.disabled = true;
      submitBtn.textContent = 'ĐANG XỬ LÝ...';

      try {
        await submitLead(leadData);
      } catch (err) {
        console.warn('Lead submit error', err);
      }

      // Fire conversion events
      if (typeof window.fbq === 'function') {
        window.fbq('track', 'Lead', {
          value: 99000, currency: 'VND',
          content_name: '100_cong_dan_toan_cau_99k',
        });
      }
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'generate_lead', { currency: 'VND', value: 99000 });
      }
      if (typeof window.ttq !== 'undefined' && window.ttq.track) {
        window.ttq.track('SubmitForm');
      }

      showStep('success');
    }
  });

  async function submitLead(payload) {
    return fetch(LEAD_API_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
  }
})();
</script>
