---
import SqueezePageLayout from '../layouts/SqueezePageLayout.astro';
import USPGrid from '../components/USPGrid.astro';
import TrustMetrics from '../components/TrustMetrics.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import FAQSection from '../components/FAQSection.astro';

const pageTitle = "Đăng ký tư vấn tuyển sinh 1:1 — Trường Việt Anh | Trường Việt Anh";
const pageDescription = "Đội tuyển sinh phản hồi trong 24h — Hoàn toàn miễn phí, không cam kết. Cá nhân hóa lộ trình theo cấp học và mong muốn của Ba/Mẹ.";
const pageKeywords = "tư vấn tuyển sinh, đặt lịch tư vấn, tư vấn cá nhân hóa, tư vấn 1-1 trường việt anh, tư vấn miễn phí trường việt anh, đặt lịch tham quan trường";
const pageCanonical = "https://truongvietanh.com/tu-van";

const uspItems = [
    {
      "icon": "⏱️",
      "text": "Phản hồi trong 24h — không phải chờ đợi"
    },
    {
      "icon": "🎯",
      "text": "Tư vấn cá nhân hóa theo cấp học, ngân sách, vị trí"
    },
    {
      "icon": "💸",
      "text": "Cập nhật chính sách học bổng & ưu đãi đang áp dụng"
    },
    {
      "icon": "📱",
      "text": "Linh hoạt: Zalo, Video Call, gặp trực tiếp — tùy Ba/Mẹ"
    },
    {
      "icon": "🔒",
      "text": "Bảo mật thông tin tuyệt đối — không spam, không chia sẻ bên thứ 3"
    },
    {
      "icon": "🆓",
      "text": "Hoàn toàn miễn phí — không cam kết, không áp lực"
    }
  ];

const metrics = [
  { number: '15+', label: 'Năm kinh nghiệm giáo dục song ngữ' },
  { number: '3,000+', label: 'Học sinh đã và đang theo học' },
  { number: '95%', label: 'Phụ huynh hài lòng & giới thiệu bạn bè' },
  { number: '9', label: 'Cơ sở tại TP.HCM, Tây Ninh, An Giang' },
];

const faqItems = [
    {
      "question": "Tư vấn có mất phí không?",
      "answer": "Hoàn toàn miễn phí. Phụ huynh nhận trọn bộ tài liệu (học phí, học bổng, chương trình, lộ trình) và buổi tư vấn không giới hạn thời gian — không cam kết nhập học."
    },
    {
      "question": "Tôi có thể chọn khung giờ tư vấn không?",
      "answer": "Có. Sau khi Ba/Mẹ đăng ký, đội tuyển sinh sẽ liên hệ và đề xuất 3 khung giờ. Ba/Mẹ chọn khung phù hợp nhất, kể cả buổi tối hay cuối tuần."
    },
    {
      "question": "Tư vấn online có hiệu quả như gặp trực tiếp không?",
      "answer": "Có. Buổi tư vấn online qua Video Call có chia sẻ tài liệu, video tour cơ sở, demo bài học mẫu, gặp Hiệu trưởng — đầy đủ như gặp trực tiếp, tiết kiệm thời gian đi lại."
    },
    {
      "question": "Sau buổi tư vấn tôi có nhận được tài liệu không?",
      "answer": "Có. Trong vòng 1 giờ sau buổi tư vấn, Ba/Mẹ sẽ nhận email tổng hợp: học phí cấp học quan tâm, lộ trình đề xuất, video tour, link đặt lịch tham quan trực tiếp."
    },
    {
      "question": "Tôi chưa quyết định cấp học cho con — có tư vấn được không?",
      "answer": "Đặc biệt được! Đội tư vấn sẽ giúp Ba/Mẹ phân tích nhu cầu, tính cách con, ngân sách gia đình để đề xuất cấp học và cơ sở phù hợp nhất — không chỉ \"bán hàng\"."
    }
  ];
---

<SqueezePageLayout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  canonicalUrl={pageCanonical}
  schoolLevel="tieu-hoc"
  funnelCode="tu-van"
>
  <section slot="hero">
    <h1 class="squeeze-hero__heading">Đăng ký tư vấn tuyển sinh 1:1 — Trường Việt Anh</h1>
    <p class="squeeze-hero__subheading">Đội tuyển sinh phản hồi trong 24h — Hoàn toàn miễn phí, không cam kết. Cá nhân hóa lộ trình theo cấp học và mong muốn của Ba/Mẹ.</p>
  </section>

  <section slot="usp"><USPGrid title="Vì sao chọn Trường Việt Anh?" items={uspItems} /></section>
  <section slot="trust"><TrustMetrics title="Trường Việt Anh trong số liệu" metrics={metrics} /></section>

  <section slot="content">
    <div class="page-content">
      <h2>Tư vấn 1:1 — Cá nhân hóa lộ trình cho con</h2>
      <p>Mỗi gia đình có hoàn cảnh, ngân sách và mong muốn khác nhau. Đội tuyển sinh Trường Việt Anh được đào tạo để <strong>lắng nghe trước khi đề xuất</strong>, không áp đặt một giải pháp chung.</p>
        <p>Buổi tư vấn 30–45 phút sẽ làm rõ: <strong>cấp học phù hợp · cơ sở gần nhà · lộ trình học phí 3–5 năm · chính sách học bổng đang áp dụng · các bước nhập học</strong>.</p>
    </div>
  </section>

  <section slot="form">
    <h2 class="squeeze-form-section__heading">Đăng ký tư vấn miễn phí</h2>
    <p class="squeeze-form-section__description">Để lại thông tin — chúng tôi sẽ gọi/zalo/video call vào khung giờ Ba/Mẹ chọn.</p>
    <LeadFormTwoStepEmailFirst
      formId="tu-van-form"
      funnelCode="tu-van"
      schoolLevel="tieu-hoc"
      submitText="Đăng ký tư vấn ngay"
      successMessage="Cảm ơn! Đội tuyển sinh sẽ liên hệ trong 24h."
    />
  </section>

  <section slot="faq"><FAQSection title="Câu hỏi thường gặp" items={faqItems} /></section>
</SqueezePageLayout>

<style is:inline>
  .page-content { max-width: 800px; margin: 0 auto; padding: 1rem 0; }
  .page-content h2 { color: #26275D; font-size: 1.6rem; margin-bottom: 1rem; text-align: center; }
  .page-content p { font-size: 1rem; line-height: 1.75; color: #333; margin-bottom: 1rem; }
  .page-content ul { margin: 1rem 0 1rem 1.5rem; }
  .page-content li { margin-bottom: .5rem; line-height: 1.7; }
  .page-content strong { color: #26275D; font-weight: 700; }
</style>
