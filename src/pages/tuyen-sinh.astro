---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import { getPillarPage } from '../lib/directus';

const cmsPage = await getPillarPage('tuyen-sinh');
const cmsFaqs = cmsPage?.faq_items || null;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Trường Việt Anh",
    "alternateName": "Trường Liên Cấp Việt Anh",
    "url": "https://truongvietanh.com",
    "logo": "https://truongvietanh.com/logo-crest-80.webp",
    "foundingDate": "2011",
    "description": "Hệ thống giáo dục liên cấp song ngữ từ Mầm non đến THPT tại TP.HCM, Long An, Kiên Giang. Tuyển sinh năm học 2026-2027.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Hồ Chí Minh",
      "addressCountry": "VN"
    },
    "telephone": "0916961409",
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "bestRating": "5",
      "ratingCount": "300"
    },
    "numberOfEmployees": { "@type": "QuantitativeValue", "value": 500 },
    "areaServed": ["TP. Hồ Chí Minh", "Long An", "Kiên Giang"]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Trường Việt Anh tuyển sinh những cấp học nào?",
        "acceptedAnswer": { "@type": "Answer", "text": "Trường Việt Anh tuyển sinh 4 cấp: Mầm non (từ 2 tuổi), Tiểu học (lớp 1-5), THCS (lớp 6-9) và THPT (lớp 10-12) tại 9 cơ sở ở TP.HCM, Long An và Kiên Giang." }
      },
      {
        "@type": "Question",
        "name": "Quy trình đăng ký tuyển sinh Trường Việt Anh như thế nào?",
        "acceptedAnswer": { "@type": "Answer", "text": "Quy trình gồm 4 bước: Đăng ký online hoặc qua hotline → Tham quan trường miễn phí → Kiểm tra đầu vào (tuỳ cấp) → Hoàn tất hồ sơ và nhập học. Toàn bộ quy trình mất khoảng 5-7 ngày." }
      },
      {
        "@type": "Question",
        "name": "Điều kiện xét tuyển vào Trường Việt Anh là gì?",
        "acceptedAnswer": { "@type": "Answer", "text": "Mầm non: từ 2 tuổi, đủ sức khoẻ. Tiểu học: đủ 6 tuổi, phỏng vấn cùng phụ huynh. THCS: học bạ tốt, kiểm tra Toán + Tiếng Anh. THPT: điểm thi tuyển hoặc xét học bạ, phỏng vấn." }
      },
      {
        "@type": "Question",
        "name": "Thời gian tuyển sinh năm học 2026-2027 là khi nào?",
        "acceptedAnswer": { "@type": "Answer", "text": "Tuyển sinh sớm (Early Bird) từ tháng 1-3/2026 với ưu đãi giảm 10% học phí. Tuyển sinh chính thức từ tháng 4-7/2026. Nhận hồ sơ bổ sung đến hết tháng 8/2026 nếu còn chỗ." }
      },
      {
        "@type": "Question",
        "name": "Hồ sơ nhập học Trường Việt Anh cần những giấy tờ gì?",
        "acceptedAnswer": { "@type": "Answer", "text": "Hồ sơ gồm: Đơn đăng ký (theo mẫu), giấy khai sinh (bản sao công chứng), học bạ các năm trước, sổ hộ khẩu/KT3, giấy khám sức khoẻ, 4 ảnh 3x4, và bảng điểm hoặc chứng chỉ tiếng Anh (nếu có)." }
      },
      {
        "@type": "Question",
        "name": "Trường Việt Anh có chính sách học bổng không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Có. Trường có 4 loại ưu đãi: Học bổng học sinh giỏi (giảm 15-50% học phí), ưu đãi đăng ký sớm (giảm 10%), giảm 10% cho anh chị em ruột, và hỗ trợ tài chính cho gia đình khó khăn." }
      },
      {
        "@type": "Question",
        "name": "Tại sao phụ huynh chọn Trường Việt Anh thay vì trường khác?",
        "acceptedAnswer": { "@type": "Answer", "text": "Trường Việt Anh nổi bật với chương trình song ngữ IELTS 6.0-8.0, phương pháp Leader in Me rèn lãnh đạo, 16 kỹ năng WEF thế kỷ 21, học phí chỉ 5-8 triệu/tháng — bằng 1/3 trường quốc tế — và hệ thống 9 cơ sở tiện lợi." }
      },
      { "@type": "Question", "name": "Thời gian xử lý hồ sơ tuyển sinh mất bao lâu?", "acceptedAnswer": { "@type": "Answer", "text": "5-7 ngày làm việc: Ngày 1-2 đăng ký nộp hồ sơ, Ngày 3-4 kiểm tra đầu vào và phỏng vấn, Ngày 5-7 thông báo kết quả và hoàn tất thủ tục." } },
      { "@type": "Question", "name": "Con đang học trường khác có thể chuyển sang Trường Việt Anh không?", "acceptedAnswer": { "@type": "Answer", "text": "Hoàn toàn được. Nhận chuyển trường tất cả cấp học trong suốt năm học. Kiểm tra trình độ xếp lớp, có chương trình bổ trợ tiếng Anh 4-8 tuần cho học sinh chưa có nền tảng." } },
      { "@type": "Question", "name": "Có chính sách hoàn phí nếu con không phù hợp không?", "acceptedAnswer": { "@type": "Answer", "text": "Có. Hoàn phí trong 30 ngày đầu, trừ phí giữ chỗ và chi phí phát sinh. Thể hiện sự tự tin vào chất lượng giáo dục." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://truongvietanh.com" },
      { "@type": "ListItem", "position": 2, "name": "Tuyển sinh", "item": "https://truongvietanh.com/tuyen-sinh" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Event",
    "name": "Open Day Trường Việt Anh — Tham Quan Trường Miễn Phí",
    "description": "Buổi tham quan trường dành cho phụ huynh: gặp giáo viên bản ngữ, tham quan cơ sở vật chất, dự giờ lớp học mẫu, tư vấn chương trình và học phí. Hoàn toàn miễn phí.",
    "startDate": "2026-05-01",
    "endDate": "2026-08-31",
    "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
    "eventStatus": "https://schema.org/EventScheduled",
    "location": {
      "@type": "Place",
      "name": "Trường Việt Anh Phú Nhuận",
      "address": { "@type": "PostalAddress", "streetAddress": "160/72 Phan Huy Ích, phường An Hội Tây, Thành phố Hồ Chí Minh", "addressLocality": "Phú Nhuận", "addressRegion": "TP. Hồ Chí Minh", "addressCountry": "VN" }
    },
    "organizer": { "@type": "Organization", "name": "Trường Việt Anh", "url": "https://truongvietanh.com" },
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "VND", "availability": "https://schema.org/InStock", "url": "https://truongvietanh.com/tuyen-sinh" },
    "image": "https://media.truongvietanh.com/images/extra-giao-vien-va-hoc-sinh-2.webp",
    "isAccessibleForFree": true
  }
];
---

<BaseLayout
  title={cmsPage?.title || "Tuyển Sinh Việt Anh 2026 – Đăng Ký &amp; Xét Tuyển"}
  description={cmsPage?.description || "Tuyển sinh Việt Anh 2026-2027: quy trình xét tuyển, hồ sơ nhập học, học bổng. Mầm non – THPT, 9 cơ sở TP.HCM, Long An, Kiên Giang."}
  canonical="https://truongvietanh.com/tuyen-sinh"
  ogImage="https://media.truongvietanh.com/images/trang-chu-3.webp"
  structuredData={structuredData}
>
  <div class="gi-page">
    <HeaderBase />

    <!-- ====== HERO WITH FORM ====== -->
    <section class="gi-hero">
      <div class="gi-container gi-hero-inner">
        <div class="gi-hero-left">
          <nav class="gi-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Trang chủ</a>
            <span aria-hidden="true">/</span>
            <span>Tuyển sinh</span>
          </nav>

          <h1 class="gi-h1">Tuyển Sinh Trường Việt Anh — Hướng Dẫn Đăng Ký & Quy Trình Xét Tuyển</h1>
          <p class="gi-subtitle">Năm học 2026-2027 — Đăng ký sớm nhận ưu đãi giảm 10% học phí</p>
          <p class="gi-last-updated">Cập nhật lần cuối: Tháng 4, 2026</p>

          <div class="gi-hero-rating">
            <span class="gi-stars" aria-label="4.9 trên 5 sao">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            <span class="gi-rating-text">4.9/5 (300+ đánh giá từ phụ huynh)</span>
          </div>

          <div class="gi-trust-badges">
            <div class="gi-badge"><strong>15+</strong> năm kinh nghiệm</div>
            <div class="gi-badge"><strong>9</strong> cơ sở</div>
            <div class="gi-badge"><strong>12.000+</strong> học sinh</div>
            <div class="gi-badge"><strong>500+</strong> giáo viên</div>
          </div>
        </div>

        <div class="gi-hero-right">
          <div class="gi-form-card">
            <p class="gi-form-heading">Đăng ký tư vấn tuyển sinh miễn phí</p>
            <LeadFormTwoStepEmailFirst
              formId="tuyen-sinh-form"
              funnelCode="tuyen-sinh-pillar"
              schoolLevel="lien-cap"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ====== TOC SIDEBAR + CONTENT ====== -->
    <div class="gi-container gi-body">
      <p class="gi-last-updated">Cập nhật lần cuối: Tháng 4/2026</p>
      <!-- Sticky TOC sidebar -->
      <nav class="gi-toc" aria-label="Mục lục">
        <p class="gi-toc-title">Mục lục</p>
        <ol class="gi-toc-list">
          <li><a href="#cap-hoc">Các cấp tuyển sinh</a></li>
          <li><a href="#quy-trinh">Quy trình đăng ký</a></li>
          <li><a href="#dieu-kien">Điều kiện xét tuyển</a></li>
          <li><a href="#thoi-gian">Thời gian tuyển sinh</a></li>
          <li><a href="#ho-so">Hồ sơ nhập học</a></li>
          <li><a href="#hoc-bong">Học bổng & ưu đãi</a></li>
          <li><a href="#tai-sao">Tại sao chọn Việt Anh</a></li>
          <li><a href="#faq">Câu hỏi thường gặp</a></li>
        </ol>
        <a href="#tuyen-sinh-form-tuyen-sinh-pillar" class="gi-toc-cta">Đăng ký ngay</a>
      </nav>

      <!-- Main content -->
      <article class="gi-main">

        <!-- Section 1: Các cấp tuyển sinh -->
        <section id="cap-hoc" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg></span>Trường Việt Anh tuyển sinh những cấp học nào?</h2>
          <p>Trường Việt Anh tuyển sinh liên cấp từ Mầm non đến THPT, phục vụ học sinh từ 2 đến 18 tuổi. Với hệ thống 9 cơ sở tại TP.HCM, Long An và Kiên Giang, phụ huynh có thể lựa chọn cơ sở gần nhà nhất cho con em mình.</p>
          <p>Mỗi cấp học được thiết kế chương trình riêng biệt, đảm bảo sự liên tục trong phát triển kỹ năng, ngoại ngữ và phẩm chất lãnh đạo. Học sinh chuyển cấp nội bộ được ưu tiên xét tuyển và không cần thi lại đầu vào — đây là lợi thế lớn của hệ thống liên cấp.</p>

          <div class="gi-table-responsive">
            <table class="gi-table">
              <thead>
                <tr>
                  <th>Cấp học</th>
                  <th>Độ tuổi</th>
                  <th>Lớp</th>
                  <th>Chương trình nổi bật</th>
                  <th>Cơ sở tuyển sinh</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Mầm non</strong></td>
                  <td>2-5 tuổi</td>
                  <td>Lá, Mầm, Chồi, Lớn</td>
                  <td>100% Immersion, PDR (Play-Discover-Reflect)</td>
                  <td>Tất cả 9 cơ sở</td>
                </tr>
                <tr>
                  <td><strong>Tiểu học</strong></td>
                  <td>6-10 tuổi</td>
                  <td>Lớp 1 — 5</td>
                  <td>UK Curriculum, STEAM, 50% thời lượng tiếng Anh</td>
                  <td>Tất cả 9 cơ sở</td>
                </tr>
                <tr>
                  <td><strong>THCS</strong></td>
                  <td>11-14 tuổi</td>
                  <td>Lớp 6 — 9</td>
                  <td>Academic English, Leader in Me, IELTS 4.5-5.5</td>
                  <td>CS2 Bình Tân, CS4 Bình Chánh, CS5 Tân An, CS8 Rạch Giá</td>
                </tr>
                <tr>
                  <td><strong>THPT</strong></td>
                  <td>15-18 tuổi</td>
                  <td>Lớp 10 — 12</td>
                  <td>IELTS Prep 6.0-8.0, hướng nghiệp, du học</td>
                  <td>CS4 Bình Chánh (liên cấp)</td>
                </tr>
              </tbody>
            </table>
          </div>

          <img src="https://media.truongvietanh.com/images/phu-huynh-02.webp" alt="Ngày hội tuyển sinh Trường Việt Anh" loading="lazy" width="1200" height="auto" class="section-img" />

          <p>Chương trình song ngữ tại Trường Việt Anh được xây dựng theo mô hình Immersion (đắm chìm ngôn ngữ) từ Mầm non, chuyển dần sang UK Curriculum ở Tiểu học, và luyện thi IELTS chuyên sâu tại THCS-THPT. Phương pháp này giúp học sinh phát triển tiếng Anh tự nhiên, không bị áp lực quá tải, và đạt đầu ra IELTS 6.0-8.0 khi tốt nghiệp lớp 12. Tìm hiểu thêm về <a href="/cap-hoc">chương trình từng cấp học</a> hoặc <a href="/gioi-thieu">triết lý giáo dục của Trường Việt Anh</a>.</p>

          <div class="gi-evidence-bar">
            <div class="gi-evidence-item">
              <strong>4</strong>
              <span>Cấp học</span>
            </div>
            <div class="gi-evidence-item">
              <strong>9</strong>
              <span>Cơ sở</span>
            </div>
            <div class="gi-evidence-item">
              <strong>12.000+</strong>
              <span>Học sinh</span>
            </div>
            <div class="gi-evidence-item">
              <strong>3</strong>
              <span>Tỉnh thành</span>
            </div>
          </div>
        </section>

        <!-- Section 2: Quy trình đăng ký -->
        <section id="quy-trinh" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></span>Quy trình đăng ký tuyển sinh như thế nào?</h2>
          <p>Quy trình tuyển sinh tại Trường Việt Anh gồm 4 bước đơn giản, từ đăng ký online đến nhập học chính thức. Toàn bộ quy trình thường hoàn tất trong 5-7 ngày làm việc, giúp phụ huynh tiết kiệm thời gian tối đa.</p>
          <p>Trường khuyến khích phụ huynh đăng ký tham quan trước khi quyết định, để con em được trải nghiệm trực tiếp môi trường học tập và gặp gỡ đội ngũ giáo viên. Buổi tham quan hoàn toàn miễn phí và không ràng buộc.</p>

          <div class="gi-roadmap">
            <h3>4 bước đăng ký tuyển sinh</h3>
            <div class="gi-roadmap-grid">
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">B1</div>
                <strong>Đăng ký online</strong>
                <p>Điền form trên website hoặc gọi hotline <strong>0916 961 409</strong>. Tư vấn viên sẽ liên hệ trong vòng 24 giờ để xác nhận thông tin và sắp xếp lịch tham quan trường.</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">B2</div>
                <strong>Tham quan trường</strong>
                <p>Phụ huynh và con em được tham quan cơ sở vật chất, gặp ban giám hiệu, dự giờ lớp học mẫu. Buổi tham quan kéo dài khoảng 60-90 phút.</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">B3</div>
                <strong>Kiểm tra đầu vào</strong>
                <p>Tuỳ cấp học: Mầm non không kiểm tra. Tiểu học phỏng vấn nhẹ. THCS/THPT kiểm tra Toán, Tiếng Việt, Tiếng Anh để xếp lớp phù hợp năng lực.</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">B4</div>
                <strong>Nhập học</strong>
                <p>Nộp hồ sơ đầy đủ, đóng phí giữ chỗ, nhận lịch học và đồng phục. Học sinh bắt đầu chương trình hội nhập (Orientation) trong tuần đầu tiên.</p>
              </div>
            </div>
          </div>

          <img src="https://media.truongvietanh.com/images/giao-vien-25.webp" alt="Giáo viên tư vấn tuyển sinh Trường Việt Anh" loading="lazy" width="1200" height="auto" class="section-img" />

          <p>Phụ huynh có thể đăng ký cho con em nhập học bất kỳ thời điểm nào trong năm học nếu cơ sở còn chỗ trống. Tuy nhiên, đăng ký đầu năm học sẽ nhận được nhiều ưu đãi hơn và đảm bảo suất học cho con. Trường cũng hỗ trợ chương trình hội nhập đặc biệt cho học sinh chuyển trường giữa kỳ, giúp các em thích nghi nhanh chóng với môi trường mới. Xem chi tiết <a href="/hoc-phi">bảng học phí từng cấp</a> và <a href="/co-so">hệ thống 9 cơ sở</a> để chọn cơ sở gần nhà nhất.</p>
        </section>

        <!-- Section 3: Điều kiện xét tuyển -->
        <section id="dieu-kien" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></span>Điều kiện xét tuyển từng cấp học tại Trường Việt Anh?</h2>
          <p>Điều kiện xét tuyển khác nhau theo từng cấp học, nhưng Trường Việt Anh luôn ưu tiên đánh giá toàn diện thay vì chỉ dựa vào điểm số. Trường tìm kiếm những học sinh có tinh thần ham học, phẩm chất tốt và phụ huynh đồng hành cùng triết lý giáo dục của trường.</p>
          <p>Không giống nhiều trường tư khác, Trường Việt Anh không phân biệt hộ khẩu — học sinh từ tất cả các tỉnh thành đều được xét tuyển bình đẳng. Hệ thống xe đưa rước phục vụ tại các cơ sở TP.HCM, giúp học sinh ở xa vẫn đi học thuận tiện.</p>

          <div class="gi-campus-groups">
            <div class="gi-campus-group">
              <h3>Mầm non (2-5 tuổi)</h3>
              <ul>
                <li><strong>Độ tuổi:</strong> Đủ 2 tuổi trở lên tính đến ngày nhập học</li>
                <li><strong>Sức khoẻ:</strong> Giấy khám sức khoẻ, tiêm chủng đầy đủ theo quy định Bộ Y tế</li>
                <li><strong>Kiểm tra:</strong> Không kiểm tra đầu vào — chỉ phỏng vấn phụ huynh ngắn để hiểu nhu cầu và đặc điểm phát triển của bé</li>
                <li><strong>Ghi chú:</strong> Nhận hồ sơ quanh năm, ưu tiên đăng ký sớm do số lượng giới hạn mỗi lớp chỉ 20-25 bé</li>
              </ul>
            </div>
            <div class="gi-campus-group">
              <h3>Tiểu học (Lớp 1-5)</h3>
              <ul>
                <li><strong>Lớp 1:</strong> Đủ 6 tuổi theo quy định, phỏng vấn cùng phụ huynh để đánh giá sự sẵn sàng đi học</li>
                <li><strong>Lớp 2-5 (chuyển cấp):</strong> Học bạ các năm trước đạt loại Tốt hoặc Khá, kiểm tra xếp lớp Tiếng Anh để bố trí lớp phù hợp</li>
                <li><strong>Ưu tiên:</strong> Học sinh nội bộ chuyển cấp từ Mầm non Việt Anh được xét trực tiếp, không cần kiểm tra thêm</li>
                <li><strong>Hồ sơ bổ sung:</strong> Bảng điểm tiếng Anh, chứng chỉ Cambridge YLE (nếu có) sẽ được cộng điểm ưu tiên xếp lớp nâng cao</li>
              </ul>
            </div>
            <div class="gi-campus-group">
              <h3>THCS (Lớp 6-9)</h3>
              <ul>
                <li><strong>Lớp 6:</strong> Hoàn thành chương trình Tiểu học, kiểm tra xếp lớp Toán + Tiếng Anh + Tiếng Việt (thời lượng 90 phút)</li>
                <li><strong>Lớp 7-9 (chuyển trường):</strong> Học bạ đạt loại Khá trở lên, kiểm tra xếp lớp 3 môn tương tự lớp 6</li>
                <li><strong>Phỏng vấn:</strong> Phỏng vấn cá nhân với ban giám hiệu để đánh giá thái độ học tập, nguyện vọng và mục tiêu của học sinh</li>
                <li><strong>Mục tiêu đầu ra:</strong> IELTS 4.5-5.5 khi kết thúc lớp 9, sẵn sàng cho chương trình IELTS Prep THPT</li>
              </ul>
            </div>
            <div class="gi-campus-group">
              <h3>THPT (Lớp 10-12)</h3>
              <ul>
                <li><strong>Lớp 10:</strong> Điểm thi tuyển sinh lớp 10 (theo quy định Sở GD&ĐT) hoặc xét tuyển bằng học bạ 4 năm THCS</li>
                <li><strong>Lớp 11-12 (chuyển trường):</strong> Học bạ THPT đạt loại Khá trở lên, kiểm tra năng lực 3 môn: Toán, Văn, Tiếng Anh</li>
                <li><strong>Phỏng vấn:</strong> Phỏng vấn bằng tiếng Anh để đánh giá trình độ ngoại ngữ và định hướng nghề nghiệp, du học</li>
                <li><strong>Ưu đãi:</strong> Học sinh có IELTS 5.0+ hoặc chứng chỉ quốc tế được xét ưu tiên và miễn kiểm tra tiếng Anh đầu vào</li>
              </ul>
            </div>
          </div>
        </section>

