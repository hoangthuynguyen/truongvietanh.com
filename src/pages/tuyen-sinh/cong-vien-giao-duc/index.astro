---
import SqueezePageLayout from '../../../layouts/SqueezePageLayout.astro';

const pageTitle = 'Công Viên Giáo Dục — Nơi 1.000 Đứa Trẻ Hạnh Phúc Lớn Lên Khác Biệt | Trường Việt Anh';
const pageDescription = 'KHÔNG BÁN VÉ. KHÔNG MỞ CỬA ĐẠI TRÀ. Chỉ dành cho thành viên nội bộ. Trở thành hội viên miễn phí 6 tháng bằng cách mời 2 người bạn có con 1–8 tuổi cùng tham gia. Dành cho Ba/Mẹ muốn con tránh xa màn hình, vận động ngoài trời, phát triển thể chất và cảm xúc.';
const pageCanonical = 'https://truongvietanh.com/tuyen-sinh/cong-vien-giao-duc';
const funnelCode = 'cong-vien-giao-duc';

const MEDIA = 'https://media.truongvietanh.com/images';
const heroImage = `${MEDIA}/da-ngoai/hoc-sinh-di-da-ngoai-1.webp`;
const galleryImages = [
  { src: `${MEDIA}/khong-gian-the-thao/hoc-sinh-chay-bo-1.webp`, alt: 'Bé vận động ngoài trời, chạy nhảy tự do' },
  { src: `${MEDIA}/vui-ve/hoc-sinh-choi-vui-ve-1.webp`, alt: 'Bé vui chơi cùng bạn ngoài sân' },
  { src: `${MEDIA}/da-ngoai/hoc-sinh-di-da-ngoai-1.webp`, alt: 'Bé khám phá thiên nhiên trong hoạt động dã ngoại' },
  { src: `${MEDIA}/khong-gian-the-thao/hoc-sinh-choi-the-thao-1.webp`, alt: 'Bé chơi thể thao ngoài trời' },
  { src: `${MEDIA}/vui-ve/hoc-sinh-choi-1.webp`, alt: 'Bé chơi nhóm, phát triển kỹ năng kết bạn' },
  { src: `${MEDIA}/da-ngoai/20250821-22-hon-bo-dap-07727.webp`, alt: 'Bé hòa mình với thiên nhiên trong dã ngoại' },
  { src: `${MEDIA}/khong-gian-the-thao/hoc-sinh-boi.webp`, alt: 'Bé vận động trong hồ bơi an toàn' },
  { src: `${MEDIA}/vui-ve/hoc-sinh-choi-tro-choi-45.webp`, alt: 'Bé chơi trò chơi vận động phát triển kỹ năng' },
  { src: `${MEDIA}/da-ngoai/20250821-22-hon-bo-dap2-06104.webp`, alt: 'Bé khám phá môi trường xung quanh' },
];

const campuses = [
  { value: 'viet-anh', label: 'Trường Mầm non Việt Anh — 573 Lê Đức Thọ, P16, Gò Vấp, TP.HCM', map: 'https://maps.app.goo.gl/5PXx5P9PAmXM5wWv5' },
  { value: 'nhan-le', label: 'Trường Mầm non Nhân Lễ — 22 Đường D2, KDC Long Hậu, Cần Giuộc, Long An', map: 'https://maps.app.goo.gl/ik7LL54j2szydWGZ9' },
  { value: 'mekong-xanh', label: 'Mầm non & Tiểu học Mekong Xanh — Lô E7, KĐT Tây Bắc, Rạch Giá, An Giang', map: 'https://maps.app.goo.gl/VHG5dxeEtan3wGjz6' },
];
---

<SqueezePageLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={pageCanonical}
  schoolLevel="mau-non"
  funnelCode={funnelCode}
>
  <section slot="hero">
    <span class="cvgd-badge">Chỉ dành cho thành viên nội bộ</span>
    <h1 class="squeeze-hero__heading">CÔNG VIÊN GIÁO DỤC</h1>
    <p class="squeeze-hero__sub"><strong>Nơi 1.000 đứa trẻ hạnh phúc sẽ bắt đầu hành trình lớn lên khác biệt.</strong></p>
    <div class="cvgd-rules">
      <div class="cvgd-rule">KHÔNG BÁN VÉ</div>
      <div class="cvgd-rule">KHÔNG MỞ CỬA ĐẠI TRÀ</div>
      <div class="cvgd-rule cvgd-rule--accent">CHỈ DÀNH CHO THÀNH VIÊN NỘI BỘ</div>
    </div>
    <p class="cvgd-hero-cta-line">
      Và để trở thành thành viên, bạn chỉ cần làm một việc duy nhất:<br/>
      <strong>Mời 2 người bạn có con từ 1–8 tuổi cùng tham gia.</strong>
    </p>
  </section>

  <section slot="content">
    <div class="cvgd-content">
      <div class="cvgd-panel">
        <h2 class="cvgd-h2">Nếu bạn là cha mẹ của trẻ 1–8 tuổi, hãy đọc kỹ</h2>
        <p class="cvgd-lead">
          <strong>7 năm đầu đời quyết định hơn 70% nền tảng trí tuệ, cảm xúc và nhân cách của trẻ.</strong>
        </p>
        <p class="cvgd-para">Nhưng hầu hết trẻ em hiện nay lớn lên trong:</p>
        <ul class="cvgd-pains">
          <li>📱 Màn hình điện thoại</li>
          <li>🏠 Không gian 4 bức tường chật hẹp</li>
          <li>🧠 Thiếu môi trường kích thích tư duy đúng chuẩn</li>
        </ul>
        <p class="cvgd-para">
          Vì vậy, chúng tôi xây dựng một nơi hoàn toàn khác cho những ngày cuối tuần của trẻ tại:
        </p>

        <ol class="cvgd-campuses">
          {campuses.map((c, i) => (
            <li>
              <a href={c.map} target="_blank" rel="noopener noreferrer">
                <span class="cvgd-campus__num">{i + 1}</span>
                <span class="cvgd-campus__text">{c.label}</span>
                <span class="cvgd-campus__go">Xem bản đồ →</span>
              </a>
            </li>
          ))}
        </ol>
      </div>

      <div class="cvgd-gallery-intro">
        <h2 class="cvgd-h2">Một ngày tại Công viên Giáo dục</h2>
        <p class="cvgd-para">Mỗi cuối tuần, các bé được vận động – khám phá – vui chơi cùng bạn trong một không gian rộng rãi, an toàn và đầy ánh nắng.</p>
      </div>

      <div class="cvgd-gallery">
        {galleryImages.map((img) => (
          <figure>
            <img src={img.src} alt={img.alt} loading="lazy" width="1200" height="800" />
          </figure>
        ))}
      </div>

      <div class="cvgd-panel cvgd-panel--highlight">
        <h2 class="cvgd-h2">🎯 Ở Công viên Giáo dục, các con sẽ</h2>
        <ul class="cvgd-benefits">
          <li><span>🏃</span><div><strong>Vận động ngoài trời</strong><p>Thoát khỏi bốn bức tường, được chạy nhảy, leo trèo, tiếp xúc với đất – nước – cây xanh.</p></div></li>
          <li><span>🔍</span><div><strong>Tự khám phá bản thân</strong><p>Không gian an toàn để con thử nghiệm, chọn lựa và phát triển tính độc lập từ sớm.</p></div></li>
          <li><span>❤️</span><div><strong>Phát triển cảm xúc</strong><p>Các hoạt động nhóm giúp con hiểu cảm xúc của mình và kết nối với bạn bè.</p></div></li>
          <li><span>🥗</span><div><strong>Làm quen với thức ăn vì sức khỏe</strong><p>Tự trồng, tự chọn, tự nếm — con hiểu đồ ăn tốt không phải là khái niệm trừu tượng.</p></div></li>
          <li><span>💪</span><div><strong>Kiểm tra thể chất định kỳ</strong><p>Đo chiều cao, cân nặng, sức bền — biết con đang mạnh lên mỗi tuần.</p></div></li>
        </ul>
      </div>

      <div class="cvgd-panel">
        <h2 class="cvgd-h2">Ai nên tham gia?</h2>
        <ul class="cvgd-who">
          <li>✅ Cha mẹ muốn con khỏe mạnh và thông minh thật sự</li>
          <li>✅ Gia đình muốn con tránh xa màn hình</li>
          <li>✅ Những người sẵn sàng hành động thay vì chỉ lo lắng</li>
        </ul>
        <p class="cvgd-para cvgd-para--emphasis">Nếu bạn thấy mình trong đó, đừng chờ đợi.</p>
      </div>

      <div class="cvgd-panel cvgd-panel--steps">
        <h2 class="cvgd-h2">Cách trở thành hội viên</h2>
        <ol class="cvgd-steps">
          <li><strong>Bước 1:</strong> Điền thông tin đăng ký</li>
          <li><strong>Bước 2:</strong> Mời 2 người bạn cùng tham gia (ghi tên + SĐT của họ ngay trong form)</li>
          <li><strong>Bước 3:</strong> Nhận thẻ hội viên <strong>6 tháng miễn phí</strong></li>
        </ol>
        <p class="cvgd-para">Vậy là xong.</p>
        <ul class="cvgd-no">
          <li>✘ Không phí tham gia</li>
          <li>✘ Không ràng buộc tài chính</li>
          <li>✔ Chỉ cần bạn lan tỏa giá trị</li>
        </ul>
      </div>

      <div class="cvgd-limit">
        <p>
          <strong>⏳ Chúng tôi giới hạn số gia đình tham gia mỗi đợt để đảm bảo chất lượng.</strong><br/>
          Khi đủ số lượng, hệ thống sẽ đóng đăng ký. Ưu tiên đăng ký sớm.
        </p>
      </div>
    </div>
  </section>

  <section slot="form">
    <div class="cvgd-form-intro">
      <h2 class="squeeze-form-section__heading">Đăng ký hội viên Công viên Giáo dục</h2>
      <p class="squeeze-form-section__description">
        Điền 1 phiếu duy nhất bao gồm thông tin của bạn và 2 người bạn được mời. Hoàn toàn miễn phí — không phí tham gia, không ràng buộc.
      </p>
    </div>

    <form id="cvgd-form" class="cvgd-form" novalidate>
      <fieldset class="cvgd-fieldset">
        <legend>1. Thông tin của bạn</legend>
        <label>
          <span>Họ và tên <em>*</em></span>
          <input type="text" name="parent_name" required minlength="2" autocomplete="name" placeholder="Nguyễn Văn A" />
        </label>
        <label>
          <span>Số điện thoại <em>*</em></span>
          <input type="tel" name="parent_phone" required pattern="[0-9\+\-\s]{9,}" autocomplete="tel" placeholder="09xx xxx xxx" />
        </label>
        <label>
          <span>Công viên tham gia <em>*</em></span>
          <select name="campus" required>
            <option value="">— Chọn nơi gần nhất —</option>
            {campuses.map((c) => <option value={c.value}>{c.label}</option>)}
          </select>
        </label>
      </fieldset>

      <fieldset class="cvgd-fieldset">
        <legend>2. Người bạn được mời (1/2)</legend>
        <label>
          <span>Họ và tên <em>*</em></span>
          <input type="text" name="ref1_name" required minlength="2" placeholder="Trần Thị B" />
        </label>
        <label>
          <span>Số điện thoại <em>*</em></span>
          <input type="tel" name="ref1_phone" required pattern="[0-9\+\-\s]{9,}" placeholder="09xx xxx xxx" />
        </label>
      </fieldset>

      <fieldset class="cvgd-fieldset">
        <legend>3. Người bạn được mời (2/2)</legend>
        <label>
          <span>Họ và tên <em>*</em></span>
          <input type="text" name="ref2_name" required minlength="2" placeholder="Lê Văn C" />
        </label>
        <label>
          <span>Số điện thoại <em>*</em></span>
          <input type="tel" name="ref2_phone" required pattern="[0-9\+\-\s]{9,}" placeholder="09xx xxx xxx" />
        </label>
      </fieldset>

      <button type="submit" class="cvgd-submit">Đăng ký nhận thẻ hội viên 6 tháng</button>
      <p class="cvgd-consent">
        Bằng cách nhấn gửi, bạn đồng ý cho Trường Việt Anh liên hệ bạn và 2 người bạn được mời qua SĐT / Zalo để xác nhận.
      </p>
    </form>
  </section>
</SqueezePageLayout>

<script is:inline>
(function () {
  const form = document.getElementById('cvgd-form');
  if (!form) return;

  const LEAD_API_URL = '/api/lead';
  const FUNNEL_CODE = 'cong-vien-giao-duc';

  const urlParams = new URLSearchParams(window.location.search);
  const utm = {
    utm_source: urlParams.get('utm_source') || '',
    utm_medium: urlParams.get('utm_medium') || '',
    utm_campaign: urlParams.get('utm_campaign') || '',
    utm_term: urlParams.get('utm_term') || '',
    utm_content: urlParams.get('utm_content') || '',
    referrer: document.referrer || '',
    landing_page: window.location.pathname,
  };

  function isValidPhone(p) { return /^[0-9\+\-\s\(\)]{9,}$/.test((p || '').replace(/\s/g, '')); }
  function showError(msg) {
    const box = form.querySelector('.cvgd-error') || (function () {
      const d = document.createElement('div');
      d.className = 'cvgd-error';
      form.insertBefore(d, form.querySelector('.cvgd-submit'));
      return d;
    })();
    box.textContent = msg;
    box.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  async function postLead(payload) {
    const body = Object.assign({}, payload, utm, {
      funnel_code: FUNNEL_CODE,
      school_level: 'mau-non',
      page: window.location.href,
      form_id: 'cvgd-form',
      timestamp: new Date().toISOString(),
    });
    try {
      const r = await fetch(LEAD_API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      return r.ok;
    } catch (e) {
      return false;
    }
  }

  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    const fd = new FormData(form);
    const parentName = (fd.get('parent_name') || '').toString().trim();
    const parentPhone = (fd.get('parent_phone') || '').toString().trim();
    const campus = (fd.get('campus') || '').toString().trim();
    const ref1Name = (fd.get('ref1_name') || '').toString().trim();
    const ref1Phone = (fd.get('ref1_phone') || '').toString().trim();
    const ref2Name = (fd.get('ref2_name') || '').toString().trim();
    const ref2Phone = (fd.get('ref2_phone') || '').toString().trim();

    if (!parentName || !isValidPhone(parentPhone) || !campus) {
      showError('Vui lòng điền đầy đủ thông tin của bạn.');
      return;
    }
    if (!ref1Name || !isValidPhone(ref1Phone) || !ref2Name || !isValidPhone(ref2Phone)) {
      showError('Vui lòng điền đầy đủ thông tin 2 người bạn được mời.');
      return;
    }
    if ([parentPhone, ref1Phone, ref2Phone].map((p) => p.replace(/\s/g, '')).some((p, i, a) => a.indexOf(p) !== i)) {
      showError('Số điện thoại bị trùng. Vui lòng kiểm tra lại.');
      return;
    }

    const submitBtn = form.querySelector('.cvgd-submit');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Đang gửi...';

    if (window.dataLayer) {
      window.dataLayer.push({ event: 'form_submit', form_id: 'cvgd-form', funnel: FUNNEL_CODE });
    }

    const leads = [
      {
        full_name: parentName,
        phone: parentPhone,
        email: '',
        campus_ref: campus,
        role: 'registrant',
        notes: 'Đăng ký hội viên Công viên Giáo dục',
      },
      {
        full_name: ref1Name,
        phone: ref1Phone,
        email: '',
        campus_ref: campus,
        role: 'referred',
        notes: 'Được giới thiệu bởi: ' + parentName + ' (' + parentPhone + ')',
      },
      {
        full_name: ref2Name,
        phone: ref2Phone,
        email: '',
        campus_ref: campus,
        role: 'referred',
        notes: 'Được giới thiệu bởi: ' + parentName + ' (' + parentPhone + ')',
      },
    ];

    const results = await Promise.all(leads.map(postLead));
    const primaryOk = results[0];

    if (primaryOk) {
      const qs = new URLSearchParams({ name: parentName, campus: campus });
      window.location.href = '/tuyen-sinh/cong-vien-giao-duc/cam-on?' + qs.toString();
    } else {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Đăng ký nhận thẻ hội viên 6 tháng';
      showError('Có lỗi khi gửi. Vui lòng gọi 0916 961 409 để được hỗ trợ.');
    }
  });
})();
</script>

<style is:inline>
  /* Hide empty layout sections not used by this page */
  section.squeeze-usp,
  section.squeeze-trust,
  section.squeeze-faq { display: none !important; }

  /* Hero: phối cảnh campus với overlay tối navy */
  section.squeeze-hero {
    background:
      linear-gradient(160deg, rgba(0,0,80,0.72) 0%, rgba(0,0,100,0.68) 50%, rgba(0,0,60,0.72) 100%),
      url('/cong-vien-giao-duc-phoi-canh.png') center / cover no-repeat !important;
    color: #fff !important;
    min-height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  section.squeeze-hero .squeeze-hero__heading,
  section.squeeze-hero .squeeze-hero__sub,
  section.squeeze-hero .cvgd-hero-cta-line { color: #fff !important; }

  .cvgd-badge {
    display: inline-block;
    background: rgba(255, 255, 0, 0.18);
    color: #ffff00;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.5px;
    margin-bottom: 1rem;
    border: 1px solid rgba(255, 255, 0, 0.5);
  }
  .cvgd-rules {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin: 1.25rem 0;
  }
  .cvgd-rule {
    background: #1a1a5e;
    color: #fff;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.3px;
  }
  .cvgd-rule--accent {
    background: linear-gradient(135deg, #F0D048, #b8922e);
  }
  .cvgd-hero-cta-line {
    max-width: 640px;
    margin: 0.75rem auto 0;
    color: #2d2d42;
    line-height: 1.7;
  }

  .cvgd-content { max-width: 960px; margin: 0 auto; display: grid; gap: 1.5rem; }

  .cvgd-hero-img {
    margin: 0;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(26, 26, 94, 0.12);
  }
  .cvgd-hero-img img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: cover;
  }

  .cvgd-gallery-intro { text-align: center; padding: 0.5rem 0 0; }
  .cvgd-gallery-intro .cvgd-h2 { margin-bottom: 0.5rem; }
  .cvgd-gallery-intro .cvgd-para { max-width: 640px; margin: 0 auto; color: #475569; }

  .cvgd-gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }
  .cvgd-gallery figure { margin: 0; border-radius: 12px; overflow: hidden; }
  .cvgd-gallery img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .cvgd-gallery figure:hover img { transform: scale(1.05); }

  .cvgd-panel {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    padding: 1.75rem 1.5rem;
  }
  .cvgd-panel--highlight {
    background: linear-gradient(180deg, #fdf7e6 0%, #ffffff 100%);
    border-color: rgba(240, 208, 72, 0.4);
  }
  .cvgd-panel--steps { border-left: 4px solid #F0D048; }
  .cvgd-h2 {
    color: #1a1a5e;
    margin-bottom: 1rem;
    line-height: 1.3;
  }
  .cvgd-lead { font-size: 1.15rem; line-height: 1.65; margin-bottom: 1rem; color: #1a1a5e; }
  .cvgd-para { line-height: 1.7; margin-bottom: 1rem; color: #2d2d42; }
  .cvgd-para--emphasis { font-weight: 700; color: #1a1a5e; font-size: 1.15rem; }
  .cvgd-pains {
    list-style: none; padding: 0; margin: 0 0 1.25rem; display: grid; gap: 0.5rem;
  }
  .cvgd-pains li {
    padding: 0.75rem 1rem; background: #fef2f2; border-left: 3px solid #dc2626;
    border-radius: 8px; font-weight: 600; color: #7f1d1d;
  }
  .cvgd-campuses { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem; }
  .cvgd-campuses a {
    display: grid; grid-template-columns: auto 1fr auto; gap: 1rem; align-items: center;
    padding: 1rem 1.25rem; background: #f8f9fb; border: 1px solid #e5e7eb;
    border-radius: 10px; color: #1a1a5e; text-decoration: none; transition: all 0.2s;
  }
  .cvgd-campuses a:hover { background: #fff; border-color: #F0D048; transform: translateY(-2px); }
  .cvgd-campus__num {
