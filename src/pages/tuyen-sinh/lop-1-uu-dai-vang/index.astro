    var email = phone.replace(/[^0-9]/g, '') + '@no-email.truongvietanh.com';

    var body = Object.assign({
      parent_name:  name,
      phone:        phone,
      email:        email,
      // worker normalizeFormData() KHÔNG đọc 'note' → gửi kèm child_name để lời nhắn
      // thật sự tới được người gọi (GHL custom field "Tên con"). Pancake hiện chưa có
      // ô free-text cho lời nhắn — muốn hiện bên Pancake thì phải sửa worker.
      note:         note,
      child_name:   note,
      campus_ref:   campus,
      campus_label: campusObj.label || '',
      form_id:      CFG.formId,
      funnel_code:  funnelCode,
      school_level: CFG.level,
      grade:        'lop-1'
    }, UTM);

    fetch(CFG.api, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    })
      .then(function (r) { return r.ok; })
      .catch(function () { return false; })
      .then(function () {
        gtm('generate_lead', { campus: campus, funnel_code: funnelCode });
        try { localStorage.setItem('va_form_submitted', '1'); } catch (e) {}
        form.style.display = 'none';
        okBox.classList.add('on');
        setTimeout(function () {
          window.location.href = CFG.redirect + '?name=' + encodeURIComponent(name) + '&campus=' + encodeURIComponent(campus);
        }, 1600);
      });
  });

  // Đếm suất: giảm chậm theo thời gian thực, không bao giờ xuống dưới 3 (không bịa "cháy hàng")
  Array.prototype.forEach.call(document.querySelectorAll('[data-seat]'), function (el) {
    var n = parseInt(el.textContent, 10) || 0;
    var t = setInterval(function () {
      if (n <= 3) { clearInterval(t); return; }
      n--; el.textContent = String(n);
    }, (240 + Math.random() * 360) * 1000);
  });
})();
</script>

<script src="/js/phone-vn.js" defer is:inline></script>
</body>
</html>
