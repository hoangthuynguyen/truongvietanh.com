---
// LP tuyển sinh LỚP 1 (đầu cấp) — chiến dịch "4 Tuần Vàng" 2026–2027
// Brief: Google Doc "brieflandinglop1.md" (Grand-Slam Offer · giọng Nguyễn Mạnh Dương)
// Offer: hero = kết quả mơ ước · cam kết hoàn 100% = closer, KHÔNG phải hero.
// Lead → POST /api/lead (worker) → GHL + Pancake. school_level 'lop-1' map đúng
// dropdown "Khối quan tâm = Lớp 1" của Pancake (xem KHOI_QUAN_TAM_MAP trong staging-worker.js).

// ─────────────────────────────────────────────────────────────
// ⚙️ CẤU HÌNH — sửa ở đây, không cần đụng phần dưới
// ─────────────────────────────────────────────────────────────
const CFG = {
  funnel: 'lop-1-uu-dai-vang',     // funnel_code gốc; khi submit sẽ nối '-go-vap' / '-binh-tan'
  formId: 'lp-lop1-uu-dai-vang',
  level: 'lop-1',
  api: '/api/lead',
  redirect: '/cam-on',
  hotline: '0916 961 409',
  hotlineTel: '+84916961409',
  deadline: '10/08/2026',          // ⚠️ ngày đóng "4 Tuần Vàng" — xác nhận lại với BGH
  campuses: [
    {
      value: 'go-vap',
      label: 'Cơ sở Gò Vấp',
      address: '160/72 Phan Huy Ích, phường An Hội Tây, Thành phố Hồ Chí Minh',
      seats: 14,
    },
    {
      value: 'binh-tan',
      label: 'Cơ sở Bình Tân',
      address: 'Số 7 Đường 38A, Phường Tân Tạo, Quận Bình Tân, Thành phố Hồ Chí Minh',
      seats: 11,
    },
  ],
};

// ─────────────────────────────────────────────────────────────
// 🎥 TESTIMONIAL — thêm phụ huynh mới bằng cách bỏ comment / thêm object
// ─────────────────────────────────────────────────────────────
const testimonials = [
  {
    youtubeId: 'xh2YHEItrvU',
    title: 'Bí quyết giúp con lấy Chứng chỉ Oxford quốc tế từ lớp 2 tại Trường Việt Anh',
    caption:
      'Một phụ huynh Việt Anh kể hành trình thật của con ở bậc Tiểu học — điều bắt đầu từ một quyết định chọn trường đúng ở Lớp 1.',
  },
  // ⬇️ Ô TRỐNG chờ bổ sung — copy khối dưới, điền ID video YouTube rồi bỏ comment:
  // { youtubeId: '', title: '', caption: '' },
  // { youtubeId: '', title: '', caption: '' },
];

// ─────────────────────────────────────────────────────────────
// 💬 TRÍCH DẪN PHỤ HUYNH (chữ) — để trống, chưa hiển thị gì cho tới khi có câu thật.
//    KHÔNG bịa testimonial (yêu cầu bắt buộc trong brief, mục 8).
// ─────────────────────────────────────────────────────────────
const quotes: { text: string; author: string; context: string }[] = [
  // { text: 'Câu nói thật của phụ huynh…', author: 'Chị …', context: 'PH lớp 1 — Cơ sở Gò Vấp' },
];

const CANONICAL = 'https://truongvietanh.com/tuyen-sinh/lop-1-uu-dai-vang';
const TITLE = 'Tuyển Sinh Lớp 1 2026 – Tiểu Học Việt Anh TP.HCM';
const DESC =
  'Học thử 4 tuần, không hài lòng hoàn 100% học phí. Tiểu học Việt Anh: kỹ năng, phẩm chất, tiếng Anh giáo viên bản ngữ, xe đưa đón cả năm. Ghi danh 4 Tuần Vàng.';
const OG_IMAGE = 'https://truongvietanh.com/lp/lop-1/og.jpg';

const faqs = [
  {
    q: 'Hoàn phí có thật không, hay lại “chữ nhỏ”?',
    a: 'Thật, và không chữ nhỏ. Trong 4 tuần đầu, nếu bạn không hài lòng, nhà trường hoàn 100% học phí, không yêu cầu giải trình. Điều kiện duy nhất: con có đi học.',
  },
  {
    q: 'Con thử rồi rút có bị hụt năm học không?',
    a: 'Không. 4 tuần đầu tháng 8 là kỹ năng, phẩm chất, tiếng Anh bản ngữ và thể thao — không phải chương trình chính khoá, nên con không mất bài và vẫn kịp nhịp chung.',
  },
  {
    q: 'Con mới rời mẫu giáo, lên Lớp 1 có theo kịp không?',
    a: '4 tuần đầu chính là để con làm quen — tập trung vào tự lập, kỹ năng và làm bạn với tiếng Anh, chưa vội vào bài vở. Có Coach kèm sát để không con nào bị bỏ lại.',
  },
  {
    q: 'Gói Bảo chứng 50 triệu là tặng thật hay tính vào học phí?',
    a: 'Tặng kèm khi ghi danh trong 4 Tuần Vàng, không cộng thêm học phí.',
  },
  {
    q: 'Học phí Lớp 1 bao nhiêu?',
    a: 'Học phí thay đổi theo cơ sở và lộ trình gia đình chọn cho con, nên nhà trường không niêm yết một con số chung. Bạn để lại số điện thoại, chuyên viên tuyển sinh sẽ tư vấn đúng mức phí của cơ sở bạn chọn.',
  },
  {
    q: 'Tôi cần làm gì tiếp theo?',
    a: 'Để lại tên và số điện thoại. Nhà trường gọi lại trong 15 phút để giữ suất học thử và hẹn bạn một buổi tham quan.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'EducationalOrganization',
    name: 'Trường Tiểu học Việt Anh',
    url: CANONICAL,
    logo: 'https://truongvietanh.com/logo-vietanh.png',
    image: OG_IMAGE,
    telephone: CFG.hotline,
    address: CFG.campuses.map((c) => ({
      '@type': 'PostalAddress',
      name: c.label,
      streetAddress: c.address,
      addressLocality: 'TP. Hồ Chí Minh',
      addressCountry: 'VN',
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{TITLE}</title>
<meta name="description" content={DESC} />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={CANONICAL} />

<meta property="og:type" content="website" />
<meta property="og:url" content={CANONICAL} />
<meta property="og:title" content={TITLE} />
<meta property="og:description" content={DESC} />
<meta property="og:image" content={OG_IMAGE} />
<meta property="og:locale" content="vi_VN" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={TITLE} />
<meta name="twitter:description" content={DESC} />
<meta name="twitter:image" content={OG_IMAGE} />

<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600;700;800&display=swap" rel="stylesheet" />
<link rel="preload" as="image" href="/lp/lop-1/hero.webp" fetchpriority="high" />

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

<style>
/* ═══ 0 · TOKENS + RESET ═══ */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --primary:#26275D;
  --primary-2:#1c1d47;
  --accent:#f9dd0e;
  --light-bg:#f0f4f8;
  --text:#1a1a2e;
  --muted:#4b5168;
  --border:#e2e8f0;
  --tint:#fdf6cf;
  --red:#e03c31;
  --r:13px;
}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{
  font-family:'Be Vietnam Pro',system-ui,-apple-system,sans-serif;
  font-size:18px;line-height:1.7;color:var(--text);background:#fff;
  padding-bottom:0;
}
img{max-width:100%;display:block}
a{color:inherit}
.wrap{max-width:780px;margin:0 auto;padding:0 20px}
section{padding:56px 0}
h1,h2,h3{line-height:1.28;letter-spacing:-.4px}
h1{font-size:clamp(32px,5.6vw,44px);font-weight:800}
h2{font-size:clamp(26px,4.2vw,34px);font-weight:800}
h3{font-size:clamp(20px,3vw,24px);font-weight:700}
p{margin:0 0 18px}
strong{font-weight:700}
.eyebrow{
  font-size:13px;font-weight:800;letter-spacing:1.3px;text-transform:uppercase;
  color:var(--primary);opacity:.75;margin-bottom:14px
}
.lead{font-size:19px}
.center{text-align:center}

/* ═══ 1 · URGENCY BAR ═══ */
.ubar{
  background:var(--red);color:#fff;text-align:center;
  padding:9px 16px;font-size:14.5px;font-weight:700;line-height:1.45
}
.ubar em{font-style:normal;background:rgba(0,0,0,.22);border-radius:20px;padding:1px 10px;font-variant-numeric:tabular-nums}

/* ═══ 2 · LOGO BAR ═══ */
.lbar{background:#fff;padding:14px 20px;display:flex;justify-content:center;border-bottom:1px solid var(--border)}
.lbar img{height:66px;width:auto}

/* ═══ 3 · HERO ═══ */
.hero{
  position:relative;background:var(--primary);color:#fff;
  padding:60px 0 52px;overflow:hidden
}
/* Banner gốc là dải 1920×650 — cover sẽ cắt mất 2 bé ở rìa trái/phải.
   → desktop: trải đủ chiều ngang, neo đáy; phần trên là navy phẳng, hoà bằng gradient. */
.hero::before{
  content:'';position:absolute;inset:0;
  background-image:url('/lp/lop-1/hero.webp');
  background-size:100% auto;background-position:center bottom;background-repeat:no-repeat
}
.hero::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(180deg,var(--primary) 0%,rgba(38,39,93,.97) 32%,rgba(38,39,93,.78) 56%,rgba(38,39,93,.6) 100%)
}
.hero .wrap{position:relative;z-index:2;text-align:center}
.hero .eyebrow{color:var(--accent);opacity:1}
.hero h1{margin-bottom:20px;text-shadow:0 2px 18px rgba(0,0,0,.35)}
.hero h1 em{font-style:italic;color:var(--accent)}
.hero-sub{font-size:19px;color:#e8ebff;margin-bottom:22px;text-shadow:0 1px 10px rgba(0,0,0,.35)}
.trust{
  display:inline-block;background:rgba(255,255,255,.1);border:1px solid rgba(249,221,14,.42);
  border-radius:var(--r);padding:13px 18px;font-size:16.5px;color:#fff;margin-bottom:26px;
  max-width:620px;backdrop-filter:blur(2px)
}
.hero-note{font-size:15px;color:#c9cef0;margin-top:16px}

/* ═══ 4 · CTA ═══ */
.cta{
  display:inline-block;background:var(--accent);color:var(--primary);
  font-family:inherit;font-size:19px;font-weight:800;line-height:1.35;
  padding:17px 34px;border:0;border-radius:var(--r);cursor:pointer;text-decoration:none;
  box-shadow:0 8px 22px rgba(249,221,14,.34);transition:transform .15s,box-shadow .15s;
  max-width:100%
}
.cta:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(249,221,14,.44)}
.cta-note{display:block;font-size:14.5px;font-weight:600;margin-top:10px;opacity:.85}
.hero .cta-note{color:#dfe3ff;opacity:1}
.cta-block{text-align:center;margin-top:8px}

/* ═══ 5 · LISTS ═══ */
.list{list-style:none;display:grid;gap:14px;margin:0 0 22px}
.list li{
  display:grid;grid-template-columns:26px 1fr;gap:12px;align-items:start;
  background:#fff;border:1px solid var(--border);border-radius:var(--r);padding:15px 17px
}
.list .ic{font-weight:800;font-size:18px;line-height:1.5}
.list-pain .ic{color:var(--red)}
.list-win .ic{color:var(--primary)}
.list-win li{background:var(--light-bg);border-color:#dbe3ee}

/* ═══ 6 · CARDS ẢNH ═══ */
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:26px 0 8px}
.cards figure{border-radius:var(--r);overflow:hidden;background:var(--primary)}
.cards img{width:100%;height:auto;aspect-ratio:1/1;object-fit:cover}
.cards figcaption{font-size:14.5px;font-weight:600;color:#fff;padding:10px 12px;text-align:center;line-height:1.45}

/* ═══ 7 · VALUE STACK ═══ */
.stack{background:#fff;border:1px solid var(--border);border-radius:var(--r);overflow:hidden;margin-bottom:18px}
.stack-row{
  display:grid;grid-template-columns:1fr auto;gap:14px;align-items:center;
  padding:16px 18px;border-bottom:1px solid var(--border);font-size:17px
}
.stack-row:last-child{border-bottom:0}
.stack-row .no{color:var(--primary);font-weight:800;margin-right:6px}
.stack-row .val{font-weight:700;color:var(--muted);white-space:nowrap;font-size:16px}
.stack-row.total{background:var(--primary);color:#fff;font-weight:800;font-size:18px}
.stack-row.total .val{color:#fff;font-size:19px}
.stack-row.free{background:var(--accent);color:var(--primary);font-weight:800;font-size:18px}
.stack-row.free .val{color:var(--primary);font-size:20px}
.fineprint{font-size:15.5px;color:var(--muted);margin-bottom:24px}

/* ═══ 8 · KHỐI CAM KẾT (closer) ═══ */
.promise{
  background:var(--tint);border:2px solid var(--primary);border-radius:var(--r);
  padding:26px 24px;margin:22px 0
}
.promise .big{font-size:20px;font-weight:800;line-height:1.55;margin-bottom:18px}
.promise p:last-child{margin-bottom:0}

/* ═══ 9 · VIDEO ═══ */
.video{margin-bottom:22px}
.video-frame{position:relative;padding-top:56.25%;border-radius:var(--r);overflow:hidden;background:#000}
.video-frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.video h3{margin:16px 0 8px;font-size:20px}
.video p{font-size:16.5px;color:var(--muted);margin:0}

/* ═══ 10 · KHAN HIẾM ═══ */
.dark{background:var(--primary);color:#fff}
.dark .eyebrow{color:var(--accent);opacity:1}
.dark p{color:#dfe3ff}
.seats{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:24px 0 22px}
.seat{
  background:var(--red);border-radius:var(--r);padding:18px 16px;text-align:center;color:#fff
}
.seat b{display:block;font-size:34px;font-weight:800;line-height:1.1;font-variant-numeric:tabular-nums}
.seat span{display:block;font-size:15px;font-weight:600;margin-top:4px}
.seat small{display:block;font-size:13.5px;opacity:.9;margin-top:2px}

/* ═══ 11 · FORM ═══ */
.formbox{background:#fff;border:1px solid var(--border);border-radius:var(--r);padding:24px 22px;box-shadow:0 6px 24px rgba(38,39,93,.07)}
.field{margin-bottom:16px}
.field label{display:block;font-size:15.5px;font-weight:700;margin-bottom:6px}
.field input,.field select,.field textarea{
  width:100%;font-family:inherit;font-size:17px;color:var(--text);
  padding:14px 15px;border:1.5px solid var(--border);border-radius:10px;background:#fff
}
.field textarea{resize:vertical;min-height:82px}
.field input:focus,.field select:focus,.field textarea:focus{outline:0;border-color:var(--primary);box-shadow:0 0 0 3px rgba(38,39,93,.1)}
.field input.err,.field select.err{border-color:var(--red);background:#fff5f4}
.errmsg{display:none;font-size:14.5px;font-weight:600;color:var(--red);margin-top:6px}
.errmsg.on{display:block}
.hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
.formbox .cta{width:100%;text-align:center}
.formbox .cta.loading{opacity:.6;pointer-events:none}
.form-foot{font-size:15px;color:var(--muted);text-align:center;margin-top:14px}
.form-foot a{color:var(--primary);font-weight:700}
.formsuccess{display:none;text-align:center;padding:12px 0}
.formsuccess.on{display:block}
.formsuccess .tick{font-size:44px;line-height:1}

/* ═══ 12 · FAQ ═══ */
.faq{border-top:1px solid var(--border)}
.faq details{border-bottom:1px solid var(--border);padding:4px 0}
.faq summary{
  list-style:none;cursor:pointer;padding:16px 34px 16px 0;position:relative;
  font-size:18px;font-weight:700;line-height:1.5
}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{
  content:'+';position:absolute;right:4px;top:14px;font-size:24px;font-weight:700;
  color:var(--primary);transition:transform .2s
}
.faq details[open] summary::after{content:'–'}
.faq .ans{padding:0 0 18px;color:var(--muted);font-size:17px}

/* ═══ 13 · CHỮ KÝ + FOOTER ═══ */
.sign{border-left:4px solid var(--accent);padding-left:18px;margin:22px 0 26px}
.sign b{display:block;font-size:19px}
.sign span{display:block;font-size:16px;color:var(--muted)}
.foot{background:var(--primary-2);color:#c9cef0;font-size:15px;padding:32px 0 90px;line-height:1.65}
.foot b{color:#fff}
.foot .campus{margin-top:12px}
.foot a{color:var(--accent);font-weight:700;text-decoration:none}

/* ═══ 14 · STICKY CTA MOBILE ═══ */
.sticky{
  display:none;position:fixed;left:0;right:0;bottom:0;z-index:60;
  background:rgba(255,255,255,.97);border-top:1px solid var(--border);
  padding:10px 14px calc(10px + env(safe-area-inset-bottom));
  box-shadow:0 -4px 18px rgba(38,39,93,.13)
}
.sticky .cta{width:100%;text-align:center;font-size:17.5px;padding:15px 18px;box-shadow:none}

/* ═══ 15 · RESPONSIVE ═══ */
@media (max-width:760px){
  body{font-size:17px}
  section{padding:44px 0}
  .hero{padding:44px 0 40px}
  /* mobile: dải quá dẹt nếu trải ngang → cover, neo vào bé gái đọc sách bên phải */
  .hero::before{background-size:cover;background-position:88% center}
  .hero::after{background:radial-gradient(ellipse 96% 74% at 50% 46%,rgba(38,39,93,.95) 0%,rgba(38,39,93,.88) 58%,rgba(38,39,93,.66) 100%)}
  .cards{grid-template-columns:1fr 1fr;gap:10px}
  .cards figure:first-child{grid-column:1 / -1}
  .cards figure:first-child img{aspect-ratio:16/10}
  .stack-row{grid-template-columns:1fr;gap:4px;font-size:16.5px}
  .stack-row .val{white-space:normal}
  .sticky{display:block}
  .foot{padding-bottom:96px}
}
@media (max-width:380px){
  .wrap{padding:0 15px}
  .cta{font-size:17px;padding:15px 20px}
  .seats{grid-template-columns:1fr}
  .promise{padding:20px 17px}
  .formbox{padding:19px 16px}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .cta{transition:none}
}
</style>
</head>

<body>

<!-- ① URGENCY BAR -->
<div class="ubar">
  Ghi danh <strong>4 Tuần Vàng</strong> — đóng cổng ngày <em>{CFG.deadline}</em>
</div>

<!-- ② LOGO -->
<div class="lbar">
  <a href="/" aria-label="Trường Việt Anh — trang chủ">
    <img src="/logo-vietanh.webp" width="135" height="66" alt="Logo Hệ thống Trường Việt Anh" />
  </a>
</div>

<!-- ③ HERO -->
<header class="hero">
  <div class="wrap">
    <p class="eyebrow">Trường Tiểu học Việt Anh · TP.HCM — Tuyển sinh Lớp 1 · 2026–2027</p>
    <h1>Một năm Lớp 1 nơi con đi học vì <em>muốn</em> đến — con tự lập, yêu thích việc học, và nói tiếng Anh tự nhiên với thầy cô bản ngữ.</h1>
    <p class="hero-sub">Ngay từ tháng đầu tiên, con được xây thứ giáo dục Việt Nam đang thiếu nhất: kỹ năng, phẩm chất, tiếng Anh với giáo viên bản ngữ và thể thao mỗi ngày.</p>
    <p class="trust">Và tôi tin điều đó đến mức: học thử 4 tuần, không hài lòng — <strong>hoàn 100% học phí, không hỏi một câu.</strong></p>
    <div class="cta-block">
      <a class="cta js-cta" href="#dang-ky">Giữ suất học thử cho con →</a>
      <span class="cta-note">Chỉ nhận đến hết {CFG.deadline} — hết chỗ là dừng</span>
    </div>
