---
import SalesPageLayout from '../../../layouts/SalesPageLayout.astro';
import LeadFormTwoStepEmailFirst from '../../../components/LeadFormTwoStepEmailFirst.astro';
---

<SalesPageLayout
  title="Lớp 10 Việt Anh 2026 — Tấm vé thẳng đến Đại học Anh Quốc"
  description="Học lớp 10 hôm nay, 3 năm sau con xét tuyển thẳng Cử nhân ĐH Birmingham City (Anh) ngay tại TP.HCM. Cam kết IELTS 6.0. Mentor 1-1. Tặng Macbook. Tuyển sinh lớp 10 bán trú TP.HCM."
  canonical="https://truongvietanh.com/tuyen-sinh/lop-10-ban-tru"
  programCode="thpt-lop10"
  schoolLevel="thpt"
>

  <!-- HERO -->
  <div slot="hero">
    <span class="sp-hero__badge">🎓 Tuyển sinh Lớp 10 · Hệ Quốc tế · TP.HCM</span>
    <h1 style="font-size:clamp(1.8rem,4.5vw,2.9rem);font-weight:900;color:#F9DD0E;margin:0 0 1rem;line-height:1.2;text-shadow:0 2px 18px rgba(0,0,0,.55)">
      Con vừa thi xong lớp 10.<br>
      <span style="color:#fff">Và có lẽ đêm qua cả nhà mình đều khó ngủ.</span>
    </h1>
    <p style="font-size:1.1rem;color:rgba(255,255,255,.92);line-height:1.65;margin:.75rem 0 1.5rem">
      Có một con đường ít ba mẹ biết: học lớp 10 hôm nay → 3 năm sau con cầm tấm bằng Cử nhân Đại học Anh Quốc — ngay tại Sài Gòn. Không thi đại học. Không cần bỏ 2–3 tỷ đi du học.
    </p>
    <div style="display:flex;flex-wrap:wrap;gap:.75rem;align-items:center">
      <a href="#sp-form1" style="display:inline-block;background:#F9DD0E;color:#26275D;font-weight:800;padding:.9rem 2.2rem;border-radius:8px;text-decoration:none;font-size:1.05rem">
        Đăng ký tư vấn lộ trình lớp 10 →
      </a>
      <a href="https://zalo.me/1678310120468101523" style="display:inline-block;background:transparent;color:#fff;font-weight:600;padding:.9rem 1.8rem;border-radius:8px;text-decoration:none;font-size:1rem;border:2px solid rgba(255,255,255,.6)">
        Nhắn Zalo ngay →
      </a>
    </div>
    <p style="margin-top:1rem;font-size:.95rem;color:rgba(255,255,255,.7)">
      ⏳ Ưu đãi trọn bộ chỉ dành cho nhóm ghi danh sớm — khớp cửa sổ kết quả thi lớp 10
    </p>
  </div>

  <!-- PAIN: lời anh Dương + value stack -->
  <div slot="pain">
    <section style="padding:2rem 0 1rem">
      <p style="font-size:1.05rem;line-height:1.75">
        Tôi là Dương, Chủ tịch Trường Việt Anh. Tôi muốn nói thẳng một điều ít ai nói:
        <strong>tấm vé vào trường công không quyết định con bạn sẽ thành người thế nào sau 3 năm nữa.</strong>
      </p>
      <p style="font-size:1.05rem;line-height:1.75;margin-top:.75rem">
        Ở Việt Anh, chúng tôi không hứa "điểm cao". Chúng tôi mở một con đường:
        lộ trình <strong>xét tuyển thẳng có điều kiện</strong> vào chương trình Cử nhân của
        <strong>Đại học Birmingham City (Anh Quốc)</strong> qua hợp tác UIT–BCU —
        xét học bạ, không thi đại học.
      </p>
      <div style="background:#fff8d6;border-left:5px solid #F9DD0E;padding:1rem 1.2rem;border-radius:8px;margin-top:1.25rem;font-size:.95rem">
        <strong>Minh bạch:</strong> phạm vi "tuyển thẳng + học bổng" áp dụng theo điều kiện trong thoả thuận hợp tác UIT–BCU. Đội tư vấn sẽ nói rõ điều kiện cụ thể với từng hồ sơ.
      </div>
    </section>
  </div>

  <!-- FEATURES: value stack -->
  <div slot="features" style="max-width:780px;margin:0 auto">
    <h2 style="font-size:1.6rem;font-weight:800;color:#26275D;margin-bottom:1rem">Ghi danh đợt này, con nhận trọn bộ</h2>
    <ul style="list-style:none;padding:0;margin:0">
      {[
        "Lộ trình xét tuyển thẳng có điều kiện Cử nhân ĐH Birmingham City (UK) — xét học bạ, miễn thi đại học",
        "Cam kết IELTS 6.0 — không đạt, trường kèm tiếp miễn phí đến khi đạt (theo điều khoản bảo hành)",
        "Mentor 1-1 đồng hành suốt 3 năm — lộ trình học thuật + hồ sơ năng lực (PDR)",
        "Tặng Macbook — công cụ học tập thời đại AI, nhận khi nhập học",
        "Học bổng Trại hè Lion Camp 100% ngay hè này",
        "Học kỳ Foundation + Capstone + Portfolio tiếng Anh — hồ sơ năng lực thật, không chỉ điểm số",
      ].map((item) => (
        <li style="display:flex;align-items:flex-start;gap:.75rem;padding:.8rem 0;border-bottom:1px solid #eef0f6;font-size:1rem;line-height:1.6">
          <span style="flex-shrink:0;width:26px;height:26px;background:#26275D;color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.8rem;font-weight:700;margin-top:.1rem">✓</span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- FORM 1: 2 bước SĐT-first -->
  <div slot="form1">
    <h2 style="color:#26275D;font-size:1.5rem;font-weight:800;margin:0 0 .5rem">Để lại số điện thoại — đội tư vấn gọi lại trong hôm nay</h2>
    <p style="color:#475569;margin:0 0 1.5rem">Mỗi năm, một quyết định đúng của ba mẹ có thể thay đổi cả tuổi thơ của con.</p>
    <div style="background:#fff;border-radius:16px;padding:1.75rem 1.5rem;max-width:440px;margin:0 auto;box-shadow:0 16px 44px rgba(38,39,93,.16);border:1px solid #e8ecf5" data-form-bg="light">
      <LeadFormTwoStepEmailFirst formId="lop10-bantru2" funnelCode="lop10-bantru2" schoolLevel="thpt" submitText="Nhận tư vấn lộ trình Lớp 10" title="" description="" />
    </div>
  </div>

  <!-- QUOTE: chữ ký anh Dương -->
  <div slot="quote">
    <blockquote style="border:none;padding:0;margin:0">
      <p style="font-size:1.15rem;line-height:1.8;color:#334155;font-style:italic">
        "Điều quan trọng hơn điểm thi lớp 10 là câu hỏi: <strong>3 năm nữa con sẽ cầm tấm bằng gì, và trở thành người như thế nào?</strong>"
      </p>
      <footer style="margin-top:.75rem;font-size:.95rem;color:#475569">
        — <strong>Nguyễn Mạnh Dương</strong>, Chủ tịch / Nhà sáng lập Trường Việt Anh
      </footer>
    </blockquote>
  </div>
</SalesPageLayout>

