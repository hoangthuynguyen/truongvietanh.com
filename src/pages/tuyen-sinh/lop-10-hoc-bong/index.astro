---
import SalesPageLayout from '../../../layouts/SalesPageLayout.astro';
---

<SalesPageLayout
  title="Học bổng Lớp 10 Việt Anh 2026 — Đậu hay trượt trường công, con vẫn có con đường tốt hơn"
  description="Học bổng Tài năng + 100 Hồ sơ Vàng lớp 10 Trường Việt Anh 2026. Lộ trình ĐH Anh Quốc, Mentor 1-1, Macbook. Học kỳ Foundation giúp con lỡ nhịp lấy lại nền tảng."
  canonical="https://truongvietanh.com/tuyen-sinh/lop-10-hoc-bong"
  programCode="thpt-lop10-hocbong"
  schoolLevel="thpt"
>
  <div slot="hero">
    <span class="sp-hero__badge">🎓 Học bổng Lớp 10 · Việt Anh · 2026</span>
    <h1 style="font-size:clamp(1.8rem,4.5vw,2.9rem);font-weight:900;color:#ffff00;margin:0 0 1rem;line-height:1.2;text-shadow:0 2px 18px rgba(0,0,0,.55)">
      Nếu con vừa trượt nguyện vọng trường công —<br>
      <span style="color:#fff">xin đừng để con nghĩ rằng mình thất bại.</span>
    </h1>
    <p style="font-size:1.1rem;color:rgba(255,255,255,.92);line-height:1.65;margin:.75rem 0 1.5rem">
      Kết quả một kỳ thi không định nghĩa 3 năm tới của con. Có một con đường có đích đến quốc tế — và đang mở học bổng.
    </p>
    <div style="display:flex;flex-wrap:wrap;gap:.75rem;align-items:center">
      <a href="#sp-form1" style="display:inline-block;background:#ffff00;color:#000080;font-weight:800;padding:.9rem 2.2rem;border-radius:8px;text-decoration:none;font-size:1.05rem">
        Xét học bổng cho con →
      </a>
      <a href="https://zalo.me/1678310120468101523" style="display:inline-block;background:transparent;color:#fff;font-weight:600;padding:.9rem 1.8rem;border-radius:8px;text-decoration:none;font-size:1rem;border:2px solid rgba(255,255,255,.6)">
        Nhắn Zalo ngay →
      </a>
    </div>
    <p style="margin-top:1rem;font-size:.95rem;color:rgba(255,255,255,.7)">
      🎓 Học bổng Tài năng + 100 suất "Hồ sơ Vàng" — đếm ngược theo ngày công bố điểm thi
    </p>
  </div>

  <div slot="pain">
    <section style="padding:2rem 0 1rem">
      <p style="font-size:1.05rem;line-height:1.75">
        Tôi là Dương, Chủ tịch Trường Việt Anh. Tôi viết những dòng này cho cả hai nhóm gia đình:
        <strong>con đang lo/hụt hẫng chờ kết quả</strong>, và
        <strong>con học giỏi muốn một môi trường xứng tầm</strong>.
      </p>
      <p style="font-size:1.05rem;line-height:1.75;margin-top:.75rem">
        Năm nay Việt Anh mở <strong>Học bổng Tài năng</strong> và <strong>100 suất "Hồ sơ Vàng"</strong>
        cho học sinh vào lớp 10 — với lộ trình xét tuyển thẳng có điều kiện vào Đại học Anh Quốc,
        Mentor 1-1, Macbook và Lion Camp.
      </p>
    </section>
  </div>

  <div slot="features" style="max-width:780px;margin:0 auto">
    <h2 style="font-size:1.6rem;font-weight:800;color:#000080;margin-bottom:1rem">Cơ chế học bổng — minh bạch, hai loại</h2>
    <ul style="list-style:none;padding:0;margin:0">
      {[
        "Học bổng Tài năng: số suất giới hạn cho HS giỏi/có thành tích — xét hồ sơ + phỏng vấn, nhận trọn bộ quyền lợi",
        "100 Hồ sơ Vàng: 100 hồ sơ ghi danh sớm nhất nhận học bổng 10% + Macbook + Mentor 3 năm + Lion Camp",
        "Học kỳ Foundation 6 tuần đầu: giúp con lỡ nhịp lấy lại nền tảng + tìm lại chính mình — không bỏ ai lại phía sau",
        "Lộ trình xét tuyển thẳng có điều kiện ĐH Birmingham City (UK) + cam kết IELTS 6.0",
      ].map((item) => (
        <li style="display:flex;align-items:flex-start;gap:.75rem;padding:.8rem 0;border-bottom:1px solid #eef0f6;font-size:1rem;line-height:1.6">
          <span style="flex-shrink:0;width:26px;height:26px;background:#000080;color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.8rem;font-weight:700;margin-top:.1rem">✓</span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
    <div style="background:#fff8d6;border-left:5px solid #ffff00;padding:1rem 1.2rem;border-radius:8px;margin-top:1.25rem;font-size:.95rem">
      <strong>Minh bạch:</strong> Học bổng Tài năng xét theo học thuật; ưu đãi ghi danh/tài chính là loại riêng — tiêu chí từng loại được công bố rõ. "Tuyển thẳng + học bổng" UIT–BCU áp dụng theo điều kiện thoả thuận.
    </div>
  </div>

  <div slot="form1">
    <h2 style="color:#000080;font-size:1.5rem;font-weight:800;margin:0 0 .5rem">Điểm thi sắp công bố — nhắn tin trước khi hết suất</h2>
    <div style="display:flex;gap:12px;justify-content:center;margin:.75rem 0 1.5rem;flex-wrap:wrap">
      {[["100","Hồ sơ Vàng"],["6 tuần","Foundation"],["3 năm","Mentor 1-1"]].map(([n,l])=>(
        <div style="background:#eef2ff;border:2px solid #000080;color:#000080;border-radius:10px;padding:.6rem 1rem;min-width:80px;text-align:center">
          <div style="font-weight:800;font-size:1.3rem">{n}</div>
          <div style="font-size:.75rem;font-weight:600;opacity:.8">{l}</div>
        </div>
      ))}
    </div>
    <div style="background:#fff;border-radius:12px;padding:1.5rem;max-width:420px;margin:0 auto;text-align:left" id="hb-wrap">
      <div style="font-size:.8rem;color:#888;font-weight:600;text-align:center;margin-bottom:.75rem" id="hb-prog">Bước 1/2 — 15 giây</div>
      <div id="hb-s1">
        <label style="display:block;font-weight:600;font-size:.95rem;margin:.6rem 0 .3rem">Họ tên ba/mẹ</label>
        <input id="hb-name" type="text" placeholder="VD: Nguyễn Văn A" style="width:100%;padding:.8rem;font-size:1rem;border:2px solid #cdd2e6;border-radius:8px;box-sizing:border-box">
        <label style="display:block;font-weight:600;font-size:.95rem;margin:.75rem 0 .3rem">Số điện thoại (Zalo)</label>
        <input id="hb-phone" type="tel" placeholder="VD: 0901 234 567" inputmode="numeric" style="width:100%;padding:.8rem;font-size:1rem;border:2px solid #cdd2e6;border-radius:8px;box-sizing:border-box">
        <div id="hb-err" style="color:#c00;font-size:.85rem;margin:.4rem 0;display:none">Vui lòng nhập số điện thoại hợp lệ (10 số).</div>
        <button onclick="hbStep2()" style="width:100%;background:#000080;color:#ffff00;border:none;font-weight:800;font-size:1.1rem;padding:.9rem;border-radius:10px;margin-top:1rem;cursor:pointer">Xét học bổng cho con →</button>
        <p style="font-size:.78rem;color:#999;text-align:center;margin-top:.6rem">Tôi cam kết bảo mật thông tin.</p>
      </div>
      <div id="hb-s2" style="display:none">
        <label style="display:block;font-weight:600;font-size:.95rem;margin:.6rem 0 .3rem">Con đang học lớp mấy?</label>
        <select id="hb-level" style="width:100%;padding:.8rem;font-size:1rem;border:2px solid #cdd2e6;border-radius:8px;box-sizing:border-box"><option>Lớp 9 (vừa thi lớp 10)</option><option>Đã có kết quả thi</option><option>Khác</option></select>
        <label style="display:block;font-weight:600;font-size:.95rem;margin:.75rem 0 .3rem">Khu vực gia đình</label>
        <input id="hb-province" type="text" placeholder="VD: TP.HCM, Cà Mau, Đà Nẵng..." style="width:100%;padding:.8rem;font-size:1rem;border:2px solid #cdd2e6;border-radius:8px;box-sizing:border-box">
        <label style="display:block;font-weight:600;font-size:.95rem;margin:.75rem 0 .3rem">Tình huống của con</label>
        <select id="hb-need" style="width:100%;padding:.8rem;font-size:1rem;border:2px solid #cdd2e6;border-radius:8px;box-sizing:border-box"><option>Đang lo / chờ kết quả thi</option><option>Trượt nguyện vọng trường công</option><option>HS giỏi — xét Học bổng Tài năng</option><option>Chỉ đang tìm hiểu</option></select>
        <button onclick="hbSubmit()" style="width:100%;background:#000080;color:#ffff00;border:none;font-weight:800;font-size:1.1rem;padding:.9rem;border-radius:10px;margin-top:1rem;cursor:pointer">Hoàn tất — Giữ suất xét học bổng</button>
        <p style="font-size:.78rem;color:#999;text-align:center;margin-top:.6rem">Đội tư vấn sẽ gọi trong vài giờ tới.</p>
      </div>
      <div id="hb-ok" style="display:none;text-align:center;padding:.5rem">
        <div style="font-size:1.4rem;color:#000080;font-weight:800">✅ Cảm ơn bạn!</div>
        <p style="margin:.75rem 0">Đội tư vấn sẽ liên hệ về điều kiện học bổng cho con. Nhắn Zalo để được ưu tiên:</p>
        <a href="https://zalo.me/1678310120468101523" target="_blank" style="display:block;background:#000080;color:#ffff00;font-weight:800;padding:.9rem;border-radius:10px;text-decoration:none;font-size:1rem">Nhắn Zalo Trường Việt Anh</a>
      </div>
    </div>
  </div>

  <div slot="quote">
    <blockquote style="border:none;padding:0;margin:0">
      <p style="font-size:1.15rem;line-height:1.8;color:#334155;font-style:italic">"Trượt một nguyện vọng không phải là dấu chấm hết. Đôi khi, nó là khởi đầu của một con đường tốt hơn — nếu con được trao đúng cơ hội, đúng người đồng hành."</p>
      <footer style="margin-top:.75rem;font-size:.95rem;color:#475569">— <strong>Nguyễn Mạnh Dương</strong>, Chủ tịch / Nhà sáng lập Trường Việt Anh</footer>
    </blockquote>
  </div>
</SalesPageLayout>

<script is:inline>
const WEBHOOK="https://script.google.com/macros/s/AKfycby7hFPL8uZercenEVNc5vO9LLX7hMNgwNPSGnESBhDaH3kVp7L0hQWSS3YN64KTEs7b3A/exec",SECRET="VA_TRAIHE_2026_SECRET",SOURCE="lop10-hocbong";
function qp(k){return new URLSearchParams(location.search).get(k)||"";}
function getVal(id){var el=document.getElementById(id);return el?el.value:"";}
function payload(stage){return JSON.stringify({secret:SECRET,source:SOURCE,stage,name:getVal('hb-name'),phone:getVal('hb-phone').replace(/\D/g,''),level:getVal('hb-level'),province:getVal('hb-province'),need:getVal('hb-need'),page_url:location.href,gclid:qp('gclid'),utm_source:qp('utm_source'),utm_medium:qp('utm_medium'),utm_campaign:qp('utm_campaign'),utm_content:qp('utm_content'),utm_term:qp('utm_term')});}
function sendLead(stage){try{fetch(WEBHOOK,{method:'POST',mode:'no-cors',headers:{'Content-Type':'text/plain;charset=utf-8'},body:payload(stage)});}catch(e){}}
function hbStep2(){var p=getVal('hb-phone').replace(/\D/g,'');if(p.length<9||p.length>11){document.getElementById('hb-err').style.display='block';return;}sendLead('partial');document.getElementById('hb-s1').style.display='none';document.getElementById('hb-s2').style.display='block';document.getElementById('hb-prog').textContent='Bước 2/2 — gần xong';}
function hbSubmit(){sendLead('complete');document.getElementById('hb-s2').style.display='none';document.getElementById('hb-ok').style.display='block';document.getElementById('hb-prog').style.display='none';}
</script>
