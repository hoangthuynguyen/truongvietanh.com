---
import SalesPageLayout from '../../../layouts/SalesPageLayout.astro';
---

<SalesPageLayout
  title="Lớp 10 Nội trú Việt Anh — Con đi xa, ba mẹ vẫn an tâm"
  description="Nội trú lớp 10 tại Trường Việt Anh TP.HCM: Mentor 1-1 báo cáo ba mẹ mỗi tuần, ăn ở an toàn, lộ trình ĐH Anh Quốc. Nhận học sinh từ Đà Nẵng, Cà Mau, Kiên Giang, Phú Quốc toàn quốc."
  canonical="https://truongvietanh.com/tuyen-sinh/lop-10-noi-tru"
  programCode="thpt-lop10-noitru"
  schoolLevel="thpt"
>
  <div slot="hero">
    <span class="sp-hero__badge">🏠 Lớp 10 Nội trú · Việt Anh · TP.HCM</span>
    <h1 style="font-size:clamp(1.8rem,4.5vw,2.9rem);font-weight:900;color:#ffff00;margin:0 0 1rem;line-height:1.2;text-shadow:0 2px 18px rgba(0,0,0,.55)">
      Gửi ba mẹ ở Cà Mau, Kiên Giang,<br>
      <span style="color:#fff">Phú Quốc, Đà Nẵng và các tỉnh</span>
    </h1>
    <p style="font-size:1.1rem;color:rgba(255,255,255,.92);line-height:1.65;margin:.75rem 0 1.5rem">
      Ở quê mình chưa có trường quốc tế tốt — điều đó không có nghĩa con mình phải chịu thiệt.
    </p>
    <div style="display:flex;flex-wrap:wrap;gap:.75rem;align-items:center">
      <a href="#sp-form1" style="display:inline-block;background:#ffff00;color:#000080;font-weight:800;padding:.9rem 2.2rem;border-radius:8px;text-decoration:none;font-size:1.05rem">
        Giữ chỗ nội trú cho con →
      </a>
      <a href="https://zalo.me/truongvietanh" style="display:inline-block;background:transparent;color:#fff;font-weight:600;padding:.9rem 1.8rem;border-radius:8px;text-decoration:none;font-size:1rem;border:2px solid rgba(255,255,255,.6)">
        Nhắn Zalo ngay →
      </a>
    </div>
    <p style="margin-top:1rem;font-size:.95rem;color:rgba(255,255,255,.7)">
      🏠 Số chỗ nội trú có hạn theo sức chứa ký túc xá — giữ chỗ cho con
    </p>
  </div>

  <Fragment slot="body">
    <section style="padding:2rem 0 1rem">
      <p style="font-size:1.05rem;line-height:1.75">
        Tôi là Dương, Chủ tịch Trường Việt Anh. Nhiều ba mẹ muốn cho con học môi trường tốt hơn,
        nhưng nghĩ tới cảnh <strong>"gửi con đi xa, ai lo cho con"</strong> là lại thôi. Tôi hiểu.
      </p>
      <p style="font-size:1.05rem;line-height:1.75;margin-top:.75rem">
        Nên ở Việt Anh, con không chỉ có nội trú an toàn.
        <strong>Mỗi con có một Mentor riêng đồng hành suốt 3 năm, mỗi tuần</strong> —
        và báo cáo lại cho ba mẹ qua PDR. Ba mẹ ở xa vẫn nắm được con từng bước.
      </p>
    </section>

    <section style="padding:1.5rem 0">
      <h2 style="font-size:1.6rem;font-weight:800;color:#000080;margin-bottom:1rem">Con rời tỉnh — được chăm kỹ hơn ở nhà</h2>
      <ul style="list-style:none;padding:0;margin:0">
        {[
          "Nội trú trọn gói an toàn — ăn ở, nề nếp, theo dõi sức khoẻ",
          "Mentor 1-1 ba năm — mỗi tuần một người lớn đồng hành con, báo cáo định kỳ cho ba mẹ",
          "Lộ trình xét tuyển thẳng có điều kiện ĐH Birmingham City (UK) + cam kết IELTS 6.0 — con ở tỉnh vẫn chạm tới bằng quốc tế",
          "Tặng Macbook + Học bổng Trại hè Lion Camp 100% — hoà nhập nhanh ngay từ hè",
          "Hỗ trợ gia đình xa: lịch thăm, kênh liên lạc cố định với Mentor + GVCN, hỗ trợ đưa đón đầu/cuối kỳ",
        ].map((item) => (
          <li style="display:flex;align-items:flex-start;gap:.75rem;padding:.8rem 0;border-bottom:1px solid #eef0f6;font-size:1rem;line-height:1.6">
            <span style="flex-shrink:0;width:26px;height:26px;background:#000080;color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.8rem;font-weight:700;margin-top:.1rem">✓</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
      <div style="background:#fff8d6;border-left:5px solid #ffff00;padding:1rem 1.2rem;border-radius:8px;margin-top:1.25rem;font-size:.95rem">
        <strong>Minh bạch:</strong> "Tuyển thẳng + học bổng" theo điều kiện thoả thuận UIT–BCU. Cam kết IELTS 6.0 theo điều khoản bảo hành (đi học đủ, dự các buổi kèm). Đội tư vấn nói rõ từng trường hợp.
      </div>
    </section>

    <section id="sp-form1" style="background:#000080;border-radius:16px;padding:2rem;margin:2rem 0;text-align:center">
      <h2 style="color:#ffff00;font-size:1.5rem;font-weight:800;margin:0 0 .5rem">Giữ chỗ nội trú cho con — để lại số điện thoại</h2>
      <p style="color:rgba(255,255,255,.9);margin:0 0 1.5rem">Đội tư vấn sẽ gọi lại và gửi ba mẹ thông tin chi tiết về nội trú, học phí, lịch thăm trường.</p>
      <div style="background:#fff;border-radius:12px;padding:1.5rem;max-width:420px;margin:0 auto;text-align:left" id="nt-wrap">
        <div style="font-size:.8rem;color:#888;font-weight:600;text-align:center;margin-bottom:.75rem" id="nt-prog">Bước 1/2 — 15 giây</div>
        <div id="nt-s1">
          <label style="display:block;font-weight:600;font-size:.95rem;margin:.6rem 0 .3rem">Họ tên ba/mẹ</label>
          <input id="nt-name" type="text" placeholder="VD: Nguyễn Văn A" style="width:100%;padding:.8rem;font-size:1rem;border:2px solid #cdd2e6;border-radius:8px;box-sizing:border-box">
          <label style="display:block;font-weight:600;font-size:.95rem;margin:.75rem 0 .3rem">Số điện thoại (Zalo)</label>
          <input id="nt-phone" type="tel" placeholder="VD: 0901 234 567" inputmode="numeric" style="width:100%;padding:.8rem;font-size:1rem;border:2px solid #cdd2e6;border-radius:8px;box-sizing:border-box">
          <div id="nt-err" style="color:#c00;font-size:.85rem;margin:.4rem 0;display:none">Vui lòng nhập số điện thoại hợp lệ (10 số).</div>
          <button onclick="ntStep2()" style="width:100%;background:#000080;color:#ffff00;border:none;font-weight:800;font-size:1.1rem;padding:.9rem;border-radius:10px;margin-top:1rem;cursor:pointer">Giữ chỗ nội trú cho con →</button>
          <p style="font-size:.78rem;color:#999;text-align:center;margin-top:.6rem">Tôi cam kết bảo mật thông tin.</p>
        </div>
        <div id="nt-s2" style="display:none">
          <label style="display:block;font-weight:600;font-size:.95rem;margin:.6rem 0 .3rem">Con đang học lớp mấy?</label>
          <select id="nt-level" style="width:100%;padding:.8rem;font-size:1rem;border:2px solid #cdd2e6;border-radius:8px;box-sizing:border-box">
            <option>Lớp 9 (vừa thi lớp 10)</option><option>Đã có kết quả thi</option><option>Khác</option>
          </select>
          <label style="display:block;font-weight:600;font-size:.95rem;margin:.75rem 0 .3rem">Gia đình ở tỉnh/thành nào?</label>
          <input id="nt-province" type="text" placeholder="VD: Cà Mau, Kiên Giang, Phú Quốc, Đà Nẵng..." style="width:100%;padding:.8rem;font-size:1rem;border:2px solid #cdd2e6;border-radius:8px;box-sizing:border-box">
          <label style="display:block;font-weight:600;font-size:.95rem;margin:.75rem 0 .3rem">Bạn quan tâm nhất điều gì?</label>
          <select id="nt-need" style="width:100%;padding:.8rem;font-size:1rem;border:2px solid #cdd2e6;border-radius:8px;box-sizing:border-box">
            <option>Nội trú &amp; an toàn cho con</option><option>Mentor 1-1 &amp; báo cáo cho ba mẹ</option><option>Học phí nội trú</option><option>Lịch thăm trường</option>
          </select>
          <button onclick="ntSubmit()" style="width:100%;background:#000080;color:#ffff00;border:none;font-weight:800;font-size:1.1rem;padding:.9rem;border-radius:10px;margin-top:1rem;cursor:pointer">Hoàn tất — Giữ suất nội trú ưu tiên</button>
          <p style="font-size:.78rem;color:#999;text-align:center;margin-top:.6rem">Đội tư vấn sẽ gọi trong vài giờ tới.</p>
        </div>
        <div id="nt-ok" style="display:none;text-align:center;padding:.5rem">
          <div style="font-size:1.4rem;color:#000080;font-weight:800">✅ Cảm ơn ba/mẹ!</div>
          <p style="margin:.75rem 0">Đội tư vấn nội trú Việt Anh sẽ liên hệ sớm.</p>
          <a href="https://zalo.me/truongvietanh" target="_blank" style="display:block;background:#000080;color:#ffff00;font-weight:800;padding:.9rem;border-radius:10px;text-decoration:none;font-size:1rem">Nhắn Zalo Trường Việt Anh</a>
        </div>
      </div>
    </section>

    <section style="border-top:2px solid #000080;padding-top:1.25rem;margin-top:.5rem">
      <p style="font-size:.95rem;line-height:1.7;color:#333">Con ở tỉnh lẻ ít trường chất lượng không phải là giới hạn của con — đó chỉ là giới hạn của địa phương. Một môi trường đúng, một người Mentor đúng, có thể mở ra cả một con đường khác.</p>
      <p style="margin-top:.75rem;font-size:.95rem"><strong style="color:#000080">Nguyễn Mạnh Dương</strong><br>Chủ tịch / Nhà sáng lập · Hệ thống Trường Việt Anh · truongvietanh.com</p>
    </section>
  </Fragment>
</SalesPageLayout>

<script is:inline>
const WEBHOOK="https://script.google.com/macros/s/AKfycby7hFPL8uZercenEVNc5vO9LLX7hMNgwNPSGnESBhDaH3kVp7L0hQWSS3YN64KTEs7b3A/exec",SECRET="VA_TRAIHE_2026_SECRET",SOURCE="lop10-noitru";
function qp(k){return new URLSearchParams(location.search).get(k)||"";}
function getVal(id){var el=document.getElementById(id);return el?el.value:"";}
function payload(stage){return JSON.stringify({secret:SECRET,source:SOURCE,stage,name:getVal('nt-name'),phone:getVal('nt-phone').replace(/\D/g,''),level:getVal('nt-level'),province:getVal('nt-province'),need:getVal('nt-need'),page_url:location.href,gclid:qp('gclid'),utm_source:qp('utm_source'),utm_medium:qp('utm_medium'),utm_campaign:qp('utm_campaign'),utm_content:qp('utm_content'),utm_term:qp('utm_term')});}
function sendLead(stage){try{fetch(WEBHOOK,{method:'POST',mode:'no-cors',headers:{'Content-Type':'text/plain;charset=utf-8'},body:payload(stage)});}catch(e){}}
function ntStep2(){var p=getVal('nt-phone').replace(/\D/g,'');if(p.length<9||p.length>11){document.getElementById('nt-err').style.display='block';return;}sendLead('partial');document.getElementById('nt-s1').style.display='none';document.getElementById('nt-s2').style.display='block';document.getElementById('nt-prog').textContent='Bước 2/2 — gần xong';}
function ntSubmit(){sendLead('complete');document.getElementById('nt-s2').style.display='none';document.getElementById('nt-ok').style.display='block';document.getElementById('nt-prog').style.display='none';}
</script>
