---
import SalesPageLayout from '../../../layouts/SalesPageLayout.astro';
---

<SalesPageLayout
  title="Lớp 10 Việt Anh 2026 — Tấm vé thẳng đến Đại học Anh Quốc"
  description="Học lớp 10 hôm nay, 3 năm sau con xét tuyển thẳng Cử nhân ĐH Birmingham City (Anh) ngay tại TP.HCM. Cam kết IELTS 6.0. Mentor 1-1. Tặng Macbook. Tuyển sinh lớp 10 bán trú TP.HCM."
  canonical="https://truongvietanh.com/tuyen-sinh/lop-10"
  programCode="thpt-lop10"
  schoolLevel="thpt"
>

  <!-- HERO -->
  <div slot="hero">
    <span class="sp-hero__badge">🎓 Tuyển sinh Lớp 10 · Hệ Quốc tế · TP.HCM</span>
    <h1 style="font-size:clamp(1.8rem,4.5vw,2.9rem);font-weight:900;color:#ffff00;margin:0 0 1rem;line-height:1.2;text-shadow:0 2px 18px rgba(0,0,0,.55)">
      Con vừa thi xong lớp 10.<br>
      <span style="color:#fff">Và có lẽ đêm qua cả nhà mình đều khó ngủ.</span>
    </h1>
    <p style="font-size:1.1rem;color:rgba(255,255,255,.92);line-height:1.65;margin:.75rem 0 1.5rem">
      Có một con đường ít ba mẹ biết: học lớp 10 hôm nay → 3 năm sau con cầm tấm bằng Cử nhân Đại học Anh Quốc — ngay tại Sài Gòn. Không thi đại học. Không cần bỏ 2–3 tỷ đi du học.
    </p>
    <div style="display:flex;flex-wrap:wrap;gap:.75rem;align-items:center">
      <a href="#sp-form1" style="display:inline-block;background:#ffff00;color:#000080;font-weight:800;padding:.9rem 2.2rem;border-radius:8px;text-decoration:none;font-size:1.05rem">
        Đăng ký tư vấn lộ trình lớp 10 →
      </a>
      <a href="https://zalo.me/truongvietanh" style="display:inline-block;background:transparent;color:#fff;font-weight:600;padding:.9rem 1.8rem;border-radius:8px;text-decoration:none;font-size:1rem;border:2px solid rgba(255,255,255,.6)">
        Nhắn Zalo ngay →
      </a>
    </div>
    <p style="margin-top:1rem;font-size:.95rem;color:rgba(255,255,255,.7)">
      ⏳ Ưu đãi trọn bộ chỉ dành cho nhóm ghi danh sớm — khớp cửa sổ kết quả thi lớp 10
    </p>
  </div>

  <!-- BODY -->
  <Fragment slot="body">

    <!-- Lời anh Dương -->
    <section style="padding:2rem 0 1rem">
      <p style="font-size:1.05rem;line-height:1.75">
        Tôi là Dương, Chủ tịch Trường Việt Anh. Tôi muốn nói thẳng một điều ít ai nói:
        <strong>tấm vé vào trường công không quyết định con bạn sẽ thành người thế nào sau 3 năm nữa.</strong>
      </p>
      <p style="font-size:1.05rem;line-height:1.75;margin-top:.75rem">
        Ở Việt Anh, chúng tôi không hứa "điểm cao". Chúng tôi mở một con đường:
        lộ trình <strong>xét tuyển thẳng có điều kiện</strong> vào chương trình Cử nhân của
        <strong>Đại học Birmingham City (Anh Quốc)</strong> qua hợp tác UIT–BCU —
        xét học bạ, không thi đại học.
      </p>
      <div style="background:#fff8d6;border-left:5px solid #ffff00;padding:1rem 1.2rem;border-radius:8px;margin-top:1.25rem;font-size:.95rem">
        <strong>Minh bạch:</strong> phạm vi "tuyển thẳng + học bổng" áp dụng theo điều kiện trong thoả thuận hợp tác UIT–BCU. Đội tư vấn sẽ nói rõ điều kiện cụ thể với từng hồ sơ.
      </div>
    </section>

    <!-- Value stack -->
    <section style="padding:1.5rem 0">
      <h2 style="font-size:1.6rem;font-weight:800;color:#000080;margin-bottom:1rem">Ghi danh đợt này, con nhận trọn bộ</h2>
      <ul style="list-style:none;padding:0;margin:0">
        {[
          "Lộ trình xét tuyển thẳng có điều kiện Cử nhân ĐH Birmingham City (UK) — xét học bạ, miễn thi đại học",
          "Cam kết IELTS 6.0 — không đạt, trường kèm tiếp miễn phí đến khi đạt (theo điều khoản bảo hành)",
          "Mentor 1-1 đồng hành suốt 3 năm — lộ trình học thuật + hồ sơ năng lực (PDR)",
          "Tặng Macbook — công cụ học tập thời đại AI, nhận khi nhập học",
          "Học bổng Trại hè Lion Camp 100% ngay hè này",
          "Học kỳ Foundation + Capstone + Portfolio tiếng Anh — hồ sơ năng lực thật, không chỉ điểm số",
        ].map((item) => (
          <li style="display:flex;align-items:flex-start;gap:.75rem;padding:.8rem 0;border-bottom:1px solid #eef0f6;font-size:1rem;line-height:1.6">
            <span style="flex-shrink:0;width:26px;height:26px;background:#000080;color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.8rem;font-weight:700;margin-top:.1rem">✓</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- FORM 2 BƯỚC SĐT-FIRST -->
    <section id="sp-form1" style="background:#000080;border-radius:16px;padding:2rem;margin:2rem 0;text-align:center">
      <h2 style="color:#ffff00;font-size:1.5rem;font-weight:800;margin:0 0 .5rem">Để lại số điện thoại — đội tư vấn gọi lại trong hôm nay</h2>
      <p style="color:rgba(255,255,255,.9);margin:0 0 1.5rem">Mỗi năm, một quyết định đúng của ba mẹ có thể thay đổi cả tuổi thơ của con.</p>
      <div style="background:#fff;border-radius:12px;padding:1.5rem;max-width:420px;margin:0 auto;text-align:left" id="lp10-form-wrap">
        <div style="font-size:.8rem;color:#888;font-weight:600;text-align:center;margin-bottom:.75rem" id="lp10-prog">Bước 1/2 — 15 giây</div>

        <div id="lp10-s1">
          <label style="display:block;font-weight:600;font-size:.95rem;margin:.6rem 0 .3rem">Họ tên ba/mẹ</label>
          <input id="lp10-name" type="text" placeholder="VD: Nguyễn Văn A"
            style="width:100%;padding:.8rem;font-size:1rem;border:2px solid #cdd2e6;border-radius:8px;box-sizing:border-box">
          <label style="display:block;font-weight:600;font-size:.95rem;margin:.75rem 0 .3rem">Số điện thoại (Zalo)</label>
          <input id="lp10-phone" type="tel" placeholder="VD: 0901 234 567" inputmode="numeric"
            style="width:100%;padding:.8rem;font-size:1rem;border:2px solid #cdd2e6;border-radius:8px;box-sizing:border-box">
          <div id="lp10-err1" style="color:#c00;font-size:.85rem;margin:.4rem 0;display:none">Vui lòng nhập số điện thoại hợp lệ (10 số).</div>
          <button onclick="lp10Step2()" style="width:100%;background:#000080;color:#ffff00;border:none;font-weight:800;font-size:1.1rem;padding:.9rem;border-radius:10px;margin-top:1rem;cursor:pointer">
            Nhận tư vấn lộ trình lớp 10 →
          </button>
          <p style="font-size:.78rem;color:#999;text-align:center;margin-top:.6rem">Tôi cam kết bảo mật thông tin của bạn.</p>
        </div>

        <div id="lp10-s2" style="display:none">
          <label style="display:block;font-weight:600;font-size:.95rem;margin:.6rem 0 .3rem">Con đang học lớp mấy?</label>
          <select id="lp10-level" style="width:100%;padding:.8rem;font-size:1rem;border:2px solid #cdd2e6;border-radius:8px;box-sizing:border-box">
            <option>Lớp 9 (vừa thi lớp 10)</option>
            <option>Đã có kết quả thi</option>
            <option>Khác</option>
          </select>
          <label style="display:block;font-weight:600;font-size:.95rem;margin:.75rem 0 .3rem">Khu vực gia đình</label>
          <input id="lp10-province" type="text" placeholder="VD: TP.HCM, Bình Dương..."
            style="width:100%;padding:.8rem;font-size:1rem;border:2px solid #cdd2e6;border-radius:8px;box-sizing:border-box">
          <label style="display:block;font-weight:600;font-size:.95rem;margin:.75rem 0 .3rem">Bạn quan tâm nhất điều gì?</label>
          <select id="lp10-need" style="width:100%;padding:.8rem;font-size:1rem;border:2px solid #cdd2e6;border-radius:8px;box-sizing:border-box">
            <option>Lộ trình ĐH Anh Quốc</option>
            <option>Học phí & ưu đãi</option>
            <option>Đăng ký tham quan trường</option>
            <option>Học bổng</option>
          </select>
          <button onclick="lp10Submit()" style="width:100%;background:#000080;color:#ffff00;border:none;font-weight:800;font-size:1.1rem;padding:.9rem;border-radius:10px;margin-top:1rem;cursor:pointer">
            Hoàn tất — Giữ suất tư vấn ưu tiên
          </button>
          <p style="font-size:.78rem;color:#999;text-align:center;margin-top:.6rem">Đội tư vấn sẽ gọi trong vài giờ tới (giờ hành chính).</p>
        </div>

        <div id="lp10-ok" style="display:none;text-align:center;padding:.5rem">
          <div style="font-size:1.4rem;color:#000080;font-weight:800">✅ Cảm ơn bạn!</div>
          <p style="margin:.75rem 0">Đội tư vấn Việt Anh sẽ liên hệ sớm. Nhắn Zalo để được ưu tiên:</p>
          <a href="https://zalo.me/truongvietanh" target="_blank"
            style="display:block;background:#000080;color:#ffff00;font-weight:800;padding:.9rem;border-radius:10px;text-decoration:none;font-size:1rem">
            Nhắn Zalo Trường Việt Anh
          </a>
        </div>
      </div>
    </section>

    <!-- Chữ ký -->
    <section style="border-top:2px solid #000080;padding-top:1.25rem;margin-top:.5rem">
      <p style="font-size:.95rem;line-height:1.7;color:#333">
        Tôi tin điều quan trọng hơn điểm thi là câu hỏi: <strong>3 năm nữa con sẽ cầm tấm bằng gì, và trở thành người như thế nào?</strong>
      </p>
      <p style="margin-top:.75rem;font-size:.95rem">
        <strong style="color:#000080">Nguyễn Mạnh Dương</strong><br>
        Chủ tịch / Nhà sáng lập · Hệ thống Trường Việt Anh · truongvietanh.com
      </p>
    </section>

  </Fragment>
</SalesPageLayout>

<script is:inline>
const WEBHOOK = "https://script.google.com/macros/s/AKfycby7hFPL8uZercenEVNc5vO9LLX7hMNgwNPSGnESBhDaH3kVp7L0hQWSS3YN64KTEs7b3A/exec";
const SECRET  = "VA_TRAIHE_2026_SECRET";
const SOURCE  = "lop10-bantru";
function qp(k){return new URLSearchParams(location.search).get(k)||"";}
function payload(stage){return JSON.stringify({
  secret:SECRET,source:SOURCE,stage,
  name:document.getElementById('lp10-name').value.trim(),
  phone:document.getElementById('lp10-phone').value.replace(/\D/g,''),
  level:(document.getElementById('lp10-level')||{}).value||"",
  province:(document.getElementById('lp10-province')||{}).value||"",
  need:(document.getElementById('lp10-need')||{}).value||"",
  page_url:location.href,gclid:qp('gclid'),
  utm_source:qp('utm_source'),utm_medium:qp('utm_medium'),
  utm_campaign:qp('utm_campaign'),utm_content:qp('utm_content'),utm_term:qp('utm_term')
});}
function sendLead(stage){try{fetch(WEBHOOK,{method:'POST',mode:'no-cors',headers:{'Content-Type':'text/plain;charset=utf-8'},body:payload(stage)});}catch(e){}}
function lp10Step2(){
  var p=document.getElementById('lp10-phone').value.replace(/\D/g,'');
  if(p.length<9||p.length>11){document.getElementById('lp10-err1').style.display='block';return;}
  sendLead('partial');
  document.getElementById('lp10-s1').style.display='none';
  document.getElementById('lp10-s2').style.display='block';
  document.getElementById('lp10-prog').textContent='Bước 2/2 — gần xong';
}
function lp10Submit(){
  sendLead('complete');
  document.getElementById('lp10-s2').style.display='none';
  document.getElementById('lp10-ok').style.display='block';
  document.getElementById('lp10-prog').style.display='none';
}
</script>
