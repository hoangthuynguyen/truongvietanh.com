---
import SalesPageLayout from '../../../layouts/SalesPageLayout.astro';
import LeadFormTwoStepEmailFirst from '../../../components/LeadFormTwoStepEmailFirst.astro';
---

<SalesPageLayout
  title="Mầm Non Song Ngữ Việt Anh — Đặt Lịch Tham Quan Miễn Phí"
  description="Mầm non Montessori + Song ngữ Anh-Việt + STEAM từ 18 tháng. 9 cơ sở TP.HCM, Long An, Kiên Giang. Học phí 5-8 triệu/tháng. Đặt lịch tham quan miễn phí."
  canonical="https://truongvietanh.com/tuyen-sinh/mam-non"
  ogImage="https://media.truongvietanh.com/images/extra-giao-vien-va-hoc-sinh-2.webp"
  heroImage="https://media.truongvietanh.com/images/extra-giao-vien-va-hoc-sinh-2.webp"
  programCode="mam-non"
  schoolLevel="mau-non"
>

  <!-- HERO -->
  <Fragment slot="hero">
    <div class="sp-hero__badge">TUYỂN SINH MẦM NON 2026–2027</div>
    <h1 style="font-size:2.5rem;font-weight:900;color:#fff;margin:0 0 1rem;line-height:1.15;text-shadow:0 2px 8px rgba(0,0,0,.3)">
      85% Não Bộ Con Phát Triển Trước 3 Tuổi — Bạn Đang Làm Gì Với Giai Đoạn Vàng Này?
    </h1>
    <p style="font-size:1.1rem;color:rgba(255,255,255,.88);line-height:1.65;margin:.75rem 0">
      Montessori + Song ngữ Anh-Việt + STEAM từ 18 tháng tuổi — Nền tảng hoàn hảo không thể bù đắp sau này
    </p>
    <p style="font-size:.88rem;color:rgba(255,255,255,.6);margin-top:.5rem">
      3,000+ gia đình tin tưởng · 15+ năm kinh nghiệm · 9 cơ sở
    </p>
    <a href="#sp-form1" style="display:inline-block;margin-top:1.5rem;background:#D4A843;color:#1a1a5e;font-weight:700;padding:.85rem 2rem;border-radius:8px;text-decoration:none;font-size:1rem">
      Đặt lịch tham quan miễn phí →
    </a>
  </Fragment>

  <!-- PAIN -->
  <Fragment slot="pain">
    <p class="sp-pain__eyebrow">NỖI LO CỦA CHA MẸ</p>
    <h2>Con đang lớn — Bạn Có Chắc Đang Cho Con Đúng Môi Trường?</h2>
    <p>Giai đoạn 0–6 tuổi là giai đoạn vàng của não bộ. Các nhà khoa học thần kinh xác nhận: 85% cấu trúc não phát triển trong những năm đầu đời. Bỏ lỡ giai đoạn này, bạn không thể bù đắp lại sau này — dù có đầu tư bao nhiêu tiền hay thời gian.</p>
    <p>Trong khi đó, phần lớn trường mầm non thông thường chỉ cung cấp 2–3 tiết tiếng Anh mỗi tuần — quá ít để tạo ra nền tảng ngôn ngữ thực sự. Lớp học đông đúc khiến cô giáo không thể chú ý đến từng bé. Và con bạn lớn lên mà không được khơi dậy đam mê khám phá từ những năm đầu đời.</p>
    <ul class="sp-pain__list">
      <li>Tiếng Anh học muộn từ lớp 1 — não bộ đã qua giai đoạn tiếp nhận ngôn ngữ dễ nhất</li>
      <li>Lớp 40–50 bé — cô không đủ thời gian chú ý đến con bạn</li>
      <li>Không có STEAM, không Montessori — học vẹt, nhớ rồi lại quên</li>
      <li>Không dinh dưỡng được kiểm soát — bé ăn kém, ngủ kém, học kém hơn</li>
    </ul>
  </Fragment>

  <!-- FEATURES -->
  <Fragment slot="features">
    <p class="sp-features__eyebrow">GIẢI PHÁP CỦA VIỆT ANH</p>
    <h2>6 Lý Do Phụ Huynh Chọn Mầm Non Việt Anh</h2>
    <p class="sp-features__sub">Không phải may mắn — đây là hệ thống được thiết kế để tối ưu từng giai đoạn phát triển của con</p>
    <div class="sp-features__grid">
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🧠</div>
        <h3>Montessori + STEAM từ 18 tháng</h3>
        <p>Phương pháp khoa học chứng minh — bé học qua khám phá, phát triển tư duy độc lập</p>
        <span class="sp-feat-card__tag">Phương pháp</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🌍</div>
        <h3>100% tiếng Anh với giáo viên bản ngữ</h3>
        <p>Mỗi ngày tiếp xúc tiếng Anh tự nhiên — não bộ ghi nhớ như trẻ bản xứ</p>
        <span class="sp-feat-card__tag">Song ngữ</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">👩‍🏫</div>
        <h3>Tối đa 20–25 bé/lớp</h3>
        <p>Cô đủ thời gian quan sát và chăm sóc từng bé — không ai bị bỏ lại phía sau</p>
        <span class="sp-feat-card__tag">Lớp nhỏ</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🥗</div>
        <h3>Thực đơn do chuyên gia dinh dưỡng thiết kế</h3>
        <p>3 bữa chính + 2 phụ mỗi ngày — đủ chất, ngon miệng, bé ăn tốt</p>
        <span class="sp-feat-card__tag">Dinh dưỡng</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🎨</div>
        <h3>Âm nhạc, mỹ thuật, thể chất tích hợp</h3>
        <p>Phát triển sáng tạo và sự tự tin từ những năm đầu đời</p>
        <span class="sp-feat-card__tag">Toàn diện</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🔒</div>
        <h3>Camera 24/7 + cơ sở quốc tế</h3>
        <p>Ba mẹ xem live con học bất cứ lúc nào — yên tâm tuyệt đối</p>
        <span class="sp-feat-card__tag">An toàn</span>
      </div>
    </div>
  </Fragment>

  <!-- TEXT WITH IMAGE -->
  <Fragment slot="textimg">
    <div class="sp-textimg__text">
      <p class="sp-textimg__eyebrow">MÔI TRƯỜNG HỌC TẬP</p>
      <h2>Ngôi Trường Mà Bé Không Muốn Về Nhà</h2>
      <p>Không gian Montessori được thiết kế theo tỷ lệ cơ thể trẻ em — mọi thứ đều vừa tầm tay bé, từ kệ sách đến bàn ghế. Đồ chơi giáo dục quốc tế chất lượng cao được chọn lọc kỹ lưỡng để kích thích từng giác quan. Cô giáo yêu thương, kiên nhẫn — không la mắng, chỉ hướng dẫn và đồng hành.</p>
      <p>Bé được tự do khám phá trong môi trường an toàn tuyệt đối — không gian xanh thoáng đãng, sân chơi ngoài trời đạt chuẩn, khu vực vui chơi trong nhà phong phú. Mỗi ngày đến trường là một ngày phiêu lưu mới, khiến bé luôn háo hức và không muốn về nhà.</p>
    </div>
    <div class="sp-textimg__img">
      <img
        src="https://media.truongvietanh.com/images/extra-giao-vien-va-hoc-sinh-2.webp"
        alt="Lớp học mầm non Việt Anh"
        loading="lazy"
        width="600"
        height="400"
      />
    </div>
  </Fragment>

  <!-- STATS -->
  <Fragment slot="stats">
    <p class="sp-stats__eyebrow">CON SỐ THỰC TẾ</p>
    <h2>15 Năm — 3,000+ Gia Đình Tin Tưởng</h2>
    <div class="sp-stats__grid">
      <div class="sp-stat">
        <span class="sp-stat__num">15+</span>
        <span class="sp-stat__label">Năm kinh nghiệm giáo dục mầm non song ngữ</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">3,000+</span>
        <span class="sp-stat__label">Gia đình đã gửi gắm con tại Việt Anh</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">98%</span>
        <span class="sp-stat__label">Phụ huynh hài lòng sau 1 học kỳ</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">9</span>
        <span class="sp-stat__label">Cơ sở tại TP.HCM, Long An, Kiên Giang</span>
      </div>
    </div>
  </Fragment>

  <!-- QUOTE -->
  <Fragment slot="quote">
    <p class="sp-quote__eyebrow">PHỤ HUYNH NÓI GÌ</p>
    <div class="sp-quote__card">
      <div class="sp-quote__stars">★★★★★</div>
      <p class="sp-quote__text">
        "Từ ngày vào Việt Anh, con tôi thay đổi hoàn toàn. Bé tự lập hơn, tiếng Anh nói chuyện với cô giáo bản ngữ tự nhiên như người lớn. Đặc biệt bé rất thích đi học — sáng nào cũng dậy sớm đòi đến trường!"
      </p>
      <div class="sp-quote__author">
        <img
          src="https://media.truongvietanh.com/images/phu-huynh-02.webp"
          alt="Chị Lan Anh"
          class="sp-quote__avatar"
          width="52"
          height="52"
          loading="lazy"
        />
        <div>
          <div class="sp-quote__name">Chị Lan Anh</div>
          <div class="sp-quote__meta">Phụ huynh bé Minh Khôi — Mầm Non Việt Anh Gò Vấp</div>
        </div>
      </div>
    </div>
  </Fragment>

  <!-- PRICING -->
  <Fragment slot="pricing">
    <p class="sp-pricing__eyebrow">HỌC PHÍ</p>
    <h2>Đầu Tư Cho Con — Minh Bạch Từ Đầu</h2>
    <p class="sp-pricing__sub">Học phí bao gồm: bán trú, ăn uống, học liệu Montessori, tiếng Anh và ngoại khóa cơ bản</p>
    <div class="sp-pricing__table">
      <div class="sp-pricing-col sp-pricing-col--regular">
        <div class="sp-pricing-col__label">Học phí thị trường</div>
        <div class="sp-pricing-col__price">8–12tr</div>
        <div class="sp-pricing-col__unit">/tháng (trường quốc tế)</div>
        <ul class="sp-pricing-col__features">
          <li>Cơ sở đơn giản</li>
          <li>Tiếng Anh hạn chế</li>
          <li>Lớp đông 40+ bé</li>
          <li>Thực đơn tiêu chuẩn</li>
        </ul>
      </div>
      <div class="sp-pricing-col sp-pricing-col--promo">
        <div class="sp-pricing-col__label">Học phí Việt Anh</div>
        <div class="sp-pricing-col__price">5–8tr</div>
        <div class="sp-pricing-col__unit">/tháng (bao gồm tất cả)</div>
        <ul class="sp-pricing-col__features">
          <li>Montessori + STEAM mỗi ngày</li>
          <li>GV bản ngữ tiếng Anh</li>
          <li>Tối đa 25 bé/lớp</li>
          <li>Thực đơn chuyên gia dinh dưỡng</li>
          <li>Camera 24/7</li>
          <li>Ngoại khóa âm nhạc, thể chất</li>
        </ul>
      </div>
    </div>
    <p class="sp-pricing__note">* Học phí chính xác tùy cơ sở và gói đăng ký. Liên hệ để nhận báo giá cụ thể.</p>
  </Fragment>

  <!-- CTA -->
  <Fragment slot="cta">
    <h2>Chỉ Còn Ít Suất — Đặt Chỗ Cho Con Ngay Hôm Nay</h2>
    <p>Tham quan miễn phí, không ràng buộc. Đội tư vấn sẽ liên hệ trong 24h để sắp xếp lịch phù hợp.</p>
    <a href="#sp-form1" class="sp-cta-btn">Đặt lịch tham quan miễn phí →</a>
    <p class="sp-cta-block__note">Không cần đặt cọc · Có thể hủy bất kỳ lúc nào</p>
  </Fragment>

  <!-- FORM 1 -->
  <Fragment slot="form1">
    <p class="sp-form-block__eyebrow">ĐĂNG KÝ TƯ VẤN</p>
    <h2>Đặt Lịch Tham Quan — Miễn Phí, Không Ràng Buộc</h2>
    <p>Điền thông tin bên dưới — tư vấn viên sẽ gọi lại trong vòng 24 giờ để sắp xếp lịch thăm trường phù hợp nhất với gia đình bạn.</p>
    <LeadFormTwoStepEmailFirst
      formId="mam-non-sales-form1"
      funnelCode="sales-mam-non"
      schoolLevel="mau-non"
      submitText="Đặt lịch tham quan ngay"
    />
  </Fragment>

  <!-- FAQ -->
  <Fragment slot="faq">
    <p class="sp-faq__eyebrow">CÂU HỎI THƯỜNG GẶP</p>
    <h2>Phụ Huynh Hay Hỏi</h2>
    <p class="sp-faq__sub">Mọi câu hỏi đều được trả lời thẳng thắn</p>

    <details class="sp-faq-item">
      <summary>Con 18 tháng học mầm non sớm quá không?</summary>
      <div class="sp-faq-answer">
        Không — đây là độ tuổi LÝ TƯỞNG. 85% não bộ phát triển từ 0–3 tuổi. Montessori từ 18 tháng giúp bé xây dựng tư duy độc lập, yêu thích khám phá — nền tảng này rất khó bù đắp nếu bỏ qua.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>Học song ngữ có làm con bị nhầm lẫn 2 ngôn ngữ?</summary>
      <div class="sp-faq-answer">
        Không hề. Nghiên cứu khoa học chứng minh: trẻ em tiếp xúc song ngữ từ nhỏ phát triển não bộ TỐT HƠN — khả năng tập trung, chuyển đổi tư duy và giải quyết vấn đề đều vượt trội so với trẻ đơn ngữ.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>Học phí 5–8 triệu có đắt không?</summary>
      <div class="sp-faq-answer">
        So với chất lượng: Montessori + GV bản ngữ + lớp nhỏ + bán trú + dinh dưỡng chuyên gia = 5–8tr/tháng rẻ hơn nhiều trường quốc tế tới 2–3 lần. Đây là đầu tư giai đoạn não bộ phát triển mạnh nhất — ROI cao nhất trong cuộc đời con.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>Con tôi chưa nói được tiếng Việt rõ, có học tiếng Anh được không?</summary>
      <div class="sp-faq-answer">
        Hoàn toàn được! Phương pháp Total Physical Response (TPR) của Việt Anh dạy ngôn ngữ qua hành động và ngữ cảnh — không cần biết gì trước. Cô sẽ dùng cả 2 ngôn ngữ một cách tự nhiên.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>Làm sao biết con đang phát triển tốt?</summary>
      <div class="sp-faq-answer">
        Mỗi tháng phụ huynh nhận báo cáo phát triển chi tiết: ngôn ngữ, vận động, xã hội, nhận thức. Ngoài ra app theo dõi cho phép ba mẹ xem ảnh/video hoạt động của con mỗi ngày.
      </div>
    </details>
  </Fragment>

  <!-- FORM 2 -->
  <Fragment slot="form2">
    <p class="sp-form-block__eyebrow">ĐĂNG KÝ NGAY</p>
    <h2>Còn Phân Vân? Cứ Đăng Ký Tham Quan Trước</h2>
    <p>Xem tận mắt môi trường — gặp cô giáo — hiểu chương trình. Hoàn toàn miễn phí, không áp lực.</p>
    <LeadFormTwoStepEmailFirst
      formId="mam-non-sales-form2"
      funnelCode="sales-mam-non-2"
      schoolLevel="mau-non"
      submitText="Đăng ký tham quan ngay"
    />
  </Fragment>

</SalesPageLayout>
