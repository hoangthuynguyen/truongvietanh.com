---
import SalesPageLayout from '../../../layouts/SalesPageLayout.astro';
import LeadFormTwoStepEmailFirst from '../../../components/LeadFormTwoStepEmailFirst.astro';
---

<SalesPageLayout
  title="THCS Song Ngữ Việt Anh — IELTS · STEM · Lãnh Đạo Từ Lớp 6"
  description="THCS Việt Anh: Song ngữ Cambridge, luyện IELTS từ lớp 6, STEM, Debate, Leader In Me. Học phí 9-11 triệu. Tham quan miễn phí."
  canonical="https://truongvietanh.com/tuyen-sinh/thcs"
  ogImage="https://media.truongvietanh.com/images/trang-chu-30.webp"
  heroImage="https://media.truongvietanh.com/images/trang-chu-30.webp"
  programCode="thcs"
  schoolLevel="thcs"
>

  <!-- HERO -->
  <Fragment slot="hero">
    <div class="sp-hero__badge">TUYỂN SINH THCS 2026–2027 — LỚP 6-9</div>
    <h1 style="font-size:2.5rem;font-weight:900;color:#fff;margin:0 0 1rem;line-height:1.15;text-shadow:0 2px 8px rgba(0,0,0,.3)">
      THCS Việt Anh — Nơi Con Từ Học Sinh Bình Thường Trở Thành Nhà Lãnh Đạo Tương Lai
    </h1>
    <p style="font-size:1.1rem;color:rgba(255,255,255,.88);line-height:1.65;margin:.75rem 0">
      IELTS từ lớp 6 · STEM chuyên sâu · Debate quốc tế · 99% lên được THPT
    </p>
    <p style="font-size:1.1rem;color:rgba(255,255,255,.88);line-height:1.65;margin:.75rem 0">
      1,000+ học sinh THCS hiện tại · 15+ năm · 2 cơ sở HCM
    </p>
    <a href="#sp-form1" style="display:inline-block;margin-top:1.5rem;background:#D4A843;color:#1a1a5e;font-weight:700;padding:.85rem 2rem;border-radius:8px;text-decoration:none;font-size:1rem">
      Đặt lịch tham quan miễn phí →
    </a>
  </Fragment>

  <!-- PAIN -->
  <Fragment slot="pain">
    <p class="sp-pain__eyebrow">LO LẮNG CỦA PHỤ HUYNH LỚP 5-8</p>
    <h2>Chuyển Cấp Lớp 6 Là Bước Ngoặt — Con Bạn Đã Sẵn Sàng Chưa?</h2>
    <p>Chuyển từ tiểu học lên THCS là giai đoạn nước rút: môn học nhiều hơn, áp lực tăng vọt, và khoảng cách giữa các học sinh bắt đầu giãn ra rõ rệt. Đây là lúc nền tảng được định hình — và một môi trường sai có thể khiến con tụt hậu trong suốt những năm còn lại.</p>
    <p>Trong khi bạn bè con đang xây lộ trình IELTS từ lớp 6, học STEM bài bản và phát triển kỹ năng lãnh đạo — con của bạn đang ở đâu?</p>
    <ul class="sp-pain__list">
      <li>THCS công lập: tiếng Anh chỉ đủ thi tốt nghiệp — IELTS phải học thêm ngoài, tốn thêm 3-5tr/tháng</li>
      <li>Không có STEM từ sớm — vào THPT thiếu nền tảng tư duy khoa học</li>
      <li>Lớp học 40+ HS — con nhút nhát sẽ không được chú ý phát triển</li>
      <li>Không có môi trường phát triển lãnh đạo — ra đời thiếu kỹ năng mềm quan trọng</li>
    </ul>
  </Fragment>

  <!-- FEATURES -->
  <Fragment slot="features">
    <p class="sp-features__eyebrow">CHƯƠNG TRÌNH THCS VIỆT ANH</p>
    <h2>8 Trụ Cột Tạo Nên Học Sinh THCS Việt Anh Xuất Sắc</h2>
    <p class="sp-features__sub">Không chỉ học giỏi — học sinh Việt Anh tự tin, có kỹ năng và tầm nhìn quốc tế</p>
    <div class="sp-features__grid">
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🎓</div>
        <h3>IELTS từ lớp 6 — lộ trình bài bản</h3>
        <p>GV bản ngữ, lớp IELTS tích hợp — con đạt 5.0+ khi lên lớp 9</p>
        <span class="sp-feat-card__tag">IELTS</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🔬</div>
        <h3>STEM + Robotics nâng cao</h3>
        <p>Lập trình Python, Arduino, thi Robotics quốc gia — nền tảng THPT và ĐH</p>
        <span class="sp-feat-card__tag">STEM</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🎤</div>
        <h3>Debate · MUN · Thuyết trình</h3>
        <p>Tranh luận tiếng Anh, Model UN — phát triển tư duy phản biện và sự tự tin</p>
        <span class="sp-feat-card__tag">Lãnh đạo</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">📊</div>
        <h3>Toán Olympic · Khoa học quốc tế</h3>
        <p>30+ giải thi học sinh giỏi mỗi năm — profile ấn tượng cho tuyển sinh THPT</p>
        <span class="sp-feat-card__tag">Thành tích</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">👑</div>
        <h3>Leader In Me · Quản lý bản thân</h3>
        <p>7 Thói Quen (Franklin Covey) — học sinh biết đặt mục tiêu và chịu trách nhiệm</p>
        <span class="sp-feat-card__tag">Phát triển cá nhân</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🌐</div>
        <h3>Cambridge Secondary + BGD-ĐT</h3>
        <p>Học đồng thời 2 chương trình — linh hoạt chuyển trường, học ở bất cứ đâu</p>
        <span class="sp-feat-card__tag">Cambridge</span>
      </div>
    </div>
  </Fragment>

  <!-- TEXT WITH IMAGE -->
  <Fragment slot="textimg">
    <div class="sp-textimg__text">
      <p class="sp-textimg__eyebrow">TRẢI NGHIỆM THỰC TẾ</p>
      <h2>Phòng Lab STEM · Debate Club · Sân Chơi Tư Duy</h2>
      <p>Học sinh THCS Việt Anh học trong không gian được thiết kế riêng cho tư duy sáng tạo: phòng STEM hiện đại với đầy đủ thiết bị Arduino, Robotics và lập trình — không phải học lý thuyết suông mà thực hành trực tiếp từng tiết học.</p>
      <p>Văn hóa tranh luận được xây dựng xuyên suốt 4 năm THCS: từ thuyết trình nhỏ trong lớp đến Debate liên trường và Model UN. Con học cách nói trước đám đông, bảo vệ quan điểm và lắng nghe — những kỹ năng không thể học từ sách giáo khoa.</p>
    </div>
    <div class="sp-textimg__img">
      <img src="https://media.truongvietanh.com/images/trang-chu-30.webp" alt="Học sinh THCS Việt Anh" loading="lazy" />
    </div>
  </Fragment>

  <!-- STATS -->
  <Fragment slot="stats">
    <h2>Con Số Minh Chứng Cho Chất Lượng</h2>
    <div class="sp-stats__grid">
      <div class="sp-stat">
        <span class="sp-stat__num">1,000+</span>
        <span class="sp-stat__label">Học sinh THCS hiện tại</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">30+</span>
        <span class="sp-stat__label">Giải thi HS giỏi mỗi năm</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">IELTS 5.0+</span>
        <span class="sp-stat__label">Trung bình học sinh lớp 9</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">99%</span>
        <span class="sp-stat__label">Lên được THPT (Việt Anh hoặc công lập tốt)</span>
      </div>
    </div>
  </Fragment>

  <!-- QUOTE -->
  <Fragment slot="quote">
    <div class="sp-quote__card">
      <div class="sp-quote__stars">★★★★★</div>
      <p class="sp-quote__text">
        "Con vào lớp 6 Việt Anh lúc tiếng Anh còn rất cơ bản. Sau 2 năm con thi IELTS được 5.5, đoạt giải nhì thi Robotics cấp thành phố và tự tin đứng debate trước 300 người. Tôi không ngờ sự thay đổi lại rõ rệt đến vậy."
      </p>
      <div class="sp-quote__author">
        <div>
          <div class="sp-quote__name">Chị Hương Giang</div>
          <div class="sp-quote__meta">Phụ huynh bé Gia Huy — THCS Việt Anh Gò Vấp</div>
        </div>
      </div>
    </div>
  </Fragment>

  <!-- PRICING -->
  <Fragment slot="pricing">
    <h2>So Sánh Chi Phí Thực Tế</h2>
    <div class="sp-pricing__table">
      <div class="sp-pricing-col sp-pricing-col--regular">
        <div class="sp-pricing-col__label">THCS công lập + học thêm</div>
        <div class="sp-pricing-col__price">4–7tr</div>
        <div class="sp-pricing-col__unit">/tháng (chưa tính học thêm)</div>
        <ul class="sp-pricing-col__features">
          <li>Lớp 40+ HS</li>
          <li>IELTS phải học thêm ngoài</li>
          <li>Không STEM bài bản</li>
          <li>Không có Debate/MUN</li>
        </ul>
      </div>
      <div class="sp-pricing-col sp-pricing-col--promo">
        <div class="sp-pricing-col__label">THCS Việt Anh</div>
        <div class="sp-pricing-col__price">9–11tr</div>
        <div class="sp-pricing-col__unit">/tháng (all-inclusive)</div>
        <ul class="sp-pricing-col__features">
          <li>IELTS tích hợp từ lớp 6</li>
          <li>STEM + Robotics nâng cao</li>
          <li>Debate + MUN tiếng Anh</li>
          <li>Leader In Me</li>
          <li>Cambridge Secondary</li>
          <li>Bán trú + Ngoại khóa</li>
        </ul>
      </div>
    </div>
    <p class="sp-pricing__note">* Học phí tùy khối lớp và cơ sở. Liên hệ nhận báo giá + tư vấn lộ trình cá nhân.</p>
  </Fragment>

  <!-- CTA -->
  <Fragment slot="cta">
    <h2>Đặt Lịch Tham Quan — Xem Lớp Học Thực Tế</h2>
    <p>Gặp giáo viên, xem phòng STEM, nghe lộ trình IELTS. Miễn phí hoàn toàn.</p>
    <a href="#sp-form1" class="sp-cta-btn">Đặt lịch tham quan ngay →</a>
  </Fragment>

  <!-- FORM 1 -->
  <Fragment slot="form1">
    <LeadFormTwoStepEmailFirst
      formId="thcs-sales-form1"
      funnelCode="sales-thcs"
      schoolLevel="thcs"
      submitText="Đặt lịch tham quan ngay"
    />
  </Fragment>

  <!-- FAQ -->
  <Fragment slot="faq">
    <p class="sp-faq__eyebrow">CÂU HỎI THƯỜNG GẶP</p>
    <h2>Phụ Huynh Thường Hỏi Gì?</h2>
    <p class="sp-faq__sub">Giải đáp thẳng thắn — không vòng vo</p>

    <details class="sp-faq-item">
      <summary>Con học THCS Việt Anh có thi vào lớp 10 công lập được không?</summary>
      <div class="sp-faq-answer">
        Được! Học sinh Việt Anh học đầy đủ chương trình BGD-ĐT. Thực tế, học sinh Việt Anh thi vào các trường THPT tốt ở HCM với tỷ lệ rất cao do nền tảng toán-văn-Anh vững, cộng thêm IELTS là điểm cộng lớn khi xét vào nhiều trường THPT chất lượng cao.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>Con tôi đang học lớp 7 trường khác — chuyển sang có kịp không?</summary>
      <div class="sp-faq-answer">
        Kịp! Chúng tôi có bài test phân loại và chương trình bridge dành riêng cho HS chuyển trường. Phần lớn HS chuyển vào đều bắt kịp trong 1-2 học kỳ đầu.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>IELTS 5.0 vào lớp 9 — có thực tế không?</summary>
      <div class="sp-faq-answer">
        Hoàn toàn thực tế. Học sinh bắt đầu từ A1 khi vào lớp 6, học tích hợp với GV bản ngữ — đến lớp 9 trung bình đạt 5.0-5.5. Một số HS xuất sắc đạt 6.0+ và đủ điều kiện nộp thẳng vào ĐH quốc tế.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>Học phí 9-11 triệu có bao gồm học thêm không?</summary>
      <div class="sp-faq-answer">
        Bao gồm tất cả: Cambridge, STEM, Debate, bán trú, học liệu, ngoại khóa cơ bản. Không cần học thêm tiếng Anh bên ngoài. So với công lập + học thêm đủ thứ, Việt Anh tiết kiệm hơn và hiệu quả hơn nhiều.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>Sau THCS Việt Anh, con có được ưu tiên vào THPT Việt Anh không?</summary>
      <div class="sp-faq-answer">
        Có. HS THCS Việt Anh được xét tuyển thẳng nếu đủ điều kiện học thuật và hạnh kiểm. Không phải thi cạnh tranh như bên ngoài — lợi thế lớn khi tuyển sinh THPT ngày càng cạnh tranh.
      </div>
    </details>
  </Fragment>

  <!-- FORM 2 -->
  <Fragment slot="form2">
    <LeadFormTwoStepEmailFirst
      formId="thcs-sales-form2"
      funnelCode="sales-thcs-2"
      schoolLevel="thcs"
      submitText="Đăng ký tham quan ngay"
    />
  </Fragment>

</SalesPageLayout>
