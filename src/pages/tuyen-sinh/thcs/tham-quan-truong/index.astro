---
import SqueezePageLayout from '../../../../layouts/SqueezePageLayout.astro';
import LeadFormTwoStepEmailFirst from '../../../../components/LeadFormTwoStepEmailFirst.astro';
import USPGrid from '../../../../components/USPGrid.astro';
import TrustMetrics from '../../../../components/TrustMetrics.astro';
import FAQSection from '../../../../components/FAQSection.astro';

const pageTitle = 'Tham Quan Trường THCS Việt Anh — Trải Nghiệm Thực Tế Trước Khi Quyết Định';
const pageDescription = 'Đặt lịch tham quan THCS Việt Anh: Xem phòng STEM Lab, lớp học song ngữ, sân thể thao, gặp giáo viên trực tiếp. Buổi tham quan miễn phí, có tư vấn cá nhân.';
const canonicalUrl = 'https://truongvietanh.com/tuyen-sinh/thcs/tham-quan-truong';

const uspItems = [
  { icon: '🏫', text: 'Tham quan toàn bộ cơ sở: Phòng học, STEM Lab, Thư viện, Sân thể thao' },
  { icon: '👨‍🏫', text: 'Gặp trực tiếp giáo viên chủ nhiệm và giáo viên bộ môn' },
  { icon: '🔬', text: 'Trải nghiệm STEM Lab thực tế: Robotics, Coding, Thí nghiệm Khoa Học' },
  { icon: '🗣️', text: 'Quan sát lớp học song ngữ — con được nghe giáo viên nước ngoài giảng' },
  { icon: '⚽', text: 'Xem cơ sở thể thao: Bóng đá, Bơi lội, Võ thuật, Nhà thi đấu đa năng' },
  { icon: '📝', text: 'Tư vấn 1-1 với chuyên gia tuyển sinh — giải đáp mọi thắc mắc cá nhân' }
];

const metrics = [
  { number: '3', label: 'Cơ sở tiêu chuẩn tại TPHCM' },
  { number: '15+', label: 'Năm hoạt động liên tục' },
  { number: '30', label: 'Học sinh tối đa mỗi lớp' },
  { number: '100%', label: 'Phụ huynh hài lòng sau tham quan' }
];

const faqItems = [
  {
    question: 'Buổi tham quan kéo dài bao lâu và bao gồm những gì?',
    answer: 'Buổi tham quan kéo dài khoảng 60-90 phút, bao gồm: (1) Đón tiếp và giới thiệu tổng quan về trường (15 phút), (2) Tham quan các phòng học, STEM Lab, thư viện, khu vực thể thao (30-40 phút), (3) Quan sát một lớp học đang diễn ra nếu đến vào ngày thường (15 phút), (4) Tư vấn cá nhân 1-1 với chuyên gia tuyển sinh (15-20 phút). Ba/Mẹ và con được tự do hỏi bất kỳ câu hỏi nào, chụp ảnh, và trải nghiệm không khí thực tế của trường.'
  },
  {
    question: 'Con tôi có thể tham gia buổi tham quan cùng không?',
    answer: 'Chúng tôi rất khuyến khích Ba/Mẹ cho con đi cùng. Việc con được trực tiếp nhìn thấy phòng học, STEM Lab, sân chơi sẽ giúp con hình dung rõ ràng về môi trường học tập mới. Nhiều em sau buổi tham quan rất hào hứng vì được thử nghiệm Robot ở STEM Lab, thấy các anh chị đang nói Tiếng Anh tự nhiên trong lớp, hoặc đơn giản là thích sân bóng rộng. Cảm nhận của con cũng là yếu tố quan trọng để Ba/Mẹ đưa ra quyết định đúng.'
  },
  {
    question: 'Tham quan vào ngày nào? Có cần đặt lịch trước không?',
    answer: 'Có, Ba/Mẹ cần đặt lịch trước để chúng tôi sắp xếp người hướng dẫn chuyên nghiệp. Buổi tham quan có thể được sắp xếp vào ngày thường (Thứ 2-6) hoặc cuối tuần (Thứ 7). Nếu đến vào ngày thường, Ba/Mẹ có thể quan sát lớp học đang diễn ra — đây là trải nghiệm chân thực nhất. Nếu đến Thứ 7, không gian yên tĩnh hơn, phù hợp để trao đổi sâu với giáo viên. Chúng tôi sẽ liên hệ xác nhận lịch trong 24h sau khi nhận đăng ký.'
  },
  {
    question: 'Tôi ở xa TPHCM, có thể tham quan online được không?',
    answer: 'Được. Chúng tôi có buổi tham quan online qua Zoom mỗi tuần cho phụ huynh ở xa. Buổi online bao gồm video tour 360 độ các cơ sở, phỏng vấn trực tiếp với giáo viên, và tư vấn cá nhân 1-1. Tuy nhiên, nếu có điều kiện, chúng tôi vẫn khuyến khích Ba/Mẹ đến trực tiếp ít nhất một lần — vì cảm nhận thực tế (không khí, tương tác của học sinh, mùi vị bếp ăn...) là những thứ camera không thể truyền tải hết.'
  },
  {
    question: 'Bếp ăn và chế độ dinh dưỡng tại trường như thế nào?',
    answer: 'Bếp ăn tại Việt Anh đạt chuẩn ATTP (An toàn thực phẩm) do Sở Y tế cấp phép, có chuyên gia dinh dưỡng lên thực đơn hàng tuần cân bằng đạm-tinh bột-rau-trái cây. Trong buổi tham quan, Ba/Mẹ sẽ được ghé thăm bếp ăn, xem quy trình chế biến, và nếm thử bữa ăn mẫu. Học sinh THCS được phục vụ bữa trưa + bữa phụ chiều, có lựa chọn riêng cho em dị ứng thực phẩm hoặc ăn chay. Nhiều phụ huynh sau khi thăm bếp ăn nói rằng đây là yếu tố quan trọng giúp họ yên tâm cho con học bán trú.'
  }
];
---

<SqueezePageLayout
  title={pageTitle}
  description={pageDescription}
  keywords="tham quan trường THCS, trường Việt Anh, STEM Lab, song ngữ, tham quan trường tư thục TPHCM"
  schoolLevel="thcs"
  funnelCode="tour-thcs"
  canonicalUrl={canonicalUrl}
>
  <div slot="hero">
    <h1 class="hero-h1">
      Tham Quan Trường THCS Việt Anh — Trải Nghiệm Thực Tế Trước Khi Quyết Định
    </h1>
    <p class="hero-subtitle">
      Đến xem STEM Lab, lớp học song ngữ, sân thể thao — và gặp giáo viên trực tiếp
    </p>
  </div>

  <div slot="usp">
    <USPGrid items={uspItems} />
  </div>

  <div slot="trust">
    <TrustMetrics metrics={metrics} />
  </div>

  <div slot="content">
    <div class="content-section featured-image-section">
      <img src="https://media.truongvietanh.com/images/the-thao-03.webp" alt="Học sinh THCS Việt Anh tham gia hoạt động thể thao tại sân trường" class="featured-image" width="800" height="450" loading="lazy" />
      <p class="featured-caption">Khuôn viên trường rộng rãi với đầy đủ sân thể thao, phòng STEM Lab và không gian học tập hiện đại -- tất cả chờ Ba/Mẹ khám phá.</p>
    </div>

    <div class="content-section">
      <h2>Ba/Mẹ sẽ thấy gì khi đến tham quan THCS Việt Anh?</h2>
      <div class="content-grid">
        <div class="content-card">
          <h3>STEM Lab: Nơi con "chạm tay" vào Robot và Code</h3>
          <p>STEM Lab tại Việt Anh không phải "phòng trưng bày" — mà là nơi học sinh thực hành mỗi tuần. Ba/Mẹ sẽ thấy: bộ Robotics LEGO Education, Arduino, máy in 3D, và màn hình lập trình Python. Trong buổi tham quan, con có thể thử điều khiển Robot hoặc xem các anh chị đang code chương trình AI. Nhiều phụ huynh sau khi thấy STEM Lab đã nói: "Tôi không ngờ trường tư thục ở TPHCM có phòng thí nghiệm như thế này".</p>
        </div>
        <div class="content-card">
          <h3>Lớp học song ngữ: Tiếng Anh không phải "môn học" mà là "ngôn ngữ sống"</h3>
          <p>Ba/Mẹ sẽ được quan sát trực tiếp lớp học có giáo viên nước ngoài giảng bằng Tiếng Anh — không phải dạy ngữ pháp mà dạy Khoa Học, Lịch Sử, Nghệ Thuật bằng Tiếng Anh. Học sinh trao đổi, thảo luận, tranh luận bằng Tiếng Anh tự nhiên. Đây là cách Tiếng Anh trở thành "hộ chiếu" chứ không phải "gánh nặng". Ba/Mẹ sẽ thấy rõ sự khác biệt so với cách dạy Tiếng Anh ở trường công.</p>
        </div>
        <div class="content-card">
          <h3>Cơ sở thể thao: Phát triển thể chất song song trí tuệ</h3>
          <p>Sân bóng đá chuẩn, hồ bơi, phòng võ thuật, nhà thi đấu đa năng — con không chỉ học trên lớp mà được rèn luyện thể chất mỗi ngày. Ba/Mẹ sẽ thấy lịch hoạt động thể thao ngoại khóa phong phú: bóng rổ, bơi lội, taekwondo, cầu lông... Thể thao tại Việt Anh không phải "giờ ra chơi" mà là chương trình có huấn luyện viên chuyên nghiệp, giúp con phát triển toàn diện cả thể chất lẫn tinh thần.</p>
        </div>
        <div class="content-card">
          <h3>Gặp giáo viên: Người sẽ đồng hành cùng con 4 năm THCS</h3>
          <p>Trong buổi tham quan, Ba/Mẹ sẽ được gặp và trò chuyện trực tiếp với giáo viên chủ nhiệm và giáo viên bộ môn. Ba/Mẹ có thể hỏi về phương pháp dạy, cách theo dõi tiến bộ của từng em, và chính sách hỗ trợ khi con gặp khó khăn. Lớp chỉ 30 em nên mỗi giáo viên "nhìn thấy" từng em — không bị "lạc" trong đám đông 45-50 em như ở trường công.</p>
        </div>
      </div>
    </div>

    <div class="content-section bonus-section">
      <h2 style="color: #D4A843;">Bonus: Tư vấn cá nhân 1-1 — Giải đáp mọi thắc mắc riêng của gia đình</h2>
      <p style="font-size: 1.05rem; line-height: 1.8; color: #333; text-align: center; max-width: 800px; margin: 0 auto;">
        Cuối buổi tham quan, Ba/Mẹ sẽ có 15-20 phút tư vấn riêng với chuyên gia tuyển sinh. Đây là lúc Ba/Mẹ hỏi những câu hỏi cụ thể về con mình: <strong>con đang ở mức nào, có cần bổ sung gì, học phí ra sao, có chương trình học bổng không</strong>. Không phải tư vấn "đại trà" mà là phân tích tình hình cụ thể của con để Ba/Mẹ có đủ thông tin đưa ra quyết định.
      </p>
    </div>
  </div>

  <div slot="form">
    <h2 class="form-heading">Đặt lịch tham quan miễn phí — Xem tận mắt trước khi quyết định</h2>
    <p class="form-subheading">Buổi tham quan hoàn toàn miễn phí. Chúng tôi sẽ liên hệ trong 24h để sắp xếp lịch phù hợp với Ba/Mẹ và con.</p>
    <LeadFormTwoStepEmailFirst
      formId="tour-thcs-form"
      funnelCode="tour-thcs"
      schoolLevel="thcs"
      submitText="Đặt lịch tham quan"
      successMessage="Cảm ơn Ba/Mẹ! Chúng tôi sẽ liên hệ trong 24h để sắp xếp lịch tham quan phù hợp."
    />
  </div>

  <div slot="faq">
    <FAQSection items={faqItems} title="Câu hỏi phổ biến về tham quan trường" />
  </div>
</SqueezePageLayout>

<style>.hero-h1{ font-family: "Montserrat", sans-serif; font-size: clamp(1.75rem, 5vw, 2.75rem); font-weight: 800; line-height: 1.2; margin-bottom: 1rem; color: #1F4E79; }.hero-subtitle{ font-size: clamp(1rem, 3vw, 1.25rem); font-weight: 500; opacity: 0.95; color: #D4A843; }.content-section{ margin-bottom: 3rem; }.content-section h2{ font-family: "Montserrat", sans-serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; margin-bottom: 2rem; color: #1F4E79; text-align: center; }.content-grid{ display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; max-width: 1200px; margin: 0 auto; }.content-card{ padding: 2rem; background: white; border: 2px solid #e0e0e0; border-radius: 12px; transition: all 0.3s ease; }.content-card:hover{ border-color: #D4A843; box-shadow: 0 8px 20px rgba(212,168,67, 0.15); transform: translateY(-4px); }.content-card h3{ font-family: "Montserrat", sans-serif; font-size: 1.5rem; font-weight: 700; color: #D4A843; margin-bottom: 1rem; }.content-card p{ font-size: 1rem; line-height: 1.7; color: #555; }.bonus-section{ background: linear-gradient(135deg, #FFF8F0 0%, #FFFBF7 100%); padding: 2rem; border-left: 5px solid #D4A843; border-radius: 8px; }.bonus-section h2{ color: #D4A843; }.form-heading{ font-family: "Montserrat", sans-serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; color: #D4A843; margin-bottom: 0.5rem; }.form-subheading{ font-size: 1rem; color: #555; margin-bottom: 2rem; font-weight: 500; }.featured-image-section{ text-align: center; margin-bottom: 3rem; }.featured-image{ width: 100%; max-width: 800px; height: auto; border-radius: 16px; box-shadow: 0 8px 30px rgba(0,0,0,0.12); object-fit: cover; aspect-ratio: 16/9; }.featured-caption{ font-size: 1rem; color: #777; margin-top: 1rem; font-style: italic; max-width: 700px; margin-left: auto; margin-right: auto; }
  @media (max-width: 768px) {.content-grid{ grid-template-columns: 1fr; }.content-card{ padding: 1.5rem; }.bonus-section{ padding: 1.5rem; } }
</style>
