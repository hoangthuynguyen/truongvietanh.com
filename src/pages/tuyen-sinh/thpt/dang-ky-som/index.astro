---
import SqueezePageLayout from '../../../../layouts/SqueezePageLayout.astro';
import LeadFormTwoStepEmailFirst from '../../../../components/LeadFormTwoStepEmailFirst.astro';
import USPGrid from '../../../../components/USPGrid.astro';
import TrustMetrics from '../../../../components/TrustMetrics.astro';
import FAQSection from '../../../../components/FAQSection.astro';

const pageTitle = 'Early Bird THPT 2026-2027 — Đóng Trước 3 Năm, Giảm Tới 26% | Việt Anh';
const pageDescription = 'Early Bird THPT Việt Anh 2026–2027: đóng trước trọn cấp 3 năm, mức giảm tăng dần 6% → 26%, khoá giá học phí theo năm đầu. Đổi ý vẫn rút được sau 30 ngày báo trước. Hotline: 0916 961 409.';
const canonicalUrl = 'https://truongvietanh.com/tuyen-sinh/thpt/dang-ky-som';

const uspItems = [
  { icon: '💰', text: 'Đóng trước trọn cấp 3 năm — giảm dần 6% → 16% → 26%. Toàn bộ tính trên học phí niêm yết năm lớp 10, nên trần tăng 10% mỗi năm không còn ảnh hưởng tới phần đã đóng.' },
  { icon: '🎯', text: 'Ưu tiên chọn lớp & cơ sở gần nhà — Đăng ký trước, chọn trước. Đăng ký muộn phải "còn đâu xếp đó", có thể bị xếp vào cơ sở xa hơn hoặc lớp không phải lựa chọn đầu tiên.' },
  { icon: '🎓', text: 'Con từ THCS Việt Anh có GPA 7.5+ tự động lên THPT không cần thi. Vào lớp 10, con tiếp tục tự giành các học bổng GRIT, CHAMPIONS và LEADERS — cộng dồn với Early Bird, không có mức trần.' },
  { icon: '📋', text: 'Miễn phí đánh giá năng lực đầu vào — Bài test Toán + Tiếng Anh giúp biết chính xác trình độ con, từ đó chuyên viên lập lộ trình 3 năm cá nhân hóa ngay trước khi nhập học.' },
  { icon: '👩‍🏫', text: 'Tư vấn lộ trình ĐH/du học 1-1 ngay khi đăng ký — Con bước vào lớp 10 đã có định hướng rõ ràng: mục tiêu IELTS, khối thi, danh sách trường ĐH phù hợp, thay vì mất nửa năm "tìm đường".' },
  { icon: '🔄', text: 'Đổi ý vẫn rút được toàn bộ phần tiền chưa dùng — chỉ cần báo trước 30 ngày, không cần lý do, không mất phí phạt. Phần thời gian con đã học vẫn giữ nguyên mức ưu đãi đã hưởng.' }
];

const metrics = [
  { number: '60', label: 'Suất lớp 10 mới mỗi năm (3 lớp x 20 em/lớp)' },
  { number: '26%', label: 'Mức giảm Early Bird khi đóng trước trọn 3 năm THPT' },
  { number: '300+', label: 'Phụ huynh quan tâm mỗi năm — suất có hạn' },
  { number: '30 ngày', label: 'Báo trước là rút được tiền, không phí phạt' }
];

const faqItems = [
  {
    question: 'Early Bird có gì khác so với đóng học phí từng năm?',
    answer: 'Early Bird là đóng trước học phí cho nhiều năm — với THPT là trọn cấp 3 năm. Đóng trước đến năm thứ mấy thì năm đó được giảm bấy nhiêu: năm 1 giảm 6%, năm 2 giảm 16%, năm 3 giảm 26%. Nhưng phần giá trị lớn nhất không nằm ở mức giảm: toàn bộ được tính trên học phí niêm yết của năm lớp 10, trong khi học phí trường có quy định tăng tối đa 10% mỗi năm. Early Bird không có hạn chót và không giới hạn suất — đây là một cách đóng học phí chứ không phải khuyến mãi, ba/mẹ chọn lúc nào cũng được. Đổi lại, nên cân nhắc kỹ: chỉ chọn khi gia đình đã có quỹ dự phòng riêng và xác định con học hết cấp tại Việt Anh.'
  },
  {
    question: 'Con chưa thi xong lớp 9, đăng ký sớm có được không?',
    answer: 'Hoàn toàn được. Đăng ký sớm là "giữ chỗ" và hưởng ưu đãi — con vẫn hoàn thành lớp 9 bình thường. Sau khi có kết quả cuối năm, con làm bài đánh giá năng lực tại Việt Anh (Toán + Tiếng Anh, không khó, chỉ để đánh giá trình độ). Nếu con từ THCS Việt Anh có GPA 7.5+, tự động lên lớp 10 mà không cần thi. Quyền lợi Early Bird vẫn giữ nguyên dù con chưa tốt nghiệp lớp 9 tại thời điểm đăng ký.'
  },
  {
    question: 'Học phí THPT Việt Anh bao nhiêu? Có trả góp được không?',
    answer: 'Học phí THPT Việt Anh phụ thuộc vào cơ sở và chương trình cụ thể, bao gồm đầy đủ: IELTS chính khóa, sách giáo khoa, ngoại khóa, tâm lý học đường. Khi đăng ký tư vấn, chuyên viên sẽ báo giá chi tiết và minh bạch. Trường hỗ trợ thanh toán linh hoạt: theo học kỳ, theo quý, hoặc theo năm (trả năm được giảm thêm). Với Early Bird, ba/mẹ được khóa mức học phí hiện tại cho cả 3 năm — lợi ích tài chính rất lớn mà đăng ký muộn không có.'
  },
  {
    question: 'Nếu đăng ký sớm rồi đổi ý thì sao? Có hoàn tiền không?',
    answer: 'Việt Anh có chính sách hoàn tiền rõ ràng và công bằng: nếu gia đình đổi ý trước tháng 8/2026, phí giữ chỗ được hoàn lại 100% hoặc chuyển sang năm sau. Chúng tôi hiểu rằng chọn trường THPT là quyết định lớn — ba/mẹ cần thời gian cân nhắc kỹ lưỡng. Đăng ký sớm không phải "cam kết cứng" mà là "giữ quyền lợi tốt nhất cho con" trong khi vẫn có đủ thời gian suy nghĩ và so sánh.'
  },
  {
    question: 'Hạn chót đăng ký sớm là khi nào? Suất có hết sớm không?',
    answer: 'Chương trình Early Bird THPT 2026-2027 áp dụng từ tháng 3 đến hết tháng 5/2026. Tuy nhiên, do chỉ tuyển 60 suất mà hàng năm 300+ phụ huynh quan tâm, các suất ưu đãi thường hết trước hạn. Năm ngoái, 80% suất Early Bird đã được đăng ký trong tháng 3-4. Ba/mẹ nên đăng ký tư vấn sớm nhất có thể — chỉ cần để lại thông tin bên dưới, chuyên viên sẽ liên hệ trong 24h để xác nhận ưu đãi.'
  }
];
---

<SqueezePageLayout
  title={pageTitle}
  description={pageDescription}
  keywords="đăng ký sớm THPT, early bird, học phí, trường Việt Anh, tuyển sinh lớp 10, ưu đãi học phí, học bổng, giữ suất"
  schoolLevel="thpt"
  funnelCode="early-bird-thpt"
  canonicalUrl={canonicalUrl}
  ogImage="https://media.truongvietanh.com/images/giao-vien-28.webp"
>
  <div slot="hero">
    <h1 class="hero-h1">
      Early Bird THPT 2026-2027 — Đóng Trước Trọn 3 Năm, Giảm Tới 26%
    </h1>
    <p class="hero-subtitle">
      Đóng trước bao nhiêu năm, giảm bấy nhiêu: 6% → 16% → 26%, khoá giá theo học phí năm lớp 10
    </p>
  </div>

  <div slot="usp">
    <USPGrid items={uspItems} />
  </div>

  <div slot="trust">
    <TrustMetrics metrics={metrics} />
  </div>

  <div slot="content">
    <div class="content-image-section">
      <img src="https://media.truongvietanh.com/images/giao-vien-28.webp" alt="Giáo viên THPT Việt Anh tận tâm hướng dẫn từng em — lớp nhỏ 30 em, quan tâm cá nhân hóa" class="content-hero-image" width="1200" height="675" loading="lazy" />
      <p class="image-caption">Đội ngũ giáo viên Việt Anh tận tâm — đăng ký sớm để con được xếp lớp phù hợp nhất</p>
    </div>

    <div class="content-section">
      <h2>Tại sao đăng ký sớm là quyết định thông minh nhất?</h2>
      <div class="content-grid">
        <div class="content-card">
          <h3>Đóng trước trọn 3 năm — giảm tới 26% và khoá giá theo năm lớp 10</h3>
          <p>Early Bird cho ba/mẹ hai thứ. Thứ nhất là mức giảm tăng dần theo số năm đóng trước: năm 1 giảm 6%, năm 2 giảm 16%, năm 3 giảm 26%. Thứ hai — và đây mới là phần lớn giá trị — toàn bộ được tính trên học phí niêm yết của năm lớp 10, trong khi học phí trường có quy định tăng tối đa 10% mỗi năm. Ưu đãi này cộng dồn với mọi ưu đãi và học bổng khác, không có mức trần tổng. Và nếu giữa chừng đổi ý, ba/mẹ lấy lại được toàn bộ phần tiền chưa dùng chỉ với 30 ngày báo trước, không mất phí phạt. Mọi con số tính trên học phí, không gồm phí dịch vụ, tiền ăn, xe đưa đón và nội trú. Xem bảng tính đầy đủ tại <a href="/hoc-bong">trang Học bổng &amp; ưu đãi học phí</a>.</p>
        </div>
        <div class="content-card">
          <h3>Ưu tiên chọn lớp & cơ sở — Đăng ký trước, chọn trước</h3>
          <p>Việt Anh chỉ tuyển 60 em lớp 10 mới (3 lớp, ~20 em/lớp) tại 2 cơ sở Gò Vấp, Bình Tân. Đăng ký sớm, con được ưu tiên xếp vào lớp phù hợp nhất với năng lực và cơ sở gần nhà nhất. Đăng ký muộn, con phải "còn đâu xếp đó" — có thể bị xếp vào cơ sở xa hơn hoặc lớp không phải lựa chọn ưu tiên. Đây là lợi ích mà tiền không mua được — chỉ thời gian quyết định.</p>
        </div>
        <div class="content-card">
          <h3>Lên thẳng lớp 10 — và bốn học bổng con tự giành</h3>
          <p>Nếu con đang học THCS tại Việt Anh và có GPA 7.5+, con được tự động lên THPT mà không cần thi đầu vào. Vào lớp 10, con tiếp tục tự giành bốn học bổng của trường: GRIT thưởng chuỗi tự học đều đặn mỗi ngày, CHAMPIONS 2–20 triệu đồng cho em đạt giải thi đấu, LEADERS 10 triệu đồng mỗi suất cho em cho đi và dẫn dắt, TALENTS 25–100 triệu đồng cho học sinh ngoài trường ở các tỉnh. Bốn học bổng này cộng dồn với nhau và cộng dồn với Early Bird, không có mức trần tổng — chi tiết tại <a href="/hoc-bong">trang Học bổng &amp; ưu đãi học phí</a>. Đối với học sinh từ ngoài, bài đánh giá năng lực đầu vào (Toán + Tiếng Anh) được miễn phí hoàn toàn.</p>
        </div>
        <div class="content-card">
          <h3>Tư vấn lộ trình sớm — Con vào lớp 10 đã có mục tiêu</h3>
          <p>Khi đăng ký sớm, con được đánh giá năng lực miễn phí và nhận lộ trình cá nhân hóa từ chuyên viên: mục tiêu IELTS theo từng năm, khối thi THPTQG phù hợp, danh sách trường ĐH/du học tiềm năng. Con bước vào lớp 10 đã biết "mình học để đi đâu" thay vì mất nửa năm tìm đường. Ba/mẹ cũng yên tâm hơn vì có kế hoạch rõ ràng, không mơ hồ lo lắng "con sẽ thi gì, vào trường nào".</p>
        </div>
      </div>
    </div>

    <div class="content-section bonus-section">
      <h2 style="color: #26275D;">Bonus: Chính sách hoàn tiền 100% — Không rủi ro</h2>
      <p style="font-size: 1.05rem; line-height: 1.8; color: #333; text-align: center; max-width: 800px; margin: 0 auto 1.5rem;">
        Đăng ký sớm không phải là "cam kết cứng". Nếu gia đình đổi ý trước tháng 8/2026, <strong>phí giữ chỗ được hoàn 100%</strong> hoặc chuyển sang năm sau. Ba/mẹ hoàn toàn yên tâm: giữ chỗ trước, hưởng ưu đãi trước, quyết định sau.
      </p>
      <p style="font-size: 1.05rem; line-height: 1.8; color: #333; text-align: center; max-width: 800px; margin: 0 auto 0;">
        Trong khi ba/mẹ suy nghĩ, các suất ưu đãi đang giảm dần mỗi ngày. <strong>Không rủi ro, chỉ có lợi ích</strong> khi hành động sớm.
      </p>
    </div>
  </div>

  <div slot="form">
    <h2 class="form-heading">Đăng ký sớm THPT 2026-2027 — Giữ suất ưu đãi ngay</h2>
    <p class="form-subheading">Để lại thông tin để nhận bảng tính Early Bird riêng cho lớp của con và tư vấn lộ trình 1-1. Chuyên viên sẽ liên hệ trong 24h.</p>
    <LeadFormTwoStepEmailFirst
      formId="early-bird-thpt-form"
      funnelCode="early-bird-thpt"
      schoolLevel="thpt"
      submitText="Đăng ký sớm — Nhận ưu đãi"
      successMessage="Cảm ơn Ba/Mẹ! Chuyên viên tuyển sinh sẽ liên hệ trong 24h để xác nhận ưu đãi Early Bird và sắp xếp lịch tư vấn."
    />
  </div>

  <div slot="faq">
    <FAQSection items={faqItems} title="Câu hỏi thường gặp về đăng ký sớm THPT Việt Anh" />
  </div>
</SqueezePageLayout>

<style>.hero-h1{ font-family: "Montserrat", sans-serif; font-size: clamp(1.75rem, 5vw, 2.75rem); font-weight: 800; line-height: 1.2; margin-bottom: 1rem; color: #26275D; }.hero-subtitle{ font-size: clamp(1rem, 3vw, 1.25rem); font-weight: 500; opacity: 0.95; color: #26275D; }.content-image-section{ text-align: center; margin-bottom: 3rem; }.content-hero-image{ width: 100%; max-width: 900px; height: auto; border-radius: 16px; box-shadow: 0 8px 30px rgba(0,0,0,0.12); }.image-caption{ font-size: 1rem; color: #5c6e80; margin-top: 0.75rem; font-style: italic; }.content-section{ margin-bottom: 3rem; }.content-section h2{ font-family: "Montserrat", sans-serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; margin-bottom: 2rem; color: #26275D; text-align: center; }.content-grid{ display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; max-width: 1200px; margin: 0 auto; }.content-card{ padding: 2rem; background: white; border: 2px solid #e0e0e0; border-radius: 12px; transition: all 0.3s ease; }.content-card:hover{ border-color: #f9dd0e; box-shadow: 0 8px 20px rgba(249, 221, 14, 0.15); transform: translateY(-4px); }.content-card h3{ font-family: "Montserrat", sans-serif; font-size: 1.5rem; font-weight: 700; color: #26275D; margin-bottom: 1rem; }.content-card p{ font-size: 1rem; line-height: 1.7; color: #555; }.bonus-section{ background: linear-gradient(135deg, #FFF8F0 0%, #FFFBF7 100%); padding: 2rem; border-left: 5px solid #f9dd0e; border-radius: 8px; }.bonus-section h2{ color: #f9dd0e; }.form-heading{ font-family: "Montserrat", sans-serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; color: #f9dd0e; margin-bottom: 0.5rem; }.form-subheading{ font-size: 1rem; color: rgba(255,255,255,0.85); margin-bottom: 2rem; font-weight: 500; }
  @media (max-width: 768px) {.content-grid{ grid-template-columns: 1fr; }.content-card{ padding: 1.5rem; }.bonus-section{ padding: 1.5rem; }.content-hero-image{ border-radius: 10px; } }
</style>
