---
import SqueezePageLayout from '../../../layouts/SqueezePageLayout.astro';
import LeadFormTwoStepEmailFirst from '../../../components/LeadFormTwoStepEmailFirst.astro';
import USPGrid from '../../../components/USPGrid.astro';
import TrustMetrics from '../../../components/TrustMetrics.astro';
import FAQSection from '../../../components/FAQSection.astro';

const pageTitle = 'Tuyển Sinh THPT - Trường Liên Cấp Việt Anh';
const pageDescription = '90% học sinh Việt Anh đỗ đại học nguyện vọng 1 — 30% du học thành công. IELTS 6.5-7.5, Luyện THPTQG, Liên kết ĐH quốc tế, Lab hiện đại, Kỹ năng thế kỷ 21.';
const canonicalUrl = 'https://truongvietanh.com/tuyen-sinh/thpt';

const uspItems = [
  { icon: '🎓', text: '90%+ đỗ ĐH nguyện vọng 1 — Con bạn sẽ là 1 trong số đó' },
  { icon: '🌍', text: '30% du học thành công (Mỹ, Anh, Úc, Canada) — Con có "Hành trang quốc tế"' },
  { icon: '📚', text: 'IELTS 6.5-7.5 khi tốt nghiệp — Không cần "ôn thêm" sau THPT' },
  { icon: '🔬', text: 'THPTQG chiến lược từ lớp 10 — Không "dồn ép" lớp 12, không "ngủ 4 tiếng"' },
  { icon: '💼', text: 'Tư vấn Đại Học 1-1: Chọn đúng ngành, không phải "Ba/Mẹ đoán mò"' },
  { icon: '🏫', text: 'Liên kết 50+ ĐH trong & ngoài: Học sinh Việt Anh được "ưu tiên xét tuyển"' }
];

const metrics = [
  { number: '15+', label: 'Năm hành trình từ Tiểu Học đến THPT' },
  { number: '90%+', label: 'Đỗ ĐH Nguyện Vọng 1 (2025: 36/40 em)' },
  { number: '30%', label: 'Du học nước ngoài thành công (Mỹ, Anh, Úc, Canada)' },
  { number: '3', label: 'Cơ sở tiêu chuẩn tại TPHCM' }
];

const faqItems = [
  {
    question: 'Tại sao 90%+ vào ĐH NV1 — con tôi có vào được không?',
    answer: 'Câu hỏi đúng mà ba/mẹ lo lắng. Thực tế: Con bạn vào được nếu em (1) Hoàn thành 3 năm THPT Việt Anh với sáng suốt và chăm học, (2) Đạt điểm THPTQG 20+ (không cần 30 như trường khác), (3) IELTS 5.0+ (chúng tôi hỗ trợ tích cực). Không phải con phải là “thần đồng” — chỉ cần “chăm chỉ và có hướng dẫn đúng”. Nếu em yếu môn nào, cô sẽ hỗ trợ ngoài giờ học (không tính phí). Điểm khác biệt: Cô giáo tại Việt Anh sẽ “nhìn thấy” con em từ lớp 10 — biết điểm mạnh, điểm yếu, đặc điểm tính cách, mục tiêu học — không chỉ “chấm điểm”. Khi vào ĐH, con em được ưu tiên xét tuyển từ 50+ trường đại học đối tác. Đó là lý do 90%+ vào được nguyện vọng 1.'
  },
  {
    question: 'IELTS 6.5-7.5 — con tôi không giỏi Tiếng Anh, sợ không đạt?',
    answer: 'Sợ là chuyện bình thường của ba/mẹ. Nhưng thực tế tại Việt Anh: Lớp 10-12, IELTS được dạy “tích hợp” trong bài học Tiếng Anh chính khóa — không phải học thêm hay áp lực. Bắt đầu lớp 10, em làm IELTS Practice Test hàng tuần (1 tiếng), cô sẽ chỉ ra lỗi sai, mẹo trả lời nhanh. Lớp 11 tháng 5-6, em thi IELTS chính thức lần 1. Nếu chưa đạt 6.5, em được ôn lại hè (tuition miễn phí) và thi lại vào lớp 11. Hàng năm, >90% em Việt Anh đạt 5.5-6.5 trước tốt nghiệp. Có em mạnh hơn đạt 7.0-7.5 (điểm này dễ vào ĐH Australia/UK). Không phải vì con em là “thần đồng Tiếng Anh” mà vì em có “thời gian & hướng dẫn đúng”.'
  },
  {
    question: 'Luyện thi THPTQG từ lớp 10 — con lớp 10 sẽ mệt mỏi, áp lực không?',
    answer: 'Lo lắng rất hợp lý. Nhưng Việt Anh khác. Chúng tôi luyện “chiến lược” (học cách làm bài, phân tích xu hướng đề thi), không phải “nạp kiến thức từ đầu” khiến em mệt. Cụ thể: Từ lớp 10, mỗi tuần em làm 1 đề full THPTQG (mất 3 tiếng). Cô giáo sẽ phân tích: “Những câu nào em thường làm sai”, “Cách suy luận nhanh hơn”, “Cách quản lý thời gian”. Lớp 11-12, em không phải “ôn lại từ đầu” vì đã quen với loạt câu hỏi THPTQG. Lớp 12 chỉ là “ôn tập & tăng tốc độ” chứ không phải sợ hãi “ôn chóng vánh cuối”. Kết quả: Em sẽ tự tin, kiểm soát được tâm lý thi, không “hoảng sợ” hay “ngủ 4 tiếng”.'
  },
  {
    question: 'Muốn du học Mỹ/Anh/Úc/Canada — trường hỗ trợ không?',
    answer: 'Hỗ trợ toàn diện, từ A-Z. Bộ phận Tư vấn Du Học sẽ: (1) Giúp em chọn trường phù hợp với điểm & ngành yêu thích (không phải “chọn khó” rồi bị từ chối), (2) Hỗ trợ viết Essay & Motivation Letter (cô Việt viết cùng em bằng Việt, sau đó dịch & chỉnh lại), (3) Tư vấn toàn bộ quá trình Visa (giấy tờ, phỏng vấn, xin visa), (4) Liên hệ với trường đối tác, giới thiệu hồ sơ em. Hàng năm, 30% em Việt Anh THPT chọn du học thay vì ĐH Việt Nam. Nhiều em vào được các trường top (MIT, Harvard, Cambridge, LSE, University of Tokyo...). Không phải vì “em giỏi hơn con em trường khác” mà vì “em được hỗ trợ tốt, Essay hay, hồ sơ hoàn chỉnh”. Nếu con em muốn du học, Việt Anh sẽ biến đó thành hiện thực thay vì mơ mộng.'
  },
  {
    question: 'THPT Việt Anh chuyên gì? Có chuyên Toán/Khoa Học/Ngoại Ngữ không?',
    answer: 'Không có “chuyên Toán” hay “chuyên Lý” kiểu trường công. Nhưng Việt Anh linh hoạt hơn: Em được chọn “Khối học” (A00/A01/D01) ngay từ lớp 10 để tập trung vào những môn em yêu thích & cần cho tương lai. Ví dụ: Em thích Toán, chọn khối A01 (Toán-Lý-Hóa) — sẽ có nhiều giờ Toán, ít giờ Lịch Sử, dễ vào ngành Kỹ Sư hay Khoa Học. Em muốn du học Ngoại Ngữ hay chọn ngành tiếng Anh, chọn Khối D01 (Toán-Văn-Anh) — IELTS sẽ tăng nhanh, Văn học em cũng được chữa kỹ. Em muốn học Kiến Trúc hay Thiết Kế, chuyên sâu Mỹ Thuật — Việt Anh cũng linh hoạt điều chỉnh. Chúng tôi “cắt xén không cần thiết” để em tập trung, không bỏ lỡ kiến thức quan trọng, không làm em “quay cuồng với quá nhiều môn”.'
  },
  {
    question: 'Nhận hồ sơ THPT từ tháng mấy? Bao nhiêu suất? Có dễ vào không?',
    answer: 'Tuyển sinh THPT Việt Anh 2026-2027: Nhận hồ sơ từ tháng 3 hàng năm, tuyển ~60 học sinh lớp 10 mới (3 lớp, ~20 em/lớp). Hàng năm, 300+ phụ huynh quan tâm nhưng chỉ tuyển 60 em vì trường chủ ý giữ lớp nhỏ (max 30 em/lớp, không 40-50) để cô giáo có thể “nhìn thấy” từng em. Về tiêu chí: Nếu em từ THCS Việt Anh có GPA 7.5+, không cần thi đầu vào — tự động lên (ưu tiên liên cấp). Nếu em từ ngoài, phải thi đánh giá năng lực Tiếng Anh & Toán (không khó, để đánh giá trình độ). Điểm THPTQG hiện tại không quan trọng (chúng tôi sẽ giúp em tăng từ lớp 10). Nên đăng ký tư vấn sớm (tháng 3-4/2026) để không bỏ lỡ suất.'
  }
];
---

<SqueezePageLayout
  title={pageTitle}
  description={pageDescription}
  keywords="THPT, tuyển sinh THPT, trung học phổ thông, trường Việt Anh, song ngữ, du học, IELTS"
  schoolLevel="thpt"
  funnelCode="tuyen-sinh-thpt"
  canonicalUrl={canonicalUrl}
>
  <div slot="hero">
    <h1 class="hero-h1">
      90% vào ĐH nguyện vọng 1, 30% du học thành công — Con bạn sẽ là 1 trong số đó
    </h1>
    <p class="hero-subtitle">
      Lớp 10-12 không phải "ôn lại cũ" — Mà là "Xây hành trang cho đại học trong nước & quốc tế"
    </p>
  </div>

  <div slot="usp">
    <USPGrid items={uspItems} />
  </div>

  <div slot="trust">
    <TrustMetrics metrics={metrics} />
  </div>

  <div slot="content">
    <div class="content-section">
      <h2>Tại sao 3 năm THPT Việt Anh thay đổi cả tương lai?</h2>
      <div class="content-grid">
        <div class="content-card">
          <h3>THPTQG từ lớp 10 — Chiến lược, không "dồn ép" lớp 12</h3>
          <p>Trong khi trường khác lớp 12 mới bắt đầu "ôn chóng vánh" & dạy thêm khắp nơi, con bạn tại Việt Anh đã làm 100+ đề THPTQG, biết cách làm bài nhanh & đúng từ lớp 10. Lớp 12, con không sợ "lạc đường" hay "hoảng sợ" mà tự tin, có kế hoạch rõ ràng. Ba/Mẹ không cần lo con "ngủ 4 tiếng, ôn 20 tiếng" lớp 12. Đó là lý do 90%+ vào được nguyện vọng 1.</p>
        </div>
        <div class="content-card">
          <h3>IELTS 6.5-7.5 khi tốt nghiệp — Không phải "học thêm"</h3>
          <p>Hàng tuần từ lớp 10, em làm IELTS Practice Test trong giờ Tiếng Anh chính khóa (không phải học thêm hay tốn tiền). Lớp 11 tháng 5, em thi IELTS chính thức có chứng chỉ quốc tế. Khi vào ĐH Việt Nam, con em đã có "Hộ chiếu Tiếng Anh" — vào được lớp chuyên Anh ngay. Muốn du học? Rào cản IELTS đã xóa sạch từ lớp 11.</p>
        </div>
        <div class="content-card">
          <h3>Tư vấn Đại Học 1-1 — Không "mẹ bảo, con theo"</h3>
          <p>Lớp 11 tháng 1, mỗi em được 1 buổi tư vấn riêng (cô + ba/mẹ) để khám phá ngành & trường phù hợp. Không phải cảnh "mẹ muốn con làm Bác Sĩ, con lại thích Kiến Trúc" dẫn đến giận dỗi. Chúng tôi sẽ giúp con "hiểu bản thân", chọn ngành mà con thật sự yêu thích & phù hợp với năng lực. Lớp 12 con học không áp lực vì đã chọn đúng con đường.</p>
        </div>
        <div class="content-card">
          <h3>Du học không phải "mơ mộng" — Mà là "hiện thực"</h3>
          <p>Hàng năm, 30% em Việt Anh THPT chọn du học (Mỹ, Anh, Úc, Canada, Nhật). Không phải em "giỏi kinh khủng" mà vì em được "hỗ trợ toàn diện" — cô chỉ cách viết Essay, chỉnh hồ sơ, tư vấn visa, liên hệ trường. Nếu con em muốn du học, Việt Anh sẽ biến nó thành hiện thực thay vì mơ mộng vô vàn.</p>
        </div>
      </div>
    </div>

    <div class="content-section bonus-section">
      <h2 style="color: #E8792B;">Bonus: Lớp nhỏ 30 em & Liên kết 50+ Đại Học</h2>
      <p style="font-size: 1.05rem; line-height: 1.8; color: #333; text-align: center; max-width: 800px; margin: 0 auto 2rem;">
        <strong>Lớp 10-12 tối đa 30 em/lớp</strong> — Cô giáo sẽ biết tên từng em, điểm mạnh, điểm yếu, mục tiêu đại học. Không cảnh "lớp 50 em, cô chỉ nhớ tên cái" ở trường công. <strong>Liên kết 50+ Đại Học</strong> trong nước (ĐH Bách Khoa, Ngoại Thương, Ngoại Giao, Y Hà Nội, HUFLIT...) & quốc tế (George Mason, RMIT, Macquarie, Waseda...). Học sinh Việt Anh được "ưu tiên xét tuyển" vào những ngành tốt, không phải chờ đợi THPTQG hay "ngồi chờ số" lo lắng.
      </p>
    </div>
  </div>

  <div slot="form">
    <h2 class="form-heading">Chỉ còn ~20 suất cho lớp 10 năm học 2026-2027</h2>
    <p class="form-subheading">Hàng năm, 300+ phụ huynh quan tâm nhưng Việt Anh chỉ tuyển 60 em lớp 10 mới (để giữ lớp nhỏ 30 em). Ba/Mẹ nên tham quan & tư vấn sớm (tháng 3-5/2026 lý tưởng nhất) để không bỏ lỡ suất.</p>
    <LeadFormTwoStepEmailFirst
      formId="tuyen-sinh-form"
      funnelCode="tuyen-sinh-thpt"
      schoolLevel="thpt"
      submitText="Đăng ký tư vấn ngay"
      successMessage="Cảm ơn Ba/Mẹ! Chúng tôi sẽ liên hệ trong 24h để sắp xếp lịch tham quan & tư vấn chi tiết."
    />
  </div>

  <div slot="faq">
    <FAQSection items={faqItems} title="Những câu hỏi Ba/Mẹ hay hỏi" />
  </div>
</SqueezePageLayout>

<style>
  .hero-h1 { font-family: "Montserrat", sans-serif; font-size: clamp(1.75rem, 5vw, 2.75rem); font-weight: 800; line-height: 1.2; margin-bottom: 1rem; color: #1F4E79; }
  .hero-subtitle { font-size: clamp(1rem, 3vw, 1.25rem); font-weight: 500; opacity: 0.95; color: #E8792B; }
  .content-section { margin-bottom: 3rem; }
  .content-section h2 { font-family: "Montserrat", sans-serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; margin-bottom: 2rem; color: #1F4E79; text-align: center; }
  .content-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; max-width: 1200px; margin: 0 auto; }
  .content-card { padding: 2rem; background: white; border: 2px solid #e0e0e0; border-radius: 12px; transition: all 0.3s ease; }
  .content-card:hover { border-color: #E8792B; box-shadow: 0 8px 20px rgba(232, 121, 43, 0.15); transform: translateY(-4px); }
  .content-card h3 { font-family: "Montserrat", sans-serif; font-size: 1.25rem; font-weight: 700; color: #E8792B; margin-bottom: 1rem; }
  .content-card p { font-size: 0.95rem; line-height: 1.7; color: #555; }
  .bonus-section { background: linear-gradient(135deg, #FFF8F0 0%, #FFFBF7 100%); padding: 2rem; border-left: 5px solid #E8792B; border-radius: 8px; }
  .bonus-section h2 { color: #E8792B; }
  .form-heading { font-family: "Montserrat", sans-serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; color: #E8792B; margin-bottom: 0.5rem; }
  .form-subheading { font-size: 1rem; color: #555; margin-bottom: 2rem; font-weight: 500; }
  @media (max-width: 768px) { .content-grid { grid-template-columns: 1fr; } .content-card { padding: 1.5rem; } .bonus-section { padding: 1.5rem; } }
</style>
