---
import SqueezePageLayout from '../../../../layouts/SqueezePageLayout.astro';
import LeadFormTwoStepEmailFirst from '../../../../components/LeadFormTwoStepEmailFirst.astro';
import USPGrid from '../../../../components/USPGrid.astro';
import TrustMetrics from '../../../../components/TrustMetrics.astro';
import FAQSection from '../../../../components/FAQSection.astro';

const pageTitle = 'Tham Quan THPT Việt Anh — Xem Cơ Sở Vật Chất & Gặp Giáo Viên Trực Tiếp | Miễn Phí';
const pageDescription = 'Đặt lịch tham quan THPT Việt Anh miễn phí. Xem phòng học hiện đại, lab khoa học, trung tâm hướng nghiệp, gặp giáo viên trực tiếp. 90 phút trải nghiệm thực tế + tư vấn lộ trình ĐH/du học 1-1. Hotline: 0916 961 409.';
const canonicalUrl = 'https://truongvietanh.com/tuyen-sinh/thpt/tham-quan-truong';

const uspItems = [
  { icon: '🏫', text: 'Tham quan 2 cơ sở THPT tại TP.HCM — Gò Vấp, Bình Tân. Ba/mẹ chọn cơ sở gần nhà nhất hoặc tham quan cả 2 để so sánh trước khi quyết định.' },
  { icon: '🔬', text: 'Lab Khoa Học hiện đại đạt chuẩn quốc tế — Phòng thí nghiệm Hóa, Lý, Sinh đầy đủ thiết bị để con thực hành mỗi tuần, không chỉ học lý thuyết suông trên giấy.' },
  { icon: '📚', text: 'Thư viện 5.000+ đầu sách song ngữ Việt-Anh — Tài liệu IELTS, SAT, sách tham khảo THPTQG, và sách phát triển kỹ năng mềm phục vụ hướng nghiệp từ lớp 10.' },
  { icon: '👨‍🏫', text: 'Gặp giáo viên chủ nhiệm và bộ môn trực tiếp — Hiểu phong cách dạy, cách theo dõi từng em, cách phối hợp với gia đình trước khi ba/mẹ đưa ra quyết định.' },
  { icon: '🎓', text: 'Trung tâm Hướng Nghiệp & Du học — Nơi 30% học sinh xây dựng hồ sơ du học thành công. Ba/mẹ sẽ thấy quy trình tư vấn ĐH 1-1 và bảng thành tích du học các khóa trước.' },
  { icon: '🏃', text: 'Sân thể thao, phòng nhạc, phòng mỹ thuật & 15+ CLB ngoại khóa — Con phát triển toàn diện cả thể chất lẫn tinh thần, có tuổi học trò vui vẻ chứ không chỉ "cắm đầu vào sách".' }
];

const metrics = [
  { number: '90p', label: 'Buổi tham quan trải nghiệm thực tế + tư vấn 1-1' },
  { number: '2', label: 'Cơ sở tiêu chuẩn tại TP.HCM (Gò Vấp, Bình Tân)' },
  { number: '100%', label: 'Miễn phí hoàn toàn — Không ràng buộc đăng ký' },
  { number: '500+', label: 'Gia đình đã tham quan và tin tưởng chọn Việt Anh' }
];

const faqItems = [
  {
    question: 'Buổi tham quan trường diễn ra như thế nào?',
    answer: 'Buổi tham quan kéo dài khoảng 90 phút, gồm 3 phần rõ ràng. Phần 1 (30 phút): Tham quan cơ sở vật chất — phòng học, lab khoa học, thư viện, sân thể thao, canteen. Phần 2 (30 phút): Gặp giáo viên chủ nhiệm và ban giám hiệu — trao đổi về chương trình, phương pháp dạy, đời sống học sinh. Phần 3 (30 phút): Tư vấn 1-1 với chuyên viên tuyển sinh — phân tích học lực con, đề xuất lộ trình ĐH/du học. Ba/mẹ nên đưa con đi cùng để con cảm nhận trực tiếp không khí trường.'
  },
  {
    question: 'Tham quan có mất phí không? Có bắt buộc đăng ký sau đó không?',
    answer: 'Hoàn toàn miễn phí và không ràng buộc bất cứ điều gì. Việt Anh tổ chức tham quan để ba/mẹ và con trải nghiệm thực tế trước khi quyết định, không có áp lực đăng ký tại chỗ. Nhiều gia đình tham quan 2-3 lần ở các cơ sở khác nhau trước khi đưa ra quyết định cuối cùng. Chúng tôi tin rằng "thấy tận mắt" tốt hơn ngàn lời quảng cáo nên luôn hoan nghênh ba/mẹ đến bất cứ lúc nào.'
  },
  {
    question: 'Con tôi có thể ngồi dự thử 1 buổi học thực tế không?',
    answer: 'Hoàn toàn có thể. Ngoài tham quan cơ sở vật chất, Việt Anh cho phép con ngồi dự thính 1-2 tiết học thực tế (Toán, Tiếng Anh, hoặc Khoa học tùy lịch). Con sẽ ngồi cùng các anh chị lớp 10-11 để cảm nhận không khí lớp học: giáo viên dạy như thế nào, bạn bè tương tác ra sao, bài tập có phù hợp không. Đây là cách tốt nhất để con tự quyết định "có muốn học ở đây không" thay vì chỉ nghe ba/mẹ kể lại.'
  },
  {
    question: 'Nên đặt lịch tham quan vào thời điểm nào là tốt nhất?',
    answer: 'Thời điểm lý tưởng là tháng 3-5/2026 cho năm học 2026-2027 vì đầu năm các lớp còn chỗ trống, con dễ được xếp lớp phù hợp nhất. Ba/mẹ cũng có đủ thời gian so sánh Việt Anh với các trường khác trước mùa tuyển sinh. Đăng ký sớm (Early Bird) còn được hưởng ưu đãi giảm học phí đến 15% và ưu tiên chọn lớp. Tuy nhiên, Việt Anh chào đón tham quan quanh năm — ba/mẹ có thể đặt lịch bất cứ lúc nào thuận tiện.'
  },
  {
    question: 'Trường có xe đưa đón không? Cơ sở nào gần khu vực tôi?',
    answer: 'Việt Anh có 2 cơ sở tại TP.HCM: Gò Vấp và Bình Tân. Cơ sở chính: 160/72 Phan Huy Ích, phường An Hội Tây, TP.HCM — gần nhiều quận lân cận. Khi đặt lịch tham quan, chuyên viên tuyển sinh sẽ tư vấn cơ sở gần nhà nhất, tuyến xe đưa đón có sẵn, và chi phí cụ thể. Ba/mẹ gọi hotline 0916 961 409 để được tư vấn nhanh nhất.'
  }
];
---

<SqueezePageLayout
  title={pageTitle}
  description={pageDescription}
  keywords="tham quan trường THPT, school tour, cơ sở vật chất, trường Việt Anh, lớp 10, tuyển sinh, gặp giáo viên"
  schoolLevel="thpt"
  funnelCode="tour-thpt"
  canonicalUrl={canonicalUrl}
  ogImage="https://media.truongvietanh.com/images/the-thao-07.webp"
>
  <div slot="hero">
    <h1 class="hero-h1">
      Tham Quan THPT Việt Anh — Xem Tận Mắt, Gặp Giáo Viên, Quyết Định Đúng
    </h1>
    <p class="hero-subtitle">
      90 phút trải nghiệm thực tế + Tư vấn lộ trình ĐH/du học cá nhân hóa — Hoàn toàn miễn phí, không ràng buộc
    </p>
  </div>

  <div slot="usp">
    <USPGrid items={uspItems} />
  </div>

  <div slot="trust">
    <TrustMetrics metrics={metrics} />
  </div>

  <div slot="content">
    <div class="content-image-section">
      <img src="https://media.truongvietanh.com/images/the-thao-07.webp" alt="Học sinh THPT Việt Anh hoạt động thể thao trên sân trường — phát triển toàn diện thể chất và tinh thần" class="content-hero-image" width="1200" height="675" loading="lazy" />
      <p class="image-caption">Sân thể thao rộng rãi tại Việt Anh — nơi con phát triển toàn diện cả thể chất lẫn tinh thần</p>
    </div>

    <div class="content-section">
      <h2>Ba/Mẹ sẽ thấy gì khi tham quan THPT Việt Anh?</h2>
      <div class="content-grid">
        <div class="content-card">
          <h3>Phòng học & Lab khoa học chuẩn quốc tế</h3>
          <p>Phòng học THPT Việt Anh được trang bị máy chiếu tương tác, bàn ghế linh hoạt cho học nhóm, điều hòa mát mẻ — thiết kế theo chuẩn quốc tế để con thoải mái học tập. Lab Hóa-Lý-Sinh có đầy đủ thiết bị thí nghiệm hiện đại, con được thực hành mỗi tuần thay vì chỉ học lý thuyết trên giấy. Phòng tin học trang bị máy tính mới, phần mềm lập trình và thiết kế cho môn Tin học và các dự án STEM. Ba/mẹ sẽ thấy ngay sự khác biệt rõ rệt so với cơ sở vật chất trường công.</p>
        </div>
        <div class="content-card">
          <h3>Trung tâm Hướng Nghiệp & Tư vấn Du học</h3>
          <p>Đây là nơi mỗi em được tư vấn 1-1 về chọn ngành, chọn trường ĐH trong nước và quốc tế với đội ngũ 5+ chuyên viên tư vấn giàu kinh nghiệm. Trung tâm trưng bày thư viện thông tin về 50+ trường ĐH đối tác và bảng thành tích du học của các khóa trước — ba/mẹ sẽ thấy những tấm gương thực tế. Ba/mẹ được giới thiệu lộ trình 3 năm cụ thể cho con: mục tiêu IELTS, lịch thi THPTQG, timeline viết essay và nộp hồ sơ du học. Đây là điều mà không website nào có thể truyền tải bằng trải nghiệm trực tiếp.</p>
        </div>
        <div class="content-card">
          <h3>Gặp giáo viên — Hiểu phong cách dạy trước khi chọn</h3>
          <p>Ba/mẹ sẽ gặp trực tiếp giáo viên chủ nhiệm và giáo viên bộ môn chính (Toán, Tiếng Anh, Khoa học) để trao đổi về phương pháp dạy và cách theo dõi từng em. Thầy cô chia sẻ cách phối hợp với gia đình khi con gặp khó khăn trong học tập hoặc tâm lý. Đây là cơ hội để ba/mẹ đánh giá: "Thầy/cô này có phù hợp với tính cách và nhu cầu của con mình không?" Một điều mà không brochure hay video quảng cáo nào có thể thay thế được.</p>
        </div>
        <div class="content-card">
          <h3>Đời sống học sinh — CLB, thể thao, canteen & tuổi trẻ</h3>
          <p>THPT không chỉ là học sách vở. Ba/mẹ sẽ thấy sân bóng đá, bóng rổ, phòng nhạc, phòng mỹ thuật và danh sách 15+ CLB ngoại khóa: Debate, Robotics, Nhạc kịch, Tình nguyện, Nhiếp ảnh, Khởi nghiệp. Canteen phục vụ bữa ăn đạt chuẩn dinh dưỡng do chuyên gia lên menu, thay đổi hàng tuần để con không chán. Con sẽ có tuổi học trò trọn vẹn: vừa học giỏi, vừa có bạn bè, có đam mê, phát triển toàn diện.</p>
        </div>
      </div>
    </div>

    <div class="content-section bonus-section">
      <h2 style="color: #f9dd0e;">Bonus: Nhận bản đồ lộ trình 3 năm cá nhân hóa khi tham quan</h2>
      <p style="font-size: 1.05rem; line-height: 1.8; color: #333; text-align: center; max-width: 800px; margin: 0 auto 1.5rem;">
        Sau buổi tham quan, chuyên viên tuyển sinh sẽ gửi ba/mẹ <strong>bản đồ lộ trình 3 năm cá nhân hóa</strong> cho con — gồm: mục tiêu IELTS theo từng năm, lịch thi THPTQG, danh sách trường ĐH phù hợp với năng lực con, và timeline du học nếu con muốn đi xa.
      </p>
      <p style="font-size: 1.05rem; line-height: 1.8; color: #333; text-align: center; max-width: 800px; margin: 0 auto 0;">
        Tài liệu này hoàn toàn <strong>miễn phí</strong>, dù ba/mẹ có đăng ký hay không. Xem như món quà cảm ơn ba/mẹ đã dành thời gian đến thăm trường.
      </p>
    </div>
  </div>

  <div slot="form">
    <h2 class="form-heading">Đặt lịch tham quan THPT Việt Anh — Miễn phí 100%</h2>
    <p class="form-subheading">Chỉ cần để lại thông tin, chuyên viên sẽ liên hệ trong 24h để sắp xếp lịch phù hợp nhất với ba/mẹ và con.</p>
    <LeadFormTwoStepEmailFirst
      formId="tour-thpt-form"
      funnelCode="tour-thpt"
      schoolLevel="thpt"
      submitText="Đặt lịch tham quan miễn phí"
      successMessage="Cảm ơn Ba/Mẹ! Chuyên viên sẽ liên hệ trong 24h để sắp xếp lịch tham quan phù hợp nhất."
    />
  </div>

  <div slot="faq">
    <FAQSection items={faqItems} title="Câu hỏi thường gặp về tham quan THPT Việt Anh" />
  </div>
</SqueezePageLayout>

<style>.hero-h1{ font-family: "Montserrat", sans-serif; font-size: clamp(1.75rem, 5vw, 2.75rem); font-weight: 800; line-height: 1.2; margin-bottom: 1rem; color: #26275D; }.hero-subtitle{ font-size: clamp(1rem, 3vw, 1.25rem); font-weight: 500; opacity: 0.95; color: #f9dd0e; }.content-image-section{ text-align: center; margin-bottom: 3rem; }.content-hero-image{ width: 100%; max-width: 900px; height: auto; border-radius: 16px; box-shadow: 0 8px 30px rgba(0,0,0,0.12); }.image-caption{ font-size: 1rem; color: #777; margin-top: 0.75rem; font-style: italic; }.content-section{ margin-bottom: 3rem; }.content-section h2{ font-family: "Montserrat", sans-serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; margin-bottom: 2rem; color: #26275D; text-align: center; }.content-grid{ display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; max-width: 1200px; margin: 0 auto; }.content-card{ padding: 2rem; background: white; border: 2px solid #e0e0e0; border-radius: 12px; transition: all 0.3s ease; }.content-card:hover{ border-color: #f9dd0e; box-shadow: 0 8px 20px rgba(249, 221, 14, 0.15); transform: translateY(-4px); }.content-card h3{ font-family: "Montserrat", sans-serif; font-size: 1.5rem; font-weight: 700; color: #f9dd0e; margin-bottom: 1rem; }.content-card p{ font-size: 1rem; line-height: 1.7; color: #555; }.bonus-section{ background: linear-gradient(135deg, #FFF8F0 0%, #FFFBF7 100%); padding: 2rem; border-left: 5px solid #f9dd0e; border-radius: 8px; }.bonus-section h2{ color: #f9dd0e; }.form-heading{ font-family: "Montserrat", sans-serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; color: #f9dd0e; margin-bottom: 0.5rem; }.form-subheading{ font-size: 1rem; color: #555; margin-bottom: 2rem; font-weight: 500; }
  @media (max-width: 768px) {.content-grid{ grid-template-columns: 1fr; }.content-card{ padding: 1.5rem; }.bonus-section{ padding: 1.5rem; }.content-hero-image{ border-radius: 10px; } }
</style>
