---
import SqueezePageLayout from '../../../../layouts/SqueezePageLayout.astro';
import LeadFormTwoStepEmailFirst from '../../../../components/LeadFormTwoStepEmailFirst.astro';
import USPGrid from '../../../../components/USPGrid.astro';
import TrustMetrics from '../../../../components/TrustMetrics.astro';
import FAQSection from '../../../../components/FAQSection.astro';

const pageTitle = 'Checklist Chọn Trường Tiểu Học – 9 Tiêu Chí Quan Trọng';
const pageDescription = 'Tải miễn phí Checklist 9 tiêu chí giúp Ba/Mẹ chọn trường Tiểu Học tốt nhất cho con.';
const canonicalUrl = 'https://truongvietanh.com/tuyen-sinh/tieu-hoc/checklist';

const uspItems = [
  { icon: '✅', text: '9 tiêu chí đầy đủ - Đánh giá toàn diện mọi khía cạnh' },
  { icon: '📋', text: 'Bảng so sánh nhanh - So sánh dễ dàng giữa các trường' },
  { icon: '📅', text: 'Lộ trình chuẩn bị 6 tháng - Hướng dẫn từng bước' },
  { icon: '🎓', text: 'Tiêu chí được giáo viên chuyên gia xây dựng' },
  { icon: '💪', text: 'Xây dựng sự tự tin cho ba/mẹ trong quyết định' },
  { icon: '🤝', text: 'Tư vấn miễn phí sau khi tải - Giải đáp mọi thắc mắc' }
];

const metrics = [
  { number: '15+', label: 'Năm kinh nghiệm giáo dục' },
  { number: '500+', label: 'Học sinh Tiểu Học' },
  { number: '98%', label: 'Phụ huynh hài lòng' },
  { number: '3', label: 'Cơ sở tại TPHCM' }
];

const faqItems = [
  { question: 'Checklist này có miễn phí không?', answer: 'Hoàn toàn miễn phí! Chúng tôi muốn giúp ba/mẹ có những công cụ tốt nhất để lựa chọn trường cho con. Bạn chỉ cần để lại email để nhận tài liệu ngay trong vài phút. Không có chi phí, không có ràng buộc - chúng tôi tin rằng giáo dục tốt cho con em là lợi ích chung.' },
  { question: 'Checklist có áp dụng cho tất cả các trường không?', answer: 'Vâng! 9 tiêu chí này được xây dựng bởi các chuyên gia giáo dục và áp dụng được cho mọi trường tiểu học, dù là trường công lập hay tư thục, song ngữ hay một ngôn ngữ. Chúng tôi không thiên vị cho Việt Anh - mục tiêu là giúp bạn đánh giá khách quan và chọn trường thật sự phù hợp với con em bạn.' },
  { question: 'Ngoài checklist còn nhận được gì?', answer: 'Ngoài checklist 9 tiêu chí, bạn sẽ nhận thêm: (1) Bảng so sánh trường - để so sánh dễ dàng giữa các trường lựa chọn, (2) Lộ trình chuẩn bị vào lớp 1 trong 6 tháng - từng bước cụ thể để chuẩn bị con em phát triển cả về mặt học tập lẫn kỹ năng sống, và (3) Quyền tư vấn miễn phí từ đội ngũ Tuyển sinh Việt Anh - họ sẵn sàng giúp bạn phân tích checklist và trả lời mọi câu hỏi.' }
];
---

<SqueezePageLayout
  title={pageTitle}
  description={pageDescription}
  keywords="checklist chọn trường, tiêu chí chọn trường tiểu học, trường Việt Anh"
  schoolLevel="tieu-hoc"
  funnelCode="checklist-tieu-hoc"
  canonicalUrl={canonicalUrl}
>
  <div slot="hero">
    <h1 class="hero-h1">Checklist 9 Tiêu Chí Chọn Trường<br/>Lựa Chọn Tự Tin Cho Con Em</h1>
    <p class="hero-subtitle">Công cụ miễn phí từ giáo viên chuyên gia - Giúp bạn đưa ra quyết định đúng đắn</p>
  </div>

  <div slot="usp">
    <USPGrid items={uspItems} />
  </div>

  <div slot="trust">
    <TrustMetrics metrics={metrics} />
  </div>

  <div slot="content">
    <div class="content-section">
      <h2>Bạn sẽ nhận được gì?</h2>
      <div class="content-grid">
        <div class="content-card">
          <h3>9 Tiêu Chí Toàn Diện - Đánh Giá Mọi Khía Cạnh</h3>
          <p>Checklist bao gồm 9 tiêu chí quan trọng được giáo viên chuyên gia xây dựng, từ chất lượng chương trình học, trình độ giáo viên, cơ sở vật chất, tiêu chuẩn an toàn, chất lượng dinh dưỡng, ngoại khóa, văn hóa trường học, đến phí tổn và phục vụ khách hàng. Bạn sẽ hiểu rõ tất cả những yếu tố ảnh hưởng đến sự phát triển của con em.</p>
        </div>
        <div class="content-card">
          <h3>Bảng So Sánh Trường - Nhìn Tổng Quan Dễ Dàng</h3>
          <p>Kèm theo là một template bảng so sánh các trường tiểu học trong khu vực (hoặc bất kỳ trường nào bạn xem xét). Bạn chỉ cần điền thông tin từng trường vào các tiêu chí, rồi nhìn bảng để so sánh một cách khách quan. Điều này giúp bạn không bỏ sót tiêu chí nào, và quyết định trở nên sáng suốt hơn.</p>
        </div>
        <div class="content-card">
          <h3>Lộ Trình Chuẩn Bị 6 Tháng - Từng Bước Cụ Thể</h3>
          <p>Ngoài checklist, bạn sẽ nhận lộ trình chuẩn bị cho con vào lớp 1 chi tiết 6 tháng trước nhập học. Bao gồm cách phát triển kỹ năng xã hội, tập trung và kiên nhẫn trong học tập, kỹ năng tự chăm sóc bản thân, và chuẩn bị tinh thần. Lộ trình này giúp con em chuẩn bị tốt nhất cho cuộc chuyển tiếp quan trọng.</p>
        </div>
        <div class="content-card">
          <h3>Tư Vấn Miễn Phí Từ Chuyên Gia Giáo Dục</h3>
          <p>Sau khi tải checklist, bạn có quyền tư vấn miễn phí từ đội ngũ chuyên gia Tuyển sinh của Trường Việt Anh. Họ sẽ giúp bạn hiểu checklist sâu hơn, phân tích thông tin từng trường, trả lời mọi câu hỏi chi tiết, và hỗ trợ bạn ra quyết định tốt nhất cho con em bạn.</p>
        </div>
      </div>
    </div>
  </div>

  <div slot="form">
    <h2 class="form-heading">Tải Checklist 9 Tiêu Chí Ngay Hôm Nay</h2>
    <p class="form-subheading">Hoàn toàn miễn phí - Nhận qua email trong vòng 5 phút</p>
    <LeadFormTwoStepEmailFirst
      formId="tuyen-sinh-form"
      funnelCode="checklist-tieu-hoc"
      schoolLevel="tieu-hoc"
      submitText="Nhận Checklist"
      successMessage="Checklist đã được gửi qua email! Vui lòng kiểm tra hộp thư (và thư mục Spam)."
    />
  </div>

  <div slot="faq">
    <FAQSection items={faqItems} title="Câu hỏi về Checklist chọn trường" />
  </div>
</SqueezePageLayout>

<style>
  .hero-h1 { font-family: "Montserrat", sans-serif; font-size: clamp(1.75rem, 5vw, 2.75rem); font-weight: 800; line-height: 1.2; margin-bottom: 1rem; color: #1F4E79; }
  .hero-subtitle { font-size: clamp(1rem, 3vw, 1.25rem); font-weight: 500; opacity: 0.95; color: #E8792B; }
  .content-section h2 { font-family: "Montserrat", sans-serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; margin-bottom: 2rem; color: #1F4E79; text-align: center; }
  .content-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; max-width: 1200px; margin: 0 auto; }
  .content-card { padding: 2rem; background: white; border: 2px solid #e0e0e0; border-radius: 12px; transition: all 0.3s ease; }
  .content-card:hover { border-color: #E8792B; box-shadow: 0 8px 20px rgba(232, 121, 43, 0.12); transform: translateY(-4px); }
  .content-card h3 { font-family: "Montserrat", sans-serif; font-size: 1.25rem; font-weight: 700; color: #E8792B; margin-bottom: 1rem; }
  .content-card p { font-size: 0.95rem; line-height: 1.6; color: #555; }
  .form-heading { font-family: "Montserrat", sans-serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; color: #E8792B; margin-bottom: 0.5rem; }
  .form-subheading { font-size: 1rem; color: #555; font-weight: 500; margin-bottom: 2rem; }
  @media (max-width: 768px) { .content-grid { grid-template-columns: 1fr; } .content-card { padding: 1.5rem; } }
</style>
