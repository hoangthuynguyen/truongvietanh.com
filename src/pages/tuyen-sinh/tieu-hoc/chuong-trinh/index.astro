---
import SqueezePageLayout from '../../../../layouts/SqueezePageLayout.astro';
import LeadFormTwoStepEmailFirst from '../../../../components/LeadFormTwoStepEmailFirst.astro';
import USPGrid from '../../../../components/USPGrid.astro';
import TrustMetrics from '../../../../components/TrustMetrics.astro';
import FAQSection from '../../../../components/FAQSection.astro';

const pageTitle = 'Chương Trình Tiểu Học Song Ngữ – Trường Việt Anh';
const pageDescription = 'Tìm hiểu chương trình Tiểu Học song ngữ chuẩn quốc tế tại Trường Việt Anh: Cambridge, STEM, ngoại khóa phong phú.';
const canonicalUrl = 'https://truongvietanh.com/tuyen-sinh/tieu-hoc/chuong-trinh';

const uspItems = [
  { icon: '📚', text: 'Cambridge pathway từ lớp 1 - Hướng tới chứng chỉ quốc tế' },
  { icon: '🔬', text: 'STEM tích hợp từ sớm - Phát triển tư duy logic và sáng tạo' },
  { icon: '🗣️', text: 'Giáo viên bản ngữ Anh - Môi trường tiếng Anh tự nhiên' },
  { icon: '👥', text: 'Lớp nhỏ 25 học sinh - Chú ý cá nhân cho mỗi bé' },
  { icon: '🌟', text: 'Đánh giá năng lực thường xuyên - Phục vụ nhu cầu từng trẻ' },
  { icon: '🏅', text: 'Tiêu chuẩn kép: Cambridge + Bộ GD&ĐT Việt Nam' }
];

const metrics = [
  { number: '15+', label: 'Năm kinh nghiệm giáo dục' },
  { number: '500+', label: 'Học sinh Tiểu Học' },
  { number: '98%', label: 'Phụ huynh hài lòng' },
  { number: '3', label: 'Cơ sở tại TPHCM' }
];

const faqItems = [
  { question: 'Chương trình có được Bộ GD&ĐT công nhận không?', answer: 'Hoàn toàn công nhận. Trường Việt Anh được Sở GD&ĐT TP.HCM cấp phép chính thức và chương trình Tiểu Học đáp ứng đầy đủ yêu cầu của Bộ GD&ĐT Việt Nam. Điều này đảm bảo rằng con bạn sẽ không gặp khó khăn nếu muốn chuyển sang trường công lập hay các trường khác trong tương lai.' },
  { question: 'Tỷ lệ tiếng Anh trong chương trình là bao nhiêu?', answer: 'Khoảng 50% thời lượng học bằng tiếng Anh, bao gồm Toán, Khoa học, Tiếng Anh chuyên sâu, và các hoạt động liên quan. Nhưng không phải 50-50 một cách cứng nhắc - chúng tôi điều chỉnh theo từng giai đoạn phát triển của bé. Từ lớp 1, các giáo viên bản ngữ tạo môi trường tiếng Anh tự nhiên, giúp bé tiếp xúc với ngôn ngữ một cách thoải mái mà không áp lực.' },
  { question: 'Học sinh có thể chuyển sang trường công lập được không?', answer: 'Hoàn toàn có thể, và các em sẽ không gặp bất kỳ vấn đề nào. Chương trình Tiểu Học Việt Anh đạt tiêu chuẩn Bộ GD&ĐT nên học sinh được công nhận đầy đủ các kết quả học tập. Nhiều phụ huynh chọn Việt Anh vì chương trình toàn diện này tạo nền tảng vững chắc cho con, dù con sau đó theo học bất kỳ trường nào.' }
];
---

<SqueezePageLayout
  title={pageTitle}
  description={pageDescription}
  keywords="chương trình tiểu học, song ngữ, Cambridge, STEM, trường Việt Anh"
  schoolLevel="tieu-hoc"
  funnelCode="chuong-trinh-tieu-hoc"
  canonicalUrl={canonicalUrl}
>
  <div slot="hero">
    <h1 class="hero-h1">Chương Trình Tiểu Học Song Ngữ<br/>Xây Dựng Nền Tảng Vững Chắc Cho Tương Lai</h1>
    <p class="hero-subtitle">Kết hợp Cambridge + Bộ GD&ĐT: Tiếng Anh thành thạo, Tư duy toàn cầu, Kỹ năng sống vượt trội</p>
  </div>

  <div slot="usp">
    <USPGrid items={uspItems} />
  </div>

  <div slot="trust">
    <TrustMetrics metrics={metrics} />
  </div>

  <div slot="content">
    <div class="content-section">
      <h2>Điểm nổi bật của chương trình</h2>
      <div class="content-grid">
        <div class="content-card">
          <h3>Tiêu Chuẩn Kép: Cambridge + Bộ GD&ĐT</h3>
          <p>Chương trình kết hợp hai tiêu chuẩn quốc tế Cambridge với chương trình chuẩn Bộ GD&ĐT Việt Nam. Con bạn sẽ nắm vững kiến thức Việt Nam, đồng thời phát triển tư duy toàn cầu và khả năng tiếng Anh cạnh tranh. Đây là sự cân bằng hoàn hảo giữa truyền thống và hiện đại.</p>
        </div>
        <div class="content-card">
          <h3>STEM từ Lớp 1: Hình Thành Tư Duy Sáng Tạo</h3>
          <p>Không chờ đến lớp 4 hay 5, bé được tiếp xúc với STEM ngay từ lớp 1 thông qua phòng lab hiện đại, dự án thực tế, và các thí nghiệm thú vị. Điều này giúp phát triển khả năng giải quyết vấn đề, tư duy logic, và sáng tạo - những kỹ năng thiết yếu cho thế kỷ 21.</p>
        </div>
        <div class="content-card">
          <h3>Tiếng Anh Chuyên Sâu Với Giáo Viên Bản Ngữ</h3>
          <p>50% thời lượng học bằng tiếng Anh, với các giáo viên bản ngữ từ Anh, Mỹ, Úc... tạo môi trường tiếng Anh tự nhiên. Mục tiêu của chúng tôi là con bạn đạt chuẩn A2-B1 khi kết thúc Tiểu Học, sẵn sàng cho các kỳ thi Cambridge chính thức.</p>
        </div>
        <div class="content-card">
          <h3>20+ Club Ngoại Khóa: Phát Triển Toàn Diện</h3>
          <p>Từ bóng đá, bơi lội, piano, robotics, coding, mỹ thuật, đến nhảy hiện đại - con bạn có cơ hội khám phá đam mê thực sự và phát triển kỹ năng mềm như teamwork, lãnh đạo, và tự tin. Mỗi bé là duy nhất, và chúng tôi tin rằng giáo dục toàn diện mới tạo nên thành công thực sự.</p>
        </div>
      </div>
    </div>
  </div>

  <div slot="form">
    <h2 class="form-heading">Khám Phá Chương Trình Chi Tiết Hôm Nay</h2>
    <p class="form-subheading">Nhận brochure chi tiết + tư vấn miễn phí từ chuyên gia giáo dục</p>
    <LeadFormTwoStepEmailFirst
      formId="tuyen-sinh-form"
      funnelCode="chuong-trinh-tieu-hoc"
      schoolLevel="tieu-hoc"
      submitText="Nhận thông tin"
      successMessage="Brochure chương trình đã gửi qua email! Bộ phận Tuyển sinh sẽ liên hệ hỗ trợ thêm."
    />
  </div>

  <div slot="faq">
    <FAQSection items={faqItems} title="Câu hỏi về Chương trình Tiểu Học" />
  </div>
</SqueezePageLayout>

<style>
  .hero-h1 { font-family: "Montserrat", sans-serif; font-size: clamp(1.75rem, 5vw, 2.75rem); font-weight: 800; line-height: 1.2; margin-bottom: 1rem; color: #1F4E79; }
  .hero-subtitle { font-size: clamp(1rem, 3vw, 1.25rem); font-weight: 500; opacity: 0.95; color: #E8792B; }
  .content-section h2 { font-family: "Montserrat", sans-serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; margin-bottom: 2rem; color: #1F4E79; text-align: center; }
  .content-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; max-width: 1200px; margin: 0 auto; }
  .content-card { padding: 2rem; background: white; border: 2px solid #e0e0e0; border-radius: 12px; transition: all 0.3s ease; }
  .content-card:hover { border-color: #E8792B; box-shadow: 0 8px 20px rgba(232, 121, 43, 0.12); transform: translateY(-4px); }
  .content-card h3 { font-family: "Montserrat", sans-serif; font-size: 1.25rem; font-weight: 700; color: #E8792B; margin-bottom: 1rem; }
  .content-card p { font-size: 0.95rem; line-height: 1.6; color: #555; }
  .form-heading { font-family: "Montserrat", sans-serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; color: #E8792B; margin-bottom: 0.5rem; }
  .form-subheading { font-size: 1rem; color: #555; font-weight: 500; margin-bottom: 2rem; }
  @media (max-width: 768px) { .content-grid { grid-template-columns: 1fr; } .content-card { padding: 1.5rem; } }
</style>
