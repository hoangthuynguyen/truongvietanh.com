---
import SqueezePageLayout from '../../../../layouts/SqueezePageLayout.astro';
import LeadFormTwoStepEmailFirst from '../../../../components/LeadFormTwoStepEmailFirst.astro';
import USPGrid from '../../../../components/USPGrid.astro';
import TrustMetrics from '../../../../components/TrustMetrics.astro';
import FAQSection from '../../../../components/FAQSection.astro';

const pageTitle = 'Đăng Ký Sớm Tiểu Học 2026 – Ưu Đãi Học Phí | Trường Việt Anh';
const pageDescription = 'Đăng ký sớm chương trình Tiểu Học 2026 tại Trường Việt Anh để nhận ưu đãi học phí và ưu tiên xếp lớp song ngữ.';
const canonicalUrl = 'https://truongvietanh.com/tuyen-sinh/tieu-hoc/dang-ky-som';

const uspItems = [
  { icon: '💰', text: 'Giảm 15% học phí năm đầu - Tiết kiệm hàng chục triệu đồng' },
  { icon: '🎁', text: 'Tặng bộ đồ dùng học tập trị giá 3 triệu đồng' },
  { icon: '👥', text: 'Ưu tiên chọn lớp song ngữ chất lượng cao - Giới hạn 25 học sinh' },
  { icon: '📋', text: 'Đánh giá năng lực miễn phí + Lộ trình học tập cá nhân' },
  { icon: '⏰', text: 'Khóa mức học phí tốt nhất - Không tăng suốt 5 năm Tiểu Học' },
  { icon: '🚀', text: 'Giữ chỗ cho con ngay hôm nay - Không phải lo chỗ lớp' }
];

const metrics = [
  { number: '15+', label: 'Năm kinh nghiệm giáo dục' },
  { number: '500+', label: 'Học sinh Tiểu Học' },
  { number: '98%', label: 'Phụ huynh hài lòng' },
  { number: '3', label: 'Cơ sở tại TPHCM' }
];

const faqItems = [
  { question: 'Ưu đãi đăng ký sớm bao gồm những gì?', answer: 'Một gói ưu đãi toàn diện: giảm 15% học phí năm đầu tiên (tiết kiệm hàng chục triệu đồng), tặng bộ đồ dùng học tập và sách giáo khoa trị giá 3 triệu đồng, ưu tiên chọn lớp song ngữ chất lượng cao (giới hạn chỉ 25 học sinh/lớp), đánh giá năng lực miễn phí, và xây dựng lộ trình học tập cá nhân cho con. Ngoài ra, bạn sẽ khóa mức học phí tốt nhất - cam kết không tăng phí suốt 5 năm Tiểu Học.' },
  { question: 'Hạn chót đăng ký sớm là khi nào?', answer: 'Chương trình ưu đãi Early Bird áp dụng đến hết ngày 30/06/2026 hoặc khi đủ chỉ tiêu, tùy theo điều kiện nào xảy ra trước. Bạn nên đăng ký sớm để không bỏ lỡ ưu đãi, vì số chỗ trong lớp song ngữ rất hạn chế - chỉ 25 học sinh mỗi lớp.' },
  { question: 'Con chưa đủ tuổi vào lớp 1, có đăng ký được không?', answer: 'Chương trình Tiểu Học chính thức dành cho bé đủ 6 tuổi tính đến tháng 9/2026 (hoặc tuần đầu năm học). Nếu con bạn sinh sau ngày đó, bạn vẫn có thể liên hệ với bộ phận Tuyển sinh để đăng ký giữ chỗ trước và xác định mốc thời gian phù hợp cho con. Chúng tôi cũng có các chương trình mầm non song ngữ nếu con chưa sẵn sàng vào lớp 1.' }
];
---

<SqueezePageLayout
  title={pageTitle}
  description={pageDescription}
  keywords="đăng ký sớm tiểu học, early bird tiểu học, trường Việt Anh, ưu đãi học phí"
  schoolLevel="tieu-hoc"
  funnelCode="early-bird-tieu-hoc"
  canonicalUrl={canonicalUrl}
>
  <div slot="hero">
    <h1 class="hero-h1">Đăng Ký Sớm Tiểu Học 2026<br/>Tiết Kiệm Hàng Chục Triệu & Giữ Chỗ Cho Con Ngay</h1>
    <p class="hero-subtitle">Giảm 15% học phí, tặng 3 triệu đồng đồ dùng, ưu tiên lớp song ngữ - Hạn chót 30/06</p>
  </div>

  <div slot="usp">
    <USPGrid items={uspItems} />
  </div>

  <div slot="trust">
    <TrustMetrics metrics={metrics} />
  </div>

  <div slot="content">
    <div class="content-section">
      <h2>Tại sao đăng ký sớm Tiểu Học Việt Anh?</h2>
      <div class="content-grid">
        <div class="content-card">
          <h3>Tiết Kiệm Học Phí - Khóa Giá Tốt Nhất Suốt 5 Năm</h3>
          <p>Giảm 15% học phí năm đầu tiên khi đăng ký trước 30/06/2026 - tức là tiết kiệm hàng chục triệu đồng! Quan trọng hơn, bạn sẽ khóa mức học phí này và cam kết không tăng phí suốt 5 năm Tiểu Học. Đó là sự bảo mật tài chính cho gia đình bạn.</p>
        </div>
        <div class="content-card">
          <h3>Ưu Tiên Chọn Lớp Song Ngữ Chất Lượng Cao</h3>
          <p>Những bạn đăng ký sớm sẽ được ưu tiên chọn lớp song ngữ với sĩ số giới hạn chỉ 25 học sinh/lớp. Điều này có ý nghĩa vô cùng quan trọng vì nó đảm bảo con bạn nhận được sự chú ý cá nhân từ giáo viên, không phải để trong lớp quá đông. Con bạn sẽ thực sự phát triển được!</p>
        </div>
        <div class="content-card">
          <h3>Tặng Bộ Đồ Dùng & Sách Giáo Khoa Trị Giá 3 Triệu</h3>
          <p>Nhận ngay trọn bộ đồ dùng học tập, đồng phục, và sách giáo khoa cho năm học đầu tiên. Điều này giúp bạn không phải tốn thêm tiền, và con bạn bắt đầu năm học mới với đầy đủ trang bị sắc sỏi và tự tin.</p>
        </div>
        <div class="content-card">
          <h3>Đánh Giá Năng Lực & Lộ Trình Học Tập Cá Nhân</h3>
          <p>Con bạn sẽ được đánh giá năng lực đầu vào miễn phí, giúp chúng tôi hiểu rõ điểm mạnh và những lĩnh vực cần hỗ trợ. Từ đó, chúng tôi xây dựng lộ trình học tập riêng biệt phù hợp với mỗi bé, thay vì dạy theo khuôn mẫu chung. Đó là giáo dục lấy học sinh làm trung tâm thực sự.</p>
        </div>
      </div>
    </div>
  </div>

  <div slot="form">
    <h2 class="form-heading">Đăng Ký Sớm Ngay Hôm Nay - Không Phải Chôi Chân Chờ Đợi!</h2>
    <p class="form-subheading">Chỉ cần 2 phút - Nhận ưu đãi trong vòng 24h, bộ phận Tuyển sinh sẽ liên hệ</p>
    <LeadFormTwoStepEmailFirst
      formId="tuyen-sinh-form"
      funnelCode="early-bird-tieu-hoc"
      schoolLevel="tieu-hoc"
      submitText="Giữ chỗ ngay"
      successMessage="Cảm ơn Ba/Mẹ! Bộ phận Tuyển sinh sẽ gửi thông tin ưu đãi qua email trong 24h."
    />
  </div>

  <div slot="faq">
    <FAQSection items={faqItems} title="Câu hỏi về Đăng ký sớm Tiểu Học" />
  </div>
</SqueezePageLayout>

<style>
  .hero-h1 { font-family: "Montserrat", sans-serif; font-size: clamp(1.75rem, 5vw, 2.75rem); font-weight: 800; line-height: 1.2; margin-bottom: 1rem; color: #1F4E79; }
  .hero-subtitle { font-size: clamp(1rem, 3vw, 1.25rem); font-weight: 500; opacity: 0.95; color: #E8792B; }
  .content-section h2 { font-family: "Montserrat", sans-serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; margin-bottom: 2rem; color: #1F4E79; text-align: center; }
  .content-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; max-width: 1200px; margin: 0 auto; }
  .content-card { padding: 2rem; background: white; border: 2px solid #e0e0e0; border-radius: 12px; transition: all 0.3s ease; }
  .content-card:hover { border-color: #E8792B; box-shadow: 0 8px 20px rgba(232, 121, 43, 0.12); transform: translateY(-4px); }
  .content-card h3 { font-family: "Montserrat", sans-serif; font-size: 1.25rem; font-weight: 700; color: #E8792B; margin-bottom: 1rem; }
  .content-card p { font-size: 0.95rem; line-height: 1.6; color: #555; }
  .form-heading { font-family: "Montserrat", sans-serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; color: #E8792B; margin-bottom: 0.5rem; }
  .form-subheading { font-size: 1rem; color: #555; font-weight: 500; margin-bottom: 2rem; }
  @media (max-width: 768px) { .content-grid { grid-template-columns: 1fr; } .content-card { padding: 1.5rem; } }
</style>
