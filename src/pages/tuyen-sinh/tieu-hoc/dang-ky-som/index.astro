---
import SqueezePageLayout from '../../../../layouts/SqueezePageLayout.astro';
import LeadFormTwoStepEmailFirst from '../../../../components/LeadFormTwoStepEmailFirst.astro';
import USPGrid from '../../../../components/USPGrid.astro';
import TrustMetrics from '../../../../components/TrustMetrics.astro';
import FAQSection from '../../../../components/FAQSection.astro';

const pageTitle = 'Đăng Ký Sớm Tiểu Học 2026 — Ưu Đãi Học Phí & Suất Ưu Tiên';
const pageDescription = 'Đăng ký sớm Tiểu Học 2026 tại Trường Việt Anh: giảm 15% học phí, khóa giá 5 năm, ưu tiên lớp song ngữ 25 học sinh. Hạn chót 30/06/2026.';
const canonicalUrl = 'https://truongvietanh.com/tuyen-sinh/tieu-hoc/dang-ky-som';

const uspItems = [
  { icon: '💰', text: 'Giảm 15% học phí năm đầu — Tiết kiệm hàng chục triệu đồng' },
  { icon: '🔒', text: 'Khóa mức học phí tốt nhất — Không tăng suốt 5 năm Tiểu Học' },
  { icon: '👥', text: 'Ưu tiên lớp song ngữ 25 HS — Đảm bảo con được chú ý cá nhân' },
  { icon: '🎁', text: 'Tặng bộ đồ dùng học tập trị giá 3 triệu đồng' },
  { icon: '📋', text: 'Đánh giá năng lực miễn phí + Lộ trình học tập riêng cho con' },
  { icon: '⏰', text: 'Chỉ 120 suất Early Bird — Đăng ký trước 30/06/2026' }
];

const metrics = [
  { number: '15+', label: 'Năm kinh nghiệm giáo dục' },
  { number: '120', label: 'Suất Early Bird giới hạn' },
  { number: '98%', label: 'Phụ huynh hài lòng' },
  { number: '15%', label: 'Giảm học phí năm đầu' }
];

const faqItems = [
  {
    question: 'Ưu đãi đăng ký sớm bao gồm cụ thể những gì?',
    answer: 'Gói Early Bird 2026 bao gồm: (1) Giảm 15% học phí năm đầu tiên — tiết kiệm hàng chục triệu đồng, (2) Khóa mức học phí hiện tại suốt 5 năm Tiểu Học — ba/mẹ không lo tăng phí hàng năm, (3) Tặng trọn bộ đồ dùng học tập, đồng phục và sách giáo khoa trị giá 3 triệu đồng, (4) Ưu tiên chọn lớp song ngữ chất lượng cao với sĩ số giới hạn 25 học sinh/lớp, (5) Đánh giá năng lực đầu vào miễn phí và xây dựng lộ trình học tập cá nhân cho con. Đây là gói ưu đãi toàn diện nhất trong năm, chỉ áp dụng cho phụ huynh đăng ký trước 30/06/2026.'
  },
  {
    question: 'Hạn chót đăng ký sớm là khi nào? Còn bao nhiêu suất?',
    answer: 'Chương trình Early Bird áp dụng đến hết ngày 30/06/2026 hoặc khi đủ 120 suất, tùy điều kiện nào xảy ra trước. Mỗi năm, số phụ huynh quan tâm luôn vượt xa số suất — năm 2025 chúng tôi nhận được hơn 200 đăng ký nhưng chỉ có 100 suất. Ba/mẹ nên đăng ký sớm để không bỏ lỡ, vì khi hết suất Early Bird, học phí sẽ trở về mức chính thức và không còn các ưu đãi kèm theo. Bộ phận Tuyển sinh sẽ liên hệ xác nhận trong vòng 24 giờ sau khi ba/mẹ đăng ký.'
  },
  {
    question: 'Khóa học phí 5 năm nghĩa là gì? Có cam kết bằng văn bản không?',
    answer: 'Khóa học phí nghĩa là mức học phí ba/mẹ đóng ở năm lớp 1 sẽ được giữ nguyên cho đến hết lớp 5 — không tăng theo lạm phát hay bất kỳ lý do nào. Cam kết này được ghi rõ trong hợp đồng nhập học, có giá trị pháp lý đầy đủ. Đây là chính sách đặc biệt chỉ dành cho phụ huynh đăng ký Early Bird, nhằm giúp gia đình yên tâm lập kế hoạch tài chính dài hạn cho con. Nhiều phụ huynh đánh giá đây là ưu đãi giá trị nhất vì trong 5 năm, học phí các trường tư thường tăng 10-15%/năm.'
  },
  {
    question: 'Con chưa đủ tuổi vào lớp 1 năm 2026, có đăng ký giữ chỗ được không?',
    answer: 'Chương trình Tiểu Học dành cho bé đủ 6 tuổi tính đến tháng 9/2026. Nếu con ba/mẹ sinh sau mốc này, ba/mẹ vẫn có thể liên hệ bộ phận Tuyển sinh để đăng ký giữ chỗ cho năm học 2027-2028 và nhận ưu đãi riêng. Ngoài ra, Trường Việt Anh có chương trình Mầm non song ngữ giúp con chuẩn bị sẵn sàng cho lớp 1 — bé sẽ quen với môi trường, giáo viên, và bạn bè trước khi bước vào Tiểu Học. Nhiều phụ huynh chọn con đường này và rất hài lòng vì con chuyển tiếp tự nhiên, không bỡ ngỡ.'
  },
  {
    question: 'Nếu đăng ký rồi mà đổi ý, có được hoàn tiền không?',
    answer: 'Giai đoạn đăng ký sớm, ba/mẹ chỉ cần để lại thông tin liên hệ — chưa cần đóng bất kỳ khoản phí nào. Bộ phận Tuyển sinh sẽ liên hệ tư vấn, mời tham quan trường, và khi ba/mẹ thực sự quyết định mới tiến hành thủ tục nhập học. Nếu sau khi tham quan mà ba/mẹ thấy chưa phù hợp, hoàn toàn không có ràng buộc gì. Chúng tôi muốn ba/mẹ chọn Việt Anh vì thật sự tin tưởng, không phải vì áp lực hay sợ mất tiền.'
  }
];
---

<SqueezePageLayout
  title={pageTitle}
  description={pageDescription}
  keywords="đăng ký sớm tiểu học, early bird tiểu học, trường Việt Anh, ưu đãi học phí 2026, giữ chỗ tiểu học"
  schoolLevel="tieu-hoc"
  funnelCode="early-bird-tieu-hoc"
  canonicalUrl={canonicalUrl}
>
  <div slot="hero">
    <h1 class="hero-h1">Đăng Ký Sớm Tiểu Học 2026<br/>Ưu Đãi Học Phí & Suất Ưu Tiên</h1>
    <p class="hero-subtitle">Giảm 15% học phí + Khóa giá 5 năm + Ưu tiên lớp song ngữ 25 HS — Chỉ 120 suất, hạn chót 30/06</p>
  </div>

  <div slot="usp">
    <USPGrid items={uspItems} />
  </div>

  <div slot="trust">
    <TrustMetrics metrics={metrics} />
  </div>

  <div slot="content">
    <div class="content-section hero-image-section">
      <img src="https://media.truongvietanh.com/images/phu-huynh-07.webp" alt="Phụ huynh đăng ký sớm nhập học tiểu học cho con tại Trường Việt Anh" class="hero-content-image" width="800" height="450" loading="lazy" />
      <p class="image-caption">Phụ huynh trao đổi với chuyên gia Tuyển sinh Trường Việt Anh về chương trình Early Bird Tiểu Học 2026</p>
    </div>

    <div class="content-section">
      <h2>Tại Sao Đăng Ký Sớm Là Quyết Định Thông Minh Nhất?</h2>
      <div class="content-grid">
        <div class="content-card">
          <h3>Tiết Kiệm Hàng Chục Triệu — Khóa Giá Suốt 5 Năm</h3>
          <p>Giảm 15% học phí năm đầu tiên là khoản tiết kiệm đáng kể ngay lập tức, nhưng lợi ích lớn nhất chính là khóa mức học phí không tăng suốt 5 năm Tiểu Học — cam kết bằng hợp đồng có giá trị pháp lý. Trong khi học phí các trường tư thục tại TPHCM thường tăng 10-15% mỗi năm, gia đình ba/mẹ sẽ yên tâm với mức phí cố định và lập kế hoạch tài chính dài hạn dễ dàng hơn. Tính ra, tổng tiết kiệm trong 5 năm có thể lên đến hàng trăm triệu đồng — đó là sự bảo đảm tài chính thực sự mà ít trường nào cung cấp.</p>
        </div>
        <div class="content-card">
          <h3>Ưu Tiên Lớp Song Ngữ Chất Lượng Cao</h3>
          <p>Lớp song ngữ tại Việt Anh giới hạn chỉ 25 học sinh/lớp — đây là tiêu chuẩn vàng được nghiên cứu giáo dục quốc tế khuyến nghị để đảm bảo mỗi bé nhận được sự chú ý cá nhân từ giáo viên. Phụ huynh đăng ký Early Bird được ưu tiên chọn lớp trước, không phải lo con bị xếp vào lớp đã đầy chỗ hoặc phải chờ danh sách dự bị. Con ba/mẹ sẽ học cùng giáo viên bản ngữ từ Anh, Mỹ, Úc có chứng chỉ TESOL/CELTA trong môi trường tiếng Anh tự nhiên, phát triển khả năng ngôn ngữ tự nhiên ngay từ ngày đầu lớp 1.</p>
        </div>
        <div class="content-card">
          <h3>Trọn Bộ Đồ Dùng & Sách Giáo Khoa Trị Giá 3 Triệu</h3>
          <p>Ba/mẹ không cần chạy đi mua sắm đồ dùng học tập — con sẽ nhận trọn bộ đồng phục (2 bộ mùa hè + 1 bộ thể dục), sách giáo khoa song ngữ, vở viết, và toàn bộ dụng cụ học tập cần thiết cho năm học đầu tiên. Điều này giúp con bắt đầu năm học mới với đầy đủ trang bị đồng nhất cùng các bạn, tự tin và sẵn sàng. Ba/mẹ cũng tiết kiệm thời gian chuẩn bị và yên tâm rằng mọi thứ đều đạt tiêu chuẩn nhà trường.</p>
        </div>
        <div class="content-card">
          <h3>Đánh Giá Năng Lực & Lộ Trình Học Tập Cá Nhân</h3>
          <p>Mỗi bé là duy nhất — chúng tôi không dạy theo khuôn mẫu chung cho tất cả. Con ba/mẹ sẽ được đánh giá năng lực đầu vào miễn phí bởi đội ngũ chuyên gia giáo dục để hiểu rõ điểm mạnh, sở thích, phong cách học tập, và những lĩnh vực cần hỗ trợ thêm. Từ đó, đội ngũ giáo viên xây dựng lộ trình học tập riêng biệt cho từng bé — bé khỏe tiếng Anh thì được thử thách nâng cao, bé cần hỗ trợ Toán thì có chương trình bổ trợ phù hợp, đảm bảo không bé nào bị bỏ lại phía sau.</p>
        </div>
      </div>
    </div>

    <div class="content-section bonus-section">
      <h2 style="color: #F0D048;">Bonus: Lộ Trình Nhập Học 2026 — Từng Bước Cụ Thể</h2>
      <p style="font-size: 1.05rem; line-height: 1.8; color: #333; text-align: center; max-width: 800px; margin: 0 auto;">
        <strong>Tháng 4-6/2026:</strong> Đăng ký Early Bird và nhận toàn bộ ưu đãi (giảm 15% + khóa giá 5 năm + quà tặng 3 triệu). <strong>Tháng 7:</strong> Tham quan trường, gặp giáo viên bản ngữ, bé trải nghiệm lớp học thử song ngữ thật sự. <strong>Tháng 8:</strong> Đánh giá năng lực đầu vào, nhận lộ trình học tập cá nhân và hướng dẫn chuẩn bị tâm lý cho con. <strong>Tháng 9:</strong> Con bước vào lớp 1 tự tin, với đầy đủ trang bị và sự hỗ trợ tận tâm từ đội ngũ giáo viên Việt Nam và bản ngữ. Ba/mẹ đăng ký càng sớm, con càng có nhiều thời gian chuẩn bị — gọi <strong>0916 961 409</strong> ngay hôm nay.
      </p>
    </div>
  </div>

  <div slot="form">
    <h2 class="form-heading">Giữ Chỗ Early Bird Ngay — Chỉ 120 Suất Cho Năm Học 2026</h2>
    <p class="form-subheading">Chỉ cần 2 phút đăng ký — Bộ phận Tuyển sinh sẽ liên hệ xác nhận và gửi thông tin ưu đãi trong 24h</p>
    <LeadFormTwoStepEmailFirst
      formId="early-bird-tieu-hoc-form"
      funnelCode="early-bird-tieu-hoc"
      schoolLevel="tieu-hoc"
      submitText="Giữ chỗ Early Bird"
      successMessage="Cảm ơn Ba/Mẹ! Bộ phận Tuyển sinh sẽ gửi thông tin ưu đãi chi tiết qua email trong 24h và liên hệ xác nhận."
    />
  </div>

  <div slot="faq">
    <FAQSection items={faqItems} title="Câu hỏi về Đăng ký sớm Tiểu Học 2026" />
  </div>
</SqueezePageLayout>

<style>.hero-h1{ font-family: "Montserrat", sans-serif; font-size: clamp(1.75rem, 5vw, 2.75rem); font-weight: 800; line-height: 1.2; margin-bottom: 1rem; color: #1F4E79; }.hero-subtitle{ font-size: clamp(1rem, 3vw, 1.25rem); font-weight: 500; opacity: 0.95; color: #F0D048; }.content-section{ margin-bottom: 3rem; }.content-section h2{ font-family: "Montserrat", sans-serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; margin-bottom: 2rem; color: #1F4E79; text-align: center; }.content-grid{ display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; max-width: 1200px; margin: 0 auto; }.content-card{ padding: 2rem; background: white; border: 2px solid #e0e0e0; border-radius: 12px; transition: all 0.3s ease; }.content-card:hover{ border-color: #F0D048; box-shadow: 0 8px 20px rgba(240, 208, 72, 0.12); transform: translateY(-4px); }.content-card h3{ font-family: "Montserrat", sans-serif; font-size: 1.5rem; font-weight: 700; color: #F0D048; margin-bottom: 1rem; }.content-card p{ font-size: 1rem; line-height: 1.7; color: #555; }.bonus-section{ background: linear-gradient(135deg, #FFF8F0 0%, #FFFBF7 100%); padding: 2rem; border-left: 5px solid #F0D048; border-radius: 8px; }.form-heading{ font-family: "Montserrat", sans-serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; color: #F0D048; margin-bottom: 0.5rem; }.form-subheading{ font-size: 1rem; color: #555; margin-bottom: 2rem; font-weight: 500; }.hero-image-section{ text-align: center; margin-bottom: 2rem; }.hero-content-image{ width: 100%; max-width: 800px; height: auto; border-radius: 12px; box-shadow: 0 8px 30px rgba(0,0,0,0.12); }.image-caption{ font-size: 1rem; color: #777; margin-top: 0.75rem; font-style: italic; }
  @media (max-width: 768px) {.content-grid{ grid-template-columns: 1fr; }.content-card{ padding: 1.5rem; }.bonus-section{ padding: 1.5rem; } }
</style>
