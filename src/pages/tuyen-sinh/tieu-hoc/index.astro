---
import SalesPageLayout from '../../../layouts/SalesPageLayout.astro';
import LeadFormTwoStepEmailFirst from '../../../components/LeadFormTwoStepEmailFirst.astro';
---

<SalesPageLayout
  title="Tiểu Học Song Ngữ Việt Anh — Cambridge · STEM · Lãnh Đạo"
  description="Tiểu học Việt Anh: Cambridge chính thức, STEM từ lớp 3, GV bản ngữ mỗi ngày. Học phí 7-10 triệu/tháng. Đặt lịch tham quan miễn phí."
  canonical="https://truongvietanh.com/tuyen-sinh/tieu-hoc"
  ogImage="https://media.truongvietanh.com/images/thuyet-trinh-04.webp"
  heroImage="https://media.truongvietanh.com/images/thuyet-trinh-04.webp"
  programCode="tieu-hoc"
  schoolLevel="tieu-hoc"
>

  <!-- HERO -->
  <Fragment slot="hero">
    <div class="sp-hero__badge">TUYỂN SINH TIỂU HỌC 2026–2027</div>
    <h1 style="font-size:2.5rem;font-weight:900;color:#fff;margin:0 0 1rem;line-height:1.15;text-shadow:0 2px 8px rgba(0,0,0,.3)">
      Tiểu Học Việt Anh — Nơi Con Học Cambridge, Nói Tiếng Anh Như Bản Xứ, Và Yêu Thích Đến Trường
    </h1>
    <p style="font-size:1.1rem;color:rgba(255,255,255,.88);line-height:1.65;margin:.75rem 0">
      Chương trình Cambridge chính thức · STEM từ lớp 3 · Giáo viên bản ngữ mỗi ngày · Kỹ năng lãnh đạo
    </p>
    <p style="font-size:.88rem;color:rgba(255,255,255,.6);margin-top:.5rem">
      3,000+ học sinh · 15+ năm · 4 cơ sở HCM + tỉnh
    </p>
    <a href="#sp-form1" style="display:inline-block;margin-top:1.5rem;background:#D4A843;color:#1a1a5e;font-weight:700;padding:.85rem 2rem;border-radius:8px;text-decoration:none;font-size:1rem">
      Đặt lịch tham quan miễn phí →
    </a>
  </Fragment>

  <!-- PAIN -->
  <Fragment slot="pain">
    <p class="sp-pain__eyebrow">VẤN ĐỀ THỰC TẾ</p>
    <h2>Tiểu Học Quyết Định Tương Lai — Con Bạn Đang Học Ở Đâu?</h2>
    <p>Tiểu học là nền tảng quyết định toàn bộ hành trình học thuật của con. Đây là giai đoạn hình thành thói quen học tập, tư duy phản biện, và sự tự tin — những yếu tố sẽ đi theo con suốt cả cuộc đời. Chọn sai môi trường ở giai đoạn này, chi phí sửa chữa sau này rất lớn.</p>
    <p>Rất nhiều phụ huynh phát hiện ra quá muộn: con học trường công 5 năm tiểu học, đến THCS mới nhận ra tiếng Anh quá yếu, thiếu tư duy STEM, và không đủ tự tin để cạnh tranh. Lúc đó, phải cho con học thêm khắp nơi — tốn kém và áp lực cho cả gia đình.</p>
    <ul class="sp-pain__list">
      <li>Trường công lập: 40–50 HS/lớp, không đủ thời gian cho từng con</li>
      <li>Tiếng Anh chỉ 3 tiết/tuần — con sẽ không thể thi IELTS lúc THCS</li>
      <li>Không STEM, không lập trình — thiếu kỹ năng thế kỷ 21 ngay từ đầu</li>
      <li>Học vẹt, thi cử áp lực — con sợ đến trường thay vì yêu thích</li>
    </ul>
  </Fragment>

  <!-- FEATURES -->
  <Fragment slot="features">
    <p class="sp-features__eyebrow">CHƯƠNG TRÌNH VIỆT ANH</p>
    <h2>7 Lợi Thế Tạo Nên Học Sinh Tiểu Học Việt Anh</h2>
    <p class="sp-features__sub">Hệ thống được thiết kế để con vừa giỏi học thuật, vừa tự tin và biết lãnh đạo</p>
    <div class="sp-features__grid">
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🎓</div>
        <h3>Cambridge chính thức từ lớp 1</h3>
        <p>Chứng chỉ quốc tế được công nhận toàn cầu — con có thể học tiếp ở bất kỳ đâu</p>
        <span class="sp-feat-card__tag">Cambridge</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🌍</div>
        <h3>GV bản ngữ mỗi ngày</h3>
        <p>Tiếng Anh tự nhiên, không phải học thuộc lòng — nghe hiểu và nói như trẻ UK</p>
        <span class="sp-feat-card__tag">Song ngữ</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🔬</div>
        <h3>STEM từ lớp 3 · Robotics lớp 4–5</h3>
        <p>Scratch, Robotics, STEM Fair hàng năm — con tư duy như kỹ sư từ nhỏ</p>
        <span class="sp-feat-card__tag">STEM</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">👑</div>
        <h3>Leader In Me · Kỹ năng lãnh đạo</h3>
        <p>7 Thói Quen của Franklin Covey — phát triển tự tin, trách nhiệm, giao tiếp</p>
        <span class="sp-feat-card__tag">Lãnh đạo</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🏅</div>
        <h3>Thi Olympic · Toán Quốc tế · Khoa học</h3>
        <p>Con được tham gia thi đấu quốc tế ngay từ tiểu học — build profile ấn tượng</p>
        <span class="sp-feat-card__tag">Thành tích</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🍱</div>
        <h3>Bán trú · Dinh dưỡng · Xe đưa đón</h3>
        <p>Chăm sóc toàn diện — ba mẹ yên tâm đi làm, con học trong môi trường tốt nhất</p>
        <span class="sp-feat-card__tag">Tiện ích</span>
      </div>
    </div>
  </Fragment>

  <!-- TEXT WITH IMAGE -->
  <Fragment slot="textimg">
    <div class="sp-textimg__text">
      <p class="sp-textimg__eyebrow">LỚP HỌC THỰC TẾ</p>
      <h2>Con Không Chỉ Học — Con Trải Nghiệm, Sáng Tạo Và Lãnh Đạo</h2>
      <p>Phòng STEM được trang bị đầy đủ thiết bị robotics, bộ thí nghiệm khoa học và máy tính lập trình. Học sinh không ngồi nghe — các con thực hành, thử nghiệm và học từ thất bại. STEM Fair hàng năm là sân khấu để con trình bày dự án trước phụ huynh và ban giám khảo.</p>
      <p>Chương trình Leader In Me giúp con học cách đặt mục tiêu, quản lý thời gian, và tự tin phát biểu trước đám đông. Sau tiểu học Việt Anh, con không chỉ có kiến thức — con có bản lĩnh và kỹ năng lãnh đạo để thành công trong bất kỳ môi trường nào.</p>
    </div>
    <div class="sp-textimg__img">
      <img
        src="https://media.truongvietanh.com/images/thuyet-trinh-04.webp"
        alt="Học sinh tiểu học thuyết trình"
        loading="lazy"
        width="600"
        height="400"
      />
    </div>
  </Fragment>

  <!-- STATS -->
  <Fragment slot="stats">
    <p class="sp-stats__eyebrow">CON SỐ THỰC TẾ</p>
    <h2>Kết Quả Của 15 Năm Phát Triển Chương Trình</h2>
    <div class="sp-stats__grid">
      <div class="sp-stat">
        <span class="sp-stat__num">15+</span>
        <span class="sp-stat__label">Năm xây dựng chương trình tiểu học song ngữ</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">1,200+</span>
        <span class="sp-stat__label">Học sinh tiểu học đang theo học</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">95%</span>
        <span class="sp-stat__label">Học sinh tiếp tục lên THCS Việt Anh</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">30+</span>
        <span class="sp-stat__label">Giải thi học sinh giỏi mỗi năm</span>
      </div>
    </div>
  </Fragment>

  <!-- QUOTE -->
  <Fragment slot="quote">
    <p class="sp-quote__eyebrow">PHỤ HUYNH NÓI GÌ</p>
    <div class="sp-quote__card">
      <div class="sp-quote__stars">★★★★★</div>
      <p class="sp-quote__text">
        "Con tôi từ một bé nhút nhát, sợ phát biểu trước lớp — sau 1 năm Tiểu Học Việt Anh bé đã đứng thuyết trình trước 200 người trong STEM Fair! IELTS lớp 5 đạt 4.5 — cô giáo nói con có nền tảng rất tốt để lên THCS."
      </p>
      <div class="sp-quote__author">
        <img
          src="https://media.truongvietanh.com/images/phu-huynh-02.webp"
          alt="Anh Minh Tuấn"
          class="sp-quote__avatar"
          width="52"
          height="52"
          loading="lazy"
        />
        <div>
          <div class="sp-quote__name">Anh Minh Tuấn</div>
          <div class="sp-quote__meta">Phụ huynh bé Thu Hà — Tiểu Học Việt Anh Gò Vấp</div>
        </div>
      </div>
    </div>
  </Fragment>

  <!-- PRICING -->
  <Fragment slot="pricing">
    <p class="sp-pricing__eyebrow">HỌC PHÍ</p>
    <h2>Đầu Tư Thông Minh — All-In-One, Không Phải Chạy Học Thêm</h2>
    <p class="sp-pricing__sub">So sánh thực tế để thấy Việt Anh không đắt — mà còn tiết kiệm hơn khi tính đủ chi phí</p>
    <div class="sp-pricing__table">
      <div class="sp-pricing-col sp-pricing-col--regular">
        <div class="sp-pricing-col__label">Trường công lập + Học thêm</div>
        <div class="sp-pricing-col__price">3–5tr</div>
        <div class="sp-pricing-col__unit">/tháng (+ học thêm 2–3tr nữa)</div>
        <ul class="sp-pricing-col__features">
          <li>Lớp 40–50 HS</li>
          <li>Tiếng Anh 3 tiết/tuần</li>
          <li>Không STEM</li>
          <li>Phải đi học thêm nhiều nơi</li>
        </ul>
      </div>
      <div class="sp-pricing-col sp-pricing-col--promo">
        <div class="sp-pricing-col__label">Tiểu học Việt Anh</div>
        <div class="sp-pricing-col__price">7–10tr</div>
        <div class="sp-pricing-col__unit">/tháng (all-in-one)</div>
        <ul class="sp-pricing-col__features">
          <li>Cambridge chính thức</li>
          <li>GV bản ngữ mỗi ngày</li>
          <li>STEM + Robotics</li>
          <li>Leader In Me</li>
          <li>Bán trú + Xe đưa đón</li>
          <li>Không cần học thêm</li>
        </ul>
      </div>
    </div>
    <p class="sp-pricing__note">* Bao gồm Cambridge, bán trú, học liệu. Liên hệ để nhận báo giá chi tiết.</p>
  </Fragment>

  <!-- CTA -->
  <Fragment slot="cta">
    <h2>Chỉ Còn Ít Suất Lớp 1–5 — Đặt Lịch Ngay</h2>
    <p>Tham quan miễn phí, không ràng buộc. Đội tư vấn sẽ liên hệ trong 24h để sắp xếp lịch phù hợp.</p>
    <a href="#sp-form1" class="sp-cta-btn">Đặt lịch tham quan miễn phí →</a>
    <p class="sp-cta-block__note">Không cần đặt cọc · Có thể hủy bất kỳ lúc nào</p>
  </Fragment>

  <!-- FORM 1 -->
  <Fragment slot="form1">
    <p class="sp-form-block__eyebrow">ĐĂNG KÝ TƯ VẤN</p>
    <h2>Đặt Lịch Tham Quan — Miễn Phí, Không Ràng Buộc</h2>
    <p>Điền thông tin bên dưới — tư vấn viên sẽ gọi lại trong vòng 24 giờ để sắp xếp lịch thăm trường phù hợp nhất với gia đình bạn.</p>
    <LeadFormTwoStepEmailFirst
      formId="tieu-hoc-sales-form1"
      funnelCode="sales-tieu-hoc"
      schoolLevel="tieu-hoc"
      submitText="Đặt lịch tham quan ngay"
    />
  </Fragment>

  <!-- FAQ -->
  <Fragment slot="faq">
    <p class="sp-faq__eyebrow">CÂU HỎI THƯỜNG GẶP</p>
    <h2>Phụ Huynh Hay Hỏi</h2>
    <p class="sp-faq__sub">Mọi câu hỏi đều được trả lời thẳng thắn</p>

    <details class="sp-faq-item">
      <summary>Tiểu học Việt Anh có dạy chương trình Bộ GD-ĐT không?</summary>
      <div class="sp-faq-answer">
        Có! Việt Anh dạy đầy đủ chương trình chuẩn Bộ GD-ĐT, CỘNG THÊM Cambridge và STEM. Con học Việt Anh vẫn có thể chuyển trường bất cứ lúc nào mà không bị tụt hậu.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>Con tôi đang học lớp 3 trường khác — có chuyển sang Việt Anh được không?</summary>
      <div class="sp-faq-answer">
        Được! Chúng tôi nhận chuyển trường mọi khối. Có bài kiểm tra đầu vào để xếp lớp phù hợp và chương trình bổ trợ cho các con chưa có nền tiếng Anh.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>Học phí 7–10 triệu có cao không?</summary>
      <div class="sp-faq-answer">
        So sánh: trường công + học thêm tiếng Anh + học thêm toán + năng khiếu = dễ 5–7tr/tháng mà không có hệ thống. Việt Anh 7–10tr bao gồm TẤT CẢ, không phải đưa đón nhiều nơi, không lo thiếu kỹ năng.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>STEM có phù hợp với bé gái không?</summary>
      <div class="sp-faq-answer">
        Hoàn toàn phù hợp! Thực tế, nhiều học sinh nữ Việt Anh đoạt giải Robotics và STEM Fair. Chúng tôi thiết kế STEM để TẤT CẢ học sinh đều tự tin — không phân biệt giới tính.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>Sau tiểu học, con có được ưu tiên vào THCS Việt Anh không?</summary>
      <div class="sp-faq-answer">
        Có. 95% học sinh tiểu học Việt Anh tiếp tục lên THCS Việt Anh. Con có lợi thế về nền tảng tiếng Anh và STEM — không cần thi lại từ đầu.
      </div>
    </details>
  </Fragment>

  <!-- FORM 2 -->
  <Fragment slot="form2">
    <p class="sp-form-block__eyebrow">ĐĂNG KÝ NGAY</p>
    <h2>Còn Phân Vân? Cứ Đăng Ký Tham Quan Trước</h2>
    <p>Xem tận mắt môi trường — gặp cô giáo — hiểu chương trình. Hoàn toàn miễn phí, không áp lực.</p>
    <LeadFormTwoStepEmailFirst
      formId="tieu-hoc-sales-form2"
      funnelCode="sales-tieu-hoc-2"
      schoolLevel="tieu-hoc"
      submitText="Đăng ký tham quan ngay"
    />
  </Fragment>

</SalesPageLayout>
