---
import SalesPageLayout from '../../../layouts/SalesPageLayout.astro';
import LeadFormTwoStepEmailFirst from '../../../components/LeadFormTwoStepEmailFirst.astro';
---

<SalesPageLayout
  title="Tiểu Học Việt Anh — Làm Chủ Việc Học, Làm Chủ Tiếng Anh, Làm Chủ Chính Mình"
  description="Tiểu học Việt Anh: học thuật Oxford UK, tiếng Anh như ngôn ngữ, Leader in Me từ lớp 1. Xây nền tảng tự học bền vững cho 10 năm tới. Nhận Brochure miễn phí."
  canonical="https://truongvietanh.com/tuyen-sinh/tieu-hoc"
  ogImage="https://media.truongvietanh.com/images/thuyet-trinh-09.webp"
  heroImage="https://media.truongvietanh.com/images/thuyet-trinh-09.webp"
  programCode="tieu-hoc"
  schoolLevel="tieu-hoc"
>

  <!-- HERO -->
  <Fragment slot="hero">
    <h1 style="font-size:clamp(2.1rem,5.2vw,3.4rem);font-weight:900;color:#F0D048;margin:0 0 1rem;line-height:1.15;text-shadow:0 2px 18px rgba(0,0,0,.55)">
      Tiểu học không phải là nơi để học nhiều hơn
      <span style="display:block;color:#fff;font-size:clamp(1rem,2.5vw,1.45rem);font-weight:700;margin-top:.6rem;line-height:1.3">
        mà là nơi trẻ bắt đầu làm chủ việc học, làm chủ tiếng Anh và làm chủ chính mình
      </span>
    </h1>

    <div style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.18);border-radius:12px;padding:1.25rem 1.5rem;margin:.75rem 0 1.25rem;text-align:left;max-width:660px;margin-left:auto;margin-right:auto">
      <p style="font-size:1rem;color:rgba(255,255,255,.88);line-height:1.85;margin:0">
        Nhiều phụ huynh nghĩ rằng:<br>
        👉 Chỉ cần con học tốt hơn một chút<br>
        👉 Biết tiếng Anh sớm hơn một chút<br>
        … là đã có lợi thế.<br><br>
        Nhưng thực tế là:<br>
        Có những đứa trẻ <em>học giỏi</em>… nhưng không biết tự học<br>
        <em>Học tiếng Anh nhiều năm</em>… nhưng không dám dùng<br>
        <em>Ngoan khi có người nhắc</em>… nhưng không tự quản lý được bản thân
      </p>
    </div>

    <p style="font-size:1rem;color:rgba(255,255,255,.8);font-style:italic;line-height:1.7;margin:.25rem 0 1.5rem">
      👉 Tiểu học không quyết định con <em>biết bao nhiêu</em> —<br>
      mà quyết định con sẽ trở thành <strong style="color:#F0D048">kiểu người học như thế nào</strong>
    </p>

    <!-- Keyword badges -->
    <div style="display:flex;gap:.65rem;justify-content:center;flex-wrap:wrap;margin:0 0 1.5rem">
      <span style="background:rgba(240, 208, 72,.22);border:1.5px solid #F0D048;color:#ffe082;font-size:1rem;font-weight:700;padding:.4rem 1.1rem;border-radius:50px">💡 Tự học</span>
      <span style="background:rgba(240, 208, 72,.22);border:1.5px solid #F0D048;color:#ffe082;font-size:1rem;font-weight:700;padding:.4rem 1.1rem;border-radius:50px">🌍 Tiếng Anh như ngôn ngữ</span>
      <span style="background:rgba(240, 208, 72,.22);border:1.5px solid #F0D048;color:#ffe082;font-size:1rem;font-weight:700;padding:.4rem 1.1rem;border-radius:50px">🧭 Lãnh đạo bản thân</span>
    </div>

    <!-- CTAs -->
    <div style="display:flex;gap:.85rem;justify-content:center;flex-wrap:wrap">
      <a href="#sp-form1" style="display:inline-block;background:#F0D048;color:#1a1a5e;font-weight:700;padding:.9rem 1.75rem;border-radius:8px;text-decoration:none;font-size:1rem;box-shadow:0 4px 18px rgba(240, 208, 72,.45)">
        📘 Nhận Brochure Tiểu học Việt Anh
      </a>
      <a href="https://zalo.me/1678310120468101523" target="_blank" rel="noopener" style="display:inline-block;background:rgba(255,255,255,.12);border:1.5px solid rgba(255,255,255,.5);color:#fff;font-weight:700;padding:.9rem 1.75rem;border-radius:8px;text-decoration:none;font-size:.97rem">
        💬 Chat Zalo ngay
      </a>
    </div>
    <p style="font-size:1rem;color:rgba(255,255,255,.5);margin-top:.85rem">
      Hiểu rõ chương trình học &amp; lộ trình phát triển của con
    </p>
  </Fragment>

  <!-- VIDEO + FORM (ngay dưới Hero) -->
  <Fragment slot="video">
    <div class="sp-video__head">
      <h2 class="sp-video__title">Hiểu Cách Tiểu Học Việt Anh Xây Nền Tảng Tự Học Cho Con</h2>
    </div>

    <div class="sp-video__frame">
      <iframe
        src="https://www.youtube.com/embed/W-HP6ARYEck?rel=0"
        title="Tiểu học Việt Anh — Làm chủ việc học, tiếng Anh và chính mình"
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>

    <div class="sp-video__form" id="sp-video-form">
      <div class="sp-video__form-eyebrow">NHẬN TƯ VẤN MIỄN PHÍ</div>
      <h3>Để Lại Email — Nhận Brochure &amp; Lộ Trình Cá Nhân Hoá</h3>
      <p>Đội ngũ Việt Anh sẽ liên hệ trong vòng 24h để tư vấn riêng cho con bạn.</p>
      <LeadFormTwoStepEmailFirst
        formId="tu-hoc-tieu-hoc-video"
        funnelCode="sales-tieu-hoc-tu-hoc-video"
        schoolLevel="tieu-hoc"
        submitText="Nhận tư vấn ngay"
      />
    </div>
  </Fragment>

  <!-- PAIN → Rich text block -->
  <Fragment slot="pain">
    <p class="sp-pain__eyebrow">🧠 SỰ THẬT ÍT ĐƯỢC NÓI</p>
    <h2>Phần Lớn Học Sinh Không Thiếu Kiến Thức — Mà Thiếu Cách Học</h2>
    <p>Hệ thống giáo dục hiện tại tạo ra rất nhiều học sinh <em>"học tốt"</em>… nhưng lại thiếu khả năng tự học khi không có ai kèm, sử dụng tiếng Anh trong thực tế, và tự chịu trách nhiệm với việc học của mình.</p>
    <p>Và điều này bắt đầu từ tiểu học.</p>
    <p style="font-size:1rem;color:#F0D048;font-weight:600;padding:.75rem 1rem;border-left:3px solid #F0D048;margin:1rem 0;color:#1a1a5e;border-left-color:#F0D048">
      👉 Giáo dục tiểu học đúng phải trả lời 3 câu hỏi:<br>
      Trẻ có <strong>biết cách học</strong> không? · Trẻ có <strong>dùng được tiếng Anh</strong> không? · Trẻ có <strong>tự quản lý được bản thân</strong> không?
    </p>
    <p>Nếu giai đoạn này chỉ tập trung vào làm bài đúng, điểm số cao, học nhiều hơn người khác — trẻ có thể "đi nhanh" trong ngắn hạn, nhưng lại không có nền tảng để đi xa.</p>
  </Fragment>

  <!-- FEATURES → 5 feature cards -->
  <Fragment slot="features">
    <p class="sp-features__eyebrow">MÔI TRƯỜNG TIỂU HỌC VIỆT ANH</p>
    <h2>Không Chỉ Dạy Kiến Thức — Mà Xây Nền Móng Cho Cách Học</h2>
    <p class="sp-features__sub">5 yếu tố tạo ra học sinh biết tự học, dùng được tiếng Anh và tự quản lý bản thân</p>
    <div class="sp-features__grid">

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">📘</div>
        <h3>Học thuật tích hợp quốc tế Oxford UK</h3>
        <p>Không phải học nhiều hơn — mà học đúng cách, có hệ thống và theo chuẩn quốc tế. Giúp trẻ hiểu sâu, không học vẹt.</p>
        <span class="sp-feat-card__tag">Học thuật</span>
      </div>

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🌍</div>
        <h3>Tiếng Anh như một ngôn ngữ</h3>
        <p>Không học tiếng Anh như một môn riêng lẻ — mà dùng tiếng Anh để học, để giao tiếp, để suy nghĩ. Ngôn ngữ trở thành phản xạ, không phải áp lực.</p>
        <span class="sp-feat-card__tag">Song ngữ</span>
      </div>

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🔬</div>
        <h3>Học Toán &amp; Khoa học bằng tiếng Anh</h3>
        <p>Trẻ không chỉ "biết từ vựng" — mà dùng tiếng Anh để tiếp cận kiến thức, hiểu vấn đề bằng ngôn ngữ thứ hai. Bước chuyển từ "học ngôn ngữ" → "dùng ngôn ngữ".</p>
        <span class="sp-feat-card__tag">STEM</span>
      </div>

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🧭</div>
        <h3>Lãnh đạo bản thân từ sớm</h3>
        <p>Thông qua Leader in Me, 7 thói quen và PDR (Personal Development Report) — trẻ học cách đặt mục tiêu, theo dõi tiến bộ, tự đánh giá. Không cần nhắc vẫn biết phải làm gì.</p>
        <span class="sp-feat-card__tag">Phát triển bản thân</span>
      </div>

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🎯</div>
        <h3>Học qua dự án &amp; trải nghiệm</h3>
        <p>Không chỉ làm bài — mà giải quyết vấn đề, làm việc nhóm, trình bày ý tưởng. Học gắn với thực tế, không tách rời cuộc sống.</p>
        <span class="sp-feat-card__tag">Dự án</span>
      </div>

    </div>
  </Fragment>

  <!-- TEXT WITH IMAGE -->
  <Fragment slot="textimg">
    <div class="sp-textimg__text">
      <p class="sp-textimg__eyebrow">🌈 MỘT NGÀY TẠI VIỆT ANH</p>
      <h2>Không Chỉ Ngồi Yên Nghe Giảng</h2>
      <p>Buổi sáng, học sinh không chỉ mở sách — mà bắt đầu bằng một mục tiêu cho ngày học và một câu hỏi cần khám phá.</p>
      <p>Trong lớp, học sinh thảo luận bằng cả tiếng Việt và tiếng Anh. Giáo viên không chỉ giảng — mà đặt câu hỏi. Có thể là một bài toán được giải bằng nhiều cách, một dự án khoa học nhỏ, hay một bài thuyết trình bằng tiếng Anh.</p>
      <p>Buổi chiều, học sinh không chỉ <em>"học xong"</em> — mà nhìn lại mình đã học gì, đánh giá tiến bộ và chuẩn bị cho ngày mai.</p>
      <p><strong>👉 Đây là lúc trẻ bắt đầu làm chủ việc học của mình.</strong></p>
      <a href="#sp-form1" style="display:inline-block;margin-top:1rem;background:#1a1a5e;color:#fff;font-weight:700;padding:.75rem 1.5rem;border-radius:8px;text-decoration:none;font-size:.92rem">
        Tìm hiểu thêm về chương trình →
      </a>
    </div>
    <div class="sp-textimg__img">
      <img
        src="https://media.truongvietanh.com/images/du-an-03.webp"
        alt="Học sinh tiểu học Việt Anh học qua dự án"
        loading="lazy"
        width="600"
        height="400"
      />
    </div>
  </Fragment>

  <!-- STATS -->
  <Fragment slot="stats">
    <p class="sp-stats__eyebrow">📊 GIAI ĐOẠN ĐỊNH HÌNH</p>
    <h2>Tiểu Học Không Phải Giai Đoạn "Nhẹ Nhàng"</h2>
    <div class="sp-stats__grid">
      <div class="sp-stat">
        <span class="sp-stat__num">5–11</span>
        <span class="sp-stat__label">Tuổi — giai đoạn hình thành thói quen học tập, tư duy và ngôn ngữ bền vững nhất</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">7</span>
        <span class="sp-stat__label">Thói quen từ Leader in Me — nền tảng lãnh đạo bản thân từ lớp 1</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">100%</span>
        <span class="sp-stat__label">Tiếp xúc tiếng Anh mỗi ngày — qua học thuật, STEM và sinh hoạt lớp</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">3,000+</span>
        <span class="sp-stat__label">Gia đình đã tin tưởng gửi gắm con tại hệ thống Trường Việt Anh</span>
      </div>
    </div>
    <p style="margin-top:2rem;font-size:1rem;color:rgba(226,232,240,.75);line-height:1.8;max-width:680px;margin-left:auto;margin-right:auto">
      Trẻ có nền tảng <strong style="color:#F0D048">tự học, tự quản lý</strong> sẽ không chỉ học nhanh hơn khi lên cấp 2 — mà còn duy trì lợi thế đó trong 10, 20 năm tiếp theo.
    </p>
  </Fragment>

  <!-- QUOTE → Chị Nga – tiểu học -->
  <Fragment slot="quote">
    <p class="sp-quote__eyebrow">PHỤ HUYNH NÓI GÌ</p>
    <div class="sp-quote__card">
      <div class="sp-quote__stars">★★★★★</div>
      <p class="sp-quote__text">
        "Điều tôi thấy rõ nhất sau khi con vào Việt Anh là con biết tự học — không cần tôi ngồi kèm mỗi tối nữa. Tiếng Anh của con từ ngại ngùng trở thành tự nhiên, con nói chuyện với giáo viên bản ngữ mà không còn e dè."
      </p>
      <div class="sp-quote__author">
        <a href="https://www.youtube.com/watch?v=3jwB87z-Keg" target="_blank" rel="noopener" style="position:relative;display:block;width:52px;height:52px;flex-shrink:0">
          <img
            src="https://img.youtube.com/vi/3jwB87z-Keg/hqdefault.jpg"
            alt="Chị Nga — Phụ huynh tiểu học"
            class="sp-quote__avatar"
            width="52"
            height="52"
            loading="lazy"
            style="object-fit:cover"
          />
          <span style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.3);border-radius:50%">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="#fff"><polygon points="5,3 19,12 5,21"/></svg>
          </span>
        </a>
        <div>
          <div class="sp-quote__name">Chị Nga</div>
          <div class="sp-quote__meta">Phụ huynh học sinh tiểu học · <a href="https://www.youtube.com/watch?v=3jwB87z-Keg" target="_blank" rel="noopener" style="color:#F0D048;font-weight:600;text-decoration:none">Xem video ▶</a></div>
        </div>
      </div>
    </div>
  </Fragment>

  <!-- PRICING -->
  <Fragment slot="pricing">
    <p class="sp-pricing__eyebrow">💡 CHỌN ĐÚNG NỀN TẢNG</p>
    <h2>Đây Không Phải Là Chọn Trường</h2>
    <p class="sp-pricing__sub">Mà là chọn cách con bạn sẽ học trong 10 năm tới</p>

    <div class="sp-pricing__table">
      <div class="sp-pricing-col sp-pricing-col--regular">
        <div class="sp-pricing-col__label">Chọn vì điểm số cao hơn</div>
        <div class="sp-pricing-col__price" style="font-size:1.4rem;text-decoration:none;color:#94a3b8">Ngắn hạn</div>
        <div class="sp-pricing-col__unit">lợi thế thấy rõ trong 1–2 năm</div>
        <ul class="sp-pricing-col__features">
          <li>Điểm cao hơn một chút</li>
          <li>Học nhiều hơn một chút</li>
          <li>Biết tiếng Anh sớm hơn</li>
          <li style="color:#1a1a5e">Không biết cách tự học</li>
          <li style="color:#1a1a5e">Tiếng Anh không dùng được</li>
          <li style="color:#1a1a5e">Phụ thuộc vào nhắc nhở</li>
        </ul>
      </div>
      <div class="sp-pricing-col sp-pricing-col--promo">
        <div class="sp-pricing-col__label">Chọn đúng nền tảng cho con</div>
        <div class="sp-pricing-col__price" style="font-size:1.4rem">Dài hạn</div>
        <div class="sp-pricing-col__unit">sự khác biệt rõ sau 5–10 năm</div>
        <ul class="sp-pricing-col__features">
          <li>Biết cách tự học</li>
          <li>Dùng được tiếng Anh thực tế</li>
          <li>Tự chịu trách nhiệm bản thân</li>
          <li>Học nhanh hơn khi lên cấp 2</li>
          <li>Tự tin trình bày, làm việc nhóm</li>
          <li>Không cần ép vẫn học tốt</li>
        </ul>
      </div>
    </div>

    <div style="background:#fffbf0;border:1.5px solid #F0D048;border-radius:12px;padding:1.5rem;margin-top:1.5rem;text-align:left">
      <p style="font-size:1rem;color:#475569;line-height:1.8;margin:0">
        <strong style="color:#1a1a5e">Sự khác biệt này không thấy ngay trong 1–2 năm.</strong> Nhưng sẽ rất rõ sau 5–10 năm — khi những đứa trẻ có nền tảng tự học bắt đầu <strong style="color:#F0D048">đi nhanh và đi xa hơn</strong> những đứa trẻ chỉ học để làm bài.
      </p>
    </div>
    <p class="sp-pricing__note">* Liên hệ để nhận thông tin học phí và chương trình chi tiết theo từng cơ sở.</p>
  </Fragment>

  <!-- CTA -->
  <Fragment slot="cta">
    <h2>Bắt Đầu Bằng Việc Hiểu Đúng</h2>
    <p>Bạn không cần quyết định ngay. Nhưng bạn nên hiểu rõ môi trường mà con sẽ học trong những năm quan trọng nhất — để đưa ra lựa chọn đúng cho con.</p>
    <a href="#sp-form1" class="sp-cta-btn">📘 Nhận ngay Brochure chương trình →</a>
    <p class="sp-cta-block__note">Không spam · Không làm phiền · Tư vấn cá nhân hoá theo nhu cầu của con</p>
  </Fragment>

  <!-- FORM 1 -->
  <Fragment slot="form1">
    <p class="sp-form-block__eyebrow">NHẬN TÀI LIỆU MIỄN PHÍ</p>
    <h2>Xem Chi Tiết Chương Trình &amp; Phương Pháp Tiểu Học Việt Anh</h2>
    <p>Điền thông tin để nhận Brochure — hiểu rõ cách chương trình xây dựng khả năng tự học, tiếng Anh thực dụng và lãnh đạo bản thân cho con.</p>
    <LeadFormTwoStepEmailFirst
      formId="tu-hoc-tieu-hoc-form1"
      funnelCode="sales-tieu-hoc-tu-hoc"
      schoolLevel="tieu-hoc"
      submitText="Nhận Brochure ngay"
    />
  </Fragment>

  <!-- FAQ -->
  <Fragment slot="faq">
    <p class="sp-faq__eyebrow">CÂU HỎI THƯỜNG GẶP</p>
    <h2>Những Điều Phụ Huynh Hay Hỏi</h2>
    <p class="sp-faq__sub">Câu trả lời thẳng thắn, không vòng vo</p>

    <details class="sp-faq-item">
      <summary>Tiểu học có cần học nhiều và nặng không?</summary>
      <div class="sp-faq-answer">
        Không. Điều quan trọng là <strong>học đúng cách</strong>. Học nhiều nhưng không biết cách học sẽ không tạo ra lợi thế dài hạn — thậm chí có thể làm trẻ mất đi sự tò mò và động lực học tự nhiên.<br><br>
        Tại Việt Anh, chúng tôi tập trung vào việc trẻ <strong>hiểu sâu và biết vận dụng</strong> — không phải nhớ nhiều.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>Nếu không học thêm nhiều, con có bị tụt lại không?</summary>
      <div class="sp-faq-answer">
        Không. Trẻ có nền tảng tự học sẽ <strong>bắt kịp rất nhanh khi cần</strong> — vì chúng biết cách tiếp cận kiến thức mới, không phụ thuộc vào việc được dạy từng bước.<br><br>
        Thực tế là học sinh Việt Anh lên cấp 2 thường tự điều chỉnh tốt hơn, học nhanh hơn và ít bị áp lực hơn so với bạn bè cùng trang lứa.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>Học bằng tiếng Anh có quá khó không?</summary>
      <div class="sp-faq-answer">
        Không — nếu được thiết kế đúng. Tiếng Anh tại Việt Anh không phải là một môn học riêng lẻ — mà là <strong>phương tiện học tập hàng ngày</strong>. Trẻ sẽ dần sử dụng tiếng Anh như một công cụ tự nhiên, không phải như một bài kiểm tra cần vượt qua.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>Làm sao biết con đang phát triển tốt?</summary>
      <div class="sp-faq-answer">
        Thay vì chỉ nhìn vào điểm số, bạn sẽ thấy con phát triển qua:<br><br>
        • <strong>Tự học</strong> — không cần nhắc, biết tự sắp xếp việc học<br>
        • <strong>Tự quản lý</strong> — đặt mục tiêu và theo dõi tiến bộ qua PDR<br>
        • <strong>Giao tiếp</strong> — tự tin trình bày ý kiến bằng cả tiếng Việt và tiếng Anh<br><br>
        Phụ huynh nhận báo cáo phát triển định kỳ và được tư vấn cách đồng hành cùng con tại nhà.
      </div>
    </details>
  </Fragment>

