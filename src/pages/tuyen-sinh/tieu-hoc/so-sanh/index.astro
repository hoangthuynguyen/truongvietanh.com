---
import SqueezePageLayout from '../../../../layouts/SqueezePageLayout.astro';
import LeadFormTwoStepEmailFirst from '../../../../components/LeadFormTwoStepEmailFirst.astro';
import USPGrid from '../../../../components/USPGrid.astro';
import TrustMetrics from '../../../../components/TrustMetrics.astro';
import FAQSection from '../../../../components/FAQSection.astro';

const pageTitle = 'So Sánh Trường Tiểu Học – Trường Việt Anh vs Các Trường Khác';
const pageDescription = 'Bảng so sánh chi tiết Trường Việt Anh với các trường tiểu học song ngữ hàng đầu tại TP.HCM.';
const canonicalUrl = 'https://truongvietanh.com/tuyen-sinh/tieu-hoc/so-sanh';

const uspItems = [
  { icon: '📊', text: 'Bảng so sánh minh bạch - So sánh 5 tiêu chí quan trọng nhất' },
  { icon: '💰', text: 'Học phí tối ưu - Cung cấp giá trị tốt nhất cho đầu tư giáo dục' },
  { icon: '🎓', text: 'Chất lượng chương trình được công nhận - Tiêu chuẩn Cambridge' },
  { icon: '👨‍👩‍👧‍👦', text: 'Cộng đồng cha mẹ hài lòng nhất - 98% phụ huynh tin tưởng' },
  { icon: '📈', text: 'Kết quả đầu ra vượt trội - Con em chúng tôi thành công' },
  { icon: '🤝', text: 'Tư vấn cá nhân từ chuyên gia - Giúp bạn quyết định đúng' }
];

const metrics = [
  { number: '15+', label: 'Năm kinh nghiệm giáo dục' },
  { number: '500+', label: 'Học sinh Tiểu Học' },
  { number: '98%', label: 'Phụ huynh hài lòng' },
  { number: '3', label: 'Cơ sở tại TPHCM' }
];

const faqItems = [
  { question: 'Bảng so sánh có khách quan không?', answer: 'Hoàn toàn khách quan. Bảng so sánh được xây dựng dựa trên dữ liệu thực tế, công khai từ các trường, và các tiêu chí rõ ràng. Bạn có thể tự kiểm chứng mọi thông tin từ các nguồn chính thức của từng trường. Chúng tôi không bao giờ dựa vào ý kiến chủ quan mà chỉ dùng dữ liệu cụ thể, vì mục tiêu là giúp bạn đưa ra quyết định đúng cho con em.' },
  { question: 'So sánh những trường nào?', answer: 'Bảng so sánh bao gồm Trường Việt Anh và các trường song ngữ hàng đầu khác tại TP.HCM trong cùng phân khúc học phí. Chúng tôi chọn các trường có chất lượng tương đương để so sánh công bằng, giúp bạn thấy rõ điểm mạnh và khác biệt của mỗi trường.' },
  { question: 'Ngoài bảng so sánh còn nhận được gì?', answer: 'Ngoài bảng so sánh chi tiết, bạn sẽ nhận được tư vấn cá nhân từ chuyên viên Tuyển sinh của Trường Việt Anh. Họ sẽ giúp bạn phân tích bảng so sánh, trả lời mọi câu hỏi, và đề xuất trường phù hợp nhất với nhu cầu và điều kiện của gia đình bạn. Quyết định chọn trường là quan trọng, và chúng tôi muốn chắc chắn bạn có tất cả thông tin cần thiết.' }
];
---

<SqueezePageLayout
  title={pageTitle}
  description={pageDescription}
  keywords="so sánh trường tiểu học, Việt Anh, trường song ngữ, TPHCM"
  schoolLevel="tieu-hoc"
  funnelCode="so-sanh-tieu-hoc"
  canonicalUrl={canonicalUrl}
>
  <div slot="hero">
    <h1 class="hero-h1">So Sánh Trường Tiểu Học Một Cách Khách Quan<br/>Chọn Trường Đúng Cho Con Em</h1>
    <p class="hero-subtitle">Bảng so sánh minh bạch + Tư vấn cá nhân - Giúp bạn quyết định tự tin</p>
  </div>

  <div slot="usp">
    <USPGrid items={uspItems} />
  </div>

  <div slot="trust">
    <TrustMetrics metrics={metrics} />
  </div>

  <div slot="content">
    <div class="content-section">
      <h2>Bảng so sánh bao gồm gì?</h2>
      <div class="content-grid">
        <div class="content-card">
          <h3>Học Phí & Các Khoản Ưu Đãi</h3>
          <p>Bảng liệt kê rõ ràng mức học phí năm, các khoản phụ phí ẩn tính (nếu có), chương trình ưu đãi early bird, và điều kiện thanh toán. Bạn sẽ thấy rõ giá trị mà bạn nhận được ở mỗi trường - không có gì bất ngờ hay ẩn giấu. Chi phí giáo dục là quyết định lớn, nên chúng tôi muốn giúp bạn so sánh một cách công bằng.</p>
        </div>
        <div class="content-card">
          <h3>Chất Lượng Chương Trình Học</h3>
          <p>Đánh giá sâu về tiêu chuẩn chương trình (Cambridge, IB, Bộ GD&ĐT...), tỷ lệ tiếng Anh, phương pháp giảng dạy (lấy học sinh làm trung tâm, STEM, ...), và đặc biệt là những yếu tố nào sẽ ảnh hưởng trực tiếp đến sự phát triển của con bạn.</p>
        </div>
        <div class="content-card">
          <h3>Cơ Sở Vật Chất & Môi Trường Học Tập</h3>
          <p>So sánh khuôn viên, số lượng và chất lượng phòng học, phòng lab STEM, thư viện, sân thể thao, nhà ăn, và các tiện ích khác. Bạn sẽ thấy rõ môi trường học tập của con em sẽ như thế nào hàng ngày, điều này rất quan trọng cho sự phát triển của bé.</p>
        </div>
        <div class="content-card">
          <h3>Kết Quả Đầu Ra & Hài Lòng Của Phụ Huynh</h3>
          <p>Những thống kê thực tế về thành tích học sinh, tỷ lệ đỗ vào các trường THCS chất lượng cao, điểm thi Cambridge, và quan trọng nhất - mức độ hài lòng của phụ huynh. Bạn sẽ biết học sinh từ trường nào đi tiếp thành công như thế nào.</p>
        </div>
      </div>
    </div>
  </div>

  <div slot="form">
    <h2 class="form-heading">Tải Bảng So Sánh Chi Tiết Ngay</h2>
    <p class="form-subheading">Nhận ngay qua email + tư vấn miễn phí từ chuyên gia</p>
    <LeadFormTwoStepEmailFirst
      formId="tuyen-sinh-form"
      funnelCode="so-sanh-tieu-hoc"
      schoolLevel="tieu-hoc"
      submitText="Nhận bảng so sánh"
      successMessage="Bảng so sánh đã gửi qua email! Kiểm tra hộp thư để xem chi tiết."
    />
  </div>

  <div slot="faq">
    <FAQSection items={faqItems} title="Câu hỏi về So sánh trường" />
  </div>
</SqueezePageLayout>

<style>
  .hero-h1 { font-family: "Montserrat", sans-serif; font-size: clamp(1.75rem, 5vw, 2.75rem); font-weight: 800; line-height: 1.2; margin-bottom: 1rem; color: #1F4E79; }
  .hero-subtitle { font-size: clamp(1rem, 3vw, 1.25rem); font-weight: 500; opacity: 0.95; color: #E8792B; }
  .content-section h2 { font-family: "Montserrat", sans-serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; margin-bottom: 2rem; color: #1F4E79; text-align: center; }
  .content-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; max-width: 1200px; margin: 0 auto; }
  .content-card { padding: 2rem; background: white; border: 2px solid #e0e0e0; border-radius: 12px; transition: all 0.3s ease; }
  .content-card:hover { border-color: #E8792B; box-shadow: 0 8px 20px rgba(232, 121, 43, 0.12); transform: translateY(-4px); }
  .content-card h3 { font-family: "Montserrat", sans-serif; font-size: 1.25rem; font-weight: 700; color: #E8792B; margin-bottom: 1rem; }
  .content-card p { font-size: 0.95rem; line-height: 1.6; color: #555; }
  .form-heading { font-family: "Montserrat", sans-serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; color: #E8792B; margin-bottom: 0.5rem; }
  .form-subheading { font-size: 1rem; color: #555; font-weight: 500; margin-bottom: 2rem; }
  @media (max-width: 768px) { .content-grid { grid-template-columns: 1fr; } .content-card { padding: 1.5rem; } }
</style>
