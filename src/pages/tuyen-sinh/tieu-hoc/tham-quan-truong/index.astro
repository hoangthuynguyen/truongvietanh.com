---
import SqueezePageLayout from '../../../../layouts/SqueezePageLayout.astro';
import LeadFormTwoStepEmailFirst from '../../../../components/LeadFormTwoStepEmailFirst.astro';
import USPGrid from '../../../../components/USPGrid.astro';
import TrustMetrics from '../../../../components/TrustMetrics.astro';
import FAQSection from '../../../../components/FAQSection.astro';

const pageTitle = 'Đặt Lịch Tham Quan Trường – Tiểu Học Việt Anh';
const pageDescription = 'Đặt lịch tham quan trường Việt Anh để trải nghiệm thực tế chương trình Tiểu Học song ngữ. Miễn phí, có xe đưa đón.';
const canonicalUrl = 'https://truongvietanh.com/tuyen-sinh/tieu-hoc/tham-quan-truong';

const uspItems = [
  { icon: '👀', text: 'Thấy trực tiếp cơ sở vật chất - Tự mình cảm nhận không khí trường' },
  { icon: '👩‍🏫', text: 'Gặp gỡ giáo viên Việt Nam và nước ngoài - Hiểu rõ cách giảng dạy' },
  { icon: '📚', text: 'Bé tham gia lớp học thử - Trải nghiệm tiết học thực tế' },
  { icon: '🤝', text: 'Tư vấn 1-1 với chuyên gia Tuyển sinh - Trả lời mọi thắc mắc' },
  { icon: '📸', text: 'Chụp ảnh & video - Chia sẻ kỷ niệm với gia đình' },
  { icon: '💝', text: 'Quà tặng cho bé - Cảm ơn sự tham gia của con em' }
];

const metrics = [
  { number: '15+', label: 'Năm kinh nghiệm giáo dục' },
  { number: '500+', label: 'Học sinh Tiểu Học' },
  { number: '98%', label: 'Phụ huynh hài lòng' },
  { number: '3', label: 'Cơ sở tại TPHCM' }
];

const faqItems = [
  { question: 'Buổi tham quan kéo dài bao lâu?', answer: 'Khoảng 60-90 phút, đủ thời gian để tham quan toàn bộ cơ sở vật chất, nghe giới thiệu chi tiết về chương trình, gặp gỡ giáo viên, và nhận tư vấn cá nhân từ chuyên gia Tuyển sinh. Chúng tôi muốn bạn có trải nghiệm thực tế đầy đủ, không vội vã.' },
  { question: 'Có cần đặt lịch trước không?', answer: 'Vâng, bạn nên đặt lịch trước để nhà trường chuẩn bị tốt nhất. Mỗi buổi chỉ nhận tối đa 5 gia đình để đảm bảo mỗi gia đình nhận được sự chú ý cá nhân và tư vấn kỹ lưỡng, không bị xếp hàng chờ đợi lâu.' },
  { question: 'Bé có được đi cùng không?', answer: 'Không chỉ được, mà chúng tôi rất khuyến khích! Bé sẽ tham gia một tiết lớp học mẫu để trực tiếp trải nghiệm không gian học tập, gặp gỡ thầy cô, và cảm nhận tình thần của lớp. Điều này giúp bé quen thuộc hơn với môi trường mới, và ba/mẹ cũng thấy con em mình hợp với môi trường trường hay không.' }
];
---

<SqueezePageLayout
  title={pageTitle}
  description={pageDescription}
  keywords="tham quan trường, school tour, tiểu học, trường Việt Anh"
  schoolLevel="tieu-hoc"
  funnelCode="school-tour-tieu-hoc"
  canonicalUrl={canonicalUrl}
>
  <div slot="hero">
    <h1 class="hero-h1">Hãy Ghé Thăm Trường Việt Anh<br/>Xem Con Em Phát Triển Trong Môi Trường Này</h1>
    <p class="hero-subtitle">Tham quan miễn phí + Bé trải nghiệm lớp học + Tư vấn 1-1 từ chuyên gia</p>
  </div>

  <div slot="usp">
    <USPGrid items={uspItems} />
  </div>

  <div slot="trust">
    <TrustMetrics metrics={metrics} />
  </div>

  <div slot="content">
    <div class="content-section">
      <h2>Tham quan trường – Bạn sẽ được gì?</h2>
      <div class="content-grid">
        <div class="content-card">
          <h3>Tham Quan Toàn Diện Cơ Sở Vật Chất Hiện Đại</h3>
          <p>Bạn sẽ được dẫn tham quan tất cả các phòng: phòng học với bảng thông minh, thư viện với hàng ngàn cuốn sách, phòng lab STEM với các thiết bị hiện đại, sân thể thao, bể bơi, nhà ăn với tiêu chuẩn an toàn vệ sinh cao... Mọi nơi được thiết kế để bé thấy cảm thấy vui vẻ, an toàn, và khơi gợi sáng tạo.</p>
        </div>
        <div class="content-card">
          <h3>Gặp Gỡ & Trao Đổi Với Giáo Viên</h3>
          <p>Bạn sẽ gặp trực tiếp các giáo viên Việt Nam tâm huyết và giáo viên nước ngoài đầy kinh nghiệm. Đây là cơ hội tuyệt vời để trao đổi về phương pháp giảng dạy, cách làm việc với bé, và đặc biệt là nghe những câu chuyện về tầm nhìn giáo dục của họ. Bạn sẽ cảm nhận được passion của các thầy cô.</p>
        </div>
        <div class="content-card">
          <h3>Con Bạn Tham Gia Lớp Học Thử - Trải Nghiệm Thực Tế</h3>
          <p>Thay vì chỉ nghe lý thuyết, bé của bạn sẽ được ngồi vào lớp, tham gia một tiết học mẫu thực tế, và trải nghiệm không khí học tập tại Việt Anh. Đây là cách tốt nhất để con em bạn cảm nhận xem mình có hợp với môi trường này hay không, và ba/mẹ cũng thấy con em mình hứng thú như thế nào.</p>
        </div>
        <div class="content-card">
          <h3>Tư Vấn Cá Nhân 1-1 Từ Chuyên Gia Tuyển Sinh</h3>
          <p>Sau buổi tham quan, bạn sẽ có thời gian tư vấn riêng với chuyên viên Tuyển sinh của Việt Anh. Họ sẽ trả lời tất cả câu hỏi của bạn về chương trình, học phí, ưu đãi, lộ trình học tập cá nhân cho bé, và giúp bạn hiểu rõ Việt Anh có phù hợp với mục tiêu giáo dục của gia đình bạn hay không.</p>
        </div>
      </div>
    </div>
  </div>

  <div slot="form">
    <h2 class="form-heading">Đặt Lịch Tham Quan Hôm Nay - Vừa Rồi Là Muộn Rồi!</h2>
    <p class="form-subheading">Miễn phí + Có xe đưa đón - Bộ phận Tuyển sinh sẽ xác nhận lịch trong 24h</p>
    <LeadFormTwoStepEmailFirst
      formId="tuyen-sinh-form"
      funnelCode="school-tour-tieu-hoc"
      schoolLevel="tieu-hoc"
      submitText="Đặt lịch ngay"
      successMessage="Đã nhận yêu cầu! Bộ phận Tuyển sinh sẽ liên hệ để xác nhận lịch tham quan."
    />
  </div>

  <div slot="faq">
    <FAQSection items={faqItems} title="Câu hỏi về Tham quan trường" />
  </div>
</SqueezePageLayout>

<style>
  .hero-h1 { font-family: "Montserrat", sans-serif; font-size: clamp(1.75rem, 5vw, 2.75rem); font-weight: 800; line-height: 1.2; margin-bottom: 1rem; color: #1F4E79; }
  .hero-subtitle { font-size: clamp(1rem, 3vw, 1.25rem); font-weight: 500; opacity: 0.95; color: #E8792B; }
  .content-section h2 { font-family: "Montserrat", sans-serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; margin-bottom: 2rem; color: #1F4E79; text-align: center; }
  .content-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; max-width: 1200px; margin: 0 auto; }
  .content-card { padding: 2rem; background: white; border: 2px solid #e0e0e0; border-radius: 12px; transition: all 0.3s ease; }
  .content-card:hover { border-color: #E8792B; box-shadow: 0 8px 20px rgba(232, 121, 43, 0.12); transform: translateY(-4px); }
  .content-card h3 { font-family: "Montserrat", sans-serif; font-size: 1.25rem; font-weight: 700; color: #E8792B; margin-bottom: 1rem; }
  .content-card p { font-size: 0.95rem; line-height: 1.6; color: #555; }
  .form-heading { font-family: "Montserrat", sans-serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; color: #E8792B; margin-bottom: 0.5rem; }
  .form-subheading { font-size: 1rem; color: #555; font-weight: 500; margin-bottom: 2rem; }
  @media (max-width: 768px) { .content-grid { grid-template-columns: 1fr; } .content-card { padding: 1.5rem; } }
</style>
