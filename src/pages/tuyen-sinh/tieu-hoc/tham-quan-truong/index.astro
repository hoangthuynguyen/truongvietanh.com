---
import SqueezePageLayout from '../../../../layouts/SqueezePageLayout.astro';
import LeadFormTwoStepEmailFirst from '../../../../components/LeadFormTwoStepEmailFirst.astro';
import USPGrid from '../../../../components/USPGrid.astro';
import TrustMetrics from '../../../../components/TrustMetrics.astro';
import FAQSection from '../../../../components/FAQSection.astro';

const pageTitle = 'Tham Quan Tiểu Học Việt Anh — Trải Nghiệm Cơ Sở Trước Khi Quyết Định';
const pageDescription = 'Đặt lịch tham quan miễn phí Trường Tiểu Học Việt Anh: xem phòng học, gặp giáo viên bản ngữ, bé trải nghiệm lớp học thử, tư vấn 1-1 từ chuyên gia.';
const canonicalUrl = 'https://truongvietanh.com/tuyen-sinh/tieu-hoc/tham-quan-truong';

const uspItems = [
  { icon: '👀', text: 'Tham quan toàn bộ cơ sở — Phòng học, lab STEM, thư viện, sân thể thao' },
  { icon: '👩‍🏫', text: 'Gặp giáo viên Việt Nam & bản ngữ — Hiểu cách dạy thực tế' },
  { icon: '📚', text: 'Bé tham gia lớp học thử — Trải nghiệm tiết học song ngữ thật' },
  { icon: '🤝', text: 'Tư vấn 1-1 từ chuyên gia Tuyển sinh — Trả lời mọi thắc mắc' },
  { icon: '🕐', text: 'Linh hoạt lịch hẹn — Sáng, chiều, thứ 7 đều được' },
  { icon: '💝', text: 'Quà tặng cho bé + Brochure chi tiết cho ba/mẹ' }
];

const metrics = [
  { number: '15+', label: 'Năm kinh nghiệm giáo dục' },
  { number: '500+', label: 'Học sinh Tiểu Học đang theo học' },
  { number: '3', label: 'Cơ sở tại TPHCM để lựa chọn' },
  { number: '60-90', label: 'Phút tham quan trọn vẹn' }
];

const faqItems = [
  {
    question: 'Buổi tham quan bao gồm những gì và kéo dài bao lâu?',
    answer: 'Buổi tham quan kéo dài 60-90 phút và bao gồm 4 phần: (1) Tham quan toàn bộ cơ sở vật chất — phòng học với bảng thông minh, phòng lab STEM, thư viện hàng ngàn cuốn sách, sân thể thao, bể bơi, nhà ăn, (2) Gặp gỡ và trao đổi với giáo viên Việt Nam và giáo viên bản ngữ, (3) Bé tham gia một tiết lớp học thử để trải nghiệm thực tế, (4) Tư vấn cá nhân 1-1 với chuyên gia Tuyển sinh — trả lời mọi câu hỏi về chương trình, học phí, và lộ trình phù hợp cho con. Chúng tôi không vội vã — ba/mẹ có đủ thời gian để cảm nhận và đặt câu hỏi.'
  },
  {
    question: 'Con có thể đi cùng và tham gia lớp học thử không?',
    answer: 'Không chỉ được mà chúng tôi rất khuyến khích! Bé sẽ được ngồi vào lớp học thật, tham gia một tiết học song ngữ với giáo viên bản ngữ, gặp gỡ các bạn cùng tuổi, và cảm nhận không gian học tập. Đây là cách tốt nhất để ba/mẹ quan sát con mình hứng thú hay không, có thoải mái với môi trường hay không. Nhiều bé sau buổi tham quan thử đã "đòi" ba/mẹ cho đi học ngay — vì các em cảm thấy vui, được chào đón, và muốn quay lại. Giáo viên cũng sẽ chia sẻ nhận xét ban đầu về bé với ba/mẹ.'
  },
  {
    question: 'Có cần đặt lịch trước không? Lịch tham quan linh hoạt thế nào?',
    answer: 'Ba/mẹ nên đặt lịch trước để nhà trường chuẩn bị tốt nhất — mỗi buổi chỉ nhận tối đa 5 gia đình để đảm bảo mỗi gia đình nhận được sự chú ý cá nhân đầy đủ. Lịch tham quan rất linh hoạt: ba/mẹ có thể chọn buổi sáng (8h-11h), buổi chiều (14h-16h), hoặc thứ 7 (9h-12h) — phù hợp với lịch làm việc bận rộn. Sau khi ba/mẹ đăng ký, bộ phận Tuyển sinh sẽ liên hệ trong vòng 24 giờ để xác nhận lịch hẹn và hướng dẫn đường đi đến cơ sở gần nhất.'
  },
  {
    question: 'Tham quan cơ sở nào? Có 3 cơ sở thì khác nhau thế nào?',
    answer: 'Trường Việt Anh có 3 cơ sở tại TPHCM, tất cả đều đạt cùng tiêu chuẩn chất lượng về chương trình, giáo viên, và cơ sở vật chất. Khi đăng ký tham quan, chuyên viên Tuyển sinh sẽ tư vấn cơ sở gần nhà ba/mẹ nhất hoặc thuận tiện đường đón trả. Ba/mẹ cũng có thể tham quan nhiều cơ sở nếu muốn so sánh — mỗi cơ sở có nét đặc trưng riêng về khuôn viên và tiện ích, nhưng chất lượng giảng dạy đồng nhất. Đội ngũ sẽ giúp ba/mẹ chọn cơ sở phù hợp nhất với nhu cầu gia đình.'
  },
  {
    question: 'Sau buổi tham quan, tôi có bị áp lực đăng ký ngay không?',
    answer: 'Tuyệt đối không. Buổi tham quan là để ba/mẹ và con trải nghiệm thực tế, thu thập thông tin, và đặt mọi câu hỏi cần thiết. Chúng tôi không bao giờ gây áp lực hay "ép" phụ huynh đăng ký tại chỗ. Sau tham quan, ba/mẹ có thể về nhà suy nghĩ, trao đổi với gia đình, so sánh với các trường khác. Chuyên viên Tuyển sinh sẽ follow-up lịch sự để giải đáp thêm thắc mắc, nhưng quyết định hoàn toàn thuộc về ba/mẹ. Chúng tôi muốn ba/mẹ chọn Việt Anh vì thật sự tin tưởng, không phải vì bị thúc ép.'
  }
];
---

<SqueezePageLayout
  title={pageTitle}
  description={pageDescription}
  keywords="tham quan trường, school tour, tiểu học, trường Việt Anh, lớp học thử, tư vấn tuyển sinh"
  schoolLevel="tieu-hoc"
  funnelCode="tour-tieu-hoc"
  canonicalUrl={canonicalUrl}
>
  <div slot="hero">
    <h1 class="hero-h1">Tham Quan Tiểu Học Việt Anh<br/>Trải Nghiệm Cơ Sở Trước Khi Quyết Định</h1>
    <p class="hero-subtitle">Miễn phí — Bé học thử lớp thật + Gặp giáo viên bản ngữ + Tư vấn 1-1 từ chuyên gia</p>
  </div>

  <div slot="usp">
    <USPGrid items={uspItems} />
  </div>

  <div slot="trust">
    <TrustMetrics metrics={metrics} />
  </div>

  <div slot="content">
    <div class="content-section hero-image-section">
      <img src="https://media.truongvietanh.com/images/vui-ve-05.webp" alt="Học sinh tiểu học Trường Việt Anh vui vẻ trong khuôn viên trường với bạn bè và giáo viên" class="hero-content-image" width="800" height="450" loading="lazy" />
      <p class="image-caption">Không khí vui tươi và an toàn tại khuôn viên Trường Tiểu Học Việt Anh</p>
    </div>

    <div class="content-section">
      <h2>Buổi Tham Quan — Ba/Mẹ và Con Sẽ Trải Nghiệm Gì?</h2>
      <div class="content-grid">
        <div class="content-card">
          <h3>Tham Quan Toàn Bộ Cơ Sở Vật Chất Hiện Đại</h3>
          <p>Ba/mẹ sẽ được nhân viên tuyển sinh dẫn tham quan tất cả các khu vực trọng yếu: phòng học trang bị bảng thông minh và máy chiếu, phòng lab STEM với thiết bị robotics LEGO Education và Arduino, thư viện song ngữ với hàng ngàn đầu sách Anh-Việt phân theo cấp độ đọc. Ngoài ra còn có sân thể thao đa năng, bể bơi tiêu chuẩn, và nhà ăn với thực đơn do chuyên gia dinh dưỡng thiết kế. Mỗi không gian được bố trí khoa học để khơi gợi sáng tạo và đảm bảo an toàn tối đa cho các bé tiểu học.</p>
        </div>
        <div class="content-card">
          <h3>Gặp Gỡ Giáo Viên — Cảm Nhận Phương Pháp Giảng Dạy</h3>
          <p>Ba/mẹ sẽ gặp trực tiếp giáo viên Việt Nam tâm huyết và giáo viên bản ngữ đến từ Anh, Mỹ, Úc — những người sẽ đồng hành cùng con mỗi ngày trong suốt năm học. Đây là dịp để trao đổi về phương pháp giảng dạy lấy học sinh làm trung tâm, cách giáo viên xử lý cá nhân hóa khi bé gặp khó khăn, và đặc biệt là nghe câu chuyện thực tế từ những người trực tiếp dạy dỗ hàng trăm học sinh tiểu học mỗi năm. Ba/mẹ sẽ cảm nhận được sự nhiệt huyết và chuyên nghiệp của đội ngũ.</p>
        </div>
        <div class="content-card">
          <h3>Bé Trải Nghiệm Lớp Học Thử — Quan Sát Phản Ứng Thực Tế</h3>
          <p>Thay vì chỉ nghe giới thiệu trên giấy, con ba/mẹ sẽ ngồi vào lớp học thật với 25 bạn, tham gia một tiết học song ngữ với giáo viên bản ngữ, và tương tác trực tiếp với các bạn cùng tuổi. Ba/mẹ có thể quan sát từ bên ngoài — con có hứng thú với phương pháp học không? Con có thoải mái trong môi trường mới không? Con có tương tác tốt với giáo viên nước ngoài không? Đây là "phép thử" chính xác nhất mà không có brochure hay video quảng cáo nào thay thế được.</p>
        </div>
        <div class="content-card">
          <h3>Tư Vấn Cá Nhân 1-1 — Mọi Câu Hỏi Đều Được Giải Đáp</h3>
          <p>Sau phần tham quan, ba/mẹ sẽ có 20-30 phút riêng với chuyên gia Tuyển sinh để trao đổi chi tiết về chương trình phù hợp cho con, mức học phí cụ thể và các ưu đãi Early Bird hiện tại, lộ trình học tập cá nhân dựa trên năng lực của bé. Không có câu hỏi nào bị bỏ qua — từ chính sách bán trú, xe đưa đón, đến cách xử lý khi con bị bắt nạt. Chúng tôi muốn ba/mẹ ra về với đầy đủ thông tin để đưa ra quyết định đúng đắn nhất cho con em mình.</p>
        </div>
      </div>
    </div>

    <div class="content-section bonus-section">
      <h2 style="color: #f9dd0e;">Bonus: Quà Tặng Cho Bé & Brochure Chi Tiết Cho Ba/Mẹ</h2>
      <p style="font-size: 1.05rem; line-height: 1.8; color: #333; text-align: center; max-width: 800px; margin: 0 auto;">
        Mỗi bé tham quan sẽ nhận <strong>một phần quà nhỏ</strong> từ nhà trường — để bé có kỷ niệm vui vẻ với buổi tham quan đầu tiên và cảm thấy được chào đón. Ba/mẹ sẽ nhận <strong>brochure chi tiết</strong> về chương trình Tiểu Học song ngữ Oxford, bảng học phí minh bạch không phụ phí ẩn, danh sách 20+ CLB ngoại khóa miễn phí, và thông tin về 3 cơ sở tại TP.HCM. Tất cả thông tin ba/mẹ cần để so sánh, trao đổi với gia đình, và đưa ra quyết định — đều có trong brochure này. Nếu cần thêm thông tin sau buổi tham quan, gọi <strong>0916 961 409</strong> hoặc nhắn Zalo — chuyên viên Tuyển sinh luôn sẵn sàng hỗ trợ.
      </p>
    </div>
  </div>

  <div slot="form">
    <h2 class="form-heading">Đặt Lịch Tham Quan Miễn Phí Ngay Hôm Nay</h2>
    <p class="form-subheading">Linh hoạt sáng, chiều, thứ 7 — Bộ phận Tuyển sinh sẽ xác nhận lịch trong 24h</p>
    <LeadFormTwoStepEmailFirst
      formId="tour-tieu-hoc-form"
      funnelCode="tour-tieu-hoc"
      schoolLevel="tieu-hoc"
      submitText="Đặt lịch tham quan"
      successMessage="Đã nhận yêu cầu! Bộ phận Tuyển sinh sẽ liên hệ trong 24h để xác nhận lịch tham quan và hướng dẫn đường đi."
    />
  </div>

  <div slot="faq">
    <FAQSection items={faqItems} title="Câu hỏi về Tham quan Trường Tiểu Học" />
  </div>
</SqueezePageLayout>

<style>.hero-h1{ font-family: "Montserrat", sans-serif; font-size: clamp(1.75rem, 5vw, 2.75rem); font-weight: 800; line-height: 1.2; margin-bottom: 1rem; color: #26275D; }.hero-subtitle{ font-size: clamp(1rem, 3vw, 1.25rem); font-weight: 500; opacity: 0.95; color: #f9dd0e; }.content-section{ margin-bottom: 3rem; }.content-section h2{ font-family: "Montserrat", sans-serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; margin-bottom: 2rem; color: #26275D; text-align: center; }.content-grid{ display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; max-width: 1200px; margin: 0 auto; }.content-card{ padding: 2rem; background: white; border: 2px solid #e0e0e0; border-radius: 12px; transition: all 0.3s ease; }.content-card:hover{ border-color: #f9dd0e; box-shadow: 0 8px 20px rgba(249, 221, 14, 0.12); transform: translateY(-4px); }.content-card h3{ font-family: "Montserrat", sans-serif; font-size: 1.5rem; font-weight: 700; color: #f9dd0e; margin-bottom: 1rem; }.content-card p{ font-size: 1rem; line-height: 1.7; color: #555; }.bonus-section{ background: linear-gradient(135deg, #FFF8F0 0%, #FFFBF7 100%); padding: 2rem; border-left: 5px solid #f9dd0e; border-radius: 8px; }.form-heading{ font-family: "Montserrat", sans-serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; color: #f9dd0e; margin-bottom: 0.5rem; }.form-subheading{ font-size: 1rem; color: #555; margin-bottom: 2rem; font-weight: 500; }.hero-image-section{ text-align: center; margin-bottom: 2rem; }.hero-content-image{ width: 100%; max-width: 800px; height: auto; border-radius: 12px; box-shadow: 0 8px 30px rgba(0,0,0,0.12); }.image-caption{ font-size: 1rem; color: #777; margin-top: 0.75rem; font-style: italic; }
  @media (max-width: 768px) {.content-grid{ grid-template-columns: 1fr; }.content-card{ padding: 1.5rem; }.bonus-section{ padding: 1.5rem; } }
</style>
