---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeaderBase from '../../../components/HeaderBase.astro';
import FooterBase from '../../../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../../../components/LeadFormTwoStepEmailFirst.astro';

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Course",
    "name": "Toán SAM – Toán Tư Duy Singapore",
    "url": "https://truongvietanh.com/tuyen-sinh/toan-tu-duy-sam",
    "description": "Toán SAM – phương pháp Toán tư duy đến từ Singapore. Dạy trẻ hiểu bản chất, nhìn ra quy luật, tự tìm cách giải — không học thuộc, không luyện bài.",
    "provider": { "@type": "Organization", "name": "Hệ thống Trường Việt Anh", "url": "https://truongvietanh.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Con tôi học yếu Toán có phù hợp không?", "acceptedAnswer": { "@type": "Answer", "text": "Càng phù hợp. Học yếu Toán thường là do cách học — không phải do con." } },
      { "@type": "Question", "name": "Có cần học nhiều bài không?", "acceptedAnswer": { "@type": "Answer", "text": "Không. Quan trọng là hiểu bản chất. Một bài hiểu sâu hơn 10 bài làm theo mẫu." } },
      { "@type": "Question", "name": "Bao lâu thấy kết quả?", "acceptedAnswer": { "@type": "Answer", "text": "Thay đổi tư duy thường thấy rõ trong 2–4 tuần đầu tiên." } },
      { "@type": "Question", "name": "Toán SAM khác gì học thêm?", "acceptedAnswer": { "@type": "Answer", "text": "Không luyện bài. Dạy cách hiểu và giải quyết vấn đề — kỹ năng áp dụng được ở mọi dạng toán." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://truongvietanh.com" },
      { "@type": "ListItem", "position": 2, "name": "Tuyển sinh", "item": "https://truongvietanh.com/tuyen-sinh" },
      { "@type": "ListItem", "position": 3, "name": "Toán SAM", "item": "https://truongvietanh.com/tuyen-sinh/toan-tu-duy-sam" }
    ]
  }
];
---

<BaseLayout
  title="Toán SAM – Toán Tư Duy Singapore Cho Trẻ Em Việt Nam"
  description="Toán SAM – phương pháp Toán tư duy Singapore. Dạy trẻ hiểu bản chất, không học thuộc — không luyện bài. Giúp con tự tin giải mọi dạng toán."
  canonical="https://truongvietanh.com/tuyen-sinh/toan-tu-duy-sam"
  ogImage="https://media.truongvietanh.com/images/thuyet-trinh-09.webp"
  structuredData={structuredData}
>
  <div class="pp-page">
    <HeaderBase />

    <!-- BLOCK 1: HERO -->
    <section class="pp-hero">
      <div class="pp-hero-inner">
        <h1 class="pp-h1">
          Con bạn đang học Toán với niềm đam mê
          <span class="pp-h1-accent">hay đang vật lộn với Toán vì bị bắt buộc?</span>
        </h1>
        <p class="pp-subtitle">
          Làm bài quen thì nhanh · gặp bài lạ thì "đứng hình" · không trả lời được câu hỏi cơ bản "Học Toán để làm gì?" — Nếu bạn thấy con mình ở đâu đó trong những điều này, rất có thể vấn đề không nằm ở con.
        </p>
        <div class="pp-cta-row">
          <a href="#pp-form" class="pp-btn pp-btn-gold">Đăng ký khảo sát Tư Duy Toán Học MIỄN PHÍ →</a>
          <a href="https://zalo.me/truongvietanh" class="pp-btn pp-btn-outline">Chat ngay với tôi →</a>
        </div>
      </div>
    </section>

    <!-- BLOCK 2: RICH TEXT -->
    <section class="pp-richtext">
      <div class="pp-richtext-inner">
        <h2>Không phải trẻ không giỏi Toán<br/>mà trẻ đang học sai cách</h2>
        <p>Phần lớn trẻ em Việt Nam học Toán theo cách:</p>
        <ul class="pp-bullet">
          <li>Ghi nhớ công thức</li>
          <li>Làm theo mẫu</li>
          <li>Luyện thật nhiều bài</li>
        </ul>
        <div class="pp-callout">Kết quả: làm đúng bài quen · nhưng không hiểu bản chất · không giải được bài mới</div>
        <p>Và phụ huynh thường nghĩ: "Con chưa cố gắng" hoặc "Con chưa đủ thông minh". Nhưng sự thật là: <strong>trẻ chưa bao giờ được học Toán đúng cách</strong>.</p>
        <p>Toán không phải là môn để "luyện trước mọi dạng bài tập" — mà là môn để <strong>phát triển tư duy logic, hiểu được cách hiểu và suy nghĩ</strong>.</p>
      </div>
    </section>

    <!-- BLOCK 3: FEATURES -->
    <section class="pp-features">
      <div class="pp-features-inner">
        <h2>Toán SAM – Phương pháp đến từ Singapore</h2>
        <div class="pp-feat-grid">
          <div class="pp-feat-card">
            <span class="pp-icon">🇸🇬</span>
            <strong>SAM – Đơn vị Toán tư duy Singapore</strong>
            <p>Một trong những hệ thống đào tạo Toán tư duy hàng đầu, phát triển theo triết lý Toán Singapore</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">🧠</span>
            <strong>Học Toán từ bản chất</strong>
            <p>Không học thuộc – không học vẹt – không phụ thuộc</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">🔍</span>
            <strong>Tư duy trực quan (CPA)</strong>
            <p>Concrete – Pictorial – Abstract. Hiểu bằng hình ảnh trước khi làm số</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">🎯</span>
            <strong>Giải quyết vấn đề</strong>
            <p>Không chỉ làm Toán, mà học cách suy nghĩ</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">🚀</span>
            <strong>Cá nhân hoá theo năng lực</strong>
            <p>Mỗi trẻ có lộ trình riêng, không học đại trà</p>
          </div>
        </div>
      </div>
    </section>

    <!-- BLOCK 4: TEXT WITH IMAGE -->
    <section class="pp-textimg">
      <div class="pp-textimg-inner">
        <div class="pp-textimg-text">
          <h2>Trẻ không sợ Toán<br/>trẻ chỉ sợ cách học hiện tại</h2>
          <p>Hãy nhìn cách trẻ đang học: <strong>nhìn bài → tìm công thức · làm sai → xem đáp án · lặp lại → vẫn không hiểu</strong>.</p>
          <div class="pp-callout">Điều này tạo ra: phụ thuộc · mất tự tin · và sợ Toán</div>
          <p>Tại SAM, trẻ không bắt đầu bằng công thức. Mà bắt đầu bằng: <strong>hiểu vấn đề → nhìn ra quy luật → tự tìm cách giải</strong>.</p>
          <p>Đây là cách trẻ hiểu sâu, nhớ lâu, và <strong>không còn sợ Toán</strong>.</p>
        </div>
        <div class="pp-textimg-img">
          <img src="https://media.truongvietanh.com/images/thuyet-trinh-09.webp" alt="Học sinh học Toán tư duy Singapore tại SAM" loading="lazy" width="600" height="400" />
        </div>
      </div>
    </section>

    <!-- BLOCK 5: STATS -->
    <section class="pp-stats">
      <div class="pp-stats-inner">
        <h2>Vì sao phương pháp Singapore khác biệt?</h2>
        <div class="pp-stats-cols">
          <div class="pp-stats-col">
            <h3>🏆 TIMSS (Toán học quốc tế)</h3>
            <ul>
              <li>Top 1 thế giới các kỳ 2011, 2015, 2019</li>
              <li>Học sinh Singapore dẫn đầu về giải quyết vấn đề</li>
              <li>Hơn 10 năm liên tiếp trong Top 3</li>
            </ul>
          </div>
          <div class="pp-stats-col">
            <h3>🏆 PISA (OECD)</h3>
            <ul>
              <li>Top 3 toàn cầu các kỳ 2012, 2015, 2018</li>
              <li>Điểm Toán cao nhất thế giới</li>
              <li>Dẫn đầu về tư duy phản biện</li>
            </ul>
          </div>
        </div>
        <p class="pp-stats-note">Điều tạo nên khác biệt không phải là <em>học nhiều hơn</em> hay <em>luyện nhiều hơn</em> — mà là cách học tập trung vào <strong>hiểu bản chất và tư duy</strong>.</p>
      </div>
    </section>

    <!-- BLOCK 6: PRICING -->
    <section class="pp-pricing">
      <div class="pp-pricing-inner">
        <h2>Đây không phải là lớp học thêm</h2>
        <div class="pp-pricing-cols">
          <div class="pp-pricing-col pp-pricing-bad">
            <span class="pp-pricing-tag">Lựa chọn 1</span>
            <p>Cho con <strong>học thêm nhiều hơn</strong> — làm thêm bài, luyện thêm đề, rồi lại đến kỳ mất gốc mới giật mình.</p>
          </div>
          <div class="pp-pricing-col pp-pricing-good">
            <span class="pp-pricing-tag">Lựa chọn 2</span>
            <p>Giúp con <strong>hiểu Toán từ gốc, tự học được, và không mất gốc sau này</strong> — kỹ năng giữ mãi về sau.</p>
          </div>
        </div>
        <div class="pp-pricing-summary">
          <p>Chi phí không nằm ở học phí. Mà nằm ở: <strong>việc con có phải mất nhiều năm để "học lại từ đầu" hay không</strong>.</p>
        </div>
      </div>
    </section>

    <!-- BLOCK 7: CTA -->
    <section class="pp-ctablock">
      <div class="pp-ctablock-inner">
        <h2>Đừng đợi đến khi con mất gốc<br/>mới bắt đầu</h2>
        <p>Bạn không cần quyết định ngay. Nhưng bạn nên <strong>hiểu cách con đang học Toán</strong>.</p>
        <div class="pp-cta-row">
          <a href="#pp-form" class="pp-btn pp-btn-gold">Đăng ký khảo sát Tư Duy Toán Học MIỄN PHÍ →</a>
          <a href="https://zalo.me/truongvietanh" class="pp-btn pp-btn-outline-dark">Chat ngay với tôi →</a>
        </div>
      </div>
    </section>

    <!-- BLOCK 8: FORM -->
    <section class="pp-form-block" id="pp-form">
      <div class="pp-form-block-inner">
        <h2>Nhận tư vấn cho con</h2>
        <p>Để lại thông tin — chúng tôi sẽ liên hệ lại trong vòng 24 giờ.</p>
        <ul>
          <li>Đánh giá khả năng học Toán hiện tại của con</li>
          <li>Lộ trình học Toán tư duy phù hợp</li>
          <li>Tư vấn cá nhân hoá 1-1 với chuyên viên</li>
        </ul>
        <LeadFormTwoStepEmailFirst
          formId="toan-tu-duy-sam-form"
          funnelCode="toan-tu-duy-sam"
          schoolLevel="tieu-hoc"
        />
      </div>
    </section>

    <!-- BLOCK 9: FAQ -->
    <section class="pp-faq">
      <div class="pp-faq-inner">
        <h2>Câu hỏi phụ huynh thường gặp</h2>
        <div class="pp-faq-item">
          <p class="pp-faq-q">Con tôi học yếu Toán có phù hợp không?</p>
          <p class="pp-faq-a">Càng phù hợp. Phần lớn trường hợp "học yếu Toán" thực ra là do cách học — chứ không phải do con. Khi đổi cách học, phần lớn trẻ bật lên rất nhanh.</p>
        </div>
        <div class="pp-faq-item">
          <p class="pp-faq-q">Có cần học nhiều bài không?</p>
          <p class="pp-faq-a">Không. Quan trọng là <strong>hiểu</strong>. Một bài hiểu sâu có giá trị hơn 10 bài làm theo mẫu — vì kỹ năng đó áp dụng được ở mọi dạng toán sau này.</p>
        </div>
        <div class="pp-faq-item">
          <p class="pp-faq-q">Bao lâu thấy kết quả?</p>
          <p class="pp-faq-a">Thay đổi tư duy thường thấy rõ trong <strong>2–4 tuần</strong> đầu tiên — khi con bắt đầu tự đặt câu hỏi "tại sao" thay vì đi tìm công thức.</p>
        </div>
        <div class="pp-faq-item">
          <p class="pp-faq-q">Toán SAM khác gì học thêm?</p>
          <p class="pp-faq-a">Không luyện bài. Dạy cách <strong>hiểu và giải quyết vấn đề</strong> — đó là kỹ năng dùng được cả đời, không chỉ cho kỳ thi sắp tới.</p>
        </div>
      </div>
    </section>

    <FooterBase />
  </div>

  <style>
    *, *::before, *::after { box-sizing: border-box; }
    .pp-page { font-family: 'Be Vietnam Pro', 'Segoe UI', system-ui, -apple-system, sans-serif; color: #1a1a2e; line-height: 1.6; }

    /* HERO */
    .pp-hero { background: linear-gradient(135deg, #0d2b55 0%, #1a1a5e 100%); color: white; padding: 5rem 1.5rem; text-align: center; }
    .pp-hero-inner { max-width: 820px; margin: 0 auto; }
    .pp-h1 { font-size: 2.4rem; font-weight: 800; line-height: 1.3; margin-bottom: 1.25rem; color: #f5a623; }
    .pp-h1-accent { color: #fff; display: block; margin-top: .75rem; font-size: .68em; font-weight: 600; line-height: 1.5; }
    .pp-subtitle { font-size: 1.1rem; opacity: .9; margin-bottom: 2.5rem; line-height: 1.75; }
    .pp-cta-row { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
    .pp-btn { display: inline-block; padding: .9rem 2rem; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 1rem; transition: opacity .2s, transform .15s; }
    .pp-btn:hover { opacity: .9; transform: translateY(-1px); }
    .pp-btn-gold { background: #f07d00; color: #fff; }
    .pp-btn-outline { background: transparent; color: white; border: 2px solid rgba(255,255,255,.7); }
    .pp-btn-outline-dark { background: transparent; color: #0d2b55; border: 2px solid #0d2b55; }

    /* RICH TEXT */
    .pp-richtext { background: #fff; padding: 4.5rem 1.5rem; }
    .pp-richtext-inner { max-width: 820px; margin: 0 auto; }
    .pp-richtext h2 { font-size: 1.5rem; font-weight: 800; color: #dc2626; text-transform: uppercase; margin-bottom: 1.5rem; line-height: 1.4; text-align: center; }
    .pp-richtext p { font-size: 1.05rem; color: #334155; line-height: 1.8; margin-bottom: 1rem; }
    .pp-bullet { list-style: none; padding: 0; margin: 1rem 0 1.25rem; }
    .pp-bullet li { padding: .4rem 0 .4rem 1.75rem; position: relative; color: #334155; font-size: 1.02rem; line-height: 1.7; }
    .pp-bullet li::before { content: '→'; position: absolute; left: 0; color: #f07d00; font-weight: 700; }
    .pp-callout { color: #0d2b55; font-weight: 700; font-size: 1.05rem; padding: .75rem 1.1rem; border-left: 4px solid #f07d00; margin: 1.25rem 0; background: #fff7ed; border-radius: 0 6px 6px 0; }

    /* FEATURES */
    .pp-features { background: #0d2b55; color: white; padding: 4.5rem 1.5rem; }
    .pp-features-inner { max-width: 1050px; margin: 0 auto; }
    .pp-features h2 { font-size: 1.5rem; font-weight: 800; text-align: center; text-transform: uppercase; margin-bottom: 2.5rem; line-height: 1.45; color: #f5a623; }
    .pp-feat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
    .pp-feat-card { background: rgba(255,255,255,.08); border-radius: 12px; padding: 1.75rem 1.5rem; border: 1px solid rgba(255,255,255,.12); }
    .pp-feat-card .pp-icon { font-size: 2rem; display: block; margin-bottom: .75rem; }
    .pp-feat-card strong { display: block; font-size: 1.05rem; margin-bottom: .5rem; }
    .pp-feat-card p { font-size: .92rem; opacity: .85; line-height: 1.65; margin: 0; }

    /* TEXT WITH IMAGE */
    .pp-textimg { background: white; padding: 4.5rem 1.5rem; }
    .pp-textimg-inner { max-width: 1050px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 3.5rem; align-items: center; }
    .pp-textimg-text h2 { font-size: 1.5rem; font-weight: 800; color: #dc2626; text-transform: uppercase; margin-bottom: 1.25rem; line-height: 1.4; }
    .pp-textimg-text p { color: #334155; line-height: 1.8; margin-bottom: .9rem; font-size: 1.02rem; }
    .pp-textimg-img img { width: 100%; border-radius: 16px; box-shadow: 0 8px 30px rgba(0,0,0,.12); display: block; }

    /* STATS */
    .pp-stats { background: #f0f4f8; padding: 4.5rem 1.5rem; border-top: 3px solid #e2e8f0; }
    .pp-stats-inner { max-width: 900px; margin: 0 auto; }
    .pp-stats-inner > h2 { font-size: 1.5rem; font-weight: 800; color: #dc2626; text-transform: uppercase; text-align: center; margin-bottom: 2rem; }
    .pp-stats-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .pp-stats-col { background: white; border-radius: 12px; padding: 1.75rem; box-shadow: 0 2px 10px rgba(0,0,0,.05); border-top: 4px solid #f5a623; }
    .pp-stats-col h3 { font-size: 1.05rem; font-weight: 700; color: #0d2b55; margin-bottom: 1rem; padding-bottom: .5rem; border-bottom: 1px solid #e2e8f0; }
    .pp-stats-col ul { list-style: none; padding: 0; margin: 0; }
    .pp-stats-col li { padding: .45rem 0 .45rem 1.75rem; position: relative; color: #475569; font-size: .98rem; line-height: 1.55; }
    .pp-stats-col li::before { content: '✓'; position: absolute; left: 0; color: #22c55e; font-weight: 700; }
    .pp-stats-note { text-align: center; margin-top: 1.75rem; color: #475569; font-size: 1rem; line-height: 1.7; }
    .pp-stats-note strong { color: #0d2b55; }

    /* PRICING */
    .pp-pricing { background: white; padding: 4.5rem 1.5rem; }
    .pp-pricing-inner { max-width: 900px; margin: 0 auto; text-align: center; }
    .pp-pricing-inner > h2 { font-size: 1.5rem; font-weight: 800; color: #dc2626; text-transform: uppercase; margin-bottom: 2rem; line-height: 1.45; }
    .pp-pricing-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem; }
    .pp-pricing-col { background: #f8fafc; border-radius: 14px; padding: 2rem 1.75rem; text-align: left; border: 1px solid #e2e8f0; }
    .pp-pricing-col.pp-pricing-bad { background: #fef2f2; border-color: #fecaca; }
    .pp-pricing-col.pp-pricing-good { background: #f0fdf4; border-color: #bbf7d0; }
    .pp-pricing-tag { display: inline-block; font-size: .78rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; padding: .3rem .75rem; border-radius: 999px; background: #e2e8f0; color: #475569; margin-bottom: 1rem; }
    .pp-pricing-col.pp-pricing-bad .pp-pricing-tag { background: #fecaca; color: #991b1b; }
    .pp-pricing-col.pp-pricing-good .pp-pricing-tag { background: #bbf7d0; color: #14532d; }
    .pp-pricing-col p { color: #334155; font-size: 1.02rem; line-height: 1.75; margin: 0; }
    .pp-pricing-summary { background: #fff7ed; border-left: 4px solid #f07d00; border-radius: 0 8px 8px 0; padding: 1.25rem 1.5rem; text-align: left; }
    .pp-pricing-summary p { color: #0d2b55; font-size: 1.05rem; line-height: 1.7; margin: 0; font-weight: 500; }

    /* CTA BLOCK */
    .pp-ctablock { background: #f0f4f8; padding: 5rem 1.5rem; text-align: center; border-top: 3px solid #e2e8f0; }
    .pp-ctablock-inner { max-width: 760px; margin: 0 auto; }
    .pp-ctablock h2 { font-size: 1.6rem; font-weight: 800; color: #dc2626; text-transform: uppercase; margin-bottom: 1.25rem; line-height: 1.4; }
    .pp-ctablock p { font-size: 1.1rem; color: #334155; line-height: 1.75; margin-bottom: 2.25rem; }

