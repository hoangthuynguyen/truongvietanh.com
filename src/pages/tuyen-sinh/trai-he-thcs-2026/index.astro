---
import SalesPageLayout from '../../../layouts/SalesPageLayout.astro';
import LeadFormTwoStepEmailFirst from '../../../components/LeadFormTwoStepEmailFirst.astro';
---

<SalesPageLayout
  title="Lion Camp 2026 THCS — 6 Tuần Dẫn Dắt Tuổi Dậy Thì Đúng Cách"
  description="Lion Camp 2026: chương trình 6 tuần giúp học sinh THCS chuyển năng lượng tuổi dậy thì thành bản lĩnh, kỹ năng và định hướng tích cực. Học bổng 10tr. Giới hạn số lượng."
  canonical="https://truongvietanh.com/tuyen-sinh/trai-he-thcs-2026"
  ogImage="https://media.truongvietanh.com/images/thuyet-trinh-09.webp"
  heroImage="https://media.truongvietanh.com/images/Block%20Hero%20_%20BG%20-%20website/thcs-banner-chinh-1.jpg"
  programCode="trai-he-thcs"
  schoolLevel="thcs"
>

  <!-- BLOCK 1: HERO -->
  <div slot="hero">
    <span class="sp-hero__badge">🦁 Lion Camp 2026 – Trại hè dành cho học sinh THCS</span>
    <h1 style="font-size:2.5rem;font-weight:900;line-height:1.15;text-shadow:0 2px 8px rgba(0,0,0,.3);margin:0 0 .5rem">
      <span style="color:#ef5350">Tuổi dậy thì không cần bị "kiểm soát"</span>
    </h1>
    <h2 style="font-size:1.75rem;font-weight:800;color:#fff;margin:0 0 1.25rem;line-height:1.2;text-shadow:0 2px 8px rgba(0,0,0,.3)">
      mà cần được dẫn dắt đúng cách
    </h2>
    <p style="font-size:1.1rem;color:rgba(255,255,255,.88);line-height:1.65;margin:.75rem 0">
      Lion Camp là chương trình 6 tuần giúp học sinh THCS chuyển năng lượng bùng nổ của tuổi dậy thì thành bản lĩnh, kỹ năng và định hướng tích cực.
    </p>
    <div style="display:flex;flex-wrap:wrap;gap:.75rem;justify-content:center;margin-top:1.75rem">
      <a href="#sp-form1" style="display:inline-block;background:#f9dd0e;color:#26275D;font-weight:700;padding:.85rem 2rem;border-radius:8px;text-decoration:none;font-size:1rem">
        Nhận Brochure chi tiết ngay →
      </a>
      <a href="https://zalo.me/1678310120468101523" target="_blank" rel="noopener" style="display:inline-block;background:transparent;color:#fff;border:2px solid rgba(255,255,255,.6);font-weight:700;padding:.85rem 2rem;border-radius:8px;text-decoration:none;font-size:1rem">
        Trò chuyện 1-1 →
      </a>
    </div>
    <p style="font-size:1rem;color:rgba(255,255,255,.7);margin-top:1.25rem">
      📅 6 tuần · 15/6 – 25/7/2026 · Giới hạn số lượng
    </p>
  </div>

  <!-- BLOCK 2: PAIN -->
  <div slot="pain">
    <p class="sp-pain__eyebrow">🚨 VẤN ĐỀ THỰC TẾ</p>
    <h2>Vấn đề không phải là con thay đổi… mà là không có ai dẫn dắt đúng</h2>
    <p>Ở độ tuổi THCS, nhiều phụ huynh bắt đầu thấy: con dễ cáu gắt hơn, ít chia sẻ với gia đình, bị ảnh hưởng mạnh bởi bạn bè, dành nhiều thời gian cho điện thoại. Cảm giác phổ biến là không còn hiểu con, không biết nên "cấm" hay "cho tự do".</p>
    <p style="margin-top:1rem">Đây không phải giai đoạn "có vấn đề" — mà là giai đoạn năng lượng phát triển mạnh nhất.</p>
    <div style="margin-top:1.5rem;padding:1.25rem 1.5rem;border:2px solid #f9dd0e;background:#fffbf0;border-radius:10px">
      <p style="margin:0;font-size:1rem;line-height:1.7;font-weight:500;color:#1a1a2e">
        <strong>Nếu không được dẫn dắt</strong> → dễ lệch hướng, mất kiểm soát.<br />
        <strong>Nếu được dẫn dắt đúng</strong> → trở thành bản lĩnh, động lực và sự trưởng thành.
      </p>
    </div>
  </div>

  <!-- BLOCK 3 + 4: FEATURES -->
  <div slot="features">
    <p class="sp-features__eyebrow">🌱 GIẢI PHÁP</p>
    <h2>Lion Camp – Nơi Tuổi Dậy Thì Được Dẫn Dắt Đúng Cách</h2>
    <p class="sp-features__sub">Lion Camp không cố "quản lý" học sinh — mà giúp các em hiểu bản thân, quản lý cảm xúc, làm chủ hành vi và định hướng suy nghĩ. Chương trình được thiết kế như một "môi trường trải nghiệm": học qua dự án, thảo luận &amp; phản biện, làm việc nhóm, trải nghiệm thực tế.</p>
    <div style="display:flex;flex-wrap:wrap;gap:.5rem;margin:1.25rem 0">
      <span style="background:#26275D;color:#fff;padding:.35rem .85rem;border-radius:20px;font-size:1rem;font-weight:600">Cảm xúc &amp; xã hội</span>
      <span style="background:#26275D;color:#fff;padding:.35rem .85rem;border-radius:20px;font-size:1rem;font-weight:600">Lãnh đạo bản thân</span>
      <span style="background:#26275D;color:#fff;padding:.35rem .85rem;border-radius:20px;font-size:1rem;font-weight:600">AI &amp; công nghệ</span>
      <span style="background:#26275D;color:#fff;padding:.35rem .85rem;border-radius:20px;font-size:1rem;font-weight:600">Tư duy phản biện</span>
      <span style="background:#26275D;color:#fff;padding:.35rem .85rem;border-radius:20px;font-size:1rem;font-weight:600">Giao tiếp</span>
      <span style="background:#26275D;color:#fff;padding:.35rem .85rem;border-radius:20px;font-size:1rem;font-weight:600">Định hướng</span>
    </div>
    <p style="font-size:1rem;color:#555;margin-bottom:1.5rem">📅 6 tuần liên tục · 👦 Độ tuổi: 11–15 · 📍 TP.HCM · Tây Ninh</p>
    <div class="sp-features__grid">
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🧠</div>
        <h3>Biết kiểm soát cảm xúc</h3>
        <p>Ít phản ứng tiêu cực, biết dừng lại và suy nghĩ trước khi hành động.</p>
        <span class="sp-feat-card__tag">Cảm xúc</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">💬</div>
        <h3>Giao tiếp tốt hơn</h3>
        <p>Biết nói chuyện, biết lắng nghe và biết thể hiện quan điểm của mình.</p>
        <span class="sp-feat-card__tag">Giao tiếp</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🎯</div>
        <h3>Có trách nhiệm hơn</h3>
        <p>Không đổ lỗi — biết chịu trách nhiệm với hành động của mình.</p>
        <span class="sp-feat-card__tag">Trách nhiệm</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">📱</div>
        <h3>Biết dùng công nghệ đúng cách</h3>
        <p>Không bị cuốn vào mạng xã hội, biết chọn lọc thông tin.</p>
        <span class="sp-feat-card__tag">Digital</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🚀</div>
        <h3>Có định hướng rõ hơn</h3>
        <p>Hiểu mình thích gì, bắt đầu nghĩ về tương lai.</p>
        <span class="sp-feat-card__tag">Định hướng</span>
      </div>
    </div>
  </div>

  <!-- BLOCK 5: TEXTIMG (Transformation — 2 styled divs, no image) -->
  <div slot="textimg">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;max-width:1100px;margin:0 auto">
      <div style="background:#fff5f5;border-left:3px solid #26275D;padding:1.5rem;border-radius:8px">
        <h3 style="color:#26275D;font-size:1.1rem;font-weight:800;margin-bottom:1rem">⚠️ Trước Lion Camp</h3>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.65rem">
          <li style="padding-left:1.2rem;position:relative;color:#1a1a2e;line-height:1.55"><span style="position:absolute;left:0;color:#26275D">✗</span> Dễ bị ảnh hưởng bởi bạn bè</li>
          <li style="padding-left:1.2rem;position:relative;color:#1a1a2e;line-height:1.55"><span style="position:absolute;left:0;color:#26275D">✗</span> Khó kiểm soát cảm xúc</li>
          <li style="padding-left:1.2rem;position:relative;color:#1a1a2e;line-height:1.55"><span style="position:absolute;left:0;color:#26275D">✗</span> Phụ thuộc vào điện thoại</li>
          <li style="padding-left:1.2rem;position:relative;color:#1a1a2e;line-height:1.55"><span style="position:absolute;left:0;color:#26275D">✗</span> Thiếu định hướng</li>
        </ul>
      </div>
      <div style="background:#f0fdf4;border-left:3px solid #16a34a;padding:1.5rem;border-radius:8px">
        <h3 style="color:#16a34a;font-size:1.1rem;font-weight:800;margin-bottom:1rem">✅ Sau 6 tuần</h3>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.65rem">
          <li style="padding-left:1.2rem;position:relative;color:#1a1a2e;line-height:1.55"><span style="position:absolute;left:0;color:#16a34a">✓</span> Tự chủ hơn</li>
          <li style="padding-left:1.2rem;position:relative;color:#1a1a2e;line-height:1.55"><span style="position:absolute;left:0;color:#16a34a">✓</span> Biết kiểm soát hành vi</li>
          <li style="padding-left:1.2rem;position:relative;color:#1a1a2e;line-height:1.55"><span style="position:absolute;left:0;color:#16a34a">✓</span> Có suy nghĩ rõ ràng hơn</li>
          <li style="padding-left:1.2rem;position:relative;color:#1a1a2e;line-height:1.55"><span style="position:absolute;left:0;color:#16a34a">✓</span> Có mục tiêu nhỏ cho bản thân</li>
        </ul>
      </div>
    </div>
    <p style="text-align:center;font-style:italic;color:#555;margin-top:1.5rem;font-size:.97rem">
      Không phải thay đổi trong lớp học — mà là thay đổi trong cách con suy nghĩ và hành động
    </p>
  </div>

  <!-- STATS -->
  <div slot="stats">
    <p class="sp-stats__eyebrow">📊 THÔNG TIN CHƯƠNG TRÌNH</p>
    <h2>Lion Camp 2026 THCS — Con Số Bạn Cần Biết</h2>
    <div class="sp-stats__grid">
      <div class="sp-stat">
        <span class="sp-stat__num">6</span>
        <span class="sp-stat__label">Tuần chương trình liên tục — giúp hình thành thói quen và thay đổi hành vi bền vững</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">100%</span>
        <span class="sp-stat__label">Trải nghiệm thực tế — không lý thuyết, không ngồi nghe giảng</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">19.990.000đ</span>
        <span class="sp-stat__label">Học phí ưu đãi (tiết kiệm 10.000.000đ so với giá niêm yết)</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">TP.HCM + Tây Ninh</span>
        <span class="sp-stat__label">2 cơ sở — môi trường an toàn, có định hướng rõ ràng</span>
      </div>
    </div>
  </div>

  <!-- BLOCK 6: QUOTE -->
  <div slot="quote">
    <p class="sp-quote__eyebrow">PHỤ HUYNH &amp; HỌC SINH NÓI GÌ</p>
    <div class="sp-quote__card">
      <div style="display:flex;flex-direction:column;gap:1.5rem">
        <div style="padding-bottom:1.25rem;border-bottom:1px solid rgba(0,0,0,.08)">
          <div class="sp-quote__stars">★★★★★</div>
          <p class="sp-quote__text">"Con tôi trưởng thành hơn rất nhiều, biết suy nghĩ trước khi hành động."</p>
          <div class="sp-quote__name">Phụ huynh học sinh lớp 7</div>
        </div>
        <div style="padding-bottom:1.25rem;border-bottom:1px solid rgba(0,0,0,.08)">
          <div class="sp-quote__stars">★★★★★</div>
          <p class="sp-quote__text">"Con bắt đầu chia sẻ với gia đình nhiều hơn."</p>
          <div class="sp-quote__name">Phụ huynh học sinh lớp 8</div>
        </div>
        <div>
          <div class="sp-quote__stars">★★★★★</div>
          <p class="sp-quote__text">"Không còn dán mắt vào điện thoại như trước."</p>
          <div class="sp-quote__name">Phụ huynh học sinh lớp 6</div>
        </div>
      </div>
    </div>
  </div>

  <!-- BLOCK 7 + 8: PRICING + GUARANTEE -->
  <div slot="pricing">
    <p class="sp-pricing__eyebrow">💡 HỌC PHÍ &amp; GIÁ TRỊ</p>
    <h2>Đầu Tư Đúng Cho Giai Đoạn Nhạy Cảm Nhất</h2>
    <div class="sp-pricing__table">
      <div class="sp-pricing-col sp-pricing-col--regular">
        <p class="sp-pricing-col__label">Giá niêm yết</p>
        <div class="sp-pricing-col__price">29.990.000đ</div>
        <div class="sp-pricing-col__unit">/khóa 6 tuần</div>
        <ul class="sp-pricing-col__features">
          <li>Chương trình phát triển 6 tuần</li>
          <li>Hoạt động dự án &amp; trải nghiệm</li>
          <li>Giáo viên &amp; mentor đồng hành</li>
          <li>Tiếng Anh giao tiếp</li>
          <li>Môi trường an toàn</li>
        </ul>
      </div>
      <div class="sp-pricing-col sp-pricing-col--promo">
        <p class="sp-pricing-col__label">Ưu đãi hiện tại</p>
        <div class="sp-pricing-col__price">19.990.000đ</div>
        <div class="sp-pricing-col__unit">/khóa (tiết kiệm 10tr)</div>
        <ul class="sp-pricing-col__features">
          <li>Toàn bộ chương trình 6 tuần</li>
          <li>Coaching cá nhân</li>
          <li>Báo cáo phát triển học sinh</li>
          <li>Giáo viên &amp; mentor đồng hành</li>
          <li>Tiếng Anh giao tiếp</li>
        </ul>
      </div>
    </div>
    <div style="margin-top:2rem;padding:1.5rem;border:2px solid #f9dd0e;background:#fffbf0;border-radius:12px">
      <h3 style="font-size:1.1rem;font-weight:800;color:#1a1a2e;margin-bottom:.75rem">🛡️ Cam kết rõ ràng cho phụ huynh</h3>
      <p style="margin:0;font-size:1rem;line-height:1.7;color:#1a1a2e">
        Nếu sau 4 tuần bạn không thấy con thay đổi tích cực — bạn có thể dừng chương trình và nhận lại học phí.<br />
        <strong>Không rủi ro · Không áp lực.</strong>
      </p>
    </div>
  </div>

  <!-- BLOCK 9: CTA -->
  <div slot="cta">
    <h2>Tuổi Dậy Thì Chỉ Đến Một Lần</h2>
    <p>Bạn có thể để con tự xoay xở. Hoặc đặt con vào một môi trường giúp con trưởng thành đúng cách — có bản lĩnh, có định hướng và có khả năng tự chủ.</p>
    <a href="#sp-form1" class="sp-cta-btn">Nhận ngay Brochure chương trình →</a>
    <p style="font-size:1rem;color:rgba(255,255,255,.65);margin-top:.85rem">Số lượng giới hạn mỗi nhóm · Không spam · Không ràng buộc</p>
  </div>

  <!-- FORM 1 -->
  <div slot="form1">
    <p class="sp-form-block__eyebrow">ĐĂNG KÝ NHẬN BROCHURE</p>
    <h2>Hiểu Rõ Chương Trình Trước Khi Quyết Định</h2>
    <p>Điền email để nhận Brochure — nội dung 6 tuần, phương pháp và cách chương trình đồng hành cùng học sinh THCS.</p>
    <LeadFormTwoStepEmailFirst
      formId="lion-camp-thcs-form1"
      funnelCode="lion-camp-2026-thcs"
      schoolLevel="thcs"
      submitText="Nhận Brochure ngay"
    />
  </div>

  <!-- BLOCK 10: FAQ -->
  <div slot="faq">
    <p class="sp-faq__eyebrow">CÂU HỎI THƯỜNG GẶP</p>
    <h2>Phụ Huynh Hỏi Nhiều Nhất</h2>

    <details class="sp-faq-item">
      <summary>Con tôi đang "khó bảo", có phù hợp không?</summary>
      <div class="sp-faq-answer">Đây chính là nhóm phù hợp nhất. Lion Camp được thiết kế đặc biệt cho những bạn đang có nhiều năng lượng và cần môi trường dẫn dắt đúng.</div>
    </details>

    <details class="sp-faq-item">
      <summary>Có phải học nhiều không?</summary>
      <div class="sp-faq-answer">Không. Trọng tâm là trải nghiệm và thay đổi hành vi — không phải kiến thức sách vở.</div>
    </details>

    <details class="sp-faq-item">
      <summary>Con có bị ép không?</summary>
      <div class="sp-faq-answer">Không. Chương trình dẫn dắt, không áp đặt. Học sinh được trao quyền tự chọn và tự chịu trách nhiệm.</div>
    </details>

    <details class="sp-faq-item">
      <summary>Làm sao biết con thay đổi?</summary>
      <div class="sp-faq-answer">Qua cách con giao tiếp, phản ứng và tự chủ mỗi ngày. Phụ huynh nhận báo cáo hàng tuần.</div>
    </details>
  </div>

  <!-- FORM 2 -->
  <div slot="form2">
    <p class="sp-form-block__eyebrow">GHI DANH NGAY</p>
    <h2>Giữ Chỗ Cho Con — Số Lượng Giới Hạn</h2>
    <p>Để lại thông tin — đội ngũ Việt Anh sẽ liên hệ tư vấn và xác nhận suất đăng ký.</p>
    <LeadFormTwoStepEmailFirst
      formId="lion-camp-thcs-form2"
      funnelCode="lion-camp-2026-thcs-2"
      schoolLevel="thcs"
      submitText="Ghi danh ngay"
    />
  </div>

</SalesPageLayout>
