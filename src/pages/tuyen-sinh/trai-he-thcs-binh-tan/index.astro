<script define:vars={{ SOURCE, FUNNEL_CODE, REDIRECT }}>
(function(){
  var SRC = SOURCE, FC = FUNNEL_CODE, REDIR = REDIRECT;

  function getChecked(groupId){
    var vals = [];
    document.querySelectorAll('#' + groupId + ' input[type=checkbox]:checked').forEach(function(el){
      vals.push(el.value);
    });
    return vals.join(',');
  }

  function doSubmit(name, phone, grade, interests, formId){
    var el = document.getElementById(formId);
    if(el){ el.style.opacity='.5'; el.style.pointerEvents='none'; }
    var payload = JSON.stringify({
      fullName: name, phone: phone, childGrade: grade,
      interests: interests, source: SRC, funnel_code: FC,
      school_level: 'thcs', page_url: location.href,
      submitted_at: new Date().toISOString()
    });
    localStorage.setItem('lp_' + SRC, '1');
    var done = false;
    var go = function(){ if(!done){ done=true; window.location.href = REDIR; } };
    fetch('https://truongvietanh.com/api/lead',{
      method:'POST', headers:{'Content-Type':'application/json'},
      body: payload, mode:'cors', keepalive:true
    }).then(function(r){ if(!r.ok) console.error('[lead] '+r.status); })
    .catch(function(){
      if(navigator.sendBeacon)
        try{ navigator.sendBeacon('https://truongvietanh.com/api/lead',
          new Blob([payload],{type:'application/json'})); }catch(ex){}
    }).finally(go);
    setTimeout(go, 3000);
    if(window.dataLayer) window.dataLayer.push({ event:'lead_submit', source: SRC, funnel_code: FC });
  }

  function validatePhone(val){
    return val.replace(/[^0-9]/g,'').length >= 9;
  }

  // Desktop form handlers
  window.dsNext = function(){
    var phoneEl = document.getElementById('dp-phone');
    var phone = phoneEl ? phoneEl.value.trim() : '';
    if(!validatePhone(phone)){ if(phoneEl){ phoneEl.classList.add('err'); phoneEl.focus(); } return; }
    phoneEl.classList.remove('err');
    document.getElementById('step1d').style.display='none';
    document.getElementById('step2d').style.display='block';
    var d1=document.getElementById('dot1d'), d2=document.getElementById('dot2d'), sl=document.getElementById('slabeld');
    if(d1){d1.classList.remove('active');d1.classList.add('done');}
    if(d2) d2.classList.add('active');
    if(sl) sl.textContent='Tên & Quan tâm';
    var n=document.getElementById('dp-name'); if(n) n.focus();
  };
  window.dsBack = function(){
    document.getElementById('step2d').style.display='none';
    document.getElementById('step1d').style.display='block';
    var d1=document.getElementById('dot1d'), d2=document.getElementById('dot2d'), sl=document.getElementById('slabeld');
    if(d2) d2.classList.remove('active');
    if(d1){d1.classList.remove('done');d1.classList.add('active');}
    if(sl) sl.textContent='Tên & Quan tâm';
  };
  window.dsSubmit = function(){
    var nameEl = document.getElementById('dp-name');
    var name = nameEl ? nameEl.value.trim() : '';
    if(!name){ if(nameEl){ nameEl.classList.add('err'); nameEl.focus(); } return; }
    nameEl.classList.remove('err');
    var phone = document.getElementById('dp-phone').value.trim();
    var grade = document.getElementById('dp-grade').value;
    var interests = getChecked('dp-interests');
    doSubmit(name, phone, grade, interests, 'formAreaDesktop');
  };

  // Mobile form handlers
  window.msNext = function(){
    var phoneEl = document.getElementById('mp-phone');
    var phone = phoneEl ? phoneEl.value.trim() : '';
    if(!validatePhone(phone)){ if(phoneEl){ phoneEl.classList.add('err'); phoneEl.focus(); } return; }
    phoneEl.classList.remove('err');
    document.getElementById('step1m').style.display='none';
    document.getElementById('step2m').style.display='block';
    var d1=document.getElementById('dot1m'), d2=document.getElementById('dot2m'), sl=document.getElementById('slabelm');
    if(d1){d1.classList.remove('active');d1.classList.add('done');}
    if(d2) d2.classList.add('active');
    if(sl) sl.textContent='Tên & Quan tâm';
    var n=document.getElementById('mp-name'); if(n) n.focus();
  };
  window.msBack = function(){
    document.getElementById('step2m').style.display='none';
    document.getElementById('step1m').style.display='block';
    var d1=document.getElementById('dot1m'), d2=document.getElementById('dot2m'), sl=document.getElementById('slabelm');
    if(d2) d2.classList.remove('active');
    if(d1){d1.classList.remove('done');d1.classList.add('active');}
    if(sl) sl.textContent='Tên & Quan tâm';
  };
  window.msSubmit = function(){
    var nameEl = document.getElementById('mp-name');
    var name = nameEl ? nameEl.value.trim() : '';
    if(!name){ if(nameEl){ nameEl.classList.add('err'); nameEl.focus(); } return; }
    nameEl.classList.remove('err');
    var phone = document.getElementById('mp-phone').value.trim();
    var grade = document.getElementById('mp-grade').value;
    var interests = getChecked('mp-interests');
    doSubmit(name, phone, grade, interests, 'formAreaMobile');
  };

  // Enter key on phone → next
  ['dp-phone','mp-phone'].forEach(function(id){
    var el=document.getElementById(id);
    if(el) el.addEventListener('keydown',function(e){
      if(e.key==='Enter'){ e.preventDefault();
        id.startsWith('dp') ? dsNext() : msNext(); }
    });
  });
  // Enter key on name → submit
  ['dp-name','mp-name'].forEach(function(id){
    var el=document.getElementById(id);
    if(el) el.addEventListener('keydown',function(e){
      if(e.key==='Enter'){ e.preventDefault();
        id.startsWith('dp') ? dsSubmit() : msSubmit(); }
    });
  });

  // FAQ toggle
  document.querySelectorAll('.faq-q').forEach(function(btn){
    btn.addEventListener('click', function(){
      var item = btn.closest('.faq-item');
      var isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item.open').forEach(function(i){ i.classList.remove('open'); });
      if(!isOpen) item.classList.add('open');
    });
  });

  // GTM phone click tracking
  document.querySelectorAll('a[href^="tel:"]').forEach(function(a){
    a.addEventListener('click', function(){
      if(window.dataLayer) window.dataLayer.push({ event:'phone_click', source: SRC });
    });
  });
  // GTM zalo click tracking
  document.querySelectorAll('a[href*="zalo.me"]').forEach(function(a){
    a.addEventListener('click', function(){
      if(window.dataLayer) window.dataLayer.push({ event:'zalo_click', source: SRC });
    });
  });

  // GTM thank you view
  if(window.dataLayer) window.dataLayer.push({ event:'landing_view', source: SRC, funnel_code: FC });
})();
</script>
</body>
</html>
