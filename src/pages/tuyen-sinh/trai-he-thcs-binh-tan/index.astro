<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KPL2NSR9" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<!-- HEADER -->
<header class="hdr">
  <div class="hdr-inner">
    <div class="hdr-logo">
      <a href="https://truongvietanh.com" aria-label="Trường Việt Anh">
        <img src="/logo-vietanh.webp" alt="Trường Việt Anh" width="240" height="80" loading="eager" />
      </a>
    </div>
    <div class="hdr-micro">
      <strong>📍 Cơ sở Bình Tân · Khai giảng 15/06/2026</strong>
      <span>Dành cho học sinh THCS 11–14 tuổi</span>
    </div>
    <div class="hdr-right">
      <a href={ZALO_URL} target="_blank" rel="noopener" class="hdr-zalo">💬 Zalo tư vấn</a>
      <a href={`tel:${HOTLINE_TEL}`}>📞 {HOTLINE}</a>
    </div>
  </div>
</header>

<!-- HERO -->
<section class="hero">
  <div class="hero-grid">
    <!-- Content -->
    <div>
      <div class="badge-pill"><span class="badge-dot"></span> 🔔 Đang nhận đăng ký · Khai giảng 15/06/2026</div>
      <h1 class="h1">Trại Hè THCS Việt Anh Bình Tân 2026</h1>
      <p class="h2-tag">6 tuần giúp con giảm game, tăng giao tiếp &amp; rèn nề nếp tích cực</p>
      <p class="hero-intro d-only">
        Mùa hè của học sinh THCS rất dễ trôi qua trong điện thoại, game và lịch sinh hoạt thiếu nề nếp. Ở tuổi 11–14, con cần môi trường đúng độ tuổi: có bạn bè, có hoạt động, có người hướng dẫn, có mục tiêu mỗi tuần và có sự cân bằng giữa học, vận động, giao tiếp và kỹ năng.
      </p>
      <p class="hero-intro m-only" style="font-size:15px">
        Dành cho học sinh THCS 11–14 tuổi tại Việt Anh Bình Tân. Giúp con giảm game, tăng giao tiếp, rèn nề nếp, tiếng Anh + AI và teamwork.
      </p>

      <div class="meta-chips">
        <span class="meta-chip">📅 Khai giảng: 15/06/2026</span>
        <span class="meta-chip">⏱️ Thời lượng: 6 tuần</span>
        <span class="meta-chip">🏫 Việt Anh Bình Tân</span>
        <span class="meta-chip">👦 11–14 tuổi / THCS</span>
      </div>

      <ul class="bullets">
        <li>Giúp con giảm thời gian game, điện thoại và màn hình thụ động</li>
        <li>Tăng giao tiếp thật qua hoạt động nhóm, vận động và teamwork</li>
        <li>Rèn nề nếp tích cực, kỹ năng tự học và sự chủ động</li>
        <li>Học tiếng Anh qua hoạt động/dự án nhẹ nhàng, phù hợp lứa tuổi THCS</li>
        <li>Làm quen AI an toàn, đúng cách và có định hướng</li>
        <li>Ba mẹ được tư vấn lộ trình hè theo lớp, tính cách và mục tiêu của con</li>
      </ul>

      <div class="trust-micro d-only">
        <span>🔒 Bảo mật thông tin</span>
        <span>📞 Phản hồi trong ngày</span>
        <span>💯 Tư vấn miễn phí</span>
      </div>

      <div class="hero-cta-m">
        <a href="#form" class="btn-orange-outline" style="width:100%;justify-content:center;font-size:14px">
          NHẬN LỊCH HÈ 6 TUẦN ↓
        </a>
        <div style="display:flex;gap:10px;margin-top:10px">
          <a href={`tel:${HOTLINE_TEL}`}
            style="flex:1;display:flex;align-items:center;justify-content:center;gap:6px;background:#fff;border:1.5px solid var(--border);color:var(--navy);padding:11px;border-radius:8px;font-weight:700;font-size:13.5px;font-family:'Montserrat',sans-serif">
            📞 Gọi
          </a>
          <a href={ZALO_URL} target="_blank" rel="noopener"
            style="flex:1;display:flex;align-items:center;justify-content:center;gap:6px;background:var(--navy);color:#fff;padding:11px;border-radius:8px;font-weight:700;font-size:13.5px;font-family:'Montserrat',sans-serif">
            💬 Zalo
          </a>
        </div>
        <p style="font-size:11.5px;color:var(--text-sub);text-align:center;margin-top:8px">
          🔒 Bảo mật · 📞 Phản hồi trong ngày · 💯 Tư vấn miễn phí
        </p>
      </div>
    </div>

    <!-- FORM CARD (desktop) -->
    <div class="hero-form-col" id="formAreaDesktop">
      <div class="fcard">
        <div class="fcard-top">⏰ Khai giảng 15/06 · Số chỗ có giới hạn</div>
        <div class="fcard-body">
          <h3 class="fcard-title">Nhận lịch hè 6 tuần + tư vấn lộ trình</h3>
          <p class="fcard-sub">Ba mẹ để lại thông tin để nhận lịch học, học phí và gợi ý lộ trình phù hợp cho con.</p>

          <div class="step-ind">
            <div class="sdot active" id="dot1d">1</div>
            <div class="sline"></div>
            <div class="sdot" id="dot2d">2</div>
            <span class="slabel" id="slabeld">Tên &amp; Quan tâm</span>
          </div>

          <!-- Step 1: Phone + Grade -->
          <div id="step1d">
            <label class="flabel" for="dp-phone">Số điện thoại Ba/Mẹ <span class="req">*</span></label>
            <input class="finput" type="tel" id="dp-phone" placeholder="0912 345 678" autocomplete="tel" inputmode="numeric" />
            <label class="flabel" for="dp-grade">Con đang học lớp / độ tuổi <span class="req">*</span></label>
            <select class="finput" id="dp-grade" style="cursor:pointer">
              <option value="">-- Chọn lớp/tuổi --</option>
              <option value="lop-5-len-6">Lớp 5 lên lớp 6</option>
              <option value="lop-6">Lớp 6</option>
              <option value="lop-7">Lớp 7</option>
              <option value="lop-8">Lớp 8</option>
              <option value="lop-9">Lớp 9</option>
              <option value="11-tuoi">11 tuổi</option>
              <option value="12-tuoi">12 tuổi</option>
              <option value="13-tuoi">13 tuổi</option>
              <option value="14-tuoi">14 tuổi</option>
              <option value="chua-chac">Chưa chắc, cần tư vấn</option>
            </select>
            <button type="button" class="btn-cta" onclick="dsNext()">NHẬN LỊCH HÈ 6 TUẦN →</button>
          </div>

          <!-- Step 2: Name + Interests -->
          <div id="step2d" style="display:none">
            <label class="flabel" for="dp-name">Họ tên Ba/Mẹ <span class="req">*</span></label>
            <input class="finput" type="text" id="dp-name" placeholder="Nguyễn Văn A" autocomplete="name" />
            <label class="flabel">Ba mẹ quan tâm nhất điều gì?</label>
            <div class="chk-group" id="dp-interests">
              <label class="chk-opt"><input type="checkbox" value="game-dien-thoai" /> Con chơi game/điện thoại nhiều</label>
              <label class="chk-opt"><input type="checkbox" value="it-noi-ngan-tiep" /> Con ít nói, ngại giao tiếp</label>
              <label class="chk-opt"><input type="checkbox" value="kho-bao" /> Con khó bảo, ít nghe lời</label>
              <label class="chk-opt"><input type="checkbox" value="ne-nep" /> Con cần vào nề nếp trước năm học mới</label>
              <label class="chk-opt"><input type="checkbox" value="tu-hoc" /> Con cần rèn kỹ năng tự học</label>
              <label class="chk-opt"><input type="checkbox" value="tieng-anh-ai" /> Tiếng Anh + AI cho THCS</label>
              <label class="chk-opt"><input type="checkbox" value="teamwork" /> Teamwork &amp; kỹ năng sống</label>
              <label class="chk-opt"><input type="checkbox" value="hoc-phi" /> Học phí &amp; ưu đãi</label>
            </div>
            <button type="button" class="btn-cta" onclick="dsSubmit()">GỬI THÔNG TIN ĐỂ ĐƯỢC TƯ VẤN</button>
            <button type="button" class="btn-back" onclick="dsBack()">← Quay lại</button>
          </div>

          <div class="fcard-foot">
            <span>🔒 Bảo mật</span>
            <span>📞 Phản hồi trong ngày</span>
            <span>🎁 Tư vấn miễn phí</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- PAIN SECTION -->
<section class="sec sec-alt" id="noi-lo">
  <div class="wrap">
    <div class="sec-head">
      <span class="sec-tag">Nỗi lo của phụ huynh</span>
      <h2 class="sec-h">Ba mẹ đang lo điều gì khi con THCS nghỉ hè?</h2>
      <p class="sec-sub d-only">Tuổi THCS là giai đoạn con thay đổi nhanh: dễ ít chia sẻ hơn, thích độc lập hơn, dễ bị cuốn vào game/điện thoại và khó quay lại nề nếp nếu nghỉ hè không có định hướng.</p>
    </div>
    <div class="pain-grid">
      <div class="pain-card">
        <div class="pain-icon">🎮</div>
        <div>
          <span class="pain-title">Con chơi game và dùng điện thoại quá nhiều</span>
          <div class="pain-desc">Mùa hè khiến nhiều học sinh THCS dễ bị cuốn vào game, YouTube, mạng xã hội và điện thoại.</div>
          <div class="pain-detail">Trại hè giúp con thay thời gian màn hình bằng hoạt động thật: vận động, teamwork, giao tiếp, tiếng Anh, AI an toàn và các nhiệm vụ nhỏ theo tuần.</div>
        </div>
      </div>
      <div class="pain-card">
        <div class="pain-icon">😶</div>
        <div>
          <span class="pain-title">Con ít nói, ngại giao tiếp</span>
          <div class="pain-desc">Nhiều con ở tuổi 11–14 ít chia sẻ với ba mẹ hơn, giao tiếp nhiều trên điện thoại nhưng lại ngại giao tiếp ngoài đời.</div>
          <div class="pain-detail">Chương trình tạo môi trường nhóm tích cực để con tương tác với bạn bè, tham gia hoạt động, trình bày ý tưởng và tự tin hơn từng tuần.</div>
        </div>
      </div>
      <div class="pain-card">
        <div class="pain-icon">🌪️</div>
        <div>
          <span class="pain-title">Con đang trong giai đoạn "bão dậy thì"</span>
          <div class="pain-desc">Tuổi THCS dễ thay đổi tâm lý, phản ứng mạnh hơn, khó bảo hơn hoặc ít nghe lời hơn.</div>
          <div class="pain-detail">Thay vì chỉ nhắc nhở ở nhà, ba mẹ có thể cho con một môi trường đúng độ tuổi để con được kết nối, vận động, giao tiếp, có mục tiêu và được định hướng tích cực.</div>
        </div>
      </div>
      <div class="pain-card">
        <div class="pain-icon">📚</div>
        <div>
          <span class="pain-title">Con thiếu nề nếp và kỹ năng tự học</span>
          <div class="pain-desc">Sau một mùa hè ngủ muộn, chơi game nhiều và thiếu lịch sinh hoạt, con dễ "rơi nhịp" khi quay lại trường.</div>
          <div class="pain-detail">Trại hè giúp con xây lại nhịp sinh hoạt tích cực, rèn kỹ năng tự học, quản lý nhiệm vụ nhỏ và sự chủ động trước năm học mới.</div>
        </div>
      </div>
      <div class="pain-card">
        <div class="pain-icon">🤖</div>
        <div>
          <span class="pain-title">Con cần học công nghệ đúng cách</span>
          <div class="pain-desc">AI đang trở thành kỹ năng mới, nhưng học sinh THCS cần được tiếp cận an toàn và có hướng dẫn.</div>
          <div class="pain-detail">Chương trình giúp con làm quen AI qua hoạt động phù hợp, biết đặt câu hỏi, trình bày ý tưởng và sử dụng công nghệ có mục tiêu.</div>
        </div>
      </div>
      <div class="pain-card" style="background:var(--orange-soft);border-color:var(--orange)">
        <div class="pain-icon">🤝</div>
        <div>
          <span class="pain-title" style="color:var(--orange-dk)">Trại hè THCS Việt Anh giúp con</span>
          <div class="pain-desc">Rèn teamwork, giao tiếp, tự tin, nề nếp, tiếng Anh + AI và sẵn sàng hơn trước năm học mới sau 6 tuần.</div>
          <div style="margin-top:10px">
            <a href="#form" class="btn-orange-outline" style="font-size:13px;padding:10px 18px;display:inline-flex">
              TƯ VẤN LỘ TRÌNH HÈ CHO CON
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- OUTCOMES SECTION -->
<section class="sec sec-light">
  <div class="wrap">
    <div class="sec-head">
      <span class="sec-tag">Kết quả sau 6 tuần</span>
      <h2 class="sec-h">Sau 6 tuần, con có thể nhận được gì?</h2>
    </div>
    <div class="out-grid">
      <div class="out-card">
        <div class="out-num">01</div>
        <div class="out-title">🎮 Giảm thời gian game/điện thoại thụ động</div>
        <div class="out-body">Con có lịch hè tích cực hơn với hoạt động nhóm, vận động, giao tiếp, dự án nhỏ, tiếng Anh và AI an toàn.</div>
      </div>
      <div class="out-card">
        <div class="out-num">02</div>
        <div class="out-title">💬 Giao tiếp và tự tin hơn</div>
        <div class="out-body">Con được tham gia teamwork, thảo luận, trình bày ý tưởng và hoạt động nhóm trong môi trường phù hợp tuổi THCS.</div>
      </div>
      <div class="out-card">
        <div class="out-num">03</div>
        <div class="out-title">📋 Rèn nề nếp và kỹ năng tự học</div>
        <div class="out-body">Con luyện thói quen tham gia hoạt động đều đặn, hoàn thành nhiệm vụ nhỏ, quản lý thời gian và chủ động hơn trong học tập.</div>
      </div>
      <div class="out-card">
        <div class="out-num">04</div>
        <div class="out-title">🤖 Học tiếng Anh + AI theo hướng ứng dụng</div>
        <div class="out-body">Con học tiếng Anh qua hoạt động/dự án, làm quen AI đúng cách, biết đặt câu hỏi, tìm ý tưởng và trình bày nội dung.</div>
      </div>
      <div class="out-card">
        <div class="out-num">05</div>
        <div class="out-title">🤝 Teamwork và kỹ năng sống tốt hơn</div>
        <div class="out-body">Con học cách hợp tác, lắng nghe, chia sẻ vai trò, xử lý tình huống và phối hợp với bạn bè trong hoạt động nhóm.</div>
      </div>
      <div class="out-card">
        <div class="out-num">06</div>
        <div class="out-title">☀️ Sẵn sàng hơn trước năm học mới</div>
        <div class="out-body">Sau 6 tuần, con có nhịp sinh hoạt tốt hơn, giao tiếp nhiều hơn, giảm màn hình thụ động và có tinh thần tích cực hơn để quay lại trường.</div>
      </div>
    </div>
    <div class="sec-cta-wrap">
      <a href="#form" class="btn-orange-outline">NHẬN TƯ VẤN 6 TUẦN HÈ CHO CON</a>
    </div>
  </div>
</section>

<!-- WEEKS SECTION -->
<section class="sec sec-alt">
  <div class="wrap">
    <div class="sec-head">
      <span class="sec-tag">Chương trình 6 tuần</span>
      <h2 class="sec-h">Lịch hè 6 tuần có gì?</h2>
      <p class="sec-sub">Ba mẹ để lại thông tin để nhận lịch học chi tiết. Chương trình được thiết kế theo hướng cân bằng giữa vận động, teamwork, tiếng Anh + AI, kỹ năng tự học, giao tiếp và nề nếp tích cực.</p>
    </div>
    <div class="weeks-grid">
      <div class="week-card">
        <div class="week-num">TUẦN 1</div>
        <div class="week-title">Làm quen, thiết lập nề nếp, giao tiếp nhóm</div>
        <div class="week-result">✅ Con bắt nhịp môi trường mới và có mục tiêu đầu tiên</div>
      </div>
      <div class="week-card">
        <div class="week-num">TUẦN 2</div>
        <div class="week-title">Teamwork, vận động, kỹ năng giao tiếp</div>
        <div class="week-result">✅ Con tương tác nhiều hơn và biết phối hợp với bạn bè</div>
      </div>
      <div class="week-card">
        <div class="week-num">TUẦN 3</div>
        <div class="week-title">Tiếng Anh qua hoạt động/dự án nhỏ</div>
        <div class="week-result">✅ Con dùng tiếng Anh để trình bày ý tưởng đơn giản</div>
      </div>
      <div class="week-card">
        <div class="week-num">TUẦN 4</div>
        <div class="week-title">AI đúng cách cho học sinh THCS</div>
        <div class="week-result">✅ Con biết đặt câu hỏi, tìm ý tưởng và dùng công nghệ có mục tiêu</div>
      </div>
      <div class="week-card">
        <div class="week-num">TUẦN 5</div>
        <div class="week-title">Kỹ năng tự học, kỷ luật tích cực, quản lý thời gian</div>
        <div class="week-result">✅ Con rèn sự chủ động và hoàn thành nhiệm vụ theo nhóm/cá nhân</div>
      </div>
      <div class="week-card" style="border-color:var(--orange);background:var(--orange-soft)">
        <div class="week-num" style="background:var(--orange-dk)">TUẦN 6</div>
        <div class="week-title">Dự án tổng kết và trình bày</div>
        <div class="week-result">🏆 Con có cơ hội trình bày sản phẩm/ý tưởng và nhìn lại sự tiến bộ</div>
      </div>
    </div>
    <div class="sec-cta-wrap">
      <a href="#form" class="btn-orange-outline">NHẬN LỊCH HÈ 6 TUẦN</a>
    </div>
  </div>
</section>

<!-- TARGET GROUPS SECTION -->
<section class="sec sec-light">
  <div class="wrap">
    <div class="sec-head">
      <span class="sec-tag">Phù hợp với nhóm nào?</span>
      <h2 class="sec-h">Chương trình phù hợp với nhóm học sinh nào?</h2>
    </div>
    <div class="age-grid" style="grid-template-columns:repeat(3,1fr)">
      <div class="age-card">
        <div class="age-pill">11–12 tuổi</div>
        <div class="age-label">Lớp 6–7</div>
        <div class="age-desc">Phù hợp với học sinh mới bước vào THCS, cần làm quen nề nếp mới, tăng giao tiếp, tự tin hơn và có môi trường hè tích cực.</div>
      </div>
      <div class="age-card hl">
        <div class="age-pill">13–14 tuổi</div>
        <div class="age-label">Lớp 8–9</div>
        <div class="age-desc">Phù hợp với học sinh cần rèn tự học, teamwork, trình bày, giảm thời gian màn hình và chuẩn bị tốt hơn cho năm học mới.</div>
      </div>
      <div class="age-card">
