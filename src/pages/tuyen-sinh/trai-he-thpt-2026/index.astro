---
import SalesPageLayout from '../../../layouts/SalesPageLayout.astro';
import LeadFormTwoStepEmailFirst from '../../../components/LeadFormTwoStepEmailFirst.astro';
---

<SalesPageLayout
  title="Lion Camp 2026 THPT — 6 Tuần Làm Rõ Bản Thân, Chọn Đúng Hướng Tương Lai"
  description="Lion Camp 2026: chương trình 6 tuần giúp học sinh THPT hiểu bản thân, định hướng nghề nghiệp và bắt đầu xây lộ trình tương lai. Học bổng 10tr. Giới hạn số lượng."
  canonical="https://truongvietanh.com/tuyen-sinh/trai-he-thpt-2026"
  ogImage="https://media.truongvietanh.com/images/thuyet-trinh-04.webp"
  heroImage="https://media.truongvietanh.com/images/thuyet-trinh-04.webp"
  programCode="trai-he-thpt"
  schoolLevel="thpt"
>

  <!-- BLOCK 1: HERO -->
  <div slot="hero">
    <span class="sp-hero__badge">🦁 Lion Camp 2026 – Trại hè định hướng tương lai</span>
    <h1 style="font-size:2.5rem;font-weight:900;color:#e53e3e;margin:0 0 .5rem;line-height:1.15;text-shadow:0 2px 8px rgba(0,0,0,.3)">
      THPT không thiếu người học giỏi
    </h1>
    <p style="font-size:1.35rem;font-weight:600;color:#fff;margin:0 0 1rem;line-height:1.3">
      chỉ thiếu người biết mình muốn gì
    </p>
    <p style="font-size:1.05rem;color:rgba(255,255,255,.88);line-height:1.65;margin:.75rem 0">
      Lion Camp là chương trình 6 tuần giúp học sinh THPT làm rõ bản thân, xây dựng năng lực và bắt đầu định hình con đường tương lai của chính mình.
    </p>
    <div style="display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.5rem;align-items:center">
      <a href="#sp-form1" style="display:inline-block;background:#ffff00;color:#000080;font-weight:700;padding:.85rem 2rem;border-radius:8px;text-decoration:none;font-size:1rem">
        Xem chương trình &amp; Ghi danh →
      </a>
      <a href="https://zalo.me/1678310120468101523" style="display:inline-block;background:transparent;color:#fff;font-weight:600;padding:.85rem 2rem;border-radius:8px;text-decoration:none;font-size:1rem;border:2px solid rgba(255,255,255,.6)">
        Nhận tư vấn định hướng →
      </a>
    </div>
    <p style="margin-top:1rem;font-size:1rem;color:rgba(255,255,255,.75)">
      📅 6 tuần · Giới hạn số lượng · Có phân nhóm theo định hướng
    </p>
  </div>

  <!-- BLOCK 2: PAIN -->
  <div slot="pain">
    <p class="sp-pain__eyebrow">🧠 VẤN ĐỀ THỰC TẾ</p>
    <h2>Học nhiều không đồng nghĩa với đi đúng hướng</h2>
    <p>Rất nhiều học sinh THPT học tốt nhưng không biết mình thích gì, chọn ngành theo cảm tính hoặc số đông, có mục tiêu… nhưng không rõ lộ trình. Đến lớp 12, áp lực thi cử tăng cao nhưng định hướng vẫn mơ hồ.</p>
    <p>Điều đáng lo không phải là "Thi được bao nhiêu điểm" — mà là "Thi xong rồi sẽ đi đâu?"</p>
    <div style="border-left:4px solid #ffff00;background:#fffbf0;padding:1rem 1.25rem;border-radius:0 8px 8px 0;margin-top:1.25rem">
      <p style="margin:0;font-size:1rem;line-height:1.7;color:#000080">
        "Không có định hướng → dễ chọn sai → mất 3–5 năm để sửa"
      </p>
    </div>
  </div>

  <!-- BLOCK 3 + 4: FEATURES (Solution intro + tags + 5 benefit cards) -->
  <div slot="features">
    <p class="sp-features__eyebrow">🌱 GIẢI PHÁP</p>
    <h2>Lion Camp – Nơi Học Sinh Bắt Đầu Hiểu Mình Và Chọn Hướng</h2>
    <p class="sp-features__sub">Lion Camp không phải trại hè học thêm hay chương trình lý thuyết. Đây là môi trường giúp học sinh hiểu bản thân, xác định mục tiêu và bắt đầu xây lộ trình thật — thông qua trải nghiệm thực tế, dự án cá nhân, coaching &amp; định hướng, làm việc nhóm &amp; phản biện.</p>

    <div style="display:flex;flex-wrap:wrap;gap:.5rem;margin:1rem 0 1.25rem">
      <span style="background:#ffff00;color:#000080;font-weight:700;font-size:1rem;padding:.3rem .8rem;border-radius:20px">Định hướng nghề nghiệp</span>
      <span style="background:#ffff00;color:#000080;font-weight:700;font-size:1rem;padding:.3rem .8rem;border-radius:20px">Tư duy phản biện</span>
      <span style="background:#ffff00;color:#000080;font-weight:700;font-size:1rem;padding:.3rem .8rem;border-radius:20px">AI &amp; công nghệ</span>
      <span style="background:#ffff00;color:#000080;font-weight:700;font-size:1rem;padding:.3rem .8rem;border-radius:20px">Giao tiếp</span>
      <span style="background:#ffff00;color:#000080;font-weight:700;font-size:1rem;padding:.3rem .8rem;border-radius:20px">Lãnh đạo bản thân</span>
      <span style="background:#ffff00;color:#000080;font-weight:700;font-size:1rem;padding:.3rem .8rem;border-radius:20px">Tiếng Anh</span>
    </div>

    <p style="font-size:1rem;color:#555;margin-bottom:1.5rem">
      📅 6 tuần · 👦 Độ tuổi: 15–18 · 📍 TP.HCM
    </p>

    <div class="sp-features__grid">
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🧭</div>
        <h3>Hiểu rõ bản thân hơn</h3>
        <p>Biết điểm mạnh – điểm yếu, biết mình phù hợp với điều gì.</p>
        <span class="sp-feat-card__tag">Self-awareness</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🎯</div>
        <h3>Có định hướng rõ hơn</h3>
        <p>Không còn chọn ngành theo cảm tính — bắt đầu có lộ trình cụ thể.</p>
        <span class="sp-feat-card__tag">Định hướng</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🧠</div>
        <h3>Tư duy trưởng thành hơn</h3>
        <p>Biết phân tích, biết ra quyết định và chịu trách nhiệm với lựa chọn.</p>
        <span class="sp-feat-card__tag">Tư duy</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">💬</div>
        <h3>Giao tiếp &amp; trình bày tốt hơn</h3>
        <p>Tự tin nói, biết bảo vệ quan điểm trước đám đông.</p>
        <span class="sp-feat-card__tag">Giao tiếp</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🌐</div>
        <h3>Biết tận dụng công nghệ</h3>
        <p>Dùng AI để học &amp; phát triển — không bị lệ thuộc.</p>
        <span class="sp-feat-card__tag">AI &amp; Digital</span>
      </div>
    </div>
  </div>

  <!-- BLOCK 5: TEXTIMG (Transformation before/after — no image, 2 styled divs) -->
  <div slot="textimg">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;max-width:1100px;margin:0 auto">
      <div style="background:#fff5f5;padding:1.5rem;border-radius:10px;border-left:3px solid #000080">
        <h3 style="margin:0 0 1rem;font-size:1.15rem;color:#000080">⚠️ Trước Lion Camp</h3>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.6rem">
          <li style="display:flex;align-items:flex-start;gap:.5rem;color:#555"><span style="color:#000080;font-weight:700">✗</span> Mơ hồ về tương lai</li>
          <li style="display:flex;align-items:flex-start;gap:.5rem;color:#555"><span style="color:#000080;font-weight:700">✗</span> Chọn ngành theo cảm tính</li>
          <li style="display:flex;align-items:flex-start;gap:.5rem;color:#555"><span style="color:#000080;font-weight:700">✗</span> Thiếu động lực học</li>
          <li style="display:flex;align-items:flex-start;gap:.5rem;color:#555"><span style="color:#000080;font-weight:700">✗</span> Dễ bị áp lực</li>
        </ul>
      </div>
      <div style="background:#f0fdf4;padding:1.5rem;border-radius:10px;border-left:3px solid #16a34a">
        <h3 style="margin:0 0 1rem;font-size:1.15rem;color:#16a34a">✅ Sau 6 tuần</h3>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.6rem">
          <li style="display:flex;align-items:flex-start;gap:.5rem;color:#555"><span style="color:#16a34a;font-weight:700">✓</span> Hiểu mình rõ hơn</li>
          <li style="display:flex;align-items:flex-start;gap:.5rem;color:#555"><span style="color:#16a34a;font-weight:700">✓</span> Có định hướng cụ thể</li>
          <li style="display:flex;align-items:flex-start;gap:.5rem;color:#555"><span style="color:#16a34a;font-weight:700">✓</span> Chủ động học tập</li>
          <li style="display:flex;align-items:flex-start;gap:.5rem;color:#555"><span style="color:#16a34a;font-weight:700">✓</span> Tự tin với lựa chọn</li>
        </ul>
      </div>
    </div>
    <p style="margin:1.5rem auto 0;font-style:italic;font-size:1rem;color:#555;text-align:center;max-width:1100px">
      Không chỉ thay đổi suy nghĩ — mà bắt đầu thay đổi hành động
    </p>
  </div>

  <!-- STATS -->
  <div slot="stats">
    <p class="sp-stats__eyebrow">📊 THÔNG TIN CHƯƠNG TRÌNH</p>
    <h2>Lion Camp 2026 THPT — Con Số Bạn Cần Biết</h2>
    <div class="sp-stats__grid">
      <div class="sp-stat">
        <span class="sp-stat__num">6</span>
        <span class="sp-stat__label">Tuần định hướng chuyên sâu — đủ để hiểu mình và xây lộ trình thật</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">15–18</span>
        <span class="sp-stat__label">Tuổi — giai đoạn quyết định hướng đi ảnh hưởng đến cả thập kỷ tiếp theo</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">19.998.000đ</span>
        <span class="sp-stat__label">Học phí ưu đãi (tiết kiệm 10.000.000đ so với giá niêm yết)</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">1 trên 1</span>
        <span class="sp-stat__label">Coaching cá nhân — hiểu đúng từng học sinh, tư vấn đúng hướng</span>
      </div>
    </div>
  </div>

  <!-- BLOCK 6: QUOTE (3 testimonials) -->
  <div slot="quote">
    <p class="sp-quote__eyebrow">HỌC SINH &amp; PHỤ HUYNH NÓI GÌ</p>
    <div class="sp-quote__card">
      <div style="padding-bottom:1.25rem;margin-bottom:1.25rem;border-bottom:1px solid #e8e8e8">
        <p class="sp-quote__text">"Con tôi đã biết mình muốn theo ngành gì sau khi tham gia."</p>
        <div class="sp-quote__author">
          <div>
            <div class="sp-quote__stars">★★★★★</div>
            <div class="sp-quote__name">Phụ huynh học sinh lớp 11</div>
          </div>
        </div>
      </div>
      <div style="padding-bottom:1.25rem;margin-bottom:1.25rem;border-bottom:1px solid #e8e8e8">
        <p class="sp-quote__text">"Con chủ động học hơn vì có mục tiêu rõ ràng."</p>
        <div class="sp-quote__author">
          <div>
            <div class="sp-quote__stars">★★★★★</div>
            <div class="sp-quote__name">Phụ huynh học sinh lớp 10</div>
          </div>
        </div>
      </div>
      <div>
        <p class="sp-quote__text">"Không còn học trong mơ hồ như trước."</p>
        <div class="sp-quote__author">
          <div>
            <div class="sp-quote__stars">★★★★★</div>
            <div class="sp-quote__name">Học sinh lớp 11</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- BLOCK 7: PRICING + BLOCK 8: GUARANTEE -->
  <div slot="pricing">
    <p class="sp-pricing__eyebrow">💡 HỌC PHÍ &amp; GIÁ TRỊ</p>
    <h2>3 Năm THPT Quyết Định Rất Nhiều — Đầu Tư Đúng Ngay Bây Giờ</h2>
    <div class="sp-pricing__table">
      <div class="sp-pricing-col sp-pricing-col--regular">
        <p class="sp-pricing-col__label">Giá niêm yết</p>
        <div class="sp-pricing-col__price" style="text-decoration:line-through;opacity:.6">29.998.000đ</div>
        <div class="sp-pricing-col__unit">/khóa 6 tuần</div>
        <ul class="sp-pricing-col__features">
          <li>Chương trình định hướng 6 tuần</li>
          <li>Coaching cá nhân</li>
          <li>Dự án &amp; trải nghiệm</li>
          <li>Phát triển kỹ năng</li>
          <li>Môi trường học tập</li>
        </ul>
      </div>
      <div class="sp-pricing-col sp-pricing-col--promo">
        <p class="sp-pricing-col__badge">⭐ Ưu đãi hiện tại</p>
        <p class="sp-pricing-col__label">Ưu đãi tháng 4</p>
        <div class="sp-pricing-col__price">19.998.000đ</div>
        <div class="sp-pricing-col__unit">/khóa (tiết kiệm 10tr)</div>
        <ul class="sp-pricing-col__features">
          <li>Toàn bộ chương trình 6 tuần</li>
          <li>Tư vấn định hướng cá nhân</li>
          <li>Hỗ trợ xây lộ trình học tập</li>
          <li>Coaching 1-1 chuyên sâu</li>
          <li>Dự án &amp; trải nghiệm thực tế</li>
        </ul>
      </div>
    </div>

    <div style="border:2px solid #ffff00;background:#fffbf0;border-radius:10px;padding:1.5rem;margin-top:2rem">
      <h3 style="margin:0 0 .75rem;color:#000080;font-size:1.15rem">🛡️ Cam kết rõ ràng</h3>
      <p style="margin:0;color:#555;line-height:1.7">
        Nếu sau 4 tuần học sinh không có sự thay đổi về định hướng — bạn có thể dừng chương trình và nhận lại học phí. Cam kết đơn giản, không điều kiện.
      </p>
    </div>
  </div>

  <!-- BLOCK 9: CTA -->
  <div slot="cta">
    <h2>3 Năm THPT Quyết Định Rất Nhiều</h2>
    <p>Bạn có thể để con học và thi theo quán tính. Hoặc bắt đầu giúp con hiểu mình và chọn đúng hướng — để 3 năm THPT trở thành nền tảng thật, không chỉ là điểm số.</p>
    <a href="#sp-form1" class="sp-cta-btn">Ghi danh ngay →</a>
    <p style="margin-top:.75rem;font-size:1rem;opacity:.75">
      Giới hạn số lượng mỗi nhóm · Không spam · Không ràng buộc
    </p>
  </div>

  <!-- FORM 1 -->
  <div slot="form1">
    <p class="sp-form-block__eyebrow">XEM CHƯƠNG TRÌNH CHI TIẾT</p>
    <h2>Hiểu Rõ Lộ Trình Định Hướng Trước Khi Quyết Định</h2>
    <p>Điền email để nhận Brochure — nội dung 6 tuần, phương pháp coaching và cách chương trình giúp học sinh THPT tìm ra hướng đi của mình.</p>
    <LeadFormTwoStepEmailFirst
      formId="lion-camp-thpt-form1"
      funnelCode="lion-camp-2026-thpt"
      schoolLevel="thpt"
      submitText="Nhận Brochure ngay"
    />
  </div>

  <!-- BLOCK 10: FAQ -->
  <div slot="faq">
    <p class="sp-faq__eyebrow">CÂU HỎI THƯỜNG GẶP</p>
    <h2>Câu Hỏi Phụ Huynh &amp; Học Sinh Hỏi Nhiều Nhất</h2>

    <details class="sp-faq-item">
      <summary>Nếu con chưa biết mình thích gì thì sao?</summary>
      <div class="sp-faq-answer">Đây chính là mục tiêu của chương trình. Lion Camp được thiết kế để giúp học sinh khám phá bản thân thông qua trải nghiệm — không cần biết trước để tham gia.</div>
    </details>

    <details class="sp-faq-item">
      <summary>Có giúp chọn ngành không?</summary>
      <div class="sp-faq-answer">Có, thông qua trải nghiệm và định hướng cá nhân. Học sinh sẽ được coaching 1-1 để làm rõ điểm mạnh, sở thích và hướng đi phù hợp.</div>
    </details>

    <details class="sp-faq-item">
      <summary>Có phải học nhiều không?</summary>
      <div class="sp-faq-answer">Không. Trọng tâm là định hướng và trải nghiệm — không phải ôn thi hay học thêm kiến thức.</div>
    </details>

    <details class="sp-faq-item">
      <summary>Kết quả đo bằng gì?</summary>
      <div class="sp-faq-answer">Bằng sự rõ ràng trong mục tiêu và hành động của học sinh. Sau 6 tuần, con sẽ có một lộ trình cá nhân cụ thể cho giai đoạn tiếp theo.</div>
    </details>
  </div>

  <!-- FORM 2 -->
  <div slot="form2">
    <h2>Giữ Chỗ Cho Con — Số Lượng Giới Hạn Mỗi Nhóm</h2>
    <p>Để lại thông tin — đội ngũ Việt Anh sẽ liên hệ tư vấn lộ trình phù hợp với mục tiêu của con.</p>
    <LeadFormTwoStepEmailFirst
      formId="lion-camp-thpt-form2"
      funnelCode="lion-camp-2026-thpt-2"
      schoolLevel="thpt"
      submitText="Ghi danh ngay"
    />
  </div>

</SalesPageLayout>
