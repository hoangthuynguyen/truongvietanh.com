    <div class="faq-list" style="max-width:760px;margin:0 auto">
      <div class="faq-item">
        <button class="faq-q">Chương trình phù hợp với học sinh lớp mấy?</button>
        <div class="faq-a">Chương trình dành cho học sinh lớp 9 lên 10, lớp 10, 11 và 12. Mỗi nhóm được thiết kế theo mục tiêu riêng phù hợp giai đoạn học tập.</div>
      </div>
      <div class="faq-item">
        <button class="faq-q">IELTS trong trại hè có khác gì luyện thi thông thường không?</button>
        <div class="faq-a">Có. Trại hè kết hợp IELTS với kỹ năng thuyết trình, tư duy và dự án nhóm. Speaking được luyện hàng ngày trong môi trường thực tế, không chỉ làm đề thi.</div>
      </div>
      <div class="faq-item">
        <button class="faq-q">Tư vấn hướng nghiệp 1:1 là như thế nào?</button>
        <div class="faq-a">Mỗi học sinh được ngồi tư vấn riêng với người hướng dẫn để khám phá điểm mạnh, tìm hiểu các ngành học và xây dựng lộ trình phù hợp. Không phải buổi giới thiệu trường chung chung.</div>
      </div>
      <div class="faq-item">
        <button class="faq-q">Chương trình có nặng học thuật không?</button>
        <div class="faq-a">Không. Chương trình cân bằng giữa IELTS, thuyết trình, tư duy, teamwork và hướng nghiệp. Mục tiêu là giúp học sinh phát triển kỹ năng thực sự, không phải học thêm chữ.</div>
      </div>
      <div class="faq-item">
        <button class="faq-q">Học sinh có thể nhận thông tin trước khi đăng ký chính thức không?</button>
        <div class="faq-a">Có. Để lại thông tin để nhận lịch học 6 tuần, học phí, học bổng và gợi ý nhóm phù hợp. Tư vấn viên sẽ liên hệ để giải đáp trước khi quyết định.</div>
      </div>
      <div class="faq-item">
        <button class="faq-q">Có học bổng hoặc ưu đãi đăng ký sớm không?</button>
        <div class="faq-a">Có. Học sinh đăng ký sớm sẽ được hưởng chính sách học bổng/ưu đãi early bird. Số lượng có giới hạn theo từng đợt.</div>
      </div>
      <div class="faq-item">
        <button class="faq-q">Ba mẹ hoặc học sinh có thể nhắn Zalo để hỏi không?</button>
        <div class="faq-a">Có. Có thể gọi hoặc nhắn Zalo qua số {HOTLINE} để được hỗ trợ nhanh hơn.</div>
      </div>
    </div>
  </div>
</section>

<!-- BOTTOM CTA -->
<section class="bcta">
  <div class="wrap">
    <h2 class="bcta-h">Đăng ký nhận lịch học 6 tuần + học bổng</h2>
    <p class="bcta-p">Trại hè THPT Việt Anh Gò Vấp 2026 khai giảng ngày 15/06/2026. Số chỗ mỗi nhóm có giới hạn để đảm bảo chất lượng tương tác và tư vấn cá nhân.</p>
    <div class="cta-row">
      <a href="#form" class="btn-orange">📋 NHẬN LỊCH HỌC &amp; HỌC BỔNG</a>
      <a href={ZALO_URL} target="_blank" rel="noopener" class="btn-outline">💬 Nhắn Zalo</a>
      <a href={`tel:${HOTLINE_TEL}`} class="btn-outline">📞 {HOTLINE}</a>
    </div>
    <p style="margin-top:18px;font-size:13px;color:rgba(255,255,255,.55)">
      📍 160/72 Phan Huy Ích, Gò Vấp, TP.HCM · 📅 Khai giảng: 15/06/2026 · 🎓 Lớp 10–12
    </p>
  </div>
</section>

<!-- FOOTER -->
<footer class="footer">
  <p>© {new Date().getFullYear()} Trường TH–THCS–THPT Việt Anh · 160/72 Phan Huy Ích, Gò Vấp, TP.HCM · <a href={`tel:${HOTLINE_TEL}`}>{HOTLINE}</a></p>
  <p style="margin-top:6px">
    <a href="https://truongvietanh.com">truongvietanh.com</a> ·
    <a href="https://truongvietanh.com/chinh-sach-bao-mat">Chính sách bảo mật</a>
  </p>
</footer>

<!-- NOTIFICATION TOAST -->
<div class="notif-toast" id="notifToast">
  <span class="notif-ico">👩</span>
  <div class="notif-txt">
    <strong id="notifName">Học sinh Lớp 11, Gò Vấp</strong>
    <span>vừa đăng ký nhận tư vấn</span>
  </div>
  <button class="notif-close" onclick="document.getElementById('notifToast').classList.remove('show')">×</button>
</div>

<!-- STICKY BAR (mobile) -->
<div class="sticky">
  <a href="#form" class="sb sb-r">📋 Nhận lịch học</a>
  <a href={`tel:${HOTLINE_TEL}`} class="sb sb-c">📞 Gọi/Zalo</a>
</div>

<script define:vars={{ SOURCE, FUNNEL_CODE, REDIRECT }}>
(function(){
  var SRC = SOURCE, FC = FUNNEL_CODE, REDIR = REDIRECT;

  function isValidEmail(v){ return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()); }

  function doSubmit(name, email, phone, grade, formId){
    var el = document.getElementById(formId);
    if(el){ el.style.opacity='.5'; el.style.pointerEvents='none'; }
    var payload = JSON.stringify({
      fullName: name, email: email, phone: phone, childGrade: grade,
      source: SRC, funnel_code: FC, school_level: 'thpt',
      page_url: location.href, submitted_at: new Date().toISOString()
    });
    localStorage.setItem('lp_' + SRC, '1');
    var done = false;
    var go = function(){ if(!done){ done=true; window.location.href = REDIR; } };
    fetch('https://truongvietanh.com/api/lead',{
      method:'POST', headers:{'Content-Type':'application/json'},
      body: payload, mode:'cors', keepalive:true
    }).then(function(r){ if(!r.ok) console.error('[lead] '+r.status); })
    .catch(function(){
      if(navigator.sendBeacon)
        try{ navigator.sendBeacon('https://truongvietanh.com/api/lead',
          new Blob([payload],{type:'application/json'})); }catch(ex){}
    }).finally(go);
    setTimeout(go, 3000);
    if(window.dataLayer) window.dataLayer.push({ event:'lead_submit', source: SRC, funnel_code: FC });
  }

  function stepNext(nameId, emailId, dot1Id, dot2Id, labelId, step1Id, step2Id, phoneId){
    var nameEl  = document.getElementById(nameId);
    var emailEl = document.getElementById(emailId);
    var name  = nameEl  ? nameEl.value.trim()  : '';
    var email = emailEl ? emailEl.value.trim() : '';
    var ok = true;
    if(!name){  if(nameEl){  nameEl.classList.add('err');  nameEl.focus(); }  ok=false; }
    else nameEl.classList.remove('err');
    if(!isValidEmail(email)){ if(emailEl){ emailEl.classList.add('err'); if(ok) emailEl.focus(); } ok=false; }
    else emailEl.classList.remove('err');
    if(!ok) return;
    document.getElementById(step1Id).style.display='none';
    document.getElementById(step2Id).style.display='block';
    var d1=document.getElementById(dot1Id), d2=document.getElementById(dot2Id), sl=document.getElementById(labelId);
    if(d1){d1.classList.remove('active');d1.classList.add('done');}
    if(d2) d2.classList.add('active');
    if(sl) sl.textContent='Số điện thoại';
    var p=document.getElementById(phoneId); if(p) p.focus();
  }

  function stepBack(dot1Id, dot2Id, labelId, step1Id, step2Id){
    document.getElementById(step2Id).style.display='none';
    document.getElementById(step1Id).style.display='block';
    var d1=document.getElementById(dot1Id), d2=document.getElementById(dot2Id), sl=document.getElementById(labelId);
    if(d2) d2.classList.remove('active');
    if(d1){d1.classList.remove('done');d1.classList.add('active');}
    if(sl) sl.textContent='Tên & Email';
  }

  function stepSubmit(nameId, emailId, phoneId, gradeId, formId){
    var phoneEl = document.getElementById(phoneId);
    var phone = phoneEl ? phoneEl.value.replace(/[^0-9]/g,'') : '';
    if(phone.length < 9){ if(phoneEl){phoneEl.classList.add('err');phoneEl.focus();} return; }
    phoneEl.classList.remove('err');
    var name  = document.getElementById(nameId).value.trim();
    var email = document.getElementById(emailId).value.trim();
    var grade = document.getElementById(gradeId).value;
    doSubmit(name, email, phoneEl.value.trim(), grade, formId);
  }

  // Desktop form
  window.dsNext   = function(){ stepNext('dp-name','dp-email','dot1d','dot2d','slabeld','step1d','step2d','dp-phone'); };
  window.dsBack   = function(){ stepBack('dot1d','dot2d','slabeld','step1d','step2d'); };
  window.dsSubmit = function(){ stepSubmit('dp-name','dp-email','dp-phone','dp-grade','formAreaDesktop'); };

  // Mobile form
  window.msNext   = function(){ stepNext('mp-name','mp-email','dot1m','dot2m','slabelm','step1m','step2m','mp-phone'); };
  window.msBack   = function(){ stepBack('dot1m','dot2m','slabelm','step1m','step2m'); };
  window.msSubmit = function(){ stepSubmit('mp-name','mp-email','mp-phone','mp-grade','formAreaMobile'); };

  // Enter key on email → next
  ['dp-email','mp-email'].forEach(function(id){
    var el=document.getElementById(id);
    if(el) el.addEventListener('keydown',function(e){
      if(e.key==='Enter'){ e.preventDefault();
        id.startsWith('dp') ? dsNext() : msNext(); }
    });
  });
  // Enter key on phone → submit
  ['dp-phone','mp-phone'].forEach(function(id){
    var el=document.getElementById(id);
    if(el) el.addEventListener('keydown',function(e){
      if(e.key==='Enter'){ e.preventDefault();
        id.startsWith('dp') ? dsSubmit() : msSubmit(); }
    });
  });

  // FAQ toggle
  document.querySelectorAll('.faq-q').forEach(function(btn){
    btn.addEventListener('click', function(){
      var item = btn.closest('.faq-item');
      var isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item.open').forEach(function(i){ i.classList.remove('open'); });
      if(!isOpen) item.classList.add('open');
    });
  });

  // Phone auto-format (Vietnamese)
  ['dp-phone','mp-phone'].forEach(function(id){
    var el=document.getElementById(id);
    if(!el) return;
    el.addEventListener('input',function(){
      var v=this.value.replace(/\D/g,'');
      if(v.length>11) v=v.slice(0,11);
      this.value=v;
    });
  });

  // Countdown to 15/06/2026
  function updateCountdown(){
    var target = new Date('2026-06-15T00:00:00+07:00').getTime();
    var now = Date.now();
    var diff = target - now;
    if(diff <= 0){ diff = 0; }
    var days = Math.floor(diff/(1000*60*60*24));
    var hours = Math.floor((diff%(1000*60*60*24))/(1000*60*60));
    var mins = Math.floor((diff%(1000*60*60))/(1000*60));
    ['cd-days','cd-hours','cd-mins'].forEach(function(id,i){
      var el=document.getElementById(id);
      if(el) el.textContent = String([days,hours,mins][i]).padStart(2,'0');
    });
  }
  updateCountdown();
  setInterval(updateCountdown, 60000);

  // Notification toast
  var toastNames = [
    'Học sinh Lớp 11, Gò Vấp','Mẹ học sinh Lớp 10, GV','Học sinh Lớp 12, Gò Vấp',
    'Ba học sinh Lớp 9→10, GV','Mẹ học sinh Lớp 11, Gò Vấp','Học sinh Lớp 10, Gò Vấp'
  ];
  var toastIdx = Math.floor(Math.random()*toastNames.length);
  function showToast(){
    var toast = document.getElementById('notifToast');
    var nameEl = document.getElementById('notifName');
    if(!toast) return;
    nameEl.textContent = toastNames[toastIdx % toastNames.length];
    toastIdx++;
    toast.classList.add('show');
    setTimeout(function(){ toast.classList.remove('show'); },4500);
  }
  setTimeout(showToast, 6000);
  setInterval(function(){ showToast(); }, 45000);

  // GTM phone click tracking
  document.querySelectorAll('a[href^="tel:"]').forEach(function(a){
    a.addEventListener('click', function(){
      if(window.dataLayer) window.dataLayer.push({ event:'phone_click', source: SRC });
    });
  });
})();
</script>
</body>
</html>
