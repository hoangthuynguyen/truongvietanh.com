<script define:vars={{ SOURCE, FUNNEL_CODE, REDIRECT, ZALO_URL, HOTLINE_TEL }}>
(function(){
  var FC = FUNNEL_CODE;

  // GTM landing view
  if(window.dataLayer) window.dataLayer.push({ event:'landing_view', funnel_code: FC });

  // Phone clicks
  document.querySelectorAll('a[href^="tel:"]').forEach(function(a){
    a.addEventListener('click', function(){
      if(window.dataLayer) window.dataLayer.push({ event:'phone_click', funnel_code: FC });
    });
  });

  // Zalo clicks
  document.querySelectorAll('a[href*="zalo.me"]').forEach(function(a){
    a.addEventListener('click', function(){
      if(window.dataLayer) window.dataLayer.push({ event:'zalo_click', funnel_code: FC });
    });
  });

  // FAQ accordion
  document.querySelectorAll('.faq-q').forEach(function(btn){
    btn.addEventListener('click', function(){
      var item = btn.closest('.faq-item');
      var wasOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item.open').forEach(function(el){ el.classList.remove('open'); });
      if(!wasOpen) item.classList.add('open');
    });
  });

  // Step 1 → Step 2
  var btnStep1 = document.getElementById('btn-step1');
  if(btnStep1) btnStep1.addEventListener('click', function(){
    var phone = document.getElementById('phone');
    var grade = document.getElementById('grade');
    if(!phone.value.trim() || phone.value.trim().length < 9){
      phone.focus(); phone.style.borderColor='var(--orange)'; return;
    }
    if(!grade.value){
      grade.focus(); grade.style.borderColor='var(--orange)'; return;
    }
    document.getElementById('step1').classList.add('hidden');
    document.getElementById('step2').classList.remove('hidden');
    if(window.dataLayer) window.dataLayer.push({ event:'form_step_1_complete', funnel_code: FC });
  });

  // Form submit
  var form = document.getElementById('lead-form');
  if(form) form.addEventListener('submit', function(e){
    e.preventDefault();
    var phone = document.getElementById('phone').value.trim();
    var grade = document.getElementById('grade').value;
    var name  = document.getElementById('name').value.trim();
    var cbs   = document.querySelectorAll('input[name="interest"]:checked');
    var interests = Array.from(cbs).map(function(c){ return c.value; }).join(', ');
    var btn = document.getElementById('btn-submit');
    if(btn){ btn.disabled = true; btn.textContent = 'Đang gửi...'; }

    var payload = {
      source: SOURCE,
      funnel_code: FC,
      phone: phone,
      grade: grade,
      name: name,
      interests: interests,
      school_level: 'tieu-hoc',
      location: 'binh-tan'
    };

    function redirect(){ window.location.href = REDIRECT; }

    fetch('https://truongvietanh.com/api/lead', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    }).then(function(r){
      if(window.dataLayer) window.dataLayer.push({ event:'lead_submit', funnel_code: FC, phone: phone });
      redirect();
    }).catch(function(){
      try{ navigator.sendBeacon('https://truongvietanh.com/api/lead', JSON.stringify(payload)); }catch(err){}
      if(window.dataLayer) window.dataLayer.push({ event:'lead_submit', funnel_code: FC, phone: phone });
      redirect();
    });
  });
})();
</script>
</body>
