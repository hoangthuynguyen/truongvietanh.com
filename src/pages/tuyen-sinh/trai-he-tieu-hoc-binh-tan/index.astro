<style is:inline>
/* ══════════════════════════════════
   TRẠI HÈ TIỂU HỌC BÌNH TÂN 2026
   Landing Page — Light + Orange CTA
   ══════════════════════════════════ */
:root{
  --navy:#000080;--navy-dk:#00004d;--navy-soft:#f0f0ff;
  --orange:#ffff00;--orange-dk:#e6e600;--orange-soft:#fffde6;
  --text:#1F2937;--text-sub:#4B5563;--border:#E5E7EB;
  --bg:#ffffff;--bg2:#F9FAFB;
  --green:#16A34A;--red:#DC2626;
  --r:12px;--r2:8px;
  --sh:0 4px 24px rgba(11,47,91,.10);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Open Sans',system-ui,sans-serif;color:var(--text);background:var(--bg);
  line-height:1.65;font-size:16px;-webkit-font-smoothing:antialiased;overflow-x:hidden;
  padding-bottom:76px}
h1,h2,h3,h4{font-family:'Montserrat',sans-serif;font-weight:800;line-height:1.2}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
.wrap{max-width:1160px;margin:0 auto;padding:0 20px;width:100%}

/* ── HEADER ── */
.hdr{background:#fff;border-bottom:3px solid var(--orange);padding:8px 0;
  position:sticky;top:0;z-index:200;box-shadow:0 2px 10px rgba(0,0,0,.06)}
.hdr-inner{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;
  max-width:1160px;margin:0 auto;padding:0 20px;gap:12px}
.hdr-logo{display:flex;justify-content:center}
.hdr-logo img{height:80px;width:auto}
.hdr-micro{font-size:12px;color:var(--text-sub);text-align:center;font-weight:600;line-height:1.4;
  display:flex;flex-direction:column;align-items:center;gap:2px}
.hdr-micro strong{color:var(--navy);font-size:13px}
.hdr-right{display:flex;flex-direction:column;align-items:flex-end;gap:4px}
.hdr-right a{font-weight:700;font-size:14px;color:var(--navy)}
.hdr-zalo{background:var(--navy);color:#fff;font-size:12px;font-weight:700;
  padding:5px 12px;border-radius:6px;display:inline-block}

/* ── HERO ── */
.hero{background:var(--bg);padding:36px 0 40px;border-bottom:1px solid var(--border)}
.hero-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:40px;align-items:start;
  max-width:1160px;margin:0 auto;padding:0 20px}
.badge-pill{display:inline-flex;align-items:center;gap:8px;
  background:var(--orange-soft);border:1.5px solid var(--orange);
  color:var(--orange-dk);padding:7px 14px;border-radius:30px;
  font-size:12.5px;font-weight:700;margin-bottom:14px}
.badge-dot{width:7px;height:7px;border-radius:50%;background:var(--orange);
  animation:bdot 1.4s ease-in-out infinite;flex-shrink:0}
@keyframes bdot{0%,100%{opacity:1}50%{opacity:.3}}
.h1{font-size:clamp(1.75rem,3vw,2.6rem);color:var(--navy);margin-bottom:8px;letter-spacing:-.3px}
.h2-tag{font-size:clamp(1.05rem,1.8vw,1.3rem);color:var(--text);font-weight:700;
  margin-bottom:14px;line-height:1.4}
.hero-intro{font-size:15.5px;color:var(--text-sub);line-height:1.75;margin-bottom:18px;
  border-left:4px solid var(--orange);padding-left:14px}
.meta-chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px}
.meta-chip{display:inline-flex;align-items:center;gap:6px;background:#fff;
  border:1.5px solid var(--border);color:var(--navy);padding:6px 12px;
  border-radius:20px;font-size:13px;font-weight:600}
.bullets{list-style:none;display:flex;flex-direction:column;gap:8px;margin-bottom:18px}
.bullets li{display:flex;align-items:flex-start;gap:10px;font-size:15px;color:var(--text);line-height:1.5}
.bullets li::before{content:'✅';flex-shrink:0;font-size:13px;margin-top:2px}
.trust-micro{font-size:12.5px;color:var(--text-sub);display:flex;flex-wrap:wrap;gap:10px;
  font-weight:600}
.trust-micro span{display:flex;align-items:center;gap:4px}

/* Hero CTA (mobile) */
.hero-cta-m{display:none;margin-top:16px}

/* ── FORM CARD ── */
.fcard{background:#fff;border-radius:var(--r);box-shadow:var(--sh);
  border:1.5px solid var(--border);overflow:hidden;position:sticky;top:96px}
.fcard-top{background:var(--orange);color:#fff;text-align:center;
  padding:9px 14px;font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.5px}
.fcard-body{padding:18px}
.fcard-title{font-size:1rem;font-weight:900;color:var(--navy);text-align:center;
  line-height:1.3;margin-bottom:4px}
.fcard-sub{font-size:12px;color:var(--text-sub);text-align:center;margin-bottom:14px;line-height:1.45}
/* Step indicator */
.step-ind{display:flex;align-items:center;justify-content:center;gap:6px;
  margin-bottom:14px;padding-bottom:12px;border-bottom:1px dashed var(--border)}
.sdot{width:24px;height:24px;border-radius:50%;background:#e5e7eb;color:#999;
  font-size:11.5px;font-weight:800;display:flex;align-items:center;justify-content:center;
  transition:.3s;flex-shrink:0}
.sdot.active{background:var(--navy);color:#fff}
.sdot.done{background:var(--green);color:#fff}
.sline{width:28px;height:2px;background:#e5e7eb}
.slabel{font-size:11.5px;color:var(--navy);font-weight:700;margin-left:6px}
/* Inputs */
.flabel{display:block;font-size:12px;font-weight:700;color:var(--navy);
  margin-bottom:4px;margin-top:10px}
.flabel:first-of-type{margin-top:0}
.req{color:var(--red)}
.finput{width:100%;padding:10px 12px;border:1.5px solid var(--border);border-radius:var(--r2);
  font-size:14px;font-family:inherit;background:#fafbff;color:var(--text);transition:.2s}
.finput:focus{outline:none;border-color:var(--navy);background:#fff;
  box-shadow:0 0 0 3px rgba(11,47,91,.08)}
.finput.err{border-color:var(--red);background:#f0f0ff}
/* Checkboxes */
.cb-group{display:flex;flex-direction:column;gap:6px;margin-top:4px}
.cb-item{display:flex;align-items:center;gap:8px;cursor:pointer;
  font-size:13px;color:var(--text);line-height:1.4;
  background:#fafbff;border:1.5px solid var(--border);border-radius:var(--r2);
  padding:7px 10px;transition:.15s}
.cb-item:hover{background:#f0f4ff;border-color:#a5b4fc}
.cb-item input{accent-color:var(--navy);width:15px;height:15px;cursor:pointer;flex-shrink:0}
/* Buttons */
.btn-cta{width:100%;background:var(--orange);color:#fff;border:none;
  padding:13px;border-radius:var(--r2);font-size:14px;font-weight:900;
  font-family:'Montserrat',sans-serif;cursor:pointer;transition:.15s;
  text-transform:uppercase;letter-spacing:.3px;
  box-shadow:0 4px 14px rgba(249,115,22,.35);margin-top:12px}
.btn-cta:hover{background:var(--orange-dk);transform:translateY(-1px);
  box-shadow:0 6px 20px rgba(249,115,22,.45)}
.btn-back{background:none;border:none;color:var(--text-sub);font-size:12px;
  font-weight:600;cursor:pointer;text-decoration:underline;padding:7px 0 0;
  width:100%;text-align:center}
.fcard-foot{display:flex;justify-content:space-around;gap:4px;flex-wrap:wrap;
  font-size:11px;color:var(--text-sub);margin-top:10px;padding-top:8px;
  border-top:1px solid var(--border);font-weight:600}
.fcard-foot span{display:flex;align-items:center;gap:3px}

/* ── SECTIONS ── */
.sec{padding:52px 0}
.sec-light{background:#fff}
.sec-alt{background:var(--bg2)}
.sec-navy{background:var(--navy);color:#fff}
.sec-tag{display:inline-block;background:var(--orange-soft);color:var(--orange-dk);
  font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.6px;
  padding:5px 14px;border-radius:20px;margin-bottom:10px;border:1px solid var(--orange)}
.sec-tag.w{background:rgba(255,255,255,.12);color:rgba(255,255,255,.9);border-color:rgba(255,255,255,.2)}
.sec-h{font-size:clamp(1.3rem,2.2vw,1.85rem);color:var(--navy);margin-bottom:8px}
.sec-navy .sec-h{color:#fff}
.sec-sub{font-size:15px;color:var(--text-sub);max-width:660px;line-height:1.7}
.sec-navy .sec-sub{color:rgba(255,255,255,.78)}
.sec-head{margin-bottom:28px}

/* ── PAIN GRID ── */
.pain-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.pain-card{background:#fff;border-radius:var(--r);padding:20px;
  display:flex;gap:12px;align-items:flex-start;border:1.5px solid var(--border);transition:.15s}
.pain-card:hover{border-color:var(--orange);box-shadow:0 4px 16px rgba(249,115,22,.1)}
.pain-icon{font-size:1.7rem;flex-shrink:0;margin-top:2px}
.pain-title{font-size:15px;color:var(--navy);font-weight:700;margin-bottom:4px;display:block}
.pain-desc{font-size:13.5px;color:var(--text-sub);line-height:1.6}
.pain-detail{font-size:13.5px;color:var(--text-sub);line-height:1.65;margin-top:8px;
  border-top:1px dashed var(--border);padding-top:8px}

/* ── OUTCOMES ── */
.out-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.out-card{background:#fff;border-radius:var(--r);padding:24px 20px;
  border:1.5px solid var(--border);position:relative;transition:.15s}
.out-card:hover{border-color:var(--orange);box-shadow:var(--sh);transform:translateY(-2px)}
.out-num{font-size:2.2rem;font-weight:900;color:rgba(249,115,22,.15);
  font-family:'Montserrat',sans-serif;margin-bottom:6px}
.out-title{font-size:1rem;font-weight:800;color:var(--navy);margin-bottom:8px}
.out-body{font-size:14px;color:var(--text-sub);line-height:1.65}

/* ── WEEKS ── */
.weeks-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.week-card{background:#fff;border-radius:var(--r);padding:18px;
  border:1.5px solid var(--border);transition:.15s}
.week-card:hover{border-color:var(--orange);box-shadow:var(--sh)}
.week-num{display:inline-block;background:var(--orange);color:#fff;
  font-size:11px;font-weight:900;padding:3px 10px;border-radius:20px;
  margin-bottom:8px;font-family:'Montserrat',sans-serif}
.week-title{font-size:14.5px;font-weight:700;color:var(--navy);margin-bottom:6px}
.week-result{font-size:13px;color:var(--green);font-weight:600;
  display:flex;align-items:center;gap:6px;margin-top:8px;padding-top:8px;
  border-top:1px dashed var(--border)}

/* ── AGE GROUPS ── */
.age-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.age-card{background:#fff;border-radius:var(--r);padding:22px 18px;text-align:center;
  border:1.5px solid var(--border);position:relative;transition:.15s}
.age-card:hover{border-color:var(--orange);box-shadow:var(--sh)}
.age-card.hl{border-color:var(--orange);background:var(--orange-soft)}
.age-pill{display:inline-block;background:var(--navy);color:#fff;
  font-size:12px;font-weight:900;padding:5px 14px;border-radius:20px;
  margin-bottom:8px;font-family:'Montserrat',sans-serif}
.age-card.hl .age-pill{background:var(--orange)}
.age-label{font-size:.95rem;font-weight:800;color:var(--navy);margin-bottom:6px}
.age-desc{font-size:13px;color:var(--text-sub);line-height:1.6}
.age-pop{position:absolute;top:-1px;right:12px;background:var(--orange);color:#fff;
  font-size:10px;font-weight:900;padding:3px 8px;border-radius:0 0 8px 8px;letter-spacing:.3px}

/* ── WHY GRID ── */
.why-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.why-card{background:rgba(255,255,255,.08);border-radius:var(--r);padding:18px;
  display:flex;gap:10px;align-items:flex-start;transition:.15s}
.why-card:hover{background:rgba(255,255,255,.12)}
.why-ic{font-size:1.5rem;flex-shrink:0;margin-top:2px}
.why-title{font-size:14px;color:var(--orange-soft);font-weight:700;margin-bottom:4px;display:block}
.why-desc{font-size:13px;color:rgba(255,255,255,.8);line-height:1.6}

/* ── TRUST SECTION ── */
.trust-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.trust-item{display:flex;align-items:flex-start;gap:10px;font-size:15px;color:var(--text);
  line-height:1.5}
.trust-item::before{content:'✅';flex-shrink:0;font-size:14px;margin-top:2px}

/* ── FAQ ── */
.faq-list{display:flex;flex-direction:column;gap:0}
.faq-item{border-bottom:1px solid var(--border)}
.faq-item:first-child{border-top:1px solid var(--border)}
.faq-q{width:100%;background:none;border:none;text-align:left;padding:16px 0;
  font-size:15.5px;font-weight:700;color:var(--navy);cursor:pointer;
  display:flex;justify-content:space-between;align-items:center;gap:12px;
  font-family:'Montserrat',sans-serif}
.faq-q::after{content:'＋';font-size:1.2rem;font-weight:900;color:var(--orange);
  flex-shrink:0;transition:.2s}
.faq-item.open .faq-q::after{content:'－'}
.faq-a{display:none;font-size:15px;color:var(--text-sub);line-height:1.75;
  padding-bottom:16px}
.faq-item.open .faq-a{display:block}

/* ── FORM SECTION (mid-page) ── */
.form-sec{background:#fff;padding:48px 0;border-top:1px solid var(--border)}
.form-sec .fcard{max-width:580px;margin:0 auto;position:static;box-shadow:0 8px 40px rgba(11,47,91,.12)}

/* ── BOTTOM CTA ── */
.bcta{background:var(--navy);color:#fff;padding:52px 0;text-align:center}
.bcta-h{font-size:clamp(1.3rem,2.2vw,1.85rem);color:#fff;margin-bottom:8px}
.bcta-p{font-size:15.5px;color:rgba(255,255,255,.8);margin-bottom:24px;
  max-width:580px;margin-left:auto;margin-right:auto;line-height:1.7}
.cta-row{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
.btn-orange{display:inline-flex;align-items:center;justify-content:center;gap:8px;
  background:var(--orange);color:#fff;padding:15px 28px;border-radius:10px;
  font-weight:900;font-size:15px;font-family:'Montserrat',sans-serif;
  transition:.15s;min-width:200px;box-shadow:0 4px 18px rgba(249,115,22,.35)}
.btn-orange:hover{background:var(--orange-dk);transform:translateY(-2px)}
.btn-outline{display:inline-flex;align-items:center;justify-content:center;gap:8px;
  background:transparent;color:#fff;border:2px solid rgba(255,255,255,.4);
  padding:15px 28px;border-radius:10px;font-weight:700;font-size:15px;
  font-family:'Open Sans',sans-serif;transition:.15s;min-width:160px}
.btn-outline:hover{background:rgba(255,255,255,.1)}

/* ── FOOTER ── */
.footer{background:var(--navy-dk);color:rgba(255,255,255,.55);text-align:center;
  padding:20px;font-size:13px}
.footer a{color:var(--orange)}

/* ── STICKY BAR ── */
.sticky{display:none;position:fixed;bottom:0;left:0;right:0;background:#fff;
  border-top:2px solid var(--orange);z-index:300;padding:10px 16px;gap:10px}
.sb{flex:1;display:flex;align-items:center;justify-content:center;gap:7px;
  padding:13px 10px;border-radius:9px;font-weight:900;font-size:13.5px;
  font-family:'Montserrat',sans-serif;text-decoration:none;border:none;cursor:pointer}
.sb-r{background:var(--orange);color:#fff}
.sb-c{background:var(--navy);color:#fff}

/* ── CHECKLIST LIST ── */
.chk-list{list-style:none;display:flex;flex-direction:column;gap:9px}
.chk-list li{display:flex;align-items:flex-start;gap:10px;font-size:15px;line-height:1.55}
.chk-list li::before{content:'✅';flex-shrink:0;font-size:13px;margin-top:2px}

/* ── SECTION CTA BUTTON ── */
.sec-cta-wrap{margin-top:28px;text-align:center}
.btn-orange-outline{display:inline-flex;align-items:center;justify-content:center;gap:8px;
  background:var(--orange);color:#fff;padding:13px 28px;border-radius:10px;
  font-weight:900;font-size:14.5px;font-family:'Montserrat',sans-serif;
  transition:.15s;box-shadow:0 4px 16px rgba(249,115,22,.3)}
.btn-orange-outline:hover{background:var(--orange-dk);transform:translateY(-1px)}

/* ── REVIEWS ── */
.review-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.review-card{background:#fff;border-radius:var(--r);padding:22px;
  border:1.5px solid var(--border);position:relative;transition:.15s}
.review-card:hover{border-color:var(--orange);box-shadow:var(--sh)}
.stars{color:#F59E0B;font-size:1.05rem;margin-bottom:10px;letter-spacing:1px}
.review-text{font-size:14.5px;color:var(--text);line-height:1.75;font-style:italic;
  margin-bottom:14px;padding-left:12px;border-left:3px solid var(--orange)}
.reviewer{font-size:12.5px;color:var(--text-sub);font-weight:700;display:flex;align-items:center;gap:6px}
.reviewer::before{content:'👩';font-style:normal}
.review-source{font-size:11.5px;color:var(--text-sub);margin-top:16px;text-align:center;
  display:flex;gap:8px;flex-wrap:wrap;justify-content:center}
.review-source span{display:flex;align-items:center;gap:4px;background:var(--bg2);
  padding:4px 10px;border-radius:20px;border:1px solid var(--border)}

/* ── COMPARISON ── */
.cmp-wrap{overflow-x:auto;border-radius:var(--r);box-shadow:var(--sh)}
.cmp-table{width:100%;border-collapse:collapse;font-size:14.5px;min-width:520px}
.cmp-table th{padding:13px 16px;font-weight:900;font-size:12.5px;text-transform:uppercase;
  letter-spacing:.4px;font-family:'Montserrat',sans-serif;border-bottom:2px solid var(--border)}
.cmp-table th:first-child{text-align:left;background:var(--bg2);color:var(--text-sub);width:38%}
.cmp-table th.no{background:#fffde6;color:#dc2626;text-align:center}
.cmp-table th.yes{background:#dcfce7;color:#16a34a;text-align:center}
.cmp-table td{padding:11px 16px;border-bottom:1px solid var(--border);line-height:1.5}
.cmp-table td:first-child{color:var(--text);font-weight:600;background:var(--bg2)}
.cmp-table td.no{text-align:center;color:#b91c1c;font-weight:600;background:#fafbff}
.cmp-table td.yes{text-align:center;color:#15803d;font-weight:700;background:#f0fdf4}
.cmp-table tr:last-child td{border-bottom:none}

/* ── EARLY BIRD ── */
.eb-section{background:var(--navy);color:#fff;padding:44px 0;border-top:4px solid var(--orange)}
.eb-tag{display:inline-block;background:var(--orange);color:#fff;font-size:12px;font-weight:900;
  text-transform:uppercase;letter-spacing:.6px;padding:5px 14px;border-radius:20px;margin-bottom:12px}
.eb-h{font-size:clamp(1.25rem,2.2vw,1.7rem);color:#fff;margin-bottom:8px}
.eb-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:20px;align-items:center}
.eb-list{list-style:none;display:flex;flex-direction:column;gap:10px}
.eb-list li{display:flex;align-items:flex-start;gap:8px;font-size:15px;
  color:rgba(255,255,255,.9);line-height:1.5}
.eb-list li::before{content:'🎁';flex-shrink:0;font-size:13px}
.eb-cta-box{background:rgba(255,255,255,.08);border-radius:var(--r);padding:22px;
  border:1.5px solid rgba(255,255,255,.2);text-align:center}
.eb-countdown{display:flex;gap:8px;justify-content:center;margin-bottom:16px}
.cdown-unit{background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.2);
  color:#fff;border-radius:10px;padding:10px 12px;min-width:64px;text-align:center}
.cdown-num{font-size:1.8rem;font-weight:900;font-family:'Montserrat',sans-serif;
  display:block;line-height:1;color:#fff}
.cdown-label{font-size:10px;font-weight:700;opacity:.75;text-transform:uppercase;
  letter-spacing:.5px;display:block;margin-top:3px}

/* ── SOCIAL COUNT ── */
.social-count{display:flex;align-items:center;justify-content:center;gap:8px;
  background:var(--orange-soft);border:1.5px solid var(--orange);
  color:var(--orange-dk);padding:8px 14px;border-radius:8px;
  font-size:13px;font-weight:700;margin-bottom:10px;width:100%;line-height:1.3}
.social-live{display:inline-block;width:7px;height:7px;border-radius:50%;
  background:var(--orange);animation:bdot 1.4s ease-in-out infinite;flex-shrink:0}

/* ── NOTIFICATION TOAST ── */
.notif-toast{position:fixed;bottom:90px;left:16px;max-width:280px;
  background:#fff;border-radius:10px;box-shadow:0 8px 32px rgba(0,0,0,.15);
  border:1.5px solid var(--border);border-left:4px solid var(--green);
  padding:11px 13px;z-index:400;display:none;align-items:center;gap:9px}
.notif-toast.show{display:flex;animation:toastIn .35s ease-out}
@keyframes toastIn{from{transform:translateX(-20px);opacity:0}to{transform:translateX(0);opacity:1}}
.notif-ico{font-size:1.25rem;flex-shrink:0}
.notif-txt{font-size:12.5px;color:var(--text);line-height:1.45}
.notif-txt strong{color:var(--navy);display:block}
.notif-close{margin-left:auto;background:none;border:none;cursor:pointer;
  color:#aaa;font-size:.9rem;padding:0 0 0 6px;flex-shrink:0;line-height:1}

/* ── VISIBILITY ── */
.m-only{display:none}
.d-only{display:block}

/* ── RESPONSIVE ── */
@media(max-width:1100px){
  .why-grid{grid-template-columns:repeat(2,1fr)}
  .age-grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:960px){
  .hero-grid{grid-template-columns:1fr;gap:0}
  .hero-form-col{display:none}
  .pain-grid{grid-template-columns:repeat(2,1fr)}
  .out-grid{grid-template-columns:repeat(2,1fr)}
  .weeks-grid{grid-template-columns:repeat(2,1fr)}
  .trust-grid{grid-template-columns:1fr}
  .hdr-micro{display:none}
  .hero-cta-m{display:block}
  .d-only{display:none}
  .m-only{display:block}
  .review-grid{grid-template-columns:1fr}
  .eb-grid{grid-template-columns:1fr}
}
@media(max-width:640px){
  .sec{padding:36px 0}
  .hdr-logo img{height:60px}
  .hdr-inner{grid-template-columns:auto 1fr}
  .pain-grid{grid-template-columns:1fr}
  .out-grid{grid-template-columns:1fr}
  .age-grid{grid-template-columns:1fr !important}
  .why-grid{grid-template-columns:1fr !important}
  .weeks-grid{grid-template-columns:1fr}
  .cta-row{flex-direction:column;align-items:center}
  .sticky{display:flex}
  .fcard{top:0}
}
</style>
</head>
