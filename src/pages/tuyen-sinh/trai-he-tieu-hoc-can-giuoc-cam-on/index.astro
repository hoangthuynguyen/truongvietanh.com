/* ══════════════════════════════════════
   TRẠI HÈ TIỂU HỌC CẦN GIUỘC — CẢM ƠN
   Thank You Page — Light + Orange CTA
   ══════════════════════════════════════ */
:root{
  --navy:#0B2F5B;--navy-dk:#071e3d;
  --orange:#F97316;--orange-dk:#EA580C;--orange-soft:#FEF3C7;
  --text:#1F2937;--text-sub:#4B5563;--border:#E5E7EB;
  --bg:#FFFDF7;
  --green:#16A34A;--trust-bg:#E0F2FE;
  --r:12px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Open Sans',system-ui,sans-serif;color:var(--text);background:var(--bg);
  line-height:1.65;font-size:16px;-webkit-font-smoothing:antialiased;overflow-x:hidden;
  display:flex;flex-direction:column;min-height:100vh;padding-bottom:80px}
h1,h2,h3{font-family:'Montserrat',sans-serif;font-weight:800;line-height:1.2}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
.wrap{max-width:820px;margin:0 auto;padding:0 24px;width:100%}

/* ── LOGO BAR ── */
.logo-bar{background:#fff;padding:8px 0;border-bottom:3px solid var(--orange);
  position:sticky;top:0;z-index:200;box-shadow:0 2px 8px rgba(0,0,0,.06)}
.lb-inner{max-width:820px;margin:0 auto;padding:0 24px;
  display:flex;align-items:center;justify-content:space-between;gap:16px}
.lb-inner img{height:72px;width:auto;display:block}
.lb-info{font-size:12px;color:var(--text-sub);font-weight:600;text-align:center;line-height:1.4}
.lb-info strong{display:block;color:var(--navy);font-size:13px}
.lb-phone{font-size:13px;font-weight:700;color:var(--navy);text-align:right;white-space:nowrap}
.lb-phone a{color:var(--navy);display:block;margin-top:3px}

/* ── PROGRESS ── */
.progress{display:flex;align-items:center;justify-content:center;gap:0;
  padding:14px 20px 4px;max-width:420px;margin:0 auto}
.pstep{display:flex;align-items:center;gap:6px;font-size:13.5px;font-weight:700;
  color:var(--navy);font-family:'Montserrat',sans-serif}
.pdot{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;
  justify-content:center;font-size:.95rem;font-weight:900;flex-shrink:0}
.pstep--done .pdot{background:var(--navy);color:#fff}
.pstep--active .pdot{background:var(--orange);color:#fff;animation:pulse 2s ease-in-out infinite}
.pstep--pending .pdot{background:#ddd;color:#aaa}
.pstep--pending{color:#aaa}
.pline{flex:1;height:2px;background:var(--navy);min-width:24px}
.pline--pending{background:#ddd}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(249,115,22,.4)}50%{box-shadow:0 0 0 8px rgba(249,115,22,0)}}

/* ── SUCCESS HERO ── */
.hero{background:var(--bg);padding:40px 0 32px;text-align:center}
.success-icon{font-size:5rem;margin-bottom:16px;display:block;
  filter:drop-shadow(0 4px 16px rgba(22,163,74,.25))}
.hero h1{font-size:clamp(1.6rem,3vw,2.2rem);color:var(--navy);margin-bottom:8px}
.hero-sub{font-size:1.1rem;font-weight:700;color:var(--green);margin-bottom:16px}
.hero-body{font-size:15.5px;color:var(--text-sub);line-height:1.75;max-width:580px;margin:0 auto 24px}

/* Program reminder chips */
.prog-chips{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-bottom:28px}
.prog-chip{display:inline-flex;align-items:center;gap:7px;background:var(--trust-bg);
  border:1.5px solid #bae6fd;color:var(--navy);padding:8px 16px;
  border-radius:24px;font-size:13.5px;font-weight:700}

/* CTA buttons */
.cta-stack{display:flex;flex-direction:column;gap:12px;max-width:400px;margin:0 auto}
.btn-primary{display:flex;align-items:center;justify-content:center;gap:10px;
  background:var(--orange);color:#fff;padding:16px 24px;border-radius:10px;
  font-weight:900;font-size:15px;font-family:'Montserrat',sans-serif;
  transition:.15s;box-shadow:0 4px 18px rgba(249,115,22,.35);width:100%}
.btn-primary:hover{background:var(--orange-dk);transform:translateY(-1px)}
.btn-secondary{display:flex;align-items:center;justify-content:center;gap:10px;
  background:#fff;color:var(--navy);border:2px solid var(--border);
  padding:14px 24px;border-radius:10px;font-weight:700;font-size:14.5px;
  font-family:'Open Sans',sans-serif;transition:.15s;width:100%}
.btn-secondary:hover{border-color:var(--navy);background:#f0f4ff}
.trust-foot{font-size:12.5px;color:var(--text-sub);display:flex;justify-content:center;
  flex-wrap:wrap;gap:12px;margin-top:14px;font-weight:600}
.trust-foot span{display:flex;align-items:center;gap:4px}

/* ── SECTIONS ── */
.sec{padding:40px 0}
.sec-alt{background:#f9fafb}
.sec-light{background:#fff}
.sec-h{font-size:clamp(1.2rem,2vw,1.6rem);color:var(--navy);margin-bottom:16px}
.sec-tag{display:inline-block;background:var(--orange-soft);color:var(--orange-dk);
  font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.6px;
  padding:5px 14px;border-radius:20px;margin-bottom:10px;border:1px solid var(--orange)}

/* ── STEPS ── */
.steps{display:flex;flex-direction:column;gap:20px;max-width:640px;margin:0 auto}
.step-item{display:flex;gap:16px;align-items:flex-start;
  background:#fff;border-radius:12px;padding:20px;border:1.5px solid var(--border)}
.step-num{width:36px;height:36px;border-radius:50%;background:var(--navy);color:#fff;
  font-size:1rem;font-weight:900;display:flex;align-items:center;justify-content:center;
  flex-shrink:0;font-family:'Montserrat',sans-serif}
.step-content h3{font-size:15.5px;font-weight:800;color:var(--navy);margin-bottom:6px}
.step-content p{font-size:14px;color:var(--text-sub);line-height:1.65}
.step-cta{margin-top:12px}
.btn-sm-orange{display:inline-flex;align-items:center;gap:6px;
  background:var(--orange);color:#fff;padding:10px 18px;border-radius:8px;
  font-weight:900;font-size:13px;font-family:'Montserrat',sans-serif;
  transition:.15s;box-shadow:0 3px 12px rgba(249,115,22,.3)}
.btn-sm-orange:hover{background:var(--orange-dk)}
.btn-sm-navy{display:inline-flex;align-items:center;gap:6px;
  background:var(--navy);color:#fff;padding:10px 18px;border-radius:8px;
  font-weight:900;font-size:13px;font-family:'Montserrat',sans-serif;transition:.15s}
.btn-sm-navy:hover{background:var(--navy-dk)}

/* Checklist */
.chk-list{list-style:none;display:flex;flex-direction:column;gap:9px}
.chk-list li{display:flex;align-items:flex-start;gap:10px;font-size:14.5px;line-height:1.55;color:var(--text)}
.chk-list li::before{content:'✅';flex-shrink:0;font-size:13px;margin-top:2px}

/* ── ZALO MSG BOX ── */
.msg-box{background:var(--trust-bg);border:1.5px solid #bae6fd;border-radius:12px;
  padding:20px;max-width:580px;margin:0 auto}
.msg-box p{font-size:14px;color:var(--text-sub);margin-bottom:10px;font-style:italic;line-height:1.7}
.copy-btn{display:inline-flex;align-items:center;gap:7px;background:#fff;
  border:1.5px solid var(--border);color:var(--navy);padding:9px 16px;
  border-radius:8px;font-size:13px;font-weight:700;cursor:pointer;transition:.15s;font-family:inherit}
.copy-btn:hover{border-color:var(--orange);color:var(--orange)}
.copy-btn.copied{background:var(--green);color:#fff;border-color:var(--green)}

/* ── SUMMARY CARD ── */
.summary-card{background:#fff;border-radius:14px;border:1.5px solid var(--border);
  padding:24px;max-width:580px;margin:0 auto;box-shadow:0 4px 20px rgba(11,47,91,.06)}
.summary-row{display:flex;justify-content:space-between;align-items:flex-start;
  padding:10px 0;border-bottom:1px solid var(--border);gap:16px}
.summary-row:last-child{border-bottom:none}
.sr-label{font-size:13px;color:var(--text-sub);font-weight:600;flex-shrink:0;width:120px}
.sr-val{font-size:14px;color:var(--navy);font-weight:700;text-align:right;flex:1}

/* ── URGENCY ── */
.urgency-box{background:var(--orange-soft);border:1.5px solid var(--orange);
  border-radius:12px;padding:24px;max-width:580px;margin:0 auto}
.urgency-box h3{font-size:1.1rem;color:var(--navy);margin-bottom:10px}
.urgency-box p{font-size:14px;color:var(--text-sub);line-height:1.7;margin-bottom:14px}

/* ── FINAL CTA ── */
.final-cta{background:var(--navy);padding:44px 0;text-align:center}
.final-cta h2{color:#fff;font-size:clamp(1.2rem,2.2vw,1.6rem);margin-bottom:8px}
.final-cta p{color:rgba(255,255,255,.75);font-size:15px;margin-bottom:24px}
.final-cta .cta-row{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
.btn-white{display:inline-flex;align-items:center;justify-content:center;gap:8px;
  background:#fff;color:var(--navy);padding:14px 24px;border-radius:9px;
  font-weight:900;font-size:14.5px;font-family:'Montserrat',sans-serif;transition:.15s}
.btn-white:hover{background:#f0f4ff}
.btn-outline-w{display:inline-flex;align-items:center;justify-content:center;gap:8px;
  background:transparent;color:#fff;border:2px solid rgba(255,255,255,.4);
  padding:14px 24px;border-radius:9px;font-weight:700;font-size:14.5px;
  font-family:'Open Sans',sans-serif;transition:.15s}
.btn-outline-w:hover{background:rgba(255,255,255,.1)}

/* ── FOOTER ── */
.footer{background:var(--navy-dk, #071e3d);color:rgba(255,255,255,.5);text-align:center;
  padding:20px;font-size:13px}
.footer a{color:var(--orange)}

/* ── STICKY BAR ── */
.sticky{display:none;position:fixed;bottom:0;left:0;right:0;background:#fff;
  border-top:2px solid var(--orange);z-index:300;padding:10px 16px;gap:10px}
.sb{flex:1;display:flex;align-items:center;justify-content:center;gap:7px;
  padding:13px 10px;border-radius:9px;font-weight:900;font-size:13.5px;
  font-family:'Montserrat',sans-serif;text-decoration:none}
.sb-r{background:var(--orange);color:#fff}
.sb-c{background:var(--navy);color:#fff}

@media(max-width:640px){
  .sec{padding:28px 0}
  .lb-inner img{height:60px}
  .lb-info{display:none}
  .sticky{display:flex}
  .summary-row{flex-direction:column;gap:4px}
  .sr-label{width:auto}
  .sr-val{text-align:left}
}
</style>
