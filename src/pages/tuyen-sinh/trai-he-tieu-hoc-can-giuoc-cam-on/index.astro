<script define:vars={{ FUNNEL_CODE, ZALO_URL }}>
(function(){
  var FC = FUNNEL_CODE;

  // GTM events on load
  if(window.dataLayer) window.dataLayer.push({ event:'thank_you_view', funnel_code: FC });

  // Track Zalo clicks
  document.querySelectorAll('a[href*="zalo.me"]').forEach(function(a){
    a.addEventListener('click', function(){
      if(window.dataLayer) window.dataLayer.push({ event:'zalo_click_after_submit', funnel_code: FC, element_id: a.id || 'unknown' });
    });
  });

  // Track phone clicks
  document.querySelectorAll('a[href^="tel:"]').forEach(function(a){
    a.addEventListener('click', function(){
      if(window.dataLayer) window.dataLayer.push({ event:'phone_click_after_submit', funnel_code: FC });
    });
  });

  // Copy message
  window.copyMsg = function(){
    var msg = document.getElementById('zalo-msg');
    if(!msg) return;
    var text = msg.textContent.trim();
    var btn = document.getElementById('copy-btn');
    if(navigator.clipboard){
      navigator.clipboard.writeText(text).then(function(){
        if(btn){ btn.textContent='✅ Đã sao chép!'; btn.classList.add('copied'); }
        setTimeout(function(){ if(btn){ btn.textContent='📋 Sao chép tin nhắn'; btn.classList.remove('copied'); } }, 2500);
      });
    } else {
      var ta = document.createElement('textarea');
      ta.value = text; ta.style.position='fixed'; ta.style.opacity='0';
      document.body.appendChild(ta); ta.select();
      try{ document.execCommand('copy'); if(btn){ btn.textContent='✅ Đã sao chép!'; btn.classList.add('copied'); } }catch(e){}
      document.body.removeChild(ta);
      setTimeout(function(){ if(btn){ btn.textContent='📋 Sao chép tin nhắn'; btn.classList.remove('copied'); } }, 2500);
    }
  };
})();
</script>
