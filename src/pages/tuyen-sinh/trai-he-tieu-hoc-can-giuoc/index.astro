            <div class="chk-group" id="dp-interests">
              <label class="chk-opt"><input type="checkbox" value="man-hinh" /> Con dùng màn hình quá nhiều</label>
              <label class="chk-opt"><input type="checkbox" value="tieng-anh" /> Tiếng Anh qua hoạt động</label>
              <label class="chk-opt"><input type="checkbox" value="ai-co-ban" /> AI cơ bản, an toàn cho bé</label>
              <label class="chk-opt"><input type="checkbox" value="van-dong-teamwork" /> Vận động và teamwork</label>
              <label class="chk-opt"><input type="checkbox" value="ky-nang-song" /> Kỹ năng sống và tự tin</label>
              <label class="chk-opt"><input type="checkbox" value="lop-theo-tuoi" /> Lớp theo độ tuổi</label>
              <label class="chk-opt"><input type="checkbox" value="gan-nha" /> Gần nhà, dễ đưa đón</label>
