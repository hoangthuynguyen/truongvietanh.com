<style is:inline>
/* ══════════════════════════════════
   TRẠI HÈ TIỂU HỌC GÒ VẤP — CẢM ƠN
   Thank You Page — Light + Orange CTA
   ══════════════════════════════════ */
:root{
  --navy:#0B2F5B;--navy-dk:#071e3d;
  --orange:#F97316;--orange-dk:#EA580C;--orange-soft:#FEF3C7;
  --text:#1F2937;--text-sub:#4B5563;--border:#E5E7EB;
  --bg:#FFFDF7;
  --green:#16A34A;--trust-bg:#E0F2FE;
  --r:12px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Open Sans',system-ui,sans-serif;color:var(--text);background:var(--bg);
  line-height:1.65;font-size:16px;-webkit-font-smoothing:antialiased;overflow-x:hidden;
  display:flex;flex-direction:column;min-height:100vh;padding-bottom:80px}
h1,h2,h3{font-family:'Montserrat',sans-serif;font-weight:800;line-height:1.2}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
.wrap{max-width:820px;margin:0 auto;padding:0 24px;width:100%}

/* ── CONFETTI ── */
#confetti-canvas{position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9999}

/* ── LOGO BAR ── */
.logo-bar{background:#fff;padding:8px 0;border-bottom:3px solid var(--orange);
  position:sticky;top:0;z-index:200;box-shadow:0 2px 8px rgba(0,0,0,.06)}
.lb-inner{max-width:820px;margin:0 auto;padding:0 24px;
  display:flex;align-items:center;justify-content:space-between;gap:16px}
.lb-inner img{height:72px;width:auto;display:block}
.lb-info{font-size:12px;color:var(--text-sub);font-weight:600;text-align:center;line-height:1.4}
.lb-info strong{display:block;color:var(--navy);font-size:13px}
.lb-phone{font-size:13px;font-weight:700;color:var(--navy);text-align:right;white-space:nowrap}
.lb-phone a{color:var(--navy);display:block;margin-top:3px}

/* ── PROGRESS ── */
.progress{display:flex;align-items:center;justify-content:center;gap:0;
  padding:14px 20px 4px;max-width:420px;margin:0 auto}
.pstep{display:flex;align-items:center;gap:6px;font-size:13.5px;font-weight:700;
  color:var(--navy);font-family:'Montserrat',sans-serif}
.pstep--done{color:var(--navy)}
.pstep--active{color:var(--navy)}
.pstep--pending{color:#aaa}
.pdot{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;
  justify-content:center;font-size:.95rem;font-weight:900;flex-shrink:0}
.pstep--done .pdot{background:var(--navy);color:#fff}
.pstep--active .pdot{background:var(--orange);color:#fff;animation:pulse 2s ease-in-out infinite}
.pstep--pending .pdot{background:#ddd;color:#aaa}
.pline{flex:1;height:2px;background:var(--navy);min-width:24px}
.pline--pending{background:#ddd}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(249,115,22,.4)}50%{box-shadow:0 0 0 8px rgba(249,115,22,0)}}

/* ── MAIN ── */
.main{flex:1;padding:20px 0 48px}

/* ── SUCCESS HERO ── */
.hero-section{text-align:center;padding:28px 0 24px;border-bottom:1px solid var(--border);margin-bottom:28px}
.success-icon{font-size:3.5rem;margin-bottom:12px;display:block}
.hero-section h1{font-size:clamp(1.4rem,3vw,1.8rem);color:var(--navy);margin-bottom:10px}
.hero-sub{font-size:1.05rem;color:var(--text-sub);margin-bottom:16px}
.hero-intro{font-size:15.5px;color:var(--text-sub);line-height:1.75;max-width:640px;margin:0 auto 20px}
.hero-intro strong{color:var(--navy)}
.meta-row{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-bottom:20px}
.meta-chip{display:inline-flex;align-items:center;gap:6px;background:#fff;
  border:1.5px solid var(--border);color:var(--navy);padding:7px 14px;border-radius:20px;
  font-size:13.5px;font-weight:600}
.trust-micro{font-size:12.5px;color:var(--text-sub);margin-top:8px;
  display:flex;flex-wrap:wrap;gap:12px;justify-content:center;font-weight:600}

/* ── CTAs ── */
.btn-zalo{display:flex;align-items:center;justify-content:center;gap:10px;
  width:100%;background:var(--orange);color:#fff;border:none;
  padding:16px 24px;border-radius:12px;font-size:15.5px;font-weight:900;
  font-family:'Montserrat',sans-serif;cursor:pointer;transition:.15s;
  text-decoration:none;box-shadow:0 6px 20px rgba(249,115,22,.3);
  animation:cta-pulse 3s ease-in-out infinite;margin-bottom:10px}
@keyframes cta-pulse{0%,100%{box-shadow:0 6px 20px rgba(249,115,22,.3)}
  50%{box-shadow:0 6px 28px rgba(249,115,22,.5),0 0 0 5px rgba(249,115,22,.12)}}
.btn-zalo:hover{background:var(--orange-dk);transform:translateY(-2px);animation:none}
.btn-call{display:flex;align-items:center;justify-content:center;gap:10px;
  width:100%;background:#fff;color:var(--navy);border:1.5px solid var(--border);
  padding:13px 24px;border-radius:12px;font-size:15px;font-weight:700;
  font-family:'Open Sans',sans-serif;cursor:pointer;transition:.15s;text-decoration:none}
.btn-call:hover{background:#f0f4ff;border-color:var(--navy)}

/* ── SECTIONS ── */
.sec{margin-bottom:28px;background:#fff;border-radius:var(--r);
  padding:24px;border:1px solid var(--border)}
.sec-h{font-size:1.1rem;color:var(--navy);margin-bottom:14px}
.sec-tag{display:inline-block;background:var(--orange-soft);color:var(--orange-dk);
  font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.5px;
  padding:4px 12px;border-radius:20px;margin-bottom:8px;border:1px solid var(--orange)}

/* ── STEPS LIST ── */
.sitem{display:flex;align-items:flex-start;gap:12px;padding:10px 0;
  border-bottom:1px solid var(--border);font-size:15px;color:var(--text-sub);line-height:1.65}
.sitem:last-child{border-bottom:none}
.sitem.done{color:var(--navy)}
.sitem.active{color:var(--navy);font-weight:600}
.sdot2{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;
  justify-content:center;font-size:13px;font-weight:900;flex-shrink:0;margin-top:2px;
  font-family:'Montserrat',sans-serif}
.sitem.done .sdot2{background:var(--navy);color:#fff}
.sitem.active .sdot2{background:var(--orange);color:#fff;animation:pulse 2s infinite}
.sitem.pending .sdot2{background:#e8e8e8;color:#aaa}

/* ── CHECKLIST ── */
.chk-list{list-style:none;display:flex;flex-direction:column;gap:9px}
.chk-list li{display:flex;align-items:flex-start;gap:9px;font-size:15px;line-height:1.55}
.chk-list li::before{content:'✅';flex-shrink:0;font-size:13px;margin-top:2px}

/* ── SUMMARY TABLE ── */
.summary-table{width:100%;border-collapse:collapse;font-size:15px}
.summary-table tr{border-bottom:1px solid var(--border)}
.summary-table tr:last-child{border-bottom:none}
.summary-table td{padding:9px 0}
.summary-table td:first-child{color:var(--text-sub);width:44%;font-weight:600}
.summary-table td:last-child{color:var(--navy);font-weight:700}

/* ── TRUST BOX ── */
.trust-box{background:var(--trust-bg);border-radius:10px;padding:16px 20px;
  font-size:14.5px;color:var(--navy);line-height:1.7}
.trust-box strong{color:var(--navy)}

/* ── NOTE BOX ── */
.note-box{background:#fff;border-left:4px solid var(--orange);
  padding:14px 18px;font-size:14.5px;color:var(--text-sub);line-height:1.7;margin-top:20px}
.note-box strong{color:var(--navy)}

/* ── FOOTER ── */
.footer{background:var(--navy-dk);color:rgba(255,255,255,.55);text-align:center;
  padding:18px;font-size:13px}
.footer a{color:var(--orange)}

/* ── STICKY BAR ── */
.sticky-bar{position:fixed;bottom:0;left:0;right:0;background:#fff;
  border-top:2px solid var(--orange);z-index:300;padding:10px 16px;display:flex;gap:10px}
.sb-btn{flex:1;display:flex;align-items:center;justify-content:center;gap:7px;
  padding:13px 10px;border-radius:9px;font-weight:900;font-size:14px;
  font-family:'Montserrat',sans-serif;text-decoration:none;transition:.15s;
  white-space:nowrap;overflow:hidden}
.sb-zalo{background:var(--orange);color:#fff}
.sb-call{background:var(--navy);color:#fff}
.sb-btn:active{opacity:.8}

/* ── RESPONSIVE ── */
@media(max-width:640px){
  .main{padding:12px 0 28px}
  .lb-inner img{height:56px}
  .lb-info{display:none}
  .wrap{padding:0 16px}
  .lb-inner{padding:0 16px}
  .hero-section h1{font-size:1.3rem}
  .btn-zalo{font-size:14.5px;padding:14px 16px}
}
</style>

