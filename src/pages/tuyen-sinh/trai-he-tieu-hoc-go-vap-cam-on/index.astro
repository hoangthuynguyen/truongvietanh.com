<!-- CONFETTI -->
<script is:inline>
(function(){
  var canvas = document.getElementById('confetti-canvas');
  if(!canvas) return;
  var ctx = canvas.getContext('2d');
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
  var pieces = [];
  var colors = ['#F97316','#0B2F5B','#ffffff','#FEF3C7','#16A34A','#fbbf24'];
  for(var i=0;i<80;i++){
    pieces.push({
      x: Math.random()*canvas.width,
      y: Math.random()*canvas.height - canvas.height,
      w: Math.random()*10+5, h: Math.random()*6+4,
      color: colors[Math.floor(Math.random()*colors.length)],
      speed: Math.random()*2.5+1.5, angle: Math.random()*360,
      spin: (Math.random()-.5)*6, opacity: 1
    });
  }
  var frame = 0;
  function draw(){
    ctx.clearRect(0,0,canvas.width,canvas.height);
    var alive = false;
    pieces.forEach(function(p){
      p.y += p.speed; p.angle += p.spin;
      if(p.y < canvas.height + 20) alive = true;
      if(frame > 120) p.opacity = Math.max(0, p.opacity - 0.008);
      ctx.save();
      ctx.globalAlpha = p.opacity;
      ctx.translate(p.x + p.w/2, p.y + p.h/2);
      ctx.rotate(p.angle * Math.PI/180);
      ctx.fillStyle = p.color;
      ctx.fillRect(-p.w/2, -p.h/2, p.w, p.h);
      ctx.restore();
    });
    frame++;
    if(alive && frame < 300) requestAnimationFrame(draw);
    else canvas.style.display='none';
  }
  requestAnimationFrame(draw);
  window.addEventListener('resize', function(){
    canvas.width=window.innerWidth; canvas.height=window.innerHeight;
  });
})();
</script>
